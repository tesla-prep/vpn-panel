# The official images come from AWS ECR Public's Docker Hub mirror; CI takes them from Google's (mirror.gcr.io/library)
# when ECR cannot serve one — for two days in 2026-10 its debian:bookworm-slim index named an amd64 manifest it no longer had.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
FROM ${BASE_REGISTRY}/debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make build-essential \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# awg / awg-quick userspace control tools
RUN for i in 1 2 3 4 5; do git clone --depth=1 --branch v3.1.20260812 https://github.com/amnezia-vpn/amneziawg-tools && break \
      || { echo "git clone amneziawg-tools failed (attempt $i) — retrying"; sleep 3; rm -rf amneziawg-tools; }; done \
 && make -C amneziawg-tools/src \
 && make -C amneziawg-tools/src install DESTDIR=/out PREFIX=/usr WITH_BASHCOMPLETION=no WITH_SYSTEMDUNITS=no WITH_WGQUICK=yes \
 && test -x /out/usr/bin/awg && test -x /out/usr/bin/awg-quick

FROM ${BASE_REGISTRY}/python:3.12-slim
ARG TARGETARCH=amd64
RUN apt-get update && apt-get install -y --no-install-recommends \
      iproute2 iptables nftables ipset dnsmasq ca-certificates procps curl util-linux wireguard-tools iputils-ping \
 && case "$TARGETARCH" in amd64) A=x86_64;; arm64) A=aarch64;; *) A=x86_64;; esac \
 && curl -fsSL "https://download.docker.com/linux/static/stable/${A}/docker-27.3.1.tgz" -o /tmp/d.tgz \
 && tar -xzf /tmp/d.tgz -C /tmp && install /tmp/docker/docker /usr/bin/docker \
 && rm -rf /tmp/d.tgz /tmp/docker /var/lib/apt/lists/*
COPY --from=build /out/usr/bin/awg /usr/bin/awg
COPY --from=build /out/usr/bin/awg-quick /usr/bin/awg-quick
WORKDIR /opt
COPY src/swg-agent /opt/swg-agent/swg-agent
COPY src/swg-noded /opt/swg-noded/swg-noded
COPY src/swg-sni /opt/swg-noded/swg-sni
COPY src/swg-relay /opt/swg-noded/swg-relay
COPY VERSION /opt/swg-noded/VERSION
COPY docker/node-entrypoint.sh /node-entrypoint.sh
RUN chmod +x /opt/swg-agent/swg-agent /opt/swg-noded/swg-noded /opt/swg-noded/swg-sni /opt/swg-noded/swg-relay /node-entrypoint.sh /usr/bin/awg /usr/bin/awg-quick

ENTRYPOINT ["/node-entrypoint.sh"]
