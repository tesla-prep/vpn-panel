NETLINK_NETFILTER = 12
NFNL_SUBSYS_QUEUE = 3
NFQNL_MSG_PACKET  = (NFNL_SUBSYS_QUEUE << 8) | 0
NFQNL_MSG_VERDICT = (NFNL_SUBSYS_QUEUE << 8) | 1
NFQNL_MSG_CONFIG  = (NFNL_SUBSYS_QUEUE << 8) | 2
NLM_F_REQUEST = 0x01
NFQA_CFG_CMD, NFQA_CFG_PARAMS, NFQA_CFG_MASK, NFQA_CFG_FLAGS = 1, 2, 4, 5
NFQNL_CFG_CMD_BIND = 1
NFQNL_COPY_PACKET = 2
NFQA_CFG_F_FAIL_OPEN = 0x0001
NFQA_PACKET_HDR, NFQA_IFINDEX_INDEV, NFQA_PAYLOAD = 1, 5, 10
NFQA_VERDICT_HDR = 2
NFQA_MARK = 3
NF_ACCEPT = 1
NLA_TYPE_MASK = 0x3fff
SNI_PROBE, SNI_REPLY, SNI_PASS, SNI_ALLOW, SNI_ARRIVE = 0x20000000, 0x10000000, 0x08000000, 0x04000000, 0x02000000
SNI_DIRECT_MARK, SNI_BLOCK_MARK = 0x9996, 0x9998


def _nla(attr_type, payload):
    ln = 4 + len(payload)
    return struct.pack("=HH", ln, attr_type) + payload + b"\x00" * ((4 - ln % 4) % 4)


def _msg(msg_type, res_id, *attrs):
    body = struct.pack("=BB", socket.AF_UNSPEC, 0) + struct.pack(">H", res_id) + b"".join(attrs)
    total = 16 + len(body)
    hdr = struct.pack("=IHHII", total, msg_type, NLM_F_REQUEST, 0, 0)
    return hdr + body



SAY_MAX, SAY_RATE = 1000, 100
LOG_OFF, LOG_ERR, LOG_WARNING, LOG_NOTICE, LOG_INFO, LOG_DEBUG = -1, 3, 4, 5, 6, 7
LOG_LEVEL_FILE = os.environ.get("SWG_LOG_LEVEL_FILE") or "/var/lib/swg-noded/log-level"
LOG_LEVEL_EVERY = 5
_LOG_TAG = {LOG_ERR: "E", LOG_WARNING: "W", LOG_NOTICE: "N", LOG_INFO: "I", LOG_DEBUG: "D"}
_SAY = {"q": collections.deque(), "dropped": 0, "wake": threading.Event(), "thread": None, "lock": threading.Lock(),
        "level": LOG_INFO, "level_at": 0.0}


def _say_level():
    _SAY["level_at"] = time.monotonic()
    try:
        with open(LOG_LEVEL_FILE) as f:
            v = int(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        v = LOG_INFO
    _SAY["level"] = v if -1 <= v <= 7 else LOG_INFO


def _say_to_journal():
    try:
        dev, ino = (int(x) for x in os.environ.get("JOURNAL_STREAM", "").split(":"))
        st = os.fstat(sys.stdout.fileno())
        return (st.st_dev, st.st_ino) == (dev, ino)
    except Exception:
        return False


_SAY_JOURNAL = _say_to_journal()
_say_level()


class _Join:
    __slots__ = ("v",)

    def __init__(self, v):
        self.v = v

    def __str__(self):
        return ", ".join(map(str, self.v))


def _say_text(prio, fmt, args):
    try:
        text = (fmt % args) if args else str(fmt)
    except Exception:
        text = "%s %r" % (fmt, args)
    pre = "<%d>" % prio if _SAY_JOURNAL else _LOG_TAG.get(prio, "I") + " "
    return "".join(pre + ln + "\n" for ln in text.split("\n"))


def _say_write(text):
    out = sys.stdout
    try:
        fd = out.fileno()
    except (AttributeError, OSError, ValueError):
        out.write(text)
        out.flush()
        return
    data = text.encode("utf-8", "replace")
    while data:
        data = data[os.write(fd, data):]


def _say_loop():
    q, wake = _SAY["q"], _SAY["wake"]
    while True:
        wake.wait(1.0)
        wake.clear()
        n = 0
        if time.monotonic() - _SAY["level_at"] >= LOG_LEVEL_EVERY:
            _say_level()
        while q and n < SAY_RATE:
            line = q.popleft()
            n += 1
            try:
                _say_write(_say_text(*line))
            except Exception:
                pass
        dropped, _SAY["dropped"] = _SAY["dropped"], 0
        if dropped:
            try:
                _say_write(_say_text(LOG_WARNING, "swg-sni: %d lines not written (more than %d a second)",
                                     (dropped, SAY_RATE)))
            except Exception:
                pass
        if q:
            time.sleep(1.0)
            wake.set()


def _say_drain():
    def run():
        q = _SAY["q"]
        while q:
            try:
                _say_write(_say_text(*q.popleft()))
            except Exception:
                return
    t = threading.Thread(target=run, daemon=True)
    t.start()
    t.join(1.0)


def say(prio, fmt, *args):
    try:
        if _SAY["thread"] is None:
            with _SAY["lock"]:
                if _SAY["thread"] is None:
                    _SAY["thread"] = threading.Thread(target=_say_loop, daemon=True)
                    _SAY["thread"].start()
                    atexit.register(_say_drain)
        if prio > _SAY["level"]:
            return
        if len(_SAY["q"]) >= SAY_MAX:
            _SAY["dropped"] += 1
            return
        _SAY["q"].append((prio, fmt, args))
        _SAY["wake"].set()
    except Exception:
        pass


def _say_excepthook(et, ev, tb):
    if et is None or issubclass(et, (SystemExit, KeyboardInterrupt)):
        return
    text = "".join(traceback.format_exception(et, ev, tb)).rstrip("\n")
    say(LOG_ERR, "\n".join("swg-sni: " + ln for ln in text.split("\n")))


sys.excepthook = _say_excepthook
threading.excepthook = lambda a: _say_excepthook(a.exc_type, a.exc_value, a.exc_traceback)

class NFQueue:

    def __init__(self, qnum):
        self.qnum = qnum
        self.s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_NETFILTER)
        self.s.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 8 << 20)
        self.s.bind((0, 0))
        self.s.settimeout(0.25)
        self.probes = {}
        self.probe_sources = collections.Counter()
        cmd = struct.pack("=BB", NFQNL_CFG_CMD_BIND, 0) + struct.pack(">H", socket.AF_UNSPEC)
        self.s.send(_msg(NFQNL_MSG_CONFIG, qnum, _nla(NFQA_CFG_CMD, cmd)))
        params = struct.pack(">I", 0xFFFF) + struct.pack("=B", NFQNL_COPY_PACKET)
        flags = struct.pack(">I", NFQA_CFG_F_FAIL_OPEN)
        self.s.send(_msg(NFQNL_MSG_CONFIG, qnum,
                         _nla(NFQA_CFG_PARAMS, params),
                         _nla(NFQA_CFG_MASK, struct.pack(">I", NFQA_CFG_F_FAIL_OPEN)),
                         _nla(NFQA_CFG_FLAGS, flags)))

    def _accept(self, packet_id, mark=None):
        attrs = [_nla(NFQA_VERDICT_HDR, struct.pack(">II", NF_ACCEPT, packet_id))]
        if mark:
            attrs.append(_nla(NFQA_MARK, struct.pack(">I", mark)))
        self.s.send(_msg(NFQNL_MSG_VERDICT, self.qnum, *attrs))

    def _finish_probe(self, key, mark, pid=None):
        probe = self.probes.pop(key, None)
        if probe:
            source = probe[4]
            self.probe_sources[source] -= 1
            if not self.probe_sources[source]:
                del self.probe_sources[source]
            for held in probe[3]:
                self._accept(held, mark)
        if pid is not None:
            self._accept(pid, mark)

    def _probe(self, pid, pkt, indev, mark, inspect):
        dst, tcp = _dst_and_tcp_payload(pkt, strict=True)
        if dst is None:
            self._accept(pid, SNI_BLOCK_MARK)
            return
        flags = pkt[(pkt[0] & 0xf) * 4 + 13]
        if not tcp:
            self._accept(pid, SNI_PASS | (mark & SNI_REPLY))
            return
        key, seq, src = _flow_seq(pkt)
        key = (indev, key)
        if mark & SNI_REPLY or flags & 0x07:
            self._finish_probe(key, SNI_BLOCK_MARK, pid)
            return
        probe = self.probes.get(key)
        if probe is None:
            source = (indev, src)
            if (len(self.probes) >= PARTIAL_MAX or self.probe_sources[source] >= PARTIAL_PER_SRC
                    or not tcp.startswith(b"\x16")):
                self._accept(pid, SNI_BLOCK_MARK)
                return
            probe = [time.monotonic() + PARTIAL_TTL, seq, b"", [], source]
            self.probes[key] = probe
            self.probe_sources[source] += 1
        offset = (seq - probe[1]) & 0xffffffff
        old = probe[2]
        overlap = min(len(tcp), max(0, len(old) - offset))
        if (offset > len(old) or offset + len(tcp) > PARTIAL_BYTES or len(probe[3]) >= 16
                or old[offset:offset + overlap] != tcp[:overlap]):
            self._finish_probe(key, SNI_BLOCK_MARK, pid)
            return
        probe[2] = data = old + tcp[overlap:]
        probe[3].append(pid)
        if len(data) >= 2 and data[1] != 3:
            self._finish_probe(key, SNI_BLOCK_MARK)
            return
        if len(data) < 6:
            return
        length = _hello_len(data)
        if not length or length > PARTIAL_BYTES:
            self._finish_probe(key, SNI_BLOCK_MARK)
        elif len(data) >= length:
            verdict = SNI_BLOCK_MARK
            try:
                host = parse_sni(data[:length], strict=True)
                if host:
                    verdict = inspect(host, pkt, indev, mark) or SNI_BLOCK_MARK
            finally:
                self._finish_probe(key, verdict)

    def loop(self, on_packet, inspect):
        next_sweep = 0
        while True:
            now = time.monotonic()
            if now >= next_sweep:
                for key, probe in list(self.probes.items()):
                    if probe[0] <= now:
                        self._finish_probe(key, SNI_BLOCK_MARK)
                next_sweep = now + 0.25
            try:
                buf = self.s.recv(0x10000)
            except TimeoutError:
                continue
            off = 0
            while off + 16 <= len(buf):
                mlen, mtype = struct.unpack("=IH", buf[off:off + 6])
                if mlen < 16 or off + mlen > len(buf):
                    break
                if mtype == NFQNL_MSG_PACKET:
                    pid, payload, indev, wire_mark = self._parse_packet(buf[off + 16:off + mlen])
                    if pid is not None:
                        if wire_mark & SNI_PROBE:
                            try:
                                self._probe(pid, payload, indev, wire_mark, inspect)
                            except Exception as e:
                                say(LOG_WARNING, "swg-sni: gated packet: %s", e)
                        else:
                            mark = None
                            try:
                                if payload:
                                    mark = on_packet(payload, indev)
                            except Exception:
                                pass
                            self._accept(pid, mark)
                off += (mlen + 3) & ~3

    @staticmethod
    def _parse_packet(body):
        pid, payload, indev, mark, o = None, b"", 0, 0, 4
        while o + 4 <= len(body):
            alen, atype = struct.unpack("=HH", body[o:o + 4])
            if alen < 4 or o + alen > len(body):
                break
            data = body[o + 4:o + alen]
            atype &= NLA_TYPE_MASK
            if atype == NFQA_PACKET_HDR and len(data) >= 4:
                pid = struct.unpack(">I", data[:4])[0]
            elif atype == NFQA_PAYLOAD:
                payload = data
            elif atype == NFQA_IFINDEX_INDEV and len(data) >= 4:
                indev = struct.unpack(">I", data[:4])[0]
            elif atype == NFQA_MARK and len(data) >= 4:
                mark = struct.unpack(">I", data[:4])[0]
            o += (alen + 3) & ~3
        return pid, payload, indev, mark


def _dst_and_tcp_payload(pkt, strict=False):
    if len(pkt) < 20 or (pkt[0] >> 4) != 4:
        return None, None
    ihl = (pkt[0] & 0x0F) * 4
    if pkt[9] != 6 or len(pkt) < ihl + 20:
        return None, None
    dst = socket.inet_ntoa(pkt[16:20])
    toff = ((pkt[ihl + 12] >> 4) & 0x0F) * 4
    start = ihl + toff
    if strict:
        total, fragment = struct.unpack(">HxxH", pkt[2:8])
        if ihl < 20 or toff < 20 or not start <= total <= len(pkt) or fragment & 0x3fff:
            return None, None
        return dst, pkt[start:total]
    return dst, pkt[start:] if start <= len(pkt) else b""


def _hello_len(p):
    if len(p) >= 6 and p[0] == 0x16 and p[1] == 0x03 and p[5] == 0x01:
        return 5 + ((p[3] << 8) | p[4])
    return 0


def _flow_seq(pkt):
    ihl = (pkt[0] & 0x0F) * 4
    return (pkt[12:20], pkt[ihl:ihl + 4]), struct.unpack(">I", pkt[ihl + 4:ihl + 8])[0], pkt[12:16]


def parse_sni(p, strict=False):
    try:
        if len(p) < 43 or p[0] != 0x16:
            return None
        if strict and (len(p) != _hello_len(p) or int.from_bytes(p[6:9], "big") != len(p) - 9):
            return None
        i = 43
        sid = p[i]; i += 1 + sid
        cs = struct.unpack(">H", p[i:i + 2])[0]; i += 2 + cs
        cm = p[i]; i += 1 + cm
        if i + 2 > len(p):
            return None
        ext_total = struct.unpack(">H", p[i:i + 2])[0]; i += 2
        end = min(len(p), i + ext_total)
        if strict and i + ext_total != len(p):
            return None
        host = None
        while i + 4 <= end:
            etype, elen = struct.unpack(">HH", p[i:i + 4]); i += 4
            if strict and i + elen > end:
                return None
            if etype == 0x0000:
                if strict and (host is not None or elen < 5 or int.from_bytes(p[i:i + 2], "big") != elen - 2):
                    return None
                j = i + 2
                if j + 3 > len(p):
                    return None
                ntype, nlen = p[j], struct.unpack(">H", p[j + 1:j + 3])[0]
                j += 3
                if strict:
                    if ntype != 0 or j + nlen != i + elen:
                        return None
                    host = p[j:j + nlen].decode("ascii").lower()
                    if not re.fullmatch(r"(?=.{1,253}$)[a-z0-9-]{1,63}(?:\.[a-z0-9-]{1,63})*", host):
                        return None
                else:
                    if ntype == 0 and j + nlen <= len(p):
                        return p[j:j + nlen].decode("ascii", "ignore").lower() or None
                    return None
            i += elen
        if strict and i == end:
            return host
    except Exception:
        return None
    return None


FLUSH_INTERVAL = 0.025
MAX_BATCH      = 128
PRUNE_EVERY    = 30.0
IFNAME_TTL     = 30.0
BLK_TOPK       = 500
BLK_WRITE_EVERY = 10.0
IDLE_WAKE      = 10.0
PARTIAL_MAX    = 1024
PARTIAL_PER_SRC = 64
PARTIAL_TTL    = 5.0
PARTIAL_BYTES  = 8197


SNI_TIER1 = ("first", "zone", "any")
SNI_TIER2 = ("starts", "ends", "contains")
SNI_KINDS = SNI_TIER1 + SNI_TIER2
if set(SNI_TIER1) & set(SNI_TIER2):
    raise SystemExit("swg-sni: %s is in both SNI_TIER1 and SNI_TIER2 — a kind has exactly one tier"
                     % ", ".join(sorted(set(SNI_TIER1) & set(SNI_TIER2))))


def _mtime(path):
    try:
        st = os.stat(path)
        return st.st_ino, st.st_mtime_ns, st.st_size
    except OSError:
        return None


def _index(data, labels=True):
    out = {}
    for cat, names in (data or {}).items():
        if not isinstance(names, (list, tuple)):
            continue
        for n in names:
            k = str(n).lower()
            k = k.strip(".") if labels else k
            if not k:
                continue
            cats = out.setdefault(k, [])
            if cat not in cats:
                cats.append(cat)
    return out


def _domain_index(data):
    index = _index(data)
    redundant = []
    for name, cats in index.items():
        parent = name.partition(".")[2]
        while "." in parent:
            covering = index.get(parent)
            if covering:
                if set(covering) == set(cats):
                    redundant.append(name)
                break
            parent = parent.partition(".")[2]
    for name in redundant:
        del index[name]
    return index


def _bucket(kind, data):
    if kind in SNI_TIER1:
        return _index(data)
    d = _index(data, labels=False)
    return sorted(d.items(), key=lambda kv: (-len(kv[0]), kv[0]))


def _empty_pats():
    return {k: _bucket(k, None) for k in SNI_KINDS}


def _learnsetname(cat):
    return "catl_" + re.sub(r"[^a-z0-9]", "_", str(cat).lower())


def _ip4(s):
    return struct.unpack(">I", socket.inet_aton(s))[0]


def _blocks_parse(data):
    empty = ([], [], {}, frozenset(), 0)
    try:
        def rules(lst):
            out = []
            for r in lst:
                mark, act, cats, sel = int(r[0]), str(r[1]), r[2], r[3]
                table = int(r[4] or 0) if len(r) > 4 else 0
                via = str(r[5] or "") if len(r) > 5 else ""
                out.append((mark, act, tuple((str(c), frozenset(str(x) for x in ex)) for c, ex in cats),
                            str(sel) if sel else None, table, via))
            return tuple(out)
        src = []
        for net, lst in data.get("src") or []:
            a, _, ln = str(net).partition("/")
            n = int(ln or 32)
            m = (0xFFFFFFFF << (32 - n)) & 0xFFFFFFFF
            src.append((n, _ip4(a) & m, m, rules(lst)))
        src.sort(key=lambda x: -x[0])
        arr = []
        a = data.get("arr") or {}
        if a.get("nets") and a.get("rules"):
            nets = []
            for net in a["nets"]:
                ip, _, ln = str(net).partition("/")
                n = int(ln or 32)
                m = (0xFFFFFFFF << (32 - n)) & 0xFFFFFFFF
                nets.append((_ip4(ip) & m, m))
            arr = [(tuple(nets), rules(a["rules"]))]
        sel = {str(w): frozenset((str(d), _ip4(x)) for d, x in pairs) for w, pairs in (data.get("sel") or {}).items()}
        return ([(net, m, r) for _n, net, m, r in src], arr, sel, frozenset(str(c) for c in data.get("nolearn") or ()),
                int(data.get("mark") or 0))
    except Exception:
        return empty


class Classifier:
    bsrc, barr, bsel, nolearn, bmark, blocks_path, blocks_mtime = (), (), {}, frozenset(), 0, None, None
    quiet = frozenset()
    learn_unions = {}
    sets_path, sets_mtime, set_gen = None, None, {}

    def __init__(self, map_path, table, reset_mark=0, learn_ttl=3600):
        self.map_path = map_path
        self.table = table
        self.reset_mark = reset_mark
        self.learn_ttl = learn_ttl
        self.refresh_age = learn_ttl / 2.0
        self.map_mtime = None
        self.pat_mtime = None
        self.dom2cat = {}
        self.pats = _empty_pats()
        self.pat_path = os.path.join(os.path.dirname(map_path) or ".", "sni-patterns.json")
        self.blk_path = os.path.join(os.path.dirname(map_path) or ".", "sni-blk-hits.json")
        self.blocks_path = os.path.join(os.path.dirname(map_path) or ".", "sni-blocks.json")
        self.blocks_mtime = None
        self.bsrc, self.barr, self.bsel, self.nolearn, self.bmark = [], [], {}, frozenset(), 0
        self.sets_path = os.path.join(os.path.dirname(map_path) or ".", "sni-sets.json")
        self.sets_mtime, self.set_gen = None, {}
        self._blk_hits = {}
        self._blk_last_w = 0.0
        self._blk_dirty = False
        self.seen = {}
        self._pending = []
        self._lock = threading.Lock()
        self._wake = threading.Event()
        self._partial = collections.OrderedDict()
        self._partial_src = {}
        self._plock = threading.Lock()
        self._last_reload = 0.0
        self._last_prune = 0.0
        self._reload()
        t = threading.Thread(target=self._flush_forever, name="swg-sni-flush", daemon=True)
        t.start()

    def _reload(self):
        mt = _mtime(self.map_path)
        if mt is None:
            self.dom2cat = {}; self.pats = _empty_pats()
            self.map_mtime = self.pat_mtime = self.blocks_mtime = None
            self.bsrc, self.barr, self.bsel, self.nolearn, self.bmark = [], [], {}, frozenset(), 0
            self.quiet = frozenset()
            self.learn_unions = {}
            return
        if mt != self.map_mtime:
            self.map_mtime = mt
            try:
                with open(self.map_path) as f:
                    self.dom2cat = _domain_index(json.load(f))
                say(LOG_INFO, "swg-sni: loaded %d domains", len(self.dom2cat))
            except Exception as e:
                say(LOG_ERR, "swg-sni: map reload failed: %s", e)
        pmt = _mtime(self.pat_path)
        if pmt != self.pat_mtime:
            self.pat_mtime = pmt
            if pmt is None:
                self.pats = _empty_pats()
            else:
                try:
                    with open(self.pat_path) as f:
                        pdata = json.load(f) or {}
                    self.pats = {k: _bucket(k, pdata.get(k)) for k in SNI_KINDS}
                    say(LOG_INFO, "swg-sni: loaded patterns %s%s",
                        ", ".join("%d %s" % (len(v), k) for k, v in self.pats.items()),
                        (" (ignoring %s)" % ", ".join(sorted(set(pdata) - set(SNI_KINDS)))
                         if set(pdata) - set(SNI_KINDS) else ""))
                except Exception as e:
                    say(LOG_ERR, "swg-sni: pattern reload failed: %s", e)
        bmt = _mtime(self.blocks_path) if self.blocks_path else None
        if bmt != self.blocks_mtime:
            self.blocks_mtime = bmt
            data = {}
            if bmt is not None:
                try:
                    with open(self.blocks_path) as f:
                        data = json.load(f) or {}
                except Exception as e:
                    say(LOG_ERR, "swg-sni: blocks reload failed: %s", e)
            self.bsrc, self.barr, self.bsel, self.nolearn, self.bmark = _blocks_parse(data)
            q = data.get("quiet") if isinstance(data, dict) else None
            self.quiet = frozenset(str(c) for c in q) if isinstance(q, list) else frozenset()
            unions = data.get("learn") if isinstance(data, dict) else None
            self.learn_unions = {c: tuple(v) for c, v in unions.items()
                                 if isinstance(v, list) and all(isinstance(x, str) for x in v)} if isinstance(unions, dict) else {}
            if bmt is not None:
                say(LOG_INFO, "swg-sni: loaded blocks for %d sources%s, %d categories not learned",
                    len(self.bsrc), " + arrivals" if self.barr else "", len(self.nolearn))
        smt = _mtime(self.sets_path) if self.sets_path else None
        if smt != self.sets_mtime:
            self.sets_mtime = smt
            gen = {}
            if smt is not None:
                try:
                    with open(self.sets_path) as f:
                        gen = {str(k): float(v) for k, v in (json.load(f) or {}).items()}
                except Exception as e:
                    say(LOG_ERR, "swg-sni: sets reload failed: %s", e)
                    gen = dict(self.set_gen)
            gone = {c for c, t in gen.items() if c in self.set_gen and self.set_gen[c] != t}
            if gone:
                with self._lock:
                    self.seen = {k: v for k, v in self.seen.items() if k[1] not in gone}
                say(LOG_INFO, "swg-sni: learned sets recreated for %s — their addresses are written again", ", ".join(sorted(gone)))
            self.set_gen = gen

    def _match(self, host):
        name = host.strip(".")
        labels = name.split(".")
        for k in range(len(labels) - 1):
            cats = self.dom2cat.get(".".join(labels[k:]))
            if cats:
                return cats
        cats = self.pats["first"].get(labels[0])
        if cats:
            return cats
        cats = self.pats["zone"].get(labels[-1])
        if cats:
            return cats
        anyl = self.pats["any"]
        if anyl:
            for lb in labels:
                cats = anyl.get(lb)
                if cats:
                    return cats
        for op, cats in self.pats["starts"]:
            if name.startswith(op):
                return cats
        for op, cats in self.pats["ends"]:
            if name.endswith(op):
                return cats
        for op, cats in self.pats["contains"]:
            if op in name:
                return cats
        return ()

    def _learn_categories(self, cats):
        return dict.fromkeys(target for cat in cats if cat not in self.nolearn
                             for target in (cat, *self.learn_unions.get(cat, ())))

    def on_packet(self, payload, indev=None):
        now = time.time()
        mono = time.monotonic()
        if mono - self._last_reload > 2:
            self._last_reload = mono; self._reload()
        dst, tcp = _dst_and_tcp_payload(payload)
        if not dst or not tcp:
            return
        host = parse_sni(tcp)
        if not host:
            host = self._reassemble(payload, tcp)
        elif self._partial:
            self._drop_held(payload)
        if not host:
            return
        cats = self._match(host)
        if not cats:
            return
        blk = self._blocked(struct.unpack(">I", payload[12:16])[0], cats, indev) if (self.bsrc or self.barr) else 0
        if blk:
            with self._lock:
                new_host = host not in self._blk_hits
                self._blk_hits[host] = self._blk_hits.get(host, 0) + 1
                if len(self._blk_hits) > BLK_TOPK:
                    self._blk_hits.pop(min(self._blk_hits, key=self._blk_hits.get), None)
                if not self._blk_dirty:
                    self._blk_dirty = True
                    self._wake.set()
            if new_host:
                say(LOG_DEBUG, "swg-sni: %s → blocked (%s)", host, _Join(cats))
        first = False
        with self._lock:
            idle = not self._pending
            for cat in self._learn_categories(cats):
                key = (dst, cat)
                ts = self.seen.get(key)
                if ts is None or now - ts >= self.learn_ttl:
                    first = first or cat not in self.quiet
                elif now - ts < self.refresh_age:
                    continue
                self.seen[key] = now
                self._pending.append((cat, dst))
            if self._pending and (idle or len(self._pending) >= MAX_BATCH):
                self._wake.set()
        if blk:
            return blk
        if first:
            say(LOG_DEBUG, "swg-sni: %s → %s  (+%s)", host, _Join(cats), dst)
            return self.reset_mark
        return None

    def _blocked(self, src, cats, indev=None):
        rule = self._rule_for_name(src, cats, indev)
        return rule[0] if rule and rule[1] == "block" else 0

    def _rule_for_name(self, src, cats, indev, arrived=None):
        rules = None
        if arrived is not True:
            for net, m, rl in self.bsrc:
                if src & m == net:
                    rules = rl
                    break
        if rules is None and arrived is not False:
            for nets, rl in self.barr:
                if any(src & m == n for n, m in nets):
                    rules = rl
                    break
        if rules is None:
            return None
        sel = self.bsel
        me = None
        for mark, act, rcats, who, table, via in rules:
            if arrived and via and via == self._ifname(indev):
                continue
            if who is not None:
                me = me or (self._ifname(indev), src)
                if me not in sel.get(who, ()):
                    continue
            for c, ex in rcats:
                if c in cats:
                    if ex:
                        me = me or (self._ifname(indev), src)
                        if any(me in sel.get(w, ()) for w in ex):
                            continue
                    return mark, act, table
        return None

    def inspect_probe(self, host, pkt, indev, mark):
        now = time.monotonic()
        if now - self._last_reload > 0.25:
            self._last_reload = now
            self._reload()
        src, dst = socket.inet_ntoa(pkt[12:16]), socket.inet_ntoa(pkt[16:20])
        rule = self._rule_for_name(_ip4(src), self._match(host), indev, bool(mark & SNI_ARRIVE))
        if not rule or rule[1] == "block":
            return SNI_BLOCK_MARK
        target = SNI_DIRECT_MARK if rule[1] == "direct" else rule[2]
        if target != SNI_DIRECT_MARK and not 7000 <= target <= 7099:
            return SNI_BLOCK_MARK
        if (mark & 0xffff or SNI_DIRECT_MARK) == target:
            return SNI_ALLOW | target
        iif = self._ifname(indev)
        if re.fullmatch(r"[A-Za-z0-9_.@:+-]{1,15}", iif):
            key = f'inet {self.table} sni_probe_route {{ "{iif}" . {src} . {dst}'
            command = f"add element {key} : {target} }}\ndelete element {key} }}\nadd element {key} : {target} }}\n"
            res = subprocess.run(["nft", "-f", "-"], input=command, text=True, capture_output=True, timeout=1)
            if res.returncode:
                say(LOG_WARNING, "swg-sni: could not record retry route: %s", res.stderr.strip()[:120])
        return SNI_BLOCK_MARK

    _ifn = {}

    def _ifname(self, indev):
        if not indev:
            return ""
        if isinstance(indev, str):
            return indev
        hit = self._ifn.get(indev)
        now = time.monotonic()
        if hit and now - hit[1] < IFNAME_TTL:
            return hit[0]
        try:
            nm = socket.if_indextoname(indev)
        except OSError:
            nm = ""
        self._ifn[indev] = (nm, now)
        return nm

    def _reassemble(self, pkt, tcp):
        key, seq, src = _flow_seq(pkt)
        now = time.monotonic()
        with self._plock:
            self._sweep_partial(now)
            held = self._partial.get(key)
            if held is not None:
                off = (seq - held[0]) & 0xFFFFFFFF
                buf = held[1]
                if off <= len(buf):
                    if off + len(tcp) <= len(buf):
                        return None
                    buf = buf[:off] + tcp
                    host = parse_sni(buf)
                    if host or len(buf) >= _hello_len(buf) or len(buf) >= PARTIAL_BYTES:
                        self._drop_partial(key)
                        return host
                    held[1] = buf; held[2] = now
                    self._partial.move_to_end(key)
                    return None
                if not _hello_len(tcp):
                    return None
                self._drop_partial(key)
            need = _hello_len(tcp)
            if len(tcp) < need <= PARTIAL_BYTES:
                if len(self._partial) < PARTIAL_MAX and self._partial_src.get(src, 0) < PARTIAL_PER_SRC:
                    self._partial[key] = [seq, bytes(tcp), now, src]
                    self._partial_src[src] = self._partial_src.get(src, 0) + 1
        return None

    def _drop_held(self, pkt):
        with self._plock:
            self._drop_partial(_flow_seq(pkt)[0])

    def _sweep_partial(self, now):
        while self._partial:
            k0, h0 = next(iter(self._partial.items()))
            if now - h0[2] < PARTIAL_TTL:
                break
            self._drop_partial(k0)

    def _drop_partial(self, key):
        h = self._partial.pop(key, None)
        if h is not None:
            n = self._partial_src.get(h[3], 1) - 1
            if n > 0:
                self._partial_src[h[3]] = n
            else:
                self._partial_src.pop(h[3], None)

    def _write_blk(self, hits):
        try:
            tmp = self.blk_path + ".tmp"
            with open(tmp, "w") as f:
                json.dump(hits, f)
            os.replace(tmp, self.blk_path)
            return True
        except Exception:
            return False

    def _flush_forever(self):
        while True:
            try:
                self._flush_loop()
            except Exception as e:
                _say_excepthook(type(e), e, e.__traceback__)
                time.sleep(1.0)

    def _flush_loop(self):
        last_write = 0.0
        while True:
            self._wake.clear()
            with self._lock:
                n = len(self._pending)
                due = self._last_prune + PRUNE_EVERY
                if self._blk_dirty:
                    due = min(due, self._blk_last_w + BLK_WRITE_EVERY)
            mono = time.monotonic()
            if n == 0:
                self._wake.wait(min(IDLE_WAKE, max(0.0, due - mono)))
            elif n < MAX_BATCH and mono - last_write < FLUSH_INTERVAL:
                self._wake.wait(FLUSH_INTERVAL - (mono - last_write))
            now, mono = time.time(), time.monotonic()
            batch = blk_snap = None
            sweep = False
            with self._lock:
                if mono >= self._last_prune + PRUNE_EVERY:
                    self._last_prune = mono; sweep = True
                    self.seen = {k: v for k, v in self.seen.items() if now - v < self.learn_ttl}
                if self._blk_dirty and mono >= self._blk_last_w + BLK_WRITE_EVERY:
                    self._blk_last_w = mono; self._blk_dirty = False; blk_snap = dict(self._blk_hits)
                if self._pending and (len(self._pending) >= MAX_BATCH or mono - last_write >= FLUSH_INTERVAL):
                    batch, self._pending = self._pending, []
            if sweep:
                with self._plock:
                    self._sweep_partial(mono)
            if blk_snap is not None and not self._write_blk(blk_snap):
                with self._lock:
                    self._blk_dirty = True
            if batch:
                self._write_learned(batch)
                last_write = time.monotonic()

    def _write_learned(self, batch):
        bycat = {}
        for cat, ip in batch:
            if ip not in bycat.setdefault(cat, []):
                bycat[cat].append(ip)
        def script(cat, ips):
            el = "inet %s %s { %s }" % (self.table, _learnsetname(cat), ", ".join(ips))
            return "add element %s\ndelete element %s\nadd element %s\n" % (el, el, el)
        scr = "".join(script(cat, ips) for cat, ips in bycat.items())
        if len(bycat) > 1 and subprocess.run(["nft", "-f", "-"], input=scr, capture_output=True, text=True).returncode == 0:
            return
        for cat, ips in bycat.items():
            r = subprocess.run(["nft", "-f", "-"], input=script(cat, ips), capture_output=True, text=True)
            if r.returncode != 0:
                with self._lock:
                    for ip in ips:
                        self.seen.pop((ip, cat), None)
                say(LOG_ERR, "swg-sni: batch add failed for %s (%d ips): %s", cat, len(ips), (r.stderr or "").strip()[:120])


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--queue", type=int, default=int(os.environ.get("SWG_SNI_QUEUE", "0")))
    ap.add_argument("--map", default=os.environ.get("SWG_SNI_MAP", "/var/lib/swg-noded/sni-map.json"))
    ap.add_argument("--table", default=os.environ.get("SWG_SNI_TABLE", "swg_smart"))
    ap.add_argument("--reset-mark", type=lambda x: int(x, 0), default=int(os.environ.get("SWG_SNI_RESET_MARK", "0"), 0))
    ap.add_argument("--learn-ttl", type=int, default=int(os.environ.get("SWG_SNI_LEARN_TTL", "3600")))
    a = ap.parse_args()
    cls = Classifier(a.map, a.table, a.reset_mark, a.learn_ttl)
    q = NFQueue(a.queue)
    say(LOG_INFO, "swg-sni: bound queue %s, table %s, map %s, reset-mark %#x, learn-ttl %ss", a.queue, a.table, a.map,
        a.reset_mark, a.learn_ttl)
    q.loop(cls.on_packet, cls.inspect_probe)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
