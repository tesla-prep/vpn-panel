_ZOMBIE_SEEN = {}
_ZOMBIE_GRACE = 30.0


def _reap_orphans():
    me = os.getpid()
    return _reap_children(me) if me == 1 else 0


def _reap_children(me):
    with _RUN_LOCK:
        if _RUN_INFLIGHT:
            return 0
    now, seen, reaped = time.monotonic(), {}, 0
    try:
        entries = os.listdir("/proc")
    except OSError:
        return 0
    for ent in entries:
        if not ent.isdigit():
            continue
        pid = int(ent)
        try:
            with open("/proc/" + ent + "/stat", "rb") as f:
                fields = f.read().rsplit(b")", 1)[1].split()
            if fields[0] != b"Z" or int(fields[1]) != me:
                continue
        except (OSError, IndexError, ValueError):
            continue
        first = _ZOMBIE_SEEN.get(pid, now)
        seen[pid] = first
        if now - first < _ZOMBIE_GRACE:
            continue
        try:
            if os.waitpid(pid, os.WNOHANG)[0] == pid:
                reaped += 1
                seen.pop(pid, None)
        except ChildProcessError:
            seen.pop(pid, None)
        except OSError:
            pass
    _ZOMBIE_SEEN.clear()
    _ZOMBIE_SEEN.update(seen)
    return reaped


