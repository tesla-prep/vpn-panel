def _exit_awg(rec):
    return {k: v for k, v in ((rec or {}).get("awg") or {}).items() if k in AWG_KEYS and str(v).strip()}


def _scope_available():
    if NODE_KIND == "docker" or not os.path.isdir("/run/systemd/system") or not shutil.which("systemd-run"):
        return False
    return getattr(run(["systemd-run", "--scope", "--quiet", "--collect", "true"], timeout=15), "returncode", 1) == 0


def _scoped_up(tool, target):
    plain = [tool, "up", target]
    if not _scope_available():
        return run(plain)
    return run(["systemd-run", "--scope", "--quiet", "--collect", "--description=swg exit " + os.path.basename(target)] + plain)


def _exit_tool(rec):
    return "awg-quick" if _exit_awg(rec) else "wg-quick"


def _exit_down(dev, rec):
    if (rec or {}).get("provider") == "socks5":
        _s5x_down(str(rec.get("id") or dev[len("s5x-"):]), dev)
        return True
    kind = _link_kind(dev)
    tool = "awg-quick" if kind == "awg" else "wg-quick" if kind == "wg" else _exit_tool(rec)
    conf = os.path.join(EXIT_DIR, dev + ".conf")
    r = run([tool, "down", conf])
    if _dev_link_state(dev) != "absent":
        run(["ip", "link", "del", dev])
    return getattr(r, "returncode", 1) == 0


def _exit_dialin(rec):
    return bool(rec.get("listen_port")) and not str(rec.get("endpoint") or "").strip()


def _dialin_devices(want):
    return sorted({str(d.get("device") or "") for d in (want or {}).values()
                   if isinstance(d, dict) and _exit_dialin(d.get("profile") or {})} - {""})


def _dialin_cut(entries, exit_, troutes, net_tables):
    dl = set(_EXITS.get("dialin") or ())
    tdev = {}
    for e in entries:
        if e.get("via_iface") in dl and not e.get("_noroute"):
            tdev.setdefault(str(e["table"]), set()).add(e["via_iface"])
    out = []
    for T in sorted(tdev):
        held = [p for p, _ in troutes] if T in net_tables else []
        held += [x["subnet"] for x in exit_ if str(x.get("table")) == T and not x.get("_noroute")]
        nets = []
        for h in held:
            with contextlib.suppress(ValueError):
                nets.append(ipaddress.ip_network(h, strict=False))
        for p in EXIT_PRIVATE_CUT:
            n = ipaddress.ip_network(p)
            if not any(n.version == h.version and n.subnet_of(h) for h in nets):
                out.append((T, p))
    return out


