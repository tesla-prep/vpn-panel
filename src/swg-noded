def _service_of_pid(pid):
    try:
        with open("/proc/%s/cgroup" % pid) as f:
            m = re.search(r"(vk-turn-proxy-[^/\s.]+)", f.read())
        return m.group(1) if m else ""
    except Exception:
        return ""


_LO4_HEX = ("0100007F", "7F000001")


def _turn_wg_sports_proc(svcs):
    want = set(svcs)
    owner = {}
    with contextlib.suppress(OSError):
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            svc = _service_of_pid(pid)
            if svc not in want:
                continue
            with contextlib.suppress(OSError):
                for fd in os.listdir("/proc/%s/fd" % pid):
                    with contextlib.suppress(OSError):
                        ln = os.readlink("/proc/%s/fd/%s" % (pid, fd))
                        if ln.startswith("socket:["):
                            owner[ln[8:-1]] = svc
    out = {}
    if owner:
        with open("/proc/net/udp") as f:
            for ln in f:
                c = ln.split()
                if (len(c) > 9 and c[3] == "01" and c[9] in owner and c[1][:8] in _LO4_HEX and c[2][:8] in _LO4_HEX
                        and c[1][8:9] == ":"):
                    out.setdefault(owner[c[9]], set()).add(str(int(c[1][9:], 16)))
    return out


def _attach_turn_wg_sports(tp):
    with contextlib.suppress(Exception):
        if not tp or TURN_DOCKER:
            return
        by_svc = _turn_wg_sports_proc(sorted({t.get("service") for t in tp if t.get("service")}))
        for t in tp:
            svc = t.get("service") or ""
            if svc in by_svc:
                t["wg_sports"] = sorted(by_svc[svc])


def load_turn_proxies():
    try:
        with open(TURN_RECORD) as f:
            d = json.load(f)
        tp = d.get("turn_proxies") if isinstance(d, dict) else None
        tp = tp if isinstance(tp, list) else []
    except Exception:
        return []
    if TURN_DOCKER:
        seen = {}; uniq = []
        for t in tp:
            s = t.get("service")
            if not s:
                continue
            if s in seen:
                uniq[seen[s]] = t
            else:
                seen[s] = len(uniq); uniq.append(t)
        tp = uniq
        for t in tp:
            if _DTURN_BINDS.get(t["service"]):
                t["bind"] = _DTURN_BINDS[t["service"]]
        _dturn_attach_running(tp)
        _attach_turn_version(tp)
        _attach_turn_src_ips(tp)
        _attach_turn_wg_sports(tp)
        return tp
    nowt = time.time()
    on_disk = _list_turn_units()
    if on_disk is not None:
        rec_by = {t.get("service"): t for t in tp if t.get("service")}
        tp = [rec_by.get(svc) or {"service": svc} for svc in on_disk]
    if TURN_MANAGE_ON and (any("params" not in t for t in tp) or nowt - _TURN_READ["at"] >= 20):
        units = _read_units_live([t["service"] for t in tp if t.get("service")])
        changed = False
        for t in tp:
            u = units.get(t.get("service"))
            if not u:
                continue
            live = _tp_from_unit(t["service"], u)
            for k in ("listen", "connect", "wrap_key", "params", "bind", "bind_ip"):
                if live.get(k) is not None and t.get(k) != live.get(k):
                    t[k] = live.get(k); changed = True
        _TURN_READ["at"] = nowt
        if changed:
            with contextlib.suppress(Exception):
                tmp = TURN_RECORD + ".tmp"
                with open(tmp, "w") as f:
                    json.dump({"turn_proxies": tp}, f)
                os.replace(tmp, TURN_RECORD)
    _attach_turn_running(tp)
    _attach_turn_version(tp)
    _attach_turn_src_ips(tp)
    _attach_turn_wg_sports(tp)
    marks = _turn_installing_markers()
    if marks:
        have = {t.get("service") for t in tp}
        for svc, m in marks.items():
            if svc in have:
                for t in tp:
                    if t.get("service") == svc and t.get("running") is not True:
                        t["installing"] = True
            else:
                tp.append({"service": svc, "listen": m["listen"], "connect": m["connect"],
                           "owner": m["owner"], "running": False, "installing": True})
    with _TURN_JOBS_LOCK:
        _active = {s for s, j in _TURN_JOBS.items() if not j.get("done")}
        _fin = {s for s, j in _TURN_JOBS.items() if j.get("done")}
        for s in [s for s in _fin if time.time() - _TURN_JOBS[s].get("at", 0) > 120]:
            _TURN_JOBS.pop(s, None)
    for svc in _fin:
        NODE_PROGRESS.pop(svc, None)
    for svc in _active:
        NODE_PROGRESS[svc] = "updating…"
        if not any(t.get("service") == svc for t in tp):
            tp.append({"service": svc, "running": False, "installing": True})
        for t in tp:
            if t.get("service") == svc:
                t["installing"] = True
    return tp

TURN_FLAP_MIN = 3
TURN_FLAP_QUIET = 900
TURN_RUN_TTL = 120
_UNIT_STATES = frozenset(("active", "reloading", "refreshing", "inactive", "failed", "activating",
                          "deactivating", "maintenance"))

_TURN_RUN = {"at": 0.0, "svc": {}}
def _attach_turn_running(tps):
    svcs = {t["service"] for t in tps if t.get("service")}
    if not svcs or not TURN_MANAGE_ON:
        return
    nowt = time.time()
    st = _TURN_RUN["svc"]
    if nowt - _TURN_RUN["at"] >= 20:
        cmd = "for s in " + " ".join(shlex.quote(s) for s in sorted(svcs)) + \
              "; do printf '%s=%s=%s\\n' \"$s\" \"$(systemctl is-active \"$s\" 2>/dev/null)\" " \
              "\"$(systemctl show -p NRestarts --value \"$s\" 2>/dev/null)\"; done"
        for ln in (host_sh(cmd).stdout or "").splitlines():
            s, _, rest = ln.partition("=")
            state, _, nr = rest.partition("=")
            state, nr = state.strip(), nr.strip()
            if s not in svcs:
                continue
            r = st.setdefault(s, {"ep": None})
            if state in _UNIT_STATES:
                r["run"] = (state == "active", nowt)
            if nr.isdigit():
                n, prev, ep = int(nr), r.get("nr"), r.get("ep")
                if prev is None:
                    climb = 0
                elif n < prev[0]:
                    ep, climb = None, n
                else:
                    climb = n - prev[0]
                if climb:
                    ep = ep or {"since": nowt, "n": 0}
                    ep["n"] += climb; ep["last"] = nowt
                elif ep and nowt - ep["last"] >= TURN_FLAP_QUIET:
                    ep = None
                r["nr"] = (n, nowt); r["ep"] = ep
        for s in [s for s in st if s not in svcs]:
            del st[s]
        _TURN_RUN["at"] = nowt
    for t in tps:
        r = st.get(t.get("service"))
        if not r:
            continue
        run, nr = r.get("run"), r.get("nr")
        if run and nowt - run[1] <= TURN_RUN_TTL:
            t["running"] = run[0]
        if not (nr and nowt - nr[1] <= TURN_RUN_TTL):
            continue
        t["restarts"] = nr[0]
        if t.get("stopped"):
            r["ep"] = None
        elif r.get("ep") and r["ep"]["n"] >= TURN_FLAP_MIN:
            t["flapping"] = r["ep"]["n"]
            t["flapping_for"] = int(nowt - r["ep"]["since"])

def _turn_loop_forget(svc):
    r = _TURN_RUN["svc"].get(svc)
    if r:
