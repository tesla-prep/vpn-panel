def _gtable_load(swap, declare):
    if swap is not None:
        r = run(["nft", "-f", "-"], input_text=swap[0])
        if r.returncode == 0:
            return r, swap[1], True
    text, gen = declare()
    return run(["nft", "-f", "-"], input_text=text), gen, False


