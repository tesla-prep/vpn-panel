def _csqtt_parent_of(pid):
    pp, parts = "", []
    if NODE_KIND == "docker":
        out = (host_sh("p=$(sed 's/.*) //' /proc/%d/stat 2>/dev/null | cut -d' ' -f2); [ -n \"$p\" ] && echo \"$p\" && "
                       "base64 -w0 < /proc/$p/cmdline 2>/dev/null | head -c 8192; :" % int(pid), timeout=20).stdout or "")
        pp, _, rest = out.partition("\n")
        rest = rest.strip(); rest = rest[:len(rest) // 4 * 4]
        with contextlib.suppress(Exception):
            parts = [x.decode(errors="replace") for x in base64.b64decode(rest).split(b"\0")[:2]]
        pp = pp.strip()
    else:
        with contextlib.suppress(Exception):
            with open("/proc/%d/stat" % int(pid)) as f:
                pp = f.read().rsplit(")", 1)[1].split()[1]
            with open("/proc/%s/cmdline" % pp, "rb") as f:
                parts = [x.decode(errors="replace") for x in f.read().split(b"\0")[:2]]
    if not pp.isdigit() or int(pp) <= 1:
        return ""
    shown = (parts[0] if parts and parts[0] else "?")
    if len(parts) > 1 and parts[1]:
        _p1 = parts[1]
        shown += " " + _p1 if not (_p1.startswith("-") or "=" in _p1 or any(c.isspace() for c in _p1)) else " …"
    return "pid %s `%s`" % (pp, shown[:120])


def _csqtt_came_back(pid):
