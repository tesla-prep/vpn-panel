def _swg_reexec(hold_sighup=False):
    if __name__ != "__main__":
        return
    if globals().get("_SWG_REEXEC") or _SWG_LOADER in getattr(sys, "orig_argv", ()):
        name = globals().get("_SWG_COMM")
        if name:
            try:
                with open("/proc/self/comm") as f:
                    now = f.read().strip()
                if now != name:
                    with open("/proc/self/comm", "w") as f:
                        f.write(name)
            except Exception:
                pass
        return
    if os.environ.get("SWG_NO_REEXEC"):
        return
    script = globals().get("__file__")
    if not (script and sys.executable and sys.argv and os.path.isfile(script)
            and os.path.realpath(sys.argv[0]) == os.path.realpath(script)):
        return
    if hasattr(sys, "orig_argv"):
        if sys.orig_argv[1:] != sys.argv:
            return
    else:
        try:
            import subprocess
            if subprocess._args_from_interpreter_flags():
                return
        except Exception:
            return
        if getattr(sys.stdout, "write_through", False) and not os.environ.get("PYTHONUNBUFFERED"):
            return
    try:
        with open("/proc/self/comm") as f:
            comm = f.read().strip()
    except Exception:
        comm = ""
    held = None
    if hold_sighup:
        import signal
        held = signal.getsignal(signal.SIGHUP)
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    try:
        os.execv(sys.executable, [sys.executable, "-c", _SWG_LOADER, sys.path[0] if sys.path else "", comm, script]
                 + sys.argv[1:])
    except OSError:
        if held is not None:
            signal.signal(signal.SIGHUP, held)


_swg_reexec()

