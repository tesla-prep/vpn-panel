DPKG_STATUS = "/var/lib/dpkg/status"
DPKG_UPDATES = "/var/lib/dpkg/updates"
DPKG_LOCKS = ("/var/lib/dpkg/lock", "/var/lib/dpkg/lock-frontend")
PROC_LOCKS = "/proc/locks"
DPKG_SETTLE = 600
DPKG_RECHECK = 1800
DPKG_BLOCKING = ("half configured", "half installed", "unpacked but not yet configured", "in a mess")
DPKG_PEEK = 60
_DPKG = {"mtime": None, "at": 0.0, "v": None, "peek": 0.0}


def _dpkg_busy():
    ids = set()
    for p in DPKG_LOCKS:
        with contextlib.suppress(OSError):
            st = os.stat(p)
            ids.add("%02x:%02x:%d" % (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino))
    try:
        with open(PROC_LOCKS) as f:
            return bool(ids) and any(x in ids for ln in f for x in ln.split())
    except OSError:
        return False


def dpkg_health(now=None):
    if NODE_KIND == "docker" or not shutil.which("dpkg"):
        return None
    try:
        mt = os.stat(DPKG_STATUS).st_mtime
    except OSError:
        return None
    with contextlib.suppress(OSError):
        mt = max(mt, os.stat(DPKG_UPDATES).st_mtime)
    now = now or time.time()
    if _DPKG["v"] is not None and mt == _DPKG["mtime"] and now - _DPKG["at"] < DPKG_RECHECK:
        return dict(_DPKG["v"])
    if now - mt < DPKG_SETTLE or _dpkg_busy():
        last = _DPKG["v"]
        if last and (last["pending"] or last["interrupted"]) and now - _DPKG["peek"] >= DPKG_PEEK:
            _DPKG["peek"] = now
            v = _dpkg_audit()
            if v is not None and not v["pending"] and not v["interrupted"]:
                _DPKG.update(mtime=mt, at=now, v=v)
        return dict(_DPKG["v"] or {"pending": [], "interrupted": False})
    v = _dpkg_audit()
    if v is None:
        return dict(_DPKG["v"]) if _DPKG["v"] is not None else None
    _DPKG.update(mtime=mt, at=now, v=v)
    return dict(_DPKG["v"])


def _dpkg_audit():
    r = run(["dpkg", "--audit"], timeout=15, env=dict(os.environ, LC_ALL="C"))
    if r.returncode not in (0, 1):
        return None
    pend, take = [], False
    for ln in (r.stdout or "").splitlines():
        if ln.startswith("The following packages"):
            take = any(w in ln for w in DPKG_BLOCKING)
            continue
        m = re.match(r"^ ([a-z0-9][a-z0-9+.:-]{0,100})\s", ln)
        if take and m and m.group(1) not in pend:
            pend.append(m.group(1))
    intr = False
    with contextlib.suppress(OSError):
        intr = any(n.isdigit() for n in os.listdir(DPKG_UPDATES))
    return {"pending": pend[:20], "interrupted": intr}


def _dpkg_part():
