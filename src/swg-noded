def sample_cats():
    t = _smart_table()
    if t["rc"] != 0:
        _CATS["rate"] = {}
        return {}
    cum = t["bytes"]
    now = time.time()
    prev, pt = _CATS["cum"], _CATS["t"]
    if prev and now > pt:
        dt = now - pt
        r = {}
        for cat, v in cum.items():
            if str(cat).startswith("blku"):
                continue
            p = prev.get(cat) or {}
            r[cat] = {"up": max(0.0, v.get("up", 0) - p.get("up", 0)) / dt,
                      "dn": max(0.0, v.get("dn", 0) - p.get("dn", 0)) / dt}
        _CATS["rate"] = r
    _CATS["cum"] = cum
    _CATS["t"] = now
    return dict(_CATS["rate"])


