            ep = str(p.get("endpoint")).strip()
            pk = str(p.get("public_key") or p.get("pubkey") or "").strip()
            break
    if not ep and conf:
        with contextlib.suppress(Exception):
            for ln in open(conf):
                m = re.match(r"(?i)\s*Endpoint\s*=\s*(.+)", ln)
                if m and not ep:
                    ep = m.group(1).strip()
                m = re.match(r"(?i)\s*PublicKey\s*=\s*(.+)", ln)
                if m and not pk:
                    pk = m.group(1).strip()
    return {"name": name, "proto": proto, "up": bool(up), "address": addr or "",
            "endpoint": ep, "peer_key": pk, "conf": conf or "",
            "boot_persist": iface_boot_persists(name, [proto or "wg"])}


