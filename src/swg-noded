def _csqtt_read_store(cfgdir, line=""):
    jp = os.path.join(cfgdir, "passwords.json")
    if os.path.isfile(jp):
        with contextlib.suppress(Exception):
            with open(jp) as f:
                return json.load(f) or {}
        return {}
    dbp = os.path.join(cfgdir, "csqtt.db")
    if not os.path.isfile(dbp):
        return {}
    pwds, devs = {}, {}
    with contextlib.suppress(Exception):
        import sqlite3
        c = sqlite3.connect(dbp, timeout=5)
        try:
            cols = {r[1] for r in c.execute("PRAGMA table_info(passwords)")}
            if "device_id" in cols and ((line or "2.1") == "2.1" or "ip" not in cols):
                for pw, did, exp, up, dn, deact, name, vkh in c.execute(
                        "SELECT password, device_id, expires_at, up_bytes, down_bytes, is_deactivated, name, vk_hash "
                        "FROM passwords"):
                    pwds[str(pw)] = {"device_id": did or "", "expires_at": exp or 0,
                                     "up_bytes": up or 0, "down_bytes": dn or 0,
                                     "is_deactivated": bool(deact), "name": name or "", "vk_hash": vkh or ""}
                for did, ip, pub in c.execute("SELECT device_id, ip, pub_key FROM devices"):
                    devs[str(did)] = {"ip": ip or "", "pub_key": pub or ""}
            else:
                for pw, ip, exp, up, dn, deact, name, vkh in c.execute(
                        "SELECT password, ip, expires_at, up_bytes, down_bytes, is_deactivated, name, vk_hash "
                        "FROM passwords"):
                    pwds[str(pw)] = {"device_id": "", "ip": ip or "", "expires_at": exp or 0,
                                     "up_bytes": up or 0, "down_bytes": dn or 0,
                                     "is_deactivated": bool(deact), "name": name or "", "vk_hash": vkh or ""}
        finally:
            c.close()
    return {"passwords": pwds, "devices": devs}


def _csqtt_users_from_text(raw):
    out = {}
    with contextlib.suppress(Exception):
        data = json.loads(raw)
        src = data.get("passwords") if isinstance(data, dict) and isinstance(data.get("passwords"), dict) else data
        if isinstance(src, dict):
            for pw, e in src.items():
                if not pw or not isinstance(e, dict):
                    continue
                out[str(pw)] = {"vk_hash": str(e.get("vk_hash") or "").strip(),
                                "expires_at": int(e.get("expires_at") or 0),
                                "is_deactivated": bool(e.get("is_deactivated")),
                                "comment": str(e.get("name") or e.get("comment") or "").strip()[:80]}
    return out


def _csqtt_users_from_db(dbpath):
    stage = None
    try:
        stage = tempfile.mkdtemp(prefix="csqttdb-")
        for _f in _CSQTT_DB_FILES:
            _src = os.path.join(os.path.dirname(dbpath), _f)
            if os.path.isfile(_src):
                shutil.copy2(_src, os.path.join(stage, _f))
        return _csqtt_db_users(stage)
    except Exception:
        return {}, False
    finally:
        if stage:
            shutil.rmtree(stage, ignore_errors=True)


def _csqtt_users_from_db_tar(blob):
    stage = None
    try:
        stage = tempfile.mkdtemp(prefix="csqttdb-")
        with tarfile.open(fileobj=io.BytesIO(blob), mode="r:") as tf:
            for m in tf.getmembers():
                if m.isfile() and os.path.basename(m.name) in _CSQTT_DB_FILES:
                    m.name = os.path.basename(m.name)
                    tf.extract(m, stage)
        return _csqtt_db_users(stage)
    except Exception:
        return {}, False
    finally:
        if stage:
            shutil.rmtree(stage, ignore_errors=True)


def _csqtt_db_users(stage):
