LOG_DROPIN_DIR = "/run/systemd/system"
LOG_DROPIN_FILE = "swg-log.conf"
LOG_DROPIN_UNITS = ("vk-turn-proxy-.service", "swg-wdtt-.service", "swg-csqtt-.service")
_LOG_FOLLOWED = {"lvl": None, "units": None, "err": None}


def log_unit_max(lvl):
    return "emerg" if lvl == LOG_OFF else "warning" if lvl < LOG_INFO else None


def log_no_detail():
    lvl = log_level()
    if lvl >= LOG_INFO:
        return ""
    return "its own lines are not kept (logging is %s)" % (
        "off" if lvl == LOG_OFF else "set to errors" if lvl == LOG_ERR else "set to warnings")


def _log_follow(node_cfg):
    lvl = log_level()
    if (lvl, _LOG["level"]) != _LOG_FOLLOWED["lvl"]:
        try:
            with open(LOG_LEVEL_FILE + ".tmp", "w") as f:
                f.write("%d %d\n" % (lvl, _LOG["level"]))
            os.replace(LOG_LEVEL_FILE + ".tmp", LOG_LEVEL_FILE)
            _LOG_FOLLOWED["lvl"] = (lvl, _LOG["level"])
        except OSError as e:
            log(LOG_WARNING, "log level: could not write %s: %s", LOG_LEVEL_FILE, e)
    _log_budget()
    _log_ns_move()
    if NODE_KIND == "docker" or not os.path.isdir(LOG_DROPIN_DIR):
        return
    cap = log_unit_max(lvl)
    units = list(LOG_DROPIN_UNITS) + sorted("%s-quick@%s.service" % ((ic.get("cmd") or ["awg"])[0], ifn)
                                            for ifn, ic in (node_cfg.get("interfaces") or {}).items()
                                            if isinstance(ic, dict))
    if (cap, units) == _LOG_FOLLOWED["units"]:
        return
    want = ("[Service]\nLogLevelMax=%s\n" % cap) if cap else None
    paths = {os.path.join(LOG_DROPIN_DIR, u + ".d", LOG_DROPIN_FILE) for u in units}
    with contextlib.suppress(OSError):
        for d in os.listdir(LOG_DROPIN_DIR):
            if re.match(r"^a?wg-quick@.+\.service\.d$", d) and os.path.exists(os.path.join(LOG_DROPIN_DIR, d, LOG_DROPIN_FILE)):
                paths.add(os.path.join(LOG_DROPIN_DIR, d, LOG_DROPIN_FILE))
    keep = {os.path.join(LOG_DROPIN_DIR, u + ".d", LOG_DROPIN_FILE) for u in units}
    changed, err = 0, None
    for p in sorted(paths):
        try:
            with open(p) as f:
                have = f.read()
        except OSError:
            have = None
        target = want if p in keep else None
        if have == target:
            continue
        try:
            if target is None:
                os.unlink(p)
                with contextlib.suppress(OSError):
                    os.rmdir(os.path.dirname(p))
            else:
                os.makedirs(os.path.dirname(p), exist_ok=True)
                with open(p + ".tmp", "w") as f:
                    f.write(target)
                os.replace(p + ".tmp", p)
            changed += 1
        except OSError as e:
            err = "%s: %s" % (p, e)
    if changed:
        r = run(["systemctl", "daemon-reload"])
        if r.returncode != 0:
            err = err or "daemon-reload: " + (r.stderr or "").strip()[:160]
        log(LOG_INFO, "log level: %d unit drop-in(s) %s — each unit takes it at its next start",
            changed, ("set to LogLevelMax=" + cap) if cap else "removed")
    if err:
        if err != _LOG_FOLLOWED["err"]:
            log(LOG_WARNING, "log level: %s — retried on every pass, said once", err)
        _LOG_FOLLOWED["err"] = err
    else:
        _LOG_FOLLOWED["units"], _LOG_FOLLOWED["err"] = (cap, units), None



LOG_NS = "swg-node"
LOG_MB_DEFAULT, LOG_MB_MIN = 100, 16
LOG_NS_CONF = "/run/systemd/journald@%s.conf.d/swg.conf" % LOG_NS
LOG_NS_DROPIN = "swg-ns.conf"
LOG_NS_UNITS = ("swg-relay@.service", "vk-turn-proxy-.service", "swg-wdtt-.service", "swg-csqtt-.service")
LOG_DIR_DOCKER = os.path.join(STATE_DIR, "log")
LOG_STATUS_EVERY_S = 60
LOG_BUDGET_FILE = os.path.join(STATE_DIR, "log-budget")


def _log_budget_boot():
    try:
        with open(LOG_BUDGET_FILE) as f:
            return max(LOG_MB_MIN, int(f.read().strip()))
    except (OSError, ValueError):
        return LOG_MB_DEFAULT


_LOG_BUDGET = {"mb": _log_budget_boot(), "ns": None, "conf": None, "applied": None, "err": None, "status": None, "at": 0.0,
               "retry_at": 0.0, "retry_want": None}
_JOURNAL_NAME_RE = re.compile(r"^[\w-]+@[0-9a-f]{32}-[0-9a-f]{16}-([0-9a-f]{16})\.journal$")


def log_ns_ok():
    if _LOG_BUDGET["ns"] is None:
        _LOG_BUDGET["ns"] = (NODE_KIND != "docker" and os.path.isdir("/run/systemd/system")
                             and any(os.path.exists(os.path.join(d, "systemd-journald@.service"))
                                     for d in ("/etc/systemd/system", "/run/systemd/system", "/usr/lib/systemd/system",
                                               "/lib/systemd/system"))
                             and not _log_ns_refused())
    return _LOG_BUDGET["ns"]


LOG_NS_ANSWER = os.environ.get("SWG_LOG_NS_PROBE") or "/var/lib/swg-log-ns"


def _log_ns_refused():
    with contextlib.suppress(OSError):
        with open(LOG_NS_ANSWER) as f:
            _LOG_BUDGET["ns_refused"] = f.read().strip() == "refused"
    return bool(_LOG_BUDGET.get("ns_refused"))


JOURNAL_SKIP_PID1 = ("grep -vE '\\.service: (Failed with result|Main process exited|Control process exited|Unit entered failed"
                     " state|Scheduled restart job)|^Failed to start ' | ")


def journal_cmd():
    return "journalctl --namespace=+" + LOG_NS if log_ns_ok() else "journalctl"


def _log_ns_dropins():
    if not log_ns_ok():
        if _LOG_BUDGET.get("ns_refused"):
            gone = 0
            for udir in (UNIT_DIR_PERSIST, UNIT_DIR_RUNTIME):
                for u in LOG_NS_UNITS:
                    p = os.path.join(udir, u + ".d", LOG_NS_DROPIN)
                    with contextlib.suppress(OSError):
                        os.remove(p)
                        gone += 1
                        with contextlib.suppress(OSError):
                            os.rmdir(os.path.dirname(p))
            if gone:
                run(["systemctl", "daemon-reload"])
                log(LOG_NOTICE, "log budget: %d LogNamespace drop-in(s) removed — no unit can run in a journal namespace here",
                    gone)
        return
    udir = UNIT_DIR_PERSIST if unit_dir_persists() else UNIT_DIR_RUNTIME
    want, changed = "[Service]\nLogNamespace=%s\n" % LOG_NS, 0
    for u in LOG_NS_UNITS:
        p = os.path.join(udir, u + ".d", LOG_NS_DROPIN)
        try:
            with open(p) as f:
                if f.read() == want:
                    continue
        except OSError:
            pass
        try:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p + ".tmp", "w") as f:
                f.write(want)
            os.replace(p + ".tmp", p)
            changed += 1
        except OSError as e:
            log(LOG_WARNING, "log budget: %s not written: %s", p, e)
    if changed:
        run(["systemctl", "daemon-reload"])
        log(LOG_INFO, "log budget: %d kind(s) of unit log into the %s journal from their next start", changed, LOG_NS)


RESTART_DROPIN = "swg-restart.conf"
RESTART_FAMILIES = ("vk-turn-proxy-.service", "swg-wdtt-.service", "swg-csqtt-.service")


def _restart_dropins():
    if NODE_KIND == "docker":
        return
    m = re.match(r"systemd (\d+)", run(["systemctl", "--version"], timeout=10).stdout or "")
    if not m or int(m.group(1)) >= 254:
        return
    udir = UNIT_DIR_PERSIST if unit_dir_persists() else UNIT_DIR_RUNTIME
    want, changed = "[Service]\nRestartSec=30\n", 0
    for u in RESTART_FAMILIES:
        p = os.path.join(udir, u + ".d", RESTART_DROPIN)
        with contextlib.suppress(OSError):
            with open(p) as f:
                if f.read() == want:
                    continue
        with contextlib.suppress(OSError):
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p + ".tmp", "w") as f:
                f.write(want)
            os.replace(p + ".tmp", p)
            changed += 1
    if changed:
        run(["systemctl", "daemon-reload"])
        log(LOG_INFO, "restart back-off: systemd %s ignores RestartSteps= — turn / WDTT / csqtt units restart every 30 s", m.group(1))


_LOG_NS_MOVE = {"sched": {}, "at": 0.0, "day": None}


def _log_ns_unmoved():
    out = []
    if not log_ns_ok():
        return out
    udir = UNIT_DIR_PERSIST if unit_dir_persists() else UNIT_DIR_RUNTIME
    written = {}
    for fam in LOG_NS_UNITS:
        with contextlib.suppress(OSError):
            written[fam[:-len(".service")]] = os.stat(os.path.join(udir, fam + ".d", LOG_NS_DROPIN)).st_mtime
    if not written:
        return out
    with contextlib.suppress(Exception):
        r = run(["systemctl", "list-units", "--no-legend", "--plain", "--type=service", "--state=active"]
                + [p + "*.service" for p in written], timeout=15)
        units = [ln.split()[0] for ln in (r.stdout or "").splitlines() if ln.strip()]
        if not units:
            return out
        r = run(["systemctl", "show", "-p", "Id", "-p", "ActiveEnterTimestampMonotonic"] + units, timeout=15)
        mono, wall = time.monotonic(), time.time()
        for blk in (r.stdout or "").split("\n\n"):
            kv = dict(ln.split("=", 1) for ln in blk.splitlines() if "=" in ln)
            uid, us = kv.get("Id", ""), kv.get("ActiveEnterTimestampMonotonic", "")
            fam = next((p for p in written if uid.startswith(p)), None)
            if fam and us.isdigit() and int(us) > 0:
                started = wall - (mono - int(us) / 1e6)
                if started < written[fam] - 1:
                    out.append(uid)
    return out


def _log_ns_move():
    now = time.time()
    if now - _LOG_NS_MOVE["at"] < LOG_STATUS_EVERY_S:
        return
    _LOG_NS_MOVE["at"] = now
    sched = dict(_LOG_NS_MOVE["sched"] or {})
    if str(sched.get("every_days", 1)) == "0":
        sched["every_days"] = 1
    day = time.strftime("%Y-%m-%d")
    if _LOG_NS_MOVE["day"] == day or not _in_quiet_window(sched):
        return
    units = _log_ns_unmoved()
    if not units:
        return
    _LOG_NS_MOVE["day"] = day
    r = run(["systemctl", "restart", "--no-block"] + units, timeout=30)
    if r.returncode == 0:
        log(LOG_INFO, "log budget: restarting %s in the update window — started before their drop-in, they wrote the "
            "main journal; from now on the %s one", " ".join(units), LOG_NS)
    else:
        log(LOG_WARNING, "log budget: restarting %s in the update window failed (%s) — tried again in the next window",
            " ".join(units), (r.stderr or r.stdout or "").strip()[:160])


def _log_ns_dir():
    try:
        with open("/etc/machine-id") as f:
            return "/var/log/journal/%s.%s" % (f.read().strip(), LOG_NS)
    except OSError:
        return None


def _log_dir_usage(d, journal):
    used, oldest = 0, None
    with contextlib.suppress(OSError):
        for n in os.listdir(d):
            with contextlib.suppress(OSError):
                st = os.stat(os.path.join(d, n))
                used += st.st_blocks * 512
            m = _JOURNAL_NAME_RE.match(n) if journal else None
            if m:
                t = int(m.group(1), 16) // 1000000
                oldest = t if oldest is None else min(oldest, t)
    if journal and oldest is None:
        oldest = _journal_head(os.path.join(d, "system.journal"))
    return used, oldest


def _journal_head(path):
    with contextlib.suppress(OSError, struct.error):
        with open(path, "rb") as f:
            h = f.read(192)
        if h[:8] == b"LPKSHHRH":
            return struct.unpack_from("<Q", h, 184)[0] // 1000000 or None
    return None


def _log_file_oldest(path):
    for p in (path + ".1", path):
        with contextlib.suppress(OSError, ValueError, UnicodeDecodeError):
            with open(p, "rb") as f:
                return _live_cal.timegm(time.strptime(f.read(20).decode(), "%Y-%m-%dT%H:%M:%SZ"))
    return None


def _supervised_logs():
    out = []
    for root in (WDTT_ROOT, CSQTT_ROOT):
        with contextlib.suppress(OSError):
            out += [os.path.join(root, name, "server.log") for name in os.listdir(root)]
    with contextlib.suppress(OSError):
        out += [os.path.join(EXIT_DIR, n) for n in os.listdir(EXIT_DIR) if n.startswith("s5x-") and n.endswith(".log")]
    return out


def _log_docker_caps(mb):
    if log_level() == LOG_OFF:
        return 0
    n = 2 + len(_turn_record_raw()) + len(_RELAY) + len(_supervised_logs())
    return max(1 << 20, (mb << 20) // n)


def docker_log_opts():
    cap = _log_docker_caps(_LOG_BUDGET["mb"])
    if not cap:
        return ["--log-driver", "none"]
    return ["--log-driver", "json-file", "--log-opt", "max-size=%dk" % max(512, cap // 2048), "--log-opt", "max-file=2"]


def _log_budget():
    mb, off = _LOG_BUDGET["mb"], log_level() == LOG_OFF
    now = time.time()
    if NODE_KIND == "docker":
        cap = _log_docker_caps(mb)
        log_file(os.path.join(LOG_DIR_DOCKER, "swg-noded.log"), cap)
        _LOG_BUDGET["applied"], _LOG_BUDGET["err"] = mb, None
        if (now - _LOG_BUDGET["at"] >= LOG_STATUS_EVERY_S or _LOG_BUDGET["status"] is None
                or _LOG_BUDGET["status"].get("mb") != mb):
            used, _o = _log_dir_usage(LOG_DIR_DOCKER, False)
            for p in _supervised_logs():
                for f in (p, p + ".1"):
                    with contextlib.suppress(OSError):
                        used += os.stat(f).st_blocks * 512
            st = {"mb": mb, "used_mb": round(used / 1048576.0, 1)}
            oldest = _log_file_oldest(os.path.join(LOG_DIR_DOCKER, "swg-noded.log"))
            if oldest:
                st["oldest"] = oldest
            _LOG_BUDGET["status"], _LOG_BUDGET["at"] = st, now
        return
    if not log_ns_ok():
        _LOG_BUDGET["status"] = {"mb": mb, "err": "a unit cannot run in a journal namespace here (mount namespaces are refused)"
                                 if _LOG_BUDGET.get("ns_refused") else "this system's journald has no namespaces",
                                 "unsupported": True}
        return
    want = "[Journal]\nStorage=%s\nSystemMaxUse=%dM\nRuntimeMaxUse=%dM\n" % ("none" if off else "persistent", mb, mb)
    if _LOG_BUDGET["conf"] is None:
        _LOG_BUDGET["conf"] = ""
        with contextlib.suppress(OSError):
            with open(LOG_NS_CONF) as f:
                _LOG_BUDGET["conf"] = f.read()
        m = re.search(r"^SystemMaxUse=(\d+)M$", _LOG_BUDGET["conf"], re.M)
        _LOG_BUDGET["applied"] = int(m.group(1)) if m else None
    if _LOG_BUDGET["conf"] == want and _LOG_BUDGET["err"]:
        _LOG_BUDGET["err"], _LOG_BUDGET["retry_want"], _LOG_BUDGET["at"] = None, None, 0.0
    if _LOG_BUDGET["conf"] != want and (now >= _LOG_BUDGET["retry_at"] or want != _LOG_BUDGET["retry_want"]):
        err = None
        try:
            os.makedirs(os.path.dirname(LOG_NS_CONF), exist_ok=True)
            with open(LOG_NS_CONF + ".tmp", "w") as f:
                f.write(want)
            os.replace(LOG_NS_CONF + ".tmp", LOG_NS_CONF)
        except OSError as e:
            err = "%s: %s" % (LOG_NS_CONF, e)
        if not err:
            r = run(["systemctl", "try-restart", "systemd-journald@%s.service" % LOG_NS], timeout=20)
            if r.returncode != 0:
                err = "journald@%s did not restart: %s" % (LOG_NS, (r.stderr or "").strip()[:160])
                try:
                    if not _LOG_BUDGET["conf"]:
                        os.remove(LOG_NS_CONF)
                    else:
                        with open(LOG_NS_CONF + ".tmp", "w") as f:
                            f.write(_LOG_BUDGET["conf"])
                        os.replace(LOG_NS_CONF + ".tmp", LOG_NS_CONF)
                except OSError as e:
                    err += "; the previous size file could not be put back (%s)" % e
        _LOG_BUDGET["at"] = 0.0
        _LOG_BUDGET["retry_at"], _LOG_BUDGET["retry_want"] = (now + LOG_STATUS_EVERY_S, want) if err else (0.0, None)
        if err:
            if err != _LOG_BUDGET["err"]:
                log(LOG_WARNING, "log budget: %s — tried again once a minute, said once", err)
            _LOG_BUDGET["err"] = err
        else:
            if off:
                d = _log_ns_dir()
                with contextlib.suppress(OSError):
                    for n in (os.listdir(d) if d else ()):
                        if ".journal" in n:
                            with contextlib.suppress(OSError):
                                os.remove(os.path.join(d, n))
            _LOG_BUDGET["conf"], _LOG_BUDGET["applied"], _LOG_BUDGET["err"] = want, mb, None
