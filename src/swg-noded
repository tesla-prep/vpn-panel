import calendar as _live_cal

LIVE_BACKFILL, LIVE_BACKFILL_MAX, LIVE_BACKFILL_S, LIVE_BACKFILL_WAIT = 200, 1000, 1.0, 10.0
LIVE_TEXT_MAX = 4096
LIVE_TAIL_BYTES = 256 << 10
LIVE_FIELDS = "MESSAGE,PRIORITY,_SYSTEMD_UNIT,UNIT,SYSLOG_IDENTIFIER,_TRANSPORT,_PID"
_LIVE_UNIT_SRC = {"swg-panel-server": "panel", "swg-sub": "sub", "swg-netctl": "netctl", "swg-update": "update"}
_LIVE_PANEL_KINDS = ("panel", "sub", "netctl", "update")
LIVE_MESH_PRE = "swg_"
_LIVE_UNIT_PRE = (("swg-relay@", "relay:"), ("vk-turn-proxy-", "turn:"), ("swg-wdtt-", "turn:"), ("swg-csqtt-", "turn:"),
                  ("wg-quick@", "iface:"), ("awg-quick@", "iface:"))
_LIVE_OURS = re.compile(r"^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)Z ([EWNID]) ?")
_LIVE_SYSLOG = re.compile(r"^([A-Z][a-z]{2}) +(\d+) (\d\d):(\d\d):(\d\d) (?:[\w.-]+\[\d+\]: )?")
_LIVE_STAMP = re.compile(r"^(\d{4})[/-](\d\d)[/-](\d\d)[ T](\d\d):(\d\d):(\d\d)(?:[.,](\d+))?Z? ?")
_LIVE_RFC = re.compile(r"^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.(\d{1,9}))?Z ")
_LIVE_MON = {m: i for i, m in enumerate(("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov",
                                          "Dec"), 1)}
_LIVE_LETTER = {"E": 3, "W": 4, "N": 5, "I": 6, "D": 7}


def live_want(src, want):
    return src in want or (":" in src and src.split(":", 1)[0] + ":*" in want)


def live_journal_src(e):
    if e.get("_TRANSPORT") == "kernel":
        return "p2p" if "swg-p2p" in live_text(e.get("MESSAGE")) else "kernel"
    u = (e.get("UNIT") if e.get("_PID") == "1" else e.get("_SYSTEMD_UNIT")) or ""
    if not isinstance(u, str) or not u.endswith(".service"):
        return None
    n = u[:-8]
    if n == "swg-noded":
        if e.get("SYSLOG_IDENTIFIER") == "dnsmasq":
            return "dns"
        return "sni" if live_text(e.get("MESSAGE")).startswith("swg-sni:") else "noded"
    if n in _LIVE_UNIT_SRC:
        return _LIVE_UNIT_SRC[n]
    for pre, kind in _LIVE_UNIT_PRE:
        if n.startswith(pre) and len(n) > len(pre):
            name = n[len(pre):]
            return ("mesh:" if kind == "iface:" and name.startswith(LIVE_MESH_PRE) else kind) + name
    return None


def live_text(m):
    if isinstance(m, list):
        with contextlib.suppress(Exception):
            return bytes(m).decode("utf-8", "replace")
        return ""
    return m if isinstance(m, str) else ""


def live_journal_argv(base, units, kernel, cursor, n):
    a = list(base) + ["-f", "--no-pager", "-o", "json", "--output-fields=" + LIVE_FIELDS]
    a += ["--after-cursor=" + cursor] if cursor else ["-n", str(n)]
    return a + live_journal_matches(units, kernel)


def live_journal_matches(units, kernel):
    a, groups = [], []
    if units:
        groups += [["_SYSTEMD_UNIT=" + u for u in units], ["_PID=1"] + ["UNIT=" + u for u in units]]
    if kernel:
        groups.append(["_TRANSPORT=kernel"])
    for i, g in enumerate(groups):
        a += (["+"] if i else []) + g
    return a


def live_journal_line(e, want):
    src = live_journal_src(e)
    if src == "p2p" and not live_want(src, want) and "kernel" in want:
        src = "kernel"
    if not src:
        return None
    try:
        t, prio = int(e.get("__REALTIME_TIMESTAMP")), int(e.get("PRIORITY", 6))
    except (TypeError, ValueError):
        t, prio = int(time.time() * 1000000), 6
    return [t, src, prio, live_text(e.get("MESSAGE"))[:LIVE_TEXT_MAX]]


def _live_utc(y, mo, d, h, mi, s):
    return _live_cal.timegm((int(y), int(mo), int(d), int(h), int(mi), int(s), 0, 0, 0))


def live_parse_line(fmt, raw, last_t):
    if fmt == "ours":
        m = _LIVE_OURS.match(raw)
        if m:
            return _live_utc(*m.groups()[:6]) * 1000000, _LIVE_LETTER[m.group(7)], raw[m.end():]
    elif fmt == "syslog":
        m = _LIVE_SYSLOG.match(raw)
        if m and m.group(1) in _LIVE_MON:
            now = time.localtime()
            with contextlib.suppress(OverflowError, ValueError):
                t = time.mktime((now.tm_year, _LIVE_MON[m.group(1)], int(m.group(2)), int(m.group(3)), int(m.group(4)),
                                 int(m.group(5)), 0, 0, -1))
                if t > time.time() + 86400:
                    t = time.mktime((now.tm_year - 1, _LIVE_MON[m.group(1)], int(m.group(2)), int(m.group(3)),
                                     int(m.group(4)), int(m.group(5)), 0, 0, -1))
                return int(t) * 1000000, 6, raw[m.end():]
    else:
        m = _LIVE_STAMP.match(raw)
        if m:
            with contextlib.suppress(OverflowError, ValueError):
                t = time.mktime(tuple(int(x) for x in m.groups()[:6]) + (0, 0, -1))
                return int(t * 1000000) + int(((m.group(7) or "") + "000000")[:6]), 6, raw[m.end():]
    return last_t or int(time.time() * 1000000), 6, raw


class _LiveFile:

    def __init__(self, path, src, fmt, cur):
        self.path, self.src, self.fmt = path, src, fmt
        self.f, self.ino, self.buf, self.t, self.out, self.gap = None, None, b"", 0, [], False
        ino, off = cur if (isinstance(cur, list) and len(cur) == 2
                           and all(isinstance(x, int) and not isinstance(x, bool) for x in cur)) else (0, -1)
        if ino and off >= 0:
            with contextlib.suppress(OSError):
                st = os.stat(path)
                if st.st_ino == ino and st.st_size >= off:
                    self._open(off)
                    return
            with contextlib.suppress(OSError):
                with open(path + ".1", "rb") as f:
                    if os.fstat(f.fileno()).st_ino == ino:
                        f.seek(off)
                        self._lines(f.read(LIVE_TAIL_BYTES * 4))
                        self.buf = b""
                        self._open(0)
                        return
            self.gap = True
        self._open(None)
        if self.f is not None and os.fstat(self.f.fileno()).st_size < LIVE_TAIL_BYTES:
            with contextlib.suppress(OSError):
                with open(path + ".1", "rb") as f:
                    size = os.fstat(f.fileno()).st_size
                    f.seek(max(0, size - LIVE_TAIL_BYTES))
                    if size > LIVE_TAIL_BYTES:
                        f.readline()
                    self._lines(f.read(LIVE_TAIL_BYTES))
                    self.buf = b""

    def _open(self, off):
        try:
            self.f = open(self.path, "rb")
        except OSError:
            self.f = self.ino = None
            return
        size = os.fstat(self.f.fileno()).st_size
        self.ino = os.fstat(self.f.fileno()).st_ino
        if off is None:
            self.f.seek(max(0, size - LIVE_TAIL_BYTES))
            if size > LIVE_TAIL_BYTES:
                self.f.readline()
        else:
            self.f.seek(min(off, size))

    def _lines(self, data):
        self.buf += data
        *done, self.buf = self.buf.split(b"\n")
        for raw in done:
            if raw:
                t, prio, text = live_parse_line(self.fmt, raw.decode("utf-8", "replace"), self.t)
                self.t = t
                self.out.append([t, self.src(text) if callable(self.src) else self.src, prio, text[:LIVE_TEXT_MAX]])

    def read(self):
        if self.f is None:
            self._open(0)
        if self.f is not None:
            with contextlib.suppress(OSError):
                self._lines(self.f.read(LIVE_TAIL_BYTES))
                st = os.stat(self.path)
                moved = st.st_ino != self.ino
                if moved:
                    self._lines(self.f.read())
                    self.f.close()
                    self.buf = b""
                    self._open(0)
                elif st.st_size < self.f.tell():
                    self.f.seek(0)
                    self.buf, moved = b"", True
                if moved and self.f is not None:
                    self._lines(self.f.read(LIVE_TAIL_BYTES))
        out, self.out = self.out, []
        return out

    def cursor(self):
        with contextlib.suppress(OSError, ValueError):
            if self.f is not None and self.ino:
                return [self.ino, self.f.tell() - len(self.buf)]
        return None

    def close(self):
        if self.f is not None:
            with contextlib.suppress(OSError):
                self.f.close()


def live_noded_src(text):
    return "sni" if text.startswith("swg-sni:") else "noded"


class _LiveCtr:

    def __init__(self, sock_path, name, src, cur, q=None):
        self.name, self.src, self.raw, self.buf = name, src, b"", b""
        self.last = cur if isinstance(cur, int) and cur > 0 else 0
        self.s, self.head, self.done, self.at = None, True, False, time.monotonic()
        q = q or "follow=1&stdout=1&stderr=1&timestamps=1" + (
            "&since=%d.%09d" % divmod(self.last, 1000000000) if self.last else "&tail=%d" % LIVE_BACKFILL)
        try:
            self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.s.settimeout(5)
            self.s.connect(sock_path)
            self.s.sendall(("GET /containers/%s/logs?%s HTTP/1.0\r\nHost: docker\r\n\r\n" % (name, q)).encode())
            self.s.setblocking(False)
        except OSError:
            self.close()
            self.done = True

    def fileno(self):
        return self.s.fileno()

    def read(self):
        out = []
        try:
            while True:
                d = self.s.recv(65536)
                if not d:
                    self.done = True
                    break
                self.raw += d
        except (BlockingIOError, InterruptedError):
            pass
        except OSError:
            self.done = True
        if self.head:
            if b"\r\n\r\n" not in self.raw:
                return out
            hdr, self.raw = self.raw.split(b"\r\n\r\n", 1)
            self.head = False
            if b" 200 " not in hdr.split(b"\r\n", 1)[0]:
                self.done, self.raw = True, b""
        while len(self.raw) >= 8 and self.raw[0] in (0, 1, 2) and self.raw[1:4] == b"\0\0\0":
            n = struct.unpack(">I", self.raw[4:8])[0]
            if len(self.raw) < 8 + n:
                break
            self.buf += self.raw[8:8 + n]
            self.raw = self.raw[8 + n:]
        *done, self.buf = self.buf.split(b"\n")
        for raw in done:
            s = raw.decode("utf-8", "replace")
            m = _LIVE_RFC.match(s)
            if not m:
                continue
            ns = _live_utc(*m.groups()[:6]) * 1000000000 + int(((m.group(7) or "") + "000000000")[:9])
            if ns <= self.last:
                continue
            self.last = ns
            out.append([ns // 1000, self.src, 6, s[m.end():][:LIVE_TEXT_MAX]])
        return out

    def close(self):
        if self.s is not None:
            with contextlib.suppress(OSError):
                self.s.close()
            self.s = None


class LiveReader:

    def __init__(self, want, journal=None, files=(), ctrs=(), sock=None, cur=None, cap=200):
        cur = cur if isinstance(cur, dict) else {}
        self.want, self.cap, self.jargv, self.sock = set(want), max(1, int(cap)), journal, sock
        self.p, self.jbuf, self.jlines, self.jstart, self.jnext = None, b"", 0, 0.0, 0.0
        self.jback, self.jgap = False, 0.0
        self.jcur = cur.get("j") if isinstance(cur.get("j"), str) else None
        self.t0, self.bf, self.marks = time.monotonic(), [], []
        self.sec, self.n, self.skip = 0, 0, 0
        fc = cur.get("f") if isinstance(cur.get("f"), dict) else {}
        dc = cur.get("d") if isinstance(cur.get("d"), dict) else {}
        self.files = [_LiveFile(p, s, fmt, fc.get(p)) for p, s, fmt in files]
        self.ctrs = [_LiveCtr(sock, c, s, dc.get(c)) for c, s in ctrs] if sock else []
        if any(f.gap for f in self.files):
            self._gap()
        if journal:
            self._jopen(back=not self.jcur)

    def _gap(self):
        self.marks.append([int(time.time() * 1000000), "!gap", 4, ""])

    def _jopen(self, back=False):
        self.jlines, self.jstart, self.jbuf, self.jback = 0, time.monotonic(), b"", back
        a = self.jargv(None, min(LIVE_BACKFILL * max(1, len(self.want)), LIVE_BACKFILL_MAX)) if back else self.jargv(self.jcur, 0)
        with contextlib.suppress(OSError, ValueError):
            self.p = subprocess.Popen([x for x in a if x != "-f"] if back else a,
                                      stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
            os.set_blocking(self.p.stdout.fileno(), False)

    def _jread(self):
        out, eof = [], False
        if self.p is None:
            if self.jargv and self.jnext and time.monotonic() >= self.jnext:
                self.jnext = 0.0
                self._jopen()
            return out
        try:
            while True:
                d = os.read(self.p.stdout.fileno(), 65536)
                if not d:
                    eof = True
                    break
                self.jbuf += d
        except (BlockingIOError, InterruptedError):
            pass
        except (OSError, ValueError):
            eof = True
        *done, self.jbuf = self.jbuf.split(b"\n")
        for raw in done:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            self.jlines += 1
            if isinstance(e.get("__CURSOR"), str):
                self.jcur = e["__CURSOR"]
            ln = live_journal_line(e, self.want)
            if ln:
                out.append(ln)
        if eof and self.jback:
            self._jclose()
            self._jopen()
        elif eof:
            quick = time.monotonic() - self.jstart < 5
            self._jclose()
            if quick and self.jcur and not self.jlines and time.monotonic() - self.jgap >= 5:
                self.jcur, self.jgap = None, time.monotonic()
                self._gap()
                self._jopen(back=True)
            else:
                self.jnext = self.jstart + 5
        return out

    def _jclose(self):
        if self.p is not None:
            with contextlib.suppress(Exception):
                self.p.kill()
            with contextlib.suppress(Exception):
                self.p.wait(2)
            with contextlib.suppress(Exception):
                self.p.stdout.close()
            self.p = None

    def poll(self, timeout):
        rd = ([self.p.stdout] if self.p is not None else []) + [c for c in self.ctrs if c.s is not None and not c.done]
        if rd:
            with contextlib.suppress(OSError, ValueError):
                select.select(rd, [], [], timeout)
        else:
            time.sleep(timeout)
        new = self._jread()
        for f in self.files:
            new += f.read()
        for i, c in enumerate(self.ctrs):
            if not c.done:
                new += c.read()
            elif time.monotonic() - c.at >= 5:
                c.close()
                self.ctrs[i] = _LiveCtr(self.sock, c.name, c.src, c.last)
        new = [ln for ln in new if live_want(ln[1], self.want)]
        new.sort(key=lambda x: x[0])
        if self.bf is not None:
            self.bf += new
            el = time.monotonic() - self.t0
            if el < LIVE_BACKFILL_S or (self.p is not None and self.jback and el < LIVE_BACKFILL_WAIT):
                return []
            per, keep = {}, []
            for ln in reversed(self.bf):
                per[ln[1]] = per.get(ln[1], 0) + 1
                if per[ln[1]] <= LIVE_BACKFILL:
                    keep.append(ln)
            out, self.marks, self.bf = self.marks + keep[::-1], [], None
            return out
        out, self.marks = self.marks, []
        for ln in new:
            s = int(time.monotonic())
            if s != self.sec:
                if self.skip:
                    out.append([int(time.time() * 1000000), "!skip", 4, str(self.skip)])
                self.sec, self.n, self.skip = s, 0, 0
            self.n += 1
            if self.n > self.cap:
                self.skip += 1
            else:
                out.append(ln)
        if self.skip and int(time.monotonic()) != self.sec:
            out.append([int(time.time() * 1000000), "!skip", 4, str(self.skip)])
            self.skip = 0
        return out

    def cursor(self):
        c, f = {}, {}
        if self.jcur:
            c["j"] = self.jcur
        for x in self.files:
            xc = x.cursor()
            if xc:
                f[x.path] = xc
        d = {x.name: x.last for x in self.ctrs if x.last}
        if f:
            c["f"] = f
        if d:
            c["d"] = d
        return c

    def close(self):
        self._jclose()
        for x in self.files + self.ctrs:
            x.close()


import heapq as _range_heapq
import zlib as _range_zlib

RANGE_SEG_MAX = 512 << 10
RANGE_SEGS = 8
RANGE_LINE_OVER = 64
RANGE_PART_LINES = 8000
RANGE_LEVELS = {"err": (0, 1, 2, 3), "warn": (4,), "info": (5, 6), "debug": (7,)}


def range_prios(lv):
    return {p for k in lv if k in RANGE_LEVELS for p in RANGE_LEVELS[k]} if isinstance(lv, list) else set(range(8))


class RangeRing:

    def __init__(self, share):
        self.share = max(1, int(share))
        self.seg = max(4096, min(RANGE_SEG_MAX, self.share // RANGE_SEGS))
        self.segs, self.cur, self.cur_size, self.size = [], [], 0, 0
        self.lines, self.cut, self.cut_t = 0, 0, 0

    def add(self, ln):
        sz = RANGE_LINE_OVER + len(ln[3])
        self.cur.append(ln)
        self.cur_size += sz
        self.size += sz
        self.lines += 1
        if self.cur_size >= self.seg:
            self.seal()
        while self.size > self.share and self.segs:
            n, size, last_t, _z = self.segs.pop(0)
            self.size -= size
            self.lines -= n
            self.cut += n
            self.cut_t = last_t

    def seal(self):
        if self.cur:
            self.segs.append((len(self.cur), self.cur_size, self.cur[-1][0],
                              _range_zlib.compress(json.dumps(self.cur).encode(), 6)))
            self.cur, self.cur_size = [], 0

    def parts(self):
        self.seal()
        for _n, _s, _t, z in self.segs:
            yield json.loads(_range_zlib.decompress(z))


def range_journal_argv(base, units, kernel, since, until, pmax):
    a = list(base) + ["--no-pager", "-o", "json", "--output-fields=" + LIVE_FIELDS, "--since=@%d" % since,
                      "--until=@%d" % until] + (["-p", "0..%d" % pmax] if pmax < 7 else [])
    return a + live_journal_matches(units, kernel)


def _range_journal(argv, want, stop):
    p = None
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
        for raw in p.stdout:
            if stop.is_set():
                return
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            ln = live_journal_line(e, want) if isinstance(e, dict) else None
            if ln:
                yield ln
    except OSError:
        return
    finally:
        if p is not None:
            with contextlib.suppress(Exception):
                p.kill()
            with contextlib.suppress(Exception):
                p.wait(5)
            with contextlib.suppress(Exception):
                p.stdout.close()


def _range_file(path, src, fmt, since_us, until_us, stop):
    last = 0
    for p in (path + ".1", path):
        try:
            f = open(p, "rb")
        except OSError:
            continue
        with f:
            for raw in f:
                if stop.is_set():
                    return
                raw = raw.rstrip(b"\n")
                if not raw:
                    continue
                t, prio, text = live_parse_line(fmt, raw.decode("utf-8", "replace"), last)
                last = t
                if since_us <= t < until_us:
                    yield [t, src(text) if callable(src) else src, prio, text[:LIVE_TEXT_MAX]]


def _range_ctr(sock_path, name, src, since_us, until_us, stop):
    c = _LiveCtr(sock_path, name, src, 0, q="stdout=1&stderr=1&timestamps=1&since=%d&until=%d"
                 % (since_us // 1000000, until_us // 1000000 + 1))
    try:
        while not c.done and not stop.is_set():
            if not select.select([c], [], [], 30)[0]:
                break
            for ln in c.read():
                if since_us <= ln[0] < until_us:
                    yield ln
    finally:
        c.close()


def range_read(ring, want, lv, since, until, stop, journal=None, files=(), ctrs=(), sock=None, tick=None):
    want, prios = set(want), range_prios(lv)
    su, uu = int(since) * 1000000, int(until) * 1000000
    gens = []
    if journal and prios:
        gens.append(_range_journal(journal(int(since), int(until), max(prios)), want, stop))
    for p, s, fmt in files:
        gens.append(_range_file(p, s, fmt, su, uu, stop))
    for c, s in (ctrs if sock else ()):
        gens.append(_range_ctr(sock, c, s, su, uu, stop))
    n = 0
    try:
        for ln in _range_heapq.merge(*gens, key=lambda x: x[0]):
            if stop.is_set():
                break
            n += 1
            if ln[2] in prios and live_want(ln[1], want):
                ring.add(ln)
            if tick and n % 5000 == 0:
                tick(n)
    finally:
        for g in gens:
            g.close()
    return n



