HELPER_IMAGE = os.environ.get("HELPER_IMAGE") or os.environ.get("SWG_TURN_IMAGE") or "ghcr.io/tesla-prep/swg-node:latest"
UNIT_DIR_PERSIST = "/etc/systemd/system"
UNIT_DIR_RUNTIME = "/run/systemd/system"
_UNIT_DIR = {"dir": None, "persist": True, "asked": False}


def _probe_unit_dir():
    if _UNIT_DIR["asked"]:
        return
    _UNIT_DIR["asked"] = True
    _UNIT_DIR["dir"] = UNIT_DIR_PERSIST
    probe = UNIT_DIR_PERSIST + "/.swg-noded-unit-probe"
    w = host_sh("( : > " + shlex.quote(probe) + " ) 2>/dev/null"
                " && { rm -f " + shlex.quote(probe) + "; echo SWGUNITDIR-RW; }"
                " || echo SWGUNITDIR-RO")
    out = (w.stdout or "")
    if "SWGUNITDIR-RW" in out:
        _UNIT_DIR["dir"], _UNIT_DIR["persist"] = UNIT_DIR_PERSIST, True
        return
    if "SWGUNITDIR-RO" not in out:
        if w.returncode != 126:
            log(LOG_WARNING, "units: could not probe %s (rc=%d) — assuming it is writable, which is what this "
                  "did before there was a probe", UNIT_DIR_PERSIST, w.returncode)
        return
    host_sh("mkdir -p " + shlex.quote(UNIT_DIR_RUNTIME))
    _UNIT_DIR["dir"], _UNIT_DIR["persist"] = UNIT_DIR_RUNTIME, False
    log(LOG_INFO, "units: %s is read-only on this host — writing to %s instead. Units there are recreated "
          "by reconcile after a reboot; interfaces come back from the node's own bootstrap.", UNIT_DIR_PERSIST, UNIT_DIR_RUNTIME)


def turn_unit_dir():
    _probe_unit_dir()
    return _UNIT_DIR["dir"] or UNIT_DIR_PERSIST


def unit_dir_persists():
    _probe_unit_dir()
