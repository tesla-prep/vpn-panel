SERVERLOG_MAX = 8 << 20

def _rotate_serverlog(path, cap=SERVERLOG_MAX):
    with contextlib.suppress(Exception):
        if os.path.getsize(path) < cap:
            return
        tmp = path + ".1.tmp"
        try:
            with open(path, "rb") as src, open(tmp, "wb") as dst:
                at = max(0, os.fstat(src.fileno()).st_size - cap)
                src.seek(at)
                if at:
                    src.readline()
                shutil.copyfileobj(src, dst, 1 << 20)
            os.replace(tmp, path + ".1")
        except OSError:
            with contextlib.suppress(OSError):
                os.remove(tmp)
        finally:
            os.truncate(path, 0)


def _cap_serverlogs():
    if NODE_KIND != "docker":
        return
    cap = _log_docker_caps(_LOG_BUDGET["mb"])
    for path in [DNSMASQ_LOG] + _supervised_logs():
        if cap:
            _rotate_serverlog(path, cap // 2)
            continue
        with contextlib.suppress(OSError):
            if os.path.getsize(path):
