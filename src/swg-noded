_PEERHS = {}
PEERHS_GAPS = 8


def _session_health(key, hs, endpoint, now, bytes_total=0):
    st = _PEERHS.setdefault(key, {"hs": None, "gaps": [], "ep": None, "ep_moves": 0, "b": None, "bd": []})
    if endpoint and endpoint != "(none)" and endpoint != st["ep"]:
        if st["ep"] is not None:
            st["ep_moves"] += 1
        st["ep"] = endpoint
    if hs and hs != st["hs"]:
        if st["hs"] is not None and hs > st["hs"]:
            st["gaps"].append(hs - st["hs"])
            del st["gaps"][:-PEERHS_GAPS]
            if st["b"] is not None:
                st["bd"].append(max(0, bytes_total - st["b"]))
                del st["bd"][:-PEERHS_GAPS]
        st["hs"] = hs
        st["b"] = bytes_total
    def _med(v):
        v = sorted(v)
        return (v[len(v) // 2] if len(v) % 2 else (v[len(v) // 2 - 1] + v[len(v) // 2]) / 2.0) if v else None
    return {"hs_gap_med": _med(st["gaps"]), "hs_seen": len(st["gaps"]),
            "ep_moves": st["ep_moves"], "hs_bytes_med": _med(st["bd"])}


def peer_view(peers, last, dt, online_max, now, iface=""):
    out = []
    seen = set()
    for p in peers:
        age = (now - p["last_handshake"]) if p["last_handshake"] else None
        prev = last.get(p["public_key"])
        rs = ts = 0.0
        if prev and dt > 0:
            rs = max(0, p["rx_bytes"] - prev[0]) / dt
            ts = max(0, p["tx_bytes"] - prev[1]) / dt
        key = iface + "|" + p["public_key"]
        seen.add(key)
        out.append({
            "public_key": p["public_key"], "endpoint": p["endpoint"],
            "preshared_key": p.get("preshared_key"),
            "allowed_ips": p["allowed_ips"], "rx_bytes": p["rx_bytes"], "tx_bytes": p["tx_bytes"],
            "rx_speed": rs, "tx_speed": ts,
            "last_handshake": p["last_handshake"] or None, "handshake_age": age,
            "online": age is not None and age <= online_max,
            **_session_health(key, p["last_handshake"], p["endpoint"], now,
                              (p["rx_bytes"] or 0) + (p["tx_bytes"] or 0)),
        })
    if iface:
        for gone in [k for k in _PEERHS if k.startswith(iface + "|") and k not in seen]:
            _PEERHS.pop(gone, None)
    return out



def _read_proc(proc_root, name):
    with open(os.path.join(proc_root, name)) as f:
        return f.read()


def read_loadavg(proc_root="/proc"):
    p = _read_proc(proc_root, "loadavg").split()
    return [float(p[0]), float(p[1]), float(p[2])]


def read_meminfo(proc_root="/proc"):
    vals = {}
    for line in _read_proc(proc_root, "meminfo").splitlines():
        k, _, rest = line.partition(":")
        f = rest.split()
        if f and f[0].isdigit():
            vals[k] = int(f[0]) * 1024
    total = vals.get("MemTotal", 0)
    avail = vals.get("MemAvailable", vals.get("MemFree", 0))
    mem = {"total": total, "available": avail, "used": max(0, total - avail)}
    if "SwapTotal" in vals:
        mem["swap_total"] = vals["SwapTotal"]
        mem["swap_used"] = max(0, vals["SwapTotal"] - vals.get("SwapFree", 0))
    return mem


def read_uptime(proc_root="/proc"):
    return float(_read_proc(proc_root, "uptime").split()[0])


_virt = None


def read_virt(proc_root="/proc"):
