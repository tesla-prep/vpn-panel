            if status == 0 and use_ip:
                bad_pip = use_ip
                status, reply = post_json(url, panel["token"], {"snapshot": snap}, panel, peer=_PANEL_PEER)
            if status == 200:
                want_pip = ((reply.get("node_egress") or {}).get("panel_ip") or "").strip()
                if want_pip != panel_ip:
                    panel_ip = want_pip
                    if want_pip != bad_pip:
                        bad_pip = ""
                    with contextlib.suppress(OSError):
                        if want_pip:
                            with open(PANEL_IP_FILE + ".tmp", "w") as _f:
                                _f.write(want_pip)
                            os.replace(PANEL_IP_FILE + ".tmp", PANEL_IP_FILE)
                        else:
                            os.unlink(PANEL_IP_FILE)
            if status == 200 and isinstance(reply.get("desired"), dict):
                _prepare_static_guard(reply.get("cascade"), node_cfg)
                _relay_plan, _relay_sync_ok = reply.get("relay"), True
                if NODE_KIND == "docker":
                    with contextlib.suppress(OSError):
                        with open("/run/swg-node-sync", "w"):
                            pass
                with contextlib.suppress(Exception):
                    live_logs_take(reply.get("logs"), url, panel, node_cfg)
                with contextlib.suppress(Exception):
                    range_logs_take(reply.get("logrange"), url, panel, node_cfg)
                ivk_process(reply.get("iface_vault_pub"), reply.get("iface_vault_want"))
                cr = create_ifaces(node_cfg, reply.get("create"), agent, sudo)
                _orph = orphan_mesh_links(node_cfg, reply.get("owned_ifaces"), reply.get("delete"))
                if _orph:
                    log(LOG_INFO, "mesh: dropping link(s) this panel does not claim (its peer node is gone, or "
                          "this node moved panels): " + ", ".join(_orph))
                dl = delete_ifaces(node_cfg, list(reply.get("delete") or []) + _orph, agent, sudo)
                apply_panel_settings(reply.get("panel"))
                with contextlib.suppress(Exception):
                    _log_follow(node_cfg)
                _n_listen = sum(len(reply.get(k) or {}) for k in ("turn", "wdtt", "csqtt")
                                if isinstance(reply.get(k), dict))
                if _n_listen:
                    with contextlib.suppress(Exception):
                        _turn_sock_bufs(_n_listen)
                tp = apply_turn(reply.get("turn"), reply.get("turn_onboard"))
                with contextlib.suppress(Exception):
                    heal_turn_binds()
                with contextlib.suppress(Exception):
                    exit_test_take(reply.get("exit_test"))
                xr = {"changed": 0, "errors": []}
                _dxl = reply.get("cascade").get("devexit") if isinstance(reply.get("cascade"), dict) else None
                with contextlib.suppress(Exception):
                    reconcile_exits(reply.get("exits"), xr, devexit=_dxl if isinstance(_dxl, list) else None,
                                    managed=set(node_cfg.get("interfaces") or {}))
                with contextlib.suppress(Exception):
                    write_inventory(node_cfg)
                _dar = {"changed": 0, "errors": []}
                try:
                    reconcile_dev_reach(node_cfg, reply.get("dev_reach"), _dar)
                except Exception as e:
                    _dar["errors"].append("device access: " + str(e)[:160])
                _shr = {"changed": 0, "errors": []}
                r = reconcile(node_cfg, reconcile_net_share(node_cfg, net_filter_desired(node_cfg, reply["desired"]),
                                                            reply.get("net_share"), _shr),
                              agent, sudo, reply.get("remove"))
                _xds = {str((x or {}).get("id")): (x or {}).get("endpoint") for x in _EXITS["list"]}
                reconcile_dial_src(reply["desired"], r,
                                   extra=[{"endpoint": _xds.get(str(e.get("id"))) or "",
                                           "dial_src": e.get("dial_src") or ""}
                                          for e in (reply.get("exits") or []) if e.get("dial_src")])
                ri = reconcile_ifaces(node_cfg, reply.get("desired_ifaces") or {}, agent, sudo)
                rs = restart_ifaces(node_cfg, reply.get("restart"), agent, sudo)
                sp = stop_ifaces(node_cfg, reply.get("iface_stop"), agent, sudo)
                sa = start_ifaces(node_cfg, reply.get("iface_start"), agent, sudo)
                ik = apply_iface_keys(node_cfg, reply.get("iface_key"), agent, sudo)
                _awg_loaded = awg_load_request(reply.get("awg_load"), agent, sudo)
                _def_egress = ((reply.get("node_egress") or {}).get("default_egress_ip") or "").strip()
                note_drops_resets(reply.get("desired_ifaces"))
                note_mesh_resets(reply.get("desired_ifaces"))
                _route_sig = json.dumps([reply.get("desired_ifaces"), reply.get("cascade"),
                                         reply.get("smart"), _def_egress,
                                         _devexit_sig(reply.get("cascade")),
                                         _NET["sig"], sorted(_NET["refused"]),
                                         reply.get("lan_share"), _SHARE["sig"],
                                         _EXITS.get("dialin"),
                                         log_level() >= LOG_INFO],
                                        sort_keys=True, default=str)
                _iface_churn = bool(_awg_loaded or cr["created"] or dl["deleted"] or rs["restarted"]
                                    or sp["stopped"] or sa["started"] or ri["changed"])
                _route_moved = _route_sig != last_desired_sig
                if (_route_sig != last_route_sig or _iface_churn or _routed_devs_moved()
                        or (time.time() - last_route_t) >= ROUTING_RECONCILE_EVERY_S):
                    _routing_why = ("route_sig" if _route_sig != last_route_sig else "iface_churn" if _iface_churn
                                    else "timer" if (time.time() - last_route_t) >= ROUTING_RECONCILE_EVERY_S else "devs_moved")
                    eg = reconcile_egress(node_cfg, reply.get("desired_ifaces") or {}, _def_egress)
                    nr = {"changed": 0, "errors": []}
                    _nets = reconcile_net_routes(node_cfg, reply["desired"], nr)
                    reconcile_net_snat(node_cfg, _nets, nr)
                    reconcile_lan_block(reply.get("lan_share") is False, nr, owned=_own_tunnel_devs(node_cfg),
                                        mesh=_relay_links(node_cfg))
                    net_share_verify(nr)
                    dev_reach_verify(nr)
                    cas = reconcile_cascade(node_cfg, reply.get("cascade"), reply.get("smart"), _def_egress,
                                            panel_conn=panel, panel_cfg=reply.get("panel"),
                                            nets=_nets)
                    with contextlib.suppress(Exception):
                        reconcile_inet_chain(node_cfg, {e.get("dev") for e in
                                                        ((reply.get("cascade") or {}).get("devexit") or [])})
                    last_route_sig = _route_sig if not cas["errors"] else None
                    last_route_t = time.time(); last_desired_sig = _route_sig
                    _ROUTED["judged"] = _ROUTED["pending"]
                else:
                    eg = {"changed": 0, "errors": []}; cas = {"changed": 0, "errors": []}
                    nr = {"changed": 0, "errors": []}
                net_probe_take(node_cfg, reply.get("net_probe"), reply["desired"], online_max)
                for blk in (cr, dl, rs, sp, sa, ik):
                    for e in blk["errors"]:
                        k, _, m = e.partition(": ")
                        NODE_ERRORS[k] = m or e
                _ri_failed = set()
                for e in ri["errors"]:
                    _k, _, _m = e.partition(": ")
                    _k = _k.replace("set-iface ", "", 1)
                    NODE_ERRORS[_k] = _m or e; _ri_failed.add(_k)
                for k in (cr.get("created", []) + dl.get("deleted", [])
                          + rs.get("restarted", []) + sp.get("stopped", []) + sa.get("started", [])
                          + ik.get("done", [])):
                    NODE_ERRORS.pop(k, None)
                active = (set(reply.get("create") or {})
                          | set(reply.get("delete") or []) | set(reply.get("restart") or []) | set(reply.get("turn") or {})
                          | set(reply.get("iface_stop") or []) | set(reply.get("iface_start") or [])
                          | set(reply.get("iface_key") or {})
                          | set(reply.get("turn_onboard") or []))
                active |= _ri_failed
                for k in list(NODE_ERRORS):
                    if k not in active:
                        NODE_ERRORS.pop(k, None)
                for e in eg["errors"] + cas["errors"]:
                    log(LOG_ERR, "egress: " + e)
                for e in nr["errors"]:
                    log(LOG_ERR, "networks: " + e)
                for e in _shr["errors"] + _dar["errors"]:
                    log(LOG_ERR, e)
                for e in xr["errors"]:
                    log(LOG_ERR, "exit: " + e)
                if (r["added"] or r["removed"] or r["errors"] or ri["changed"] or ri["errors"]
                        or eg["changed"] or eg["errors"] or cas["changed"] or cas["errors"] or nr["changed"]
                        or xr["changed"] or xr["errors"]
                        or cr["created"] or cr["errors"]
                        or dl["deleted"] or dl["errors"] or tp["done"] or tp["errors"]):
                    _errs = (r['errors'] + ri['errors'] + cr['errors'] + dl['errors'] + tp['errors']
                             + eg['errors'] + cas['errors'])[:3]
                    log(LOG_ERR if _errs else LOG_INFO if (r["added"] or r["removed"] or cr["created"]
                                                           or dl["deleted"] or tp["done"] or ri["changed"]
                                                           or (_route_moved and (eg["changed"] or cas["changed"]
                                                                                 or nr["changed"])))
                    else LOG_DEBUG,
                        "reconcile: +%s -%s ifaces~%s cascade~%s create+%s delete-%s turn=%s errors=%s",
                        r['added'], r['removed'], ri['changed'], cas['changed'], cr['created'],
                        dl['deleted'], tp['done'], _errs)
                interval = reply.get("interval", interval)
            elif status == 0:
                log(LOG_ERR, 'sync error: %s', reply.get("error"))
                _pin_mismatch_hint(reply.get("error"), panel)
            elif _panel_busy(status, reply):
                log(LOG_INFO, "sync skipped: the panel is busy with a long operator action — retrying next pass")
            else:
                log(LOG_ERR, f"sync HTTP {status}: {reply.get('error')}")
        except Exception as e:
            log(LOG_ERR, 'loop error: %s', e)
        try:
            _rr = {"changed": 0, "errors": []}
            reconcile_relay(_relay_plan, _rr, _relay_sync_ok, _relay_links(node_cfg))
            for _e in _rr["errors"]:
                log(LOG_ERR, "relay: " + _e)
        except Exception as _e:
            log(LOG_ERR, 'relay: watchdog failed, disarming: %s', _e)
            with contextlib.suppress(Exception):
                _relay_disarm()
                _RELAY_ARM["sig"] = None
                _RELAY_ARM["why"] = "watchdog error: %s" % _e
        with _TURN_JOBS_LOCK:
            _busy = bool(_TURN_JOBS)
        _iv = 1.0 if _busy else interval
        if _LOOP["n"] == 1:
            _release_startup_memory()
        with contextlib.suppress(Exception):
            log(LOG_DEBUG, "pass %d: routing=%s, %d spawns, own %d ms, children %d ms", _LOOP["n"], _routing_why,
                _RUN_SPAWNS - _acct[2], (time.process_time() - _acct[0]) * 1000, (_children_cpu_s() - _acct[1]) * 1000)
        time.sleep(max(0.5, _iv - (time.time() - t0)))


if __name__ == "__main__":
    main()
