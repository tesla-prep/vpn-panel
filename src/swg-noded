def _s5x_dns_suspect(dev, qa, now=None):
    s = _S5X.get(dev)
    if not s or qa is None:
        return False
    now = time.time() if now is None else now
    last, s["qa"] = s.get("qa"), qa
    if not last or qa[0] < last[0] or qa[1] != last[1]:
        if last and qa[0] >= last[0] and qa[1] > last[1]:
            s["suspect"] = False
        s["unans"], s["unans_reads"] = 0, 0
        return False
    if qa[0] > last[0]:
        s["unans"], s["unans_reads"] = s.get("unans", 0) + qa[0] - last[0], s.get("unans_reads", 0) + 1
    if (s.get("udp_ok") is True and s.get("unans_reads", 0) >= 2 and s.get("unans", 0) >= S5X_DNS_SUSPECT_Q
            and now - s.get("suspect_at", 0) >= S5X_RECHECK_S):
        s["suspect_at"], s["suspect"], s["unans"], s["unans_reads"] = now, True, 0, 0
        return True
    return False


