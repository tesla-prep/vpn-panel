def _awg_mok_match():
    want = re.sub(r"[^0-9A-F]", "", run(["modinfo", "-F", "sig_key", "amneziawg"]).stdout.upper()).lstrip("0")
    if not want:
        return ""
    for c in AWG_MOK_CANDIDATES:
        if not os.path.isfile(c):
            continue
        for form in (["-inform", "DER"], []):
            m = re.search(r"serial=([0-9A-Fa-f]+)", run(["openssl", "x509"] + form + ["-in", c, "-noout", "-serial"]).stdout)
            if m:
                if m.group(1).upper().lstrip("0") == want:
                    return c
                break
    return ""


def _awg_refused_record(refused, boot):
    p = os.path.join(STATE_DIR, AWG_REFUSED)
