LOG_OFF, LOG_ERR, LOG_WARNING, LOG_NOTICE, LOG_INFO, LOG_DEBUG = -1, 3, 4, 5, 6, 7
LOG_LEVELS = {"off": LOG_OFF, "error": LOG_ERR, "warning": LOG_WARNING, "info": LOG_INFO, "debug": LOG_DEBUG}
LOG_DEBUG_RATE = 100
_LOG_STREAM = "stdout"
_LOG = {"level": LOG_INFO, "until": 0, "sec": 0, "n": 0, "dropped": 0}


def _log_to_journal():
    try:
        dev, ino = (int(x) for x in os.environ.get("JOURNAL_STREAM", "").split(":"))
        st = os.fstat(getattr(sys, _LOG_STREAM).fileno())
        return (st.st_dev, st.st_ino) == (dev, ino)
    except Exception:
        return False


_LOG_JOURNAL = _log_to_journal()
_LOG_TAG = {LOG_ERR: "E", LOG_WARNING: "W", LOG_NOTICE: "N", LOG_INFO: "I", LOG_DEBUG: "D"}


def log_set(level, debug_left=0):
    _LOG["level"] = level
    _LOG["until"] = -1 if debug_left == -1 else (time.monotonic() + debug_left if debug_left and debug_left > 0 else 0)


def log_level():
    u = _LOG["until"]
    return LOG_DEBUG if (u == -1 or (u and time.monotonic() < u)) else _LOG["level"]


_LOG_FILE = {"path": None, "cap": 0, "f": None, "size": 0, "lock": threading.RLock()}


def log_file(path, cap):
    with _LOG_FILE["lock"]:
        if _LOG_FILE["f"] and (path != _LOG_FILE["path"] or not cap):
            with contextlib.suppress(OSError):
                _LOG_FILE["f"].close()
            _LOG_FILE["f"] = None
        if path and not cap:
            for p in (path, path + ".1"):
                with contextlib.suppress(OSError):
                    os.remove(p)
        _LOG_FILE["path"], _LOG_FILE["cap"] = (path, int(cap)) if path and cap else (None, 0)


def _log_file_write(data):
    with _LOG_FILE["lock"]:
        path = _LOG_FILE["path"]
        if not path:
            return
        try:
            if _LOG_FILE["f"] is None:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                _LOG_FILE["f"] = open(path, "ab")
                _LOG_FILE["size"] = _LOG_FILE["f"].tell()
            _LOG_FILE["f"].write(data)
            _LOG_FILE["f"].flush()
            _LOG_FILE["size"] += len(data)
            if _LOG_FILE["size"] >= _LOG_FILE["cap"] // 2:
                _LOG_FILE["f"].close()
                _LOG_FILE["f"] = None
                os.replace(path, path + ".1")
        except (OSError, AttributeError, ValueError):
            _LOG_FILE["f"] = None


def _log_write(prio, text):
    pre = "<%d>" % prio if _LOG_JOURNAL else _LOG_TAG.get(prio, "I") + " "
    try:
        out = getattr(sys, _LOG_STREAM) if isinstance(_LOG_STREAM, str) else _LOG_STREAM
        out.write("".join(pre + ln + "\n" for ln in text.split("\n")))
        out.flush()
    except Exception:
        pass
    if _LOG_FILE["path"]:
        ts = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime()) + "Z " + _LOG_TAG.get(prio, "I") + " "
        _log_file_write("".join(ts + ln + "\n" for ln in text.split("\n")).encode("utf-8", "replace"))


def log(prio, msg, *args):
    if prio > _LOG["level"] and prio > log_level():
        return
    if prio == LOG_DEBUG or _LOG["dropped"]:
        s = int(time.monotonic())
        if s != _LOG["sec"]:
            if _LOG["dropped"]:
                _log_write(LOG_DEBUG, "%d debug lines not written (more than %d a second)" % (_LOG["dropped"], LOG_DEBUG_RATE))
            _LOG["sec"], _LOG["n"], _LOG["dropped"] = s, 0, 0
        if prio == LOG_DEBUG:
            _LOG["n"] += 1
            if _LOG["n"] > LOG_DEBUG_RATE:
                _LOG["dropped"] += 1
                return
    try:
        text = (msg % args) if args else str(msg)
    except Exception:
        text = "%s %r" % (msg, args)
    _log_write(prio, text)


def _log_excepthook(et, ev, tb, *_):
    if et is None or issubclass(et, SystemExit):
        return
    log(LOG_ERR, "".join(traceback.format_exception(et, ev, tb)).rstrip("\n"))


sys.excepthook = _log_excepthook
