_HOST_STARTTIME_SH = "st(){ read -r l < /proc/$1/stat 2>/dev/null || return 1; r=${l##*') '}; set -- $r; echo \"${20}\"; }; "


def _host_proc_ident(pid):
    flags, st = {}, ""
    if NODE_KIND != "docker":
        return flags, st
    with contextlib.suppress(Exception):
        out = (host_sh(_HOST_STARTTIME_SH + "base64 -w0 < /proc/%d/cmdline 2>/dev/null; echo; st %d; :" % (int(pid), int(pid)),
                       timeout=20).stdout or "")
        b64, _, rest = out.partition("\n")
        parts = [x.decode("utf-8", "replace") for x in base64.b64decode(b64.strip()).split(b"\x00") if x] if b64.strip() else []
        if parts:
            flags = _wdtt_flags_from_argv(parts)
        st = rest.strip() if rest.strip().isdigit() else ""
    return flags, st


def _wdtt_host_procs():
    now = time.time()
    if now - _WDTT_HOSTPROC["at"] < _WDTT_HOST_TTL:
        return _WDTT_HOSTPROC["rows"]
    if now - _WDTT_HOSTPROC["walked"] < _WDTT_HOST_FLOOR:
        return _WDTT_HOSTPROC["rows"]
    rows = []
    ok = False
    with contextlib.suppress(Exception):
        cmd = ("for p in /proc/[0-9]*; do c=$p/cmdline; [ -r \"$c\" ] || continue; "
               "case \"$(head -c 200 \"$c\" | tr '\\0' ' ')\" in *wdtt*|*csqtt*) "
               "printf '%s ' \"${p#/proc/}\"; base64 -w0 < \"$c\"; echo ;; esac; done; "
               "for d in " + " ".join(shlex.quote(d) for d in WDTT_CFG_DIRS)
               + "; do [ -f \"$d/wg-keys.dat\" ] && echo \"CFG $d\"; done; :")
        _r = host_sh(cmd, timeout=30)
        ok = (_r.returncode == 0)
        cfg = set()
        for ln in (_r.stdout or "").splitlines():
            if ln.startswith("CFG "):
                cfg.add(ln[4:].strip())
                continue
            pid, _, b64 = ln.strip().partition(" ")
            if not pid.isdigit() or not b64:
                continue
            with contextlib.suppress(Exception):
                parts = [x.decode("utf-8", "replace") for x in base64.b64decode(b64).split(b"\x00") if x]
                if parts and ("wdtt" in parts[0] or "csqtt" in parts[0] or "server" in parts[0]):
                    rows.append((int(pid), _wdtt_flags_from_argv(parts)))
    _WDTT_HOSTPROC["at"] = now
    _WDTT_HOSTPROC["walked"] = time.time()
    _WDTT_HOSTPROC["rows"] = rows
    _WDTT_HOSTPROC["ok"] = ok
    if ok:
        _WDTT_HOSTPROC["cfg"] = cfg
    log(LOG_DEBUG if ok else LOG_WARNING, "host-walk: %d server proc(s), %.1fs, %s", len(rows),
        _WDTT_HOSTPROC["walked"] - now, "complete" if ok else "INCOMPLETE (answer not trusted)")
    return rows


def _wdtt_hostproc_flush(force=False):
    _WDTT_HOSTPROC["at"] = 0.0
    if force:
        _WDTT_HOSTPROC["walked"] = 0.0


def _foreign_on(lookup):
