def _hev_path():
    return os.path.join(STATE_DIR, "hev", HEV_TAG, "hev-socks5-tunnel")


def _hev_ok(path, want):
    try:
        st = os.stat(path)
    except OSError:
        return False
    stamp = (path, st.st_ino, st.st_size, st.st_mtime_ns)
    if _HEV["ok"] == stamp:
        return True
    if os.access(path, os.X_OK) and _turn_sha_ok(path, want):
        _HEV["ok"] = stamp
        return True
    return False


def _hev_fetch(arch, dest):
    want = HEV_SHA256[arch]
    if _turn_panel_fetch(HEV_OWNER, HEV_TAG, arch, dest, want):
        return ""
    base = "https://github.com/%s/releases/download/%s/%s" % (HEV_OWNER, HEV_TAG, HEV_ASSET[arch])
    urls = [base] + [m.rstrip("/") + "/" + base for m in (os.environ.get("SWG_TURN_MIRROR") or "").split()]
    err, tmp = "download failed", dest + ".dl"
    with contextlib.suppress(OSError):
        os.makedirs(os.path.dirname(dest), exist_ok=True)
    for url in urls:
        r = run(["curl", "-4", "-fsSL", "--connect-timeout", "20", "--max-time", "240", "--retry", "3",
                 "--retry-delay", "3", "--retry-all-errors", url, "-o", tmp], timeout=320)
        if getattr(r, "returncode", 1) == 0:
            if _turn_sha_ok(tmp, want):
                try:
                    os.chmod(tmp, 0o755)
                    os.replace(tmp, dest)
                    return ""
                except OSError as e:
                    err = ("could not put it in place: " + str(e))[:160]
            else:
                err = "checksum mismatch — refusing to run an unverified binary (want %s…)" % want[:12]
        else:
            err = (getattr(r, "stderr", "") or "download failed").strip()[:160]
        with contextlib.suppress(OSError):
            os.remove(tmp)
    return err


def hev_binary():
    arch = _turn_arch()
    if arch not in HEV_SHA256:
        return "", "no hev build for %s — SOCKS5 exits run on amd64 and arm64 only" % (os.uname().machine or arch)
    p = _hev_path()
    if _hev_ok(p, HEV_SHA256[arch]):
        return p, ""
    t = _HEV["thread"]
    if (t is None or not t.is_alive()) and time.time() >= _HEV["next"]:
        def go():
            e = _hev_fetch(arch, p)
            _HEV["err"] = e
            _HEV["fails"] = (_HEV["fails"] + 1) if e else 0
            _HEV["next"] = time.time() + min(3600, 60 * 2 ** (_HEV["fails"] - 1)) if e else 0.0
            if e:
                log(LOG_WARNING, "SOCKS5 exits: hev %s could not be fetched: %s", HEV_TAG, e)
        _HEV["thread"] = threading.Thread(target=go, daemon=True)
        _HEV["thread"].start()
    return "", (("hev %s: %s" % (HEV_TAG, _HEV["err"])) if _HEV["err"] and not (t and t.is_alive())
                else "fetching the SOCKS5 tunnel program…")


def _yq(s):
    return "'" + str(s).replace("'", "''") + "'"


def _s5x_yml(dev, sk):
    cred = ("  username: %s\n  password: %s\n" % (_yq(sk["user"]), _yq(sk["pass"]))) if sk.get("user") else ""
    return ("tunnel:\n  name: %s\n  mtu: %d\n  ipv4: %s\n"
            "socks5:\n  address: %s\n  port: %d\n  udp: 'udp'\n%s"
            "mapdns:\n  address: %s\n  port: 53\n  network: %s\n  netmask: %s\n  cache-size: %d\n"
