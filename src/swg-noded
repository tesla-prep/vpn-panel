_IFDROP = {}
_FAULT_ALL = ("rx_drop", "rx_err", "tx_drop", "tx_err")
_IFDROP_ERR = {}


def _if_datapath(ifn):
    try:
        with open("/sys/class/net/%s/uevent" % ifn) as f:
            wg = bool(re.search(r"^DEVTYPE=(wireguard|amneziawg)$", f.read(), re.M))
    except OSError:
        wg = None
    if wg:
        return "wg"
    if os.path.exists("/sys/class/net/%s/tun_flags" % ifn):
        return "tun"
    return None if wg is None else "other"


def _if_stat(ifn, key):
    with open("/sys/class/net/%s/statistics/%s" % (ifn, key)) as f:
        return int(f.read().strip())


def _iface_drops_one(ifn, links, now):
    try:
        pkts = _if_stat(ifn, "rx_packets") + _if_stat(ifn, "tx_packets")
        kinds = (_if_stat(ifn, "rx_dropped"), _if_stat(ifn, "rx_errors"),
                 _if_stat(ifn, "tx_dropped"), _if_stat(ifn, "tx_errors"))
    except (OSError, ValueError):
        return None
    cur = (pkts,) + kinds
    st = _IFDROP.setdefault(ifn, {"prev": None, "hist": []})
    if st.get("dp") is None:
        st["dp"] = _if_datapath(ifn)
    fk = ("rx_drop",) if (st["dp"] == "wg" and ifn not in links) else _FAULT_ALL
    fi = [2 + _FAULT_ALL.index(k) for k in fk]
    _bb = _drops_baseline(ifn)
    _want = _DROPS_RESET.get(ifn)
    if _want and _bb.get("nonce") != _want:
        _bb = _drops_base()[ifn] = {"nonce": _want, "bad": sum(kinds), "pkts": pkts, "at": int(now), "kinds": list(kinds)}
        _drops_base_save()
        st["prev"] = None; st["hist"] = []
    elif fk != _FAULT_ALL and _bb and _bb["kinds"] is None:
        _bb = _drops_base()[ifn] = dict(_bb, bad=sum(kinds), pkts=pkts, at=int(now), kinds=list(kinds))
        _drops_base_save()
    if st["prev"] is not None:
        d = tuple(cur[i] - st["prev"][i] for i in range(5))
        if min(d) >= 0 and any(d):
            st["hist"].append((now,) + d)
            del st["hist"][:-IFACE_DROP_WINDOW]
        elif min(d) < 0:
            st.pop("dp", None)
    st["prev"] = cur
    h = st["hist"]
    if not h:
        return None
    tp = sum(r[1] for r in h)
    part = [sum(r[i] for r in h) for i in (2, 3, 4, 5)]
    if not (tp + sum(part)):
        return None
    tb = sum(part[i - 2] for i in fi)
    _fb = lambda r: sum(r[i] for i in fi)
    bad_at = [r[0] for r in h if _fb(r)]
    _rate = [_fb(r) * 100.0 / (r[1] + _fb(r)) for r in h if (r[1] + _fb(r)) >= IFACE_PEAK_MIN]
    peak = max(_rate) if _rate else None
    peak_bad = max([_fb(r) for r in h] or [0])
    _bk = _bb.get("kinds")
    life_bad = sum(kinds[i - 2] for i in fi) - (sum(_bk[i - 2] for i in fi) if _bk else _bb.get("bad", 0))
    return {
        "pct": round(tb * 100.0 / (tp + tb), 3) if (tp + tb) else 0.0, "window_pkts": tp, "window_bad": tb,
        "rx_drop": part[0], "rx_err": part[1], "tx_drop": part[2], "tx_err": part[3],
        "peak": (round(peak, 3) if peak is not None else None), "peak_bad": peak_bad,
        "span_s": int(now - h[0][0]),
        "last_bad_s": int(now - bad_at[-1]) if bad_at else None,
        "life_pkts": max(0, cur[0] - _bb.get("pkts", 0)), "life_bad": max(0, life_bad),
        "life_since": _bb.get("at") or None,
        "dp": st.get("dp"), "fault_kinds": list(fk),
    }


def iface_drops(ifaces, links=()):
    out = {}
    now = time.time()
    for ifn in ifaces:
        try:
            rec = _iface_drops_one(ifn, links, now)
        except Exception as e:
            if _IFDROP_ERR.get(ifn) != repr(e):
                _IFDROP_ERR[ifn] = repr(e)
                log(LOG_ERR, "iface_drops: %s skipped: %r\n%s", ifn, e, traceback.format_exc())
            continue
        if rec is not None:
            out[ifn] = rec
    for gone in [k for k in _IFDROP if k not in ifaces]:
        _IFDROP.pop(gone, None)
    for gone in [k for k in _IFDROP_ERR if k not in ifaces]:
        _IFDROP_ERR.pop(gone, None)
    return out


PROXY_DROP_WINDOW = 60
_PXDROP = {}


def _hex_ip4(h):
    try:
        n = int(h, 16)
        return "%d.%d.%d.%d" % (n & 0xFF, (n >> 8) & 0xFF, (n >> 16) & 0xFF, (n >> 24) & 0xFF)
    except ValueError:
        return ""


def _udp_sockets():
    out = {}
    for path, v6 in (("/proc/net/udp", False), ("/proc/net/udp6", True)):
        try:
            with open(path) as f:
                lines = f.read().splitlines()[1:]
        except OSError:
            continue
        for ln in lines:
            f_ = ln.split()
            if len(f_) < 11:
                continue
            addr, _, port_hex = f_[1].partition(":")
            try:
                port = int(port_hex, 16)
                drops = int(f_[-1])
                rxq = int(f_[4].split(":")[1], 16)
            except (ValueError, IndexError):
                continue
            ip = "" if v6 else _hex_ip4(addr)
            out[(ip, port)] = (drops, rxq)
    return out


def udp_listen_ports():
    out = set()
    for path in ("/proc/net/udp", "/proc/net/udp6"):
        try:
            with open(path) as f:
                next(f, None)
                for ln in f:
                    f_ = ln.split()
                    if len(f_) > 3 and f_[3] == "07":
                        with contextlib.suppress(ValueError):
                            out.add(int(f_[1].rpartition(":")[2], 16))
        except OSError:
            continue
    return sorted(p for p in out if p)[:1024]


def proxy_drops(proxies, now=None):
    now = now or time.time()
    socks = _udp_sockets()
    out = {}
    live = set()
    for p in (proxies or []):
        svc = (p or {}).get("service")
        listen = ((p or {}).get("listen") or "").strip()
        if not svc or ":" not in listen:
            continue
        host, _, port_s = listen.rpartition(":")
        try:
            port = int(port_s)
        except ValueError:
            continue
        hit = socks.get((host, port))
        if hit is None:
            hit = socks.get(("0.0.0.0", port)) or socks.get(("", port))
        if hit is None:
            continue
        drops, rxq = hit
        live.add(svc)
        st = _PXDROP.setdefault(svc, {"prev": None, "hist": []})
        if st["prev"] is not None:
            d = drops - st["prev"]
            if d >= 0:
                st["hist"].append((now, d))
                del st["hist"][:-PROXY_DROP_WINDOW]
            else:
                st["hist"] = []
        st["prev"] = drops
        h = st["hist"]
        win = sum(x[1] for x in h)
        span = int(now - h[0][0]) if len(h) > 1 else 0
        bad_at = [t for t, d in h if d]
        out[svc] = {"win_drops": win, "life_drops": drops, "rxq": rxq,
                    "per_min": round(win * 60.0 / span, 2) if span else 0.0,
                    "span_s": span, "last_bad_s": int(now - bad_at[-1]) if bad_at else None}
    for gone in [k for k in _PXDROP if k not in live]:
        _PXDROP.pop(gone, None)
    return out


