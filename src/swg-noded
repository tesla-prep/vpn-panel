_OWN_DNS = {}
_OWN_DNS_RETRY = {}
OWN_DNS_UNKNOWN = object()

def _turn_own_dns(cfgdir):
    import sqlite3
    for path in (cfgdir + "/csqtt.db", cfgdir + "/passwords.json"):
        try:
            mt = os.stat(path).st_mtime
        except OSError:
            continue
        with contextlib.suppress(OSError):
            st = os.stat(path + "-wal")
            mt = (mt, st.st_mtime, st.st_size)
        hit = _OWN_DNS.get(path)
        if hit and hit[0] == mt:
            return hit[1]
        if time.time() < _OWN_DNS_RETRY.get(path, 0):
            return hit[1] if hit else OWN_DNS_UNKNOWN
        try:
            if path.endswith(".db"):
                con = sqlite3.connect("file:" + path + "?mode=ro", uri=True, timeout=1)
                try:
                    try:
                        row = con.execute("SELECT value FROM meta WHERE key = 'dns'").fetchone()
                    except sqlite3.OperationalError as e:
                        if "no such table" not in str(e):
                            raise
                        row = None
                finally:
                    con.close()
                val = _turn_dns({"dns": row[0]}) if row else None
            else:
                with open(path) as f:
                    d = json.load(f)
                val = _turn_dns({"dns": d.get("dns")}) if isinstance(d, dict) and d.get("dns") else None
        except (sqlite3.Error, OSError, ValueError):
            _OWN_DNS_RETRY[path] = time.time() + 60
            return hit[1] if hit else OWN_DNS_UNKNOWN
        _OWN_DNS[path] = (mt, val)
        _OWN_DNS_RETRY.pop(path, None)
        return val
    return None

