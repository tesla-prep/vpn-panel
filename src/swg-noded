            val = None
    _BOOT_PERSIST[iface] = (now, val)
    return val


MESH_PROBE_EVERY_S = 60
MESH_PROBE_COUNT = 20
MESH_PROBE_SIZE = 1200
MESH_WINDOW = 30
_MESH_HEALTH = {}
_MESH_HIST = {}
_MESH_LOCK = threading.Lock()
_MESH_RESET = {}
_MESH_RESET_DONE = {}


def _mesh_peer_ip(iface):
    r = run(["ip", "-4", "-o", "addr", "show", iface])
    if r.returncode != 0:
        return ""
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", r.stdout or "")
    if not m:
        return ""
    try:
        n = ipaddress.ip_interface(m.group(1))
        if n.network.prefixlen >= 32:
            return ""
        return next((str(h) for h in n.network.hosts() if h != n.ip), "")
    except ValueError:
        return ""


def _mesh_probe_once(iface):
    peer = _mesh_peer_ip(iface)
    if not peer:
        return None
    r = run(["ping", "-n", "-q", "-I", iface, "-c", str(MESH_PROBE_COUNT), "-i", "0.2",
             "-s", str(MESH_PROBE_SIZE), "-W", "2", peer], timeout=MESH_PROBE_COUNT * 2 + 10)
    if r.returncode not in (0, 1):
        return None
    out = r.stdout or ""
    loss = re.search(r"([0-9.]+)% packet loss", out)
    rtt = re.search(r"= ([0-9.]+)/([0-9.]+)/([0-9.]+)/([0-9.]+) ms", out)
    if not loss:
        return None
    lost = round(float(loss.group(1)) / 100.0 * MESH_PROBE_COUNT)
    return {"peer": peer, "sent": MESH_PROBE_COUNT, "lost": lost,
            "rtt_ms": float(rtt.group(2)) if rtt else None,
            "rtt_min": float(rtt.group(1)) if rtt else None,
            "rtt_max": float(rtt.group(3)) if rtt else None,
            "mdev_ms": float(rtt.group(4)) if rtt else None, "at": int(time.time())}


def _mesh_probe_ifaces(node_cfg):
    links = set(_relay_links(node_cfg))
    return sorted(n for n in (node_cfg.get("interfaces") or {}) if n.startswith("swg_") or n in links)


def _mesh_probe_loop(node_cfg):
    while True:
        try:
            for iface in _mesh_probe_ifaces(node_cfg):
                got = _mesh_probe_once(iface)
                if got:
                    with _MESH_LOCK:
                        _want = _MESH_RESET.get(iface)
                        if _want and _MESH_RESET_DONE.get(iface) != _want:
                            _MESH_RESET_DONE[iface] = _want
                            _MESH_HIST.pop(iface, None)
                        h = _MESH_HIST.setdefault(iface, [])
                        h.append((got["at"], got["sent"], got["lost"]))
                        del h[:-MESH_WINDOW]
                        sent = sum(a for _, a, _ in h) or 1
                        lost = sum(b for _, _, b in h)
                        lastl = [t for t, _, b in h if b]
                        _MESH_HEALTH[iface] = {
                            "peer": got["peer"], "rtt_ms": got["rtt_ms"], "mdev_ms": got["mdev_ms"],
                            "rtt_min": got["rtt_min"], "rtt_max": got["rtt_max"],
                            "loss": round(lost * 100.0 / sent, 3),
                            "peak_loss": round(max(b * 100.0 / a for _, a, b in h if a), 3),
                            "last_loss_s": (got["at"] - lastl[-1]) if lastl else None,
                            "probes": len(h), "probe_every_s": MESH_PROBE_EVERY_S, "probe_size": MESH_PROBE_SIZE,
                            "window_sent": sent, "window_lost": lost, "at": got["at"]}
            with _MESH_LOCK:
                for gone in [k for k in _MESH_HEALTH if k not in (node_cfg.get("interfaces") or {})]:
                    _MESH_HEALTH.pop(gone, None); _MESH_HIST.pop(gone, None)
        except Exception:
            pass
        time.sleep(MESH_PROBE_EVERY_S)


def mesh_health():
    with _MESH_LOCK:
        return {k: dict(v) for k, v in _MESH_HEALTH.items()}


IFACE_DROP_WINDOW = 60
