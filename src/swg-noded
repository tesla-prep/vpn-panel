        L.append("PersistentKeepalive = " + str(int(rec["keepalive"])))
    return "\n".join(L) + "\n"


_EXIT_EP_IP = {}


def _exit_ping(endpoint, timeout=1.5):
    host = str(endpoint or "").rsplit(":", 1)[0].strip("[]")
    if not host:
        return None
    ip, now = None, time.time()
    _c = _EXIT_EP_IP.get(host)
    if _c and now - _c[0] < 300:
        ip = _c[1]
    if not ip:
        with contextlib.suppress(Exception):
            ip = socket.gethostbyname(host)
            _EXIT_EP_IP[host] = (now, ip)
    if not ip:
        return None
    s = None
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_ICMP)
        s.settimeout(timeout)
        ident = secrets.randbelow(0xFFFF) + 1
        def _ck(d):
            if len(d) % 2:
                d += b"\0"
            x = sum(struct.unpack("!%dH" % (len(d) // 2), d))
            x = (x >> 16) + (x & 0xFFFF); x += x >> 16
            return ~x & 0xFFFF
        pl = b"swg-exit-probe"
        pkt = struct.pack("!BBHHH", 8, 0, _ck(struct.pack("!BBHHH", 8, 0, 0, ident, 1) + pl), ident, 1) + pl
        t0 = time.monotonic()
        s.sendto(pkt, (ip, 0))
        end = t0 + timeout
        while True:
            left = end - time.monotonic()
            if left <= 0:
                return None
            r, _, _ = select.select([s], [], [], left)
            if not r:
                return None
            data, frm = s.recvfrom(2048)
            ihl = (data[0] & 0x0F) * 4
            if len(data) < ihl + 8:
                continue
            typ, _c2, _s2, rid, _sq = struct.unpack("!BBHHH", data[ihl:ihl + 8])
            if typ == 0 and rid == ident and frm[0] == ip:
                return round((time.monotonic() - t0) * 1000, 1)
    except Exception:
        return None
    finally:
        if s is not None:
            with contextlib.suppress(Exception):
                s.close()


_EXIT_REDIAL_AT = {}
_EXIT_RESOLVED = {}


def _exit_resolve(dev, rec, now=None):
    now = time.time() if now is None else now
    host, _, port = str((rec or {}).get("endpoint") or "").rpartition(":")
    host = host.strip("[]")
    if not host or not port.isdigit():
        return None
    try:
        ipaddress.ip_address(host)
        return None
    except ValueError:
        pass
    if now - _EXIT_REDIAL_AT.get(dev, 0) < EXIT_REDIAL_EVERY_S:
        return None
    _EXIT_REDIAL_AT[dev] = now
    try:
        ips = list(dict.fromkeys(a[4][0] for a in socket.getaddrinfo(host, int(port), 0, socket.SOCK_DGRAM)))
    except Exception:
        return None
    if not ips:
        return None
    _EXIT_RESOLVED[dev] = (time.time(), (host, port, ips))
    return (host, port, ips)


def _exit_redial(dev, rec, found):
    if not found or not rec.get("peer_key"):
        return None
    host, port, ips = found
    live = cmd = None
    for c in _exit_clis(rec, dev):
        r = run(c + ["show", dev, "endpoints"])
        if getattr(r, "returncode", 1) != 0:
            continue
        cmd = c
        for ln in (r.stdout or "").splitlines():
            parts = ln.split()
            if len(parts) >= 2 and parts[0] == rec["peer_key"]:
                live = parts[1]
        break
    if live is None:
        return None
    live_ip = live.rpartition(":")[0].strip("[]")
    if live_ip in ips:
        return None
    _v6 = lambda a: ":" in a
    try:
        fam = _v6(str(ipaddress.ip_address(live_ip)))
    except ValueError:
        fam = None
    ip = (next((a for a in ips if _v6(a) == fam), None) if fam is not None else None) \
        or next((a for a in ips if not _v6(a)), None)
    if ip is None:
        return None
    fresh = ("[%s]:%s" if _v6(ip) else "%s:%s") % (ip, port)
    r = run(cmd + ["set", dev, "peer", rec["peer_key"], "endpoint", fresh])
    if getattr(r, "returncode", 1) != 0:
        log(LOG_WARNING, "exit device %s: %s now resolves to %s, but re-pointing the tunnel failed: %s",
            dev, host, ip, (r.stderr or "").strip()[:160])
        return None
    _v4 = next((a for a in ips if not _v6(a)), None)
    if _v4:
        _EXIT_EP_IP[host] = (time.time(), _v4)
    else:
        _EXIT_EP_IP.pop(host, None)
    log(LOG_INFO, "exit device %s: %s now resolves to %s (the tunnel was dialling %s) — re-pointed",
        dev, host, fresh, live)
    return fresh


def _exit_clis(rec, dev):
    _kind = _link_kind(dev)
    _first = ["awg"] if (_kind == "awg" or (not _kind and _exit_awg(rec))) else _wgcmd(["wg"])
    _other = _wgcmd(["wg"]) if _first == ["awg"] else ["awg"]
    return (_first, _other)


def _exit_handshake(rec, dev):
    for cmd in _exit_clis(rec, dev):
        r = _dump_of(cmd, dev)
        if getattr(r, "returncode", 1) != 0:
            continue
        for f in (ln.split("\t") for ln in (r.stdout or "").splitlines()[1:]):
            parts = [f[0], f[4]] if len(f) >= 5 else []
            if len(parts) >= 2 and parts[1].isdigit():
                ts = int(parts[1])
                return 0 if ts == 0 else max(1, int(time.time()) - ts)
    return None


def _exit_learned_ep(rec, dev):
    for cmd in _exit_clis(rec, dev):
        r = _dump_of(cmd, dev)
        if getattr(r, "returncode", 1) != 0:
            continue
        for f in (ln.split("\t") for ln in (r.stdout or "").splitlines()[1:]):
            if len(f) >= 3 and f[2] and f[2] != "(none)":
                return f[2]
        return ""
    return ""


_EXIT_TLS = {"ctx": None, "at": 0.0}


def _exit_tls():
    now = time.monotonic()
    if _EXIT_TLS["ctx"] is None or now - _EXIT_TLS["at"] >= 3600:
        _EXIT_TLS.update(ctx=ssl.create_default_context(), at=now)
    return _EXIT_TLS["ctx"]


def _mapdns_a(dev, server, name, timeout=3.0):
    qid = secrets.randbelow(0xFFFF)
    q = qid.to_bytes(2, "big") + b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00" + \
        b"".join(bytes([len(p)]) + p.encode() for p in name.split(".")) + b"\x00\x00\x01\x00\x01"
    u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        u.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, dev.encode())
        u.settimeout(timeout)
        u.sendto(q, (server, 53))
        d, _ = u.recvfrom(4096)
    finally:
        u.close()
    if len(d) < 12 or d[:2] != q[:2]:
        raise OSError("mapdns: no answer for %s" % name)
    i, an = 12, int.from_bytes(d[6:8], "big")
    while i < len(d) and d[i]:
        i += d[i] + 1
    i += 5
    for _ in range(an):
        i += 2 if d[i] & 0xC0 == 0xC0 else (d.index(0, i) - i + 1)
        typ, rdl = int.from_bytes(d[i:i + 2], "big"), int.from_bytes(d[i + 8:i + 10], "big")
        if typ == 1 and rdl == 4:
            return socket.inet_ntoa(d[i + 10:i + 14])
        i += 10 + rdl
    raise OSError("mapdns: no A record for %s" % name)


def _exit_trace(dev, mapdns=None):
    import http.client, ssl
    class _Bound(http.client.HTTPSConnection):
        def connect(s2):
            so = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            so.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, dev.encode())
            so.settimeout(s2.timeout)
            _a = ((_mapdns_a(dev, mapdns, s2.host), s2.port) if mapdns
                  else socket.getaddrinfo(s2.host, s2.port, socket.AF_INET, socket.SOCK_STREAM)[0][4])
            _t = time.monotonic()
            so.connect(_a)
            s2.tcp_ms = round((time.monotonic() - _t) * 1000, 1)
            s2.sock = s2._context.wrap_socket(so, server_hostname=s2.host)
    try:
        _t0 = time.monotonic()
        c = _Bound("www.cloudflare.com", 443, timeout=10, context=_exit_tls())
        c.request("GET", "/cdn-cgi/trace", headers={"Host": "www.cloudflare.com", "User-Agent": "swg-noded"})
        kv = dict(l.split("=", 1) for l in c.getresponse().read().decode().strip().splitlines() if "=" in l)
        return {"ip": kv.get("ip", ""), "warp": kv.get("warp", ""), "loc": kv.get("loc", ""),
                "rtt_ms": int((time.monotonic() - _t0) * 1000), "tcp_ms": getattr(c, "tcp_ms", None)}
    except Exception as e:
        _why = (str(e) or e.__class__.__name__).strip()[:200]
        return {"err": "%s: %s" % (e.__class__.__name__, _why) if _why != e.__class__.__name__ else _why}


_EXIT_HEALTH = {}


_EXIT_REACH_TLS = {}


def _exit_reach_tls():
    c = _EXIT_REACH_TLS.get("ctx")
    if c is None:
        c = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        c.check_hostname, c.verify_mode = False, ssl.CERT_NONE
        _EXIT_REACH_TLS["ctx"] = c
    return c


def _exit_reach(dev, targets=EXIT_REACH_TARGETS, timeout=EXIT_REACH_TIMEOUT_S):
    import errno
    socks, pending, asked = [], {}, False
    def _hs(t):
        try:
            t.do_handshake()
            return True
        except ssl.SSLWantReadError:
            return "r"
        except ssl.SSLWantWriteError:
            return "w"
        except (ssl.SSLError, OSError):
            return False
    def _tls(s):
        t = _exit_reach_tls().wrap_socket(s, do_handshake_on_connect=False)
        socks.append(t)
        return t, _hs(t)
    try:
        for host, port in targets:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            socks.append(s)
            try:
                s.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, str(dev).encode())
            except OSError as e:
                if e.errno in (errno.EPERM, errno.EACCES):
                    continue
                raise
            s.setblocking(False)
            rc = s.connect_ex((host, port))
            asked = True
            if rc == 0:
                t, st = _tls(s)
                if st is True:
                    return True
                if st:
                    pending[t] = st
            elif rc in (errno.EINPROGRESS, errno.EWOULDBLOCK, errno.EALREADY):
                pending[s] = "c"
        if not asked:
            return None
        end = time.monotonic() + timeout
        while pending:
            left = end - time.monotonic()
            if left <= 0:
                break
            r, w, _ = select.select([s for s, v in pending.items() if v == "r"],
                                    [s for s, v in pending.items() if v != "r"], [], left)
            for s in set(r) | set(w):
                st = pending.pop(s)
                if st == "c":
                    if s.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR) != 0:
                        continue
                    s, st = _tls(s)
                else:
                    st = _hs(s)
                if st is True:
                    return True
                if st:
                    pending[s] = st
        return False
    except OSError:
        return None if not asked else False
    finally:
        for s in socks:
            with contextlib.suppress(Exception):
                s.close()


def _exit_probe_all(devs):
    res = {}
    def one(dev, rec):
        tr = _exit_trace(dev, rec["mapdns"]) if rec.get("mapdns") else _exit_trace(dev)
        rch = None if (tr or {}).get("ip") else _exit_reach(dev)
        res[dev] = (tr, rch, None)
        res[dev] = (tr, rch, _exit_ping(rec.get("endpoint")))
        if rec.get("mapdns"):
            pass
        elif not (tr or {}).get("ip") and rch is not True:
            _exit_resolve(dev, rec)
    ths = [threading.Thread(target=one, args=(d, r), daemon=True) for d, r in devs]
    if ths:
        with contextlib.suppress(Exception):
            _exit_tls()
        with contextlib.suppress(Exception):
            _exit_reach_tls()
    for t in ths:
        t.start()
    end = time.monotonic() + EXIT_PROBE_BOUND_S
    for t in ths:
        t.join(max(0.0, end - time.monotonic()))
    return dict(res)


def _exit_judge(dev, tr, now=None, reach=None):
    now = time.time() if now is None else now
    st = _EXIT_HEALTH.setdefault(dev, {"dead": False, "fail_since": None, "fails": 0,
                                       "ok_since": None, "since": now, "why": ""})
    carried = True if (tr or {}).get("ip") else (reach or _exit_reach)(dev)
    if carried is None:
        return st
    if carried:
        st["fail_since"], st["fails"] = None, 0
        if st["ok_since"] is None:
            st["ok_since"] = now
        if st["dead"] and now - st["ok_since"] >= EXIT_ALIVE_AFTER_S:
            st.update(dead=False, since=now, why="")
            log(LOG_INFO, "exit device %s: carrying traffic again for %ds — routing back through it", dev, EXIT_ALIVE_AFTER_S)
    else:
        st["ok_since"] = None
        if st["fail_since"] is None:
            st["fail_since"] = now
        st["fails"] += 1
        if (not st["dead"] and st["fails"] >= EXIT_DEAD_MIN_PROBES
                and now - st["fail_since"] >= EXIT_DEAD_AFTER_S):
            st.update(dead=True, since=now,
                      why=str((tr or {}).get("err") or "nothing crossed the tunnel").strip()[:200])
            log(LOG_INFO, "exit device %s: carried nothing for %ds (%s) — treating it as failed", dev, int(now - st["fail_since"]), st["why"])
    return st


def _exit_no_traffic(st, now=None):
    if not st or not st.get("dead"):
        return None
    now = time.time() if now is None else now
    return dict({"since": int(st["since"]), "why": st["why"]},
                **({"back_in": max(0, int(EXIT_ALIVE_AFTER_S - (now - st["ok_since"])))}
                   if st.get("ok_since") is not None else {}))


_EXIT_PROBED_AT = {}


def _exit_adopted(devexit, mine, managed=()):
    now, out, seen = time.monotonic(), [], set()
    for e in devexit or []:
        dev = str((e or {}).get("dev") or "") if isinstance(e, dict) else ""
        if not dev or dev in seen or dev in mine or dev in managed or dev.startswith("swg_"):
            continue
        seen.add(dev)
        if _dev_is_ether(dev):
            continue
        if _dev_link_state(dev) != "up":
            out.append((dev, None))
            continue
        out.append((dev, _exit_probe_due(dev, now)))
    return out


def _exit_probe_answered(tr, reach):
    return bool((tr or {}).get("ip") or (tr or {}).get("err") or reach is not None)


def _exit_probe_due(dev, now=None):
    now = time.monotonic() if now is None else now
    st = _EXIT_HEALTH.get(dev)
    return (st is None or st["dead"] or st["fails"] > 0
            or now - _EXIT_PROBED_AT.get(dev, now - EXIT_PROBE_IDLE_S) >= EXIT_PROBE_IDLE_S)


def _devexit_report():
    mine, out, said = {str((x or {}).get("device") or "") for x in _EXITS["list"]}, [], set()
    for e in _DEVEXIT["list"]:
        d = str(e.get("dev") or "")
        nt = None if d in mine or d in said else _exit_no_traffic(_EXIT_HEALTH.get(d))
        if nt:
            said.add(d)
        out.append(dict(e, no_traffic=nt) if nt else e)
    return out


def _devexit_state(dev):
    s = _dev_link_state(dev)
    return "dead" if s == "up" and (_EXIT_HEALTH.get(str(dev or "")) or {}).get("dead") else s


def reconcile_exits(desired, res, devexit=None, managed=()):
    want = {str((e or {}).get("id") or ""): e for e in (desired or []) if isinstance(e, dict) and e.get("provider") == "socks5"}
    out = []
    _slots = []
    def _exit_row(xid, dev, prov, rec, err, _blob_err, _live, tr, _hl, ping):
        return {"id": xid, "device": dev, "provider": prov, "up": _live,
                    "no_traffic": _exit_no_traffic(_hl),
                    "address": rec.get("address", ""), "public_key": rec.get("pub", ""),
                    "peer_key": rec.get("peer_key", ""),
                    "endpoint": (_exit_learned_ep(rec, dev) if _live else "") if _exit_dialin(rec) else rec.get("endpoint", ""),
                    "account_type": rec.get("account_type", ""), "trace": tr,
                    "error": err,
                    "restore_error": _blob_err,
                    "handshake": (_exit_handshake(rec, dev) if _live and prov != "socks5" else None),
                    "ping_ms": (ping if _live else None),
                    "awg": bool(_exit_awg(rec)),
                    **(dict(_s5x_view(dev), **({"setup": rec["setup"]} if rec.get("setup") else {})) if prov == "socks5" else {})}
    with contextlib.suppress(Exception):
        os.makedirs(EXIT_DIR, mode=0o700, exist_ok=True)

    try:
        for xid, d in sorted(want.items()):
            dev = str(d.get("device") or "").strip()
            if not xid or not dev or len(dev) > 15 or "/" in dev or any(c.isspace() for c in dev):
                res["errors"].append("exit %s: unusable device name" % (xid or "?"))
                if xid:
                    out.append({"id": xid, "device": dev, "provider": str(d.get("provider") or "warp"),
                                "up": False, "error": "unusable device name"})
                continue
            sp = os.path.join(EXIT_DIR, xid + ".json")
            rec = {}
            with contextlib.suppress(Exception):
                with open(sp) as f:
                    rec = json.load(f)
            prov = "socks5"
            err = ""
            _blob_err = ""
            if d.get("down"):
                if rec.get("provider") == "socks5" and rec.get("started"):
                    _exit_down(dev, dict(rec, id=xid))
                    rec["started"] = ""
                    with contextlib.suppress(Exception):
                        _replace_if_changed(sp, json.dumps(rec), 0o600)
                    res["changed"] += 1
                elif rec.get("priv") and _dev_link_state(dev) != "absent":
                    _exit_down(dev, rec)
                    res["changed"] += 1
                out.append({"id": xid, "device": dev, "provider": prov, "up": False, "paused": True,
                            "address": rec.get("address", ""), "public_key": rec.get("pub", ""),
                            "account_type": rec.get("account_type", ""), "trace": {}, "error": ""})
                continue
            _sk = _s5x_socks(d)
            _sig = "%s hev-%s" % (str(d.get("cfg_sig") or "-"), HEV_TAG)
            rec = {"provider": "socks5", "device": dev, "started": rec.get("started", ""), "setup": "",
                   "endpoint": ("[%s]:%d" if ":" in _sk["host"] else "%s:%d") % (_sk["host"], _sk["port"]) if _sk else ""}
            err, _state = "", _dev_link_state(dev)
            if not _sk:
                err = "the proxy address is incomplete"
            else:
                binp, err = hev_binary()
                if not binp and _state == "up":
                    err = ""
                elif not binp and err == "fetching the SOCKS5 tunnel program…":
                    rec["setup"], err = err, ""
                if binp:
                    _yml = os.path.join(EXIT_DIR, dev + ".yml")
                    try:
                        _replace_if_changed(_yml, _s5x_yml(dev, _sk), 0o600)
                    except OSError as e:
                        err = ("could not write the tunnel config: " + str(e))[:160]
                    if not err:
                        err = (_s5x_ensure_child(xid, dev, _sig, binp, _yml) if NODE_KIND == "docker"
                               else _s5x_ensure_unit(xid, _sig, binp, _yml, _state, rec["started"]))
                    if not err:
                        if rec["started"] != _sig:
                            _EXIT_HEALTH.pop(dev, None); _EXIT_PROBED_AT.pop(dev, None)
                            _S5X.pop(dev, None)
                            res["changed"] += 1
                        rec["started"] = _sig
                        _state = _dev_link_state(dev)
            with contextlib.suppress(Exception):
                _replace_if_changed(sp, json.dumps({k: v for k, v in rec.items() if k != "setup"}), 0o600)
            if err:
                res["errors"].append("exit %s: %s" % (xid, err))
            if _state == "up":
                rec = dict(rec, socks=_sk)
                _slots.append((len(out), xid, dev, prov, rec, err, ""))
                out.append(None)
            else:
                if _EXIT_HEALTH.get(dev):
                    _EXIT_HEALTH[dev]["ok_since"] = None
                _EXIT_PROBED_AT.pop(dev, None)
                out.append(_exit_row(xid, dev, prov, rec, err, "", False, {}, None, None))
    finally:
        _mine = {str((d or {}).get("device") or "") for d in want.values() if isinstance(d, dict)}
        _ad = _exit_adopted(devexit, _mine, managed)
        _sx = {dev: _exit_probe_due(dev) for _s, _x, dev, _p, _r, _e, _b in _slots if _p == "socks5"}
        _pr = _exit_probe_all([(dev, rec if dev not in _sx else {"endpoint": rec.get("endpoint"), "mapdns": S5X_DNS})
                               for _s, _x, dev, _p, rec, _e, _b in _slots if dev not in _sx or _sx[dev]]
                              + [(d, {}) for d, due in _ad if due])
        _dnsc = _s5x_dns_counts() if _sx else {}
        for _s, xid, dev, prov, rec, err, _blob_err in _slots:
            _sv = _s5x_take(dev, res, sig=rec.get("started"))
            _due = _s5x_check_due(dev)
            if _s5x_dns_suspect(dev, _dnsc.get(dev)):
                _due = "now"
            if dev in _pr:
                tr, _rch, _png = _pr[dev]
                _hl = _exit_judge(dev, tr, reach=lambda _d, _r=_rch: _r)
                if _exit_probe_answered(tr, _rch):
                    _EXIT_PROBED_AT[dev] = time.monotonic()
                _sv.update(trace=tr, ping=_png)
                if _due == "fail" and not (tr or {}).get("ip") and _rch is False:
                    _due = "now"
            else:
                tr, _png, _hl = _sv.get("trace") or {}, _sv.get("ping"), _EXIT_HEALTH.get(dev)
            if _due == "now":
                _s5x_dispatch(dev, rec.get("socks"), rec.get("started"))
            _c = _sv.get("check") or {}
            if _hl and _hl["dead"] and _c.get("why") and _c.get("at", 0) >= (_hl.get("fail_since") or 0) - EXIT_PROBE_BOUND_S:
                _hl["why"] = S5X_WHY.get(_c["why"], _c["why"])
            out[_s] = _exit_row(xid, dev, prov, rec, err, _blob_err, True, tr, _hl, _png)
        for dev, due in _ad:
            if due is None:
                if dev in _EXIT_HEALTH:
                    _exit_judge(dev, {"err": "the device is not up"}, reach=lambda _d: False)
            elif due:
                tr, _rch, _png = _pr.get(dev) or ({}, None, None)
                _exit_judge(dev, tr, reach=lambda _d, _r=_rch: _r)
                if dev in _pr and _exit_probe_answered(tr, _rch):
                    _EXIT_PROBED_AT[dev] = time.monotonic()
        _held = _mine | {d for d, _ in _ad}
        for k in [k for k in _EXIT_HEALTH if k not in _held] + [k for k in _EXIT_PROBED_AT if k not in _held] \
                + [k for k in _S5X_CHECKS if k not in _held]:
            _EXIT_HEALTH.pop(k, None); _EXIT_PROBED_AT.pop(k, None); _S5X_CHECKS.pop(k, None)

    _sigs = {xid: str((d or {}).get("cfg_sig") or "") for xid, d in want.items()}
    for _o in out:
        _o["cfg_sig"] = _sigs.get(str(_o.get("id") or ""), "")
    with contextlib.suppress(Exception):
        for fn in sorted(os.listdir(EXIT_DIR)):
            _stem = fn[:-5] if fn.endswith(".json") else ""
            if not _stem or len(_stem) != 8 or any(ch not in "0123456789abcdef" for ch in _stem) \
                    or _stem in want:
                continue
            old = {}
            with contextlib.suppress(Exception):
                with open(os.path.join(EXIT_DIR, fn)) as f:
                    old = json.load(f)
            od = str(old.get("device") or "")
            if od and (_dev_link_state(od) != "absent" or old.get("provider") == "socks5"):
                _exit_down(od, dict(old, id=_stem))
            if od and od not in _held:
                for _m in (_EXIT_HEALTH, _EXIT_REDIAL_AT, _EXIT_RESOLVED, _EXIT_PROBED_AT):
                    _m.pop(od, None)
            for p2 in (os.path.join(EXIT_DIR, fn), os.path.join(EXIT_DIR, od + ".conf") if od else ""):
                if p2:
                    with contextlib.suppress(Exception):
                        os.unlink(p2)
            log(LOG_INFO, "exit %s: removed (device %s)", _stem, od or "-")
            res["changed"] += 1
    with contextlib.suppress(Exception):
        _s5x_sweep(want)
    _EXITS["list"] = out
    _EXITS["socks"] = {x["device"]: x.get("udp_ok") is True for x in out
                       if isinstance(x, dict) and x.get("provider") == "socks5" and not x.get("paused")}


def _cascade_local_routes(node_cfg, _proc="/proc/net/route"):
    want = []
    for ifn in sorted((node_cfg or {}).get("interfaces") or {}):
        s = _iface_subnet(node_cfg, ifn)
        if s and not _iface_is_mesh(node_cfg, ifn, s):
            want.append((s, str(ifn)))
    with contextlib.suppress(Exception):
        for ifn, inst in sorted((_wdtt_load() or {}).items()):
            want.append((_wdtt_subnet((inst or {}).get("wg_addr") or ""), str(ifn)))
            raw = _wdtt_raw(inst)
            if raw:
                want.append((_wdtt_subnet(raw[2]), raw[1]))
    with contextlib.suppress(Exception):
        for ifn, inst in sorted((_csqtt_load() or {}).items()):
            want.append((_csqtt_subnet((inst or {}).get("tun_addr") or ""), str(ifn)))
    try:
        with open(_proc) as f:
            rows = f.read().splitlines()[1:]
    except OSError:
        return []
    live = set()
    for line in rows:
        t = line.split()
        if len(t) < 8:
            continue
        with contextlib.suppress(ValueError):
            d, m = int(t[1], 16), int(t[7], 16)
            live.add((t[0], "%d.%d.%d.%d/%d" % (d & 0xFF, (d >> 8) & 0xFF, (d >> 16) & 0xFF, (d >> 24) & 0xFF,
                                                bin(m).count("1"))))
    return sorted({(s, dev) for s, dev in want if s and (dev, s) in live})


STATIC_EGRESS_NFT = "swg_static_egress"
STATIC_EGRESS_STATE = os.path.join(STATE_DIR, "static-egress.json")
_STATIC_EGRESS = {"sig": None, "active": [], "blocked": [], "ready": [], "entries": [], "local": []}
_STATIC_SCOPES = {"static", "static-mesh"}


def _static_egress_entries(raw, devexit):
    devices = {(e["subnet"], e["dev"], e["table"]): e.get("scope") for e in devexit}
    entries = []
    for item in raw if isinstance(raw, list) else ():
        if not isinstance(item, dict):
            continue
        iif, src, key = (str(item.get(k) or "") for k in ("iif", "source", "key"))
        if not _SRC_DEV_RE.fullmatch(iif) or not re.fullmatch(r"[a-f0-9]{24}", key):
            continue
        try:
            source = str(ipaddress.IPv4Address(src.removesuffix("/32"))) + "/32"
        except ValueError:
            continue
        entry = {"iif": iif, "source": source, "key": key}
        table, dev = item.get("table"), str(item.get("dev") or "")
        if isinstance(table, int) and SWG_RT_BASE <= table <= SWG_RT_MAX and _SRC_DEV_RE.fullmatch(dev):
            scope = devices.get((source, dev, table))
            if (scope == "static" and dev.startswith("s5x-")
                    or scope == "static-mesh" and dev != iif):
                entry.update(dev=dev, table=table)
                route_id = item.get("ready_id")
                if scope == "static" and isinstance(route_id, str) and re.fullmatch(r"[a-f0-9]{24}", route_id):
                    entry["ready_id"] = route_id
        entries.append(entry)
    return entries


def _ensure_static_egress(entries, local_nets, res):
    if not entries and _STATIC_EGRESS["sig"] == "":
        return True
    groups = {}
    for e in entries:
        groups.setdefault((e["iif"], e.get("dev", ""), e.get("table", 0)), set()).add(e["source"])
    local = _collapse4(local_nets) if groups else []
    lines = []
    if groups:
        lines = [f"table inet {STATIC_EGRESS_NFT} {{}}", f"delete table inet {STATIC_EGRESS_NFT}",
                 f"table inet {STATIC_EGRESS_NFT} {{",
                 "  chain classify { type filter hook prerouting priority mangle + 8; policy accept;"]
        if local:
            lines.append("    ip daddr { %s } return" % ", ".join(local))
        lines.append(f"    meta mark & 0x0000fffe == {SNI_BLOCK_MARK:#x} return")
        for (iif, dev, table), sources in sorted(groups.items()):
            if dev:
                lines.append('    iifname "%s" ip saddr { %s } meta mark set %d' %
                             (iif, ", ".join(sorted(sources)), table + STATIC_EGRESS_MARK_OFFSET))
        lines += ["  }", "  chain guard { type filter hook forward priority filter + 1; policy accept;"]
        if local:
            lines.append("    ip daddr { %s } return" % ", ".join(local))
        for (iif, dev, _), sources in sorted(groups.items()):
            out = ' oifname != "%s"' % dev if dev else ""
            lines.append('    iifname "%s" ip saddr { %s }%s drop' %
                         (iif, ", ".join(sorted(sources)), out))
        lines += ["  }", "}"]
    body = "\n".join(lines)
    if body == _STATIC_EGRESS["sig"] and run(["nft", "list", "table", "inet", STATIC_EGRESS_NFT]).returncode == 0:
        _STATIC_EGRESS.update(entries=entries, local=local)
        return True
    if body:
        result = run(["nft", "-f", "-"], input_text=body + "\n")
    else:
        result = run(["nft", "delete", "table", "inet", STATIC_EGRESS_NFT])
    if result.returncode == 0 or (not body and (_nft_absent(result) or result.returncode == 127)):
        _STATIC_EGRESS.update(sig=body, entries=entries, local=local)
        res["changed"] += int(result.returncode == 0)
        return True
    res["errors"].append("static SOCKS5 routing: " + ((result.stderr or "").strip() or "nft failed")[:160])
    return False


def _static_guard_only(entries):
    return [{k: e[k] for k in ("iif", "source", "key")} for e in entries]


def _store_static_guard(entries, local):
    guard = _static_guard_only(entries)
    if guard or os.path.exists(STATIC_EGRESS_STATE):
        _replace_if_changed(STATIC_EGRESS_STATE, json.dumps({"entries": guard, "local": list(local)}), 0o600)


def _restore_static_guard():
    try:
        with open(STATIC_EGRESS_STATE) as f:
            state = json.load(f)
    except FileNotFoundError:
        return
    res = {"changed": 0, "errors": []}
    if not _ensure_static_egress(_static_egress_entries(state["entries"], ()), state["local"], res):
        raise SystemExit(res["errors"][0])


def _prepare_static_guard(plan, node_cfg):
    entries = _static_egress_entries((plan or {}).get("static_egress"), ())
    current = {(e["iif"], e["source"]): e for e in _STATIC_EGRESS["entries"]}
    added = False
    for entry in entries:
        match = (entry["iif"], entry["source"])
        if current.get(match, {}).get("key") != entry["key"]:
            current[match] = entry
            added = True
    if not added:
        return
    guard = list(current.values())
    local = sorted(set(_STATIC_EGRESS["local"]) | {p for p, _ in _cascade_local_routes(node_cfg)})
    res = {"changed": 0, "errors": []}
    _store_static_guard(guard, local)
    if not _ensure_static_egress(guard, local, res):
        raise RuntimeError(res["errors"][0])
    _STATIC_EGRESS.update(active=[], blocked=sorted({e["key"] for e in guard}), ready=[])


def reconcile_cascade(node_cfg, plan, smart=None, default_egress_ip="", panel_conn=None, panel_cfg=None, nets=()):
    res = {"changed": 0, "errors": []}
    plan = plan or {}
    fwd = plan.get("forward") or []
    exit_ = plan.get("exit") or []
    devexit = plan.get("devexit") or []
    static_entries = _static_egress_entries(plan.get("static_egress"), devexit)
    _dxs = [dict(e, state=_devexit_state(e.get("dev") or "")) for e in devexit]
    for e in _dxs:
        e["needs_gw"] = _dev_is_ether(str(e.get("dev") or ""))
        e["gw"] = _devexit_gw(e) if e["needs_gw"] else ""
    _arr_raw = set(x for x in (((smart or {}).get("arrivals") or {}).get("subnets") or []) if isinstance(x, str))
    _dx_seen, _dx_rep = set(), []
    for e in _dxs:
        if e.get("scope") in _STATIC_SCOPES:
            continue
        _ka = (str(e.get("dev") or ""), e.get("table"), e.get("scope") or "iface", bool(e.get("killswitch")),
               str(e.get("egress_ip") or "").strip(),
               "@arr" if (e.get("subnet") or "") in _arr_raw else (e.get("subnet") or ""))
        if _ka not in _dx_seen:
            _dx_seen.add(_ka)
            _dx_rep.append(e)
    _DEVEXIT["list"] = [{"dev": e.get("dev") or "", "subnet": e.get("subnet") or "", "state": e["state"],
                         "needs_gw": bool(e["needs_gw"]), "gw": e["gw"],
                         "killswitch": bool(e.get("killswitch")),
                         "scope": e.get("scope") or "iface",
                         "egress_ip": str(e.get("egress_ip") or "").strip(),
                         **({"arr": True} if (e.get("subnet") or "") in _arr_raw else {})} for e in _dx_rep]
    _devfwd = [{"subnet": e["subnet"], "via_iface": e["dev"], "table": e["table"], "gw": e["gw"]}
               for e in _dxs if e["state"] == "up" and e.get("scope") not in _STATIC_SCOPES | {"rule"}
               and not (e["needs_gw"] and not e["gw"])]
    fwd = fwd + _devfwd
    _dxgw = {e["dev"]: e["gw"] for e in _dxs}
    _dxnogw = {e["dev"] for e in _dxs if e["needs_gw"] and not e["gw"]}
    _fwd_rules = {(e["subnet"], str(e["table"])) for e in fwd}
    _dxguard = [e for e in _dxs if e.get("killswitch")]
    smart_e = (smart or {}).get("entries") or []
    smart_exit = [e for e in smart_e if e.get("action", "exit") == "exit"]
    _lst = {e["dev"]: _dev_seen(e["dev"], e["state"]) for e in _dxs if e.get("dev")}
    def _withheld(dev):
        if dev not in _lst:
            _lst[dev] = _dev_seen(dev)
        return dev in _dxnogw or _lst[dev][0] != "up"
    fwd = [dict(e, _noroute=_withheld(e["via_iface"])) for e in fwd]
    exit_ = [dict(e, _noroute=_withheld(e["via_iface"])) for e in exit_]
    smart_exit = [dict(e, gw=_dxgw.get(e.get("via_iface"), ""),
                       _noroute=_withheld(e.get("via_iface"))) for e in smart_exit]
    arr_subs, arr_e = _arrivals_parse((smart or {}).get("arrivals"))
    arr_exit = [dict(e, gw=_dxgw.get(e["via_iface"], ""), _noroute=_withheld(e["via_iface"]))
                for e in arr_e if e["action"] == "exit"]
    static = [dict(e, via_iface=e["dev"], _noroute=_withheld(e["dev"])) for e in static_entries if e.get("dev")]
    arr_exit += static
    _pe = _p2p_entry((smart or {}).get("p2p")) if ((smart or {}).get("p2p") or {}).get("action") == "route" else None
    if _pe:
        arr_exit = arr_exit + [{"subnet": "", "category": "p2p", "action": "exit", "via_iface": _pe["via_iface"],
                                "table": int(_pe["table"]), "gw": _dxgw.get(_pe["via_iface"], ""),
                                "_noroute": _withheld(_pe["via_iface"])}]
    _pi = (smart or {}).get("p2p") if isinstance((smart or {}).get("p2p"), dict) else {}
    if _pi.get("action") == "iface":
        for _ie in _p2p_iface_entries(_pi)[0]:
            arr_exit = arr_exit + [{"subnet": "", "category": "p2p", "action": "exit", "via_iface": _ie["via_iface"],
                                    "table": int(_ie["table"]), "gw": _dxgw.get(_ie["via_iface"], ""),
                                    "_noroute": _withheld(_ie["via_iface"])}]
    _ROUTED["pending"] = {d: v for d, v in _lst.items() if d}
    mode = "sni" if (smart or {}).get("mode") == "sni" else "kernel"
    _SMART_MODE["m"] = mode
    host_engine = "sni_user" if mode == "sni" else "none"
    is_sni = mode == "sni"
    _SMART_MODE["engine"] = host_engine
    _reset_ran = _apply_routing_reset((smart or {}).get("routing_reset"), res, (smart or {}).get("routing_reset_learned"))
    _engine_change_reset(host_engine, res, already=_reset_ran)
    ip_learning = (smart or {}).get("ip_learning", True)
    learn_ttl = 3600 if ip_learning else 120
    _cat_caps_take(smart)
    _panel_list_refresh((smart or {}).get("list_manifest") or {}, (panel_cfg or {}).get("geo_update") or {},
                        panel_conn, res)
    band = _live_band_prios()
    want_tables = ({str(e["table"]) for e in (fwd + smart_exit + arr_exit + exit_)}
                   | {str(e["table"]) for e in _dxguard})
    _RPF["needed"] = bool(fwd or smart_e or exit_ or arr_exit)
    if _RPF["needed"]:
        _rall = _rp_filter_val("all")
        _RPF["bad"] = sorted(d for d in {_detect_wan()} | {e["via_iface"] for e in (fwd + smart_exit + arr_exit + exit_)}
                             if _rp_effective(d, _rall) not in (None, 2))
    else:
        _RPF["bad"] = []
    _tbls = sorted({str(e["table"]) for e in fwd + smart_exit} | {str(e["table"]) for e in _dxguard})
    _troutes = list(nets)
    if _tbls:
        _taken = {p for p, _ in _troutes} | {e["subnet"] for e in exit_}
        _troutes += [(p, dev) for p, dev in _cascade_local_routes(node_cfg) if p not in _taken]
    _net_tables = _tbls if _troutes else []
    _cut = _dialin_cut(fwd + smart_exit + arr_exit, exit_, _troutes if _net_tables else (), set(_net_tables))
    want_sig = _cascade_want_sig(fwd, exit_, smart_exit, guard=_dxguard,
                                 nets=_troutes, net_tables=_net_tables, arr=arr_exit, cut=_cut, static=static)
    local_nets = ([p for p, _ in (*nets, *_cascade_local_routes(node_cfg))] +
                  [e["subnet"] for e in exit_]) if static_entries else []
    if not _ensure_static_egress(static_entries, local_nets, res):
        _STATIC_EGRESS.update(active=[], blocked=sorted({e["key"] for e in static_entries}), ready=[])
        return res
    _store_static_guard(static_entries, _STATIC_EGRESS["local"])
    live_sig = _cascade_live_sig({str(p) for p in _band_tables(band)} | want_tables)
    if want_sig != live_sig:
        if fwd or smart_e or exit_ or arr_exit:
            _sysctl_ensure("net.ipv4.ip_forward", 1)
            wan = _detect_wan()
            _all = _sysctl_ensure("net.ipv4.conf.all.rp_filter", 2)
            _eff = lambda v: v if _all is None else max(v, _all)
            _bad = []
            for dev in sorted({"all", wan} | {e["via_iface"] for e in (fwd + smart_exit + arr_exit + exit_)}):
                v = _all if dev == "all" else _sysctl_ensure("net.ipv4.conf.%s.rp_filter" % dev, 2,
                                                             ok=lambda cur: _eff(cur) == 2)
                if v is not None and _eff(v) != 2:
                    _bad.append(dev)
            _RPF["needed"] = True
            _RPF["bad"] = sorted(_bad)
        for token in sorted(live_sig):
            if token.startswith("R|static|"):
                _, _, mark, table = token.split("|")
                run(["ip", "rule", "del", "fwmark", mark, "lookup", table, "priority", str(STATIC_EGRESS_PREF)])
        for pri in band:
            for _ in range(4096):
                if run(["ip", "rule", "del", "pref", str(pri)]).returncode != 0:
                    break
        for tbl in _band_tables(band):
            run(["ip", "route", "flush", "table", str(tbl)])
        for T, p in _cut:
            run(["ip", "route", "replace", "prohibit", p, "table", T])
        for e in fwd:
            T = str(e["table"]); S = e["subnet"]; dev = e["via_iface"]
            _gw = str(e.get("gw") or "")
            if not e.get("_noroute"):
                run(["ip", "route", "replace", "default"] + (["via", _gw] if _gw else [])
                    + ["dev", dev, "table", T])
            run(["ip", "rule", "add", "from", S, "lookup", T, "priority", T])
            res["changed"] += 1
        for e in _dxguard:
            T = str(e["table"])
            run(["ip", "route", "replace", "prohibit", "default", "metric", str(DEVEXIT_GUARD_METRIC),
                 "table", T])
            if (e["subnet"], T) not in _fwd_rules and e.get("scope") != "rule":
                run(["ip", "rule", "add", "from", e["subnet"], "lookup", T, "priority", T])
            res["changed"] += 1
        for T, dev, _sg in sorted({(str(e["table"]), e["via_iface"], str(e.get("gw") or ""))
                                   for e in smart_exit + arr_exit if not e.get("_noroute")}):
            run(["ip", "route", "replace", "default"] + (["via", _sg] if _sg else [])
                + ["dev", dev, "table", T])
        for T in sorted({str(e["table"]) for e in smart_exit + arr_exit}):
            run(["ip", "rule", "add", "fwmark", T, "lookup", T, "priority", T])
            res["changed"] += 1
        for table in sorted({e["table"] for e in static}):
            run(["ip", "rule", "add", "fwmark", str(table + STATIC_EGRESS_MARK_OFFSET), "lookup", str(table),
                 "priority", str(STATIC_EGRESS_PREF)])
            res["changed"] += 1
        for e in exit_:
            T = str(e["table"]); S = e["subnet"]; dev = e["via_iface"]
            if not e.get("_noroute"):
                run(["ip", "route", "replace", S, "dev", dev, "table", T])
            run(["ip", "rule", "add", "iif", dev, "to", S, "prohibit", "priority", T])
            run(["ip", "rule", "add", "to", S, "lookup", T, "priority", T])
            res["changed"] += 1
        for T in _net_tables:
            for p, dev in _troutes:
                run(["ip", "route", "replace", p, "dev", dev, "table", T])
                res["changed"] += 1
        for _t in sorted({int(e["table"]) for e in (fwd + smart_exit)}):
            _u = _up_mark(_t)
            if _u:
                run(["ip", "rule", "add", "fwmark", str(_u), "lookup", str(_t), "priority", str(_u)])
                res["changed"] += 1
    _ensure_fwd_iptables(fwd, exit_, _detect_wan(), res, default_egress_ip, devexit=devexit)
    _s5x_rules(devexit, nets, res)
    blocked = {e["key"] for e in static_entries if not e.get("dev")}
    ready = set()
    if static:
        live = live_sig if want_sig == live_sig else _cascade_live_sig(want_tables)
        returns = {(e["via_iface"], e["subnet"]): e["table"] for e in exit_ if e.get("personal")}
        for e in static:
            table, dev = e["table"], e["dev"]
            if (res["errors"] or e["_noroute"] or f"R|static|{table + STATIC_EGRESS_MARK_OFFSET}|{table}" not in live
                    or f"T|{table}|default|{dev}|" not in live):
                blocked.add(e["key"])
                continue
            if "ready_id" in e:
                source = e["source"].removesuffix("/32")
                return_table = returns.get((e["iif"], source))
                if (f"R|to|{source}|{return_table}" in live
                        and f"T|{return_table}|{source}|{e['iif']}|" in live):
                    ready.add(e["ready_id"])
                else:
                    blocked.add(e["key"])
    _STATIC_EGRESS.update(active=sorted({e["key"] for e in static_entries} - blocked),
                          blocked=sorted(blocked), ready=sorted(ready))
    smart_cats = sorted(set((smart or {}).get("categories") or []) | {e["category"] for e in smart_e + arr_e})
    _smart_subs = {e["subnet"] for e in smart_e}
    smart_ifs = sorted(({ifn for ifn in (node_cfg.get("interfaces") or {}) if _iface_subnet(node_cfg, ifn) in _smart_subs}
                        | {ifn for ifn, w in _wdtt_load().items() if _wdtt_subnet((w or {}).get("wg_addr") or "") in _smart_subs}
                        | {(_wdtt_raw(w) or ("", "", ""))[1] for w in _wdtt_load().values()
                           if _wdtt_raw(w) and _wdtt_subnet(_wdtt_raw(w)[2]) in _smart_subs}
                        | {ifn for ifn, c in _csqtt_load().items() if _csqtt_subnet((c or {}).get("tun_addr") or "") in _smart_subs})) if _smart_subs else []
    domains = dict((smart or {}).get("domains") or {})
    _dns_up = _dns_upstream((smart or {}).get("dns_upstream"))
    if mode != "kernel":
        for _c, _caps in _CAT_CAPS.items():
            if _caps.get("host") and _c not in domains and _c in smart_cats:
                domains[_c] = []
    _host_cats = [c for c in domains if _CAT_CAPS.get(c, {}).get("host")]
    _fetched, _fetched_z = _smart_domain_refresh(_host_cats, res)
    _pats = _pattern_buckets(smart)
    if _fetched_z:
        _zb = _pats.setdefault("zone", {})
        for _c, _zs in _fetched_z.items():
            _zb[_c] = sorted(set(_zb.get(_c) or []) | set(_zs))
    _zones = _pats.get("zone") or {}
    _dns_e = smart_e + [{"subnet": S} for S in arr_subs]
    _nb_allow = (sorted({a for a in ((smart or {}).get("allow") or ()) if isinstance(a, str) and _DOM_RE.match(a)})
                 if is_sni else [])
    dom_sig = _dom_signature(_dns_e, domains, _zones, _fetched, _dns_up, allow=_nb_allow, pats=_pats)
    _dt = _DOMTIER_CACHE.get("v")
    dom_unchanged = bool(_dt and _dt[0] == dom_sig)
    if dom_unchanged:
        domains = _dt[1]
    else:
        for cat, fl in _fetched.items():
            domains[cat] = sorted(set(domains.get(cat) or []) | set(fl))
        _never_block_adjust(domains, _pats, _nb_allow, host_engine)
        _DOMTIER_CACHE["v"] = (dom_sig, domains)
    _shw = _smart_shadows(smart_e + [{"subnet": "@arr", "category": e["category"]} for e in arr_e], domains, _pats,
                          host_engine, insig=dom_sig, allow=_nb_allow)
    _arr = ({"subnets": arr_subs, "entries": arr_e, "legs": list(_relay_links(node_cfg)),
             "cln": _collapse4([p for p, _d in _cascade_local_routes(node_cfg)] + [e["subnet"] for e in exit_]
                               + [p for p, _d in (nets or ())])} if arr_e else None)
    _name_cats = {c for c, v in domains.items() if v} | {c for k, byc in _pats.items() for c, v in (byc or {}).items() if v}
    set_counts = _ensure_smart_nft(smart_e, smart_cats, res, pin=is_sni, v6_ifaces=smart_ifs,
                                    reset_mark=(SNI_RESET_MARK if is_sni else 0), queue=(host_engine == "sni_user"),
                                    learn_ttl=learn_ttl, srcs=(smart or {}).get("srcs"), shadows=_shw, arrivals=_arr,
                                    name_cats=_name_cats,
                                    static_cats={c for c in smart_cats if _CAT_CAPS.get(c, {}).get("ip") or ((smart or {}).get("cidrs") or {}).get(c)})
    if smart_cats:
        _smart_geo_refresh(smart_cats, set_counts or {}, res, additive={c for c, v in domains.items() if v})
    _smart_load_cidrs((smart or {}).get("cidrs") or {}, set_counts or {}, res)
    _subs = sorted({e["subnet"] for e in smart_e})
    _mech = (smart or {}).get("mech") or {}
    _doh_mech = {s for s, cats in _mech.items() if "doh" in (cats or [])}
    _SMART_MODE.pop("lowered", None)
    _SMART_MODE.pop("no_lower", None)
    if host_engine == "sni_user":
        domains, _pats = _smart_shadowed(domains, _pats, _shw)
        _ensure_sni_router(domains, _subs + arr_subs, res, learn_ttl, map_key=(dom_sig, (_shw or {}).get("sig", "")), patterns=_pats,
                           blocks=_SNI_BLOCKS["v"])
    else:
        _ensure_sni_router(None, [], res)
    _ensure_doh_block([], sorted(_doh_mech), res)
    _ensure_mech_block(_mech, res, scan_allow=(smart or {}).get("scan_allow") or [])
    _ensure_p2p((smart or {}).get("p2p"), _mech, node_cfg, res,
                routers=(smart or {}).get("p2p_routers") or [],
                portok=(smart or {}).get("p2p_portok"),
                fwd=(smart or {}).get("p2p_fwd"))
    _ensure_p2pfwd(_P2P["fwd"], node_cfg, res)
    return res


_KSNI = {"ok": None}


def _kernel_sni_ok():
    if _KSNI["ok"] is None:
        _KSNI["ok"] = (run(["sh", "-c", "command -v ipset >/dev/null 2>&1"]).returncode == 0
                       and run(["sh", "-c", "iptables -m string --help >/dev/null 2>&1"]).returncode == 0
                       and run(["sh", "-c", "iptables -m connbytes --help >/dev/null 2>&1"]).returncode == 0)
    return _KSNI["ok"]


_KSNI_SRC = {"ok": None}
_XTS_ARR = "swga"
_XTS_SRC = {}
_XTS_SRC_RE = re.compile(r"swgs_[0-9a-f]{12}")


def _ksni_src_ok():
    if _KSNI_SRC["ok"] is None:
        ok = _kernel_sni_ok()
        if ok:
            run(["ipset", "destroy", "swgs_probe"])
            ok = run(["ipset", "create", "swgs_probe", "hash:net,iface", "family", "inet"]).returncode == 0
            run(["ipset", "destroy", "swgs_probe"])
        _KSNI_SRC["ok"] = bool(ok)
    return _KSNI_SRC["ok"]


def _xts_srcsetname(wid):
    return "swgs_" + wid


def _ipset_headers():
    r = run(["ipset", "list", "-t"])
    if r.returncode != 0:
        return None
    out = {}
    for blk in (r.stdout or "").split("Name: ")[1:]:
        nm = blk.split("\n", 1)[0].strip()
        h = re.search(r"^Header: (.*)$", blk, re.M)
        t = re.search(r"\btimeout (\d+)", h.group(1)) if h else None
        n = re.search(r"^Number of entries: (\d+)", blk, re.M)
        out[nm] = {"timeout": t.group(1) if t else None, "n": int(n.group(1)) if n else -1}
    return out


def _xts_src_sets(want, res, hdrs=None):
    if not want:
        return
    have = {k: v["n"] for k, v in (hdrs or {}).items() if _XTS_SRC_RE.fullmatch(k) or k == _XTS_ARR}
    for sn, mem in sorted(want.items()):
        msig = hashlib.sha1(json.dumps(sorted(mem)).encode()).hexdigest()[:16]
        if sn in have and _XTS_SRC.get(sn) == msig and have[sn] == len(mem):
            continue
        tmp = sn + "t"
        body = ["create %s hash:net,iface family inet" % sn, "create %s hash:net,iface family inet" % tmp, "flush " + tmp]
        body += ["add %s %s,%s" % (tmp, a, d) for d, a in sorted(mem)]
        body += ["swap %s %s" % (tmp, sn), "destroy " + tmp]
        r = run(["ipset", "-exist", "restore"], input_text="\n".join(body) + "\n")
        if r.returncode == 0:
            _XTS_SRC[sn] = msig
        else:
            _XTS_SRC.pop(sn, None)
            res["errors"].append("kernel-sni: " + (r.stderr or "").strip()[:120])


def _xts_setname(cat):
    return ("swgk_" + re.sub(r"[^a-z0-9]", "_", cat.lower()))[:31]


_XTS_CAP = 256
_XTS_MAXLEN = 128
_XTS_CONNBYTES = 16
_XTS_NOPAYLOAD = 80
_XTS_SRVANS = 80
_XTS_PAT_MAX = 100


def _xts_ops(domains, contains, cap=_XTS_CAP):
    out, notes, built = {}, {}, {}
    for cat in sorted(set(list((contains or {}).keys()) + list((domains or {}).keys()))):
        raw_pats = (contains or {}).get(cat) or []
        doms = (domains or {}).get(cat) or []
        pats = raw_pats[:_XTS_PAT_MAX]
        seen, ops, n_long = set(), [], 0
        n_over = len(raw_pats) - len(pats)
        for o in pats:
            if not o or o in seen:
                continue
            seen.add(o)
            if len(o) > _XTS_MAXLEN:
                n_long += 1
                continue
            ops.append(o)
        n_pat = len(ops)
        for i, o in enumerate(doms):
            if len(ops) >= cap:
                n_over += len(doms) - i
                break
            if not o or o in seen:
                continue
            seen.add(o)
            if len(o) > _XTS_MAXLEN - 3:
                n_long += 1
                continue
            ops.append(o)
        if ops:
            out[cat] = ops
        if n_over or n_long:
            notes[cat] = {"over": n_over, "long": n_long}
        if n_pat:
            built[cat] = n_pat
    return out, notes, built


def _xts_pats(op, pattern):
    if pattern:
        return [["--string", op]]
    return [["--hex-string", "|00%04x|%s" % (len(op), op)], ["--string", "." + op]]


def _xts_scan(subnet, arr=False):
    return (["-m", "set", "--match-set", _XTS_ARR, "src,src"] if arr else ["-s", subnet]) + ["-p", "tcp", "--dport", "443",
            "-m", "connbytes", "--connbytes", "0:" + str(_XTS_CONNBYTES),
            "--connbytes-mode", "packets", "--connbytes-dir", "original",
            "-m", "string", "--algo", "bm"]


_IPT_SAFE_ARG = re.compile(r"[A-Za-z0-9_.:/,!*+@%=-]+")


def _ipt_restore_arg(a):
    a = str(a)
    return a if _IPT_SAFE_ARG.fullmatch(a) else '"' + a.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _xts_split(rules, chain):
    head, groups, order = [], {}, []
    for r in rules:
        a = r[2:]
        if "-s" in a:
            key = ("-s", a[a.index("-s") + 1])
        elif "--match-set" in a and a[a.index("--match-set") + 1] == _XTS_ARR:
            key = ("arr", _XTS_ARR)
        else:
            head.append(r)
            continue
        if key not in groups:
            groups[key] = []; order.append(key)
        groups[key].append(a)
    out, subs = list(head), []
    for i, key in enumerate(order, 1):
        subs.append("%s_%d" % (chain, i))
        sel = ["-s", key[1]] if key[0] == "-s" else ["-m", "set", "--match-set", _XTS_ARR, "src,src"]
        out.append(["-A", chain, *sel, "-j", subs[-1]])
    for name, key in zip(subs, order):
        rs = groups[key]
        k = next((i for i, a in enumerate(rs) if "--string" in a or "--hex-string" in a), None)
        if k is not None:
            rs = rs[:k] + [["-m", "length", "--length", "0:%d" % _XTS_NOPAYLOAD, "-j", "RETURN"],
                           ["-m", "connbytes", "--connbytes", "%d:" % (_XTS_SRVANS + 1), "--connbytes-dir", "reply",
                            "--connbytes-mode", "avgpkt", "-j", "RETURN"]] + rs[k:]
        out += [["-A", name, *a] for a in rs]
    return out, subs


def _xts_drop_subchains(keep=()):
    gone = [c for c in re.findall(r"^-N (SWGK(?:_\d+|L_\d+|B_\d+t?))$", run(["iptables", "-t", "mangle", "-S"]).stdout or "", re.M)
            if c not in keep]
    for c in gone:
        run(["iptables", "-t", "mangle", "-F", c])
    for c in gone:
        run(["iptables", "-t", "mangle", "-X", c])


def _xts_reap(want_cats, want_srcs=()):
    keep = {_xts_setname(c) for c in want_cats} | set(want_srcs)
    for setn in re.findall(r"^(swgk_\S+|swgs_\S+|swgat?$)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
        if setn.startswith("swgs_") and not (_XTS_SRC_RE.fullmatch(setn) or _XTS_SRC_RE.fullmatch(setn[:-1])):
            continue
        if setn not in keep:
            run(["ipset", "destroy", setn])
            _XTS_SRC.pop(setn, None)


def _ensure_smart_xtstring(host_entries, domains, reset_mark, res, active=True, ttl=3600, contains=None, srcs=None, arrivals=None):
    CHAIN = "SWGK"
    ops, ops_notes, ops_built = _xts_ops(domains, contains) if active else ({}, {}, {})
    entries = [e for e in host_entries if ops.get(e["category"]) and ("src" not in e or _SRC_WID_RE.fullmatch(str(e["src"])))] \
        if active else []
    want_srcs = {_xts_srcsetname(e["src"]): _src_pairs((srcs or {}).get(e["src"])) for e in entries if "src" in e}
    arr_ents = [e for e in ((arrivals or {}).get("entries") or []) if ops.get(e["category"])] if active else []
    if arr_ents:
        want_srcs[_XTS_ARR] = {(str(d), str(n)) for n, d in ((arrivals or {}).get("pairs") or ())}
    _SMART_MODE["xts_idle"] = not entries and not arr_ents
    rents = [e for e in entries if e.get("action", "exit") != "block"]
    arr_r = [e for e in arr_ents if e.get("action", "exit") != "block"]
    want_cats = sorted({e["category"] for e in rents + arr_r})
    _want_ents = {e["category"] for e in list(host_entries) + list((arrivals or {}).get("entries") or [])} if active else set()
    _capped = sorted(c for c in _want_ents if (ops_notes.get(c) or {}).get("over"))
    _missed = sum((ops_notes.get(c) or {}).get("over") or 0 for c in _want_ents)
    _long = sum((ops_notes.get(c) or {}).get("long") or 0 for c in _want_ents)
    if _capped or _long:
        _SMART_MODE["xts_cap"] = {"cap": _XTS_CAP, "capped": _capped, "missed": _missed,
                                  **({"long": _long, "maxlen": _XTS_MAXLEN} if _long else {})}
    else:
        _SMART_MODE.pop("xts_cap", None)
    _pat_lowered = sum(ops_built.get(c) or 0 for c in _want_ents)
    if active and _pat_lowered:
        _SMART_MODE["lowered"] = {"contains": _pat_lowered}
    rules = [["-A", CHAIN, "-m", "connbytes", "--connbytes", "%d:" % (_XTS_CONNBYTES + 1),
              "--connbytes-mode", "packets", "--connbytes-dir", "original", "-j", "RETURN"]]
    xrules, xchains, bj = [], [], 0
    def _who(e, arr=False):
        if arr:
            return ["!", "-i", e["via_iface"]] if e.get("action", "exit") == "exit" and e.get("via_iface") else []
        return ["-m", "set", "--match-set", _xts_srcsetname(e["src"]), "src,src"] if "src" in e else []
    def _blocks(ents, sel, arr=False):
        nonlocal bj
        has = False
        for i, e in enumerate(ents):
            if e.get("action") != "block":
                continue
            bc, tc = "SWGKB_%d" % bj, "SWGKB_%dt" % bj
            bj += 1
            rules.append(["-A", CHAIN, *sel, *([] if arr else _who(e)), "-m", "connbytes", "--connbytes", "0:%d" % _XTS_SRVANS,
                          "--connbytes-dir", "reply", "--connbytes-mode", "avgpkt", "-m", "length", "--length",
                          "%d:65535" % (_XTS_NOPAYLOAD + 1), "-j", bc])
            for d in ops.get(e["category"]) or []:
                for pat in _xts_pats(d, d in cpat.get(e["category"], ())):
                    xrules.append(["-A", bc, "-m", "string", "--algo", "bm", *pat, "-g", tc])
            for x in ents[:i]:
                if x.get("action", "exit") == "block":
                    continue
                for d in ops.get(x["category"]) or []:
                    for pat in _xts_pats(d, d in cpat.get(x["category"], ())):
                        xrules.append(["-A", tc, *_who(x, arr), "-m", "string", "--algo", "bm", *pat, "-j", "RETURN"])
            xrules.append(["-A", tc, "-j", "MARK", "--set-mark", hex(SNI_BLOCK_MARK)])
            xchains.extend([bc, tc])
            has = True
        if has:
            rules.append(["-A", CHAIN, *sel, "-m", "mark", "--mark", "%#x/0xffff" % SNI_BLOCK_MARK, "-j", "RETURN"])
    cpat = {c: set(((contains or {}).get(c) or [])[:_XTS_PAT_MAX]) for c in (contains or {})}
    _bysrc = {}
    for e in entries:
        _bysrc.setdefault(e["subnet"], []).append(e)
    for S in _bysrc:
        _blocks(_bysrc[S], ["-s", S])
    _blocks(arr_ents, ["-m", "set", "--match-set", _XTS_ARR, "src,src"], arr=True)
    for e in rents:
        setn = _xts_setname(e["category"]); T = str(e.get("table"))
        if e.get("action", "exit") == "direct":
            T = hex(SNI_DIRECT_MARK)
        who = ["-m", "set", "--match-set", _xts_srcsetname(e["src"]), "src,src"] if "src" in e else []
        rules.append(["-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", *who, "-j", "MARK", "--set-mark", T])
        rules.append(["-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", *who, "-j", "CONNMARK", "--set-mark", T])
        rules.append(["-A", CHAIN, "-s", e["subnet"], "-m", "set", "--match-set", setn, "dst", *who, "-j", "RETURN"])
    for S, c in sorted({(e["subnet"], e["category"]) for e in rents if "src" in e}):
        rules.append(["-A", CHAIN, "-s", S, "-m", "set", "--match-set", _xts_setname(c), "dst", "-j", "RETURN"])
    _asrc = ["-m", "set", "--match-set", _XTS_ARR, "src,src"]
    for e in arr_r:
        setn = _xts_setname(e["category"])
        T = hex(SNI_DIRECT_MARK) if e.get("action") == "direct" else str(e.get("table"))
        gd = ["!", "-i", e["via_iface"]] if e.get("action") != "direct" else []
        for tgt in (["MARK", "--set-mark", T], ["CONNMARK", "--set-mark", T], ["RETURN"]):
            rules.append(["-A", CHAIN, *gd, *_asrc, "-m", "set", "--match-set", setn, "dst", "-j", *tgt])
    for c in sorted({e["category"] for e in arr_r}):
        rules.append(["-A", CHAIN, *_asrc, "-m", "set", "--match-set", _xts_setname(c), "dst", "-j", "RETURN"])
    learn = list(dict.fromkeys([(e["subnet"], e["category"]) for e in rents]
                               + [(None, e["category"]) for e in arr_r]))
    lchain = {c: "SWGKL_%d" % k for k, c in enumerate(want_cats)}
    lrules = []
    for c in want_cats:
        lrules.append(["-A", lchain[c], "-j", "SET", "--add-set", _xts_setname(c), "dst"])
        if reset_mark:
            lrules.append(["-A", lchain[c], "-j", "MARK", "--set-mark", hex(reset_mark)])
    for S, c in learn:
        for d in ops.get(c) or []:
            for pat in _xts_pats(d, d in cpat.get(c, ())):
                rules.append(["-A", CHAIN, *_xts_scan(S, S is None), *pat, "-j", lchain[c]])
        if reset_mark:
            rules.append(["-A", CHAIN, *(["-s", S] if S is not None else _asrc), "-m", "mark", "--mark", hex(reset_mark),
                          "-j", "CONNMARK", "--save-mark"])
    rules, subs = _xts_split(rules, CHAIN)
    rules += lrules + xrules
    subs += [lchain[c] for c in want_cats] + xchains
    sig = hashlib.sha1((json.dumps(rules) + "|ttl:" + str(ttl)).encode()).hexdigest()[:16]
    sigf = os.path.join(GEO_DIR, ".xtstring-sig")
    try:
        stored = open(sigf).read().strip()
    except OSError:
        stored = ""
    hooked = run(["iptables", "-t", "mangle", "-C", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN]).returncode == 0
    hdrs = _ipset_headers() if (entries or arr_ents) else {}
    _xts_src_sets(want_srcs, res, hdrs)
    if (entries or arr_ents) and hdrs is None:
        res["errors"].append("kernel-sni: ipset list failed — learned-IP lifetime not checked this pass")
    for c in (want_cats if hdrs else ()):
        setn = _xts_setname(c)
        if setn not in hdrs or hdrs[setn]["timeout"] == str(ttl):
            continue
        run(["ipset", "destroy", "swgk_TTL"])
        r = run(["ipset", "restore"], input_text="create swgk_TTL hash:ip family inet timeout %s\nswap swgk_TTL %s\n"
                                                     "destroy swgk_TTL\n" % (ttl, setn))
        if r.returncode != 0:
            res["errors"].append("kernel-sni: learned-IP lifetime not applied to %s: %s" % (setn, (r.stderr or "").strip()[:80]))
    if stored == sig and (hooked if (entries or arr_ents) else not hooked):
        for c in want_cats:
            run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
        _xts_reap(want_cats, want_srcs)
        return want_cats
    if (entries or arr_ents) and not _kernel_sni_ok():
        res["errors"].append("kernel-sni: ipset/xt_string unavailable"); return []
    if entries or arr_ents:
        for c in want_cats:
            run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
        lines = ["*mangle"] + [":%s - [0:0]" % c for c in [CHAIN] + subs] + [" ".join(_ipt_restore_arg(x) for x in a) for a in rules]
        if not hooked:
            lines.append("-A PREROUTING -p tcp --dport 443 -j %s" % CHAIN)
        r = run(["iptables-restore", "--noflush", "-w", "5"], input_text="\n".join(lines + ["COMMIT"]) + "\n", timeout=120)
        if r.returncode == 0:
            _xts_drop_subchains(keep=subs)
            _xts_reap(want_cats, want_srcs)
            res["changed"] += 1
            with contextlib.suppress(OSError):
                os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)
            return want_cats
        res["errors"].append("kernel-sni: one-transaction rebuild refused (%s) — rebuilding rule by rule"
                             % ((r.stderr or "").strip().splitlines() or ["?"])[-1][:100])
    run(["iptables", "-t", "mangle", "-D", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN])
    run(["iptables", "-t", "mangle", "-F", CHAIN]); run(["iptables", "-t", "mangle", "-X", CHAIN])
    _xts_drop_subchains()
    if not entries and not arr_ents:
        for setn in re.findall(r"^(swgk_\S+)", (run(["ipset", "list", "-name"]).stdout or ""), re.M):
            run(["ipset", "destroy", setn])
        _xts_reap([])
        with contextlib.suppress(OSError):
            if run(["iptables", "-t", "mangle", "-S", CHAIN]).returncode != 0:
                os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)
            else:
                os.remove(sigf)
        return []
    _xts_reap(want_cats, want_srcs)
    _ok = [True]
    def _ipt(*a):
        r = run(["iptables", "-t", "mangle", *a])
        if r.returncode != 0:
            res["errors"].append("kernel-sni: " + (r.stderr or "").strip()[:120]); _ok[0] = False
    for c in want_cats:
        run(["ipset", "create", _xts_setname(c), "hash:ip", "family", "inet", "timeout", str(ttl), "-exist"])
    _ipt("-N", CHAIN)
    for c in subs:
        _ipt("-N", c)
    for a in rules:
        _ipt(*a)
    _ipt("-A", "PREROUTING", "-p", "tcp", "--dport", "443", "-j", CHAIN)
    if _ok[0]:
        res["changed"] += 1
        with contextlib.suppress(OSError):
            os.makedirs(GEO_DIR, exist_ok=True); open(sigf, "w").write(sig)
    return want_cats


_SNI_TIER2_MAX = 1000
_SNI_TIER2_KINDS = ("starts", "ends", "contains")
_SNI_CAP_SAMPLE = 5
_SNI_CAP_OPLEN = 40


def _sni_tier2_cap(patterns, cap=None):
    cap = _SNI_TIER2_MAX if cap is None else cap
    out = {k: v for k, v in (patterns or {}).items() if k not in _SNI_TIER2_KINDS}
    order = []
    for kind in _SNI_TIER2_KINDS:
        byc = (patterns or {}).get(kind) or {}
        ops = {}
        for cat, lst in byc.items():
            for o in (lst or []):
                if o:
                    ops.setdefault(o, []).append(cat)
        for o in sorted(ops, key=lambda x: (-len(x), x)):
            order.append((kind, o, ops[o]))
    kept, dropped_cats, missed, sample = order[:cap], set(), 0, []
    for kind, o, cats in order[cap:]:
        missed += 1
        dropped_cats |= set(cats)
        if len(sample) < _SNI_CAP_SAMPLE:
            sample.append([kind, o if len(o) <= _SNI_CAP_OPLEN else o[:_SNI_CAP_OPLEN - 1] + "…"])
    for kind, o, cats in kept:
        b = out.setdefault(kind, {})
        for c in cats:
            b.setdefault(c, []).append(o)
    return out, {"capped": sorted(dropped_cats), "missed": missed, "sample": sample}


_SNI_MAP_LAST = {"key": None, "stat": None, "n": 0}


def _ensure_sni_router(domains, subnets, res, learn_ttl=3600, map_key=None, patterns=None, blocks=None):
    want = domains is not None and bool(subnets)
    _SMART_MODE["sni_idle"] = not want
    p = _SNI_PROC.get("p")
    if not want:
        if p and p.poll() is None:
            with contextlib.suppress(Exception): p.terminate()
        _SNI_PROC["p"] = None
        _SMART_MODE.pop("sni_cap", None)
        with contextlib.suppress(OSError): os.remove(SNI_MAP_PATH)
        with contextlib.suppress(OSError): os.remove(SNI_PATTERNS_PATH)
        with contextlib.suppress(OSError): os.remove(SNI_BLOCKS_PATH)
        with contextlib.suppress(OSError): os.remove(SNI_SETS_PATH)
        return
    if p and p.poll() is None and _SNI_PROC.get("ttl") != learn_ttl:
        with contextlib.suppress(Exception): p.terminate()
        _SNI_PROC["p"] = None; p = None
    def _put_blocks():
        newblk = json.dumps(blocks, sort_keys=True) if blocks else ""
        oldblk = ""
        with contextlib.suppress(OSError):
            with open(SNI_BLOCKS_PATH) as f: oldblk = f.read()
        if newblk != oldblk:
            if not newblk:
                with contextlib.suppress(OSError): os.remove(SNI_BLOCKS_PATH)
