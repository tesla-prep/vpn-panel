def sample_catk():
    now = time.time()
    if _CATK["cum"] is not None and (now - _CATK["t"]) < CATK_SAMPLE_EVERY_S:
        return dict(_CATK["rate"])
    if not _CATK["on"]:
        _CATK["cum"] = None; _CATK["rate"] = {}
        return {}
    r = run(["iptables", "-t", "mangle", "-S", SWG_CATK_CHAIN, "-v"])
    if r.returncode == 1:
        _CATK["cum"] = None; _CATK["rate"] = {}
        return {}
    if r.returncode != 0:
        return dict(_CATK["rate"])
    cum = {}
    for m in re.finditer(r'--comment "?swg-catk-(up|dn):([^"\s]+)"?.* -c \d+ (\d+)', r.stdout or ""):
        cum.setdefault(m.group(2), {"up": 0, "dn": 0})[m.group(1)] += int(m.group(3))
    prev, pt = _CATK["cum"], _CATK["t"]
    if prev is not None and now > pt:
        dt = now - pt
        _CATK["rate"] = {c: {"up": max(0.0, v["up"] - (prev.get(c) or {}).get("up", 0)) / dt,
                             "dn": max(0.0, v["dn"] - (prev.get(c) or {}).get("dn", 0)) / dt}
                         for c, v in cum.items()}
    _CATK["cum"] = cum; _CATK["t"] = now
    return dict(_CATK["rate"])


