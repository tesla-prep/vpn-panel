def _s5x_rules(devexit, nets, res):
    socks = _EXITS.get("socks") or {}
    _ifc = [e for e in devexit if e.get("dev") in socks and e.get("subnet")
            and (e.get("scope") or "iface") != "rule"
            and (e.get("scope") != "static" or not e.get("part"))]
    _full = {str(e["subnet"]) for e in _ifc if not e.get("part")}
    _fell = _s5x_arr_dns(sorted({str(e["subnet"]) for e in _ifc if e.get("part")} - _full), res, bool(socks))
    whole = sorted({e["subnet"] for e in _ifc if (not e.get("part") or str(e["subnet"]) in _fell)
                    and _devexit_state(e["dev"]) == "up"})
    if whole or _S5X_NFT["dns"] is not False:
        _p, _had = _dns_dnat(whole, res, [p for p, _i in (nets or ())], S5X_DNS_TAG, S5X_DNS_NET_TAG, S5X_DNS + ":53", ("udp",))
        _S5X_NFT["dns"] = bool(whole) or _had
    rej = sorted(d for d, ok in socks.items() if not ok and _WANIF_RE.match(str(d or "")))
    unm = sorted({int(e["table"]) for e in devexit if e.get("dev") in socks and not socks[e["dev"]]
                  and e.get("scope") == "rule" and str(e.get("table") or "").isdigit()})
    watch = sorted({e["dev"] for e in devexit if socks.get(e.get("dev")) is True and e.get("scope") == "rule" and str(e.get("table") or "").isdigit()})
    sig = (tuple(rej), tuple(unm), tuple(watch))
    if sig == _S5X_NFT["sig"]:
        if not (rej or unm or watch) or run(["nft", "list", "table", "inet", S5X_NFT_TABLE]).returncode == 0:
            return
    if not rej and not unm and not watch:
        r = run(["nft", "delete", "table", "inet", S5X_NFT_TABLE])
        ok, gone = r.returncode == 0 or _nft_absent(r) or r.returncode == 127, r.returncode == 0
    else:
        L = ["table inet %s {}" % S5X_NFT_TABLE, "delete table inet %s" % S5X_NFT_TABLE, "table inet %s {" % S5X_NFT_TABLE,
             "  chain udp_refuse { type filter hook forward priority filter - 1; policy accept;"]
        L += ['    oifname "%s" ip daddr != %s meta l4proto udp reject with icmpx type port-unreachable' % (d, S5X_DNS)
              for d in rej]
        L += ['    oifname "%s" ip daddr != %s udp dport 53 counter comment "q %s"' % (d, S5X_DNS, d) for d in watch]
        L += ['    iifname "%s" ip saddr != %s udp sport 53 counter comment "a %s"' % (d, S5X_DNS, d) for d in watch]
        L += ["  }", "  chain dns_unmark { type filter hook prerouting priority mangle + 6; policy accept;"]
        L += ["    meta mark %#x udp dport 53 meta mark set 0x0" % t for t in unm]
        L += ["  }", "}"]
        r = run(["nft", "-f", "-"], input_text="\n".join(L) + "\n")
        ok = gone = r.returncode == 0
    if ok:
        _S5X_NFT["sig"] = sig
        res["changed"] += 1 if gone else 0
    else:
        res["errors"].append("socks5 exit rules: " + ((r.stderr or "").strip() or "nft failed")[:160])


def _s5x_arr_dns(want, res, any_socks=True):
    if not want and (_S5X_NFT["arr"] is False or (_S5X_NFT["arr"] is None and not any_socks)):
        _S5X_NFT["arr"] = False
        return set()
    say = lambda bad: res["errors"].append("socks5 exit: arrivals' DNS bypass not installed for " + ", ".join(bad[:3])
                                           + " — their DNS uses the proxy's stand-in addresses")
    key = tuple(want)
    _b = _S5X_NFT["arr_bad"]
    if _b and _b[0] == key and time.monotonic() - _b[2] < S5X_CHECK_EVERY_S:
        say(_b[1])
        return set(_b[1])
    _one = lambda a: a if "/" in a else a + "/32"
    cur = [ln for ln in (run(["ip", "rule", "show"]).stdout or "").splitlines() if ln.startswith("%d:" % S5X_ARR_DNS_PRI)]
    have = []
    for ln in cur:
        m = re.search(r"from (\S+)", ln)
        if m and "dport 53" in ln:
            have.append(_one(m.group(1)))
    have.sort()
    bad = []
    if have != sorted(_one(S) for S in want) or len(cur) != len(have):
        for _ in range(8 + len(cur)):
            if run(["ip", "rule", "del", "pref", str(S5X_ARR_DNS_PRI)]).returncode != 0:
                break
        bad = [S for S in want if run(["ip", "rule", "add", "from", S, "ipproto", "udp", "dport", "53", "lookup", "main",
                                       "priority", str(S5X_ARR_DNS_PRI)]).returncode != 0]
        if bad:
            say(bad)
        res["changed"] += 1
    _S5X_NFT["arr_bad"] = (key, bad, time.monotonic()) if bad else None
    _S5X_NFT["arr"] = bool(want)
    return set(bad)


def _dns_dnat(subnets, res, nets, tag_dnat, tag_net, to, protos):
    _one = lambda a: a if "/" in a else a + "/32"
    subnets = [_one(str(S)) for S in subnets]
    want = {(S, proto) for S in subnets for proto in protos}
    prefixes = sorted({_net_prefix(x) for x in (nets or ()) if _net_prefix(x)}) if subnets else []
    want_x = {(S, P, proto) for S in subnets for P in prefixes for proto in protos}
    out = getattr(run(["iptables", "-t", "nat", "-S", "PREROUTING"]), "stdout", "") or ""
    live, live_x, x_lines, order_bad, dnat_seen = set(), set(), [], False, False
    for ln in out.splitlines():
        mc = re.search(r"--comment \"?([^\"\s]+)", ln)
        tag = mc.group(1) if mc else ""
        ms = re.search(r"-s (\S+)", ln); mp = re.search(r"-p (\w+)", ln)
        if not (ms and mp):
            continue
        if tag == tag_dnat and "-j DNAT" in ln:
            live.add((_one(ms.group(1)), mp.group(1))); dnat_seen = True
        elif tag == tag_net and "-j RETURN" in ln:
            md = re.search(r"-d (\S+)", ln)
            if md:
                live_x.add((_one(ms.group(1)), _net_prefix(md.group(1)) or _one(md.group(1)), mp.group(1)))
                x_lines.append(ln)
                order_bad = order_bad or dnat_seen

    def rule(S, proto):
        return ["-s", S, "-p", proto, "--dport", "53", "-m", "comment", "--comment", tag_dnat,
                "-j", "DNAT", "--to-destination", to]

    def xrule(S, P, proto):
        return ["-s", S, "-d", P, "-p", proto, "--dport", "53", "-m", "comment", "--comment", tag_net, "-j", "RETURN"]
    if order_bad:
        for ln in x_lines:
            if _ipt_del_listed(["-t", "nat"], "PREROUTING", ln):
                res["changed"] += 1
        live_x = set()
    for (S, P, proto) in sorted(live_x - want_x):
        run(["iptables", "-t", "nat", "-D", "PREROUTING"] + xrule(S, P, proto)); res["changed"] += 1
    for (S, P, proto) in sorted(want_x - live_x):
        run(["iptables", "-t", "nat", "-I", "PREROUTING", "1"] + xrule(S, P, proto)); res["changed"] += 1
    for (S, proto) in sorted(want - live):
        run(["iptables", "-t", "nat", "-A", "PREROUTING"] + rule(S, proto)); res["changed"] += 1
    for (S, proto) in sorted(live - want):
        run(["iptables", "-t", "nat", "-D", "PREROUTING"] + rule(S, proto)); res["changed"] += 1
    return prefixes, bool(live or live_x)


