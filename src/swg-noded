def _unit_states(units):
    r = run(["systemctl", "show", "-p", "Id", "-p", "ActiveState", "--"] + list(units))
    out = {}
    if r.returncode != 0:
        return out
    cur = {}
    for ln in (r.stdout or "").splitlines() + [""]:
        if not ln.strip():
            if cur.get("Id"):
                out[cur["Id"]] = cur.get("ActiveState", "")
            cur = {}
            continue
        k, _, v = ln.partition("=")
        cur[k] = v
    return out


def host_sh(cmd, timeout=90, probe=False):
    if not _host_sh_available():
        if not _HOST_SH_CAP["warned"]:
            _HOST_SH_CAP["warned"] = True
            log(LOG_WARNING, "host_sh: no docker socket on this node (TURN_MANAGE=manual) — host-side reads, "
                  "foreign-server discovery and unit management are unavailable; "
                  "further attempts are skipped silently")
        class _R:
            returncode = 126; stdout = ""; stderr = "host_sh unavailable: no docker socket mounted"
        return _R()
    if NODE_KIND != "docker":
        args = ["sh", "-c", cmd] if os.geteuid() == 0 else ["sudo", "-n", "sh", "-c", cmd]
    else:
        _wrapped = _HOST_PATH_PREFIX + cmd
        args = ["docker", "run", "--rm", "--privileged", "--pid=host", "--network", "none", "--entrypoint", "nsenter",
                HELPER_IMAGE, "-t", "1", "-m", "-u", "-i", "-n", "-p", "--", "sh", "-c", _wrapped]
    try:
        r = run(args, timeout=timeout)
    except Exception as e:
        log(LOG_ERR, "host_sh EXC: " + str(e) + " :: " + cmd[:160])
        class _R:
            returncode = 127; stdout = ""; stderr = str(e)
        return _R()
    if r.returncode != 0:
        log(LOG_DEBUG if probe else LOG_WARNING, "host_sh rc=%s :: %s :: %s", r.returncode, cmd[:160],
            (r.stderr or r.stdout or "")[:300])
    return r

