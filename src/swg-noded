_AWG_GEN = {"at": 0.0, "v": None}
_AWG_GEN_TTL = 300
AWG_GEN_ORDER = {"2.0": 0, "3.0": 1, "3.1": 2}


def _genl_family(name):
    s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 16)
    try:
        s.settimeout(2)
        s.bind((0, 0))
        n = name.encode() + b"\0"
        attr = struct.pack("HH", 4 + len(n), 2) + n
        attr += b"\0" * ((4 - len(attr) % 4) % 4)
        body = struct.pack("BBH", 3, 1, 0) + attr
        s.send(struct.pack("IHHII", 16 + len(body), 0x10, 1, 1, 0) + body)
        d = s.recv(65536)
    finally:
        s.close()
    ln, typ = struct.unpack("IH", d[:6])
    if typ == 2:
        err = -struct.unpack("i", d[16:20])[0]
        if err == 2:
            return None
        raise OSError(err, os.strerror(err))
    out, p = {}, 20
    while p + 4 <= ln:
        al, at = struct.unpack("HH", d[p:p + 4])
        if al < 4:
            break
        if at in (3, 5):
            out[at] = struct.unpack("I", d[p + 4:p + 8])[0]
        p += (al + 3) & ~3
    return out.get(3), out.get(5)


def _awg_module_gen():
    try:
        vm = _genl_family("amneziawg")
    except Exception:
        return "unknown"
    if vm is None:
        return None
    v, m = vm[0], vm[1] or 0
    return "2.0" if v == 2 and m >= 25 else ("3.1" if v == 3 and m >= 34 else ("3.0" if v == 3 and m >= 32 else "unknown"))


def _awg_disk_gen():
    if NODE_KIND == "docker":
        return None
    try:
        v = run(["modinfo", "-F", "version", "amneziawg"]).stdout.strip()
    except Exception:
        return None
    m = re.match(r"^(\d+)\.(\d+)", v or "")
    if not m:
        return None
    a, b = int(m.group(1)), int(m.group(2))
    return "2.0" if a == 1 else ("3.1" if a == 3 and b >= 1 else ("3.0" if a == 3 else None))


def _bin_gen(path, k31, k30):
    if not path or not os.path.isfile(path):
        return None
    with open(path, "rb") as f:
        head = f.read(4096)
    w = re.search(rb'"(/[^"]+/\.[^/"]+-wrapped)"', head) if head.startswith(b"#!") else None
    if w and os.path.isfile(w.group(1).decode(errors="replace")):
        path = w.group(1).decode(errors="replace")
    with open(path, "rb") as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as m:
        return "3.1" if m.find(k31) >= 0 else ("3.0" if m.find(k30) >= 0 else "2.0")


def _awg_gen_sig():
    sig = []
    with contextlib.suppress(OSError):
        sig.append(open("/sys/module/amneziawg/version").read().strip())
    for p in ("/lib/modules/%s/modules.dep" % os.uname().release, shutil.which("awg") or ""):
        try:
            st = os.stat(p)
            sig.append("%s:%d:%d" % (p, st.st_mtime_ns, st.st_size))
        except OSError:
            sig.append(p + ":-")
    return "|".join(sig)


def awg_gen_report(now=None):
    now = now or time.monotonic()
    sig = _awg_gen_sig()
    if _AWG_GEN["v"] is not None and now - _AWG_GEN["at"] < _AWG_GEN_TTL and _AWG_GEN.get("sig") == sig:
        return dict(_AWG_GEN["v"])
    g = {"module": _awg_module_gen(), "tools": None, "disk": _awg_disk_gen()}
    with contextlib.suppress(Exception):
        g["tools"] = _bin_gen(shutil.which("awg"), b"RandomTrailers", b"HeaderProtectionKey")
    _AWG_GEN.update(at=now, v=g, sig=sig)
    return dict(g)


def _with_awg_gen(dp):
