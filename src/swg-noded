EnvironmentFile=/etc/swg-panel/relay/%i.env
ExecStart=RELAY_BIN_PATH --port ${RELAY_PORT} --bind ${RELAY_BIND} --mark ${RELAY_MARK} --cc ${RELAY_CC_UP} --cc-cli ${RELAY_CC_CLI} --mss ${RELAY_MSS} --status-sock ${RELAY_SOCK} --report 300
Restart=always
