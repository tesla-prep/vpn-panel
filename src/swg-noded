_AWAIT_KEY = set()


_PIN_HINT = {"at": 0.0}


def _pin_mismatch_hint(err, panel=None):
    if err not in ("tls fingerprint mismatch", "tls pin malformed") or time.time() - _PIN_HINT["at"] < 3600:
        return
    _PIN_HINT["at"] = time.time()
    def nixos(sha):
        return ("services.swg-node.panelTlsFingerprint in its configuration.nix: set it to %s, or clear it and set "
                "verifyPanelTls = true for a certificate a public CA vouches for (verified, not pinned — a pin breaks at "
                "its next renewal); then run nixos-rebuild switch%s."
                % (sha, "" if NODE_KIND == "docker" else " and restart swg-noded"))
    if err == "tls pin malformed":
        fp = str((panel or {}).get("fingerprint") or "")
        fix = ("On this NixOS node the pin is " + nixos("the panel's sha256") if NODE_PLATFORM == "nixos" else
               "Re-run the node installer on this box at a terminal: it shows the certificate the panel presents and asks "
               "before pinning it. Unattended, give it TLS_FINGERPRINT=<the panel's sha256>, or TLS_VERIFY=yes for one a "
               "public CA vouches for.")
        log(LOG_ERR, "panel TLS: the pin on record for the panel is not a sha256 fingerprint%s, so every sync is refused and "
              "nothing is sent — it names no certificate at all. %s"
              % ((' ("%s%s")' % (fp[:24], "…" if len(fp) > 24 else "")) if fp else "", fix))
        return
    fix = ("this NixOS node's pin is " + nixos("the new sha256") if NODE_PLATFORM == "nixos" else
           "re-run the node installer on this box at a terminal and accept the new certificate when it asks (one a public "
           "CA vouches for is then verified, not pinned); unattended it never takes a changed certificate — give it "
           "TLS_FINGERPRINT=<the new sha256>, or TLS_VERIFY=yes for a CA one.")
    log(LOG_ERR, "panel TLS: the panel's certificate no longer matches this node's pin, so every sync is refused. If the "
          "panel's certificate was renewed or replaced on purpose, %s Anything else may be an impersonator." % fix)


def create_ifaces(node_cfg, create, agent, sudo):
    res = {"created": [], "errors": []}
    if not create:
        return res
    ifaces = node_cfg.setdefault("interfaces", {})
    changed = False
    _live = None
    for iface, want in create.items():
        _no3 = awg_gen_refusal(iface, (want or {}).get("awg_params"))
        if _no3:
            res["errors"].append(f"{iface}: {_no3}")
            continue
        if iface in ifaces:
            if _live is None:
                _live = _live_wg_ifaces()
            if iface in _live:
                continue
            if not want.get("restore"):
                res["errors"].append(
                    f"{iface}: this node already has a record for {iface} but no such interface exists here — "
                    f"it cannot be created again under that name. Restore it (that reuses its original server "
                    f"key, so existing clients keep working), or delete it and create it under a free name.")
                continue
            _stale = (ifaces.get(iface) or {}).get("conf")
            if _stale and os.path.exists(_stale):
                with contextlib.suppress(OSError):
                    os.unlink(_stale)
            log(LOG_WARNING, "create: %s is recorded here but its device is gone — dropping the stale record and "
                  "restoring it with its original key" % iface)
            ifaces.pop(iface, None)
            changed = True
        cmd = want.get("cmd") or ["awg"]
        priv = (want.get("private_key") or "").strip()
        if not priv and want.get("sealed_key"):
            with contextlib.suppress(Exception):
                priv = ivk_unseal(transport_priv(), want["sealed_key"]).decode().strip()
        if not priv and want.get("restore"):
            priv = ((read_iface_backup(iface) or {}).get("private_key") or "").strip()
        if not priv and want.get("hold_key"):
            _AWAIT_KEY.add(iface)
            log(LOG_WARNING, "create: %s HOLDING — the panel holds its escrowed key; unlock the vault and restore it "
                  "(minting here would re-key every client)" % iface)
            continue
        _AWAIT_KEY.discard(iface)
        r = run_agent(agent, sudo, {"op": "create-iface", "iface": iface, "cmd": cmd,
                                    "subnet": want.get("subnet"), "listen_port": want.get("listen_port"),
                                    "address": want.get("address"),
                                    "private_key": priv,
                                    "awg_params": want.get("awg_params"),
                                    **({"awg_params_exact": True} if want.get("awg_params_exact") else {}),
                                    "mtu": want.get("mtu")})
        if not r.get("ok"):
            res["errors"].append(f"{iface}: {r.get('error')}"); continue
        data = r.get("data") or {}
        conf = data.get("conf") or ""
        if not conf:
            res["errors"].append(f"{iface}: agent returned no conf path"); continue
        with contextlib.suppress(Exception):
            _ctext = open(conf).read()
            if not priv:
                _new = harvest_iface_backup(_ctext, cmd)
                _old = read_iface_backup(iface) or {}
                if _new and _old.get("public_key") and _old.get("public_key") != _new.get("public_key"):
                    write_iface_backup(iface, _new)
                    log(LOG_INFO, "keys: %s is a new interface — the older key backup under its name (of an interface deleted "
                          "before) is replaced by its own" % iface)
            ensure_iface_backup(iface, _ctext, cmd)
        ifaces[iface] = {"cmd": data.get("cmd") or cmd, "conf": conf}
        changed = True
        res["created"].append(iface)
    if changed:
        try:
            _persist_config(node_cfg)
        except Exception as e:
            res["errors"].append(f"persist config.json: {e}")
    return res


