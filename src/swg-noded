            if fn.endswith(".conf"):
                extra[fn[:-5]] = os.path.join(EXIT_DIR, fn)
    r = run_agent(agent, sudo, {"op": "reload-awg-module", "extra_confs": extra, "id": pid, "result_path": AWG_LOAD_RESULT},
                  timeout=600, scope="swg-awg-load-%d-%d" % (n, int(time.time())))
    if r.get("ok"):
        _AWG_LOAD["v"] = _awg_load_result(r.get("data") or {}, n, pid)
    else:
        code = r.get("code") or "internal"
        rec = {}
        with contextlib.suppress(Exception):
            with open(AWG_LOAD_RESULT) as f:
                rec = json.load(f) or {}
        base = _awg_load_result(rec, n, pid) if rec.get("id") == pid else _awg_load_result({}, n, pid)
        _AWG_LOAD["v"] = dict(base, ok=False, code=code, error=str(r.get("error") or "")[:300])
    _AWG_GEN["v"] = None
    with contextlib.suppress(OSError):
        _awg_load_stamp(dict(_AWG_LOAD["v"], at=int(time.time())))
    log(LOG_INFO, "awg module load #%d: %s %s", n, _AWG_LOAD["v"]["code"], json.dumps(_AWG_LOAD["v"]["ifaces"]))
    return _AWG_LOAD["v"]["code"] not in AWG_LOAD_PRECHECK


def awg_need(awg):
