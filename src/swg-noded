            res["errors"].append("lan block: " + detail)
            return _LAN["status"]
        _LAN["installed"] = True
        _LAN["sig"] = sig
        res["changed"] += 1
    _LAN["status"] = {"on": True, "ok": True, "nets": nets}
    return _LAN["status"]




def _gtable_declare(table, priority, guard, counters, gen):
    L = ["table inet %s" % table, "delete table inet %s" % table, "table inet %s {" % table,
         "  set guard { typeof ip daddr; flags interval; elements = { %s } }" % ", ".join(guard),
         "  counter gc { }"]
    L += ["  counter %s { }" % c for c in counters]
    L += gen["lines"]
    L.append("  chain sel { ip daddr vmap @%s; }" % gen["map"])
    L.append('  chain pre { type filter hook prerouting priority %s; policy accept; ct direction reply accept; '
             'ip daddr != @guard accept; jump sel; ip daddr @guard counter name "gc" drop; }' % priority)
    L.append("}")
    return "\n".join(L) + "\n"


def _gtable_swap(table, old_guard, guard, counters, gen, old):
    L = ["table inet %s {" % table] + ["  counter %s { }" % c for c in counters] + gen["lines"] + ["}"]
    gone, fresh = [x for x in old_guard if x not in guard], [x for x in guard if x not in old_guard]
    if gone:
        L.append("delete element inet %s guard { %s }" % (table, ", ".join(gone)))
    if fresh:
        L.append("add element inet %s guard { %s }" % (table, ", ".join(fresh)))
    L += ["flush chain inet %s sel" % table, "add rule inet %s sel ip daddr vmap @%s" % (table, gen["map"]),
          "delete map inet %s %s" % (table, old["map"])]
    L += ["delete chain inet %s %s" % (table, c) for c in old["chains"]]
    L += ["delete set inet %s %s" % (table, x) for x in old["sets"]]
    return "\n".join(L) + "\n"


def _gtable_drop_counter(table, name):
    return "delete counter inet %s %s\n" % (table, name)


def _gtable_intact(table):
    pre = run(["nft", "list", "chain", "inet", table, "pre"])
    return pre.returncode == 0 and "jump sel" in (pre.stdout or "") and "@guard" in (pre.stdout or "")


def _gen_names(gen):
