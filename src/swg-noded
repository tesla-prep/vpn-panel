_NODE_ADDR_SKIP = ("wg", "awg", "swg_", "dawg", "docker", "br-", "veth", "kube", "cni", "flannel", "s5x")


def _node_addrs():
    out = []
    try:
        raw = _pass_cached("ip-4-addr", lambda: run(["ip", "-4", "-o", "addr", "show"])).stdout
    except Exception:
        return out
    for ln in raw.splitlines():
        p = ln.split()
        if len(p) < 4 or p[2] != "inet":
            continue
        dev, ip = p[1], p[3].split("/")[0]
        if dev == "lo" or dev.startswith(_NODE_ADDR_SKIP):
            continue
        if ip.startswith("127."):
            continue
        out.append((dev, ip))
    return out


def list_node_ips(addrs=None):
