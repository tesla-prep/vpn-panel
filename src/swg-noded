def _s5x_socks(d):
    sk = (d or {}).get("socks") if isinstance((d or {}).get("socks"), dict) else {}
    host, user, pw = (str(sk.get(k) or "") for k in ("host", "user", "pass"))
    try:
        port = int(sk.get("port") or 0)
    except (TypeError, ValueError):
        port = 0
    if not host or len(host) > 253 or any(c.isspace() or ord(c) < 32 for c in host) or not 0 < port <= 65535 \
            or len(user) > 255 or len(pw) > 255 or any(ord(c) < 32 for c in user + pw):
        return None
    return {"host": host, "port": port, "user": user, "pass": pw}


def _s5x_unit(xid):
    return "swg-s5x-" + xid


def _s5x_sysd():
    if _S5X_RUN["sysd"] is None:
        m = re.match(r"systemd (\d+)", getattr(run(["systemctl", "--version"], timeout=10), "stdout", "") or "")
        _S5X_RUN["sysd"] = int(m.group(1)) if m else 0
    return _S5X_RUN["sysd"]


def _s5x_argv(xid, sig, binp, yml):
    back = (["-p", "RestartSec=3", "-p", "RestartSteps=8", "-p", "RestartMaxDelaySec=300"] if _s5x_sysd() >= 254
            else ["-p", "RestartSec=30"])
    return (["systemd-run", "--quiet", "--unit=" + _s5x_unit(xid), "--slice=" + S5X_SLICE,
             "--description=swg exit %s %s" % (xid, sig), "-p", "Restart=on-failure"] + back
            + ["-p", "Nice=10", "-p", "NoNewPrivileges=yes", "-p", "AmbientCapabilities=CAP_NET_ADMIN",
               "-p", "CapabilityBoundingSet=CAP_NET_ADMIN", "-p", "DeviceAllow=/dev/net/tun rw",
               "-p", "ProtectSystem=strict", "-p", "ProtectHome=yes", "-p", "PrivateTmp=yes",
               "-p", "RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK",
               "-p", "SystemCallFilter=@system-service", "-p", "SystemCallErrorNumber=EPERM", binp, yml])


def _s5x_show(xid):
    r = run(["systemctl", "show", "-p", "LoadState,ActiveState,SubState,Description", _s5x_unit(xid)], timeout=15)
    return dict(l.split("=", 1) for l in (getattr(r, "stdout", "") or "").splitlines() if "=" in l)


def _s5x_ensure_unit(xid, sig, binp, yml, state, started):
    if state == "up" and started == sig and xid in _S5X_SEEN:
        return ""
    _S5X_SEEN.add(xid)
    u = _s5x_show(xid)
    live = u.get("LoadState") == "loaded" and u.get("ActiveState") in ("active", "activating", "reloading")
    if live and u.get("Description", "").split()[3:] == sig.split():
        if state == "up":
            return ""
        return ("" if u.get("SubState") != "auto-restart" else
                "the SOCKS5 tunnel keeps exiting — systemd restarts it with a back-off (journalctl -u %s)" % _s5x_unit(xid))
    if live:
        run(["systemctl", "stop", _s5x_unit(xid)], timeout=30)
    run(["systemctl", "reset-failed", _s5x_unit(xid)], timeout=15)
    r = run(_s5x_argv(xid, sig, binp, yml), timeout=30)
    if getattr(r, "returncode", 1) != 0:
        return ("could not start the SOCKS5 tunnel: " + (getattr(r, "stderr", "") or "systemd-run failed").strip())[:160]
    if not _S5X_RUN["quota"]:
        _S5X_RUN["quota"] = getattr(run(["systemctl", "set-property", "--runtime", S5X_SLICE,
                                         "CPUQuota=%d%%" % S5X_QUOTA_PCT], timeout=15), "returncode", 1) == 0
    return ""


def _s5x_pidfile(dev):
    return os.path.join(EXIT_DIR, dev + ".pid")


def _s5x_child(dev, yml):
    with contextlib.suppress(Exception):
        with open(_s5x_pidfile(dev)) as f:
            pid, _, sig = f.read().strip().partition(" ")
        with open("/proc/%d/cmdline" % int(pid), "rb") as f:
            if yml.encode() in f.read().split(b"\0"):
                return int(pid), sig
    return 0, ""


def _s5x_ensure_child(xid, dev, sig, binp, yml):
    p = _S5X_PROCS.setdefault(xid, {"proc": None, "deaths": 0, "next": 0.0, "at": 0.0})
    pid, have = _s5x_child(dev, yml)
    if pid and have == sig:
        if p["deaths"] and time.time() - p["at"] > 60:
            p["deaths"] = 0
        return ""
    if pid:
        _s5x_kill(pid)
    elif p["proc"] is not None or p["at"]:
        with contextlib.suppress(Exception):
            p["proc"] and p["proc"].poll()
        p["proc"], p["at"] = None, 0.0
        p["deaths"] += 1
        p["next"] = time.time() + min(300, 3 * 2 ** (p["deaths"] - 1))
    if time.time() < p["next"]:
        return "the SOCKS5 tunnel exited — starting it again in %ds (%s)" % (int(p["next"] - time.time()) + 1, dev + ".log")
    lp = os.path.join(EXIT_DIR, dev + ".log")
    _rotate_serverlog(lp, _log_docker_caps(_LOG_BUDGET["mb"]) // 2 or SERVERLOG_MAX)
    try:
        lf = open(lp, "ab", buffering=0)
        pr = subprocess.Popen(["nice", "-n", "10", binp, yml], stdout=lf, stderr=lf, stdin=subprocess.DEVNULL, close_fds=True)
    except Exception as e:
        return ("could not start the SOCKS5 tunnel: " + str(e))[:160]
    p.update(proc=pr, at=time.time())
    with contextlib.suppress(Exception):
        _replace_if_changed(_s5x_pidfile(dev), "%d %s" % (pr.pid, sig), 0o600)
    return ""


def _s5x_kill(pid):
    with contextlib.suppress(Exception):
        os.kill(pid, signal.SIGTERM)
    for _ in range(20):
        if not _pid_alive(pid):
            return
        time.sleep(0.1)
    with contextlib.suppress(Exception):
        os.kill(pid, signal.SIGKILL)


def _s5x_down(xid, dev):
    if NODE_KIND == "docker":
        pid, _ = _s5x_child(dev, os.path.join(EXIT_DIR, dev + ".yml"))
        if pid:
            _s5x_kill(pid)
        p = _S5X_PROCS.pop(xid, None)
        with contextlib.suppress(Exception):
            p and p["proc"] and p["proc"].wait(timeout=2)
    else:
        run(["systemctl", "stop", _s5x_unit(xid)], timeout=30)
        run(["systemctl", "reset-failed", _s5x_unit(xid)], timeout=15)
    _S5X_SEEN.discard(xid)
    if _dev_link_state(dev) != "absent":
        run(["ip", "link", "del", dev])
    for p2 in (os.path.join(EXIT_DIR, dev + ".yml"), _s5x_pidfile(dev)):
        with contextlib.suppress(OSError):
            os.unlink(p2)
    for m in (_EXIT_HEALTH, _EXIT_PROBED_AT, _S5X, _S5X_CHECKS):
        m.pop(dev, None)


def _s5x_sweep(want):
    if _S5X_RUN["swept"]:
        return
    _S5X_RUN["swept"] = True
    if NODE_KIND == "docker":
        with contextlib.suppress(OSError):
            for fn in os.listdir(EXIT_DIR):
                if fn.startswith("s5x-") and fn.endswith(".pid") and fn[4:-4] not in want:
                    _s5x_down(fn[4:-4], fn[:-4])
        return
    r = run(["systemctl", "list-units", "--all", "--plain", "--no-legend", "swg-s5x-*"], timeout=15)
    for ln in (getattr(r, "stdout", "") or "").splitlines():
        u = (ln.split() or [""])[0]
        xid = u[len("swg-s5x-"):-len(".service")] if u.startswith("swg-s5x-") and u.endswith(".service") else ""
        if re.fullmatch(r"[0-9a-f]{8}", xid) and xid not in want:
            _s5x_down(xid, "s5x-" + xid)


S5X_WHY = {
    "unreachable": "the proxy cannot be reached from this node",
    "refused": "the proxy refused the connection — is the port right?",
    "timeout": "the proxy did not answer in time",
    "not_socks5": "that address does not speak SOCKS5",
    "auth_required": "the proxy wants a login, and none is set",
    "auth_failed": "the proxy refused the login — check the user and password",
    "not_allowed": "the proxy refused this node's address — some providers make you allow-list the server's IP",
    "connect_failed": "the proxy could not reach the internet for us",
}


def _s5x_recv(s, n):
    b = b""
    while len(b) < n:
        c = s.recv(n - len(b))
        if not c:
            raise ConnectionError("closed")
        b += c
    return b


def _s5x_open(host, port, user, pw, timeout):
    try:
        s = socket.create_connection((host, int(port)), timeout=timeout)
    except socket.timeout:
        return None, "timeout"
    except ConnectionRefusedError:
        return None, "refused"
    except OSError:
        return None, "unreachable"
    try:
        s.settimeout(timeout)
        s.sendall(b"\x05\x02\x00\x02" if user else b"\x05\x01\x00")
        ver, meth = _s5x_recv(s, 2)
        if ver != 5:
            raise ValueError("not_socks5")
        if meth == 0xFF:
            raise ValueError("auth_failed" if user else "auth_required")
        if meth == 2:
            if not user:
                raise ValueError("auth_required")
            u, p = user.encode(), pw.encode()
            s.sendall(b"\x01" + bytes([len(u)]) + u + bytes([len(p)]) + p)
            if _s5x_recv(s, 2)[1] != 0:
                raise ValueError("auth_failed")
        elif meth != 0:
            raise ValueError("not_socks5")
        return s, ""
    except Exception as e:
        with contextlib.suppress(Exception):
            s.close()
        return None, (str(e) if str(e) in S5X_WHY else "timeout" if isinstance(e, socket.timeout) else "not_socks5")


def _s5x_cmd(s, cmd, atyp_addr, port):
    s.sendall(b"\x05" + bytes([cmd, 0]) + atyp_addr + int(port).to_bytes(2, "big"))
    ver, rep, _r, atyp = _s5x_recv(s, 4)
    if ver != 5:
        raise ValueError("not_socks5")
    if atyp == 1:
        a = socket.inet_ntoa(_s5x_recv(s, 4))
    elif atyp == 3:
        a = _s5x_recv(s, _s5x_recv(s, 1)[0]).decode("ascii", "replace")
    elif atyp == 4:
        a = socket.inet_ntop(socket.AF_INET6, _s5x_recv(s, 16))
    else:
        raise ValueError("not_socks5")
    return rep, (a, int.from_bytes(_s5x_recv(s, 2), "big"))


def _socks_check(host, port, user="", pw="", timeout=10.0, udp_wait=3.0, _trace=("www.cloudflare.com", 443),
                 _dns=("1.1.1.1", 53)):
    out = {"login": False, "egress_ip": "", "loc": "", "udp": None, "rtt_ms": None, "why": ""}
    t0 = time.monotonic()
    s, why = _s5x_open(host, port, user, pw, timeout)
    if not s:
        out["why"] = why
        return out
    out["login"] = True
    try:
        out["udp"] = _s5x_udp(host, port, user, pw, timeout, udp_wait, _dns)
    except Exception:
        out["udp"] = False
    try:
        name = _trace[0].encode()
        rep, _b = _s5x_cmd(s, 1, b"\x03" + bytes([len(name)]) + name, _trace[1])
        if rep != 0:
            out["why"] = "not_allowed" if rep == 2 else "connect_failed"
            return out
        t = _exit_tls().wrap_socket(s, server_hostname=_trace[0])
        s = t
        t.sendall(b"GET /cdn-cgi/trace HTTP/1.1\r\nHost: %s\r\nUser-Agent: swg-noded\r\nConnection: close\r\n\r\n" % name)
        body = b""
        while len(body) < 65536:
            c = t.recv(4096)
            if not c:
                break
            body += c
        kv = dict(l.split("=", 1) for l in body.decode("utf-8", "replace").splitlines() if "=" in l)
        out.update(egress_ip=kv.get("ip", "")[:45], loc=kv.get("loc", "")[:8],
                   rtt_ms=int((time.monotonic() - t0) * 1000))
        if not out["egress_ip"]:
            out["why"] = "connect_failed"
    except Exception as e:
        out["why"] = str(e) if str(e) in S5X_WHY else "connect_failed"
        return out
    finally:
        with contextlib.suppress(Exception):
            s.close()
    return out


def _s5x_udp(host, port, user, pw, timeout, wait, dns):
    c, why = _s5x_open(host, port, user, pw, timeout)
    if not c:
        return False
    u = None
    try:
        rep, (ba, bp) = _s5x_cmd(c, 3, b"\x01\x00\x00\x00\x00", 0)
        if rep != 0 or not bp:
            return False
        if ba in ("0.0.0.0", "::"):
            ba = c.getpeername()[0]
        u = socket.socket(socket.AF_INET6 if ":" in ba else socket.AF_INET, socket.SOCK_DGRAM)
        u.settimeout(wait)
        qid = secrets.randbelow(0xFFFF)
        q = qid.to_bytes(2, "big") + b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00" + \
            b"".join(bytes([len(p)]) + p.encode() for p in "www.cloudflare.com".split(".")) + b"\x00\x00\x01\x00\x01"
        pkt = b"\x00\x00\x00\x01" + socket.inet_aton(dns[0]) + int(dns[1]).to_bytes(2, "big") + q
        end = time.monotonic() + wait
        for k in range(3):
            u.sendto(pkt, (ba, bp))
            step = min(end, time.monotonic() + wait / 3) if k < 2 else end
            while time.monotonic() < step:
                u.settimeout(max(0.05, step - time.monotonic()))
                try:
                    d, _f = u.recvfrom(4096)
                except socket.timeout:
                    break
                if len(d) > 12 and d[3] == 1 and d[10:12] == qid.to_bytes(2, "big"):
                    return True
        return False
    except Exception:
        return False
    finally:
        for x in (u, c):
            with contextlib.suppress(Exception):
                x and x.close()


def _s5x_dispatch(dev, sk, sig):
    if dev in _S5X_INFLIGHT or not sk:
        return
    _S5X_INFLIGHT.add(dev)
    def go():
        try:
            r = _socks_check(sk["host"], sk["port"], sk["user"], sk["pass"])
        except Exception:
            r = {"login": False, "egress_ip": "", "loc": "", "udp": None, "rtt_ms": None, "why": "timeout"}
        _S5X_CHECKS[dev] = (time.time(), sig, r)
        _S5X_INFLIGHT.discard(dev)
    threading.Thread(target=go, daemon=True).start()


def _s5x_take(dev, res, now=None, sig=None):
    got = _S5X_CHECKS.pop(dev, None)
    s = _S5X.setdefault(dev, {"udp_ok": None, "pending": None, "next": 0.0, "check": None})
    if not got or (sig is not None and got[1] != sig):
        return s
    now = time.time() if now is None else now
    at, _sig, r = got
    s["check"] = dict(r, at=int(at))
    u = r.get("udp")
    if u is not None:
        if s["udp_ok"] is None:
            s["udp_ok"], s["pending"] = u, (False if u is False else None)
        elif u == s["udp_ok"]:
            s["pending"] = None
        elif s["pending"] == u or (u is False and s.get("suspect")):
            s["udp_ok"], s["pending"] = u, None
            log(LOG_INFO, "exit device %s: the proxy %s UDP now", dev, "carries" if u else "no longer carries")
        else:
            s["pending"] = u
    s["suspect"] = False
    s["next"] = now + (S5X_RECHECK_S if s["pending"] is not None else S5X_CHECK_EVERY_S)
    if r.get("why"):
        res["errors"].append("exit device %s: %s" % (dev, S5X_WHY.get(r["why"], r["why"])))
    return s


