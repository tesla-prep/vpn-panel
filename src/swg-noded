def _share_by_peer(node_cfg, desired, only=None):
    by_peer = {}
    for _iface, m in _net_members(node_cfg, desired).items():
        for pre, pks in m.items():
            for pk in pks:
                if only is None or pk in only:
                    by_peer.setdefault(pk, set()).add(pre)
    return by_peer


def _share_plan(node_cfg, desired, share):
    import ipaddress
    by_peer = _share_by_peer(node_cfg, desired)
    plan, seen = [], set()
    for ent in (share if isinstance(share, list) else []):
        pk = ent.get("peer") if isinstance(ent, dict) else None
        if not isinstance(pk, str) or pk in seen or not by_peer.get(pk):
            continue
        seen.add(pk)
        els = {}
        for e in (ent.get("from") if isinstance(ent.get("from"), list) else []):
            if not (isinstance(e, list) and len(e) == 3):
                continue
            ifn, pre, until = e
            pre = _net_prefix(pre) if isinstance(pre, str) else ""
            if not (isinstance(ifn, str) and _SHARE_IFNAME_RE.match(ifn) and pre
                    and isinstance(until, int) and not isinstance(until, bool) and until >= 0):
                continue
            k = (ifn, pre)
            els[k] = 0 if (until == 0 or els.get(k) == 0) else max(until, els.get(k) or 0)
        plan.append((pk, sorted(by_peer[pk], key=ipaddress.ip_network),
                     [(i, x, els[(i, x)]) for i, x in sorted(els, key=lambda k: (k[0], ipaddress.ip_network(k[1])))]))
    return sorted(plan)


def _share_live(els, now):
    return [(i, x, (u - now) if (u and u - now <= SHARE_TIMEOUT_CAP) else 0) for i, x, u in els if not u or u > now]


def _share_sig(plan, now):
    return json.dumps([[pk, nets, [[i, x, (u if (u and u - now <= SHARE_TIMEOUT_CAP) else ("far" if u else 0))]
                                   for i, x, u in els if not u or u > now]] for pk, nets, els in plan])


def _share_nets(plan):
