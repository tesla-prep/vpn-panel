def _shared_record(name, legacy, env):
    p = os.environ.get(env)
    if p:
        return p
    new = os.path.join(STATE_DIR, name)
    with contextlib.suppress(Exception):
        _n = os.path.exists(new)
        _l = os.path.exists(legacy)
        if _l and (not _n or os.path.getmtime(legacy) > os.path.getmtime(new)):
            os.makedirs(STATE_DIR, exist_ok=True)
            shutil.copy2(legacy, new)
            log(LOG_INFO, "record: %s -> %s (the newer copy; records are shared across run-models now)", legacy, new)
    return new


def _replace_if_changed(path, text, mode=None):
    with contextlib.suppress(Exception):
        with open(path) as f:
            if f.read() == text:
                if mode is not None and (os.fstat(f.fileno()).st_mode & 0o777) != mode:
                    os.chmod(path, mode)
                return
    with open(path + ".tmp", "w") as f:
        if mode is not None:
            os.fchmod(f.fileno(), mode)
        f.write(text)
    os.replace(path + ".tmp", path)


