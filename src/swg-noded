        with contextlib.suppress(OSError):
            os.remove(p)
        return
    mok = (_awg_record(AWG_REFUSED) or {}).get("mok") or ""
    mok = mok if _MOK_PATH_RE.match(mok) else _awg_mok_match()
    with contextlib.suppress(OSError):
        with open(p + ".tmp", "w") as f:
            f.write("kernel=%s\nboot=%s\nmok=%s\n" % (os.uname().release, boot, mok))
        os.replace(p + ".tmp", p)


