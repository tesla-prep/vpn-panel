def _relay_mss(gw, mark=0):
    dev = ""
    out = run(["ip", "route", "get", "1.1.1.1", "from", gw] + (["mark", str(mark)] if mark else [])).stdout or ""
    m = re.search(r"\bdev (\S+)", out)
    if m:
        dev = m.group(1)
    if not dev:
        return 0
    try:
        with open("/sys/class/net/%s/mtu" % dev) as f:
            mtu = int(f.read().strip())
    except (OSError, ValueError):
        return 0
    return max(536, mtu - RELAY_MSS_HEADROOM)


def _relay_status(iface, timeout=2.0):
    s = None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(_relay_sock(iface))
        buf = b""
        while b"\n" not in buf and len(buf) < 8192:
            b = s.recv(4096)
            if not b:
                break
            buf += b
        return json.loads(buf.decode() or "{}") or None
    except (OSError, ValueError):
        return None
    finally:
        if s is not None:
            with contextlib.suppress(OSError):
                s.close()


def _relay_cpu(iface, pid, now):
    st = _RELAY.setdefault(iface, {})
    try:
        with open("/proc/%d/stat" % pid) as f:
            parts = f.read().rsplit(") ", 1)[1].split()
        ticks = (int(parts[11]) + int(parts[12])) / float(os.sysconf("SC_CLK_TCK"))
    except (OSError, IndexError, ValueError):
        return None
    prev_t, prev_w = st.get("cputime"), st.get("cpuat")
    st["cputime"], st["cpuat"] = ticks, now
    if prev_t is None or not prev_w or now <= prev_w:
        return None
    return max(0.0, (ticks - prev_t) / (now - prev_w) * 100.0)


def _relay_diverted():
    r = run(["nft", "-j", "list", "table", "inet", RELAY_TABLE])
    if r.returncode != 0:
        return None
    try:
        obj = json.loads(r.stdout or "{}")
    except ValueError:
        return None
    out = {}
    for item in (obj.get("nftables") or []):
        rule = (item or {}).get("rule") or {}
        if rule.get("chain") != "pre":
            continue
        tag = str(rule.get("comment") or "")
        if not tag.startswith(RELAY_SYN_TAG):
            continue
        n = 0
        for e in (rule.get("expr") or []):
            if isinstance(e, dict) and "counter" in e:
                n += int((e["counter"] or {}).get("packets") or 0)
        iid = tag[len(RELAY_SYN_TAG):]
        out[iid] = out.get(iid, 0) + n
    return out


def _relay_probe(iface, now, diverted=None):
    st = _RELAY.setdefault(iface, {})
    s = _relay_status(iface)
    if not s:
        st.pop("loops", None)
        return False, "relay not answering", {}
    loops, prev = s.get("loops"), st.get("loops")
    st["loops"] = loops
    if not isinstance(loops, int):
        return False, "relay status has no loop counter", s
    if prev is not None and loops <= prev:
        return False, "relay loop not turning (loops stuck at %d)" % loops, s
    cpu = _relay_cpu(iface, s.get("pid") or 0, now)
    st["cpu"] = cpu
    if cpu is not None and cpu > RELAY_CPU_MAX:
        st["hot"] = st.get("hot", 0) + 1
        if st["hot"] >= 2:
            return False, "relay over CPU budget (%.0f%% of one core, quota not enforcing)" % cpu, s
    else:
        st["hot"] = 0
    rs, rs_prev = s.get("refused_self") or 0, st.get("refused_self")
    st["refused_self"] = rs
    if rs_prev is not None and rs - rs_prev >= RELAY_SELFDIAL_MAX:
        return False, "relay is being dialled on its own port (%d refused since the last pass)" % (rs - rs_prev), s
    _all = _relay_diverted() if diverted is None else diverted
    dv = None if _all is None else int(_all.get(iface, 0))
    dv_prev = st.get("diverted")
    if dv is not None:
        st["diverted"] = dv
    ac, ac_prev = s.get("accepted") or 0, st.get("accepted")
    st["accepted"] = ac
    _up, _up_prev = s.get("uptime_s"), st.get("uptime_s")
    if _up is not None and _up_prev is not None and _up < _up_prev:
        st.pop("black_until", None); st["black_wait"] = RELAY_BLACK_BASE
    elif s.get("pid") and st.get("pid") and s["pid"] != st["pid"]:
        st.pop("black_until", None); st["black_wait"] = RELAY_BLACK_BASE
    st["pid"], st["uptime_s"] = s.get("pid"), _up
    if now < st.get("black_until", 0):
        return False, ("relay took traffic and accepted none; holding the forwarding path for %ds"
                       % int(st["black_until"] - now)), s
    if dv is None or dv_prev is None or ac_prev is None:
        pass
    elif dv - dv_prev >= RELAY_DIVERT_MIN and ac <= ac_prev:
        st["mute"] = st.get("mute", 0) + 1
        if st["mute"] >= 2:
            st["mute"] = 0
            st["black_wait"] = min(RELAY_BLACK_MAX, int(st.get("black_wait") or RELAY_BLACK_BASE) * 2)
            st["black_until"] = now + st["black_wait"] / 2
            return False, ("relay took %d diverted packets and accepted none — the divert is a blackhole"
                           % (dv - dv_prev)), s
    else:
        st["mute"] = 0
        if ac > (ac_prev or 0):
            st["black_wait"] = RELAY_BLACK_BASE
    if prev is None:
        return False, "relay just seen, waiting for a second sample", s
    return True, "", s


RELAY_RULE_TAG = "swg-relay:"
RELAY_SYN_TAG = "swg-relay-syn:"
_RELAY_LINKS = {"key": None, "links": ()}


def _relay_links(node_cfg):
    ifs = (node_cfg or {}).get("interfaces") or {}
    key = tuple(sorted((str(n), str((c or {}).get("conf", "")) if isinstance(c, dict) else "") for n, c in ifs.items()))
    if key != _RELAY_LINKS["key"]:
        _RELAY_LINKS["links"] = tuple(sorted(n for n in ifs if _iface_is_mesh(node_cfg, n, _iface_subnet(node_cfg, n))))
        _RELAY_LINKS["key"] = key
    return _RELAY_LINKS["links"]


def _relay_rule_tag(iid):
    return RELAY_RULE_TAG + iid


def _relay_syn_tag(iid):
    return RELAY_SYN_TAG + iid


def _relay_nft(entries, guard_ports=(), links=()):
    L = ["table inet %s" % RELAY_TABLE, "delete table inet %s" % RELAY_TABLE,
         "table inet %s {" % RELAY_TABLE,
         "  chain pre {",
         "    type filter hook prerouting priority %d; policy accept;" % RELAY_HOOK_PRI]
    forward_only = _collapse4(s for e in entries for s in (e.get("forward_only") or ()))
    if forward_only:
        L.append("    ip saddr { %s } return" % ", ".join(forward_only))
    assert SNI_RESET_MARK & 0xfffe == SNI_BLOCK_MARK & 0xfffe
    for S in sorted({e["subnet"] for e in entries}):
        L.append("    ip saddr %s ct state != new meta mark & 0x0000fffe != %#010x meta l4proto tcp socket transparent 1 counter meta mark set 0x%x accept"
                 % (S, SNI_BLOCK_MARK, RELAY_MARK))
    for e in entries:
        S, port = e["subnet"], e["port"]
        _m = ("meta mark 0x%x " % e["mark"]) if e.get("mark") else ""
        if not e.get("mark"):
            _m = "meta mark & %#x == 0 " % P2P_BIT
        _att = 'tcp flags syn / fin,syn,rst,ack fib daddr %soifname { %s } ' % (
            ". mark " if e.get("mark") else "", ", ".join('"%s"' % d for d in links))
        L.append('    ip saddr %s %smeta l4proto tcp %scounter comment "%s"'
                 % (S, _m, _att, _relay_syn_tag(e["iid"])))
        L.append('    ip saddr %s %smeta l4proto tcp %stproxy ip to :%d counter meta mark set 0x%x accept comment "%s"'
                 % (S, _m, _att, port, RELAY_MARK, _relay_rule_tag(e["iid"])))
    ports = sorted({e["port"] for e in entries} | set(guard_ports))
    if entries:
        L += ["  }"]
    else:
        L = [l for l in L if not l.startswith("  chain pre") and "hook prerouting" not in l]
    if ports:
        L += ["  chain inp {",
              "    type filter hook input priority %d; policy accept;" % RELAY_HOOK_PRI]
        for S in sorted({e["subnet"] for e in entries}):
            L.append("    ip saddr %s fib daddr type != local meta mark & 0x0000ffff == %#010x meta l4proto tcp counter reject with tcp reset"
                     % (S, SNI_BLOCK_MARK))
            L.append("    ip saddr %s fib daddr type != local meta mark %#010x meta l4proto tcp counter reject with tcp reset"
                     % (S, SNI_RESET_MARK))
        for port in ports:
            L.append("    fib daddr type local meta l4proto tcp th dport %d counter drop" % port)
        L += ["  }"]
    L += ["}"]
    return "\n".join(L) + "\n"


def _relay_note(state, why=""):
    prev = _RELAY_ARM.get("noted")
    now = (state, why)
    if prev == now:
        return
    _RELAY_ARM["noted"] = now
    log(LOG_INFO, "relay divert %s%s", state, (" — " + why) if why else "")


def _relay_unroutable(entries, rules):
    src = []
    for l in rules:
        m = re.match(r"^(\d+):\s+from ([0-9./]+) lookup (\d+)\b", l.strip())
        if m and m.group(2) != "all":
            src.append((int(m.group(1)), m.group(2), int(m.group(3))))
    out = {}
    for e in entries:
        T = int(e.get("mark") or 0)
        if not T:
            continue
        try:
            net = ipaddress.ip_network(e["subnet"], strict=False)
        except ValueError:
            continue
        if SWG_RT_UP_BASE <= T <= SWG_RT_UP_MAX:
            if any(re.match(r"^\s*%d:\s+.*fwmark (0x%x|%d)\b.*lookup \d+" % (T, T, T), l) for l in rules):
                continue
            _want_tbl = T - SWG_RT_UP_BASE + SWG_RT_BASE
            _falls_to = None
            for pri, s_net, tbl in src:
                try:
                    other = ipaddress.ip_network(s_net, strict=False)
                except ValueError:
                    continue
                if other.subnet_of(net) or net.subnet_of(other):
                    _falls_to = tbl
                    break
            if _falls_to == _want_tbl:
                continue
            out[e["iid"]] = ("this leg's routing rule (fwmark %d) is not installed, so the relay's own "
                             "connection would leave by %s instead of table %d"
                             % (T, ("table %d" % _falls_to) if _falls_to else "this node's own address",
                                _want_tbl))
            continue
        for pri, s_net, tbl in src:
            if pri >= T:
                continue
            try:
                other = ipaddress.ip_network(s_net, strict=False)
            except ValueError:
                continue
            if other.subnet_of(net) or net.subnet_of(other):
                out[e["iid"]] = ("routing for %s is claimed by rule %d (from %s lookup %d), which is "
                                 "consulted before this leg's table %d" % (e["subnet"], pri, s_net, tbl, T))
                break
    return out


def _relay_arm(entries, res, rules=None, guard_ports=(), links=()):
    run(["ip", "route", "replace", "local", "default", "dev", "lo", "table", str(RELAY_RT)])
    _rules = rules if rules is not None else (run(["ip", "rule", "show"]).stdout or "").splitlines()
    have = any(("fwmark 0x%x" % RELAY_MARK) in l and ("lookup %d" % RELAY_RT) in l
               for l in _rules)
    if not have:
        run(["ip", "rule", "add", "fwmark", str(RELAY_MARK), "lookup", str(RELAY_RT),
             "priority", str(RELAY_RT)])
    r = run(["nft", "-f", "-"], input_text=_relay_nft(entries, guard_ports, links))
    if r.returncode != 0:
        _relay_disarm(res)
        res["errors"].append("relay divert: " + (r.stderr or "nft failed").strip())
        return False
    res["changed"] += 1
    return True


def _relay_disarm(res=None):
    run(["nft", "delete", "table", "inet", RELAY_TABLE])
    for _ in range(4):
        if run(["ip", "rule", "del", "fwmark", str(RELAY_MARK), "lookup", str(RELAY_RT)]).returncode != 0:
            break
    run(["ip", "route", "flush", "table", str(RELAY_RT)])
    if res is not None and _RELAY_ARM["sig"] is not None:
        res["changed"] += 1


def _relay_any_table():
    return run(["nft", "list", "table", "inet", RELAY_TABLE]).returncode == 0


def _relay_table_live():
    r = run(["nft", "list", "table", "inet", RELAY_TABLE])
    return r.returncode == 0 and "tproxy" in (r.stdout or "")


RELAY_ENV_DIR = "/etc/swg-panel/relay"

RELAY_SLICE = "swg-relay.slice"
RELAY_SLICE_TMPL = """[Unit]
Description=swg-relay CPU budget for this node
Before=slices.target

[Slice]
CPUAccounting=yes
CPUQuota=RELAY_QUOTAPCT%
"""

