def _dev_link_state(dev):
    d = str(dev or "")
    if not d or len(d) > 15 or "/" in d or d in (".", ".."):
        return "absent"
    if not os.path.isdir("/sys/class/net/" + d):
        return "absent"
    with contextlib.suppress(Exception):
        with open("/sys/class/net/%s/flags" % d) as f:
            return "up" if (int(f.read().strip(), 16) & 1) else "down"
    return "down"


def _dev_ifindex(dev):
    with contextlib.suppress(Exception):
        with open("/sys/class/net/%s/ifindex" % dev) as f:
            return int(f.read().strip())
    return 0


def _dev_seen(dev, state=None):
    s = _devexit_state(dev) if state is None else state
    return (s, _dev_ifindex(dev) if s != "absent" else 0)


_ROUTED = {"judged": {}, "pending": {}}


def _routed_devs_moved():
    return any(_dev_seen(d) != v for d, v in _ROUTED["judged"].items())


def _devexit_sig(cascade):
    return sorted((str((e or {}).get("dev") or ""), _devexit_state(str((e or {}).get("dev") or "")),
                   _dev_gateway(str((e or {}).get("dev") or "")))
                  for e in ((cascade or {}).get("devexit") or [])) + sorted((_EXITS.get("socks") or {}).items())


def _dev_is_ether(dev):
    with contextlib.suppress(Exception):
        with open("/sys/class/net/%s/type" % str(dev or "")) as f:
            return f.read().strip() == "1"
    return False


def _dev_gateway(dev, _proc="/proc/net/route"):
    d = str(dev or "")
    if not d:
        return ""
    best = None
    with contextlib.suppress(Exception):
        with open(_proc) as f:
            for line in f.read().splitlines()[1:]:
                t = line.split()
                if len(t) < 8 or t[0] != d or t[1] != "00000000" or t[2] == "00000000":
                    continue
                with contextlib.suppress(Exception):
                    m = int(t[6])
                    if best is None or m < best[0]:
                        v = int(t[2], 16)
                        best = (m, "%d.%d.%d.%d" % (v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >> 24) & 0xFF))
    return best[1] if best else ""


def _table_default_via(table, dev):
    with contextlib.suppress(Exception):
        for line in run(["ip", "route", "show", "default", "table", str(table)]).stdout.splitlines():
            t = line.split()
            if "dev" in t and t[t.index("dev") + 1] == str(dev) and "via" in t:
                return t[t.index("via") + 1]
    return ""


def _devexit_gw(e, detected=None):
    dev = str((e or {}).get("dev") or "")
    if not dev or not _dev_is_ether(dev):
        return ""
    gw = _dev_gateway(dev) if detected is None else detected
    return gw or str((e or {}).get("gw") or "").strip() or _table_default_via((e or {}).get("table") or "", dev)



_PANEL_PEER = {"addr": ""}

RESOLV_CONF = "/etc/resolv.conf"
RESOLVED_UPSTREAM = "/run/systemd/resolve/resolv.conf"
_RESERVED_V4 = ("0.0.0.0/8", "127.0.0.0/8", "169.254.0.0/16", "224.0.0.0/4", "240.0.0.0/4")
_TUNNEL_DEV_PREFIXES = ("wg", "awg", "dawg", "wdtt", "csqtt")
_RT_TYPES = ("local", "broadcast", "unicast", "multicast", "blackhole", "unreachable", "prohibit", "throw")


def _resolvers(_path=None, _upstream=None):
    import ipaddress
    def _ns(text):
        return [t[1] for t in (ln.split() for ln in text.splitlines()) if len(t) >= 2 and t[0] == "nameserver"]
    def _v4(s):
        with contextlib.suppress(ValueError):
            a = ipaddress.ip_address(s.split("%")[0])
            if a.version == 4:
                return a
        return None
    try:
        with open(_path or RESOLV_CONF) as f:
            text = f.read()
    except OSError:
        return [], False
    servers = _ns(text)
    if not servers:
        return [], False
    out, known = set(), True
    for s in servers:
        a = _v4(s)
        if a is None:
            continue
        if not a.is_loopback:
            out.add(str(a))
            continue
        if str(a) == "127.0.0.53":
            try:
                with open(_upstream or RESOLVED_UPSTREAM) as f:
                    ups = _ns(f.read())
            except OSError:
                known = False
                continue
        elif str(a) == "127.0.0.11":
            m = re.search(r"(?m)^#\s*ExtServers:\s*\[([^\]]*)\]", text)
            if not m:
                known = False
                continue
            ups = [u for u in m.group(1).split() if not u.startswith("host(")]
        else:
            known = False
            continue
        for u in ups:
            b = _v4(u)
            if b is not None and b.is_loopback:
                known = False
            elif b is not None:
                out.add(str(b))
    return sorted(out), known


def _default_gateways(_proc="/proc/net/route"):
    out = []
    try:
        with open(_proc) as f:
            lines = f.read().splitlines()[1:]
    except OSError:
        return None
    for line in lines:
        t = line.split()
        if len(t) < 8 or t[1] != "00000000" or t[7] != "00000000" or t[2] == "00000000":
            continue
        with contextlib.suppress(ValueError):
            v = int(t[2], 16)
            gw = "%d.%d.%d.%d" % (v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >> 24) & 0xFF)
            if gw not in out:
                out.append(gw)
    return out


def _local_addrs():
    import ipaddress
    r = run(["ip", "-4", "-o", "addr", "show"])
    if r.returncode != 0:
        return None
    out = []
    for ln in (r.stdout or "").splitlines():
        p = ln.split()
        if len(p) < 4 or p[2] != "inet" or p[1] == "lo":
            continue
        with contextlib.suppress(ValueError):
            itf = ipaddress.ip_interface(p[3])
            out.append((p[1], str(itf.ip), str(itf.network)))
    return out


_LOCAL_V4 = {"at": -1e9, "set": None}

def _local_v4():
    now = time.monotonic()
    if now - _LOCAL_V4["at"] > 30:
        la = _local_addrs()
        _LOCAL_V4["set"] = None if la is None else {ip for _d, ip, _n in la}
        _LOCAL_V4["at"] = now
    return _LOCAL_V4["set"]


_BIND_WILD = ("0.0.0.0", "::", "[::]", "*")

def _bind_split(listen):
    s = str(listen or "").strip()
    i = s.rfind(":")
    if i <= 0:
        return "", "", False
    host, port = s[:i], s[i + 1:]
    return host, port, not (host in _BIND_WILD or host.startswith("["))


_RESOLVED = {}

def _host_on_box(host, mine, resolve=True):
    if _IPV4_RE.match(host):
        return host if host in mine else ""
    if not resolve:
        return ""
    now = time.monotonic()
    hit = _RESOLVED.get(host)
    if hit and now - hit[0] < 60:
        cands = hit[1]
    else:
        try:
            cands = sorted({a[4][0] for a in socket.getaddrinfo(host, None, socket.AF_INET)})
        except socket.gaierror as e:
            if e.errno not in (socket.EAI_NONAME, getattr(socket, "EAI_NODATA", -5)):
                return None
            cands = []
        except (OSError, UnicodeError):
            return None
        _RESOLVED[host] = (now, cands)
    here = [c for c in cands if c in mine]
    return here[0] if here else ""


def turn_bind(listen, resolve=True, pin="", prev=""):
    s = str(listen or "").strip()
    host, port, decidable = _bind_split(s)
    if not decidable:
        return s
    mine = _local_v4()
    if mine is None:
        return s
    pin = str(pin or "").strip()
    if pin and _IPV4_RE.match(pin) and pin in mine:
        return pin + ":" + port
    ip = _host_on_box(host, mine, resolve)
    if ip is None:
        ph, pp, _ = _bind_split(prev)
        return (ph + ":" + port) if pp == port and (ph in mine or ph == "0.0.0.0") else "0.0.0.0:" + port
    return (ip + ":" + port) if ip else "0.0.0.0:" + port


_BIND_HEALED = set()
_BIND_RETRY = {}

def _bind_ask_now(key):
    return time.monotonic() >= _BIND_RETRY.get(key, 0)

def _bind_ask_later(key):
    _BIND_RETRY[key] = time.monotonic() + 300

def _bind_works(cur, mine, names=True):
    host, _port, decidable = _bind_split(cur)
    if not decidable:
        return True
    if not names and not _IPV4_RE.match(host):
        return False
    ip = _host_on_box(host, mine)
    return None if ip is None else bool(ip)


def bind_heal_due(key, envpath, listen, names=True):
    if key in _BIND_HEALED or not _bind_ask_now(key):
        return False
    have = _env_listen(envpath)
    mine = _local_v4()
    if not have or mine is None:
        _BIND_HEALED.add(key)
        return False
    ok = _bind_works(have, mine, names)
    if ok is None:
        _bind_ask_later(key)
        return False
    _BIND_HEALED.add(key)
    return not ok


def rebind_env(envpath, inst, render):
    if not (inst.get("iface") and inst.get("listen") and inst.get("password") and os.path.exists(envpath)):
        return
    with contextlib.suppress(Exception):
        _now = _env_listen(envpath)
        if _now != turn_bind(inst["listen"], pin=inst.get("bind_ip"), prev=_now):
            text = render(inst)
            with open(envpath + ".tmp", "w") as f:
                f.write(text)
            os.replace(envpath + ".tmp", envpath)


_TURN_BIND_HEALED = set()
_TURN_HEAL_SEEN = {"mtime": None, "pending": True}

def heal_turn_binds():
    if TURN_DOCKER or not TURN_MANAGE_ON:
        return
    try:
        mt = os.stat(TURN_RECORD).st_mtime
    except OSError:
        return
    if _TURN_HEAL_SEEN.get("mtime") == mt and not _TURN_HEAL_SEEN.get("pending"):
        return
    try:
        with open(TURN_RECORD) as f:
            rec = (json.load(f) or {}).get("turn_proxies") or []
    except Exception:
        return
    mine = _local_v4()
    if mine is None:
        return
    pending = False
    for t in rec:
        svc = str((t or {}).get("service") or "")
        if not svc or svc in _TURN_BIND_HEALED:
            continue
        if not _bind_ask_now(svc):
            pending = True
            continue
        listen = str(t.get("listen") or "")
        host, port, decidable = _bind_split(listen)
        pin = str(t.get("bind_ip") or "")
        if t.get("stopped") or not host:
            _TURN_BIND_HEALED.add(svc)
            continue
        if pin and _IPV4_RE.match(pin) and pin in mine:
            _TURN_BIND_HEALED.add(svc)
            if t.get("bind") == pin + ":" + port:
                continue
        else:
            ok = _bind_works(str(t.get("bind") or listen), mine)
            if ok is None:
                _bind_ask_later(svc); pending = True
                continue
            _TURN_BIND_HEALED.add(svc)
            if ok:
                continue
        unit = host_sh("cat " + shlex.quote(_turn_unit_path(svc)) + " 2>/dev/null", probe=True).stdout or ""
        if not _unit_is_envform(unit):
            continue
        cur = _tp_from_unit(svc, unit)
        if not cur.get("listen"):
            continue
        text = _turn_env_text(cur["listen"], cur.get("connect", ""), cur.get("params", ""), cur.get("bind_ip", ""), cur.get("bind", ""))
        nb = (text.split("\n", 1)[0].split("=", 1) + [""])[1]
        if nb == cur.get("bind"):
            continue
        if (host_sh("systemctl is-active " + shlex.quote(svc) + " 2>/dev/null", probe=True).stdout or "").strip() == "inactive":
            continue
        w = host_sh("cat > " + shlex.quote(_turn_env_path(svc)) + " <<'SWGENV'\n" + text + "SWGENV\nsystemctl restart " + shlex.quote(svc))
        _turn_loop_forget(svc)
        log(LOG_NOTICE, "turn: %s bound %s — now binds %s" % (svc, cur.get("bind", ""), nb)
            if w.returncode == 0 else "turn: %s could not be moved off %s: %s" % (svc, cur.get("bind", ""), (w.stderr or "").strip()[:120]))
    _TURN_HEAL_SEEN.update(mtime=mt, pending=pending)


def _env_listen(path):
    with contextlib.suppress(OSError):
        with open(path) as f:
            for ln in f:
                if ln.startswith("SWG_LISTEN="):
                    return ln.split("=", 1)[1].strip()
    return ""


def network_route_refusal(prefix, local=(), gateways=(), panel=(), resolvers=(), resolvers_known=True):
    import ipaddress
    try:
        net = ipaddress.ip_network(str(prefix).strip(), strict=False)
    except ValueError:
        return "invalid", ""
    if net.version != 4:
        return "not_v4", ""
    if net.prefixlen == 0:
        return "default_route", ""
    if any(net.overlaps(ipaddress.ip_network(r)) for r in _RESERVED_V4):
        return "reserved", ""
    for dev, ip, sub in local:
        with contextlib.suppress(ValueError):
            if net.overlaps(ipaddress.ip_network(str(sub), strict=False)):
                if dev.startswith("swg_"):
                    return "mesh", ip
                return ("iface_subnet" if dev.startswith(_TUNNEL_DEV_PREFIXES) else "node_lan"), ip
    for why, addrs in (("node_gateway", gateways), ("node_panel", panel or ()), ("node_resolver", resolvers)):
        for a in addrs:
            with contextlib.suppress(ValueError):
                if ipaddress.ip_address(a) in net:
                    return why, a
    if panel is None:
        return "panel_unknown", ""
    if not resolvers_known:
        return "resolver_unknown", ""
    return None, ""


def _route_paths(addrs):
    addrs = [a for a in addrs if a]
    if not addrs:
        return {}
    r = run(["ip", "-4", "-force", "-batch", "-"], input_text="".join("route get %s\n" % a for a in addrs))
    out = {a: "unreachable" for a in addrs}
    seen = False
    for ln in (r.stdout or "").splitlines():
        if not ln or ln[0].isspace():
            continue
        t = ln.split()
        kind = ""
        if t[0] in _RT_TYPES and len(t) > 1:
            kind, t = t[0] + " ", t[1:]
        if t[0] not in out:
            continue
        seen = True
        out[t[0]] = kind + " ".join(k + " " + t[t.index(k) + 1] for k in ("via", "dev") if k in t[:-1])
    if not seen and r.returncode != 0:
        return None
    return out


def _net_guard_deps():
    local, gws = _local_addrs(), _default_gateways()
    if local is None or gws is None:
        return None
    res, known = _resolvers()
    pa = _PANEL_PEER.get("addr") or ""
    return {"local": local, "gateways": gws, "resolvers": res, "resolvers_known": known,
            "panel": None if not pa else [a for a in (pa,) if ":" not in a and not a.startswith("127.")]}


def net_route_install(prefix, dev, table="", _guard=True, _verify=True):
    tbl = ["table", str(table)] if table else []
    deps = _net_guard_deps()
    if deps is None:
        return False, "guard_unreadable", ""
    if _guard:
        why, addr = network_route_refusal(prefix, **deps)
        if why:
            return False, why, addr
    cur = run(["ip", "-4", "route", "show", "exact", str(prefix)] + tbl)
    if cur.returncode != 0:
        return False, "guard_unreadable", ""
    foreign = [t for t in (ln.split() for ln in (cur.stdout or "").splitlines())
               if t and ("dev" not in t[:-1] or t[t.index("dev") + 1] != dev)]
    if _guard and foreign:
        t = foreign[0]
        return False, "route_exists", (t[t.index("dev") + 1] if "dev" in t[:-1] else t[0])
    watch = sorted(set(deps["gateways"]) | set(deps["panel"] or ()) | set(deps["resolvers"]))
    before = _route_paths(watch) if _verify else {}
    if before is None:
        return False, "verify_unreadable", ""
    r = run(["ip", "route", "replace", str(prefix), "dev", dev] + tbl)
    if r.returncode != 0:
        return False, "install_failed", (r.stderr or "").strip()[:160]
    if _verify:
        after = _route_paths(watch)
        moved = [a for a in watch if after is None or after.get(a) != before.get(a)]
        if moved:
            run(["ip", "route", "del", str(prefix), "dev", dev] + tbl)
            for t in foreign:
                run(["ip", "route", "add"] + [w for w in t if w not in (
                    "linkdown", "dead", "pervasive", "offload", "trap", "rt_offload", "rt_trap",
                    "rt_offload_failed", "notify")] + tbl)
            return False, "rolled_back", moved[0]
    return True, None, ""


def net_deps():
    res, known = _resolvers()
    return {"panel": _PANEL_PEER.get("addr") or "", "resolvers": res, "resolvers_known": known, "share": 1, "carried": 1,
            "reach": 2}



_NET = {"refused": {}, "seen": set(), "sig": [], "kept": []}


def _net_prefix(s):
    import ipaddress
    with contextlib.suppress(ValueError):
        n = ipaddress.ip_network(str(s).strip(), strict=False)
        if n.version == 4:
            return str(n)
    return ""


def _net_kernel_dst(prefix):
    return prefix[:-3] if prefix.endswith("/32") else prefix


def _net_members(node_cfg, desired):
    import ipaddress
    out = {}
    ifs = node_cfg.get("interfaces") or {}
    for iface, plist in (desired or {}).items():
        if iface not in ifs or iface.startswith("swg_"):
            continue
        multi = [p for p in (plist or []) if "," in str(p.get("allowed_ips") or "")]
        if not multi:
            continue
        sub = _iface_subnet(node_cfg, iface)
        if not sub or _iface_is_mesh(node_cfg, iface, sub):
            continue
        net = ipaddress.ip_network(sub)
        for p in multi:
            for m in str(p.get("allowed_ips")).split(","):
                pre = _net_prefix(m)
                if pre and not ipaddress.ip_network(pre).subnet_of(net):
                    out.setdefault(iface, {}).setdefault(pre, []).append(p.get("public_key"))
    return out


def _net_live_main(node_cfg, _proc="/proc/net/route"):
    import ipaddress
    try:
        with open(_proc) as f:
            rows = f.read().splitlines()[1:]
    except OSError:
        return None
    ifs = node_cfg.get("interfaces") or {}
    subs, out = {}, {}
    for line in rows:
        t = line.split()
        if len(t) < 8 or t[0] not in ifs or t[0].startswith("swg_"):
            continue
        with contextlib.suppress(ValueError):
            d, m = int(t[1], 16), int(t[7], 16)
            plen = bin(m).count("1")
            if not plen:
                continue
            pre = _net_prefix("%d.%d.%d.%d/%d" % (d & 0xFF, (d >> 8) & 0xFF, (d >> 16) & 0xFF, (d >> 24) & 0xFF, plen))
            if t[0] not in subs:
                s = _iface_subnet(node_cfg, t[0])
                subs[t[0]] = None if (not s or _iface_is_mesh(node_cfg, t[0], s)) else ipaddress.ip_network(s)
            if subs[t[0]] is not None and pre and not ipaddress.ip_network(pre).subnet_of(subs[t[0]]):
                out.setdefault(t[0], set()).add(pre)
    return out


def net_filter_desired(node_cfg, desired):
    members = _net_members(node_cfg, desired)
    _NET["sig"] = sorted((i, p) for i, m in members.items() for p in m)
    if not members:
        _NET["seen"].clear()
        return desired
    allp = {p for m in members.values() for p in m}
    _NET["seen"] &= allp
    new = sorted(allp - _NET["seen"] - set(_NET["refused"]))
    if new:
        deps = _net_guard_deps()
        for p in new:
            why, addr = network_route_refusal(p, **deps) if deps is not None else ("guard_unreadable", "")
            if why:
                _NET["refused"][p] = {"why": why, "addr": addr}
            _NET["seen"].add(p)
    out = None
    for iface, nets in members.items():
        drop = set(nets) & set(_NET["refused"])
        if not drop:
            continue
        out = out or dict(desired)
        out[iface] = [dict(p, allowed_ips=",".join(m for m in str(p.get("allowed_ips")).split(",")
                                                   if _net_prefix(m) not in drop))
                      if "," in str(p.get("allowed_ips") or "") else p
                      for p in desired[iface]]
    return desired if out is None else out


def reconcile_net_routes(node_cfg, desired, res, _proc="/proc/net/route"):
    members = _net_members(node_cfg, desired)
    live = _net_live_main(node_cfg, _proc)
    if not members and not live:
        _NET["refused"] = {}
        _NET["kept"] = []
        return []
    if live is None:
        res["errors"].append("networks: cannot read the routing table — nothing changed")
        return []
    deps = _net_guard_deps()
    if deps is None:
        res["errors"].append("networks: cannot read this node's addresses — nothing changed")
        _NET["kept"] = sorted((p, i) for i, ps in live.items() for p in ps if p in (members.get(i) or {}))
        return _NET["kept"]
    for iface, ps in sorted(live.items()):
        gone = {p for p in ps if p not in (members.get(iface) or ())
                and any(p in (nets or ()) for i2, nets in members.items() if i2 != iface)}
        for p in sorted(gone):
            run(["ip", "route", "del", p, "dev", iface])
            res["changed"] += 1
        live[iface] = set(ps) - gone
    refused, kept = {}, []
    for iface, nets in sorted(members.items()):
        carried = {_net_prefix(m) for v in (current_allowed(node_cfg, iface) or {}).values()
                   for m in str(v).split(",")}
        for p in sorted(nets):
            key = "netroute|%s|%s" % (iface, p)
            why, addr = network_route_refusal(p, **deps)
            if why:
                refused[p] = {"why": why, "addr": addr, "iface": iface}
                continue
            if not _op_ready(key):
                refused[p] = dict(_NET["refused"].get(p) or {"why": "rolled_back", "addr": ""}, iface=iface)
                continue
            if p not in carried:
                continue
            if p in (live.get(iface) or ()):
                kept.append((p, iface))
                continue
            ok, why, addr = net_route_install(p, iface)
            if ok:
                _op_ok(key)
                kept.append((p, iface))
                res["changed"] += 1
            else:
                _op_fail(key, base=15.0, err=why)
                refused[p] = {"why": why, "addr": addr, "iface": iface}
                res["errors"].append(("network %s on %s: %s %s" % (p, iface, why, addr)).strip())
    keep = set(kept)
    for iface, ps in sorted(live.items()):
        for p in sorted(ps):
            if (p, iface) not in keep:
                run(["ip", "route", "del", p, "dev", iface])
                res["changed"] += 1
    _NET["refused"] = refused
    _NET["kept"] = kept
    return kept



_NETSNAT = {"checked": False, "have": 0}
NETSNAT_TAG = "swg-net-snat:"


def _net_snat_rules(node_cfg, kept):
    out = {}
    for prefix, iface in kept or ():
        sub = _iface_subnet(node_cfg, iface)
        if sub and re.match(r"^[A-Za-z0-9_.@-]{1,15}$", str(iface)):
            out["%s%s:%s" % (NETSNAT_TAG, iface, prefix)] = (iface, prefix, sub)
    return out


def reconcile_net_snat(node_cfg, kept, res):
    want = _net_snat_rules(node_cfg, kept)
    if not want and _NETSNAT["checked"] and not _NETSNAT["have"]:
        return
    r = run(["iptables", "-t", "nat", "-S", "POSTROUTING"])
    if r.returncode != 0:
        res["errors"].append("networks: cannot read the NAT table — clients of other interfaces keep their own address this pass")
        return
    lines = [l.strip() for l in (r.stdout or "").splitlines() if l.startswith("-A POSTROUTING") and NETSNAT_TAG in l]
    have, stuck = {}, 0
    for ln in lines:
        m = re.search(r'--comment "?(' + re.escape(NETSNAT_TAG) + r'[^"\s]+)"?', ln)
        if m:
            have.setdefault(m.group(1), []).append(ln)
    for tag, lns in sorted(have.items()):
        w = want.get(tag)
        good = None
        if w:
            iface, prefix, sub = w
            for ln in lns:
                if (re.search(r"(?:^|\s)-o %s(?:\s|$)" % re.escape(iface), ln) and re.search(r"(?:^|\s)-d %s(?:\s|$)" % re.escape(prefix), ln)
                        and re.search(r"(?:^|\s)! -s %s(?:\s|$)" % re.escape(sub), ln) and re.search(r"-j MASQUERADE(?:\s|$)", ln)):
                    good = ln
                    break
        for ln in lns:
            if ln != good:
                if _ipt_del_listed(["-t", "nat"], "POSTROUTING", ln):
                    res["changed"] += 1
                else:
                    stuck += 1
                    res["errors"].append("networks: could not remove a stale translation (%s)" % tag[len(NETSNAT_TAG):])
        if good:
            want.pop(tag)
    for tag, (iface, prefix, sub) in sorted(want.items()):
        a = run(["iptables", "-t", "nat", "-I", "POSTROUTING", "1", "!", "-s", sub, "-d", prefix, "-o", iface,
                 "-m", "comment", "--comment", tag, "-j", "MASQUERADE"])
        if a.returncode == 0:
            res["changed"] += 1
        else:
            res["errors"].append("networks: cannot translate other interfaces' clients to %s on %s: %s"
                                 % (prefix, iface, (a.stderr or "").strip()[:120]))
    _NETSNAT["checked"] = True
    _NETSNAT["have"] = len(_net_snat_rules(node_cfg, kept)) + stuck



NET_PROBE_WAIT_S = 4.0
NET_PROBE_KEEP_S = 60
_PROBE = {"id": "", "result": None, "at": 0.0}
_PROBE_LOCK = threading.Lock()
_PROBE_ID_RE = re.compile(r"^[A-Za-z0-9]{8,32}$")


def _iface_own_addr(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic.get("conf", "")) as f:
            return conf_v4_address(parse_interface_section(f.read()).get("Address")).split("/")[0]
    except Exception:
        return ""


def net_probe_check(node_cfg, req, desired):
    import ipaddress
    rid = str(req.get("id") or "")
    base = {"id": rid, "addr": str(req.get("addr") or "")[:64]}
    port = req.get("port")
    try:
        addr = ipaddress.ip_address(str(req.get("addr") or "").strip())
    except ValueError:
        return dict(base, verdict="bad_request"), None
    if addr.version != 4 or (port is not None and (isinstance(port, bool) or not isinstance(port, int)
                                                   or not 1 <= port <= 65535)):
        return dict(base, verdict="bad_request"), None
    iface = str(req.get("iface") or "")
    sub = _iface_subnet(node_cfg, iface) if iface in (node_cfg.get("interfaces") or {}) and not iface.startswith("swg_") else ""
    peer, prefix = None, ""
    if sub and ipaddress.ip_network(sub).version == 4 and not _iface_is_mesh(node_cfg, iface, sub):
        peer = next((p for p in (desired or {}).get(iface) or [] if p.get("public_key") == req.get("pubkey")), None)
        tun = ipaddress.ip_network(sub)
        for m in str((peer or {}).get("allowed_ips") or "").split(",")[1:]:
            pre = _net_prefix(m)
            if pre and not ipaddress.ip_network(pre).subnet_of(tun) and addr in ipaddress.ip_network(pre):
                prefix = pre
                break
    if not prefix:
        return dict(base, verdict="not_carried"), None
    base["prefix"] = prefix
    net = ipaddress.ip_network(prefix)
    if net.prefixlen <= 30 and addr in (net.network_address, net.broadcast_address):
        return dict(base, verdict="network_address"), None
    r = _NET["refused"].get(prefix)
    if r:
        return dict(base, verdict="no_route", why=str(r.get("why") or ""), raddr=str(r.get("addr") or "")), None
    src = _iface_own_addr(node_cfg, iface)
    if not src:
        return dict(base, verdict="no_source"), None
    return None, {"id": rid, "iface": iface, "pubkey": peer.get("public_key"), "addr": str(addr), "port": port,
                  "prefix": prefix, "src": src}


def _net_icmp(dst, src, wait=NET_PROBE_WAIT_S, count=3):
    import errno
    def _ck(d):
        if len(d) % 2:
            d += b"\0"
        x = sum(struct.unpack("!%dH" % (len(d) // 2), d))
        x = (x >> 16) + (x & 0xFFFF); x += x >> 16
        return ~x & 0xFFFF
    s = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_ICMP)
    try:
        s.bind((src, 0))
        ident, sent, pl = secrets.randbelow(0xFFFF) + 1, {}, b"swg-net-probe"
        t0 = time.monotonic()
        end, gap = t0 + wait, wait / (count + 1)
        while True:
            now = time.monotonic()
            if len(sent) < count and now >= t0 + len(sent) * gap:
                seq = len(sent) + 1
                try:
                    s.sendto(struct.pack("!BBHHH", 8, 0, _ck(struct.pack("!BBHHH", 8, 0, 0, ident, seq) + pl), ident, seq)
                             + pl, (dst, 0))
                except OSError as e:
                    return ("send_error", errno.errorcode.get(e.errno, str(e.errno)))
                sent[seq] = time.monotonic()
                continue
            if now >= end:
                return ("no_answer",)
            nxt = t0 + len(sent) * gap if len(sent) < count else end
            if not select.select([s], [], [], max(0.0, min(end, nxt) - now))[0]:
                continue
            data, frm = s.recvfrom(2048)
            ihl = (data[0] & 0x0F) * 4
            if len(data) < ihl + 8:
                continue
            if data[ihl] == 0 and frm[0] == dst:
                rid, seq = struct.unpack("!HH", data[ihl + 4:ihl + 8])
                if rid == ident and seq in sent:
                    return ("answered", round((time.monotonic() - sent[seq]) * 1000, 1))
            elif data[ihl] == 3 and len(data) >= ihl + 36:
                inner = data[ihl + 8:]
                iihl = (inner[0] & 0x0F) * 4
                if (len(inner) >= iihl + 8 and inner[9] == 1 and socket.inet_ntoa(inner[16:20]) == dst
                        and struct.unpack("!H", inner[iihl + 4:iihl + 6])[0] == ident):
                    return ("unreachable", round((time.monotonic() - t0) * 1000, 1), frm[0])
    finally:
        s.close()


def _net_tcp(dst, port, src, wait=NET_PROBE_WAIT_S):
    import errno
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind((src, 0))
        s.settimeout(wait)
        t0 = time.monotonic()
        try:
            rc = s.connect_ex((dst, port))
        except socket.timeout:
            return ("no_answer",)
        except OSError as e:
            rc = e.errno
        ms = round((time.monotonic() - t0) * 1000, 1)
        if rc == 0:
            return ("answered", ms)
        if rc == errno.ECONNREFUSED:
            return ("refused_port", ms)
        if rc in (errno.EHOSTUNREACH, errno.ENETUNREACH):
            return ("unreachable", ms, "")
        if rc in (errno.ETIMEDOUT, errno.EAGAIN, errno.EWOULDBLOCK, errno.EINPROGRESS):
            return ("no_answer",)
        return ("send_error", errno.errorcode.get(rc, str(rc)))
    finally:
        s.close()


def _net_route_dev(addr, src):
    r = run(["ip", "-4", "route", "get", addr, "from", src])
    if r.returncode in (124, 127):
        return None
    t = (r.stdout or "").split() if r.returncode == 0 else []
    return t[t.index("dev") + 1] if "dev" in t[:-1] else ""


def net_probe_run(node_cfg, ctx, online_max=180, _icmp=None, _tcp=None):
    out = {"id": ctx["id"], "addr": ctx["addr"], "prefix": ctx["prefix"], "src": ctx["src"],
           "kind": "tcp" if ctx["port"] else "icmp"}
    if ctx["port"]:
        out["port"] = ctx["port"]
    dev = _net_route_dev(ctx["addr"], ctx["src"])
    if dev is None:
        return dict(out, verdict="error", detail="cannot read the routing table")
    if dev != ctx["iface"]:
        return dict(out, verdict="route_elsewhere", dev=dev)
    def _row():
        d = _iface_dump(node_cfg, ctx["iface"])
        return None if d is None else next((p for p in d[1] if p["public_key"] == ctx["pubkey"]), {})
    row = _row()
    if row is None:
        return dict(out, verdict="error", detail="cannot read " + ctx["iface"])
    if ctx["prefix"] not in {_net_prefix(m) for m in str(row.get("allowed_ips") or "").split(",")}:
        return dict(out, verdict="no_acl")
    got = ((_tcp or _net_tcp)(ctx["addr"], ctx["port"], ctx["src"]) if ctx["port"]
           else (_icmp or _net_icmp)(ctx["addr"], ctx["src"]))
    if got[0] in ("answered", "refused_port"):
        return dict(out, verdict=got[0], ms=got[1])
    if got[0] == "unreachable" and got[2]:
        return dict(out, verdict="unreachable", ms=got[1], **{"from": got[2]})
    if got[0] == "send_error" and got[1] == "ENOKEY":
        return dict(out, verdict="no_acl")
    hs = (_row() or row).get("last_handshake") or 0
    age = int(time.time() - hs) if hs else None
    if got[0] == "send_error" and got[1] != "EDESTADDRREQ" and age is not None and age <= online_max:
        return dict(out, verdict="error", detail=got[1])
    if age is None or age > online_max:
        return dict(out, verdict="gateway_offline", handshake_age=age)
    if got[0] == "unreachable":
        return dict(out, verdict="unreachable", ms=got[1])
    return dict(out, verdict="no_answer", handshake_age=age)


def _net_probe_done(rid, result):
    with _PROBE_LOCK:
        if _PROBE["id"] == rid:
            _PROBE.update(result=dict(result, at=int(time.time())), at=time.time())


def _net_probe_thread(node_cfg, ctx, online_max):
    try:
        res = net_probe_run(node_cfg, ctx, online_max)
    except Exception as e:
        res = {"id": ctx["id"], "addr": ctx["addr"], "prefix": ctx["prefix"], "verdict": "error", "detail": str(e)[:160]}
    _net_probe_done(ctx["id"], res)


def net_probe_take(node_cfg, req, desired, online_max=180):
    with _PROBE_LOCK:
        rid = req.get("id") if isinstance(req, dict) else ""
        rid = rid if isinstance(rid, str) else ""
        if not rid:
            if _PROBE["id"]:
                _PROBE.update(id="", result=None, at=0.0)
            return
        if rid == _PROBE["id"]:
            if _PROBE["result"] is not None and time.time() - _PROBE["at"] > NET_PROBE_KEEP_S:
                _PROBE["result"] = None
            return
        if not _PROBE_ID_RE.match(rid):
            return
        _PROBE.update(id=rid, result=None, at=time.time())
    refusal, ctx = net_probe_check(node_cfg, req, desired)
    if refusal is not None:
        _net_probe_done(rid, refusal)
        return
    threading.Thread(target=_net_probe_thread, args=(node_cfg, ctx, online_max), daemon=True).start()


def net_probe_status():
    with _PROBE_LOCK:
        return dict(_PROBE["result"]) if _PROBE["result"] is not None else None



