def _block_activity():
    out = {}
    IP = r"\d+\.\d+\.\d+\.\d+/\d+"
    with contextlib.suppress(Exception):
        if _P2P["on"]:
            _bt = ("bt_tcp", "bt_utp", "dht", "udptrk", "fan_flag")
            nl = _nft_counters(P2P_NFT_TABLE)
            if nl is not None:
                out.setdefault("*", {})["torrent"] = sum(nl[n][0] for n in _bt if n in nl)
            else:
                cj = json.loads(run(["nft", "-j", "list", "counters", "table", "inet", P2P_NFT_TABLE]).stdout or "{}")
                out.setdefault("*", {})["torrent"] = sum(int(o["counter"].get("packets", 0)) for o in cj.get("nftables", [])
                                                         if "counter" in o and o["counter"].get("name") in _bt)
    with contextlib.suppress(Exception):
        if _P2P["on"]:
            sj = json.loads(run(["nft", "-j", "list", "set", "inet", P2P_NFT_TABLE, "flag"]).stdout or "{}")
            ips = [e["elem"]["val"] if isinstance(e, dict) else e
                   for o in sj.get("nftables", []) if "set" in o for e in (o["set"].get("elem") or [])]
            if ips:
                out.setdefault("*", {})["torrent_ips"] = [str(i) for i in ips]
    mech = ""
    with contextlib.suppress(Exception):
        mech = _nft_kept(["nft", "list", "table", "inet", "swg_mech"], structural=False).stdout or ""
    with contextlib.suppress(Exception):
        for sub, fset in re.findall(r"ip saddr (" + IP + r")[^\n]*?add @(pscf_\S+)", mech):
            with contextlib.suppress(Exception):
                blk = re.search(r"set " + re.escape(fset) + r" \{(.*?)\n[ \t]*\}", mech, re.S)
                sm = re.search(r"elements = \{([^}]*)\}", blk.group(1)) if blk else None
                ips = re.findall(r"\d+\.\d+\.\d+\.\d+", sm.group(1)) if sm else []
                out.setdefault(sub, {})["scan"] = len(ips)
                if ips:
                    out[sub]["scan_ips"] = ips
    with contextlib.suppress(Exception):
        for ln in mech.splitlines():
            if "@mps_" not in ln or "drop" not in ln:
                continue
            sub = re.search(r"ip saddr (" + IP + r")", ln)
            pk = re.search(r"counter packets (\d+)", ln)
            if sub and pk:
                out.setdefault(sub.group(1), {})["mech"] = int(pk.group(1))
    with contextlib.suppress(Exception):
        _bsw = {x[0] for c2, lst in ((_SHADOW["v"] or {}).get("by_target") or {}).items() if str(c2).startswith("blku") for x in lst}
        _st = _smart_table()
        pre = (_nft_kept(["nft", "list", "chain", "inet", SMART_NFT_TABLE, "prerouting"], structural=False).stdout or ""
               if (_bsw or _st["rc"] != 0 or "blku" in _st["out"]) else "")
        for ln in pre.splitlines():
            _m = re.search(r"@catl?_(sw_[0-9a-f]{10})\b", ln) if _bsw else None
            if ("blku" not in ln and not (_m and _m.group(1) in _bsw)) or "drop" not in ln:
                continue
            sub = re.search(r"ip saddr (" + IP + r")", ln)
            pk = re.search(r"counter packets (\d+)", ln)
            if sub and pk:
                out.setdefault(sub.group(1), {})
                out[sub.group(1)]["blocked"] = out[sub.group(1)].get("blocked", 0) + int(pk.group(1))
    with contextlib.suppress(Exception):
        fwd = _smart_forward()
        for ln in fwd.splitlines():
            pk = re.search(r"counter packets (\d+)", ln) if ("%#010x" % SNI_BLOCK_MARK) in ln else None
            if pk:
                out.setdefault("*", {})["blocked"] = out.get("*", {}).get("blocked", 0) + int(pk.group(1))
    with contextlib.suppress(Exception):
        inp = _nft_kept(["nft", "list", "chain", "inet", RELAY_TABLE, "inp"], structural=False).stdout or ""
        for ln in inp.splitlines():
            pk = re.search(r"counter packets (\d+)", ln) if ("== %#010x" % SNI_BLOCK_MARK) in ln else None
            if pk:
                out.setdefault("*", {})["blocked"] = out.get("*", {}).get("blocked", 0) + int(pk.group(1))
    return out


