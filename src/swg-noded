def _lan_ruleset(nets, devs, mesh=()):
    dst = "{ %s }" % ", ".join(nets)
    L = ["table inet %s" % LAN_NFT_TABLE, "delete table inet %s" % LAN_NFT_TABLE,
         "table inet %s {" % LAN_NFT_TABLE, "  chain clients {",
         "    type filter hook forward priority %s; policy accept;" % LAN_HOOK_PRI]
    if devs:
        L.append("    iifname { %s } ip daddr %s counter drop" % (", ".join('"%s"' % d for d in devs), dst))
    L.append('    iifname "swg_*" ip daddr %s counter drop' % dst)
    other = sorted(m for m in mesh if not str(m).startswith("swg_") and re.match(r"^[A-Za-z0-9_.@-]{1,15}$", str(m)))
    if other:
        L.append("    iifname { %s } ip daddr %s counter drop" % (", ".join('"%s"' % m for m in other), dst))
