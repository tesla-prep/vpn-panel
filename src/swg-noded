def _exit_conf_text(rec):
    _in = _exit_dialin(rec)
    L = ["[Interface]", "PrivateKey = " + rec.get("priv", ""),
         "Address = " + rec.get("address", "") + "/32", "MTU = " + str(rec.get("mtu") or 1280)]
    if _in:
        L.append("ListenPort = " + str(int(rec["listen_port"])))
    L.append("Table = off")
    _aw = _exit_awg(rec)
    L += ["%s = %s" % (k, _aw[k]) for k in AWG_KEYS if k in _aw]
    L += ["", "[Peer]", "PublicKey = " + rec.get("peer_key", "")]
    if str(rec.get("psk") or "").strip():
        L.append("PresharedKey = " + str(rec["psk"]).strip())
    L.append("AllowedIPs = 0.0.0.0/0")
    if _in:
