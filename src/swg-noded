                        hit.setdefault(d, set()).add(c)
            if len(keep) != len(lst):
                domains[c] = keep
            continue
        for d in lst:
            if d in cand:
                hit.setdefault(d, set()).add(c)
    t2k = ("starts", "ends", "contains")
    idx = {kd: {} for kd in ("first", "zone", "any")}
    t2 = {kd: {} for kd in t2k}
    for kd, byc in (pats or {}).items():
        if kd not in idx and kd not in t2:
            continue
        for c, ops in (byc or {}).items():
            for o in (ops or ()):
                o = str(o).lower()
                o = o if kd in t2 else o.strip(".")
                if o:
                    (t2 if kd in t2 else idx)[kd].setdefault(o, set()).add(c)
    t2 = {kd: sorted(v.items(), key=lambda kv: (-len(kv[0]), kv[0])) for kd, v in t2.items()}

    def ladder(a):
        ok = lambda cs: {c for c in (cs or ()) if not c.startswith(_NB_UNION)}
        lb = a.split(".")
        if engine == "dns":
            for k in range(len(lb)):
                s = ".".join(lb[k:])
                got = ok(hit.get(s)) | (ok(idx["zone"].get(s)) if k == len(lb) - 1 else set())
                if got:
                    return got
            return set()
        for k in range(len(lb) - 1):
            got = ok(hit.get(".".join(lb[k:])))
            if got:
                return got
        for got in (ok(idx["first"].get(lb[0])), ok(idx["zone"].get(lb[-1]))):
            if got:
                return got
        for x in lb:
            got = ok(idx["any"].get(x))
            if got:
                return got
        for kd in t2k:
            for o, cs in t2[kd]:
                if (a.startswith(o) if kd == "starts" else a.endswith(o) if kd == "ends" else o in a):
                    got = ok(cs)
                    if got:
                        return got
        return set()
    uz = {z for z, cs in idx["zone"].items() if any(c.startswith(_NB_UNION) for c in cs)}
    add = {}
    for a in sorted(allow):
        lb = a.split(".")
        if hit.get(a) or not (lb[-1] in uz or any(c.startswith(_NB_UNION) for k in range(1, len(lb)) for c in hit.get(".".join(lb[k:]), ()))):
            continue
        for c in (ladder(a) or {NEVER_BLOCK_CAT}):
            add.setdefault(c, []).append(a)
    for c, names in add.items():
        domains[c] = list(domains.get(c) or []) + names


def _ensure_smart_dnsmasq(domains, smart_e, res, unchanged=False, zones=None, nets=(), upstream=SMART_DNS_UPSTREAM_DEFAULT, spare=None):
    subnets = sorted({e["subnet"] for e in smart_e})
    want = bool((domains or zones) and subnets)
    _SMART_MODE["dns_idle"] = not want
    if not want:
        _SMART_MODE.pop("dns_upstream", None)
    _smart_dns_redirect(subnets if want else [], res, nets=[p for p, _i in (nets or ())])
    if not want:
        _DNSMASQ_BUILD["n"] = 0
        had = _dnsmasq_running() or os.path.exists(DNSMASQ_CONF) or run(["pgrep", "-f", "conf-file=" + DNSMASQ_CONF]).returncode == 0
        if had:
            _dnsmasq_stop(); res["changed"] += 1
        return
    _DNSMASQ_BUILD["n"] += 1
    if unchanged and _DNSMASQ_BUILD["n"] % 12 != 0 and _dnsmasq_running():
        return
    conf = ["# managed by swg-noded — domain-tier smart routing (do not edit)",
            "port=" + str(SMART_DNS_PORT), "listen-address=127.0.0.1", "bind-interfaces",
            "no-resolv", "no-hosts", "cache-size=2000", "pid-file=" + DNSMASQ_PID,
            "max-ttl=" + str(SMART_DNS_MAX_TTL)]
    if NODE_KIND == "docker":
        with contextlib.suppress(OSError):
            os.makedirs(os.path.dirname(DNSMASQ_LOG), exist_ok=True)
        conf.append("log-facility=" + DNSMASQ_LOG)
    conf += ["server=" + u for u in (upstream or SMART_DNS_UPSTREAM_DEFAULT)]
    dom_sets = {}
    _catd = set((spare or {}).get("catd") or ())
    for cat in domains:
        if cat == NEVER_BLOCK_CAT:
            for d in domains[cat]:
                if d:
                    dom_sets.setdefault(d, set())
            continue
        sn = _smart_setname(cat)
        for d in domains[cat]:
            if d:
                dom_sets.setdefault(d, set()).add(sn)
                if cat in _catd:
                    dom_sets[d].add("catd_" + sn[4:])
    _zone_keys = set()
    for cat in (zones or {}):
        sn = _smart_setname(cat)
        for z in (zones[cat] or []):
            if z:
                dom_sets.setdefault(z, set()).add(sn); _zone_keys.add(z)
                if cat in _catd:
                    dom_sets[z].add("catd_" + sn[4:])
    _blk_sets = set((spare or {}).get("block_sets") or ())
    if spare:
        for d, sns in dom_sets.items():
            if not (sns & _blk_sets):
                sns.add("dnsok")
        conf.append("nftset=/#/4#inet#" + SMART_NFT_TABLE + "#dnsok")
    if _zone_keys and _SMART_MODE.get("engine") == "dns":
        _SMART_MODE["lowered"] = {"zone": len(_zone_keys)}
    groups = {}
    for d, sns in dom_sets.items():
        if sns:
            groups.setdefault(tuple(sorted(sns)), []).append(d)
    for sns in sorted(groups):
        suffix = "/" + ",".join("4#inet#" + SMART_NFT_TABLE + "#" + sn for sn in sns)
        cur, clen = [], 0
        for d in sorted(groups[sns]):
            if cur and 8 + clen + len(suffix) + 1 + len(d) > 900:
                conf.append("nftset=/" + "/".join(cur) + suffix)
                cur, clen = [], 0
            cur.append(d); clen += len(d) + (1 if clen else 0)
        if cur:
            conf.append("nftset=/" + "/".join(cur) + suffix)
    body = "\n".join(conf) + "\n"
    try:
        cur = open(DNSMASQ_CONF).read()
    except OSError:
        cur = None
    if cur != body:
        try:
            with open(DNSMASQ_CONF, "w") as f:
                f.write(body)
        except OSError as e:
            res["errors"].append("smart dnsmasq conf: " + str(e)); return
        if _dnsmasq_running():
            _dnsmasq_kill()
    if not _dnsmasq_running():
        r = run([DNSMASQ_BIN, "--conf-file=" + DNSMASQ_CONF])
        if getattr(r, "returncode", 1) != 0:
            res["errors"].append("smart dnsmasq start: " + (getattr(r, "stderr", "") or "").strip()[:120])
        else:
            res["changed"] += 1
    if _dnsmasq_running():
        _SMART_MODE["dns_upstream"] = list(upstream or SMART_DNS_UPSTREAM_DEFAULT)
    else:
        _SMART_MODE.pop("dns_upstream", None)


