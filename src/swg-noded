_SRC_WID_RE = re.compile(r"[0-9a-f]{12}")
_SRC_DEV_RE = re.compile(r"[A-Za-z0-9_.@:+-]{1,15}")
_SRC_SETS = {}


def _smart_srcsetname(wid):
    return "src_" + wid


_PORTS_LIST_RE = re.compile(r"(?:[0-9]{1,5}(?:-[0-9]{1,5})?(?:,[0-9]{1,5}(?:-[0-9]{1,5})?){0,31})?")


def _ports_spans(p):
    if not isinstance(p, dict) or p.get("proto") not in ("tcp", "udp", "both") or not isinstance(p.get("list", ""), str) \
            or not _PORTS_LIST_RE.fullmatch(p.get("list", "")):
        return None
    spans = sorted(tuple(int(x) for x in (t.split("-") * 2)[:2]) for t in p.get("list", "").split(",") if t)
    if any(not (1 <= a <= b <= 65535) for a, b in spans) or (not spans and p["proto"] == "both"):
        return None
    out = []
    for a, b in spans:
        if out and a <= out[-1][1] + 1:
            out[-1] = (out[-1][0], max(out[-1][1], b))
        else:
            out.append((a, b))
    return p["proto"], out


def _ports_tokens(ps):
    proto, spans = ps
    out = ["meta", "l4proto", "{ tcp, udp }" if proto == "both" else proto]
    if spans:
        el = ["%d" % a if a == b else "%d-%d" % (a, b) for a, b in spans]
        out += ["th", "dport", el[0] if len(el) == 1 else "{ " + ", ".join(el) + " }"]
    return out


def _ports_match(p):
    ps = _ports_spans(p)
    return None if ps is None else _ports_tokens(ps)


def _spans_t443(ps):
    return ps is None or (ps[0] != "udp" and (not ps[1] or any(a <= 443 <= b for a, b in ps[1])))


def _ports_t443(e):
    if "ports" not in e:
        return True
    ps = _ports_spans(e["ports"])
    return ps is not None and _spans_t443(ps)


def _ports_cover(a, b):
    if a is None:
        return True
    if b is None:
        return False
    return (a[0] == "both" or a[0] == b[0]) and (not a[1] or (bool(b[1]) and all(any(x <= lo and hi <= y for x, y in a[1])
                                                                               for lo, hi in b[1])))


def _smart_keys_read(e):
    return ("src" not in e or bool(_SRC_WID_RE.fullmatch(str(e["src"])))) and ("ports" not in e or _ports_spans(e["ports"]) is not None)


_ARR_ACTS = ("exit", "direct", "block")
_ARR_SETS = {}


def _collapse4(nets):
    out = []
    for x in (nets or ()):
        with contextlib.suppress(Exception):
            n = ipaddress.ip_network(str(x), strict=False)
            if n.version == 4:
                out.append(n)
    return [str(n) for n in ipaddress.collapse_addresses(out)]


def _arrivals_parse(arr):
    if not isinstance(arr, dict):
        return [], []
    subs = _collapse4(x for x in (arr.get("subnets") or []) if isinstance(x, str))
    ents = []
    for e in (arr.get("entries") if isinstance(arr.get("entries"), list) else ()):
        if not isinstance(e, dict) or "src" in e or e.get("action") not in _ARR_ACTS or not isinstance(e.get("category"), str) \
                or not e["category"]:
            continue
        if e["action"] == "exit":
            T, dev = e.get("table"), str(e.get("via_iface") or "")
            if not (isinstance(T, int) and SWG_RT_BASE <= T <= SWG_RT_MAX and _SRC_DEV_RE.fullmatch(dev)):
                continue
            ents.append({"category": e["category"], "action": "exit", "via_iface": dev, "table": T})
        elif e["category"] != "all" or e["action"] == "block":
            ents.append({"category": e["category"], "action": e["action"]})
    return (subs, ents) if subs and ents else ([], [])


def _src_pairs(pairs):
    out = set()
    for p in (pairs if isinstance(pairs, list) else ()):
        if not (isinstance(p, (list, tuple)) and len(p) == 2 and _SRC_DEV_RE.fullmatch(str(p[0]))):
            continue
        a, _, ln = str(p[1]).partition("/")
        with contextlib.suppress(ValueError):
            if ln in ("", "32"):
                out.add((str(p[0]), str(ipaddress.IPv4Address(a))))
    return out


def _smart_src_members(pairs):
    return sorted('"%s" . %s' % p for p in _src_pairs(pairs))


_SHADOW = {"k": None, "v": {}, "dns": ""}


def _smart_shadows(smart_e, domains, pats, engine, insig=None, allow=()):
    if engine not in ("dns", "sni_user"):
        return {}
    kinds = ("zone",) if engine == "dns" else ("first", "zone", "any", "starts", "ends", "contains")
    aud = {}
    for e in smart_e:
        if e.get("category") and e["category"] != "all" and _smart_keys_read(e):
            aud.setdefault(e["category"], {}).setdefault(e["subnet"], []).append(
                (e.get("src") or None, _ports_spans(e["ports"]) if "ports" in e else None))
    keyed = [c for c in aud if (domains or {}).get(c) or any(c in ((pats or {}).get(k) or {}) for k in kinds)]
    def gap(c1, c2):
        cov = aud.get(c1, {})
        return any(not any((x is None or x == w) and _ports_cover(p1, p2) for x, p1 in cov.get(S, ()))
                   for S, ws in aud[c2].items() for w, p2 in ws)
    pairs = {(c1, c2) for c1 in keyed for c2 in keyed if c1 != c2 and gap(c1, c2)}
    if not pairs:
        return {}
    k = (engine, insig, json.dumps(pats or {}, sort_keys=True), json.dumps(sorted(pairs))) if insig is not None else None
    if k is not None and _SHADOW["k"] == k:
        return _SHADOW["v"]
    t2k = ("starts", "ends", "contains")
    def norm(kd, s):
        s = str(s); l = s.lower(); l = s if l == s else l
        return l if kd in t2k else l.strip(".")
    def ops(c):
        for d in (domains.get(c) or []):
            n = norm("site", d)
            if n and (engine == "dns" or "." in n):
                yield ("site", d, n)
        for kd in kinds:
            for o in ((pats.get(kd) or {}).get(c) or []):
                n = norm(kd, o)
                if n:
                    yield (kd, o, n)
    def rank(kd, n, lb=()):
        if engine == "dns":
            return (-(n.count(".") + 1),)
        if kd == "site":
            return (1, -(n.count(".") + 1))
        if kd == "zone":
            return (3,)
        if kd == "any":
            return (4, lb.index(n) if n in lb else 0)
        return (5, t2k.index(kd), -len(n), n)
    own = {"site": {}, "zone": {}, "any": {}}
    t2 = {kd: {} for kd in t2k}
    for i, c in enumerate(keyed):
        b = 1 << i
        for kd, _raw, n in ops(c):
            if kd in t2k:
                t2[kd].setdefault(n, set()).add(c)
            else:
                d = own.setdefault(kd, {}); d[n] = d.get(n, 0) | b
    t2 = {kd: list(v.items()) for kd, v in t2.items()}
    def of(kd, n):
        m = own.get(kd, {}).get(n, 0)
        return [keyed[i] for i in range(m.bit_length()) if m >> i & 1] if m else ()
    found = {}
    allow = set(allow or ())
    for c1 in sorted({c1 for c1, _c2 in pairs}):
        tg = {c2 for a, c2 in pairs if a == c1}
        for kd, raw, n in ops(c1):
            hit = []
            if kd == "site":
                lb = n.split(".")
                for j in range(1, len(lb) - (0 if engine == "dns" else 1)):
                    hit += [(c, rank("site", ".".join(lb[j:]))) for c in of("site", ".".join(lb[j:]))]
                hit += [(c, rank("zone", lb[-1])) for c in of("zone", lb[-1])]
                if allow and not str(c1).startswith(_NB_UNION) and _nb_under(n, allow):
                    hit = [(c, r) for c, r in hit if not str(c).startswith(_NB_UNION)]
                hit += [(c, rank("any", x, lb)) for x in lb for c in of("any", x)]
                hit += [(c, rank("ends", o)) for o, cs in t2["ends"] if n.endswith(o) for c in cs]
            elif kd in ("first", "zone"):
                hit += [(c, rank("any", n)) for c in of("any", n)]
                t = "starts" if kd == "first" else "ends"
                hit += [(c, rank(t, o)) for o, cs in t2[t] if (n.startswith(o) if t == "starts" else n.endswith(o)) for c in cs]
            elif kd in ("starts", "ends"):
                hit += [(c, rank(kd, o)) for o, cs in t2[kd] if o != n and (n.startswith(o) if kd == "starts" else n.endswith(o))
                        for c in cs]
            hit += [(c, rank("contains", o)) for o, cs in t2["contains"] if o in n and (o != n or kd != "contains") for c in cs]
            best = {}
            for c, r in hit:
                if c != c1 and (c not in best or r < best[c]):
                    best[c] = r
            for c2 in best:
                if c2 in tg:
                    more = tuple(sorted(c3 for c3, r in best.items() if r < best[c2]))
                    found.setdefault((c2, c1, more), {}).setdefault(kd, set()).add(raw)
    out = {"by_target": {}, "domains": {}, "pats": {}}
    for (c2, c1, more), byk in sorted(found.items()):
        sh = "sw_" + hashlib.sha1("\n".join((c2, c1) + more).encode()).hexdigest()[:10]
        out["by_target"].setdefault(c2, []).append((sh, c1, list(more)))
        for kd, lst in byk.items():
            (out["domains"] if kd == "site" else out["pats"].setdefault(kd, {}))[sh] = sorted(lst)
    out = dict(out, sig=hashlib.sha1(json.dumps(out, sort_keys=True).encode()).hexdigest()[:16]) if found else {}
    _SHADOW.update(k=k, v=out)
    return out


def _smart_shadowed(domains, pats, shw):
    if not shw:
        return domains, pats
    return ({**(domains or {}), **shw["domains"]},
            {kd: {**((pats or {}).get(kd) or {}), **shw["pats"].get(kd, {})} for kd in set(pats or {}) | set(shw["pats"])})


_LOOP = {"n": 0}
_SMART_TABLE = {"n": -1, "rc": 1, "out": "", "counts": {}, "setnames": set(), "bytes": {}, "gen": None, "cnames": []}


def _smart_live(out):
    return "expires " in out or "add @" in out or "update @" in out or " meter " in out


def _smart_cat_bytes(pairs):
    out = {}
    for name, by in pairs:
        mm = re.match(r"c_(.+)_(up|dn)$", name)
        if mm:
            out.setdefault(mm.group(1), {"up": 0, "dn": 0})[mm.group(2)] = int(by)
    return out


def _smart_table():
    if _SMART_TABLE["n"] != _LOOP["n"]:
        gen = _nft_genid()
        if gen is not None and gen == _SMART_TABLE["gen"]:
            nl = _nft_counters(SMART_NFT_TABLE) if _SMART_TABLE["cnames"] else {}
            if nl is not None and all(c in nl for c in _SMART_TABLE["cnames"]):
                _SMART_TABLE.update(n=_LOOP["n"], bytes=_smart_cat_bytes((c, nl[c][1]) for c in _SMART_TABLE["cnames"]))
                return _SMART_TABLE
        r = run(["nft", "list", "table", "inet", SMART_NFT_TABLE])
        out = r.stdout or ""
        counts, setnames, cbytes, cnames = {}, set(), {}, []
        if r.returncode == 0:
            setnames = set(re.findall(r"set (\S+) {", out))
            counts = {c: 0 for c in setnames}
            for m in re.finditer(r"set (\S+) {(?:[^}]*?elements = {([^}]*)})?", out, re.S):
                el = m.group(2)
                counts[m.group(1)] = len([x for x in el.split(",") if x.strip()]) if el else 0
            pairs = re.findall(r"counter (c_[a-z0-9_]+) \{\s*packets \d+ bytes (\d+)", out)
            cnames, cbytes = [c for c, _ in pairs], _smart_cat_bytes(pairs)
        keep = gen is not None and ((r.returncode == 0 and not _smart_live(out)) or _nft_absent(r))
        _SMART_TABLE.update(n=_LOOP["n"], rc=r.returncode, out=out, counts=counts, setnames=setnames, bytes=cbytes,
                            gen=gen if keep else None, cnames=cnames)
    return _SMART_TABLE


class _NftBatch:

    def __init__(self):
        self.lines = []

    def __len__(self):
        return len(self.lines)

    def add(self, *args):
        self.lines.append(" ".join(str(a) for a in args))

    def apply(self, res, what="smart nft"):
        if not self.lines:
            return True
        script = "\n".join(self.lines) + "\n"
        for argv, stage in ((["nft", "-c", "-f", "-"], "check"), (["nft", "-f", "-"], "apply")):
            r = run(argv, input_text=script, timeout=60)
            if r.returncode != 0:
                res["errors"].append("%s %s: %s" % (what, stage, (r.stderr or "").strip().replace("\n", " ")[:160]))
                return False
        return True


def _ensure_smart_nft(smart_e, categories, res, pin=False, v6_ifaces=(), reset_mark=0, queue=True, learn_ttl=3600, srcs=None,
                      shadows=None, arrivals=None, name_cats=None, blk_reject=False, spare_dns=False, static_cats=None):
    _SNI_BLOCKS["v"] = None
    _DNS_SPARE["v"] = None
    cats = sorted(set(categories) | {e["category"] for e in smart_e})
    _t = _smart_table()
    arr = arrivals if (isinstance(arrivals, dict) and arrivals.get("entries") and arrivals.get("subnets")) else None
    if not smart_e and not cats and not arr:
        if _t["rc"] == 0:
            run(["nft", "delete", "table", "inet", SMART_NFT_TABLE]); res["changed"] += 1
        return {}
    body = _t["out"] if _t["rc"] == 0 else ""
    _am = os.path.join(GEO_DIR, ".automerge-migrated")
    if _t["rc"] == 0 and not os.path.exists(_am) and re.search(r"set \S+ {(?:(?!auto-merge|}).)*}", body, re.S):
        run(["nft", "delete", "table", "inet", SMART_NFT_TABLE]); res["changed"] += 1
        body = ""
    if not body:
        run(["nft", "add", "table", "inet", SMART_NFT_TABLE])
        _DNSMASQ_SETS_EMPTIED["v"] = True
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True); open(_am, "w").write("1")
    have_sets = set(re.findall(r"set (\S+) {", body))
    bat = _NftBatch()
    stamps = []
    for c in cats:
        if c == "all":
            continue
        sn = _smart_setname(c)
        if sn not in have_sets:
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, sn, "{ typeof ip daddr; flags interval; auto-merge; }"])
        if queue and _smart_learnsetname(c) not in have_sets:
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, _smart_learnsetname(c),
                 "{ typeof ip daddr; flags timeout; timeout " + str(learn_ttl) + "s; }"])
            _CATL_GEN[c] = time.time()
    shcats = sorted({x[0] for lst in ((shadows or {}).get("by_target") or {}).values() for x in lst})
    for c in shcats:
        if _smart_setname(c) not in have_sets:
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, _smart_setname(c), "{ typeof ip daddr; flags interval; auto-merge; }"])
        if queue and _smart_learnsetname(c) not in have_sets:
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, _smart_learnsetname(c),
                 "{ typeof ip daddr; flags timeout; timeout " + str(learn_ttl) + "s; }"])
            _CATL_GEN[c] = time.time()
    if "prerouting" not in re.findall(r"chain (\S+) {", body):
        run(["nft", "add", "chain", "inet", SMART_NFT_TABLE, "prerouting",
             "{ type filter hook prerouting priority mangle; policy accept; }"])
    arr_sets, arr_stamps = {}, {}
    if arr:
        arr_sets = {"lg": ("{ typeof iifname; }", sorted('"%s"' % d for d in set(arr.get("legs") or ()) if _SRC_DEV_RE.fullmatch(str(d)))),
                    "ar": ("{ typeof ip saddr; flags interval; auto-merge; }", _collapse4(arr["subnets"])),
                    "cln": ("{ typeof ip daddr; flags interval; auto-merge; }", _collapse4(arr.get("cln") or ()))}
        for sn, (typ, mem) in sorted(arr_sets.items()):
            if sn not in have_sets:
                run(["nft", "add", "set", "inet", SMART_NFT_TABLE, sn, typ])
            msig = hashlib.sha1(json.dumps(mem).encode()).hexdigest()[:16]
            if sn not in have_sets or _ARR_SETS.get(sn) != msig or (mem and not _t["counts"].get(sn, 0)):
                bat.add("flush", "set", "inet", SMART_NFT_TABLE, sn)
                if mem:
                    bat.add("add", "element", "inet", SMART_NFT_TABLE, sn, "{ " + ", ".join(mem) + " }")
                arr_stamps[sn] = msig
    subnets = sorted({e["subnet"] for e in smart_e})
    spec = [e for e in smart_e if e["category"] != "all" and _smart_keys_read(e)]
    allr = [e for e in smart_e if e["category"] == "all" and "src" not in e and "ports" not in e]
    want = [(e["subnet"], e["category"], e.get("action", "exit"), e.get("table")) + ((e["src"],) if "src" in e else ())
            for e in spec + allr]
    ps_of = {i: _ports_spans(e["ports"]) for i, e in enumerate(spec) if "ports" in e}
    pt_of = {i: _ports_tokens(ps) for i, ps in ps_of.items()}
    off443 = {i for i, ps in ps_of.items() if not _spans_t443(ps)}
    rows = []
    for i, w in enumerate(want):
        if len(w) > 4:
            if rows and rows[-1]["key"] == (w[0], w[4]) and rows[-1]["end"] == i:
                rows[-1]["end"] = i + 1
            else:
                rows.append({"key": (w[0], w[4]), "start": i, "end": i + 1})
    want_sr = {"sr%d" % k for k in range(len(rows))}
    want_src = {_smart_srcsetname(r["key"][1]): _smart_src_members((srcs or {}).get(r["key"][1])) for r in rows}
    src_stamps = {}
    for sn, mem in sorted(want_src.items()):
        if sn not in have_sets:
            run(["nft", "add", "set", "inet", SMART_NFT_TABLE, sn, "{ type ifname . ipv4_addr; }"])
        msig = hashlib.sha1(json.dumps(mem).encode()).hexdigest()[:16]
        if sn not in have_sets or _SRC_SETS.get(sn) != msig or _t["counts"].get(sn, 0) != len(mem):
            bat.add("flush", "set", "inet", SMART_NFT_TABLE, sn)
            for i in range(0, len(mem), 2000):
                bat.add("add", "element", "inet", SMART_NFT_TABLE, sn, "{ " + ", ".join(mem[i:i + 2000]) + " }")
            src_stamps[sn] = msig
    sh_of = {}
    if shcats:
        aud = {}
        for i, w in enumerate(want):
            aud.setdefault(w[1], {}).setdefault(w[0], []).append((w[4] if len(w) > 4 else None, ps_of.get(i)))
        for i, w in enumerate(want):
            for sh, c1, more in shadows["by_target"].get(w[1], ()):
                cov = {x for c in [c1] + list(more) for x, p1 in aud.get(c, {}).get(w[0], ()) if _ports_cover(p1, ps_of.get(i))}
                if None not in cov and not (len(w) > 4 and w[4] in cov):
                    sh_of.setdefault(i, []).append((sh, sorted(x for x in cov if x)))
    shw = [[i, sh, ex] for i, lst in sorted(sh_of.items()) for sh, ex in lst]
    pb_of = {}
    if pin:
        for i, w in enumerate(want):
            if w[2] != "block" or w[1] == "all" or str(w[1]).startswith("blku"):
                continue
            ex = []
            for j in range(i):
                wj = want[j]
                if wj[0] != w[0] or wj[2] not in ("exit", "direct") or wj[1] == "all":
                    continue
                cond = ["iifname", ".", "ip", "saddr", "@" + _smart_srcsetname(wj[4])] if len(wj) > 4 else []
                for c, cnd in [(wj[1], cond)] + [(sh, cond + [t for x in xs for t in ("iifname", ".", "ip", "saddr", "!=", "@" + _smart_srcsetname(x))])
                                                  for sh, xs in sh_of.get(j, ())]:
                    ex += [[cnd + pt_of[j], snm, None if j in off443 else cnd] if j in pt_of else [cnd, snm]
                           for snm in [_smart_setname(c)] + ([_smart_learnsetname(c)] if queue else [])]
            if ex:
                pb_of[i] = ex
    want_pb = {"pb%d" % i for i in pb_of}
    aw = [(e["category"], e["action"], e.get("table"), e.get("via_iface") or "") for e in arr["entries"]] if arr else []
    ash_of = {}
    if arr and shcats:
        acov = {e["category"] for e in arr["entries"]}
        for i, (c, a, T, g) in enumerate(aw):
            for sh, c1, more in shadows["by_target"].get(c, ()):
                if not ({c1} | set(more)) & acov:
                    ash_of.setdefault(i, []).append(sh)
    pa_of = {}
    if pin and arr:
        for i, (c, a, T, g) in enumerate(aw):
            if a != "block" or c == "all":
                continue
            ex = []
            for j in range(i):
                cj, aj, Tj, gj = aw[j]
                if aj not in ("exit", "direct") or cj == "all":
                    continue
                cnd = ["iifname", "!=", '"%s"' % gj] if aj == "exit" and gj else []
                for c2 in [cj] + ash_of.get(j, []):
                    ex.extend([cnd, snm] for snm in [_smart_setname(c2)] + ([_smart_learnsetname(c2)] if queue else []))
            if ex:
                pa_of[i] = ex
    want_pa = {"pa%d" % i for i in pa_of}
    sni_blocks = None
    _nb = lambda acts: any(w[2] in acts and w[1] != "all" for w in want) or any(a in acts and c != "all" for c, a, _T, _g in aw)
    _has_blk = _nb(("block",))
    if queue and (_has_blk or off443):
        by_src = {}
        for i, w in enumerate(want):
            if w[1] != "all" and i not in off443:
                by_src.setdefault(w[0], []).append([(i + 1) << 16 | SNI_BLOCK_MARK, w[2],
                                                    [[w[1], []]] + [[sh, list(ex)] for sh, ex in sh_of.get(i, ())],
                                                    w[4] if len(w) > 4 else None])
        _used = lambda acts: ({w[1] for w in want if w[2] in acts} | {sh for i, w in enumerate(want) if w[2] in acts for sh, _x in sh_of.get(i, ())}
                              | {c for c, a, _T, _g in aw if a in acts} | {sh for i, (c, a, _T, _g) in enumerate(aw) if a in acts for sh in ash_of.get(i, ())})
        _wids = {w[4] for w in want if len(w) > 4} | {x for lst in sh_of.values() for _sh, ex in lst for x in ex}
        sni_blocks = {"v": 1, "mark": SNI_BLOCK_MARK,
                      "src": [[S, rl] for S, rl in sorted(by_src.items()) if any(r[1] == "block" for r in rl)],
                      "sel": {x: sorted(_src_pairs((srcs or {}).get(x))) for x in sorted(_wids)},
                      "nolearn": sorted(_used(("block",)) - _used(("exit", "direct")) - {"all"}
                                        | ({NEVER_BLOCK_CAT} & set(name_cats or ())))}
        if off443:
            _r443 = ({w[1] for i, w in enumerate(want) if w[2] in ("exit", "direct") and i not in off443}
                     | {sh for i, w in enumerate(want) if w[2] in ("exit", "direct") and i not in off443 for sh, _x in sh_of.get(i, ())}
                     | {c for c, a, _T, _g in aw if a in ("exit", "direct")}
                     | {sh for i, (c, a, _T, _g) in enumerate(aw) if a in ("exit", "direct") for sh in ash_of.get(i, ())})
            _q = sorted(_used(("exit", "direct")) - _r443 - {"all"})
            if _q:
                sni_blocks["quiet"] = _q
        if arr and any(a == "block" and c != "all" for c, a, _T, _g in aw):
            sni_blocks["arr"] = {"nets": _collapse4(arr["subnets"]),
                                 "rules": [[(0x8000 + i + 1) << 16 | SNI_BLOCK_MARK, a, [[c, []]] + [[sh, []] for sh in ash_of.get(i, ())], None]
                                           for i, (c, a, _T, _g) in enumerate(aw) if c != "all"]}
    _SNI_BLOCKS["v"] = sni_blocks
    svb_of = {}
    if sni_blocks:
        for i, w in enumerate(want):
            if w[2] != "block" or w[1] == "all" or str(w[1]).startswith("blku") or i in off443 or \
                    (name_cats is not None and w[1] not in name_cats and not sh_of.get(i)):
                continue
            ex = []
            for j in range(i):
                wj = want[j]
                if wj[0] == w[0] and wj[2] in ("exit", "direct") and wj[1] != "all" and j not in off443:
                    ex.append([["iifname", ".", "ip", "saddr", "@" + _smart_srcsetname(wj[4])] if len(wj) > 4 else [], _smart_setname(wj[1])])
            if ex:
                svb_of[(i + 1) << 16 | SNI_BLOCK_MARK] = ex
        for i, (c, a, _T, _g) in enumerate(aw):
            if a != "block" or c == "all" or str(c).startswith("blku") or (name_cats is not None and c not in name_cats and not ash_of.get(i)):
                continue
            ex = [[["iifname", "!=", '"%s"' % gj] if aj == "exit" and gj else [], _smart_setname(cj)]
                  for cj, aj, _Tj, gj in aw[:i] if aj in ("exit", "direct") and cj != "all"]
            if ex:
                svb_of[(0x8000 + i + 1) << 16 | SNI_BLOCK_MARK] = ex
    blk_rst = bool(pin and (blk_reject or (sni_blocks and _has_blk)))
    dns_blk, catd = set(), set()
    if spare_dns:
        for i, w in enumerate(want):
            if w[2] == "block" and w[1] != "all" and i not in pt_of:
                if name_cats is None or w[1] in name_cats:
                    dns_blk.add(w[1])
                dns_blk |= {sh for sh, _x in sh_of.get(i, ())}
        for i, (c, a, _T, _g) in enumerate(aw):
            if a == "block" and c != "all":
                if name_cats is None or c in name_cats:
                    dns_blk.add(c)
                dns_blk |= set(ash_of.get(i, ()))
        catd = {c for c in dns_blk if c in (static_cats or ())}
        if dns_blk:
            _DNS_SPARE["v"] = {"block_sets": sorted(_smart_setname(c) for c in dns_blk), "catd": sorted(catd)}
            if "dnsok" not in have_sets:
                run(["nft", "add", "set", "inet", SMART_NFT_TABLE, "dnsok", "{ typeof ip daddr; size %d; }" % DNSOK_MAX])
            for c in sorted(catd):
                if "catd_" + _smart_setname(c)[4:] not in have_sets:
                    run(["nft", "add", "set", "inet", SMART_NFT_TABLE, "catd_" + _smart_setname(c)[4:], "{ typeof ip daddr; }"])
            if _t["counts"].get("dnsok", 0) >= DNSOK_MAX * 9 // 10:
                bat.add("flush", "set", "inet", SMART_NFT_TABLE, "dnsok")
                _DNSMASQ_SETS_EMPTIED["v"] = True
    def _bsets(c):
        if queue:
            return [] if str(c).startswith("blku:host:") else [(_smart_setname(c), [])]
        if c in catd:
            return [(_smart_setname(c), ["ip", "daddr", "!=", "@catd_" + _smart_setname(c)[4:]]),
                    ("catd_" + _smart_setname(c)[4:], ["ip", "daddr", "!=", "@dnsok"])]
        if c in dns_blk:
            return [(_smart_setname(c), ["ip", "daddr", "!=", "@dnsok"])]
        return [(_smart_setname(c), [])]
    def _rsets(c, act):
        if act == "block":
            return _bsets(c)
        return [(_smart_setname(c), [])] + ([(_smart_learnsetname(c), [])] if queue else [])
    v6f = sorted(set(v6_ifaces))
    sig = hashlib.sha1((("pin;" if pin else "") + ("q2;" if queue else "") + json.dumps(want) + "|v6:" + ",".join(v6f) + "|rst:" + str(reset_mark) + ("|lttl:" + str(learn_ttl) if queue else "") + "|s9").encode()).hexdigest()[:16]
    if pt_of:
        sig = hashlib.sha1((sig + "|pt:" + json.dumps(sorted(pt_of.items()))).encode()).hexdigest()[:16]
    if shw:
        sig = hashlib.sha1((sig + "|sh:" + json.dumps(shw)).encode()).hexdigest()[:16]
    if pb_of:
        sig = hashlib.sha1((sig + "|pb:" + json.dumps(sorted(pb_of.items()))).encode()).hexdigest()[:16]
    if arr:
        sig = hashlib.sha1((sig + "|arr:" + json.dumps([aw, sorted(ash_of.items()), sorted(pa_of.items())])).encode()).hexdigest()[:16]
    if dns_blk:
        sig = hashlib.sha1((sig + "|dok:" + json.dumps([sorted(dns_blk), sorted(catd)])).encode()).hexdigest()[:16]
    if (queue and _has_blk) or blk_rst:
        sig = hashlib.sha1((sig + "|nb1" + ("|br" if blk_rst else "") + ("|svb:" + json.dumps(sorted(svb_of.items())) if svb_of else "")).encode()).hexdigest()[:16]
    _sigf = os.path.join(GEO_DIR, ".smart-sig")
    try:
        stored = open(_sigf).read().strip()
    except OSError:
        stored = ""
    _chs = re.findall(r"chain (\S+) {", body)
    chain_present = "prerouting" in _chs
    def _cbody(name):
        m = re.search(r"chain " + name + r" \{(.*?)\n\s*\}", body, re.S)
        return m.group(1) if m else ""
    expect_pre = pin or any(w[2] != "direct" or len(w) > 4 for w in want)
    pre_ok = (not expect_pre) or ("saddr" in _cbody("prerouting"))
    rows_ok = ({c for c in _chs if re.fullmatch(r"sr\d+", c)} == want_sr
               and {c for c in _chs if re.fullmatch(r"pb\d+", c)} == want_pb
               and ("sa" in _chs) == bool(arr) and {c for c in _chs if re.fullmatch(r"pa\d+", c)} == want_pa
               and (not arr or ("@lg" in _cbody("prerouting") and bool(_cbody("sa").strip())))
               and ("svb" in _chs) == bool(svb_of) and (not svb_of or bool(_cbody("svb").strip())))
    fwd_ok = (((not v6f) or ("drop" in _cbody("forward"))) and ((not (pin and reset_mark)) or ("reject" in _cbody("forward")))
              and ((not blk_rst) or ("%#010x" % SNI_BLOCK_MARK) in _cbody("forward")))
    if stored != sig or not chain_present or not pre_ok or not fwd_ok or not rows_ok:
        stored = ""
        bat.add("flush", "chain", "inet", SMART_NFT_TABLE, "prerouting")
