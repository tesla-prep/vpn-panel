def _relay_unit_text():
    return RELAY_UNIT_TMPL.replace("RELAY_BIN_PATH", RELAY_BIN)


def _relay_slice_text(quota_pct):
    q = max(5, min(RELAY_QUOTA_MAX, int(quota_pct or RELAY_QUOTA_PCT)))
    return RELAY_SLICE_TMPL.replace("RELAY_QUOTAPCT", str(q))


def _relay_env_text(iface, e):
    return ("RELAY_PORT=%d\nRELAY_BIND=%s\nRELAY_SOCK=%s\nRELAY_CC_UP=%s\nRELAY_CC_CLI=%s\nRELAY_MSS=%d\n"
            "RELAY_MARK=%d\n"
            % (e["port"], e["gw"], _relay_sock(iface), e.get("cc_up", ""), e.get("cc_cli", ""), e.get("mss") or 0,
               int(e.get("up") or 0)))


def _relay_write(path, text, dry=False):
    with contextlib.suppress(OSError):
        with open(path) as f:
            if f.read() == text:
                return False
    if dry:
        return True
    with contextlib.suppress(OSError):
        os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path + ".tmp", "w") as f:
            f.write(text)
        os.replace(path + ".tmp", path)
        return True
    except OSError:
        return False


def _relay_docker_cpus(quota_pct, n):
    q = max(5, min(RELAY_QUOTA_MAX, int(quota_pct or RELAY_QUOTA_PCT)))
    return max(0.05, round((q / 100.0) / max(1, n), 3))


def _relay_docker_spec(iface, e, cpus):
    return json.dumps({"img": SWG_TURN_IMAGE, "cpus": cpus, "port": e["port"], "bind": e["gw"],
                       "mark": int(e.get("mark") or 0), "up": int(e.get("up") or 0),
                       "mss": e.get("mss") or 0, "cc": e.get("cc_up", ""), "cli": e.get("cc_cli", "")},
                      sort_keys=True)


def _relay_docker_running(cn):
    r = run(["docker", "inspect", "-f", "{{.State.Running}}|{{index .Config.Labels \"swg.relay.spec\"}}", cn])
    if r.returncode != 0:
        return False, ""
    out = (r.stdout or "").strip().split("|", 1)
    return (out[0] == "true"), (out[1] if len(out) > 1 else "")


def _relay_supervise_docker(want, quota_pct, res):
    host_dir = SWG_HOST_NODE_DIR + "/relay"
    with contextlib.suppress(OSError):
        os.makedirs(RELAY_DIR_LOCAL, exist_ok=True)
    staged = RELAY_DIR_LOCAL + "/swg-relay"
    with contextlib.suppress(OSError):
        if not os.path.exists(staged) or open(staged, "rb").read() != open(RELAY_BIN, "rb").read():
            shutil.copyfile(RELAY_BIN, staged + ".tmp"); os.chmod(staged + ".tmp", 0o755)
            os.replace(staged + ".tmp", staged)
    cpus = _relay_docker_cpus(quota_pct, len(want))
    for iface in sorted(want):
        e, cn = want[iface], _relay_cname(iface)
        spec = _relay_docker_spec(iface, e, cpus)
        alive, have = _relay_docker_running(cn)
        if alive and have == spec:
            continue
        if _RELAY_ARM["sig"] is not None:
            _relay_disarm(res)
            _RELAY_ARM["sig"] = None; _RELAY_ARM["why"] = "relay restarting to pick up new settings"
            _relay_note("DISARMED", _RELAY_ARM["why"])
        run(["docker", "rm", "-f", cn], timeout=30)
        r = run(["docker", "run", "-d", "--name", cn, "--network", "host", "--restart", "unless-stopped",
                 "--cpus", str(cpus), "--cap-add", "NET_ADMIN", "--cap-add", "NET_RAW",
                 "--security-opt", "no-new-privileges", "--label", "swg.relay.spec=" + spec,
                 *docker_log_opts(),
                 "-v", host_dir + ":" + RELAY_DIR_LOCAL,
                 "--entrypoint", "python3", SWG_TURN_IMAGE, staged,
                 "--port", str(e["port"]), "--bind", e["gw"], "--mark", str(int(e.get("up") or 0)),
                 "--cc", e.get("cc_up", ""),
                 "--cc-cli", e.get("cc_cli", ""), "--mss", str(e.get("mss") or 0),
                 "--status-sock", _relay_sock(iface), "--report", "300"], timeout=60)
        if r.returncode != 0:
            res["errors"].append(("relay %s: docker run failed: %s" % (iface, (r.stderr or r.stdout or "").strip()))[:200])
        else:
            res["changed"] += 1
    for iface in sorted((set(_RELAY) | _relay_existing()) - set(want)):
        if run(["docker", "rm", "-f", _relay_cname(iface)], timeout=30).returncode == 0:
            with contextlib.suppress(OSError):
                os.unlink(_relay_sock(iface))
            if _RELAY_UNITS["at"] is not None:
                _RELAY_UNITS["at"].discard(iface)
            _RELAY.pop(iface, None)
    return set(want)


def _relay_supervise(want, quota_pct, res):
    if NODE_KIND == "docker":
        return _relay_supervise_docker(want, quota_pct, res)
    unit_dir = UNIT_DIR_PERSIST if unit_dir_persists() else UNIT_DIR_RUNTIME
    unit_path, unit_text = os.path.join(unit_dir, "swg-relay@.service"), _relay_unit_text()
    slice_path, slice_text = os.path.join(unit_dir, RELAY_SLICE), _relay_slice_text(quota_pct)
    if want and not _RELAY_CG["path"]:
        _RELAY_CG["at"] = 0.0
    envs = {i: (os.path.join(RELAY_ENV_DIR, i + ".env"), _relay_env_text(i, e)) for i, e in want.items()}
    unit_changed = bool(want) and _relay_write(unit_path, unit_text, dry=True)
    slice_changed = bool(want) and _relay_write(slice_path, slice_text, dry=True)
    reload_needed = unit_changed or slice_changed
    restart = {i for i, (pth, txt) in envs.items() if _relay_write(pth, txt, dry=True)}
    if unit_changed:
        restart |= set(want)
    if restart and _RELAY_ARM["sig"] is not None:
        _relay_disarm(res)
        _RELAY_ARM["sig"] = None
        _RELAY_ARM["why"] = "relay restarting to pick up new settings"
        _relay_note("DISARMED", _RELAY_ARM["why"])
    if reload_needed:
        if slice_changed:
            _relay_write(slice_path, slice_text)
        if unit_changed:
            _relay_write(unit_path, unit_text)
        run(["systemctl", "daemon-reload"])
    for _i, (pth, txt) in sorted(envs.items()):
        _relay_write(pth, txt)
    for iface in sorted(want):
        u = _relay_unit(iface)
        if iface in restart:
            run(["systemctl", "restart", u])
            res["changed"] += 1
        elif run(["systemctl", "is-active", "--quiet", u]).returncode != 0:
            run(["sh", "-c", sc_enable_now(u)])
            res["changed"] += 1
    for iface in sorted((set(_RELAY) | _relay_existing()) - set(want)):
        run(["sh", "-c", "systemctl disable --now " + shlex.quote(_relay_unit(iface)) + " >/dev/null 2>&1"])
        if run(["systemctl", "is-active", "--quiet", _relay_unit(iface)]).returncode != 0:
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(RELAY_ENV_DIR, iface + ".env"))
            _RELAY_UNITS["at"].discard(iface)
            _RELAY.pop(iface, None)
    return set(want)


def reconcile_relay(plan, res, sync_ok=True, links=()):
    plan = plan or {}
    if not _relay_capable()[0]:
        plan = {}
    _RELAY_ARM["booted"] = _RELAY_ARM.get("booted", False)
    legs = plan.get("legs")
    if legs is None:
        legs = [dict(e, iface=i) for i, e in (plan.get("ifaces") or {}).items()]
    want = {}
    for e in legs:
        e = dict(e or {})
        if not e.get("subnet") or not e.get("iface"):
            continue
        e["mark"] = int(e.get("mark") or 0)
        e["up"] = _up_mark(int(e.get("up_table") or 0)) or e["mark"]
        e["iid"] = _relay_iid(e["iface"], e.get("peer", ""))
        if e["iid"] in want:
            res["errors"].append("relay %s: two legs claim the same instance" % e["iid"])
            continue
        want[e["iid"]] = e
    for i, e in list(want.items()):
        e["gw"] = (e.get("gw") or "").strip() or _iface_addr(e["iface"])
        if not e["gw"]:
            res["errors"].append("relay %s: no local address on the interface, cannot bind upstream" % i)
            want.pop(i); continue
        e["port"] = _relay_port(i, e.get("port") or 0)
        e["mss"] = int(e.get("mss") or 0) or _relay_mss(e["gw"], e["up"])
    if not sync_ok:
        want = _RELAY_ARM.get("want") or {}
    else:
        _RELAY_ARM["want"] = want

    if not want:
        if not _RELAY_ARM.get("booted"):
            _RELAY_ARM["booted"] = True
            _relay_disarm()
            _RELAY_ARM["sig"] = None
        if _RELAY_ARM["sig"] is not None:
            _relay_disarm(res)
            _RELAY_ARM["sig"] = None
            _RELAY_ARM["why"] = "off"
        _relay_note("off", "no relay wanted")
        _relay_supervise({}, plan.get("quota_pct") or RELAY_QUOTA_PCT, res)
        return

    if not _RELAY_ARM["booted"]:
        _RELAY_ARM["booted"] = True
        _relay_disarm()
        _RELAY_ARM["sig"] = None
    _relay_supervise(want, plan.get("quota_pct") or RELAY_QUOTA_PCT, res)
    now = time.time()
    cap = int(plan.get("max_conns") or 0)
    entries, why = [], []
    _rules = (run(["ip", "rule", "show"]).stdout or "").splitlines()
    _unroutable = _relay_unroutable([{"iid": i, "subnet": want[i]["subnet"], "mark": want[i]["up"]}
                               for i in sorted(want)], _rules)
    _div = _relay_diverted()
    for iface in sorted(want):
        ok, reason, st = _relay_probe(iface, now, _div)
        if ok and not links:
            ok, reason = False, "no mesh link on this node to relay into"
        if ok and iface in _unroutable:
            ok, reason = False, _unroutable[iface]
        if ok and cap and (st.get("live") or 0) >= cap:
            ok, reason = False, "at connection cap (%d)" % cap
        _RELAY.setdefault(iface, {})["ok"] = ok
        _RELAY[iface]["why"] = reason
        if ok:
            entries.append({"subnet": want[iface]["subnet"], "port": want[iface]["port"],
                            "iface": want[iface]["iface"], "peer": want[iface].get("peer", ""),
                            "mark": want[iface]["mark"], "iid": iface,
                            **({"forward_only": want[iface]["forward_only"]} if want[iface].get("forward_only") else {})})
        elif reason:
            why.append(iface + ": " + reason)

    sig = json.dumps([entries, list(links)], sort_keys=True)
    if not entries:
        if _RELAY_ARM["sig"] is not None or _relay_table_live():
            _relay_disarm(res)
        if want:
            _gp = sorted({want[i]["port"] for i in want})
            _gsig = json.dumps(_gp)
            if _gsig != _RELAY_ARM.get("guard") or not _relay_any_table():
                _gr = run(["nft", "-f", "-"], input_text=_relay_nft([], _gp))
                if _gr.returncode != 0:
                    _RELAY_ARM["guard"] = None
                    res["errors"].append("relay port guard: " + (_gr.stderr or "nft failed").strip()[:160])
                else:
                    _RELAY_ARM["guard"] = _gsig
        else:
            _RELAY_ARM["guard"] = None
        _RELAY_ARM["sig"] = None
        _RELAY_ARM["why"] = "; ".join(why) or "no healthy relay"
        _relay_note("DISARMED", _RELAY_ARM["why"])
        return
    if sig != _RELAY_ARM["sig"] or not _relay_table_live():
        if _relay_arm(entries, res, _rules, sorted({want[i]["port"] for i in want}), links):
            _RELAY_ARM["sig"] = sig
            _RELAY_ARM["guard"] = None
            _RELAY_ARM["since"] = now
            _RELAY_ARM["why"] = "; ".join(why)
            _relay_note("ARMED", ", ".join("%s -> :%d" % (e["iid"], e["port"]) for e in sorted(entries, key=lambda x: x["iid"]))
                                 + ("; excluded " + "; ".join(why) if why else ""))
        else:
            _RELAY_ARM["sig"] = None
            _relay_note("DISARMED", "arming failed")


def _relay_quota_effective():
    if NODE_KIND == "docker":
        tot = 0.0; seen = False
        for iface in sorted(_RELAY):
            r = run(["docker", "inspect", "-f", "{{.HostConfig.NanoCpus}}", _relay_cname(iface)])
            if r.returncode == 0 and (r.stdout or "").strip().isdigit():
                n = int(r.stdout.strip())
                if n > 0: tot += n / 1e9; seen = True
        return int(round(tot * 100)) if seen else None
    cg = _RELAY_CG["path"]
    if not cg and time.time() - _RELAY_CG["at"] >= 60:
        cg = (run(["systemctl", "show", "-p", "ControlGroup", "--value", RELAY_SLICE]).stdout or "").strip()
        _RELAY_CG.update(path=cg, at=time.time())
    if cg and not os.path.isdir("/sys/fs/cgroup" + cg) and not os.path.isdir("/sys/fs/cgroup/cpu" + cg):
        _RELAY_CG.update(path="", at=0.0)
        cg = ""
    if not cg:
        return None
    try:
        with open("/sys/fs/cgroup" + cg + "/cpu.max") as f:
            q, per = f.read().split()[:2]
        return None if q == "max" else int(round(100.0 * int(q) / int(per)))
    except (OSError, ValueError, ZeroDivisionError, IndexError):
        pass
    try:
        with open("/sys/fs/cgroup/cpu" + cg + "/cpu.cfs_quota_us") as f:
            q = int(f.read().strip())
        with open("/sys/fs/cgroup/cpu" + cg + "/cpu.cfs_period_us") as f:
            per = int(f.read().strip())
        return None if q < 0 or per <= 0 else int(round(100.0 * q / per))
    except (OSError, ValueError, ZeroDivisionError):
        return None


def relay_status():
    enforced = _relay_quota_effective()
    cap_ok, cap_why = _relay_capable()
    out = {"armed": _RELAY_ARM["sig"] is not None, "since": _RELAY_ARM["since"],
           "capable": cap_ok, "cannot": cap_why,
           "legs": True,
           "why": _RELAY_ARM["why"], "mark": RELAY_MARK, "table": RELAY_RT,
           "quota_pct": enforced if enforced is not None else RELAY_QUOTA_PCT, "ifaces": {}}
    for iface, st in sorted(_RELAY.items()):
        s = _relay_status(iface, timeout=0.5) or {}
        out["ifaces"][iface] = {"ok": bool(st.get("ok")), "why": st.get("why", ""),
                                "quota_pct": enforced,

                                "cpu_pct": round(st["cpu"], 1) if st.get("cpu") is not None else None,
                                "live": s.get("live"), "peak": s.get("peak"),
                                "accepted": s.get("accepted"), "failed": s.get("failed"),
                                "bytes_down": s.get("down"), "bytes_up": s.get("up")}
    return out


def inet_managed_ifaces(node_cfg):
    managed = set((node_cfg.get("interfaces") or {}).keys())
    with contextlib.suppress(Exception):
        for _wif, _winst in (_wdtt_load() or {}).items():
            managed.add(_wif)
            _wraw = _wdtt_raw(_winst)
            if _wraw:
                managed.add(_wraw[1])
    with contextlib.suppress(Exception):
        managed |= set((_csqtt_load() or {}).keys())
    return sorted(managed)


def reconcile_inet_chain(node_cfg, exit_devs=()):
    T = SWG_INET_TABLE
    managed = inet_managed_ifaces(node_cfg)
    if not managed:
        return
    wan = _detect_wan()
    if not wan:
        return
    if run(["iptables", "-t", "filter", "-nL", SWG_INET_CHAIN]).returncode == 0:
        run(["iptables", "-t", "filter", "-D", "FORWARD", "-j", SWG_INET_CHAIN])
        run(["iptables", "-t", "filter", "-F", SWG_INET_CHAIN])
        run(["iptables", "-t", "filter", "-X", SWG_INET_CHAIN])
    if run(["iptables", "-t", T, "-nL", SWG_INET_CHAIN]).returncode != 0:
        run(["iptables", "-t", T, "-N", SWG_INET_CHAIN])
    if ("-j " + SWG_INET_CHAIN) not in (run(["iptables", "-t", T, "-S", "FORWARD"]).stdout or ""):
        run(["iptables", "-t", T, "-I", "FORWARD", "1", "-j", SWG_INET_CHAIN])
    cur = run(["iptables", "-t", T, "-S", SWG_INET_CHAIN]).stdout.splitlines()
    cursig = set()
    for ln in cur:
        m = re.search(r'--comment "?(swg-inet-(?:up|dn)):([^"\s]+)', ln)
        if not m:
            continue
        mi = re.search(r"-i (\S+)", ln); mo = re.search(r"-o (\S+)", ln)
        cursig.add((m.group(1), m.group(2), mi.group(1) if mi else "", mo.group(1) if mo else ""))
    outs = [(wan, "")] + [(d, "@" + d) for d in sorted({str(x or "").strip() for x in (exit_devs or [])}
                                                       - {wan} - set(managed) - {""})]
    wantsig = set()
    for ifn in managed:
        for dev, tag in outs:
            wantsig.add(("swg-inet-up", ifn + tag, ifn, dev)); wantsig.add(("swg-inet-dn", ifn + tag, dev, ifn))
    if cursig == wantsig:
        return
    run(["iptables", "-t", T, "-F", SWG_INET_CHAIN])
    for ifn in managed:
        for dev, tag in outs:
            run(["iptables", "-t", T, "-A", SWG_INET_CHAIN, "-i", ifn, "-o", dev,
                 "-m", "comment", "--comment", "swg-inet-up:" + ifn + tag])
            run(["iptables", "-t", T, "-A", SWG_INET_CHAIN, "-i", dev, "-o", ifn,
                 "-m", "comment", "--comment", "swg-inet-dn:" + ifn + tag])


def read_inet_bytes():
    r = run(["iptables", "-t", SWG_INET_TABLE, "-S", SWG_INET_CHAIN, "-v"])
    if r.returncode == 1:
        return {"up": 0, "down": 0, "dev": {}}
    if r.returncode != 0 or not r.stdout:
        return None
    up = down = 0
    dev = {}
    for c in re.finditer(r'--comment "?swg-inet-(up|dn):([^"\s]*)"?.* -c \d+ (\d+)', r.stdout):
        by = int(c.group(3))
        k = "up" if c.group(1) == "up" else "down"
        if k == "up":
            up += by
        else:
            down += by
        _, _, d = c.group(2).partition("@")
        if d:
            dev.setdefault(d, {"up": 0, "down": 0})[k] += by
    return {"up": up, "down": down, "dev": dev}


def sample_inet(node_cfg, now):
    if _INET["cum"] is not None and (now - _INET["t"]) < INET_SAMPLE_EVERY_S:
        return _INET["rate"]
    if not inet_managed_ifaces(node_cfg):
        return _INET["rate"]
    cur = read_inet_bytes()
    if cur is None:
        return _INET["rate"]
    prev, pt = _INET["cum"], _INET["t"]
    if prev is not None and now > pt:
        dt = now - pt
        _INET["rate"] = {"up": max(0.0, (cur["up"] - prev["up"]) / dt),
                         "down": max(0.0, (cur["down"] - prev["down"]) / dt)}
        _pd = (prev.get("dev") or {})
        _INET["drate"] = {d: {"up": max(0.0, (v["up"] - _p["up"]) / dt),
                              "down": max(0.0, (v["down"] - _p["down"]) / dt)}
                          for d, v in (cur.get("dev") or {}).items() for _p in [_pd.get(d)] if _p}
    _INET["cum"] = cur; _INET["t"] = now
    return dict(_INET["rate"])


def sample_exit():
