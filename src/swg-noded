def _share_ranges(items):
    import ipaddress
    bounds = sorted({int(n.network_address) for n, _t in items} | {int(n.broadcast_address) + 1 for n, _t in items})
    runs = []
    for lo, nxt in zip(bounds, bounds[1:]):
        cover = [t for n, t in items if int(n.network_address) <= lo and nxt - 1 <= int(n.broadcast_address)]
        if not cover:
            continue
        t = 0 if 0 in cover else max(cover)
        if runs and runs[-1][1] == lo - 1 and runs[-1][2] == t:
            runs[-1][1] = nxt - 1
        else:
            runs.append([lo, nxt - 1, t])
    return [(p, t) for lo, hi, t in runs
            for p in ipaddress.summarize_address_range(ipaddress.IPv4Address(lo), ipaddress.IPv4Address(hi))]


def _share_generation(plan, now, g):
    import ipaddress
    sets, vm, chains, names_c, names_s = [], [], [], [], []
    for n, (_pk, nets, els) in enumerate(plan):
        vm += ["%s : jump p%d_%s" % (x, n, g) for x in nets]
        live = _share_live(els, now)
        hosts = ['"%s" . %s%s' % (i, x[:-3], (" timeout %ds" % t) if t else "") for i, x, t in live if x.endswith("/32")]
        pref = {}
        for i, x, t in live:
            if not x.endswith("/32"):
                pref.setdefault(i, []).append((ipaddress.ip_network(x), t))
        sets.append("  set a%d_%s { type ifname . ipv4_addr; flags timeout;%s }" % (n, g, (" elements = { %s }" % ", ".join(hosts)) if hosts else ""))
        names_s.append("a%d_%s" % (n, g))
        rules = ["iifname . ip saddr @a%d_%s accept" % (n, g)]
        for m, i in enumerate(sorted(pref)):
            sets.append("  set a%dn%d_%s { typeof ip saddr; flags interval, timeout; elements = { %s } }"
                        % (n, m, g, ", ".join("%s%s" % (p, (" timeout %ds" % t) if t else "") for p, t in _share_ranges(pref[i]))))
            names_s.append("a%dn%d_%s" % (n, m, g))
            rules.append('iifname "%s" ip saddr @a%dn%d_%s accept' % (i, n, m, g))
        chains.append("  chain p%d_%s { %s; counter drop; }" % (n, g, "; ".join(rules)))
        names_c.append("p%d_%s" % (n, g))
    lines = sets + ["  map nets_%s { typeof ip daddr : verdict; flags interval; elements = { %s } }" % (g, ", ".join(vm))] + chains
    return {"lines": lines, "map": "nets_" + g, "chains": names_c, "sets": names_s}


def _share_strip(desired, plan):
    drop = {pk: set(nets) for pk, nets, _e in plan}
    out = dict(desired)
    for iface, plist in desired.items():
        if not any(isinstance(q, dict) and q.get("public_key") in drop for q in plist or []):
            continue
        out[iface] = [dict(q, allowed_ips=",".join(m for m in str(q.get("allowed_ips") or "").split(",")
                                                   if _net_prefix(m) not in drop[q["public_key"]]))
                      if isinstance(q, dict) and q.get("public_key") in drop else q for q in plist]
    return out


def _share_drop_table(res):
    r = run(["nft", "delete", "table", "inet", SHARE_NFT_TABLE])
    if r.returncode == 0 or "No such file" in (r.stderr or ""):
        _SHARE["installed"] = False
        res["changed"] += 1
        return
    res["errors"].append("sharing: could not remove %s: %s" % (SHARE_NFT_TABLE, (r.stderr or "").strip()[:120]))


def _share_strip_named(node_cfg, desired, share):
    named = {e["peer"] for e in (share if isinstance(share, list) else []) if isinstance(e, dict) and isinstance(e.get("peer"), str)}
    return _share_strip(desired, [(pk, sorted(nets), []) for pk, nets in _share_by_peer(node_cfg, desired, named).items()])


def reconcile_net_share(node_cfg, desired, share, res, now=None):
    try:
        return _share_converge(node_cfg, desired, share, res, now)
    except Exception as e:
        detail = ("%s: %s" % (type(e).__name__, e))[:160]
        res["errors"].append("sharing: " + detail)
        _SHARE.update(probed=False, declared=False, sig=None, plan=None, names=None,
                      status={"ok": False, "why": "exception", "detail": detail, "peers": []})
        return _share_strip_named(node_cfg, desired, share)


def _share_converge(node_cfg, desired, share, res, now):
    if not _SHARE["probed"]:
        _SHARE["installed"] = run(["nft", "list", "table", "inet", SHARE_NFT_TABLE]).returncode == 0
        _SHARE.update(probed=True, declared=False)
    plan = _share_plan(node_cfg, desired, share) if share else []
    if not plan:
        if _SHARE["installed"]:
            _share_drop_table(res)
        _SHARE.update(sig=None, plan=None, status=None, declared=False, gen="a", names=None)
        return desired
    now = int(time.time()) if now is None else now
    sig = _share_sig(plan, now)
    if not _SHARE["installed"] or sig != _SHARE["sig"]:
        def declare():
            gen = _share_generation(plan, now, "a")
            return _gtable_declare(SHARE_NFT_TABLE, SHARE_HOOK_PRI, _share_nets(plan), [], gen), gen
        swap = None
        if _SHARE["installed"] and _SHARE["declared"] and _SHARE["plan"] and _SHARE["names"]:
            gen = _share_generation(plan, now, "b" if _SHARE["gen"] == "a" else "a")
            swap = (_gtable_swap(SHARE_NFT_TABLE, _share_nets(_SHARE["plan"]), _share_nets(plan), [], gen, _SHARE["names"]), gen)
        r, gen, _swapped = _gtable_load(swap, declare)
        if r.returncode != 0:
            detail = (r.stderr or "").strip()[:160]
            _SHARE.update(probed=False, declared=False, sig=None, plan=None, names=None,
                          status={"ok": False, "why": "nft_failed", "detail": detail, "peers": [x[0] for x in plan]})
            res["errors"].append("sharing: " + detail)
            return _share_strip(desired, plan)
        _SHARE.update(installed=True, declared=True, sig=sig, gen=gen["map"].rsplit("_", 1)[1], names=_gen_names(gen))
        res["changed"] += 1
    _SHARE["plan"] = plan
    _SHARE["status"] = {"ok": True, "peers": [x[0] for x in plan]}
    return desired


def net_share_verify(res, now=None):
    if not _SHARE["plan"] or not _SHARE["installed"]:
        return
    if _gtable_intact(SHARE_NFT_TABLE):
        return
    now = int(time.time()) if now is None else now
    gen = _share_generation(_SHARE["plan"], now, "a")
    r = run(["nft", "-f", "-"], input_text=_gtable_declare(SHARE_NFT_TABLE, SHARE_HOOK_PRI, _share_nets(_SHARE["plan"]), [], gen))
    if r.returncode == 0:
        _SHARE.update(sig=_share_sig(_SHARE["plan"], now), declared=True, gen="a", names=_gen_names(gen))
        res["changed"] += 1
        return
    _SHARE.update(installed=False, declared=False, sig=None, names=None)
    res["errors"].append("sharing: the table was gone and could not be rebuilt: " + (r.stderr or "").strip()[:120])



REACH_NFT_TABLE = "swg_reach"
REACH_HOOK_PRI = "mangle - 4"
_REACH = {"probed": False, "installed": False, "declared": False, "sig": None, "plan": None, "gen": "a", "names": None,
          "status": None, "seen": {}, "loaded": [], "base": {}, "live": {}, "since": 0, "skipped": {}, "stale": None}


def _reach_conf_addr(node_cfg, iface):
    ic = (node_cfg.get("interfaces") or {}).get(iface) or {}
    try:
        with open(ic.get("conf", "")) as f:
            return conf_v4_address(parse_interface_section(f.read()).get("Address"))
    except Exception:
        return ""


def _reach_devices(node_cfg, names):
    import ipaddress
    wd = cq = None
    out = {}
    for name in names:
        addrs = []
        if name in (node_cfg.get("interfaces") or {}):
            a = _reach_conf_addr(node_cfg, name)
            if a and _iface_is_mesh(node_cfg, name, a):
                continue
            addrs = [(name, a)] if a else []
        else:
            wd = _wdtt_load() if wd is None else wd
            cq = _csqtt_load() if cq is None else cq
            if name in wd:
                raw = _wdtt_raw(wd[name])
                addrs = [(name, wd[name].get("wg_addr") or "")] + ([(raw[1], raw[2])] if raw else [])
            elif name in cq:
                addrs = [(name, cq[name].get("tun_addr") or "")]
        devs = []
        for dev, a in addrs:
            with contextlib.suppress(ValueError, TypeError):
                i = ipaddress.ip_interface(str(a).strip())
                if i.version == 4 and i.network.prefixlen < 31:
                    devs.append((dev, i.network, i.ip))
        if devs:
            _REACH["seen"][name] = devs
            out[name] = devs
        elif name in _REACH["seen"]:
            out[name] = _REACH["seen"][name]
    return out


def _reach_skip_reason(node_cfg, name, devices):
    if devices.get(name):
        return "overlap"
    if name in (node_cfg.get("interfaces") or {}):
        a = _reach_conf_addr(node_cfg, name)
        return "mesh" if a and _iface_is_mesh(node_cfg, name, a) else "no_address"
    return "no_address" if name in _wdtt_load() or name in _csqtt_load() else "not_here"


def _reach_names(wire):
    if not isinstance(wire, dict):
        return []
    return sorted({n for n in (wire.get("ifaces") if isinstance(wire.get("ifaces"), list) else [])
                   if isinstance(n, str) and _SHARE_IFNAME_RE.match(n)})


def _reach_plan(node_cfg, wire, devices=None):
    import ipaddress
    if not isinstance(wire, dict):
        return None, {}
    names = _reach_names(wire)
    opened = {n for n in (wire.get("open") if isinstance(wire.get("open"), list) else []) if isinstance(n, str)}
    devices = _reach_devices(node_cfg, names) if devices is None else devices
    ifaces, nets, skipped = [], [], {}
    for name in names:
        kept = False
        for _dev, net, own in devices.get(name) or []:
            if any(net.overlaps(n) for n, _o, _j in nets):
                continue
            nets.append((net, own, len(ifaces)))
            kept = True
        if kept:
            ifaces.append(name)
        else:
            skipped[name] = _reach_skip_reason(node_cfg, name, devices)
    if not ifaces:
        return None, skipped
    def elements(lst):
        out = set()
        for e in (lst if isinstance(lst, list) else []):
            if isinstance(e, list) and len(e) == 2 and isinstance(e[0], str) and _SHARE_IFNAME_RE.match(e[0]):
                pre = _net_prefix(e[1]) if isinstance(e[1], str) else ""
                if pre:
                    out.add((e[0], pre))
        return out
    users = [elements(u) for u in wire["users"]] if isinstance(wire.get("users"), list) else []
    order = {}
    def skey(s):
        if s not in order:
            n = ipaddress.ip_network(s[1])
            order[s] = (s[0], int(n.network_address), n.prefixlen)
        return order[s]
    where = {}
    for z in (wire.get("zones") if isinstance(wire.get("zones"), list) else []):
        if not isinstance(z, dict):
            continue
        src = set()
        for i in (z.get("users") if isinstance(z.get("users"), list) else []):
            if type(i) is int and 0 <= i < len(users):
                src |= users[i]
        key = tuple(sorted(src, key=skey))
        for a in (z.get("to") if isinstance(z.get("to"), list) else []):
            try:
                ip = ipaddress.ip_address(str(a).strip())
            except ValueError:
                continue
            hit = next(((net, own, j) for net, own, j in nets if ip.version == 4 and ip in net), None)
            if hit is None or ip == hit[1]:
                continue
            if ip in where and where[ip] != (key, hit[2]):
                where[ip] = None
            elif ip not in where:
                where[ip] = (key, hit[2])
    sets = sorted({v[0] for v in where.values() if v})
    sidx = {s: k for k, s in enumerate(sets)}
    chains = sorted({(sidx[v[0]], v[1]) for v in where.values() if v})
    elems = []
    for net, own, j in sorted(nets, key=lambda x: x[0]):
        lo, hi = int(net.network_address), int(net.broadcast_address)
        rest = "accept" if ifaces[j] in opened else "jump n%d" % j
        marks = sorted([(int(ip), "jump z%di%d" % (sidx[v[0]], v[1])) for ip, v in where.items()
                        if v and v[1] == j and ip in net] + [(int(own), "accept")]
                       + ([(int(ip), "jump n%d" % j) for ip, v in where.items() if v is None and ip in net] if rest == "accept" else []))
        cur = lo
        for n, verdict in marks:
            if n > cur:
                elems.append((cur, n - 1, rest))
            if verdict:
                elems.append((n, n, verdict))
            cur = n + 1
        if cur <= hi:
            elems.append((cur, hi, rest))
    return {"ifaces": ifaces, "subnets": [str(net) for net, _o, _j in sorted(nets, key=lambda x: x[0])],
            "sets": [list(s) for s in sets], "chains": chains, "map": elems}, skipped


def _reach_counter(name):
    return "c" + name.encode().hex()


def _reach_generation(plan, g):
    import ipaddress
    ip4 = lambda n: str(ipaddress.IPv4Address(n))
    sets, chains, names_s, names_c, zrules = [], [], [], [], {}
    for k, s in enumerate(plan["sets"]):
        hosts = ['"%s" . %s' % (d, p[:-3]) for d, p in s if p.endswith("/32")]
        pref = {}
        for d, p in s:
            if not p.endswith("/32"):
                pref.setdefault(d, []).append(ipaddress.ip_network(p))
        sets.append("  set f%d_%s { type ifname . ipv4_addr;%s }" % (k, g, (" elements = { %s }" % ", ".join(hosts)) if hosts else ""))
        names_s.append("f%d_%s" % (k, g))
        zrules[k] = ["iifname . ip saddr @f%d_%s accept" % (k, g)]
        for m, d in enumerate(sorted(pref)):
            sets.append("  set f%dn%d_%s { typeof ip saddr; flags interval; elements = { %s } }"
                        % (k, m, g, ", ".join(str(x) for x in ipaddress.collapse_addresses(pref[d]))))
            names_s.append("f%dn%d_%s" % (k, m, g))
            zrules[k].append('iifname "%s" ip saddr @f%dn%d_%s accept' % (d, k, m, g))
    for k, j in plan["chains"]:
        chains.append('  chain z%di%d_%s { %s; counter name "%s" drop; }' % (k, j, g, "; ".join(zrules[k]), _reach_counter(plan["ifaces"][j])))
        names_c.append("z%di%d_%s" % (k, j, g))
    for j, name in enumerate(plan["ifaces"]):
        chains.append('  chain n%d_%s { counter name "%s" drop; }' % (j, g, _reach_counter(name)))
        names_c.append("n%d_%s" % (j, g))
    dmap = ("  map dmap_%s { typeof ip daddr : verdict; flags interval; elements = { %s } }"
            % (g, ", ".join("%s : %s" % (ip4(lo) if lo == hi else "%s-%s" % (ip4(lo), ip4(hi)), v if v == "accept" else v + "_" + g)
                            for lo, hi, v in plan["map"])))
    return {"lines": sets + [dmap] + chains, "map": "dmap_" + g, "chains": names_c, "sets": names_s,
            "counters": [_reach_counter(n) for n in plan["ifaces"]]}


_NL_COUNTERS = {"warned": False}


def _nft_cli_only():
    return os.environ.get("SWG_NFT_CLI_ONLY") == "1"


def _nl_refused(why):
    if not _NL_COUNTERS["warned"]:
        _NL_COUNTERS["warned"] = True
        log(LOG_WARNING, "nftables over netlink: %s — reading it with nft instead, nothing kept across passes", why)


def _nl_attrs(buf, off, end):
    while off + 4 <= end:
        alen, atyp = struct.unpack_from("=HH", buf, off)
        if alen < 4:
            return
        yield atyp & 0x3fff, buf[off + 4:off + alen]
        off += (alen + 3) & ~3


def _nft_counters(table, family=1):
    if _nft_cli_only():
        return None
    def attr(t, data):
        a = struct.pack("=HH", 4 + len(data), t) + data
        return a + b"\0" * ((4 - len(a) % 4) % 4)
    body = struct.pack("=BBH", family, 0, 0) + attr(1, table.encode() + b"\0") + attr(3, struct.pack(">I", 1))
    msg = struct.pack("=LHHLL", 16 + len(body), (10 << 8) | 19, 0x1 | 0x300, 1, 0) + body
    out, s = {}, None
    try:
        s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 12)
        s.settimeout(2)
        s.sendto(msg, (0, 0))
        while True:
            d = s.recv(1 << 16)
            off = 0
            while off + 16 <= len(d):
                ln, typ = struct.unpack_from("=LH", d, off)
                if ln < 16:
                    raise ValueError("short netlink message")
                if typ == 3:
                    return out or None
                if typ == 2:
                    err = struct.unpack_from("=i", d, off + 16)[0]
                    if err:
                        _nl_refused("the kernel refused a counter read (%s)" % os.strerror(-err))
                        return None
                    return out or None
                name, pk, by = None, 0, 0
                for t, v in _nl_attrs(d, off + 20, off + ln):
                    if t == 2:
                        name = v.rstrip(b"\0").decode()
                    elif t == 4:
                        for t2, v2 in _nl_attrs(v, 0, len(v)):
                            if t2 == 1:
                                by = struct.unpack(">Q", v2[:8])[0]
                            elif t2 == 2:
                                pk = struct.unpack(">Q", v2[:8])[0]
                if name is not None:
                    out[name] = (pk, by)
                off += (ln + 3) & ~3
    except (OSError, ValueError, struct.error, UnicodeDecodeError) as e:
        _nl_refused("could not read counters (%s)" % e)
        return None
    finally:
        if s is not None:
            s.close()


def _nft_genid():
    if _nft_cli_only():
        return None
    s = None
    try:
        s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 12)
        s.settimeout(2)
        s.sendto(struct.pack("=LHHLL", 20, (10 << 8) | 16, 0x1, 1, 0) + struct.pack("=BBH", 0, 0, 0), (0, 0))
        d = s.recv(1 << 16)
        ln, typ = struct.unpack_from("=LH", d, 0)
        if typ == (10 << 8) | 15 and 20 <= ln <= len(d):
            for t, v in _nl_attrs(d, 20, ln):
                if t == 1 and len(v) >= 4:
                    return struct.unpack(">I", v[:4])[0]
        if typ == 2 and len(d) >= 20 and struct.unpack_from("=i", d, 16)[0]:
            _nl_refused("the kernel refused the generation id (%s)" % os.strerror(-struct.unpack_from("=i", d, 16)[0]))
    except (OSError, ValueError, struct.error) as e:
        _nl_refused("could not read the generation id (%s)" % e)
    finally:
        if s is not None:
            s.close()
    return None


_NFT_KEPT = {}


def _nft_absent(r):
    return r.returncode == 1 and "No such file or directory" in (r.stderr or "")


def _nft_kept(args, structural=True):
    key = " ".join(args)
    gen = _nft_genid()
    hit = _NFT_KEPT.get(key)
    if gen is not None and hit is not None and hit[0] == gen:
        return hit[1]
    r = run(args)
    if gen is not None and ((structural and r.returncode == 0) or _nft_absent(r)):
        _NFT_KEPT[key] = (gen, r)
    else:
        _NFT_KEPT.pop(key, None)
    return r


def _reach_read_counters():
    nl = _nft_counters(REACH_NFT_TABLE)
    if nl is not None:
        items = [(n, pk) for n, (pk, _by) in nl.items()]
    else:
        r = run(["nft", "-j", "list", "counters", "table", "inet", REACH_NFT_TABLE])
        if r.returncode != 0:
            return None
        items = []
        with contextlib.suppress(ValueError, TypeError, AttributeError):
            for ent in json.loads(r.stdout or "{}").get("nftables") or []:
                c = ent.get("counter") if isinstance(ent, dict) else None
                if c:
                    items.append((c.get("name"), c.get("packets")))
    out = {}
    for cname, pk in items:
        m = re.match(r"^c([0-9a-f]{2,30})$", str(cname or ""))
        if not m:
            continue
        with contextlib.suppress(ValueError, UnicodeDecodeError, TypeError):
            name = bytes.fromhex(m.group(1)).decode()
            if _SHARE_IFNAME_RE.match(name):
                out[name] = int(pk or 0)
    return out


def _reach_held():
    if not _REACH["installed"] or not _gtable_intact(REACH_NFT_TABLE):
        return None
    return _reach_read_counters()


def _reach_fold():
    for n, v in _REACH["live"].items():
        _REACH["base"][n] = _REACH["base"].get(n, 0) + v
    _REACH["live"] = {}


def _reach_ok_status():
    names = list(_REACH["loaded"])
    st = {"ok": True, "ifaces": names, "since": _REACH["since"],
          "blocked": {n: _REACH["base"].get(n, 0) + _REACH["live"].get(n, 0) for n in names}}
    if _REACH["skipped"]:
        st["skipped"] = dict(_REACH["skipped"])
    if _REACH["stale"]:
        st.update(_REACH["stale"], ok=False, stale=True)
    return st


def _reach_drop_table(res):
    r = run(["nft", "delete", "table", "inet", REACH_NFT_TABLE])
    if r.returncode == 0 or "No such file" in (r.stderr or ""):
        _REACH["installed"] = False
        res["changed"] += 1
        return
    res["errors"].append("device access: could not remove %s: %s" % (REACH_NFT_TABLE, (r.stderr or "").strip()[:120]))


def reconcile_dev_reach(node_cfg, wire, res):
    try:
        _reach_converge(node_cfg, wire, res)
    except Exception as e:
        detail = ("%s: %s" % (type(e).__name__, e))[:160]
        res["errors"].append("device access: " + detail)
        try:
            held = _reach_held()
        except Exception:
            held = None
        if held is not None and _REACH["loaded"]:
            _REACH["live"] = held
        _REACH.update(sig=None, declared=False, stale={"why": "exception", "detail": detail} if held is not None else None)
        _REACH["status"] = (_reach_ok_status() if held is not None else
                            {"ok": False, "why": "exception", "detail": detail, "ifaces": _reach_names(wire)})


def _reach_converge(node_cfg, wire, res):
    if not _REACH["probed"]:
        _REACH["installed"] = run(["nft", "list", "table", "inet", REACH_NFT_TABLE]).returncode == 0
        _REACH.update(probed=True, declared=False)
    plan, skipped, key = None, {}, None
    if wire:
        names = _reach_names(wire)
        devices = _reach_devices(node_cfg, names)
        key = json.dumps(wire, sort_keys=True, separators=(",", ":")) + repr(sorted(
            (n, [(d, str(net), str(own)) for d, net, own in v]) for n, v in devices.items()))
        if key == _REACH["sig"] and _REACH["plan"] and _REACH["installed"] and not _REACH["stale"]:
            return
        plan, skipped = _reach_plan(node_cfg, wire, devices)
    if not plan:
        if _REACH["installed"]:
            _reach_drop_table(res)
        _REACH.update(sig=None, plan=None, status=None, loaded=[], base={}, live={}, since=0, stale=None,
                      declared=False, gen="a", names=None, skipped=skipped)
        if skipped:
            _REACH["status"] = {"ok": True, "ifaces": [], "since": 0, "blocked": {}, "skipped": dict(skipped)}
        return
    swap = bool(_REACH["installed"] and _REACH["declared"] and _REACH["plan"] and _REACH["names"])
    if swap and plan == _REACH["plan"] and not _REACH["stale"]:
        _REACH.update(sig=key, skipped=skipped)
        _REACH["status"] = _reach_ok_status()
        return
    def declare():
        before = _reach_read_counters() if _REACH["installed"] and _REACH["loaded"] else None
        if before is not None:
            _REACH["live"] = before
        gen = _reach_generation(plan, "a")
        return _gtable_declare(REACH_NFT_TABLE, REACH_HOOK_PRI, plan["subnets"], gen["counters"], gen), gen
    attempt = None
    if swap:
        gen = _reach_generation(plan, "b" if _REACH["gen"] == "a" else "a")
        attempt = (_gtable_swap(REACH_NFT_TABLE, _REACH["plan"]["subnets"], plan["subnets"], gen["counters"], gen, _REACH["names"]), gen)
    r, gen, swapped = _gtable_load(attempt, declare)
    if r.returncode != 0:
        detail = (r.stderr or "").strip()[:160]
        res["errors"].append("device access: " + detail)
        held = _reach_held()
        if held is not None:
            if _REACH["loaded"]:
                _REACH["live"] = held
            _REACH.update(declared=False, stale={"why": "nft_failed", "detail": detail})
            _REACH["status"] = _reach_ok_status()
            return
        _REACH.update(probed=False, declared=False, sig=None, plan=None, names=None, loaded=[], stale=None, skipped=skipped,
                      status={"ok": False, "why": "nft_failed", "detail": detail, "ifaces": plan["ifaces"],
                              **({"skipped": dict(skipped)} if skipped else {})})
        return
    if not swapped:
        _reach_fold()
    old = _REACH["names"]["counters"] if swapped else ()
    _REACH.update(installed=True, declared=True, sig=key, plan=plan, gen=gen["map"].rsplit("_", 1)[1], names=_gen_names(gen),
                  loaded=list(plan["ifaces"]), skipped=skipped, since=_REACH["since"] or int(time.time()), stale=None)
    res["changed"] += 1
    if swapped:
        now_counts = _reach_read_counters()
        if now_counts is not None:
            _REACH["live"] = now_counts
        keep = set(gen["counters"])
        gone = [c for c in old if c not in keep]
        if gone and now_counts is not None:
            _reach_retire(gone, now_counts, res)
    _REACH["status"] = _reach_ok_status()


def _reach_retire(gone, now, res):
    names = {_reach_counter(n): n for n in now}
    for c in gone:
        n = names.get(c)
        if n is None:
            continue
        v = now[n]
        try:
            r = run(["nft", "-f", "-"], input_text=_gtable_drop_counter(REACH_NFT_TABLE, c))
        except Exception as e:
            r = subprocess.CompletedProcess([], 1, "", "%s: %s" % (type(e).__name__, e))
        if r.returncode == 0:
            _REACH["base"][n] = _REACH["base"].get(n, 0) + v
            _REACH["live"].pop(n, None)
        else:
            res["errors"].append("device access: the counter of %s, which left, stays until the next reload: %s"
                                 % (n, (r.stderr or "").strip()[:120]))


def dev_reach_verify(res):
    if not _REACH["plan"] or not _REACH["installed"]:
        return
    live = _reach_read_counters()
    if live is not None:
        _REACH["live"] = live
        if _gtable_intact(REACH_NFT_TABLE):
            _REACH["status"] = _reach_ok_status()
            return
    _reach_fold()
    plan = _REACH["plan"]
    gen = _reach_generation(plan, "a")
    r = run(["nft", "-f", "-"], input_text=_gtable_declare(REACH_NFT_TABLE, REACH_HOOK_PRI, plan["subnets"], gen["counters"], gen))
    if r.returncode == 0:
        _REACH.update(declared=True, gen="a", names=_gen_names(gen))
        res["changed"] += 1
        return
    detail = (r.stderr or "").strip()[:160]
    _REACH.update(installed=False, declared=False, sig=None, stale=None, names=None,
                  status={"ok": False, "why": "nft_failed", "detail": detail, "ifaces": plan["ifaces"]})
    res["errors"].append("device access: the table was gone or emptied and could not be rebuilt: " + detail)


def _cascade_want_sig(fwd, exit_, smart=None, guard=(), nets=(), net_tables=(), arr=(), cut=(), static=()):
    sig = set()
    for e in (guard or []):
        T = str(e["table"]); sig.add(f"T|{T}|prohibit||")
        if e.get("scope") != "rule":
            sig.add(f"R|from|{e['subnet']}|{T}")
    for e in fwd:
        T = str(e["table"]); sig.add(f"R|from|{e['subnet']}|{T}")
        if not e.get("_noroute"):
            sig.add(f"T|{T}|default|{e['via_iface']}|{str(e.get('gw') or '')}")
    for e in list(smart or []) + list(arr or []):
        T = str(e["table"]); sig.add(f"R|fwmark|{int(e['table'])}|{T}")
        if not e.get("_noroute"):
            sig.add(f"T|{T}|default|{e['via_iface']}|{str(e.get('gw') or '')}")
    sig.update(f"R|static|{e['table'] + STATIC_EGRESS_MARK_OFFSET}|{e['table']}" for e in static)
    for e in exit_:
        T = str(e["table"]); sig.add(f"R|to|{e['subnet']}|{T}")
        sig.add(f"R|backstop|{e['subnet']}|{e['via_iface']}|{T}")
        if not e.get("_noroute"):
            sig.add(f"T|{T}|{e['subnet']}|{e['via_iface']}|{str(e.get('gw') or '')}")
    for e in list(fwd) + list(smart or []):
        _u = _up_mark(e["table"])
        if _u:
            sig.add(f"R|upmark|{_u}|{int(e['table'])}")
    for T in net_tables:
        for p, dev in nets:
            sig.add(f"T|{T}|{_net_kernel_dst(p)}|{dev}|")
    for T, p in cut:
        sig.add(f"T|{T}|prohibit:{_net_kernel_dst(p)}||")
    return sig


def _cascade_live_sig(tables):
    sig = set()
    _seen_to = set()
    try:
        for line in run(["ip", "rule", "show"]).stdout.splitlines():
            mp = re.match(r"^\s*(\d+):\s+(.*)$", line)
            if not mp:
                continue
            pri = int(mp.group(1))
            _up = SWG_RT_UP_BASE <= pri <= SWG_RT_UP_MAX
            if not (_up or SWG_RT_BASE <= pri <= SWG_RT_MAX or pri == STATIC_EGRESS_PREF):
                continue
            body = mp.group(2)
            lk = re.search(r"lookup (\S+)", body); T = lk.group(1) if lk else str(pri)
            mto = re.search(r"\bto (\S+)", body); mfrom = re.search(r"\bfrom (\S+)", body)
            mfw = re.search(r"fwmark (0x[0-9a-fA-F]+|\d+)", body)
            mif = re.search(r"\biif (\S+)", body)
            if pri == STATIC_EGRESS_PREF:
                if mfw and T.isdecimal() and SWG_RT_BASE <= int(T) <= SWG_RT_MAX:
                    mark = int(mfw.group(1), 0)
                    if mark == int(T) + STATIC_EGRESS_MARK_OFFSET:
                        sig.add(f"R|static|{mark}|{T}")
                continue
            if mto and mif and re.search(r"\bprohibit\b", body):
                late = "-late" if (pri, mto.group(1)) in _seen_to else ""
                sig.add(f"R|backstop{late}|{mto.group(1)}|{mif.group(1)}|{pri}")
            elif mfw and _up:
                sig.add(f"R|upmark|{int(mfw.group(1), 0)}|{T}")
            elif mfw:
                sig.add(f"R|fwmark|{int(mfw.group(1), 0)}|{T}")
            elif mto:
                _seen_to.add((pri, mto.group(1)))
                sig.add(f"R|to|{mto.group(1)}|{T}")
            elif mfrom and mfrom.group(1) != "all":
                sig.add(f"R|from|{mfrom.group(1)}|{T}")
    except Exception:
        pass
    for T in tables:
        try:
            for line in run(["ip", "route", "show", "table", str(T)]).stdout.splitlines():
                toks = line.split()
                if not toks:
                    continue
                if toks[0] == "prohibit" and len(toks) > 1 and toks[1] != "default":
                    sig.add(f"T|{T}|prohibit:{toks[1]}||")
                    continue
                dev = toks[toks.index("dev") + 1] if "dev" in toks else ""
                via = toks[toks.index("via") + 1] if "via" in toks else ""
                sig.add(f"T|{T}|{toks[0]}|{dev}|{via}")
        except Exception:
            pass
    return sig


def _live_band_prios():
    out = []
    with contextlib.suppress(Exception):
        for line in run(["ip", "rule", "show"]).stdout.splitlines():
            mp = re.match(r"^\s*(\d+):", line)
            if not mp:
                continue
            pri = int(mp.group(1))
            if SWG_RT_BASE <= pri <= SWG_RT_MAX or SWG_RT_UP_BASE <= pri <= SWG_RT_UP_MAX:
                out.append(pri)
    return sorted(set(out))


def _band_tables(prios):
    return [p for p in prios if SWG_RT_BASE <= p <= SWG_RT_MAX]


def _ensure_fwd_iptables(fwd, exit_, default_wan, res, default_egress_ip="", devexit=()):
    link_devs = sorted({e["via_iface"] for e in (fwd + exit_)})
    _dx = list(devexit or [])
    link_devs = sorted(set(link_devs) | {e["dev"] for e in _dx})
    try:
        nat = run(["iptables", "-t", "nat", "-S", "POSTROUTING"]).stdout.splitlines()
    except Exception as e:
        res["errors"].append("cascade nat list: " + str(e)); nat = []
    want_dx = set()
    for e in _dx:
        if e.get("scope") == "static-mesh":
            continue
        S, dev = e["subnet"], e["dev"]
        if not _WANIF_RE.match(str(dev or "")):
            res["errors"].append("devexit snat " + S + ": refused device name " + repr(dev)[:40])
            continue
        tag = "swg-egress:exit:%s@%s" % (S, dev)
        if tag in want_dx:
            continue
        want_dx.add(tag)
        _eg = str(e.get("egress_ip") or "").strip()
        _des = ("SNAT", dev, _eg) if _eg else ("MASQUERADE", dev, "")
        _ch, err = _snat_reconcile_rule(tag, S, _des, nat)
        if err:
            res["errors"].append("devexit snat " + S + ": " + err)
        elif _ch:
            res["changed"] += 1
    for ln in nat:
        mt = re.search(r'--comment "?(swg-egress:exit:[^"\s]+)"?', ln)
        if mt and mt.group(1) not in want_dx and ln.startswith("-A POSTROUTING"):
            run(["sh", "-c", "iptables -t nat " + ln.replace("-A POSTROUTING", "-D POSTROUTING", 1)])
            res["changed"] += 1
    want_snat = set()
    for e in exit_:
        if e.get("personal"):
            continue
        S = e["subnet"]; tag = "swg-fwd-snat:" + S; want_snat.add(tag)
        W = _safe_wan(e.get("wan_iface"), default_wan)
        X = (e.get("egress_ip") or "").strip() or default_egress_ip
        des = ("SNAT", W, X) if X else ("MASQUERADE", W, "")
        _ch, err = _snat_reconcile_rule(tag, S, des, nat)
        if err:
            res["errors"].append("cascade snat " + S + ": " + err)
        elif _ch:
            res["changed"] += 1
    for ln in nat:
        mt = re.search(r'--comment "?(swg-fwd-snat:[^"\s]+)"?', ln)
        if mt and mt.group(1) not in want_snat and ln.startswith("-A POSTROUTING"):
            run(["sh", "-c", "iptables -t nat " + ln.replace("-A POSTROUTING", "-D POSTROUTING", 1)]); res["changed"] += 1
    _ensure_tunnel_acl("swg-fwd-acl:", link_devs, res)
    _ensure_dev_rules("mangle", "FORWARD", "swg-fwd-mss:", link_devs, res,
                      lambda d, direction: (["iptables", "-t", "mangle", "-I", "FORWARD", "-o", d,
                                             "-p", "tcp", "--tcp-flags", "SYN,RST", "SYN",
                                             "-m", "comment", "--comment", "swg-fwd-mss:" + d,
                                             "-j", "TCPMSS", "--clamp-mss-to-pmtu"] if direction == "-o" else None))


FWD_IN_CHAIN = "SWG_FWD_IN"
_FWD_IN = {"n": -1, "ok": False}


def _fwd_in_want(forward_lines):
    docker = any(re.search(r"-j DOCKER-USER(\s|$)", ln) for ln in forward_lines)
    ret = ["-A %s -o docker0 -j RETURN" % FWD_IN_CHAIN, "-A %s -o br-+ -j RETURN" % FWD_IN_CHAIN] if docker else []
    return ret + ["-A %s -j ACCEPT" % FWD_IN_CHAIN]


def _ensure_fwd_in_chain(res):
    if _FWD_IN["n"] == _LOOP["n"]:
        return _FWD_IN["ok"]
    _FWD_IN["n"] = _LOOP["n"]
    cur = run(["iptables", "-S", FWD_IN_CHAIN])
    if cur.returncode != 0:
        if run(["iptables", "-N", FWD_IN_CHAIN]).returncode != 0:
            res["errors"].append("forward accept: could not create chain " + FWD_IN_CHAIN)
            _FWD_IN["ok"] = False
            return False
        have = []
        res["changed"] += 1
    else:
        have = [ln.strip() for ln in (cur.stdout or "").splitlines() if ln.startswith("-A ")]
    want = _fwd_in_want((run(["iptables", "-S", "FORWARD"]).stdout or "").splitlines())
    if have != want:
        run(["iptables", "-F", FWD_IN_CHAIN])
        for ln in want:
            run(["iptables"] + ln.split())
        res["changed"] += 1
    _FWD_IN["ok"] = True
    return True


def _ensure_tunnel_acl(prefix, devs, res):
    tgt = FWD_IN_CHAIN if (devs and _ensure_fwd_in_chain(res)) else "ACCEPT"
    _ensure_dev_rules("filter", "FORWARD", prefix, devs, res,
                      lambda d, direction: ["iptables", "-I", "FORWARD", direction, d, "-m", "comment", "--comment",
                                            prefix + d, "-j", tgt if direction == "-i" else "ACCEPT"])


def _ipt_del_listed(targs, chain, ln):
    want = ln.strip()
    lines = [l.strip() for l in (run(["iptables"] + targs + ["-S", chain]).stdout or "").splitlines() if l.startswith("-A ")]
    if want not in lines:
        return False
    n = str(lines.index(want) + 1)
    if (run(["iptables"] + targs + ["-S", chain, n]).stdout or "").strip() != want:
        return False
    return run(["iptables"] + targs + ["-D", chain, n]).returncode == 0


def _ensure_dev_rules(table, chain, prefix, link_devs, res, mk):
    targs = ["-t", table] if table != "filter" else []
    try:
        lines = run(["iptables"] + targs + ["-S", chain]).stdout.splitlines()
    except Exception as e:
        res["errors"].append(f"cascade {table} list: " + str(e)); return
    want = {prefix + d for d in link_devs}
    for d in link_devs:
        tag = prefix + d
        for direction in ("-i", "-o"):
            add = mk(d, direction)
            if add is None:
                continue
            have = [ln for ln in lines if tag in ln and f"{direction} {d}" in ln]
            tgt = add[add.index("-j") + 1] if "-j" in add else ""
            stale = [ln for ln in have if tgt and not re.search(r"-j %s(\s|$)" % re.escape(tgt), ln)]
            for ln in stale:
                _ipt_del_listed(targs, chain, ln)
                res["changed"] += 1
            if len(have) == len(stale):
                run(add)
                res["changed"] += 1
    for ln in lines:
        mt = re.search(r'--comment "?(' + re.escape(prefix) + r'[^"\s]+)"?', ln)
        if mt and mt.group(1) not in want and ln.startswith("-A " + chain):
            _ipt_del_listed(targs, chain, ln); res["changed"] += 1


