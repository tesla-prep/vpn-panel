def _sh_is_read(cmd):
    c = cmd[:-len(" 2>/dev/null")] if cmd.endswith(" 2>/dev/null") else cmd
    if re.search(r"[;&|<>`$(){}\n]", c):
        return False
    try:
        return _is_read(shlex.split(c))
    except ValueError:
        return False


def _is_read(args):
    if not args:
        return False
    prog, rest = os.path.basename(str(args[0])), [str(a) for a in args[1:]]
    if prog == "sudo":
        while rest and rest[0].startswith("-"):
            rest = rest[1:]
        return _is_read(rest)
    if prog == "sh":
        return len(rest) == 2 and rest[0] == "-c" and _sh_is_read(rest[1])
    if prog in ("docker", "podman") and "nsenter" in rest and "--" in rest:
        inner = rest[rest.index("--") + 1:]
        if len(inner) == 3 and inner[:2] == ["sh", "-c"]:
            return _sh_is_read(inner[2].split("\n", 1)[1] if inner[2].startswith(_HOST_PATH_PREFIX) else inner[2])
        return False
    words = [a for a in rest if not a.startswith("-")]
    if prog == "ip":
        return "-batch" not in rest and len(words) >= 2 and words[1] in ("show", "list", "get")
    if prog in ("wg", "awg"):
        return bool(rest) and rest[0] in ("show", "showconf", "pubkey")
    if prog == "nft":
        return bool(words) and words[0] == "list" and "-f" not in rest
    if prog in ("iptables", "ip6tables"):
        return not any(a in _WRITE_IPTABLES for a in rest) and any(a in _READ_IPTABLES for a in rest)
    if prog in ("iptables-save", "ip6tables-save", "ss", "cat", "ping"):
        return True
    if prog == "systemctl":
        return bool(words or rest) and (words[0] if words else rest[0]) in _READ_SYSTEMCTL or rest[:1] == ["--version"]
    if prog == "ipset":
        return bool(rest) and rest[0] in ("list", "-L", "-list")
    if prog in ("docker", "podman"):
        return bool(words) and words[0] in ("ps", "inspect", "version", "info", "logs", "images")
    return False


def run(args, input_text=None, timeout=20, env=None):
    global _RUN_INFLIGHT, _RUN_SPAWNS
    with _RUN_LOCK:
        _RUN_INFLIGHT += 1
        _RUN_SPAWNS += 1
    try:
        return subprocess.run(args, input=input_text, capture_output=True, text=True, timeout=timeout, env=env)
    except (FileNotFoundError, PermissionError) as e:
        return subprocess.CompletedProcess(args, 127, "", str(e))
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timeout")
    finally:
        with _RUN_LOCK:
            _RUN_INFLIGHT -= 1
        if _PASS and not _is_read(args):
            _PASS.clear()


