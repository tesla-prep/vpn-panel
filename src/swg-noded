def reconcile_lan_block(block, res, owned=None, mesh=()):
    if not _LAN["probed"]:
        _LAN["installed"] = run(["nft", "list", "table", "inet", LAN_NFT_TABLE]).returncode == 0
        _LAN["probed"] = True
    if not block:
        if _LAN["installed"]:
            _lan_drop_table(res)
        _LAN["sig"] = None
        _LAN["status"] = None
        return None
    nets = _node_lan_nets(_own_tunnel_devs() if owned is None else owned)
    devs = sorted(d for d in _CLIENT_DEVS["list"] if re.match(r"^[A-Za-z0-9_.@-]{1,15}$", str(d)))
    if nets is None:
        _LAN["status"] = {"on": True, "ok": False, "why": "addresses_unreadable", "nets": []}
        res["errors"].append("lan block: cannot read this node's addresses — the block is left as it was")
        return _LAN["status"]
    if not nets:
        if _LAN["installed"]:
            _lan_drop_table(res)
        _LAN["sig"] = None
        _LAN["status"] = {"on": True, "ok": True, "nets": []}
        return _LAN["status"]
    mesh = sorted(str(m) for m in (mesh or ()))
    sig = json.dumps([nets, devs, mesh])
    _lt = run(["nft", "list", "table", "inet", LAN_NFT_TABLE]) if _LAN["installed"] else None
    live = bool(_lt) and _lt.returncode == 0 and " drop" in (_lt.stdout or "")
    if not live or sig != _LAN["sig"]:
        r = run(["nft", "-f", "-"], input_text=_lan_ruleset(nets, devs, mesh))
        if r.returncode != 0:
            _LAN["probed"] = False
            _LAN["sig"] = None
            detail = (r.stderr or "").strip()[:160]
