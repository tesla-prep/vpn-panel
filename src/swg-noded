def _nft_load_set(setname, cidrs, replace=True):
    import ipaddress
    try:
        cidrs = [str(n) for n in ipaddress.collapse_addresses(
            ipaddress.ip_network(c.strip(), strict=False) for c in cidrs if c.strip())]
    except Exception:
        pass
    lines = [f"flush set inet {SMART_NFT_TABLE} {setname}"] if replace else []
    for i in range(0, len(cidrs), 2000):
        lines.append(f"add element inet {SMART_NFT_TABLE} {setname} {{ {', '.join(cidrs[i:i + 2000])} }}")
    path = os.path.join(GEO_DIR, "." + setname + ".nft")
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    rc = run(["nft", "-f", path]).returncode
    with contextlib.suppress(OSError):
        os.unlink(path)
    return rc, (_nft_set_count(setname) if rc == 0 else 0)


def _nft_set_count(setname):
    out = (run(["nft", "list", "set", "inet", SMART_NFT_TABLE, setname]).stdout or "")
    m = re.search(r"elements = \{([^}]*)\}", out, re.S)
    return len([x for x in m.group(1).split(",") if x.strip()]) if m else 0


def _smart_geo_refresh(categories, set_counts, res, additive=()):
    if not categories:
        return
    try:
        os.makedirs(GEO_DIR, exist_ok=True)
    except OSError as e:
        res["errors"].append("smart geo dir: " + str(e)); return
    for cat in categories:
        if cat == "all":
            continue
        try:
            sn = _smart_setname(cat)
            path = os.path.join(GEO_DIR, cat + ".txt")
            try:
                st = os.stat(path)
            except OSError:
                continue
            sig = "%d:%d" % (int(st.st_mtime), st.st_size)
            lp = os.path.join(GEO_DIR, "." + cat + ".loaded")
            marker = ""
            with contextlib.suppress(OSError):
                marker = open(lp).read().strip()
            _mp = marker.split("|")
            msig, mhash = (_mp[0], _mp[1]) if len(_mp) >= 2 else ("", marker)
            mcount = int(_mp[2]) if len(_mp) > 2 and _mp[2].isdigit() else 0
            live = set_counts.get(sn, 0)
            is_add = cat in additive
            floor_present = (live >= mcount > 0) if is_add else (live > 0)
            if msig == sig and floor_present:
                continue
            cidrs = [ln.strip() for ln in open(path).read().splitlines() if _CIDR4_RE.match(ln.strip())]
            if not cidrs:
                continue
            h = hashlib.sha256(("\n".join(cidrs)).encode()).hexdigest()
            content_changed = mhash != h
            if content_changed or not floor_present:
                rc, n = _nft_load_set(sn, cidrs, replace=(content_changed or not is_add))
                if rc == 0 and is_add and content_changed:
                    _DNSMASQ_SETS_EMPTIED["v"] = True
                if rc == 0:
                    with contextlib.suppress(OSError):
                        open(lp, "w").write("%s|%s|%d" % (sig, h, n))
                    res["changed"] += 1
                else:
                    res["errors"].append("smart geo load " + cat + " failed")
            else:
                with contextlib.suppress(OSError):
                    open(lp, "w").write("%s|%s|%d" % (sig, h, mcount))
        except Exception as e:
            res["errors"].append("smart geo " + cat + ": " + str(e)[:120])


