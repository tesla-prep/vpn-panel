    return "3.1" if ks & {"RandomTrailers", "DisableCookies"} else ("3.0" if ks else None)


def awg_gen_refusal(iface, awg):
    need = awg_need(awg)
    if not need:
        return ""
    g = awg_gen_report()
    dp = ("AmneziaWG kernel module", g.get("module"))
    for part, have in (dp, ("awg tools", g.get("tools"))):
        if AWG_GEN_ORDER.get(have, -1) < AWG_GEN_ORDER[need]:
            return "not applied: AmneziaWG %s needs %s %s or newer, and this node's is %s" % (need, part, need, have or "missing")
    return ""


def _uapi_lines(iface):
    sock = next((p for p in (os.path.join(d, iface + ".sock") for d in WG_SOCK_DIRS) if os.path.exists(p)), "")
    if not sock:
        return []
    with contextlib.suppress(Exception):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2)
        s.connect(sock)
        s.sendall(b"get=1\n\n")
        data = b""
        while b"errno=" not in data:
            c = s.recv(8192)
            if not c:
                break
            data += c
        s.close()
        return data.decode("utf-8", "replace").splitlines()
    return []


def _uapi_probe(iface):
    port = 0; peers = 0
    for line in _uapi_lines(iface):
        if line.startswith("listen_port="):
            with contextlib.suppress(ValueError):
                port = int(line.split("=", 1)[1] or "0")
        elif line.startswith("public_key="):
            peers += 1
    return port, peers

