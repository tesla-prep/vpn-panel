def smart_status():
    t = _smart_table()
    mode = _SMART_MODE.get("m") or "kernel"
    engine = _SMART_MODE.get("engine") or "none"
    sni_alive = bool(_SNI_PROC.get("p") and _SNI_PROC["p"].poll() is None)
    base = {"mode": mode, "engine": engine, "engine_ok": engine == "none" or sni_alive or bool(_SMART_MODE.get("sni_idle")),
            "sni_alive": sni_alive,
            "arr": 1,
            "caps_keep": 1,
            "allow": 1,
            "p2pi": 1,
            "ports": 1}
    if _P2P["on"]:
        _r = _P2P.get("route") or ""
        _rd = _P2P.get("route_devs") or ([_P2P["route_dev"]] if _P2P.get("route_dev") else [])
        _dn = sorted({d for d in _rd if d in (_P2P.get("route_down") or ()) or _devexit_state(d) != "up"}) if _r else []
        if _dn:
            _r = "down"
        base["p2p"] = {"state": _P2P["state"], "mode": _P2P["mode"], **({"route": _r} if _r else {}),
                       **({"down": _dn} if _dn and _P2P["mode"] == "iface" else {}),
                       **({"detail": _P2P["detail"]} if _P2P["state"] == "error" else {})}
    if _SMART_MODE.get("sni_cap"):
        base["sni_cap"] = _SMART_MODE["sni_cap"]
    if _SMART_MODE.get("lowered"):
        base["lowered"] = _SMART_MODE["lowered"]
    if _SMART_MODE.get("no_lower"):
        base["no_lower"] = _SMART_MODE["no_lower"]
    if t["rc"] != 0:
        return {**base, "active": False, "sets": {}, "rules": 0, "resets": 0,
                **({"block": _block_activity()} if (_MECH_ON["subs"] or _P2P["on"]) else {})}
    rules = len(_SMART_MARK_RE.findall(t["out"]))
    resets = sum(int(x) for x in re.findall(r"meta mark 0x0*9999 counter packets (\d+)", _smart_forward()))
    return {**base, "active": rules > 0,
            "sets": {k: v for k, v in t["counts"].items() if not re.fullmatch(r"catl?_sw_[0-9a-f]{10}|src_[0-9a-f]{12}|lg|ar|cln|catd_\S+|dnsok", k)}, "rules": rules,
            "bytes": dict(t["bytes"]), "resets": resets,
            "block": _block_activity(),
            "blk_domains": _blk_domains_read()}


