def _live_units(prefixes):
    out = set()
    for d in (UNIT_DIR_PERSIST, UNIT_DIR_RUNTIME):
        with contextlib.suppress(OSError):
            out |= {f for f in os.listdir(d) if f.endswith(".service") and f.startswith(prefixes)
                    and not f.endswith("-.service") and "@.service" not in f}
    return out


def _live_plan(srcs, ifaces, rng=False):
    off = log_level() == LOG_OFF
    st, units, kernel, files, ctrs = {}, set(), False, [], []
    if NODE_KIND == "docker":
        sock = next((p for p in ("/var/run/docker.sock", "/run/docker.sock") if os.path.exists(p)), None) \
            if _host_sh_available() else None
        turns = {_turn_inst(t["service"]) for t in _turn_record_raw()} if sock else set()
        servers = {}
        for root in (WDTT_ROOT, CSQTT_ROOT):
            with contextlib.suppress(OSError):
                servers.update({n: os.path.join(root, n, "server.log") for n in os.listdir(root)
                                if os.path.isdir(os.path.join(root, n))})
        relays = set(_RELAY) if sock else set()
        for s in srcs:
            kind, _, name = s.partition(":")
            if kind in _LIVE_PANEL_KINDS:
                continue
            if off:
                st[s] = "off"
            elif kind in ("noded", "sni"):
                st[s] = "ok"
                files.append((os.path.join(LOG_DIR_DOCKER, "swg-noded.log"), live_noded_src, "ours"))
            elif kind == "dns":
                st[s] = "ok"
                files.append((DNSMASQ_LOG, "dns", "syslog"))
            elif kind == "turn":
                fs = [(p, "turn:" + n, "plain") for n, p in sorted(servers.items()) if name in ("*", n)]
                cs = [(_turn_cname("vk-turn-proxy-" + n), "turn:" + n) for n in sorted(turns) if name in ("*", n)]
                files += fs
                ctrs += cs
                st[s] = "ok" if fs or cs else "absent"
            elif kind == "relay":
                cs = [(_relay_cname(n), "relay:" + n) for n in sorted(relays) if name in ("*", n)]
                ctrs += cs
                st[s] = "ok" if cs else "absent"
            elif kind == "mesh":
                st[s] = "unavailable"
            elif kind in ("iface", "kernel", "p2p"):
                st[s] = "unavailable"
            else:
                st[s] = "absent"
        files = list({f[0]: f for f in files}.values())
        return {"files": files, "ctrs": list({c[0]: c for c in ctrs}.values()), "sock": sock}, st
    for s in srcs:
        kind, _, name = s.partition(":")
        if kind in _LIVE_PANEL_KINDS:
            continue
        if kind in ("noded", "sni", "dns"):
            st[s] = "off" if off else "ok"
            units.add("swg-noded.service")
        elif kind == "relay":
            us = {"swg-relay@%s.service" % n for n in _RELAY if name in ("*", n)}
            st[s] = "off" if off and us else "ok" if us else "absent"
            units |= us
        elif kind == "turn":
            us = {u for u in _live_units(("vk-turn-proxy-", "swg-wdtt-", "swg-csqtt-"))
                  if name == "*" or u in ("vk-turn-proxy-%s.service" % name, "swg-wdtt-%s.service" % name,
                                          "swg-csqtt-%s.service" % name)}
            st[s] = "off" if off and us else "ok" if us else "absent"
            units |= us
        elif kind in ("iface", "mesh"):
            mesh = kind == "mesh"
            ns = [n for n in ifaces if n.startswith(LIVE_MESH_PRE) == mesh and name in ("*", n)]
            st[s] = "ok" if ns else "absent"
            units |= {"%s@%s.service" % (q, n) for n in ns for q in ("wg-quick", "awg-quick")}
        elif kind == "kernel":
            st[s], kernel = "ok", True
        elif kind == "p2p":
            st[s], kernel = ("off", kernel) if off else ("ok", True)
        else:
            st[s] = "absent"
    base = journal_cmd().split()
    us = sorted(units)
    if rng:
        return ({"journal": (lambda s, u, pm: range_journal_argv(base, us, kernel, s, u, pm)) if us or kernel else None},
                st)
    return ({"journal": (lambda cur, n: live_journal_argv(base, us, kernel, cur, n)) if us or kernel else None}, st)


def _logs_post(rq, extra):
    body = {"id": rq["id"], "key": rq["key"], "now": round(time.time(), 3), **extra}
    code, _r = post_json(rq["url"], rq["panel"]["token"], body, rq["panel"], timeout=15, gz=True)
    return "ok" if code == 200 else "gone" if code in (403, 404, 410) else "order" if code == 409 else "fail"


def _logs_entries(reqs, most, need=()):
    want = {}
    for r in reqs if isinstance(reqs, list) else []:
        if (isinstance(r, dict) and isinstance(r.get("id"), str) and LIVE_ID_RE.match(r["id"]) and len(want) < most
                and isinstance(r.get("key"), str) and len(r["key"]) <= 128 and isinstance(r.get("src"), list)
                and all(isinstance(r.get(k), list) for k in need)):
            want[r["id"]] = dict(r, src=[x for x in r["src"][:64] if isinstance(x, str) and LIVE_SRC_RE.match(x)])
    return want


def _live_chunk(pend):
    n, size = 0, 0
    for ln in pend:
        t = ln[3]
        size += 48 + len(ln[1]) + (len(t) + 5 * (len(t) - len(t.translate(_LIVE_CTL))) if t.isascii() else 6 * len(t))
        if n and size > LIVE_POST_BYTES:
            break
        n += 1
    return n


def _live_skipped(lines):
    return sum(int(x[3]) if x[1] == "!skip" and str(x[3]).isdigit() else 1 for x in lines)


def _live_run(rq, ifaces):
    rd = None
    try:
        plan, st = _live_plan(rq["src"], ifaces)
        rd = LiveReader([s for s in rq["src"] if st.get(s) == "ok"], cur=rq["cur"], cap=rq["cap"], **plan)
        pend, said, last, t0 = [], False, 0.0, time.monotonic()
        while not rq["stop"].is_set() and time.monotonic() < rq["exp"]:
            pend += rd.poll(0.5)
            if len(pend) > LIVE_PEND_MAX:
                cut = len(pend) - LIVE_PEND_MAX + 1
                pend = [[pend[cut - 1][0], "!skip", 4, str(_live_skipped(pend[:cut]))]] + pend[cut:]
            now = time.monotonic()
            if (pend or not said) and now - t0 >= LIVE_BACKFILL_S and now - last >= rq["iv"]:
                skip = [ln for ln in pend if ln[1] == "!skip"]
                if len(skip) > 1:
                    pend = [ln for ln in pend if ln[1] != "!skip"] + [[skip[-1][0], "!skip", 4, str(_live_skipped(skip))]]
                n = _live_chunk(pend)
                r = _logs_post(rq, {"lines": pend[:n], **({"cur": rd.cursor()} if n == len(pend) else {}),
                                    **({} if said else {"st": st})})
                last = now
                if r == "gone":
                    break
                if r == "ok":
                    pend, said = pend[n:], True
                    if pend:
                        last = 0.0
    except Exception as e:
        log(LOG_WARNING, "logs: the live reader for %s stopped: %s", rq["id"], e)
    finally:
        if rd is not None:
            rd.close()
        with _LIVE_LOCK:
            if _LIVE.get(rq["id"]) is rq:
                _LIVE.pop(rq["id"], None)


def live_logs_take(reqs, sync_url, panel, node_cfg):
    want = _logs_entries(reqs, LIVE_MAX)
    now = time.monotonic()
    url = sync_url.rsplit("/api/node/sync", 1)[0] + "/api/node/logs"
    with _LIVE_LOCK:
        for rid in [k for k in _LIVE if k not in want]:
            _LIVE.pop(rid)["stop"].set()
        for rid, r in want.items():
            try:
                lease = min(60, max(1, int(r.get("lease") or 15)))
                iv = min(30, max(1, int(r.get("iv") or 1)))
                cap = min(200, max(1, int(r.get("cap") or 200)))
            except (TypeError, ValueError):
                continue
            rq = _LIVE.get(rid)
            if rq is None:
                if not r["src"]:
                    continue
                rq = _LIVE[rid] = {"id": rid, "stop": threading.Event(), "src": r["src"], "iv": iv, "cap": cap,
                                   "key": r["key"], "cur": r.get("cur") if isinstance(r.get("cur"), dict) else None}
                rq.update(exp=now + lease + LIVE_GRACE, url=url, panel=panel)
                threading.Thread(target=_live_run, args=(rq, list((node_cfg.get("interfaces") or {}).keys())),
                                 daemon=True, name="swg-logs-" + rid).start()
            rq.update(exp=now + lease + LIVE_GRACE, url=url, panel=panel, iv=iv)


RANGE_MAX, RANGE_HB_S, RANGE_RUN_S = 2, 10, 900
_RANGE = {}
_RANGE_DONE = {}
_RANGE_LOCK = threading.Lock()


def _range_send(rq, extra, until):
    while not rq["stop"].is_set() and time.monotonic() < until:
        r = _logs_post(rq, extra)
        if r != "fail":
            return r
        rq["stop"].wait(rq["iv"])
    return "gone"


def _range_parts(ring):
    for seg in ring.parts():
        while seg:
            n = min(_live_chunk(seg), RANGE_PART_LINES)
            yield seg[:n]
            seg = seg[n:]


def _range_run(rq, ifaces):
    until = time.monotonic() + RANGE_RUN_S
    with contextlib.suppress(Exception):
        os.setpriority(os.PRIO_PROCESS, threading.get_native_id(), 19)
    try:
        plan, st = _live_plan(rq["src"], ifaces, rng=True)
        want = [s for s in rq["src"] if st.get(s) == "ok"]
        if _range_send(rq, {"st": st}, until) != "ok":
            return
        ring, read, reading = RangeRing(rq["share"]), [0], threading.Event()

        def beat():
            hb = min(40, max(RANGE_HB_S, rq["iv"]))
            while not reading.wait(hb) and not rq["stop"].is_set():
                if _logs_post(rq, {"read": read[0]}) == "gone":
                    rq["stop"].set()
        threading.Thread(target=beat, daemon=True, name="swg-range-beat-" + rq["id"]).start()
        try:
            since, end = rq["since"] + rq["off"], rq["until"] + rq["off"]
            n = range_read(ring, want, rq["lv"], since, end, rq["stop"], tick=lambda k: read.__setitem__(0, k),
                           **plan) if want else 0
        finally:
            reading.set()
        done = {"read": n, "cut": ring.cut, "cut_t": ring.cut_t}
        for _try in range(3):
            if rq["stop"].is_set():
                return
            seq, prev, r = 0, None, "ok"
            for part in _range_parts(ring):
                if prev is not None:
                    r = _range_send(rq, {"seq": seq, "lines": prev}, until)
                    if r != "ok":
                        break
                    seq += 1
                prev = part
            if r == "ok":
                r = _range_send(rq, {"seq": seq, "lines": prev or [], "done": done}, until)
            if r != "order":
                return
    except Exception as e:
        log(LOG_WARNING, "logs: the range read for %s stopped: %s", rq["id"], e)
    finally:
        with _RANGE_LOCK:
            if _RANGE.get(rq["id"]) is rq:
                _RANGE.pop(rq["id"], None)
            _RANGE_DONE[rq["id"]] = time.monotonic()


def range_logs_take(reqs, sync_url, panel, node_cfg):
    want = _logs_entries(reqs, RANGE_MAX, ("lv",))
    now = time.monotonic()
    url = sync_url.rsplit("/api/node/sync", 1)[0] + "/api/node/logs"
    with _RANGE_LOCK:
        for rid in [k for k in _RANGE if k not in want]:
            _RANGE.pop(rid)["stop"].set()
        for rid in [k for k, t in _RANGE_DONE.items() if now - t > RANGE_RUN_S]:
            del _RANGE_DONE[rid]
        for rid, r in want.items():
            if rid in _RANGE or rid in _RANGE_DONE:
                continue
            try:
                since, end, share = int(r["since"]), int(r["until"]), max(4096, min(64 << 20, int(r["share"])))
                iv, off = min(30, max(1, int(r.get("iv") or 1))), time.time() - float(r["now"])
            except (KeyError, TypeError, ValueError, OverflowError):
                continue
            if not r["src"] or not since < end or not abs(off) < 1e9:
                continue
            rq = _RANGE[rid] = {"id": rid, "stop": threading.Event(), "key": r["key"], "src": r["src"],
                                "lv": [k for k in r["lv"] if k in RANGE_LEVELS], "since": since, "until": end,
                                "share": share, "iv": iv, "off": int(round(off)) if abs(off) >= 2 else 0, "url": url,
                                "panel": panel}
            threading.Thread(target=_range_run, args=(rq, list((node_cfg.get("interfaces") or {}).keys())),
                             daemon=True, name="swg-range-" + rid).start()

def _apply_routing_reset(reset_val, res, learned_val=None):
    full = _apply_full_reset(reset_val, res)
    learned = False if full else _apply_learned_reset(learned_val, res)
    return full or learned


def _apply_learned_reset(learned_val, res):
    try:
        rv = str(int(learned_val or 0))
    except Exception:
        rv = "0"
    stamp = os.path.join(GEO_DIR, ".routing-reset-learned")
    cur = ""
    with contextlib.suppress(Exception):
        cur = open(stamp).read().strip()
    if rv == cur or rv == "0":
        return False
    _learned_reset_now(res, "#%s" % rv)
    with contextlib.suppress(OSError):
        open(stamp, "w").write(rv)
    return True


def _learned_reset_now(res, why):
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
    for fn in (".smart-sig", ".xtstring-sig", ".catcount-sig"):
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(GEO_DIR, fn))
    for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
        if fn.endswith(".loaded"):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, fn))
    run(["nft", "delete", "table", "inet", SMART_NFT_TABLE])
    _SMART_TABLE.update(n=-1, gen=None)
    p = _SNI_PROC.get("p")
    if p and p.poll() is None:
        with contextlib.suppress(Exception): p.terminate()
    _SNI_PROC["p"] = None
    res["changed"] += 1
    log(LOG_INFO, "routing: LEARNED RESET %s — flushed learned nft sets (lists kept); re-learning" % why)
    return True


_ENGINE_STAMP = os.path.join(GEO_DIR, ".host-engine")


def _engine_change_reset(host_engine, res, already=False):
    prev = ""
    with contextlib.suppress(OSError):
        prev = open(_ENGINE_STAMP).read().strip()
    if prev == host_engine:
        return False
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
        with open(_ENGINE_STAMP + ".tmp", "w") as f:
            f.write(host_engine)
        os.replace(_ENGINE_STAMP + ".tmp", _ENGINE_STAMP)
    if not prev or already:
        return False
    _learned_reset_now(res, "(engine %s → %s)" % (prev, host_engine))
    return True


def _apply_full_reset(reset_val, res):
    try:
        rv = str(int(reset_val or 0))
    except Exception:
        rv = "0"
    stamp = os.path.join(GEO_DIR, ".routing-reset")
    cur = ""
    with contextlib.suppress(Exception):
        cur = open(stamp).read().strip()
    if rv == cur or rv == "0":
        return False
    with contextlib.suppress(OSError):
        os.makedirs(GEO_DIR, exist_ok=True)
    for fn in (os.listdir(GEO_DIR) if os.path.isdir(GEO_DIR) else []):
        if fn.endswith((".txt", ".doms", ".attempt", ".loaded")) or fn in (
                ".smart-sig", ".xtstring-sig", ".catcount-sig", ".geo-epoch", ".doh.sig", ".automerge-migrated"):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(GEO_DIR, fn))
    run(["nft", "delete", "table", "inet", SMART_NFT_TABLE])
    _SMART_TABLE.update(n=-1, gen=None)
    p = _SNI_PROC.get("p")
    if p and p.poll() is None:
        with contextlib.suppress(Exception): p.terminate()
    _SNI_PROC["p"] = None
    with contextlib.suppress(OSError):
        open(stamp, "w").write(rv)
    res["changed"] += 1
    log(LOG_INFO, "routing: FULL RESET #%s — wiped sets/chains/ipsets/list-cache; rebuilding + re-pulling" % rv)
    return True


