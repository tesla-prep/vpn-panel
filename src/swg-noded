def reconcile_ifaces(node_cfg, desired_ifaces, agent, sudo):
    res = {"changed": 0, "errors": []}
    for iface, want in (desired_ifaces or {}).items():
        if iface not in (node_cfg.get("interfaces") or {}):
            continue
        payload = {"op": "set-iface", "iface": iface}
        port = want.get("listen_port")
        if port:
            cur = current_listen_port(node_cfg, iface)
            if cur is not None and int(cur) != int(port):
                payload["listen_port"] = int(port)
        mtu = want.get("mtu")
        if mtu:
            cur_mtu = iface_mtu(iface, parse_interface_section(_conf_text(node_cfg, iface)))
            if cur_mtu is None or int(cur_mtu) != int(mtu):
                payload["mtu"] = int(mtu)
        awg = want.get("awg_params")
        refused = ""
        if isinstance(awg, dict) and awg:
            cur_awg = current_awg(node_cfg, iface) or {}
            want_s = {k: str(v) for k, v in awg.items()}
            if (any(str(cur_awg.get(k)) != v for k, v in want_s.items())
                    or (want.get("awg_params_exact") and any(k in cur_awg and k not in want_s for k in AWG_KEYS))):
                refused = awg_gen_refusal(iface, awg)
                if not refused:
                    payload["awg_params"] = awg
                    if want.get("awg_params_exact"):
                        payload["awg_params_exact"] = True
        akey = "setiface|" + iface
        if refused:
            res["errors"].append(f"set-iface {iface}: {refused}")
        if len(payload) <= 2:
            _op_ok(akey)
            continue
        _op_cfg_changed(akey, json.dumps(payload, sort_keys=True))
        if not _op_ready(akey):
            _held = (_OP_BACKOFF.get(akey) or [0, 0])[1] == float("inf")
            res["errors"].append(f"set-iface {iface}: {_op_err(akey) or 'repeated failure'}" + ("" if _held else " (retrying)"))
            continue
        r = run_agent(agent, sudo, payload)
        if r.get("ok"):
            _op_ok(akey); res["changed"] += 1
        else:
            _op_fail(akey, err=r.get("error")); res["errors"].append(f"set-iface {iface}: {r.get('error')}")
            if r.get("code") == "awg_gen_refused":
                _OP_BACKOFF[akey][1] = float("inf")
    return res


_EP_CONF = {}


def _conf_peer_endpoints(text):
    out, pk, ep, in_peer = {}, None, "", False
    for line in (text or "").splitlines():
        st = line.strip()
        if st.startswith("["):
            if in_peer and pk:
                out[pk] = ep
            in_peer, pk, ep = st.lower() == "[peer]", None, ""
            continue
        if not in_peer or st.startswith("#") or "=" not in st:
            continue
        k, v = st.split("=", 1)
        k = k.strip().lower()
        if k == "publickey":
            pk = v.strip()
        elif k == "endpoint":
            ep = v.strip()
    if in_peer and pk:
        out[pk] = ep
    return out


def tag_nat_hooks(node_cfg, agent, sudo):
    moved = 0
    for iface in (node_cfg.get("interfaces") or {}):
        text = _conf_text(node_cfg, iface)
        if not text or re.search(r"(?m)^\s*#swg:onboarded\b", text):
            continue
        if not re.search(r"(?im)^\s*Post(?:Up|Down)\s*=.*\bPOSTROUTING -s \S+ -o \S+ -j MASQUERADE", text):
            continue
        r = run_agent(agent, sudo, {"op": "tag-nat-hooks", "iface": iface})
        if not r.get("ok"):
            log(LOG_ERR, "nat: could not give %s its own MASQUERADE: %s", iface, r.get("error"))
            continue
        d = r.get("data") or {}
        if d.get("changed"):
            moved += 1
            log(LOG_INFO, "nat: %s has its own MASQUERADE now (swg-nat:%s) — in its hooks, and %s", iface, iface, "live" if d.get("live") else "from its next bring-up")
    return moved


_NAT_CONF_DIRS = ("/etc/amnezia/amneziawg", "/etc/wireguard")
_NAT_TAG_RE = re.compile(r'--comment "?swg-nat:([^"\s]+)"?(?:\s|$)')


def reap_orphan_nat(node_cfg):
    try:
        out = run(["iptables", "-t", "nat", "-S", "POSTROUTING"]).stdout or ""
    except Exception:
        return []
    managed = set((node_cfg.get("interfaces") or {}).keys())
    gone = []
    for ln in out.splitlines():
        m = _NAT_TAG_RE.search(ln)
        if not ln.startswith("-A POSTROUTING ") or not m:
            continue
        name = m.group(1)
        if name in managed or len(name) > 15 or "/" in name:
            continue
        if any(os.path.exists(os.path.join(d, name + ".conf")) for d in _NAT_CONF_DIRS):
            continue
        r = run(["ip", "link", "show", name])
        if r.returncode == 0 or "does not exist" not in (r.stderr or ""):
            continue
        try:
            args = shlex.split(ln)
        except ValueError:
            continue
        if run(["iptables", "-t", "nat", "-D"] + args[1:]).returncode == 0:
            gone.append(name)
    if gone:
        log(LOG_INFO, "nat: removed the rule of interface(s) that no longer exist here: %s" % ", ".join(sorted(set(gone))))
    return gone


def reconcile(node_cfg, desired_by_iface, agent, sudo, remove_by_iface=None):
    res = {"added": 0, "removed": 0, "errors": []}
    remove_by_iface = remove_by_iface or {}
    EP_FILE = os.path.join(STATE_DIR, "mesh-eps.json")
    applied_ep = {}
    with contextlib.suppress(Exception):
        applied_ep = json.load(open(EP_FILE))
    ep_dirty = False
    stopped = _load_stopped_ifaces()
    for iface, ic in (node_cfg.get("interfaces") or {}).items():
        desired = {p["public_key"]: p for p in (desired_by_iface.get(iface) or [])}
        dump = _iface_dump(node_cfg, iface)
        current = current_pubkeys(node_cfg, iface, dump)
        if current is None:
            if iface not in stopped:
                res["errors"].append(f"{iface}: cannot read interface")
            continue
        live_allowed = current_allowed(node_cfg, iface, dump) or {}
        live_ep = current_endpoints(node_cfg, iface, dump) or {}
        live_hs = current_handshakes(node_cfg, iface, dump) or {}
        live_psk = current_psks(node_cfg, iface, dump) or {}
        for pk in remove_by_iface.get(iface, []):
            if pk in current and pk not in desired:
                r = run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                if r.get("ok"):
                    res["removed"] += 1; current.discard(pk)
                else:
                    res["errors"].append(f"retire {pk[:8]}: {r.get('error')}")
        if not _add_only(iface, ic):
            for pk in current - set(desired):
                r = run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                if r.get("ok"):
                    res["removed"] += 1; current.discard(pk)
                    applied_ep.pop(iface + "|" + pk, None); ep_dirty = True
                else:
                    res["errors"].append(f"remove {pk[:8]}: {r.get('error')}")
        for pk, p in desired.items():
            if pk in current:
                if live_hs.get(pk) and (time.time() - live_hs[pk]) <= MESH_STALE_S:
                    _op_ok("stale|" + iface + "|" + pk)
                want_a = _norm_allowed(p.get("allowed_ips", ""))
                if want_a and live_allowed.get(pk) is not None and live_allowed[pk] != want_a:
                    r = run_agent(agent, sudo, {"op": "set-peer-allowed", "iface": iface,
                                                "public_key": pk, "allowed_ips": p.get("allowed_ips", "")})
                    if r.get("ok"):
                        res["added"] += 1
                    else:
                        res["errors"].append(f"allowed {pk[:8]}: {r.get('error')}")
                if "preshared_key" in p and pk in live_psk:
                    want_psk = _norm_psk(p.get("preshared_key"))
                    if want_psk != live_psk[pk]:
                        kk = "psk|" + iface + "|" + pk
                        _op_cfg_changed(kk, hashlib.sha256(want_psk.encode()).hexdigest()[:12])
                        if not _op_ready(kk):
                            res["errors"].append(f"psk {pk[:8]}: retrying later (repeated failure)")
                        else:
                            run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                            r = run_agent(agent, sudo, {"op": "add-peer", "iface": iface, "public_key": pk,
                                                        "allowed_ips": p.get("allowed_ips", ""),
                                                        "preshared_key": p.get("preshared_key", "none"),
                                                        "endpoint": p.get("endpoint"),
                                                        "persistent_keepalive": p.get("persistent_keepalive"),
                                                        "name": p.get("name", "")})
                            if r.get("ok"):
                                _op_fail(kk, err="applied; awaiting confirmation")
                                res["added"] += 1
                                log(LOG_INFO, "peer %s on %s: preshared key re-applied from the panel", pk[:8], iface)
                            else:
                                _op_fail(kk, err=r.get("error"))
                                res["errors"].append(f"psk {pk[:8]}: {r.get('error')}")
                ek = iface + "|" + pk; want_ep = p.get("endpoint")
                if want_ep and applied_ep.get(ek) != want_ep:
                    if live_ep.get(pk) == want_ep:
                        applied_ep[ek] = want_ep; ep_dirty = True
                    elif not _op_ready("redial|" + ek):
                        res["errors"].append(f"endpoint {pk[:8]}: retrying later (repeated failure)")
                    else:
                        _mkadd = lambda: {"op": "add-peer", "iface": iface, "public_key": pk,
                                          "allowed_ips": p.get("allowed_ips", ""),
                                          "preshared_key": p.get("preshared_key", "none"),
                                          "endpoint": want_ep,
                                          "persistent_keepalive": p.get("persistent_keepalive"),
                                          "name": p.get("name", "")}
                        r = run_agent(agent, sudo, _mkadd())
                        if not r.get("ok") and r.get("code") == "peer_exists":
                            run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                            r = run_agent(agent, sudo, _mkadd())
                        if r.get("ok"):
                            _op_ok("redial|" + ek); applied_ep[ek] = want_ep; ep_dirty = True; res["added"] += 1
                        else:
                            _op_fail("redial|" + ek); res["errors"].append(f"endpoint {pk[:8]}: {r.get('error')}")
                elif want_ep and live_hs.get(pk) and (time.time() - live_hs[pk]) > MESH_STALE_S and _op_ready("stale|" + ek):
                    run_agent(agent, sudo, {"op": "remove-peer", "iface": iface, "public_key": pk})
                    r = run_agent(agent, sudo, {"op": "add-peer", "iface": iface, "public_key": pk,
                                                "allowed_ips": p.get("allowed_ips", ""),
                                                "preshared_key": p.get("preshared_key", "none"),
                                                "endpoint": want_ep,
                                                "persistent_keepalive": p.get("persistent_keepalive"),
                                                "name": p.get("name", "")})
                    if r.get("ok"):
                        _op_fail("stale|" + ek)
                        applied_ep[ek] = want_ep; ep_dirty = True; res["added"] += 1
                    else:
                        _op_fail("stale|" + ek); res["errors"].append(f"stale-redial {pk[:8]}: {r.get('error')}")
                if want_ep and _EP_CONF.get(ek) != want_ep:
                    conf_ep = _conf_peer_endpoints(_conf_text(node_cfg, iface)).get(pk)
                    if conf_ep is not None and conf_ep != want_ep:
                        r = run_agent(agent, sudo, {"op": "persist-peer-endpoint", "iface": iface, "public_key": pk,
                                                    "endpoint": want_ep})
                        if r.get("ok"):
                            log(LOG_INFO, "peer %s on %s: the .conf now names its endpoint %s (it named %s)", pk[:8], iface, want_ep, conf_ep or "none")
                        else:
                            log(LOG_ERR, "peer %s on %s: could not write its endpoint into the .conf: %s", pk[:8], iface, r.get("error"))
                    _EP_CONF[ek] = want_ep
                continue
            akey = "add|" + iface + "|" + pk
            _op_cfg_changed(akey, (p.get("allowed_ips", ""), str(p.get("endpoint") or ""), p.get("preshared_key", "none")))
            if not _op_ready(akey):
                res["errors"].append(f"add {pk[:8]}: retrying later (repeated failure)")
                continue
            r = run_agent(agent, sudo, {
                "op": "add-peer", "iface": iface, "public_key": pk,
                "allowed_ips": p.get("allowed_ips", ""),
                "preshared_key": p.get("preshared_key", "none"),
                "endpoint": p.get("endpoint"),
                "persistent_keepalive": p.get("persistent_keepalive"),
                "name": p.get("name", "")})
            if r.get("ok"):
                _op_ok(akey); res["added"] += 1
                if p.get("endpoint"):
                    applied_ep[iface + "|" + pk] = p.get("endpoint"); ep_dirty = True
                    _EP_CONF[iface + "|" + pk] = p.get("endpoint")
            else:
                _op_fail(akey); res["errors"].append(f"add {pk[:8]}: {r.get('error')}")
    _want_ep = {i + "|" + p["public_key"] for i in (node_cfg.get("interfaces") or {})
                for p in (desired_by_iface.get(i) or []) if p.get("endpoint") and p.get("public_key")}
    for _k in [k for k in applied_ep if k not in _want_ep]:
        applied_ep.pop(_k, None); ep_dirty = True
    if ep_dirty:
        with contextlib.suppress(Exception):
            with open(EP_FILE + ".tmp", "w") as f:
                json.dump(applied_ep, f)
            os.replace(EP_FILE + ".tmp", EP_FILE)
    return res


def _strip_learned_endpoints(body):
    out, sec = [], []

    def emit():
        blk = sec
        if blk and re.match(r"(?i)^\s*\[Peer\]", blk[0]) and not any(
                re.match(r"(?i)^\s*PersistentKeepalive\s*=", l) for l in blk):
            blk = [l for l in blk if not re.match(r"(?i)^\s*Endpoint\s*=", l)]
        out.extend(blk)

    for ln in body.splitlines():
        if re.match(r"(?i)^\s*\[", ln):
            emit(); sec = [ln]
        else:
            sec.append(ln)
    emit()
    return "\n".join(out)


