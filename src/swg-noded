_IPV4_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}$")

def _wdtt_raw(inst):
    port = str((inst or {}).get("raw_port") or "").strip()
    if not port.isdigit() or not (1 <= int(port) <= 65535):
        return None
    ifn = ((inst or {}).get("raw_iface") or "").strip()
    addr = ((inst or {}).get("raw_addr") or "").strip()
    if not _WDTT_RAW_NAME_RE.match(ifn) or not _WDTT_CIDR_RE.match(addr):
        return None
    lip = str((inst or {}).get("listen") or "")
    lip = lip.rsplit(":", 1)[0].strip() if ":" in lip else ""
    _pin = str((inst or {}).get("bind_ip") or "").strip()
    if _pin and _IPV4_RE.match(_pin):
        lip = _pin
    if not _IPV4_RE.match(lip or ""):
        lip = "0.0.0.0"
    else:
        lip = turn_bind(lip + ":0", resolve=False).rsplit(":", 1)[0]
    return (lip + ":" + port, ifn, addr)

def _turn_dns(inst):
    v = (inst or {}).get("dns")
    parts = [str(p).strip() for p in (v if isinstance(v, list) else str(v or "").split(","))]
    parts = list(dict.fromkeys(p for p in parts if p))
    if not 1 <= len(parts) <= 2 or not all(_turn_dns_usable(p) for p in parts):
        return ""
    return ",".join(parts)

def _turn_dns_usable(p):
    import ipaddress
    try:
        a = ipaddress.ip_address(p)
    except ValueError:
        return False
    return (a.version == 4 and str(a) == p and not a.is_unspecified and not a.is_loopback
            and not a.is_link_local and not a.is_multicast and not a.is_reserved and not p.startswith("0."))

_WDTT_TAKES_DNS = {}
_WDTT_DNS_RETRY = {}
_WDTT_DNS_BACKOFF = 300

def _wdtt_takes_dns(fork, force=False):
    fork = _wdtt_fork({"fork": fork})
    key = (fork, _wdtt_installed_ver(fork))
    if key in _WDTT_TAKES_DNS:
        return _WDTT_TAKES_DNS[key]
    if not force and time.time() < _WDTT_DNS_RETRY.get(key, 0):
        return None
    binp = _wdtt_bin_shared(fork)
    if not os.path.exists(binp):
        return None
    r = run([binp, "-h"], timeout=6)
    flags = _turn_help_flags((r.stderr or "") + (r.stdout or ""))
    if not flags:
        _WDTT_DNS_RETRY[key] = time.time() + _WDTT_DNS_BACKOFF
        return None
    _WDTT_TAKES_DNS[key] = any(f["name"] == "dns" for f in flags)
    return _WDTT_TAKES_DNS[key]

def _wdtt_params_eff(inst, fork=None):
    params = (inst.get("params") or "").strip()
    dns = _turn_dns(inst)
    if not dns or _wdtt_takes_dns(fork or _wdtt_fork(inst)) is not True:
        return params
    return ("-dns " + dns + " " + params).strip()

