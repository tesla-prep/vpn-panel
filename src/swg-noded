_CSQTT_VER_RE = re.compile(rb'aria-label="v(\d{1,3}\.\d{1,3}[0-9A-Za-z.+~-]{0,24}) by amurcanov"')
_CSQTT_EXEVER = {}
_CSQTT_EXEVER_TTL = 600
_CSQTT_EXEVER_FAIL_TTL = 60

def _csqtt_exe_version(pid):
    now = time.time()
    hit = _CSQTT_EXEVER.get(pid)
    if hit and now - hit[0] < (_CSQTT_EXEVER_TTL if hit[1] is not None else _CSQTT_EXEVER_FAIL_TTL):
        return hit[1]
    for k in [k for k, v in _CSQTT_EXEVER.items() if now - v[0] >= _CSQTT_EXEVER_TTL]:
        _CSQTT_EXEVER.pop(k, None)
    ver = None
    with contextlib.suppress(Exception):
        if NODE_KIND == "docker":
            r = host_sh("grep -a -o -m1 -E 'aria-label=\"v[0-9][^\"]{0,30} by amurcanov\"' /proc/%d/exe "
                        "2>/dev/null | head -c 200; [ -r /proc/%d/exe ] && echo CSQTT_EXE_READ; :" % (int(pid), int(pid)),
                        timeout=20)
            out = (r.stdout or "").encode()
            if r.returncode == 0 and b"CSQTT_EXE_READ" in out:
                m = _CSQTT_VER_RE.search(out)
                ver = m.group(1).decode() if m else ""
        else:
            with open("/proc/%d/exe" % int(pid), "rb") as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as mm:
                m = _CSQTT_VER_RE.search(mm)
                ver = m.group(1).decode() if m else ""
    _CSQTT_EXEVER[pid] = (now, ver)
    return ver


def _csqtt_line_of_version(ver):
    m = re.match(r"(\d+)\.(\d+)", ver or "")
    if not m:
        return ""
    mm = "%d.%d" % (int(m.group(1)), int(m.group(2)))
    return CSQTT_DEFAULT_LINE if mm in ("2.0", "2.1") else mm


def _csqtt_procs():
    out = []
    if NODE_KIND == "docker":
        for pid, parts in _wdtt_host_procs():
            fl = _wdtt_flags_from_argv(parts) if isinstance(parts, list) else (parts or {})
            if _csqtt_is_server(fl):
                out.append((pid, fl))
        return out
    with contextlib.suppress(Exception):
        for ent in os.listdir("/proc"):
            if not ent.isdigit():
                continue
            with contextlib.suppress(Exception):
                with open("/proc/%s/cmdline" % ent, "rb") as f:
                    parts = [x.decode(errors="replace") for x in f.read().split(b"\x00") if x]
                if not parts:
                    continue
                fl = _wdtt_flags_from_argv(parts)
                if _csqtt_is_server(fl):
                    out.append((int(ent), fl))
    return out


def _csqtt_is_server(fl):
    return bool((fl.get("tun-addr") or "").strip() or "csqtt" in (fl.get("_exe") or "").lower())


def csqtt_candidates():
    mine = set(_csqtt_load().keys())
    out = []
    for pid, f in _csqtt_procs():
        iface = _csqtt_iface_of(f)
        cfg = (f.get("config-dir") or "").strip()
        if iface in mine or not cfg:
            continue
        if cfg.startswith(CSQTT_ROOT + "/"):
            continue
        users, store_found = _csqtt_store_probe(cfg, pid=pid)
        ver = _csqtt_exe_version(pid)
        out.append({"iface": iface, "pid": pid, "config_dir": cfg,
                    "version": ver or "", "line": _csqtt_line_of_version(ver),
                    "container": _proc_container(pid),
                    "store_found": store_found,
                    "listen": (f.get("listen") or "").strip(),
                    "tun_addr": (f.get("tun-addr") or "").strip() or CSQTT_DEFAULT_TUNADDR,
                    "max_passwords": (f.get("max-passwords") or "").strip(),
                    "users": [{"comment": v["comment"], "vk_hash": v["vk_hash"], "expires_at": v["expires_at"],
                               "is_deactivated": v["is_deactivated"]} for v in users.values()],
                    "adoptable": True})
    return out


def _csqtt_scan_ok():
    return True if NODE_KIND != "docker" else bool(_WDTT_HOSTPROC.get("ok", True))


def _csqtt_container_of(pid):
    txt = ""
    if NODE_KIND == "docker":
        txt = (host_sh("cat /proc/%d/cgroup 2>/dev/null; :" % int(pid), timeout=20).stdout or "")
    else:
        with contextlib.suppress(Exception):
            with open("/proc/%d/cgroup" % int(pid)) as f:
                txt = f.read()
    m = re.search(r"(docker|libpod)[-/]([0-9a-f]{12,64})", txt)
    return (m.group(2), "podman" if m.group(1) == "libpod" else "docker") if m else ("", "")


def _ctr_stop_foreign(cid, runtime):
    if NODE_KIND == "docker":
        r = host_sh("docker stop " + shlex.quote(cid), timeout=60)
    else:
        cli = _ctr_cli_named(runtime) or (_ctr_cli_named("docker") if runtime == "podman" else None)
        if not cli:
            return False, "no %s command on this node to stop container %s with" % (runtime or "docker", cid[:12])
        r = run([cli, "stop", cid], timeout=60)
    if r.returncode == 0:
        return True, ""
    tail = [ln for ln in ((r.stderr or "") + "\n" + (r.stdout or "")).splitlines() if ln.strip()]
    return False, ("%s stop %s failed: %s" % (runtime or "docker", cid[:12], tail[-1].strip() if tail else "exit %d" % r.returncode))[:240]


def _csqtt_stop_foreign(iface, cfgdir):
    _host = (NODE_KIND == "docker")

    def _foreign(after_stop=False):
        _wdtt_hostproc_flush(force=after_stop)
        return next(((p, f) for p, f in _csqtt_procs() if _it(f)), None)

    def _it(f):
        return (_csqtt_is_server(f) and _csqtt_iface_of(f) == iface
                and (not cfgdir or os.path.normpath((f.get("config-dir") or "").strip() or "/") == os.path.normpath(cfgdir))
                and not (f.get("config-dir") or "").startswith(CSQTT_ROOT + "/"))

    def _drop_tun():
        with contextlib.suppress(Exception):
            run(["ip", "link", "delete", "dev", iface])
        if _host:
            host_sh("ip link delete dev %s 2>/dev/null; :" % shlex.quote(iface))

    hit = _foreign()
    if not hit:
        return (True, "") if _csqtt_scan_ok() else (False, "the process scan did not complete")
    pid, _f = hit
    unit = _wdtt_unit_of_pid(pid, _host)
    if unit and not unit.startswith(("swg-csqtt-", "swg-wdtt-")):
        host_sh(sc_disable_now(unit) + " >/dev/null 2>&1; :")
    cid, runtime = _csqtt_container_of(pid)
    if cid:
        ok, why = _ctr_stop_foreign(cid, runtime)
        if not _foreign(after_stop=True) and _csqtt_scan_ok():
            _drop_tun()
            return True, ""
        return False, why or ("container %s was stopped but the server is still running" % cid[:12])
    if NODE_KIND == "docker":
        _fl, _st = _host_proc_ident(pid)
        _sent = bool(_st and _it(_fl))
        if _sent:
            host_sh(_HOST_STARTTIME_SH + "s(){ [ \"$(st %d)\" = %s ]; }; "
                    "s || exit 0; kill -TERM %d 2>/dev/null; i=0; while [ $i -lt 30 ] && s; do sleep 0.15; i=$((i+1)); done; "
                    "s && kill -KILL %d 2>/dev/null; :" % (pid, shlex.quote(_st), pid, pid))
    else:
        _sent = True
        with contextlib.suppress(Exception):
            os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not _pid_alive(pid):
                    break
                time.sleep(0.15)
            else:
                os.kill(pid, signal.SIGKILL)
                for _ in range(10):
                    if not _pid_alive(pid):
                        break
                    time.sleep(0.1)
    back = _foreign(after_stop=True)
    if not (not back and _csqtt_scan_ok()):
        if back and back[0] != pid:
            return False, "it " + _csqtt_came_back(back[0])
        if not _sent:
            return False, "the host could not be read to confirm pid %d is still that server before stopping it — tried again" % pid
        return False, "it is still running after TERM and KILL"
    _drop_tun()
    return True, ""


def _csqtt_serve_adopted(inst):
    au = inst.get("adopt_users") or {}
    if not au:
        return
    pwds = dict(inst.get("passwords") or {})
    for pw, m in au.items():
        if pw in pwds:
            continue
        m = m if isinstance(m, dict) else {}
        pwds[pw] = {"expires_at": int(m.get("expires_at") or 0), "vk_hash": str(m.get("vk_hash") or ""),
                    "is_deactivated": bool(m.get("is_deactivated"))}
    inst["passwords"] = pwds


_CSQTT_ADOPT_LATER = {}
CSQTT_ADOPT_RETRY_S = 60
CSQTT_ADOPT_LOOK_S = 15
_CSQTT_FETCH_LATER = {}
CSQTT_FETCH_RETRY_S = 300


def reconcile_csqtt(want, remove=None):
    res = {"changed": 0, "errors": []}
    want = want or {}
    if isinstance(want, dict):
        _CLAIMED["csqtt"] = set(want)
    if not isinstance(want, dict):
        res["errors"].append("panel sent a malformed csqtt set (%s) — ignored" % type(want).__name__)
        return res
    have = _csqtt_load()
    for _i in [i for i in _CSQTT_ADOPT_LATER if i not in want]:
        _CSQTT_ADOPT_LATER.pop(_i, None)
    if not want and not have:
        return res
    _sw_pass = [False]
    for iface in [i for i in (remove or []) if isinstance(i, str) and i not in (want or {})]:
        if iface in have and (have.get(iface) or {}).get("panel_managed"):
            _csqtt_remove(iface); have.pop(iface, None); res["changed"] += 1
    for iface, req in want.items():
        try:
            if not _CSQTT_NAME_RE.match(iface):
                res["errors"].append(iface + ": bad csqtt iface name"); continue
            inst = dict(req or {}); inst["iface"] = iface
            prev = have.get(iface) or {}
            inst["panel_managed"] = True
            _switched = False
            _cut = _csqtt_cut_line(iface)
            _cur = (_cut or _csqtt_running_line(iface)
                    or (prev.get("line") if _csqtt_line_ok(prev.get("line")) else "") or CSQTT_DEFAULT_LINE)
            _line = (inst.get("line") or "").strip()
            if not _line:
                _line = _cur
                if _cur != CSQTT_DEFAULT_LINE:
                    inst.pop("ver", None)
            if not _csqtt_line_ok(_line):
                res["errors"].append(iface + ": this node doesn't know csqtt " + _line[:16] + " — update the node (its page offers "
                                     "\"update node to …\"), then the server moves on the next sync. Known here: "
                                     + ", ".join(CSQTT_KNOWN_LINES) + ".")
                _line = _cur
                inst["ver"] = (inst.get("cur_ver") or "").strip()
            inst["line"] = _cur
            _lf = prev.get("line_failed") or {}
            if (_line != _cur and _lf.get("line") == _line and _lf.get("ver") == (inst.get("ver") or "").strip()
                    and inst.get("restart") == prev.get("restart")):
                inst["line_failed"] = _lf
            inst["password"] = (prev.get("password") or inst.get("password") or "").strip() or _gen_csqtt_password()
            inst["web_pass"] = (prev.get("web_pass") or _gen_csqtt_password() + _gen_csqtt_password())
            inst["web_port"] = prev.get("web_port") or _csqtt_webport(inst.get("listen") or "")
            _pw_seen = bool(prev.get("pw_seen") or (inst.get("passwords") or {}))
            if _pw_seen:
                inst["pw_seen"] = True
            if not _pw_seen and not inst.get("adopt_users"):
                _pre = _csqtt_adopted_users(_csqtt_dir(iface))
                if _pre:
                    inst["adopt_users"] = _pre
                    inst["adopt_users_at"] = int(time.time())
                    _au = _pre
            _au = prev.get("adopt_users") or {}
            if _au:
                _have = set((inst.get("passwords") or {}).keys())
                if (_have and not (set(_au) - _have)) or int(time.time()) - int(prev.get("adopt_users_at") or 0) > 900:
                    _au = {}
            if _au:
                inst["adopt_users"] = _au
                inst["adopt_users_at"] = prev.get("adopt_users_at") or int(time.time())
            _later = _CSQTT_ADOPT_LATER.get(iface)
            if _later and (not inst.get("adopt_foreign") or _csqtt_present(iface)):
                _CSQTT_ADOPT_LATER.pop(iface, None); _later = None
            _waiting = bool(_later) and time.monotonic() < _later[0]
            if _waiting and NODE_KIND == "docker":
                _wdtt_hostproc_fresh(CSQTT_ADOPT_LOOK_S)
            if _waiting and (_csqtt_foreign_pid(iface) is not None or not _csqtt_scan_ok()):
                res["errors"].append(iface + ": " + _later[1])
                if prev:
                    have[iface] = inst
                continue
            if inst.get("adopt_foreign") and not _csqtt_present(iface):
                _src = (inst.get("adopt_config_dir") or "").strip()
                if not _src:
                    _src = next((c["config_dir"] for c in csqtt_candidates() if c["iface"] == iface), "")
                _spid = next((pid for pid, f in _csqtt_procs()
                              if _csqtt_iface_of(f) == iface
                              and (not _src or os.path.normpath((f.get("config-dir") or "").strip() or "/") == os.path.normpath(_src))), None)
                _pre = _csqtt_adopted_users(_src, fresh=True, pid=_spid) if _src else {}
                if _pre:
                    inst["adopt_users"] = _pre
                    inst["adopt_users_at"] = int(time.time())
                    _au = _pre
                _stopped, _why = _csqtt_stop_foreign(iface, _src)
                if not _stopped:
                    _e = "couldn't stop the existing csqtt server (" + _why + ")"
                    _CSQTT_ADOPT_LATER[iface] = (time.monotonic() + CSQTT_ADOPT_RETRY_S, _e)
                    res["errors"].append(iface + ": " + _e)
                    if prev:
                        have[iface] = inst
                    continue
            if _au:
                _csqtt_serve_adopted(inst)
            if not _csqtt_present(iface):
                if _cut:
                    _csqtt_stop_one(iface)
                    _csqtt_store_restore(_csqtt_dir(iface), _cut)
                    log(LOG_WARNING, "csqtt %s: a switch away from %s was cut and its server is gone — store rolled back, re-installing %s", iface, _cut, _cut)
                elif not inst.get("line_failed"):
                    inst["line"] = _line
                if inst["line"] != _line:
                    inst["ver"] = (inst.get("cur_ver") or "").strip() or _csqtt_installed_ver(inst["line"])
                if inst.get("restart") != prev.get("restart"):
                    _CSQTT_FETCH_LATER.pop((_csqtt_line_of(inst), (inst.get("ver") or "").strip()), None)
                if os.path.exists("/sys/class/net/" + iface):
                    _fp = _foreign_on(lambda: _csqtt_foreign_pid(iface))
                    if _fp or not _csqtt_scan_ok():
                        if not _fp:
                            _e = "the process scan did not complete, so this server is not installed on %s yet" % iface
                        elif inst.get("adopt_foreign"):
                            _e = "the server being taken over " + _csqtt_came_back(_fp)
                            _CSQTT_ADOPT_LATER[iface] = (time.monotonic() + CSQTT_ADOPT_RETRY_S, _e)
                        else:
                            _e = ("another csqtt server, not this panel's, is running on %s (pid %d), so this one is not "
                                  "installed over it. Stop that server, or remove this one and take that server over from "
                                  "the node page." % (iface, _fp))
                        res["errors"].append(iface + ": " + _e)
                        if prev:
                            have[iface] = inst
                        continue
                err = _csqtt_install(inst)
                if not err:
                    _CSQTT_ADOPT_LATER.pop(iface, None)
                if not err and _cut:
                    _csqtt_cut_clear(iface)
                if err:
                    res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                res["changed"] += 1
            else:
                _want_ver = (inst.get("ver") or "").strip()
                if inst.get("restart") != prev.get("restart"):
                    _CSQTT_FETCH_LATER.pop((_line, _want_ver), None)
                if _cut:
                    _sw_pass[0] = _switched = True
                    err = _csqtt_abort_switch(inst, _cut)
                    log(LOG_WARNING, "csqtt %s: a switch away from %s was cut by a restart — rolled back", iface, _cut)
                    if err:
                        res["errors"].append(iface + ": rolled back to csqtt " + _cut + ", but: " + err)
                elif _line != _cur and not inst.get("line_failed") and (
                        _sw_pass[0] or time.monotonic() < _CSQTT_FETCH_LATER.get((_line, _want_ver), 0)):
                    pass
                elif _line != _cur and not inst.get("line_failed"):
                    err, _memo = _csqtt_switch_line(inst, _cur, _line, _want_ver, _csqtt_ifaces(want, _line),
                                                    {i for i, r in want.items() if (r or {}).get("stopped")})
                    _sw_pass[0] = _switched = (not err) or _memo
                    if err and not _memo:
                        _CSQTT_FETCH_LATER[(_line, _want_ver)] = time.monotonic() + CSQTT_FETCH_RETRY_S
                    if not err:
                        inst["line"] = _line; inst.pop("line_failed", None)
                        log(LOG_INFO, "csqtt %s: switched %s → %s (%s)", iface, _cur, _line, _want_ver)
                        res["changed"] += 1
                    else:
                        if _memo:
                            inst["line_failed"] = {"line": _line, "ver": _want_ver, "why": err[:200]}
                        res["errors"].append(iface + ": couldn't switch to csqtt " + _line + ": " + err)
                _run_ver = _want_ver if _line == _cur else (inst.get("cur_ver") or "").strip()
                if inst.get("line") == _cur:
                    inst["ver"] = _run_ver
                if (not _switched and _run_ver and _run_ver != _csqtt_installed_ver(_cur)
                        and time.monotonic() >= _CSQTT_FETCH_LATER.get((_cur, _run_ver), 0)):
                    err = _csqtt_update_binary(inst, _run_ver, _csqtt_ifaces(want, _cur) or [iface], _cur)
                    if err:
                        _CSQTT_FETCH_LATER[(_cur, _run_ver)] = time.monotonic() + CSQTT_FETCH_RETRY_S
                        res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                    res["changed"] += 1
                if (_csqtt_unit_drifted(iface, inst) or _csqtt_params_changed(prev, inst)
                        or (not inst.get("stopped") and _csqtt_env_drifted(iface, inst))
                        or (not inst.get("stopped") and bind_heal_due("csqtt:" + iface, _csqtt_dir(iface) + "/csqtt.env", inst.get("listen") or "", names=False))):
                    err = _csqtt_reconfigure(inst)
                    if err:
                        res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                    res["changed"] += 1
                _body = _csqtt_desired_body(inst) if _pw_seen else ""
                if _pw_seen and _csqtt_desired_changed(iface, _body):
                    err = _csqtt_reconcile_desired(iface, _body)
                    if err:
                        res["errors"].append(iface + ": " + err); have[iface] = inst; continue
                    res["changed"] += 1
            if bool(inst.get("stopped")) != bool(prev.get("stopped")):
                if NODE_KIND == "docker":
                    _csqtt_docker_stop(iface) if inst.get("stopped") else _csqtt_docker_start(inst)
                else:
                    host_sh("systemctl " + ("disable --now " if inst.get("stopped") else "enable --now ")
                            + shlex.quote(_csqtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            if inst.get("restart") and inst.get("restart") != prev.get("restart") and not inst.get("stopped") and not _switched:
                if NODE_KIND == "docker":
                    _csqtt_docker_start(inst)
                else:
                    rebind_env(_csqtt_dir(iface) + "/csqtt.env", inst, _csqtt_env_text)
                    host_sh("systemctl restart " + shlex.quote(_csqtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            if (NODE_KIND != "docker" and _csqtt_present(iface) and not bool(inst.get("stopped"))
                    and _unit_active(_csqtt_svc(iface))
                        not in ("active", "activating", "reloading")):
                host_sh(sc_enable_now(_csqtt_svc(iface)) + " >/dev/null 2>&1")
                res["changed"] += 1
            if (NODE_KIND == "docker" and not inst.get("stopped") and _csqtt_present(iface)
                    and not _csqtt_docker_pid(iface)):
                err = _csqtt_docker_start(inst)
                if err:
                    res["errors"].append(iface + ": " + err)
                else:
                    res["changed"] += 1
            have[iface] = inst
        except Exception as e:
            res["errors"].append(iface + ": " + str(e))
    if not _csqtt_save(have):
        res["errors"].append("couldn't write the csqtt record (" + CSQTT_RECORD + ")")
    return res

def csqtt_snapshot():
    out = []
    insts = _csqtt_load()
    if not insts:
        return out
    _nowt = int(time.time())
    for iface, inst in insts.items():
        svc = _csqtt_svc(iface)
        active = ("active" if _csqtt_docker_pid(iface) else "inactive") if NODE_KIND == "docker" else _unit_active(svc)
        _rl = _csqtt_cut_line(iface) or _csqtt_running_line(iface) or _csqtt_line_of(inst)
        pj = _csqtt_read_store(_csqtt_dir(iface), _rl)
        pwds, devs = {}, {}
        for did, d in (pj.get("devices") or {}).items():
            d = d or {}
            devs[did] = {"ip": d.get("ip", ""), "pub_key": d.get("pub_key", "")}
        last = _CSQTT_LASTBYTES.setdefault(iface, {})
        _alive = set(pj.get("passwords") or {})
        for pw, e in (pj.get("passwords") or {}).items():
            e = e or {}
            up, dn = int(e.get("up_bytes") or 0), int(e.get("down_bytes") or 0)
            _dev = devs.get(e.get("device_id") or "") or {}
            _rs, _ts = _pw_speed(last, pw, up, dn, _nowt)
            online = _raw_online("csqtt:" + iface, pw, _rs, _ts, _nowt, _alive)
            pwds[pw] = {"device_id": e.get("device_id", ""), "up_bytes": up, "down_bytes": dn,
                        "is_deactivated": bool(e.get("is_deactivated")), "expires_at": e.get("expires_at", 0),
                        "ip": e.get("ip") or _dev.get("ip", ""), "online": online, "rx_speed": _rs, "tx_speed": _ts}
        _rxb, _txb, _rxs, _txs = _wdtt_iface_traffic(iface)
        _own = _turn_own_dns(_csqtt_dir(iface))
        out.append({"iface": iface, "service": svc, "active": active, "listen": inst.get("listen", ""),
                    "bind": _env_listen(_csqtt_dir(iface) + "/csqtt.env"),
                    "bind_ip": inst.get("bind_ip", ""),
                    "tun_addr": inst.get("tun_addr", ""), "web_port": inst.get("web_port", ""),
                    "stopped": bool(inst.get("stopped")), "kind": "csqtt",
                    "fork": (inst.get("fork") or "").strip() or next(iter(CSQTT_FORK_OWNER)),
                    "version": _csqtt_installed_ver(_rl),
                    "line": _rl,
                    **({"line_failed": inst["line_failed"]} if inst.get("line_failed") else {}),
                    "max_passwords": inst.get("max_passwords") or "",
                    "params": inst.get("params") or "",
                    "dns": _csqtt_applied_dns(iface, inst),
                    **({"dns_server": _own} if _own is not OWN_DNS_UNKNOWN else {}),
                    "rx_bytes": _rxb, "tx_bytes": _txb, "rx_speed": _rxs, "tx_speed": _txs,
                    "adopt_users": inst.get("adopt_users") or {},
                    "passwords": pwds, "devices": devs})
    return out


