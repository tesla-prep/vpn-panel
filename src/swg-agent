CONFIG_PATH = os.environ.get("SWG_AGENT_CONFIG", "/etc/swg-agent/config.json")
AUDIT_PATH  = os.environ.get("SWG_AGENT_AUDIT",  "/var/log/swg-agent/audit.log")
LOCK_PATH   = os.environ.get("SWG_AGENT_LOCK",   "/run/swg-agent.lock")
VERSION     = "1.0"

PUBKEY_RE = re.compile(r"^[A-Za-z0-9+/]{43}=$")
ENDPOINT_RE = re.compile(r"^(\[[0-9A-Fa-f:.]{2,45}\]|[A-Za-z0-9](?:[A-Za-z0-9.-]{0,252})):[0-9]{1,5}$")
AWG_KEYS  = ["Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4",
             "H1", "H2", "H3", "H4", "I1", "I2", "I3", "I4", "I5",
             "HeaderProtectionKey", "RandomTrailers", "ContentPaddingAddition", "RekeyAfterTime", "RekeyTimeout",
             "RejectAfterTime", "KeepaliveTimeout", "MaxHandshakeAttempts", "DisableCookies"]
AWG3_KEYS = AWG_KEYS[AWG_KEYS.index("HeaderProtectionKey"):]


def awg3_unset(k, v):
    return k in AWG3_KEYS and k != "HeaderProtectionKey" and str(v).strip().lower() in ("0", "off")


def awg_gone(k, v):
    s = re.sub(r"\s+", "", "" if v is None else str(v))
    m = re.fullmatch(r"(\d+)-(\d+)", s)
    if m and m.group(1) == m.group(2):
        s = m.group(1)
    return s in ("", "0") or s.lower() == "off" or (k in ("H1", "H2", "H3", "H4") and s == k[1])


class AgentError(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code
        self.msg = msg



def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except Exception as e:
        raise AgentError("internal", f"cannot read {CONFIG_PATH}: {e}")


def iface_cfg(cfg, iface):
    ifaces = cfg.get("interfaces", {})
    if iface not in ifaces:
        raise AgentError("iface_not_managed", f"interface {iface!r} is not managed")
    return ifaces[iface]


def run(args, input_text=None, check=True):
    p = subprocess.run(args, input=input_text, capture_output=True, text=True)
    if check and p.returncode != 0:
        raise AgentError("internal", f"{' '.join(args)} failed: {p.stderr.strip()}")
    return p.stdout


def read_conf(path):
    with open(path) as f:
        return f.read()


def write_conf_atomic(path, text):
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def parse_dump(out):
    lines = out.strip().splitlines()
    iface_line = lines[0].split("\t") if lines else []
    peers = []
    for line in lines[1:]:
        f = line.split("\t")
        if len(f) < 8:
            continue
        peers.append({
            "public_key": f[0],
            "endpoint": None if f[2] in ("(none)", "") else f[2],
            "allowed_ips": f[3],
            "last_handshake": int(f[4]) if f[4].isdigit() else 0,
            "rx_bytes": int(f[5]) if f[5].isdigit() else 0,
            "tx_bytes": int(f[6]) if f[6].isdigit() else 0,
        })
    return iface_line, peers


def parse_interface_section(conf_text):
    info, in_iface = {}, False
    for line in conf_text.splitlines():
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            continue
        if in_iface and "=" in s and not s.startswith("#"):
            k, v = s.split("=", 1)
            k, v = k.strip(), v.strip()
            info[k] = (info[k] + ", " + v) if (k.lower() == "address" and info.get(k) and v) else v
    return info


def conf_v4_address(address):
    for a in str(address or "").split("#", 1)[0].split(","):
        with contextlib.suppress(ValueError):
            if a.strip() and ipaddress.ip_interface(a.strip()).version == 4:
                return a.strip()
    return ""


def awg_params(info):
    out = {}
    for k in AWG_KEYS:
        if k in info and not awg3_unset(k, info[k]):
            v = info[k]
            out[k] = int(v) if v.isdigit() else v
    return out


def iface_net(info):
    addr = conf_v4_address(info.get("Address")) or info.get("Address", "").split(",")[0].strip()
    if not addr:
        raise AgentError("internal", "interface conf has no Address")
    return ipaddress.ip_interface(addr)


def used_ips(peers):
    out = set()
    for p in peers:
        for cidr in p["allowed_ips"].split(","):
            cidr = cidr.strip()
            if cidr:
                out.add(cidr.split("/")[0])
    return out


def next_free_ip(info, peers):
    net = iface_net(info)
    taken = used_ips(peers) | {str(net.ip)}
    for host in net.network.hosts():
        if str(host) not in taken:
            return str(host)
    raise AgentError("subnet_full", "no free addresses in subnet")


def wg_dump(ic, iface):
    return run(ic["cmd"] + ["show", iface, "dump"])


def gen_psk(ic):
    return run(ic["cmd"] + ["genpsk"]).strip()


def append_peer_to_conf(path, pub, psk, allowed, name, endpoint=None, keepalive=None):
    block = "\n"
    if name:
        block += f"# name: {name}\n"
    block += "[Peer]\n"
    block += f"PublicKey = {pub}\n"
    if psk:
        block += f"PresharedKey = {psk}\n"
    block += f"AllowedIPs = {allowed}\n"
    if endpoint:
        block += f"Endpoint = {endpoint}\n"
    if keepalive:
        block += f"PersistentKeepalive = {keepalive}\n"
    with open(path, "a") as f:
        f.write(block)


def remove_peer_from_conf(path, pub):
    lines = read_conf(path).splitlines()
    starts = [i for i, l in enumerate(lines) if l.strip().lower() == "[peer]"]
    target = None
    for idx, start in enumerate(starts):
        end = starts[idx + 1] if idx + 1 < len(starts) else len(lines)
        if any(re.match(rf"\s*PublicKey\s*=\s*{re.escape(pub)}\s*$", b) for b in lines[start:end]):
            target = (start, end)
            break
    if target is None:
        return
    start, end = target
    while start - 1 >= 0 and (lines[start - 1].strip() == ""
                              or lines[start - 1].strip().lower().startswith("# name:")):
        start -= 1
    new_lines = lines[:start] + lines[end:]
    write_conf_atomic(path, ("\n".join(new_lines).rstrip("\n") + "\n") if new_lines else "")


def set_listen_port_in_conf(path, port):
    lines = read_conf(path).splitlines()
    out, in_iface, done = [], False, False
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            out.append(line)
            continue
        if in_iface and not done and re.match(r"(?i)\s*ListenPort\s*=", line):
            out.append(f"ListenPort = {port}")
            done = True
            continue
        out.append(line)
    if not done:
        res, added = [], False
        for line in out:
            res.append(line)
            if not added and line.strip().lower() == "[interface]":
                res.append(f"ListenPort = {port}")
                added = True
        out = res
    write_conf_atomic(path, "\n".join(out).rstrip("\n") + "\n")


def set_iface_fields_in_conf(path, fields):
    want = {k.lower(): (k, str(v)) for k, v in fields.items()}
    lines = read_conf(path).splitlines()
    out, in_iface, seen = [], False, set()
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]"); out.append(line); continue
        if in_iface and "=" in s and not s.startswith("#"):
            k = s.split("=", 1)[0].strip().lower()
            if k in want:
                if k not in seen:
                    name, val = want[k]; out.append(f"{name} = {val}"); seen.add(k)
                continue
        out.append(line)
    missing = [(name, val) for k, (name, val) in want.items() if k not in seen]
    if missing:
        res, added = [], False
        for line in out:
            res.append(line)
            if not added and line.strip().lower() == "[interface]":
                for name, val in missing:
                    res.append(f"{name} = {val}")
                added = True
        out = res
    write_conf_atomic(path, "\n".join(out).rstrip("\n") + "\n")


def ensure_table_off_in_conf(path):
    try:
        info = parse_interface_section(read_conf(path))
    except Exception:
        return
    if str(info.get("Table", "")).strip().lower() == "off":
        return
    set_iface_fields_in_conf(path, {"Table": "off"})


def rewrite_peer_allowed_in_conf(path, pub, allowed):
    lines = read_conf(path).splitlines()
    starts = [i for i, l in enumerate(lines) if l.strip().lower() == "[peer]"]
    for idx, start in enumerate(starts):
        end = starts[idx + 1] if idx + 1 < len(starts) else len(lines)
        if any(re.match(rf"\s*PublicKey\s*=\s*{re.escape(pub)}\s*$", b) for b in lines[start:end]):
            done = False
            for i in range(start, end):
                if re.match(r"(?i)\s*AllowedIPs\s*=", lines[i]):
                    lines[i] = f"AllowedIPs = {allowed}"; done = True; break
            if not done:
                lines.insert(start + 1, f"AllowedIPs = {allowed}")
            write_conf_atomic(path, "\n".join(lines).rstrip("\n") + "\n")
            return


def rewrite_peer_endpoint_in_conf(path, pub, endpoint):
    lines = read_conf(path).splitlines()
    starts = [i for i, l in enumerate(lines) if l.strip().lower() == "[peer]"]
    for idx, start in enumerate(starts):
        end = starts[idx + 1] if idx + 1 < len(starts) else len(lines)
        pk_at = [i for i in range(start, end) if re.match(rf"\s*PublicKey\s*=\s*{re.escape(pub)}\s*$", lines[i])]
        if not pk_at:
            continue
        for i in range(start, end):
            m = re.match(r"(?i)\s*Endpoint\s*=\s*(.*?)\s*$", lines[i])
            if m:
                if m.group(1) == endpoint:
                    return False
                lines[i] = f"Endpoint = {endpoint}"
                break
        else:
            lines.insert(pk_at[0] + 1, f"Endpoint = {endpoint}")
        write_conf_atomic(path, "\n".join(lines).rstrip("\n") + "\n")
        return True
    return False


@contextlib.contextmanager
def locked():
    os.makedirs(os.path.dirname(LOCK_PATH) or "/run", exist_ok=True)
    f = open(LOCK_PATH, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def audit(op, req):
    try:
        os.makedirs(os.path.dirname(AUDIT_PATH), exist_ok=True)
        with open(AUDIT_PATH, "a") as f:
            f.write(json.dumps({
                "ts": int(time.time()), "op": op,
                "iface": req.get("iface"), "public_key": req.get("public_key"),
                "allowed_ips": req.get("allowed_ips"), "name": req.get("name"),
            }) + "\n")
    except Exception:
        pass



def op_describe(cfg, req):
    out = {"hostname": os.uname().nodename, "agent_version": VERSION, "interfaces": {}}
    want = req.get("iface")
    for iface, ic in cfg.get("interfaces", {}).items():
        if want and iface != want:
            continue
        iface_line, peers = parse_dump(wg_dump(ic, iface))
        info = parse_interface_section(read_conf(ic["conf"]))
        net = iface_net(info)
        port = int(iface_line[2]) if len(iface_line) > 2 and iface_line[2].isdigit() else None
        out["interfaces"][iface] = {
            "public_key": iface_line[1] if len(iface_line) > 1 else None,
            "listen_port": port,
            "endpoint": f"{cfg.get('endpoint_host', '')}:{port}" if port else None,
            "address": str(net),
            "subnet": str(net.network),
            "peer_count": len(peers),
            "used_ips": sorted(used_ips(peers)),
            "awg_params": awg_params(info),
            "dns": cfg.get("dns", []),
        }
    return out


def op_list_peers(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    _, peers = parse_dump(wg_dump(ic, iface))
    return {"iface": iface, "peers": peers}


def op_next_ip(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    _, peers = parse_dump(wg_dump(ic, iface))
    info = parse_interface_section(read_conf(ic["conf"]))
    return {"iface": iface, "next_ip": next_free_ip(info, peers) + "/32"}


def op_add_peer(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    allowed = req.get("allowed_ips", "")
    name = req.get("name")
    psk_req = req.get("preshared_key", "auto")

    info = parse_interface_section(read_conf(ic["conf"]))
    iface_line, peers = parse_dump(wg_dump(ic, iface))

    if any(p["public_key"] == pub for p in peers):
        raise AgentError("peer_exists", "a peer with this public key already exists")

    members = [c.strip() for c in allowed.split(",") if c.strip()]
    if not members or not all("/" in m for m in members):
        raise AgentError("bad_request", "allowed_ips must be CIDR(s), e.g. 10.0.0.5/32")
    net = iface_net(info)
    if not any(m in ("0.0.0.0/0", "::/0") for m in members):
        in_sub = []
        for m in members:
            _ip = m.split("/")[0]
            try:
                _a = ipaddress.ip_address(_ip)
            except ValueError:
                raise AgentError("bad_request", f"invalid ip {_ip}")
            if _a in net.network:
                in_sub.append(_ip)
        if not in_sub:
            raise AgentError("bad_request", f"no address in {allowed} is inside subnet {net.network}")
        for ip in in_sub:
            if ip == str(net.ip):
                raise AgentError("ip_in_use", f"{ip} is the server address")
            if ip in used_ips(peers):
                raise AgentError("ip_in_use", f"{ip} already assigned")

    if psk_req in (None, "none", False):
        psk = None
    elif psk_req in ("auto", "", True):
        psk = gen_psk(ic)
    else:
        psk = psk_req

    endpoint = (req.get("endpoint") or "").strip() or None
    ka = req.get("persistent_keepalive")
    try:
        ka = int(ka) if ka else None
    except (TypeError, ValueError):
        ka = None

    args = ic["cmd"] + ["set", iface, "peer", pub, "allowed-ips", allowed]
    if endpoint:
        args += ["endpoint", endpoint]
    if ka:
        args += ["persistent-keepalive", str(ka)]
    if psk:
        args += ["preshared-key", "/dev/stdin"]
    run(args, input_text=(psk + "\n") if psk else None)

    append_peer_to_conf(ic["conf"], pub, psk, allowed, name, endpoint=endpoint, keepalive=ka)
    if endpoint:
        ensure_table_off_in_conf(ic["conf"])

    port = int(iface_line[2]) if len(iface_line) > 2 and iface_line[2].isdigit() else None
    return {
        "public_key": pub,
        "allowed_ips": allowed,
        "preshared_key": psk,
        "server_public_key": iface_line[1] if len(iface_line) > 1 else None,
        "endpoint": f"{cfg.get('endpoint_host', '')}:{port}" if port else None,
        "awg_params": awg_params(info),
        "dns": cfg.get("dns", []),
    }


def op_set_peer_allowed(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    allowed = (req.get("allowed_ips") or "").strip()
    if not allowed or "/" not in allowed.split(",")[0]:
        raise AgentError("bad_request", "allowed_ips must be CIDR(s), e.g. 0.0.0.0/0 or 10.8.0.0/24")
    is_default = any(c.strip() in ("0.0.0.0/0", "::/0") for c in allowed.split(","))
    if is_default:
        ensure_table_off_in_conf(ic["conf"])
    run(ic["cmd"] + ["set", iface, "peer", pub, "allowed-ips", allowed])
    rewrite_peer_allowed_in_conf(ic["conf"], pub, allowed)
    return {"iface": iface, "public_key": pub, "allowed_ips": allowed}


def op_persist_peer_endpoint(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    ep = (req.get("endpoint") or "").strip()
    if not ENDPOINT_RE.fullmatch(ep):
        raise AgentError("bad_request", "endpoint must be host:port, a.b.c.d:port or [v6]:port")
    changed = rewrite_peer_endpoint_in_conf(ic["conf"], pub, ep)
    return {"iface": iface, "public_key": pub, "endpoint": ep, "changed": changed}


def op_remove_peer(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    pub = req.get("public_key", "")
    if not PUBKEY_RE.match(pub):
        raise AgentError("bad_pubkey", "public_key is not a valid WireGuard key")
    _, peers = parse_dump(wg_dump(ic, iface))
    match = next((p for p in peers if p["public_key"] == pub), None)
    if not match:
        raise AgentError("peer_not_found", "no peer with this public key")
    run(ic["cmd"] + ["set", iface, "peer", pub, "remove"])
    remove_peer_from_conf(ic["conf"], pub)
    return {"removed": pub, "freed_ip": match["allowed_ips"]}


def set_awg_in_conf(path, awg):
    keyset = set(AWG_KEYS)
    lines = read_conf(path).splitlines()
    out, in_iface = [], False
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            in_iface = (s.lower() == "[interface]")
            out.append(line)
            if in_iface:
                for k in AWG_KEYS:
                    if k in awg:
                        out.append(f"{k} = {awg[k]}")
            continue
        if in_iface and "=" in s and s.split("=", 1)[0].strip() in keyset:
            continue
        out.append(line)
    write_conf_atomic(path, "\n".join(out).rstrip("\n") + "\n")


def _awg3_norm(v):
    s = re.sub(r"\s+", "", "" if v is None else str(v))
    if s.lower() in ("", "0", "off", "false", "no"):
        return ""
    if s.lower() in ("1", "on", "true", "yes"):
        return "1"
    m = re.fullmatch(r"(\d+)-(\d+)", s)
    return m.group(1) if m and m.group(1) == m.group(2) else s


def _unit_started(tool, iface):
    if not shutil.which("systemctl") or _IN_CONTAINER:
        return False
    with contextlib.suppress(Exception):
        return subprocess.run(["systemctl", "is-active", "--quiet", f"{tool}-quick@{iface}"],
                              capture_output=True).returncode == 0
    return False


def _bounce(ic, iface, tool, by_unit):
    target = _quick_target(ic, iface)
    unit = f"{tool}-quick@{iface}"
    if by_unit:
        run(["systemctl", "stop", unit], check=False)
    else:
        with contextlib.suppress(Exception):
            run([tool + "-quick", "down", target])
    sock = f"/var/run/amneziawg/{iface}.sock"
    for _ in range(100):
        if not os.path.exists(f"/sys/class/net/{iface}") and not os.path.exists(sock):
            break
        time.sleep(0.1)
    if not os.path.exists(f"/sys/class/net/{iface}"):
        with contextlib.suppress(OSError):
            os.unlink(sock)
    if not by_unit:
        _quick_up(tool, iface, target)
        return
    p = subprocess.run(["systemctl", "start", unit], capture_output=True, text=True)
    if p.returncode != 0:
        log = subprocess.run(["journalctl", "-u", unit, "-n", "6", "--no-pager", "-o", "cat"],
                             capture_output=True, text=True).stdout.strip()
        raise AgentError("up_failed", f"{unit} did not start: {log or p.stderr.strip()}" + _log_no_detail())


def _log_no_detail():
    try:
        lvl = int(os.environ.get("SWG_LOG_LEVEL", "6"))
    except ValueError:
        return ""
    if lvl >= 6:
        return ""
    return " — its own lines are not kept (logging is %s)" % (
        "off" if lvl < 0 else "set to errors" if lvl <= 3 else "set to warnings")


def _awg_recreate(ic, iface, awg, before):
    tool = (ic.get("cmd") or ["awg"])[0]
    if not os.path.exists(f"/sys/class/net/{iface}"):
        set_awg_in_conf(ic["conf"], awg)
        return awg
    by_unit = _unit_started(tool, iface)
    set_awg_in_conf(ic["conf"], awg)
    try:
        _bounce(ic, iface, tool, by_unit)
        dev = parse_interface_section(run([tool, "showconf", iface]))
        bad = [k for k in AWG3_KEYS if _awg3_norm(awg.get(k)) != _awg3_norm(dev.get(k))]
        _was = parse_interface_section(before or "")
        kept = [k for k in AWG_KEYS if k not in AWG3_KEYS and k in _was and k not in awg and not awg_gone(k, dev.get(k))]
        if not bad and not kept:
            return awg
        err = (f"{iface} came up without {', '.join(bad)} as asked" if bad
               else f"{iface} came up still holding {', '.join(kept)}")
    except Exception as e:
        err = e.msg if isinstance(e, AgentError) else str(e)
    write_conf_atomic(ic["conf"], before)
    try:
        _bounce(ic, iface, tool, by_unit)
    except Exception as e:
        raise AgentError("awg_gen_refused", f"this node's AmneziaWG refused the change ({err}), and {iface} did not come "
                                            f"back on its previous configuration either: "
                                            f"{e.msg if isinstance(e, AgentError) else e}")
    raise AgentError("awg_gen_refused", f"this node's AmneziaWG refused the change — {iface} is back on its previous "
                                        f"configuration: {err}")


def op_set_iface(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    out = {"iface": iface}
    before = None
    if isinstance(req.get("awg_params"), dict) and req["awg_params"]:
        with contextlib.suppress(Exception):
            before = read_conf(ic["conf"])
    if req.get("listen_port") is not None:
        try:
            port = int(req.get("listen_port"))
        except (TypeError, ValueError):
            raise AgentError("bad_request", "listen_port must be a number")
        if not (1 <= port <= 65535):
            raise AgentError("bad_request", "listen_port out of range (1-65535)")
        with contextlib.suppress(Exception):
            run(ic["cmd"] + ["set", iface, "listen-port", str(port)])
        set_listen_port_in_conf(ic["conf"], port)
        out["listen_port"] = port
    if req.get("mtu") is not None:
        try:
            mtu = int(req.get("mtu"))
        except (TypeError, ValueError):
            raise AgentError("bad_request", "mtu must be a number")
        if not (576 <= mtu <= 9200):
            raise AgentError("bad_request", "mtu out of range (576-9200)")
        with contextlib.suppress(Exception):
            run(["ip", "link", "set", "dev", iface, "mtu", str(mtu)])
        set_iface_fields_in_conf(ic["conf"], {"MTU": mtu})
        out["mtu"] = mtu
    awg = req.get("awg_params")
    if isinstance(awg, dict) and awg and (ic.get("cmd") or [""])[0] != "awg":
        out["awg_params_skipped"] = "not an AmneziaWG interface"
        awg = None
    if isinstance(awg, dict) and awg:
        awg = {k: str(awg[k]) for k in AWG_KEYS if k in awg and str(awg.get(k, "")) != "" and not awg3_unset(k, awg[k])}
        _was = parse_interface_section(before or "")
        cur3 = {k: v for k, v in _was.items() if k in AWG3_KEYS and not awg3_unset(k, v)}
        if awg and cur3 and not req.get("awg_params_exact"):
            awg = {**{k: v for k, v in cur3.items() if k not in awg}, **awg}
        gone = req.get("awg_params_exact") and any(k in _was and k not in awg for k in AWG_KEYS if k not in AWG3_KEYS)
        if awg and before is not None and (cur3 or any(k in awg for k in AWG3_KEYS) or gone):
            out["awg_params"] = _awg_recreate(ic, iface, awg, before)
        elif awg:
            args = ic["cmd"] + ["set", iface]
            for k in AWG_KEYS:
                if k in awg:
                    args += [k.lower(), awg[k]]
            with contextlib.suppress(Exception):
                run(args)
            set_awg_in_conf(ic["conf"], awg)
            out["awg_params"] = awg
    if len(out) == 1:
        raise AgentError("bad_request", "nothing to set")
    return out


_IPT_REAP_TRIES = 8

def _ipt_reap(table, rule):
    t = (table + " ") if table else ""
    return ("for _n in " + " ".join(str(i) for i in range(1, _IPT_REAP_TRIES + 1))
            + f"; do iptables {t}-D {rule} 2>/dev/null || break; done")

def _ipt_set(table, rule):
    t = (table + " ") if table else ""
    return _ipt_reap(table, rule) + f"; iptables {t}-A {rule} || true"


NAT_TAG = "swg-nat:"


def _nat_masq(net, wan, who="%i"):
    return f"POSTROUTING -s {net} -o {wan} -m comment --comment {NAT_TAG}{who} -j MASQUERADE"


def _nat_hooks(net, wan):
    up = (f"sysctl -q -w net.ipv4.ip_forward=1 || true; "
          f"{_ipt_set('-t nat', _nat_masq(net, wan))}; "
          f"{_ipt_set('', f'FORWARD -i %i -o {wan} -j ACCEPT')}; "
          f"{_ipt_set('', f'FORWARD -i {wan} -o %i -m state --state RELATED,ESTABLISHED -j ACCEPT')}")
    down = (f"{_ipt_reap('-t nat', _nat_masq(net, wan))}; "
            f"{_ipt_reap('', f'FORWARD -i %i -o {wan} -j ACCEPT')}; "
            f"{_ipt_reap('', f'FORWARD -i {wan} -o %i -m state --state RELATED,ESTABLISHED -j ACCEPT')}; true")
    return up, down


def _wan_iface():
    best, best_metric = "", None
    out = run(["ip", "-4", "route", "show", "default"], check=False) or ""
    for ln in out.splitlines():
        m = re.search(r"\bdev (\S+)", ln)
        if not m:
            continue
        mt = re.search(r"\bmetric (\d+)", ln)
        mt = int(mt.group(1)) if mt else 0
        if best_metric is None or mt < best_metric:
            best, best_metric = m.group(1), mt
    if best:
        return best
    out = run(["ip", "-4", "route", "get", "1.1.1.1"], check=False)
    m = re.search(r" dev (\S+)", out or "")
    return m.group(1) if m else "eth0"


def _ensure_tool(tool):
    have, quick = shutil.which(tool), shutil.which(tool + "-quick")
    if have and quick:
        return
    if tool == "wg":
        if _declarative():
            raise AgentError("no_tool", "WireGuard tools are not installed on this node, and this node's "
                             "installation is managed declaratively — installing them by hand would not "
                             "survive its next rebuild. Add the WireGuard tools to the system configuration "
                             "that declares this node and rebuild it, then this interface creates itself on "
                             "the next sync.")
        raise AgentError("no_tool", "WireGuard tools are not installed on this node. Install them with your "
                         "package manager (on Debian/Ubuntu: apt-get install -y wireguard), then this "
                         "interface creates itself on the next sync.")
    if have and not quick:
        if _declarative():
            raise AgentError("no_tool", "AmneziaWG is only half-installed on this node: awg is present but "
                             "awg-quick is missing. This node's installation is managed declaratively, so it "
                             "has to be completed in the system configuration that declares this node rather "
                             "than by an installer run here — add the full AmneziaWG tools and rebuild, then "
                             "this interface creates itself on the next sync.")
        if _IN_CONTAINER:
            raise AgentError("no_tool", "This node's container image has awg but not awg-quick. Update the node "
                             "(docker compose pull && docker compose up -d) so it runs a current swg-node image, "
                             "then this interface creates itself on the next sync.")
        raise AgentError("no_tool", "AmneziaWG is only half-installed on this node: awg is present but "
                         "awg-quick is missing. Re-run the swgPanel node installer — it builds both from "
                         "source — then this interface creates itself on the next sync.")
    if _declarative():
        raise AgentError("no_tool", "AmneziaWG tools are not installed on this node, and this node's "
                         "installation is managed declaratively — re-running an installer would not "
                         "survive its next rebuild. Add the AmneziaWG tools to the system configuration "
                         "that declares this node and rebuild it, then this interface creates itself on "
                         "the next sync.")
    if _IN_CONTAINER:
        raise AgentError("no_tool", "AmneziaWG tools are missing from this node's container image. Update the "
                         "node (docker compose pull && docker compose up -d) so it runs a current swg-node "
                         "image, then this interface creates itself on the next sync.")
    raise AgentError("no_tool", "AmneziaWG tools are not installed on this node. Re-run the swgPanel node "
                     "installer — it builds them from source on any distribution, and falls back to the "
                     "userspace datapath where the kernel module cannot load. Then this interface creates "
                     "itself on the next sync.")


def _awg_obfuscation(gen="3.1"):
    if gen == "3.1":
        s = 12 + secrets.randbelow(9)
        key = base64.b64encode(os.urandom(32)).decode()
        return (f"Jc = {4 + secrets.randbelow(3)}\nJmin = 40\nJmax = 70\n"
                f"S1 = {s}\nS2 = {s}\nS3 = {s}\nS4 = {s}\nH1 = 1\nH2 = 2\nH3 = 3\nH4 = 4\n"
                f"HeaderProtectionKey = {key}\nRandomTrailers = 1\nContentPaddingAddition = 2-10\n"
                "RekeyAfterTime = 100-120\nRekeyTimeout = 3-7\nRejectAfterTime = 150-180\n"
                "KeepaliveTimeout = 5-15\nMaxHandshakeAttempts = 15-20\n")
    s1 = 15 + random.randint(0, 135); s2 = 15 + random.randint(0, 135)
    while s2 == s1 or s2 == s1 + 56:
        s2 = 15 + random.randint(0, 135)
    s3 = 15 + random.randint(0, 85); s4 = 15 + random.randint(0, 85)
    b = [base + random.randint(0, 899999999) for base in (5, 1000000000, 2000000000, 3000000000)]
    w = 15
    return ("Jc = 4\nJmin = 40\nJmax = 70\n"
            f"S1 = {s1}\nS2 = {s2}\nS3 = {s3}\nS4 = {s4}\n"
            f"H1 = {b[0]}-{b[0] + w}\nH2 = {b[1]}-{b[1] + w}\nH3 = {b[2]}-{b[2] + w}\nH4 = {b[3]}-{b[3] + w}\n"
            "I1 = <b 0xc000000001><r 64><t>\nI2 = <r 24><t>\nI3 = <r 32>\n"
            "I4 = <b 0xc000000001><r 32><t>\nI5 = <t><r 48>\n")


_IN_CONTAINER = os.path.exists("/.dockerenv") or os.path.exists("/run/.containerenv")

_UNIT_DIR = "/etc/systemd/system"
_UNIT_PERSIST = {"v": None}


def _declarative():
    if (os.environ.get("SWG_DECLARATIVE") or "").strip().lower() in ("1", "true", "yes", "on"):
        return True
    return not _units_persist()


def _units_persist():
    if _UNIT_PERSIST["v"] is None:
        probe = os.path.join(_UNIT_DIR, ".swg-agent-unit-probe")
        try:
            with open(probe, "w"):
                pass
            os.unlink(probe)
            _UNIT_PERSIST["v"] = True
        except OSError as e:
            _UNIT_PERSIST["v"] = getattr(e, "errno", None) != errno.EROFS
    return _UNIT_PERSIST["v"]


_QUICK_UNIT_MARK = "# Written by swgPanel"
_QUICK_UNIT = """\
{mark}: {tool}-quick@.service was missing on this host, so no {tool} interface could survive a
# reboot. Safe to delete once the {label} tools' own package provides one.
[Unit]
Description={label} via {tool}-quick(8) for %I
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target
Documentation=man:{tool}-quick(8)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={bin} up %i
ExecStop={bin} down %i
Environment=WG_ENDPOINT_RESOLUTION_RETRIES=infinity

[Install]
WantedBy=multi-user.target
"""


def _unit_known(unit):
    try:
        return subprocess.run(["systemctl", "cat", unit], capture_output=True, text=True).returncode == 0
    except Exception:
        return False


def _ensure_quick_unit(tool):
    unit = tool + "-quick@.service"
    if _unit_known(unit):
        return True
    bin_ = shutil.which(tool + "-quick")
    if not bin_:
        return False
    try:
        with open(os.path.join(_UNIT_DIR, unit), "w") as f:
            f.write(_QUICK_UNIT.format(mark=_QUICK_UNIT_MARK, tool=tool, bin=bin_,
                                       label=("AmneziaWG" if tool == "awg" else "WireGuard")))
        os.chmod(os.path.join(_UNIT_DIR, unit), 0o644)
    except OSError:
        return False
    with contextlib.suppress(Exception):
        subprocess.run(["systemctl", "daemon-reload"], capture_output=True, text=True)
    return _unit_known(unit)


def _scope_available():
    if _IN_CONTAINER or not os.path.isdir("/run/systemd/system") or not shutil.which("systemd-run"):
        return False
    try:
        return subprocess.run(["systemd-run", "--scope", "--quiet", "--collect", "true"],
                              capture_output=True, text=True, timeout=15).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _quick_target(ic, iface):
    conf = (ic or {}).get("conf") or ""
    if conf and os.path.basename(conf) == iface + ".conf" and os.path.isfile(conf):
        return conf
    return iface


def _quick_up(tool, iface, target=""):
    plain = [tool + "-quick", "up", target or iface]
    if not _scope_available():
        return run(plain)
    return run(["systemd-run", "--scope", "--quiet", "--collect", "--description=swg " + iface + " (" + tool + "-quick up)"] + plain)


def _iface_unit(action, tool, iface):
    if not _units_persist() or not shutil.which("systemctl"):
        return None
    if action == "enable" and not _ensure_quick_unit(tool):
        return False
    try:
        return subprocess.run(["systemctl", action, f"{tool}-quick@{iface}"],
                              capture_output=True, text=True).returncode == 0
    except Exception:
        return False


_EXEC_DENIED_RE = re.compile(
