_AA_PROFILES = "/sys/kernel/security/apparmor/profiles"
_AA_TOOLS = ("wg", "wg-quick", "awg", "awg-quick")


def _aa_enforced_tools():
    try:
        with open(_AA_PROFILES) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    out = set()
    for ln in lines:
        name, _, mode = ln.strip().rpartition(" ")
        if mode != "(enforce)" or "//" in name:
            continue
        if name.rsplit("/", 1)[-1] in _AA_TOOLS:
            out.add(name.rsplit("/", 1)[-1])
    return sorted(out)


