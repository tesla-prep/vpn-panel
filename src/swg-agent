def op_create_iface(cfg, req):
    iface = (req.get("iface") or "").strip()
    req_tool = (req.get("cmd") or ["awg"])[0]
    add_obf = (req_tool == "awg")
    have = lambda t: bool(shutil.which(t) and shutil.which(t + "-quick"))
    tool = req_tool if have(req_tool) else ("awg" if have("awg") else req_tool)
    cmd = [tool]
    if not iface or "/" in iface or " " in iface:
        raise AgentError("bad_request", "invalid interface name")
    try:
        net = ipaddress.ip_network(req.get("subnet") or "", strict=False)
    except Exception:
        raise AgentError("bad_request", "subnet must be a CIDR like 10.8.0.0/24")
    try:
        port = int(req.get("listen_port") or 51820)
    except (TypeError, ValueError):
        raise AgentError("bad_request", "listen_port must be a number")
    mtu = str(req.get("mtu") or "1280")
    _ensure_tool(tool)
    conf_dir = "/etc/amnezia/amneziawg" if tool == "awg" else "/etc/wireguard"
    conf = os.path.join(conf_dir, iface + ".conf")
    if subprocess.run(["ip", "link", "show", "dev", iface], capture_output=True).returncode == 0:
        raise AgentError("name_taken", f"an interface named {iface} already exists on this node - choose a free name")
    if os.path.exists(conf):
        raise AgentError("exists", f"{conf} already exists")
    os.makedirs(conf_dir, exist_ok=True)
    priv = (req.get("private_key") or "").strip()
    if not priv:
        priv = run(cmd + ["genkey"]).strip()
        if not priv:
            raise AgentError("internal", f"{tool} genkey produced no key")
    pub = run(cmd + ["pubkey"], input_text=priv + "\n").strip()
    ov_addr = (req.get("address") or "").strip()
    if ov_addr:
        try:
            addr = str(ipaddress.ip_interface(ov_addr))
        except Exception:
            raise AgentError("bad_request", "address must be CIDR like 10.99.0.0/31")
    else:
        addr = f"{net.network_address + 1}/{net.prefixlen}"
    wan = _wan_iface()
    up, down = _nat_hooks(net, wan)
    body = (f"#swg:cmd {tool}\n"
            f"[Interface]\nPrivateKey = {priv}\nAddress = {addr}\nListenPort = {port}\nMTU = {mtu}\n"
            f"PostUp = {up}\nPostDown = {down}\n")
    if (req.get("table") or "").strip().lower() == "off":
        body += "Table = off\n"
    if tool == "awg" and add_obf:
        supp = req.get("awg_params") if isinstance(req.get("awg_params"), dict) else None
        supp = {k: str(supp[k]) for k in AWG_KEYS if supp and str(supp.get(k, "")) != ""} if supp else None
        if req.get("awg_params_exact") and not supp:
            raise AgentError("awg_empty_exact", "an AmneziaWG interface needs at least one AmneziaWG parameter — create a "
                                                "WireGuard interface instead")
        if supp and (req.get("awg_params_exact") or "HeaderProtectionKey" in supp):
            body += "".join(f"{k} = {supp[k]}\n" for k in AWG_KEYS if k in supp)
        elif supp:
            _gen = _awg_obfuscation("2.0")
            _out = []
            for _ln in _gen.splitlines():
                _k = _ln.split("=")[0].strip()
                _out.append(f"{_k} = {supp[_k]}" if _k in supp else _ln)
            _seen = {l.split("=")[0].strip() for l in _out}
            _out += [f"{k} = {supp[k]}" for k in AWG_KEYS if k in supp and k not in _seen]
            body += "\n".join(_out) + "\n"
        else:
            body += _awg_obfuscation("2.0")
    write_conf_atomic(conf, body)
    try:
        _quick_up(tool, iface)
    except Exception as e:
        with contextlib.suppress(Exception):
            os.unlink(conf)
        msg = str(e)
        _denied = _denied_error(msg)
        if _denied:
            raise _denied
        if "Unknown device type" in msg or "Protocol not supported" in msg:
            kr = os.uname().release
            mod = "amneziawg" if tool == "awg" else "wireguard"
            if _declarative():
                raise AgentError("no_module",
                                 f"the {mod} kernel module isn't built or loaded on this node (kernel {kr}), "
                                 f"and this node's installation is managed declaratively. Add the module to the "
                                 f"system configuration that declares this node — it must come from the same "
                                 f"kernel package set as the running kernel (on NixOS: "
                                 f"boot.extraModulePackages = [ config.boot.kernelPackages.{mod} ];) — and "
                                 f"rebuild. The userspace datapath is the fallback if the module lags your "
                                 f"kernel. Then the interface creates automatically on the next sync.")
            if tool == "awg":
                how = (f"sudo apt-get install -y dkms linux-headers-{kr} && "
                       f"sudo apt-get install -y amneziawg && sudo modprobe amneziawg")
            else:
                how = "sudo apt-get install -y wireguard && sudo modprobe wireguard"
            raise AgentError("no_module",
                             f"the {mod} kernel module isn't built/loaded "
                             f"on this node (kernel {kr}) — its DKMS module needs matching linux-headers. Run on the "
                             f"node:  {how}  — then the interface creates automatically on the next sync. "
                             f"(Re-running the node installer, or swg-update, does this for you.)")
        if "already exists" in msg.lower():
            raise AgentError("name_taken", f"an interface named {iface} already exists on this node - choose a free name")
        raise AgentError("up_failed", f"{tool}-quick up {iface} failed (port/subnet may be in use): {e}")
    _unit = _iface_unit("enable", tool, iface)
    return {"iface": iface, "public_key": pub, "address": addr, "conf": conf, "cmd": cmd,
            "listen_port": port, "unit_enabled": _unit}


_EGRESS_MASQ_RE = re.compile(r"-s (\S+) -o (\S+) (-m comment --comment \S+ )?-j MASQUERADE")

def _reap_egress_rules(conf_text, iface):
    m = _EGRESS_MASQ_RE.search(conf_text or "")
    if not m:
        return
    net, wan = m.group(1), m.group(2)
    masq = (["-m", "comment", "--comment", NAT_TAG + iface] if m.group(3) else [])
    for args in (["-t", "nat", "-D", "POSTROUTING", "-s", net, "-o", wan] + masq + ["-j", "MASQUERADE"],
                 ["-D", "FORWARD", "-i", iface, "-o", wan, "-j", "ACCEPT"],
                 ["-D", "FORWARD", "-i", wan, "-o", iface, "-m", "state",
                  "--state", "RELATED,ESTABLISHED", "-j", "ACCEPT"]):
        for _ in range(_IPT_REAP_TRIES):
            try:
                if subprocess.run(["iptables"] + args, capture_output=True, text=True).returncode != 0:
                    break
            except Exception:
                break


_LEGACY_MASQ_RE = re.compile(r"POSTROUTING -s (\S+) -o (\S+) -j MASQUERADE")


def _reap_own_nat(iface):
    try:
        out = subprocess.run(["iptables", "-t", "nat", "-S", "POSTROUTING"], capture_output=True, text=True).stdout or ""
    except Exception:
        return
    tag = re.compile(r'--comment "?%s"?(?=\s|$)' % re.escape(NAT_TAG + iface))
    for ln in out.splitlines():
        if not ln.startswith("-A POSTROUTING ") or not tag.search(ln):
            continue
        try:
            args = shlex.split(ln)
        except ValueError:
            continue
        with contextlib.suppress(Exception):
            subprocess.run(["iptables", "-t", "nat", "-D"] + args[1:], capture_output=True)


def op_tag_nat_hooks(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    path = ic["conf"]
    text = read_conf(path)
    if re.search(r"(?m)^\s*#swg:onboarded\b", text):
        return {"iface": iface, "changed": False, "live": False, "why": "adopted — its hooks are its own"}
    lines, pairs, changed = text.splitlines(), set(), False
    for i, ln in enumerate(lines):
        m = re.match(r"(?i)(\s*Post(?:Up|Down)\s*=\s*)(.*)$", ln)
        if not m:
            continue
        body = m.group(2)
        for mm in _EGRESS_MASQ_RE.finditer(body):
            pairs.add((mm.group(1), mm.group(2)))
        new_body = _LEGACY_MASQ_RE.sub(lambda mm: _nat_masq(mm.group(1), mm.group(2)), body)
        if new_body != body:
            lines[i] = m.group(1) + new_body
            changed = True
    if changed:
        write_conf_atomic(path, "\n".join(lines).rstrip("\n") + "\n")
    live = subprocess.run(["ip", "link", "show", iface], capture_output=True).returncode == 0
    if live:
        for net, wan in sorted(pairs):
            legacy = ["POSTROUTING", "-s", net, "-o", wan, "-j", "MASQUERADE"]
            tagged = ["POSTROUTING", "-s", net, "-o", wan, "-m", "comment", "--comment", NAT_TAG + iface, "-j", "MASQUERADE"]
            if subprocess.run(["iptables", "-t", "nat", "-C"] + tagged, capture_output=True).returncode != 0:
                subprocess.run(["iptables", "-t", "nat", "-A"] + tagged, capture_output=True)
            for _ in range(_IPT_REAP_TRIES):
                if subprocess.run(["iptables", "-t", "nat", "-D"] + legacy, capture_output=True).returncode != 0:
                    break
    return {"iface": iface, "changed": changed, "live": live, "rules": sorted("%s via %s" % p for p in pairs)}


def op_delete_iface(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    tool = (ic.get("cmd") or ["awg"])[0]
    conf_text = ""
    with contextlib.suppress(Exception):
        conf_text = read_conf(ic["conf"])
    with contextlib.suppress(Exception):
        run([tool + "-quick", "down", _quick_target(ic, iface)])
    if os.path.exists(os.path.join(_SYS_NET, iface)):
        with contextlib.suppress(Exception):
            run(["ip", "link", "delete", "dev", iface])
    _reap_egress_rules(conf_text, iface)
    _reap_own_nat(iface)
    _iface_unit("disable", tool, iface)
    with contextlib.suppress(Exception):
        os.remove(ic["conf"])
    for twin_text in _remove_conf_twins(iface, ic.get("conf") or ""):
        _reap_egress_rules(twin_text, iface)
    return {"iface": iface, "deleted": True}


_CONF_DIRS = ("/etc/amnezia/amneziawg", "/etc/wireguard")
_SYS_NET = "/sys/class/net"


def _remove_conf_twins(iface, removed):
    texts = []
    for d in _CONF_DIRS:
        p = os.path.join(d, iface + ".conf")
        if removed and os.path.abspath(p) == os.path.abspath(removed):
            continue
        try:
            if os.path.islink(p):
                if not removed or os.path.realpath(p) != os.path.realpath(removed):
                    continue
                text = ""
            elif os.path.isfile(p):
                with open(p) as f:
                    text = f.read()
                if not re.search(r"(?m)^#swg:", text.split("[Interface]", 1)[0]):
                    continue
            else:
                continue
            os.remove(p)
            texts.append(text)
        except OSError:
            continue
    return texts


