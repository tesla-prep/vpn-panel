_AWG_GEN_ORDER = {"2.0": 0, "3.0": 1, "3.1": 2}
_SYS = "/sys"
_PROC = "/proc"
AWG_GO_PATHS = ("/usr/local/sbin/amneziawg-go", "/usr/local/bin/amneziawg-go", "/usr/sbin/amneziawg-go", "/usr/bin/amneziawg-go")


def _awg_fallback():
    return bool(shutil.which("amneziawg-go")) or any(os.access(p, os.X_OK) for p in AWG_GO_PATHS)


def _awg_devs_elsewhere():
    out = []
    for ln in subprocess.run(["ip", "netns", "list"], capture_output=True, text=True).stdout.splitlines():
        ns = ln.split()[0] if ln.split() else ""
        if ns and _awg_kernel_devs(ns):
            out.append(ns)
    if not (shutil.which("lsns") and shutil.which("nsenter")):
        return None
    try:
        me = os.readlink(_PROC + "/self/ns/net")
    except OSError:
        me = ""
    ls = subprocess.run(["lsns", "-t", "net", "-J", "-o", "NS,PID,NSFS"], capture_output=True, text=True)
    try:
        rows = json.loads(ls.stdout).get("namespaces") if ls.returncode == 0 else None
        hosts = open(_PROC + "/1/mountinfo").read().splitlines()
    except (ValueError, AttributeError, OSError):
        return None
    if not isinstance(rows, list):
        return None
    look, seen = [], set()
    for r in rows:
        ns, pid, nsfs = str((r or {}).get("ns") or ""), (r or {}).get("pid"), (r or {}).get("nsfs")
        seen.add(ns)
        if not ns or "net:[%s]" % ns == me:
            continue
        if pid:
            look.append((ns, "%s/%s/ns/net" % (_PROC, pid), "process %s" % pid))
        elif nsfs:
            look.append((ns, str(nsfs).split("\n")[0], "mounted at %s" % str(nsfs).split("\n")[0]))
        else:
            return None
    for ln in hosts:
        a, sep, b = ln.partition(" - ")
        f = a.split()
        if not sep or b.split()[:1] != ["nsfs"] or len(f) < 5 or not re.fullmatch(r"net:\[\d+\]", f[3]):
            continue
        ns = f[3][5:-1]
        if ns in seen or f[3] == me:
            continue
        seen.add(ns)
        mp = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), f[4])
        look.append((ns, _PROC + "/1/root" + mp, "mounted at %s" % mp))
    for ns, path, how in look:
        p = subprocess.run(["nsenter", "--net=" + path, "ip", "-o", "link", "show", "type", "amneziawg"],
                           capture_output=True, text=True)
        if p.returncode != 0:
            return None
        if (p.stdout or "").strip():
            out.append("net:[%s] (%s)" % (ns, how))
    return out

def _awg_ver_gen(v):
    m = re.match(r"^\s*(\d+)\.(\d+)", v or "")
    if not m:
        return None
    a, b = int(m.group(1)), int(m.group(2))
    return "2.0" if a == 1 else ("3.1" if a == 3 and b >= 1 else ("3.0" if a == 3 else None))


def _awg_kernel_devs(ns=None):
    p = subprocess.run(["ip"] + (["-n", ns] if ns else []) + ["-o", "link", "show", "type", "amneziawg"],
                       capture_output=True, text=True)
    return [ln.split(":", 2)[1].strip().split("@")[0] for ln in (p.stdout or "").splitlines() if ln.count(":") >= 2]


def op_reload_awg_module(cfg, req):
    if _IN_CONTAINER:
        raise AgentError("container", "the kernel module is the host's — load it on the host")
    loaded = ""
    with contextlib.suppress(OSError):
        loaded = open(_SYS + "/module/amneziawg/version").read().strip()
    disk = subprocess.run(["modinfo", "-F", "version", "amneziawg"], capture_output=True, text=True).stdout.strip()
    gl, gd = _awg_ver_gen(loaded), _awg_ver_gen(disk)
    if not loaded:
        raise AgentError("not_loaded", "the AmneziaWG kernel module is not loaded")
    if gd is None or _AWG_GEN_ORDER[gd] <= _AWG_GEN_ORDER.get(gl, -1):
        raise AgentError("nothing_newer", f"the installed module ({disk or 'none'}) is not newer than the loaded one ({loaded})")
    awg = shutil.which("awg") or ""
    if _AWG_GEN_ORDER[gd] >= 1:
        key = b"RandomTrailers" if gd == "3.1" else b"HeaderProtectionKey"
        try:
            with open(awg, "rb") as f:
                ok_tools = key in f.read()
        except OSError:
            ok_tools = False
        if not ok_tools:
            raise AgentError("tools_old", "the awg tools predate AmneziaWG %s and could not configure the new module" % gd)
    if not _awg_fallback():
        raise AgentError("no_fallback", "no amneziawg-go to fall back on if the new module would not load")
    ns_busy = _awg_devs_elsewhere()
    if ns_busy is None:
        raise AgentError("cannot_check", "lsns or nsenter is missing, so the other network namespaces cannot be checked")
    if ns_busy:
        raise AgentError("other_netns", "an AmneziaWG device lives in network namespace " + ", ".join(ns_busy))
    extra = {k: v for k, v in (req.get("extra_confs") or {}).items() if isinstance(v, str)}
    plan, no_way = [], []
    for dev in _awg_kernel_devs():
        by_unit = _unit_started("awg", dev)
        conf = extra.get(dev) or ""
        if not conf:
            with contextlib.suppress(Exception):
                conf = _quick_target(iface_cfg(cfg, dev), dev)
        if not conf or conf == dev:
            conf = next((c for c in ("/etc/amnezia/amneziawg/%s.conf" % dev, "/etc/amneziawg/%s.conf" % dev)
                         if os.path.isfile(c)), "")
        if not by_unit and not conf:
            no_way.append(dev)
        plan.append((dev, by_unit, conf))
    if no_way:
        raise AgentError("no_way_back", "no unit or configuration brings back: " + ", ".join(no_way))

    def _down(dev, by_unit, conf):
        if by_unit:
            run(["systemctl", "stop", f"awg-quick@{dev}"], check=False)
        else:
            with contextlib.suppress(Exception):
                run(["awg-quick", "down", conf])
        for _ in range(100):
            if not os.path.exists(_SYS + f"/class/net/{dev}"):
                break
            time.sleep(0.1)

    def _up(dev, by_unit, conf):
        with contextlib.suppress(Exception):
            if by_unit:
                run(["systemctl", "start", f"awg-quick@{dev}"], check=False)
            else:
                _quick_up("awg", dev, conf)
        if not os.path.exists(_SYS + f"/class/net/{dev}"):
            return "down"
        return "userspace" if os.path.exists(_SYS + f"/class/net/{dev}/tun_flags") else "kernel"

    def _record(res):
        rp = req.get("result_path") or ""
        if rp:
            with contextlib.suppress(OSError):
                tmp = rp + ".tmp"
                with open(tmp, "w") as f:
                    json.dump(dict(res, id=req.get("id") or ""), f)
                os.replace(tmp, rp)
        return res

    for step in plan:
        _down(*step)
    if _awg_kernel_devs() or subprocess.run(["modprobe", "-r", "amneziawg"], capture_output=True).returncode != 0:
        ifaces = {step[0]: _up(*step) for step in plan}
        _record({"result": "busy", "was": loaded, "loaded": loaded, "ifaces": ifaces})
        raise AgentError("busy", "the kernel module could not be unloaded — every interface was brought back as it was")
    load_ok = subprocess.run(["modprobe", "amneziawg"], capture_output=True).returncode == 0
    ifaces = {step[0]: _up(*step) for step in plan}
    now = ""
    with contextlib.suppress(OSError):
        now = open(_SYS + "/module/amneziawg/version").read().strip()
    return _record({"result": "done" if load_ok and now else "load_failed", "was": loaded, "loaded": now, "ifaces": ifaces})


def op_restore_iface_key(cfg, req):
    iface = req["iface"]
    ic = iface_cfg(cfg, iface)
    priv = (req.get("private_key") or "").strip()
    if not priv:
        raise AgentError("bad_request", "private_key required")
    fields = {"PrivateKey": priv}
    if req.get("address"):
        fields["Address"] = req["address"]
    if req.get("listen_port"):
        fields["ListenPort"] = str(req["listen_port"])
    set_iface_fields_in_conf(ic["conf"], fields)
    tool = (ic.get("cmd") or ["awg"])[0]
    target = _quick_target(ic, iface)
    with contextlib.suppress(Exception):
        run([tool + "-quick", "down", target])
    try:
        _quick_up(tool, iface, target)
    except Exception as e:
        _denied = _denied_error(str(e))
        if _denied:
            raise _denied
        raise AgentError("up_failed", f"{tool}-quick up {iface} failed after key restore: {e}")
    return {"iface": iface, "restored": True}



def respond(ok, op, data=None, error=None, code=None):
    out = {"ok": ok, "op": op}
    if ok:
        out["data"] = data
    else:
        out["error"] = error
        out["code"] = code
    print(json.dumps(out))
    sys.exit(0 if ok else 1)


READ_OPS = {"describe": op_describe, "list-peers": op_list_peers, "next-ip": op_next_ip}
WRITE_OPS = {"add-peer": op_add_peer, "remove-peer": op_remove_peer, "set-iface": op_set_iface,
             "set-peer-allowed": op_set_peer_allowed, "persist-peer-endpoint": op_persist_peer_endpoint,
             "tag-nat-hooks": op_tag_nat_hooks,
             "create-iface": op_create_iface, "delete-iface": op_delete_iface, "restart-iface": op_restart_iface,
             "stop-iface": op_stop_iface, "start-iface": op_start_iface,
             "restore-iface-key": op_restore_iface_key, "reload-awg-module": op_reload_awg_module}


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--awg-params" and sys.argv[2] in ("2.0", "3.1"):
        sys.stdout.write(_awg_obfuscation(sys.argv[2]))
        return
    try:
        req = json.load(sys.stdin)
    except Exception as e:
        respond(False, None, error=f"invalid JSON request: {e}", code="bad_request")
    op = req.get("op")
    if isinstance(req.get("log_level"), int):
        os.environ["SWG_LOG_LEVEL"] = str(req["log_level"])
    try:
        cfg = load_config()
        if op in READ_OPS:
            respond(True, op, data=READ_OPS[op](cfg, req))
        elif op in WRITE_OPS:
            with locked():
                data = WRITE_OPS[op](cfg, req)
            audit(op, req)
            respond(True, op, data=data)
        else:
            respond(False, op, error=f"unknown op {op!r}", code="unknown_op")
    except AgentError as e:
        respond(False, op, error=e.msg, code=e.code)
    except KeyError as e:
        respond(False, op, error=f"missing field {e}", code="bad_request")
    except Exception as e:
        respond(False, op, error=str(e), code="internal")


if __name__ == "__main__":
    main()
