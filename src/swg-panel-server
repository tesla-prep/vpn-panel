        uid = body.get("id") or ""
        roster = roster_load(roster_path)
        if uid not in roster["users"]:
            return 404, {"ok": False, "error": "unknown user", "code": "not_found"}
        fields = {}
        for k in ("name", "tag", "note", "vk_link"):
            if k in body:
                v = body[k]
                fields[k] = v.strip() if (isinstance(v, str) and k != "note") else v
        if "name" in fields and not fields["name"]:
            return 400, {"ok": False, "error": "name cannot be empty", "code": "bad_request"}
        if "vk_link" in fields:                              # per-user VK call link baked into their turn-proxy configs
            vk = _vk_link_norm(fields.get("vk_link"))[:512]   # a bare hash → its link
            if vk and not _VK_CALL_RE.match(vk):
                return 400, {"ok": False, **perr("Not a VK call link or its hash — expected https://vk.ru/call/join/…"), "code": "bad_request"}
            fields["vk_link"] = vk
        if "vk_links" in body:                               # the FULL ordered set of a user's VK call links (index 0 = primary)
            raw = body.get("vk_links")
            if not isinstance(raw, list):
                return 400, {"ok": False, "error": "vk_links must be a list", "code": "bad_request"}
            links = []
            for item in raw:
                s = _vk_link_norm(item)[:512]                # a bare hash → its link
                if not s:
                    continue
                if not _VK_CALL_RE.match(s):
                    return 400, {"ok": False, **perr("Not a VK call link or its hash — expected https://vk.ru/call/join/…"), "code": "bad_request"}
                links.append(s)
            fields["vk_links"] = links
        if "expiry" in body:                                 # subscription-wide expiry date (epoch secs; 0/"" clears it)
            exp = coerce_expiry(body.get("expiry"))
            if exp is None:
                return 400, {"ok": False, "error": "expiry must be an epoch timestamp or 0", "code": "bad_request"}
            if exp:
                # A subscription can't expire before its longest-lived peer — that peer would outlive the sub.
                maxpeer = max((int(p.get("expiry") or 0) for p in roster["peers"].values()
                               if isinstance(p, dict) and p.get("user_id") == uid), default=0)
                if maxpeer and exp < maxpeer:
                    return 400, {"ok": False, **perr("Subscription expiry can't be earlier than a peer's expiry ({v1})", v1=fmt_day(maxpeer)), "code": "bad_request"}
            fields["expiry"] = exp
        if "static_exit" in body:
            value = body["static_exit"]
            fields["static_exit"] = None
            if value is not None:
