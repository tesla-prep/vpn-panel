    feeds, _ = _block_feeds(cat, block_providers_enabled(ps), nid, node.get("routing_mode") or "kernel",
                           [cid for cid in cat if cid in selected])
    out = []
    for cid, pairs in feeds.items():
        paths = tuple(_list_path(sid, tier) for sid, tier in pairs if tier == "host")
        if paths:
