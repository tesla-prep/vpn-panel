        nodes[nid].pop("mesh_awg_gen", None)   # the per-node type of an unreleased build (plan §8 round 12): dead, dropped as we pass
        _mesh_after = (nodes[nid].get("mesh_subnet") or "", str(nodes[nid].get("mesh_port") or ""), nodes[nid].get("mesh_prefix") or "")
        if _mesh_after[0] != _mesh_before[0] or _mesh_after[2] != _mesh_before[2]:
