def turn_pin(owner, arches=None, wait=25, force=False):
    owner = (owner or "").strip()
    if not owner or "/" not in owner:
        return {}
    want = [a for a in (arches or TURN_ARCHES) if a in TURN_ARCHES] or list(TURN_ARCHES)
    now = time.time()
    if not force:
        c = _TURN_PIN_CACHE.get(owner)
        if c and (now - c["at"]) < _TURN_PIN_TTL and all(a in (c["pin"].get("sums") or {}) for a in want):
            return c["pin"]
    tag = _resolve_turn_tag(owner)
    if not tag:
        c = _TURN_PIN_CACHE.get(owner)
        return c["pin"] if c else {}
    sums, threads = {}, []
    for a in want:
        with _TURN_SUMS_LOCK:
            cached = _TURN_SUMS.get(owner + "|" + tag + "|" + a)
        if cached:
            sums[a] = cached
        else:
            t = threading.Thread(target=turn_sum, args=(owner, tag, a), daemon=True)
            t.start(); threads.append((a, t))
    deadline = now + max(1, wait)
    for a, t in threads:
        t.join(max(0.1, deadline - time.time()))
        with _TURN_SUMS_LOCK:
            s = _TURN_SUMS.get(owner + "|" + tag + "|" + a)
        if s:
            sums[a] = s
    pin = {"tag": tag, "sums": sums}
    _TURN_PIN_CACHE[owner] = {"pin": pin, "at": now}
    return pin


