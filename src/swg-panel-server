def _blku_merge_write(cat, tier, paths, extra=None):
    prev = list_meta(cat, tier)
    files = []
    try:
        for p in paths:
            files.append(open(p, "r", encoding="utf-8", errors="replace"))
    except Exception:
        for f in files:
            with contextlib.suppress(Exception):
                f.close()
        return prev, "fetch-failed"
    tmp = _list_path(cat, tier) + ".merge." + uuid.uuid4().hex[:8] + ".tmp"
    h = hashlib.sha1(); n = 0; last = None
    try:
        os.makedirs(LIST_DIR, exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as out:
            gens = ((ln.rstrip("\n") for ln in f) for f in files)
            for dom in heapq.merge(*gens):
                if not dom or dom == last:
                    continue
                last = dom
                line = dom + "\n"
                out.write(line); h.update(line.encode()); n += 1
    except Exception:
        with contextlib.suppress(Exception):
            os.remove(tmp)
        return prev, "fetch-failed"
    finally:
        for f in files:
            with contextlib.suppress(Exception):
                f.close()
    return _list_commit(cat, tier, h.hexdigest()[:12], n, lambda: os.replace(tmp, _list_path(cat, tier)),
                        tmp=tmp, extra=extra, protect_count=False)


def _blk_file_has(path, target):
    tb = target.encode("utf-8", "ignore")
    try:
        with open(path, "rb") as f:
            f.seek(0, 2); hi = f.tell(); lo = 0
            while lo < hi:
                mid = (lo + hi) // 2
                f.seek(mid)
                if mid:
                    f.readline()
                line = f.readline()
                if not line:
                    hi = mid; continue
                val = line.rstrip(b"\n")
                if val == tb:
                    return True
                if val < tb:
                    lo = f.tell()
                else:
                    hi = mid
    except OSError:
        return False
    return False


def _blk_cat_srcpaths(deps, nid, node):
