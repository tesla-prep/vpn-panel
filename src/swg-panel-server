        tsha, unl, tbs = body.get("token_sha"), body.get("unlock_by_sk"), body.get("token_by_sk")
        if not (isinstance(tsha, str) and isinstance(unl, str) and isinstance(tbs, str)):
            return 400, {"ok": False, "error": "token_sha, unlock_by_sk and token_by_sk are required", "code": "bad_request"}
        users = load_sub_users(deps); escrow = load_sub_escrow(deps)
        prev = escrow.get(uid) or {}
        users[uid] = {"token_sha": tsha, "enabled": True}            # PUBLIC map (swg-sub reads this) — no secrets
        # NEVER overwrite an existing unlock-key: a user may already hold encrypted-config blobs (from the config
        # store) encrypted under it — replacing it would orphan them. Enabling only adds the URL token on top.
        escrow[uid] = {"unlock_by_sk": prev.get("unlock_by_sk") or unl, "token_by_sk": tbs,
                       "created": prev.get("created") or now(), "rotated": now()}
        save_sub_users(deps, users); save_sub_escrow(deps, escrow)
        ev_append(roster_path, "user", uid, "Enabled subscription", (roster["users"][uid] or {}).get("name", ""))
        return 200, {"ok": True, "data": {"enabled": True}}

    if method == "POST" and path == "/api/sub/user/rotate":          # new token (same unlock-key) → old URL dies
        uid = body.get("user_id") or ""
