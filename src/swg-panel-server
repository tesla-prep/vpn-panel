    return os.path.join(stats_dir, "peer-" + nid + "-" + hashlib.sha256((pubkey or "").encode()).hexdigest()[:16] + ".rrd")
RANGE_SPEC = {"live": (0, 200, 200 * 15), "hour": (0, 250, 3600), "day": (1, 300, 86400),
              "week": (2, 350, 7 * 86400), "month": (3, 400, 30 * 86400)}
RANGE_CUSTOM_DAYS = 33   # a custom chart window reaches back this many local days, today included — what the coarsest ring holds


def resolve_range(qs, dflt="day", now=None):
    """(ring, want, since, until, axis) for ?range=<named> or ?range=custom&from=&to= (YYYY-MM-DD, the panel's days).

    Named: exactly RANGE_SPEC — since = now - window, until None, axis None, so a named reply stays byte-identical.
    Custom: whole local days — since = from's midnight, until = min(now, the midnight after to) — read off the finest ring
    whose capacity still reaches back to since. `axis` = {rangeKey, step, since, until}: the reply carries it and the SPA
    reads its step from there (a volume is Σ mean B/s × step), never from a per-range map.

    ⚠️ Never adds to RANGE_SPEC: _rings_dead_after() reads its widest window as the GC age of every ring.
    Raises ValueError(perr(...)); the caller answers 400."""
    now = time.time() if now is None else now
    rng = (qs.get("range") or [dflt])[0]                    # read exactly as every endpoint always has (no strip, no
    if rng != "custom":                                      # default for an empty value) — callers index RANGE_SPEC by it
        spec = RANGE_SPEC.get(rng)
        if not spec:
            raise ValueError({"error": "range must be live|hour|day|week|month|custom"})
        ring, want, win = spec
        return ring, want, now - win, None, None
    f, t = _ld_from_to(qs)
    today = _ld_day(now)[0]
    t = min(t, today)
    if f > t:
        raise ValueError(perr("from must not be after to"))
    first = _ld_of(_ld_date(today) - _ldt.timedelta(days=RANGE_CUSTOM_DAYS - 1))
    if f < first:
        raise ValueError(perr("The charts keep {v1} days: a custom window can start on {v2} at the earliest",
                              v1=RANGE_CUSTOM_DAYS, v2=_ld_date(first).isoformat()))
    since, until = _ld_midnight(f), min(int(now), _ld_midnight(_ld_next(t)))
    ring = next((i for i, (st, n) in enumerate(HRRD_RINGS) if since >= now - (n - 1) * st), len(HRRD_RINGS) - 1)
    step, nslots = HRRD_RINGS[ring]
    # Whole local days only: every ring's step divides a day and the rings count from local midnight, so a window always
    # lies on whole buckets — never the one straddling bucket that neither end would pass (a 0 where traffic was, §8.2).
    axis = {"rangeKey": "custom:%d-%d" % (f, t), "step": step, "since": int(since), "until": int(until)}
    return ring, nslots, since, until, axis


def _local_bars(since, until, step, off=None):
    """Bars of `step` seconds from `since` (a local midnight): (count, each bar's start epoch, the bar an epoch falls in).
    DAY bars are laid on the LOCAL clock — laid on the epoch, a day bar after a DST change starts at 23:00 or 01:00 and takes
    the next day's first hour. Shorter bars are real seconds — on the local clock a fall-back's repeated hour would fold two
    real hours into one bar. `off(epoch)` is the UTC offset in force (the gate passes its own)."""
    if step % 86400:
        n = max(1, min(64, -(-(until - since) // step)))
        return n, [since + i * step for i in range(n)], lambda ep: int((ep - since) // step)
    off = off or (lambda e: time.localtime(e).tm_gmtoff or 0)
    w0 = since + off(since)
    n = max(1, min(64, -(-((until + off(until)) - w0) // step)))
    starts = [w - off(w - off(w)) for w in (w0 + i * step for i in range(n))]
    return n, starts, lambda ep: int((ep + off(ep) - w0) // step)


def range_or_400(qs, dflt="day"):
    """resolve_range() for an endpoint: (spec, None), or (None, the 400 reply)."""
    try:
        return resolve_range(qs, dflt), None
    except ValueError as e:
        m = e.args[0] if e.args and isinstance(e.args[0], dict) else {"error": str(e)}
        return None, (400, {"ok": False, **m, "code": "bad_request"})

OFFENDER_TTL = RANGE_CUSTOM_DAYS * 86400 + 3600   # drop an offender once unseen longer than the widest window (a custom one, 33 days) + slack
OFFENDER_MAX = 4000                   # per metric — offenders are few, but cap memory hard regardless
OFFENDER_METRICS = ("torrent", "scan")   # metrics with genuine per-source presence (blocked drops by dst → no source)

HRRD_HEAD = struct.Struct("<4sBII")           # magic, version, ring0_step, ring0_slots
HRRD_MNAMES = ["cpu", "mem", "disk", "rx", "tx", "arx", "atx", "mrx", "mtx", "inet_up", "inet_down", "pon", "ptot", "paon", "patot"]
HRRD_NM = len(HRRD_MNAMES)
_PCT_IDX = (0, 1, 2)                            # NA-aware percentage bytes
_U32_IDX = (3, 4, 5, 6, 7, 8, 9, 10)           # rx/tx-style counters incl. inet up/down (mean-consolidated)
_U16_IDX = (11, 12, 13, 14)                    # peer counts (mean-consolidated)
HRRD_SLOT = struct.Struct("<IBBBBIIIIIIIIHHHH")  # bucket, cpu,mem,disk,count, rx,tx,arx,atx,mrx,mtx,inet_up,inet_down, pon,ptot,paon,patot (48 B)
HRRD_SLOT_V6 = struct.Struct("<IBBBBIIIIIIHHHH") # pre-v7 40-byte slot — read only, to migrate v6 history (inserts inet as 0)
HRRD_SLOT_V5 = struct.Struct("<IBBBBII")       # legacy 16-byte slot — read only, to migrate a pre-v6 file's history
HRRD_NA = 255
HRRD_U32 = 0xFFFFFFFF
HRRD_U16 = 0xFFFF
HRRD_TOTAL = sum(n for _, n in HRRD_RINGS)
def _ring_base(i):                  # byte offset of ring i within the file
    return HRRD_HEAD.size + sum(n for _, n in HRRD_RINGS[:i]) * HRRD_SLOT.size
_hrrd_lock = threading.Lock()

def _pctb(v):  return HRRD_NA if v == HRRD_NA else max(0, min(254, int(v)))
def _u32b(v):  return max(0, min(HRRD_U32, int(v)))
def _u16b(v):  return max(0, min(HRRD_U16, int(v)))


def snap_aggregates(snap, node_cfg):
    """Per-node dashboard aggregates from a snapshot the node already POSTs (no node change). Splits client
    vs mesh (system link ifaces) and wg vs awg, and counts client peer deployments online/total. Which ifaces
    are system comes from the node's panel-side `ifaces` overrides; wg/awg from the reported awg_params."""
    ov = (node_cfg or {}).get("ifaces") or {}
    a = {k: 0 for k in ("rx", "tx", "arx", "atx", "mrx", "mtx", "pon", "ptot", "paon", "patot")}
    for ifn, blk in ((snap or {}).get("interfaces") or {}).items():
        meta = blk.get("meta") or {}
        o = ov.get(ifn) or {}
        is_sys = bool(o.get("system") or meta.get("system"))
        is_awg = bool(meta.get("awg_params") or o.get("awg_params"))
        irx = itx = on = tot = 0
        for p in (blk.get("peers") or []):
            irx += p.get("rx_speed", 0) or 0
            itx += p.get("tx_speed", 0) or 0
            if not is_sys:
                tot += 1
                if p.get("online"):
                    on += 1
        a["rx"] += irx; a["tx"] += itx                          # total across every iface (= snap_traffic)
        if is_sys:
            a["mrx"] += irx; a["mtx"] += itx                     # mesh link traffic
        else:
            a["pon"] += on; a["ptot"] += tot
            if is_awg:
                a["arx"] += irx; a["atx"] += itx; a["paon"] += on; a["patot"] += tot
    for w in ((snap or {}).get("wdtt") or []):
        if not w:
            continue
        wr = int(w.get("rx_speed", 0) or 0); wt = int(w.get("tx_speed", 0) or 0)
        a["rx"] += wr; a["tx"] += wt
        devs = (w.get("passwords") or {})
        on = sum(1 for e in devs.values() if (e or {}).get("online"))
        a["pon"] += on; a["ptot"] += len(devs)
    # csqtt instances also own their TUN (raw datapath) → fold their throughput + online counts in too, same as WDTT.
    for c in ((snap or {}).get("csqtt") or []):
        if not c:
            continue
        a["rx"] += int(c.get("rx_speed", 0) or 0); a["tx"] += int(c.get("tx_speed", 0) or 0)
        devs = (c.get("passwords") or {})
        a["pon"] += sum(1 for e in devs.values() if (e or {}).get("online")); a["ptot"] += len(devs)
    return a


def snap_traffic(snap):
    """Aggregate (rx, tx) bytes/sec across all interfaces' peers in a node snapshot."""
    rx = tx = 0
    for blk in ((snap or {}).get("interfaces") or {}).values():
        for p in (blk.get("peers") or []):
            rx += p.get("rx_speed", 0) or 0
            tx += p.get("tx_speed", 0) or 0
    return int(rx), int(tx)


CPU_SAT_PCT = 90        # a vCPU at/above this is "saturated" (must match SAT_PCT in js/screen-nodes.js)


def health_pcts(health):
    """(cpu, mem, disk) integer percentages from a snapshot health block, NA where absent.
    CPU is real utilization (0-100, mean across cores); disk is the busiest mount."""
    if not isinstance(health, dict):
        return None
    def pc(used, total):
        return HRRD_NA if not total else max(0, min(100, round(used / total * 100)))
    cpu = HRRD_NA
    cpu_pct = health.get("cpu_pct")
    load = health.get("load")
    if isinstance(cpu_pct, (int, float)):
        cpu = max(0, min(100, round(cpu_pct)))
    elif isinstance(load, list) and load:
        cpu = max(0, min(254, round((load[0] or 0) / (health.get("ncpu") or 1) * 100)))
    m = health.get("mem") or {}
    mem = pc(m.get("used", 0), m.get("total", 0))
    disk = HRRD_NA
    for d in (health.get("disk") or []):
        if d.get("total"):
            disk = max(0 if disk == HRRD_NA else disk, pc(d["used"], d["total"]))
    return (cpu, mem, disk)


def _hrrd_ok(path):
    try:
        with open(path, "rb") as f:
            magic, ver, step, slots = HRRD_HEAD.unpack(f.read(HRRD_HEAD.size))
        return magic == HRRD_MAGIC and ver == HRRD_VER and (step, slots) == HRRD_RINGS[0]
    except (OSError, struct.error):
        return False


def _bucket_of(ts, step):         # LOCAL-time-aligned bucket id for a timestamp (clean week/month boundaries)
    off = time.localtime(ts).tm_gmtoff or 0
    return ((int(ts) + off) // step) & 0xFFFFFFFF


def _bucket_epoch(bucket, step):  # inverse: a bucket id back to the real epoch of its local boundary
    wall = bucket * step
    return wall - (time.localtime(wall).tm_gmtoff or 0)


def _avg_pct(old, new, cnt):      # incremental mean of two pct bytes, NA-aware (cnt = samples already in bucket)
    if new == HRRD_NA: return old
    if old == HRRD_NA or cnt <= 0: return new
    return max(0, min(254, round((old * cnt + new) / (cnt + 1))))


def _avg_u(old, new, cnt, cap):   # incremental mean of a counter (no NA sentinel)
    new = min(max(int(new), 0), cap)
    if cnt <= 0: return new
    return min(round((old * cnt + new) / (cnt + 1)), cap)


def _slot_write(f, base, slots, bucket, M, cnt):
    """Write the metric vector M (HRRD_NM values) + sample count into `bucket`'s slot."""
    vals = ([bucket & 0xFFFFFFFF, _pctb(M[0]), _pctb(M[1]), _pctb(M[2]), min(max(cnt, 0), 255) & 0xFF]
            + [_u32b(M[i]) for i in _U32_IDX] + [_u16b(M[i]) for i in _U16_IDX])
    f.seek(base + (bucket % slots) * HRRD_SLOT.size)
    f.write(HRRD_SLOT.pack(*vals))


def _slot_read(f, base, slots, bucket):
    """(M, cnt) if the slot for `bucket` currently holds it, else None. M = HRRD_NM-value metric vector."""
    f.seek(base + (bucket % slots) * HRRD_SLOT.size)
    cur = f.read(HRRD_SLOT.size)
    if len(cur) == HRRD_SLOT.size:
        u = HRRD_SLOT.unpack(cur)
        if u[0] == (bucket & 0xFFFFFFFF):
            # u = bucket, cpu,mem,disk,count, rx,tx,arx,atx,mrx,mtx,inet_up,inet_down, pon,ptot,paon,patot
            M = [u[1], u[2], u[3]] + list(u[5:5 + len(_U32_IDX)]) + list(u[5 + len(_U32_IDX):])
            return (M, u[4])
    return None


def _hrrd_put_raw(f, base, slots, bucket, M):
    # ring0 only: fold a raw sample into its 15s bucket as an incremental mean (~3 samples/bucket,
    # so no rounding drift). A new bucket resets the slot, overwriting the stale wrap value.
    bucket &= 0xFFFFFFFF
    cur = _slot_read(f, base, slots, bucket)
    if cur is not None:                          # same bucket → fold into the existing mean
        M0, cnt = cur
        for j in _PCT_IDX: M[j] = _avg_pct(M0[j], M[j], cnt)
        for j in _U32_IDX: M[j] = _avg_u(M0[j], M[j], cnt, HRRD_U32)
        for j in _U16_IDX: M[j] = min(max(M0[j], M[j]), HRRD_U16)
        _slot_write(f, base, slots, bucket, M, cnt + 1)
    else:
        _slot_write(f, base, slots, bucket, M, 1)


def _hrrd_consolidate(f, i, ts):
    # ring i (>=1): recompute its CURRENT bucket as the fresh mean of the (already-averaged) children
    # it covers in ring i-1. One rounding per metric, NA-aware for pct; counters straight mean.
    step, slots = HRRD_RINGS[i]
    cbase = _ring_base(i - 1); cslots = HRRD_RINGS[i - 1][1]
    ratio = HRRD_RATIO[i]
    bucket = _bucket_of(ts, step)
    kids = [r[0] for k in range(bucket * ratio, bucket * ratio + ratio)
            if (r := _slot_read(f, cbase, cslots, k)) is not None]
    if not kids:
        return
    out = [0] * HRRD_NM
    for j in _PCT_IDX:
        vs = [k[j] for k in kids if k[j] != HRRD_NA]
        out[j] = round(sum(vs) / len(vs)) if vs else HRRD_NA
    for j in _U32_IDX:                         # rates → mean over the children
        out[j] = round(sum(k[j] for k in kids) / len(kids))
    for j in _U16_IDX:                         # headcounts → PEAK over the children (see _hrrd_put_raw)
        out[j] = max(k[j] for k in kids)
    _slot_write(f, _ring_base(i), slots, bucket, out, len(kids))


def _hrrd_feed(f, ts, M):
    # one sample (metric vector M) → ring0 (raw incremental mean) then recompute the coarser rings for ts.
    step0, slots0 = HRRD_RINGS[0]
    _hrrd_put_raw(f, _ring_base(0), slots0, _bucket_of(ts, step0), list(M))
    for i in range(1, len(HRRD_RINGS)):              # 5min ← 15s, 30min ← 5min, 2h ← 30min
        _hrrd_consolidate(f, i, ts)


def _hrrd_salvage(path):
    """Read an OLDER-layout RRD's finest ring before we recreate it, so a format-version change MIGRATES
    history into the new rings instead of wiping the graph. Returns [(ts, M), …] from the file's header-declared
    ring0, or None if nothing is salvageable. A pre-v6 file's slots are the legacy 16-byte layout (cpu/mem/disk +
    rx/tx); its new fields (awg/mesh/counts) carry as 0 and refill over time."""
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return None
    if len(data) < HRRD_HEAD.size or data[:4] != HRRD_MAGIC:
        return None                                  # absent / not ours / truncated header → nothing to carry
    _, ver, step0, slots0 = HRRD_HEAD.unpack_from(data, 0)
    if ver == HRRD_VER and (step0, slots0) == HRRD_RINGS[0]:
        return None                                  # same layout (would've passed _hrrd_ok) → nothing to do
    if not (0 < step0 <= 86400 and 0 < slots0 <= 100000):
        return None                                  # implausible header → don't trust the body
    sst = HRRD_SLOT_V5 if ver <= 5 else HRRD_SLOT_V6 if ver == 6 else HRRD_SLOT
    pts = []
    for i in range(slots0):                          # the file's own ring0 = its finest history
        off = HRRD_HEAD.size + i * sst.size
        if off + sst.size > len(data):
            break
        u = sst.unpack_from(data, off)
        b = u[0]
        if not b:
            continue
        if ver <= 5:                                 # b, cpu,mem,disk,count, rx,tx  → pad new fields with 0
            M = [u[1], u[2], u[3], u[5], u[6]] + [0] * (HRRD_NM - 5)
        elif ver == 6:                               # v6: 6 u32 (rx,tx,arx,atx,mrx,mtx) + 4 u16 (pon..patot) —
            M = [u[1], u[2], u[3]] + list(u[5:11]) + [0, 0] + list(u[11:15])   # insert inet_up/down (0) after mtx
        else:
            M = [u[1], u[2], u[3]] + list(u[5:5 + len(_U32_IDX)]) + list(u[5 + len(_U32_IDX):])
        pts.append((b * step0, M))
    pts.sort(key=lambda x: x[0])
    return pts or None


_hrrd_healed = set()          # paths already recreated once — the log line is worth seeing, a loop of them is not


def _ring_drop_unwritable(path, make):
    """A ring file owned by a DIFFERENT uid can never be written again — and because every writer wraps its
    write in `suppress(OSError)`, that failure is invisible: the ring freezes, the chart reads a flat zero,
    and nothing anywhere says why. (Seen live: a panel that had once run as root left nine root-owned rings
    behind, so fleet throughput, turn throughput and presence all sat at zero while the per-interface rings
    written after it were fine.)

    The stats dir is ours, so replace the file. Losing that ring's history costs a graph its past; keeping it
    costs the graph its present, permanently, with no signal. Logged once per path — a self-heal that keeps
    firing is a real ownership problem, not a hiccup."""
    with contextlib.suppress(OSError):
        os.unlink(path)
    ok = False
    with contextlib.suppress(OSError):
        make(path)
        ok = True
    if path not in _hrrd_healed:
        _hrrd_healed.add(path)
        log(LOG_WARNING, "stats: %s was not writable (owned by another user) — recreated%s", os.path.basename(path), "" if ok else " FAILED")
    return ok


def hrrd_update(path, ts, M):
    """Append one metric vector M (HRRD_NM values) at time ts to the per-node ring."""
    ts = int(ts)
    with _hrrd_lock:
        if not _hrrd_ok(path):                    # (re)create: header + all rings zeroed (also upgrades older versions)
            carry = _hrrd_salvage(path)           # migrate an older-format file's history instead of wiping it
            with contextlib.suppress(OSError):
                if carry and os.path.exists(path):
                    os.replace(path, path + ".bak")   # keep the pre-migration original recoverable
                with open(path, "wb") as f:
                    f.write(HRRD_HEAD.pack(HRRD_MAGIC, HRRD_VER, HRRD_RINGS[0][0], HRRD_RINGS[0][1]))
                    f.write(b"\x00" * (HRRD_SLOT.size * HRRD_TOTAL))
                if carry:
                    with open(path, "r+b") as f:
                        for (cts, cM) in carry:
                            _hrrd_feed(f, cts, cM)
        for _try in (0, 1):
            try:
                with open(path, "r+b") as f:
                    _hrrd_feed(f, ts, M)
                return
            except PermissionError:
                if _try or not _ring_drop_unwritable(path, _hrrd_blank):
                    return
            except OSError:
                return


def _hrrd_blank(path):
    with open(path, "wb") as f:
        f.write(HRRD_HEAD.pack(HRRD_MAGIC, HRRD_VER, HRRD_RINGS[0][0], HRRD_RINGS[0][1]))
        f.write(b"\x00" * (HRRD_SLOT.size * HRRD_TOTAL))
    with contextlib.suppress(OSError):
        os.chmod(path, 0o644)


# presence rings: WHICH peers were online in each bucket
PRES_MAGIC = b"SWGP"
PRES_VER = 1
PRES_BITS0 = 512                                   # initial bitmap width; grows (doubling) as the fleet does
PRES_HEAD = struct.Struct("<4sBIII")               # magic, ver, ring0_step, ring0_slots, bits
_pres_lock = threading.Lock()


def pres_path(stats_dir, nid):
    return os.path.join(stats_dir, "presence-" + nid + ".rrd")


def _pres_slot(bits):
    return 4 + bits // 8                           # u32 bucket + bitmap


def _pres_base(i, bits):
    return PRES_HEAD.size + sum(n for _, n in HRRD_RINGS[:i]) * _pres_slot(bits)


def _pres_size(bits):
    return PRES_HEAD.size + sum(n for _, n in HRRD_RINGS) * _pres_slot(bits)


def pres_index_path(stats_dir):
    return os.path.join(stats_dir, "presence-index.json")


def pres_bits_for(pubkeys, stats_dir):
    """Stable fleet-wide pubkey → bit index. Bits are never reused while the map lives, so a bitmap written
    yesterday still means the same peers today. Returns {pubkey: bit} for the requested keys."""
    path = pres_index_path(stats_dir)
    with _pres_lock:
        try:
            idx = json.loads(open(path).read())
        except Exception:
            idx = {}
        changed = False
        for pk in pubkeys:
            if pk not in idx:
                idx[pk] = len(idx)                 # append-only: next free bit
                changed = True
        if changed:
            with contextlib.suppress(Exception):
                atomic_write(path, json.dumps(idx), mode=0o600)
        return idx


def pres_width(npeers):
    """Bitmap width for a fleet of `npeers` — powers of two from PRES_BITS0."""
    bits = PRES_BITS0
    while bits < max(1, npeers):
        bits *= 2
    return bits


def _pres_ensure(path, bits):
    """Create the file, or widen it when the fleet outgrows the bitmap. Returns the width actually on disk.

    Widening rewrites the file empty: bitmaps cannot be re-packed in place, and a fleet crossing a power of
    two is a once-ever event. Losing presence history is strictly better than silently reinterpreting bits.
    """
    with contextlib.suppress(OSError):
        with open(path, "rb") as f:
            head = f.read(PRES_HEAD.size)
        if len(head) == PRES_HEAD.size:
            magic, ver, s0, n0, obits = PRES_HEAD.unpack(head)
            if magic == PRES_MAGIC and ver == PRES_VER and (s0, n0) == HRRD_RINGS[0] \
               and obits >= bits and os.path.getsize(path) >= _pres_size(obits):
                return obits
    with open(path, "wb") as f:                    # (re)create, zeroed
        f.write(PRES_HEAD.pack(PRES_MAGIC, PRES_VER, HRRD_RINGS[0][0], HRRD_RINGS[0][1], bits))
        f.write(b"\x00" * (_pres_size(bits) - PRES_HEAD.size))
    os.chmod(path, 0o644)
    return bits


def pres_feed(path, ts, bit_list, bits):
    """OR `bit_list` into ring0's bucket for ts, then rebuild each coarser ring's current bucket as the OR of
    its children. OR is the whole point: union loses nothing, unlike the mean/max the numeric rings use.
    In-place slot writes only — never rewrites the file."""
    with _pres_lock:
        bits = _pres_ensure(path, bits)
        # Same trap as the numeric rings: a file owned by another uid opens read-only, the caller's
        # suppress(Exception) hides it, and "Online peers" flatlines with nothing to see. The dir is ours.
        if not os.access(path, os.W_OK):
            _ring_drop_unwritable(path, lambda p2: _pres_ensure(p2, bits))
        slot = _pres_slot(bits); nb = bits // 8
        with open(path, "r+b") as f:
            def rd(i, bucket):
                ns = HRRD_RINGS[i][1]
                f.seek(_pres_base(i, bits) + (bucket % ns) * slot)
                raw = f.read(slot)
                if len(raw) != slot:
                    return (0, bytearray(nb))
                return (struct.unpack_from("<I", raw, 0)[0], bytearray(raw[4:]))

            def wr(i, bucket, bm):
                ns = HRRD_RINGS[i][1]
                f.seek(_pres_base(i, bits) + (bucket % ns) * slot)
                f.write(struct.pack("<I", bucket & 0xFFFFFFFF) + bytes(bm))

            b0 = _bucket_of(ts, HRRD_RINGS[0][0])
            cur, bm = rd(0, b0)
            acc = bytearray(nb) if cur != (b0 & 0xFFFFFFFF) else bm      # a new bucket starts clean (stale wrap)
            for bit in bit_list:
                if 0 <= bit < bits:
                    acc[bit >> 3] |= 1 << (bit & 7)
            wr(0, b0, acc)

            for i in range(1, len(HRRD_RINGS)):
                bucket = _bucket_of(ts, HRRD_RINGS[i][0])
                ratio = HRRD_RATIO[i]
                un = bytearray(nb)
                for k in range(bucket * ratio, bucket * ratio + ratio):
                    cb, cbm = rd(i - 1, k)
                    if cb == (k & 0xFFFFFFFF):
                        for j in range(nb):
                            un[j] |= cbm[j]
                wr(i, bucket, un)


def pres_scan(path, ring, since, until=None):
    """[(bucket_epoch, bitmap_bytes)] for in-window buckets of `ring`. Same stale-bucket rule as hrrd_read."""
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return []
    if len(data) < PRES_HEAD.size or data[:4] != PRES_MAGIC:
        return []
    _, ver, s0, n0, bits = PRES_HEAD.unpack_from(data, 0)
    if ver != PRES_VER or (s0, n0) != HRRD_RINGS[0] or len(data) < _pres_size(bits):
        return []
    step, ns = HRRD_RINGS[ring]
    base = _pres_base(ring, bits); slot = _pres_slot(bits); nb = bits // 8
    out = []
    for i in range(ns):
        off = base + i * slot
        b = struct.unpack_from("<I", data, off)[0]
        if not b:
            continue
        ep = _bucket_epoch(b, step)
        if ep < since or (until is not None and ep >= until):
            continue
        out.append((ep, data[off + 4:off + 4 + nb]))
    out.sort(key=lambda x: x[0])
    return out


def _bm_bits(bm):
    for i, byte in enumerate(bm):
        while byte:
            b = byte & -byte
            yield (i << 3) + b.bit_length() - 1
            byte ^= b


def hrrd_repair_counts(path):
    """One-shot: rebuild rings 1..3's u16 HEADCOUNTS as the MAX of their children.

    Buckets written before headcount consolidation changed from mean→max hold averaged counts that round to 0
    in the coarse rings: a turn-proxy carrying one peer for ten minutes of a two-hour bucket stored `pon = 0`,
    so Month reported "0 peers" beside real traffic while Hour reported 1. Those buckets are never rewritten,
    so without this they keep lying until they age out — up to 33 days for ring3.

    Only buckets whose children still exist can be repaired (ring0 holds 62 min, ring1 25 h, ring2 7.3 d), so
    the deep past keeps its old values and ages out. Rates (u32/pct) are untouched: their mean is correct."""
    changed = False
    with _hrrd_lock:
        if not _hrrd_ok(path):
            return False
        try:
            with open(path, "r+b") as f:
                for i in range(1, len(HRRD_RINGS)):
                    slots = HRRD_RINGS[i][1]
                    cbase, cslots = _ring_base(i - 1), HRRD_RINGS[i - 1][1]
                    ratio = HRRD_RATIO[i]
                    for si in range(slots):
                        f.seek(_ring_base(i) + si * HRRD_SLOT.size)
                        raw = f.read(HRRD_SLOT.size)
                        if len(raw) != HRRD_SLOT.size:
                            break
                        b = HRRD_SLOT.unpack(raw)[0]
                        if not b:
                            continue
                        cur = _slot_read(f, _ring_base(i), slots, b)
                        if cur is None:
                            continue
                        M, cnt = cur
                        kids = [r[0] for k in range(b * ratio, b * ratio + ratio)
                                if (r := _slot_read(f, cbase, cslots, k)) is not None]
                        if not kids:
                            continue
                        newM = list(M)
                        for j in _U16_IDX:
                            newM[j] = max(k[j] for k in kids)
                        if newM != M:
                            _slot_write(f, _ring_base(i), slots, b, newM, cnt)
                            changed = True
        except OSError:
            return False
    return changed


def hrrd_repair_all(stats_dir):
    """Run hrrd_repair_counts over every ring in stats_dir, once per install (marker file)."""
    if not stats_dir:
        return
    marker = os.path.join(stats_dir, ".counts-repaired-v1")
    if os.path.exists(marker):
        return
    n = fixed = 0
    with contextlib.suppress(OSError):
        for fn in sorted(os.listdir(stats_dir)):
            if not fn.endswith(".rrd") or fn.startswith("presence-"):
                continue
            n += 1
            with contextlib.suppress(Exception):
                if hrrd_repair_counts(os.path.join(stats_dir, fn)):
                    fixed += 1
    with contextlib.suppress(Exception):
        atomic_write(marker, str(int(time.time())), mode=0o644)
    log(LOG_INFO, "headcount repair: rebuilt peak counts in %d of %d rings", fixed, n)


def _rings_dead_after():
    """Seconds of silence after which a ring can no longer contribute a single bucket to ANY range.

    Derived, never a magic number: the widest thing a ring can hold is `step * buckets` of its coarsest tier,
    and the widest thing anyone can ASK for is the largest `RANGE_SPEC` window — every ranged read passes
    `since = now - window`, so a bucket older than that is filtered out on the way back. Past the larger of
    the two, `hrrd_read` returns nothing from this file no matter what is in it. Change HRRD_RINGS and this
    follows; that is the whole point of computing it.

    Plus two days, because the cost of being early is deleting history somebody could still see, and the cost
    of being late is 61 KB."""
    span = max(step * n for step, n in HRRD_RINGS)
    window = max(spec[2] for spec in RANGE_SPEC.values())
    return max(span, window) + 2 * 86400


def rings_gc(stats_dir):
    """Delete rings nothing has written for longer than any range can read.

    ⚠️ THE LEAK IS PER-SUBJECT, NOT PER-BYTE, and that is why it went unnoticed. Every ring is a
    fixed-size circular buffer — 62,413 bytes, wrapping for ever — so no individual file grows. What grows is
    the NUMBER of them: one per (node, peer), (node, interface), (node, category), (node, exit), mesh pair,
    turn fork… and nothing removed one when its subject stopped existing. MEASURED on the qualification
    panel, which is as small as a fleet gets — 4 nodes, 3 peers: 104 rings, of which 69 had no live subject.
    4.2 MB of 6.3 MB, 66% waste, and only ever upward. The worst family was mesh link interfaces: every
    re-provision mints a fresh `swg_<hash>` and leaves the old ring behind for good. There were also rings
    for a node that had been removed from the fleet entirely.

    ⚠️ IT SWEEPS BY MTIME, NOT BY SUBJECT, and the difference is the safety of the whole thing. Matching each
    file back to a live subject means re-deriving eight different key schemes (a sha256 prefix here, a
    node-id split there, a sanitised fork name in the middle) — eight chances to get one wrong and delete a
    ring that is very much alive. An mtime cannot be mis-derived. And the rule it implements is stronger than
    "the subject is gone": a file this old is one that `hrrd_read` would return NOTHING from, so removing it
    destroys no information that any range could still show. A peer ring is only written above
    PEER_MIN_BPS, so a genuinely idle peer's ring is swept too — correctly, because it holds nothing
    readable either, and the next byte through recreates it."""
    if not stats_dir:
        return 0, 0
    cutoff = time.time() - _rings_dead_after()
    gone = freed = 0
    with contextlib.suppress(OSError):
        for fn in os.listdir(stats_dir):
            if not fn.endswith(".rrd"):
                continue
            fp = os.path.join(stats_dir, fn)
            with contextlib.suppress(OSError):
                st = os.stat(fp)
                if st.st_mtime >= cutoff:
                    continue
                os.unlink(fp)
                gone += 1; freed += st.st_size
    if gone:
        log(LOG_INFO, "rings gc: removed %d ring(s) unwritten for over %d days (%.1f MB)", gone, _rings_dead_after() // 86400, freed / 1048576.0)
    return gone, freed


def hrrd_read(path, ring=0, want=HRRD_VIEW, slim=False, since=None, until=None):
    """Most recent `want` buckets from ring index `ring`, optionally only those at/after `since` and before `until` (epoch).
    ⚠️ Both filters run BEFORE the tail slice: sliced first, a window that ended in the past would keep the newest
    buckets and then drop them all — an empty chart and a 0 total where traffic was.

    **`since` is what makes a ranged read honest.** A ring is circular and its slots are never cleared, so a
    lazily-written ring — peer rings are gated on PEER_MIN_BPS, category rings only get written when that
    category sees traffic — keeps its last buckets forever once the peer/category goes idle. Without a cutoff
    a "last hour" query happily sums traffic from a day ago (observed: peer rings whose newest bucket was 22h
    old still contributing every byte to `range=hour`). The health ring is written every sync so it self-heals,
    which is why this went unnoticed there.

    slim=True returns only the legacy fields {t,cpu,mem,disk,rx,tx} (for the /api/state bundle — keeps the 5s
    hot path small); slim=False adds the dashboard fields {arx,atx,mrx,mtx,pon,ptot,paon,patot}. NA percentages
    → None. Timestamps are the real epoch of each bucket's local-time boundary."""
    with _hrrd_lock:
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            return None
    if len(data) < HRRD_HEAD.size or data[:4] != HRRD_MAGIC:
        return None
    _, ver, step0, slots0 = HRRD_HEAD.unpack_from(data, 0)
    if ver != HRRD_VER or (step0, slots0) != HRRD_RINGS[0]:   # old layout — show nothing till it refills
        return None
    step, nslots = HRRD_RINGS[ring]
    base = _ring_base(ring)
    rows = []
    for i in range(nslots):
        off = base + i * HRRD_SLOT.size
        if off + HRRD_SLOT.size > len(data):
            break
        u = HRRD_SLOT.unpack_from(data, off)         # bucket, cpu,mem,disk,count, rx,tx,arx,atx,mrx,mtx,inet_up,inet_down, pon,ptot,paon,patot
        if u[0]:
            rows.append(u)
    if not rows:
        return None
    rows.sort(key=lambda r: r[0])
    if since is not None:                                    # drop stale buckets left behind by a lazily-written ring
        rows = [r for r in rows if _bucket_epoch(r[0], step) >= since]
        if not rows:
            return None
    if until is not None:                                    # a custom window that ended in the past (resolve_range)
        rows = [r for r in rows if _bucket_epoch(r[0], step) < until]
        if not rows:
            return None
    rows = rows[-want:]
    na = lambda v: None if v == HRRD_NA else v
    out = {"t": [_bucket_epoch(r[0], step) for r in rows],
           "cpu": [na(r[1]) for r in rows], "mem": [na(r[2]) for r in rows], "disk": [na(r[3]) for r in rows],
           "rx": [r[5] for r in rows], "tx": [r[6] for r in rows]}
    if slim:                                          # keep the /api/state bundle small; mrx/mtx let the hero net out mesh
        out["mrx"] = [r[9] for r in rows]; out["mtx"] = [r[10] for r in rows]
        out["pon"] = [r[13] for r in rows]            # online-peer count per bucket → live online-bars read the ring (full + survives reload), not just a client accumulator
        return out
    out.update({"arx": [r[7] for r in rows], "atx": [r[8] for r in rows], "mrx": [r[9] for r in rows], "mtx": [r[10] for r in rows],
                "inet_up": [r[11] for r in rows], "inet_down": [r[12] for r in rows],   # measured internet up/down (B/s means)
                "pon": [r[13] for r in rows], "ptot": [r[14] for r in rows], "paon": [r[15] for r in rows], "patot": [r[16] for r in rows]})
    return out


