NODE_SIG_WINDOW = max(30, int(os.environ.get("SWG_PANEL_SIG_WINDOW", "300") or 300))
REQUIRE_NODE_SIG = os.environ.get("SWG_PANEL_REQUIRE_SIG", "").strip().lower() in ("1", "true", "yes", "on")
_NODE_SIG_SEEN = {}
_NODE_SIG_LOCK = threading.Lock()



AUTH_FAIL_FREE   = 5
AUTH_FAIL_DELAY  = 0.4
AUTH_FAIL_MAX    = 4.0
AUTH_FAIL_WINDOW = 900
_AUTH_FAILS = {}
_AUTH_FAILS_LOCK = threading.Lock()


def _authfail_state(bucket):
    with _AUTH_FAILS_LOCK:
        n, at = _AUTH_FAILS.get(bucket, (0, 0.0))
        if n and (time.time() - at) > AUTH_FAIL_WINDOW:
            _AUTH_FAILS.pop(bucket, None)
            return 0, 0.0
        return n, (time.time() - at if at else 0.0)


def _authfail_note(bucket):
    with _AUTH_FAILS_LOCK:
        n, at = _AUTH_FAILS.get(bucket, (0, 0.0))
        if n and (time.time() - at) > AUTH_FAIL_WINDOW:
            n = 0
        n += 1
        _AUTH_FAILS[bucket] = (n, time.time())
        return n


def _authfail_clear(bucket):
    with _AUTH_FAILS_LOCK:
        _AUTH_FAILS.pop(bucket, None)


def _authfail_delay(bucket):
    n, _ = _authfail_state(bucket)
    if n < AUTH_FAIL_FREE:
        return 0.0
    return min(AUTH_FAIL_MAX, AUTH_FAIL_DELAY * (2 ** (n - AUTH_FAIL_FREE)))




def _verify_node_sig(token_sha, ts, mac, body):
    if not token_sha:
        return False, "unverifiable"
    try:
        t = int(ts)
    except (TypeError, ValueError):
        return False, "bad-timestamp"
    now = int(time.time())
    if abs(now - t) > NODE_SIG_WINDOW:
        return False, "stale"
    bsha = hashlib.sha256(body or b"").hexdigest()
    expect = hmac.new(token_sha.encode(), (str(ts) + "." + bsha).encode(), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expect, (mac or "").strip().lower()):
        return False, "mismatch"
    with _NODE_SIG_LOCK:
        if _NODE_SIG_SEEN.get(mac, 0) > now:
            return False, "replay"
        if len(_NODE_SIG_SEEN) > 20000:
            for k in [k for k, e in _NODE_SIG_SEEN.items() if e <= now]:
                _NODE_SIG_SEEN.pop(k, None)
        _NODE_SIG_SEEN[mac] = now + NODE_SIG_WINDOW + 5
    return True, ""


def _node_cred_same(before, now):
    if now.get("token_sha") and before.get("token_sha"):
        return hmac.compare_digest(now["token_sha"], before["token_sha"])
    return bool(now.get("token_hash")) and now.get("token_hash") == before.get("token_hash")


def find_node_by_token(nodes, token):
    if not token:
        return None, None
    tsha = hashlib.sha256(token.encode()).hexdigest()
    for nid, n in nodes.items():
        ts = n.get("token_sha")
        if ts and hmac.compare_digest(ts, tsha):
            return nid, n
    for nid, n in nodes.items():
        if n.get("token_sha"):
            continue
        if verify_password(n.get("token_hash", ""), token):
            return nid, n
    return None, None


