        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Assigned peer", peer_label(roster, p2),
                  "fresh key issued", detail_key="fresh key issued")
        # the fresh key is encrypted into the peer's blob by the browser (subMaybePublish); no plaintext at rest.
        return 200, {"ok": True, "data": p2}

    if method == "POST" and path == "/api/peers/adopt":
        # Pull a peer observed on a node (an orphan) into the roster. Known key → add the
        # target to the existing credential; new key → mint a peer (unassigned by default).
        pubkey = (body.get("pubkey") or "").strip()
        target = body.get("target") or {}
        for f in ("node", "iface", "ip"):
            if not target.get(f):
                return 400, {"ok": False, **perr("target.{v1} is required", v1=f), "code": "bad_request"}
        if not pubkey:
            return 400, {"ok": False, "error": "pubkey is required", "code": "bad_request"}
        if not known(target["node"]):
            return 400, {"ok": False, **perr("unknown node {v1}", v1=repr(target["node"])), "code": "bad_request"}
        if is_system_iface(deps, nodes, target["node"], target["iface"]):
            return 400, {"ok": False, **perr("{v1} is a system mesh link — not a peer interface", v1=target["iface"]), "code": "system_iface"}
        _akind = iface_kind(deps, nodes, snaps, target["node"], target["iface"], target.get("type") or "")
        if is_keyless_kind(_akind):
            return 400, {"ok": False, **perr("{v1} is a self-contained turn server — add its users from the peer sheet, not by adopting a WireGuard key", v1=target["iface"]), "code": "wdtt_iface"}
        if not valid_addr(target["ip"]):
            return 400, {"ok": False, **perr("invalid address {v1}", v1=repr(target["ip"])), "code": "bad_request"}
        roster = roster_load(roster_path)
        uid = body.get("user_id")
        if uid and uid not in roster["users"]:
            return 400, {"ok": False, "error": "unknown user", "code": "bad_request"}
        target["type"] = _akind          # already resolved above (wg | awg), by the node, not the name
        existing = find_peer_by_pubkey(roster, pubkey)
        if existing:
            pid = existing["id"]
            if not any(t["node"] == target["node"] and t["iface"] == target["iface"]
                       for t in existing["targets"]):
                peer_set(roster, pid, {"targets": existing["targets"] + [target]}, now())
        else:
            pid = gen_id()
            while pid in roster["peers"]:
                pid = gen_id()
            peer_set(roster, pid, {"user_id": uid or None, "pubkey": pubkey,
                                   "psk": body.get("psk") or "", "targets": [target]}, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Adopted peer", peer_label(roster, roster["peers"][pid]),
                  f"{target['node']}/{target['iface']}")
        return 200, {"ok": True, "data": roster["peers"][pid]}

    if method == "POST" and path == "/api/peers/correct":
        pid = body.get("peer_id") or ""; tgt = body.get("target") or {}
        node = tgt.get("node") or ""; iface = (tgt.get("iface") or "").strip()
        roster = roster_load(roster_path)
        p = (roster.get("peers") or {}).get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        if node not in nodes:
            return 400, {"ok": False, "error": "unknown node", "code": "bad_request"}
        if not any(t.get("node") == node and t.get("iface") == iface for t in p.get("targets", [])):
            return 400, {"ok": False, "error": "peer has no such target", "code": "bad_request"}
        meta = (((deps.get("node_snaps") or {}).get(node) or {}).get("interfaces") or {}).get(iface) or {}
        subnet = (meta.get("meta") or {}).get("subnet")
        if not subnet:
            return 400, {"ok": False, "error": "interface isn't reporting a subnet (is it present and online?)", "code": "bad_request"}
        try:
            net = ipaddress.ip_network(subnet, strict=False)
        except Exception:
            return 400, {"ok": False, **perr("interface subnet {v1} is invalid", v1=repr(subnet)), "code": "bad_request"}
        # the targets to move: this peer's targets on THIS iface (one identity shares one IP across its nodes)
        movers = [t for t in p.get("targets", []) if t.get("iface") == iface]
        cur = ((movers[0].get("ip") if movers else "") or "").split("/")[0]
        try:
            if cur and ipaddress.ip_address(cur) in net:
                return 400, {"ok": False, "error": "peer IP is already inside the interface subnet — nothing to correct", "code": "bad_request"}
        except ValueError:
            pass
        same_iface_nodes = sorted({t.get("node") for t in movers if t.get("node") in nodes})
        nxt = panel_next_ip(snaps, roster, same_iface_nodes or [node], iface, nodes)
        if not nxt.get("ok"):
            return 400, {"ok": False, "error": nxt.get("error") or "no free address in the subnet", "code": nxt.get("code") or "bad_request"}
        new_ip = nxt["data"]["next_ip"].split("/")[0]
        for t in movers:
            t["ip"] = new_ip
        peer_set(roster, pid, {"targets": p["targets"]}, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Corrected peer address", peer_label(roster, roster["peers"][pid]),
                  f"{cur or '?'} → {new_ip} ({iface})")
        return 200, {"ok": True, "data": {"peer": roster["peers"][pid], "ip": new_ip, "was": cur}}

    # Block / unblock access (declarative revoke)
