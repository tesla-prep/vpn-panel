_TZ_BOOT = os.environ.get("TZ")
_TZ_NAME = re.compile(r"^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+){0,2}$")
_TZ_STATE = {"zone": "", "missing": "", "zones": None}


def _tz_dir():
    return os.environ.get("TZDIR") or "/usr/share/zoneinfo"


def tz_file(name):
    if not isinstance(name, str) or not _TZ_NAME.match(name) or name.split("/")[0] in ("posix", "right"):
        return ""
    path = os.path.join(_tz_dir(), name)
    try:
        with open(path, "rb") as f:
            return path if f.read(4) == b"TZif" else ""
    except OSError:
        return ""


def tz_apply(name):
    if name:
        path = tz_file(name)
        if not path:
            return False
        os.environ["TZ"] = path
    elif _TZ_BOOT is None:
        os.environ.pop("TZ", None)
    else:
        os.environ["TZ"] = _TZ_BOOT
    time.tzset()
    _TZ_STATE["zone"], _TZ_STATE["missing"] = name, ""
    return True


def _tz_short(name):
    p = (name or "").replace("_", " ").split("/")
    return p[-1] + (" (%s)" % p[1] if len(p) == 3 else "")


def tz_view():
    if "server" not in _TZ_STATE:
        n = (_TZ_BOOT or "").lstrip(":")
        if not n:
            with contextlib.suppress(OSError):
                n = os.path.normpath(os.path.join("/etc", os.readlink("/etc/localtime")))
        n = n[len(_tz_dir().rstrip("/")) + 1:] if n.startswith(_tz_dir().rstrip("/") + "/") else n
        _TZ_STATE["server"] = _tz_short(n) if _TZ_NAME.match(n) else ""
    lt = time.localtime()
    return {"zone": _TZ_STATE["zone"], "missing": _TZ_STATE["missing"], "server": _TZ_STATE["server"],
            "abbr": lt.tm_zone, "offset": lt.tm_gmtoff}


def tz_zones(browser=""):
    if _TZ_STATE["zones"] is None:
        names = set()
        with contextlib.suppress(OSError):
            with open(os.path.join(_tz_dir(), "zone.tab"), encoding="utf-8") as f:
                names = {p[2].strip() for p in (ln.split("\t") for ln in f if not ln.startswith("#")) if len(p) > 2}
        _TZ_STATE["zones"] = ["UTC"] * bool(tz_file("UTC")) + sorted(z for z in names if tz_file(z))
    alias = browser if isinstance(browser, str) and _TZ_NAME.match(browser) else ""
    found = alias if tz_file(alias) else ""
    if alias and not found:
        with contextlib.suppress(OSError):
            with open(os.path.join(_tz_dir(), "tzdata.zi"), encoding="utf-8") as f:
                link = next((p[1] for p in (ln.split() for ln in f if ln.startswith("L "))
                             if len(p) == 3 and p[2] == alias), "")
            found = link if tz_file(link) else ""
    return {"zones": _TZ_STATE["zones"], "browser": found}

