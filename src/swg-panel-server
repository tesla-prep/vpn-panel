_EXIT_REFUSALS = ("empty", "name", "loopback", "self", "mesh", "nic", "nic_nogw", "nic_wan",
                  "managed", "ingress", "imported")


def exit_device_refusal(c, dev, mesh_prefix="swg_", link_ifaces=(), iface=None, nics=(),
                        gws=None, wan="", gw_known=False):
    d = str(dev or "").strip()
    if not d:
        return "empty"
    if not _WANIF_RE.match(d) or d in (".", ".."):
        return "name"
    if d == "lo":
        return "loopback"
    if iface and d == str(iface):
        return "self"
    if d in set(link_ifaces or ()) or d.startswith(mesh_prefix or "swg_") or d.startswith("swg_"):
        return "mesh"
    if d in set(nics or ()):
        if wan and d == str(wan):
            return "nic_wan"
        if gws is None:
            return "nic"
        if not str((gws or {}).get(d) or "").strip() and not gw_known:
            return "nic_nogw"
    if d in {str((x or {}).get("device") or "") for x in (c.get("exits") or [])
             if isinstance(x, dict) and x.get("producer") == "imported"}:
        return "imported"
    for _w in (c.get("wdtt") or {}).items():
        if d == _w[0] or d == str((_w[1] or {}).get("raw_iface") or ""):
            return "ingress"
    if d in (c.get("csqtt") or {}):
        return "ingress"
    if d in (c.get("ifaces") or {}):
        return "managed"
    return None


