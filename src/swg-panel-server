def _parse_port_ranges(spec):
    out = []
    for part in str(spec or "").replace(" ", "").split(","):
        if not part:
            continue
        lo, _, hi = part.partition("-")
        if not lo.isdigit():
            continue
        a = int(lo)
        b = int(hi) if hi.isdigit() else a
        if 0 < a <= b <= 65535:
            out.append((a, b))
    return out


def _awg_datapath(snap):
