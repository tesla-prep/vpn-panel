        _cl_dropped = []      # §5.4 for the custom-list save — tokens this could not keep, reported not swallowed
        idf = incoming.get("interface_defaults")
        if isinstance(idf, dict):
            dns = idf.get("dns")
            _ag = idf.get("awg_gen") if idf.get("awg_gen") in ("2.0", "3.1") else (cur.get("interface_defaults") or {}).get("awg_gen")
            _a3 = idf.get("awg3_params")
            if isinstance(_a3, dict):
                # "-" = a 3.1 interface made from these gets no such line: kept as written, checked as absent (a timing
                # left out counts at WireGuard's default in the crossing check, as on an interface)
                _a3, _e3 = awg3_template_clean(_a3)
                if _e3:
                    return 400, {"ok": False, **_e3, "code": "bad_request"}
            else:
                _a3 = (cur.get("interface_defaults") or {}).get("awg3_params")
            _bad = awg_template_refusal(idf.get("awg_params"), perr("the interface defaults"),
                                        was=(cur.get("interface_defaults") or {}).get("awg_params"))
            if _bad:
                return 400, {"ok": False, **_bad, "code": "bad_request"}
            cur["interface_defaults"] = {
                "dns": (dns if isinstance(dns, list) else [s.strip() for s in str(dns or "").split(",") if s.strip()]),
                "mtu": int(idf.get("mtu") or 1280),
