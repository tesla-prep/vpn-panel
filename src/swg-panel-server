                taken.append(ipaddress.ip_network(str(ipaddress.IPv4Address(str(o.get("address") or "")) + 1) + "/32"))
        pair = None if any(t.version == 4 and DIALIN_NET.subnet_of(t) for t in taken) else \
            next((n for n in DIALIN_NET.subnets(new_prefix=31) if not any(n.overlaps(t) for t in taken)), None)
        if pair is None:
            return "", "no free address pair in 10.254.0.0/16 on this node — paste a config with your own address"
        node, router, mtu = str(pair[0]), str(pair[1]), 1280
        _tm = str(g.get("mtu") if g.get("mtu") is not None else "").strip()
        if _tm:
            if not re.fullmatch(r"[0-9]{1,5}", _tm) or not 576 <= int(_tm) <= 1500:
                return "", "the MTU must be a number from 576 to 1500"
            mtu = int(_tm)
        _tv, _tom = ctx.get("awg_tpl") or ({}, frozenset())
        _typed = g.get("awg") if isinstance(g.get("awg"), dict) and proto != "wg" else {}
        _ref = awg_template_refusal(_typed, perr("this exit"), gen3=proto == "awg3", was=None) if _typed else None
        if _ref:
            return "", _ref
        _uv, _uom = awg_template(_typed, gen3=proto == "awg3")
        if proto == "awg3" and any(not str(_uv[k]).isdigit() or int(_uv[k]) < 12 for k in ("S1", "S2", "S3", "S4") if k in _uv):
            return "", "S1–S4 must be at least 12 for AmneziaWG 3.1 — header protection refuses less"
        if proto == "awg3":
            _tv = {k: v for k, v in _tv.items() if not (k in ("S1", "S2", "S3", "S4") and not (str(v).isdigit() and int(v) >= 12))}
            _tom = _tom - {"S1", "S2", "S3", "S4"}
        _tv = {k: v for k, v in _tv.items() if not awg_value_refusal(k, v)}
        _tv, _tom = {**{k: v for k, v in _tv.items() if k not in _uom}, **_uv}, (_tom - set(_uv)) | _uom
        awg = {}
        if proto == "awg2":
            awg = {k: v for k, v in {**gen_awg_params("2.0"), **_tv}.items() if k not in _tom and k not in AWG3_FIELDS}
        elif proto == "awg3":
            awg = awg3_full(_tv, defaults=ctx.get("awg3"), omit=(frozenset(ctx.get("awg3_omit") or ()) - set(_uv)) | _tom,
                            s_max=max(AWG31_MIN_S, mesh_s4_room(mtu)))
        _rd = 0
        while _rd < 64 and all(str(awg.get(k, "")).isdigit() for k in ("S1", "S2")) and int(awg["S2"]) == int(awg["S1"]) + 56 \
                and not {"S1", "S2"} <= set(_tv):
            _rd += 1
            _k = "S2" if "S2" not in _tv else "S1"
            awg[_k] = str(gen_awg_params("3.1" if proto == "awg3" else "2.0")[_k])
        if "S4" in awg and "S4" not in _uv and not mesh_s4_fits(awg["S4"], mtu):
            awg["S4"] = str(mesh_s4_draw(mtu, AWG31_MIN_S if proto == "awg3" else 0))
        _ref = awg_rules(awg, perr("this exit"), gen3=proto == "awg3") if proto != "wg" else None
        if _ref:
            return "", _ref
    return ("[Interface]\nPrivateKey = %s\nAddress = %s/32\nMTU = %s\nListenPort = %d\n" % (pk, node, mtu, port)
            + "".join("%s = %s\n" % (k, awg[k]) for k in AWG_FIELDS if k in awg and str(awg[k]).strip() != "")
            + "\n[Peer]\nPublicKey = %s\n" % rk + ("PresharedKey = %s\n" % psk if psk else "")
            + "AllowedIPs = %s/32\n" % router), ""


def _dialin_ctx(deps, nodes, nid):
    c = nodes.get(nid) or {}
    snap = ((deps.get("node_snaps") or {}).get(nid) or {})
    ports = dict(_node_ports(deps, nodes, nid, skip_exits=True))
    ports.setdefault(WDTT_RAW_PORT, perr("RAW-IP (reserved)"))
    nets = []
    for ifn, blk in sorted((((deps.get("node_snaps") or {}).get(nid) or {}).get("interfaces") or {}).items()):
        with contextlib.suppress(ValueError, TypeError):
            if ((blk or {}).get("meta") or {}).get("subnet"):
                nets.append((ifn, ipaddress.ip_network(blk["meta"]["subnet"], strict=False)))
    nets += _tunnel_networks(c)
    with contextlib.suppress(ValueError, TypeError):
        nets.append(("the mesh pool", ipaddress.ip_network(str(node_mesh_cfg(deps, c).get("subnet") or ""), strict=False)))
    others = []
    for _oid, _on in nodes.items():
        if _oid != nid:
