def _turn_bins_needed():
    sd = (getattr(Handler, "deps", None) or {}).get("stats_dir")
    if not sd or not os.path.isdir(sd):
        return None
    wdtt_owner = {fork: owner for owner, fork in _WDTT_OWNER_FORK.items()}
    need = {}
    def add(owner, tag):
        if owner:
            need.setdefault(owner, set()).add(_turn_safe(tag) if tag else "*")
    def text(x):
        return x if isinstance(x, str) else ""
    def rows(snap, key):
        v = snap.get(key)
        return [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []
    for owner, fork in _WDTT_OWNER_FORK.items():
        add(owner, _wdtt_current_version(fork) or None)
    for _cl in CSQTT_LINES:
        if CSQTT_LINES[_cl]:
            add(CSQTT_MIRROR_OWNER, _csqtt_current_version(_cl))
    for k, v in (_turn_holds_load() or {}).items():
        rest = str(k).partition("|")[2]
        tag = (v.get("tag") if isinstance(v, dict) else v) or None
        if rest.startswith("wdtt:"):
            add(wdtt_owner.get(rest[5:]), tag)
        elif rest == "fork:csqtt" or rest.startswith("fork:csqtt@"):
            add(CSQTT_MIRROR_OWNER, tag)
        elif rest.startswith("fork:"):
            add(turn_fork_owner(rest[5:]), tag)
    try:
        names = [n for n in os.listdir(sd) if n.startswith("stats-") and n.endswith(".json")]
    except OSError:
        return None
    for n in names:
        try:
            with open(os.path.join(sd, n)) as fh:
                snap = json.load(fh)
            if not isinstance(snap, dict):
                raise ValueError("not a JSON object")
        except Exception as e:
            if n not in _TURN_PRUNE_WARNED:
                _TURN_PRUNE_WARNED.add(n)
                log(LOG_WARNING, "turn store: not pruned — %s cannot be read (%s)", os.path.join(sd, n), e)
            return None
        for w in rows(snap, "wdtt"):
            add(wdtt_owner.get(text(w.get("fork"))), w.get("version"))
        for c in rows(snap, "csqtt"):
            add(CSQTT_MIRROR_OWNER, c.get("version"))
        for t in rows(snap, "turn_proxies"):
            add(text(t.get("owner")) or turn_fork_owner(turn_fork(text(t.get("service")))), t.get("version"))
    return need


def _turn_bins_prune(owner, need=None):
    if need is None:
        need = _turn_bins_needed()
    if need is None:
        return
    keep = set(need.get(owner) or ())
    if owner in _WDTT_OWNER_FORK:
        advertised = {_turn_safe(v) for v, _ in _wdtt_versions(_WDTT_OWNER_FORK[owner])}
        keep.add("wdtt")
    elif owner == CSQTT_MIRROR_OWNER:
        advertised = {_turn_safe(v) for _b in CSQTT_LINES.values() for v, _ in _b}
        keep.add("csqtt")
    else:
        advertised = None
    cut = [k for k in keep if len(k) == _TURN_VER_CUT]
    d = os.path.join(TURN_BINS_DIR, _turn_safe(owner))
    landed, live = {}, set()
    for t in sorted(_turn_files(d)):
        p = os.path.join(d, t)
        if not os.path.isdir(p):
            continue
        for f in _turn_files(p):
            if ".dl." in f and (_turn_age(os.path.join(p, f)) or 0) > 3600:
                with contextlib.suppress(OSError):
                    os.remove(os.path.join(p, f))
        age, at = _turn_age(p), _turn_mirrored_at(p)
        if age is None:
            continue
        if at is not None:
            landed[p] = at
        if any(".dl." in f for f in _turn_files(p)):
            continue
        if at is None:
            if age > 3600:
                shutil.rmtree(p, ignore_errors=True)
                log(LOG_INFO, "turn store: removed %s/%s — no binary in it (a failed fetch)", owner, t)
            continue
        if "*" in keep or t in keep or any(t.startswith(k) for k in cut):
            continue
        if advertised is not None and t not in advertised:
            if age > 3600:
                shutil.rmtree(p, ignore_errors=True)
                landed.pop(p, None)
                log(LOG_INFO, "turn store: removed %s/%s — a build no longer offered, and nothing runs or holds it",
                    owner, t)
            continue
        live.add(p)
    if "*" in keep:
        return
    for p in sorted(landed, key=landed.get, reverse=True)[TURN_BINS_KEEP:]:
        if p in live:
            shutil.rmtree(p, ignore_errors=True)
            log(LOG_INFO, "turn store: removed %s/%s — older than the newest %d, and nothing runs or holds it",
                owner, os.path.basename(p), TURN_BINS_KEEP)


def _turn_bins_prune_soon(owner):
    with _TURN_PRUNING_LOCK:
        if owner in _TURN_PRUNING:
            return
        _TURN_PRUNING.add(owner)
    def _run():
        try:
            _turn_bins_prune(owner)
        except Exception as e:
            log(LOG_WARNING, "turn store: pruning %s stopped (%s) — what it had not reached stays", owner, e)
        finally:
            with _TURN_PRUNING_LOCK:
                _TURN_PRUNING.discard(owner)
    threading.Thread(target=_run, name="turn-store-prune", daemon=True).start()


def _turn_bins_prune_all():
    need = _turn_bins_needed()
    if need is None:
        return
    owners = set(_WDTT_OWNER_FORK) | {CSQTT_MIRROR_OWNER} | {s.get("owner") for s in TURN_SERVERS.values() if s.get("owner")}
    with _TURN_SUMS_LOCK:
        owners |= {k.split("|")[0] for k in _TURN_SUMS}
    by_dir = {_turn_safe(o): o for o in owners if o and "/" in o}
    for dn in sorted(_turn_files(TURN_BINS_DIR)):
        if dn in by_dir:
            try:
                _turn_bins_prune(by_dir[dn], need)
            except Exception as e:
                log(LOG_WARNING, "turn store: pruning %s stopped (%s) — what it had not reached stays", by_dir[dn], e)


def turn_sum(owner, tag, arch, need_file=False):
    if not owner or "/" not in owner or not tag or arch not in TURN_ARCHES:
        return ""
    key = owner + "|" + tag + "|" + arch
    dest = _turn_store_path(owner, tag, arch)
    _st = None
    with contextlib.suppress(OSError):
        _st = os.stat(dest)
    if _st is not None and _st.st_size > 0:
        _stamp = (_st.st_mtime_ns, _st.st_size, _st.st_ino)
        with _TURN_SUMS_LOCK:
            _hot = _TURN_SUM_STAT.get(key)
        if _hot and _hot[0] == _stamp:
            return _hot[1]
        with contextlib.suppress(OSError):
            _fsha = _turn_sha256_file(dest)
            if _fsha:
                with _TURN_SUMS_LOCK:
                    _TURN_SUM_STAT[key] = (_stamp, _fsha)
                    if _TURN_SUMS.get(key) != _fsha:
                        _TURN_SUMS[key] = _fsha
                        with contextlib.suppress(Exception):
                            atomic_write(TURN_SUMS_PATH, json.dumps(_TURN_SUMS) + "\n", mode=0o600)
                return _fsha
    with _TURN_SUMS_LOCK:
        cached = _TURN_SUMS.get(key)
    if cached and not need_file:
        return cached
    with _TURN_SUM_SEM:
        with _TURN_SUMS_LOCK:
            cached = _TURN_SUMS.get(key)
        if cached and not need_file:
            return cached
        sha = ""
        if os.path.isfile(dest) and os.path.getsize(dest) > 0:
            with contextlib.suppress(OSError):
                sha = _turn_sha256_file(dest)
        else:
            try:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
            except OSError:
                return ""
            with contextlib.suppress(OSError):
                os.utime(os.path.dirname(dest), None)
            tmp = dest + ".dl." + str(os.getpid())
            try:
                r = subprocess.run(["curl", "-4", "-fsSL", "--connect-timeout", "15", "--max-time", "180",
                                    "--retry", "2", "--retry-delay", "2", _turn_asset_url(owner, tag, arch), "-o", tmp],
                                   capture_output=True, text=True, timeout=200)
                if r.returncode == 0 and os.path.isfile(tmp) and os.path.getsize(tmp) > 0:
                    sha = _turn_sha256_file(tmp)
                    os.replace(tmp, dest)
                    if cached and sha != cached:
                        log(LOG_WARNING, "turn store: %s %s %s fetched again, and its sha256 is not the one it was pinned "
                            "with — the pin follows the file (a node pinned to the old one is refused it until then)",
                            owner, tag, arch)
            except Exception:
                sha = ""
            finally:
                with contextlib.suppress(OSError):
                    os.remove(tmp)
        if sha and sha != cached:
            with _TURN_SUMS_LOCK:
                _TURN_SUMS[key] = sha
                with contextlib.suppress(Exception):
                    atomic_write(TURN_SUMS_PATH, json.dumps(_TURN_SUMS) + "\n", mode=0o600)
    if sha:
        _turn_bins_prune_soon(owner)
    return sha

def _node_arch(deps, nid):
    a = ((deps.get("node_snaps") or {}).get(nid) or {}).get("arch")
    return [a] if a in TURN_ARCHES else None

def turn_pin_tag(owner, tag, arches=None):
    owner = (owner or "").strip()
    if not owner or "/" not in owner or not tag:
        return {}
    want = [a for a in (arches or TURN_ARCHES) if a in TURN_ARCHES] or list(TURN_ARCHES)
    sums = {}
    for a in want:
        s = turn_sum(owner, tag, a)
        if s:
            sums[a] = s
    return {"tag": tag, "sums": sums}

def turn_available_tags(owner):
    owner = (owner or "").strip()
    out = {}
    if owner and "/" in owner:
        with _TURN_SUMS_LOCK:
            keys = list(_TURN_SUMS.keys())
        for k in keys:
            p = k.split("|")
            if len(p) != 3 or p[0] != owner:
                continue
            tag, arch = p[1], p[2]
            fp = _turn_store_path(owner, tag, arch)
            with contextlib.suppress(OSError):
                if os.path.isfile(fp) and os.path.getsize(fp) > 0:
                    e = out.setdefault(tag, {"tag": tag, "arches": [], "at": 0})
                    if arch not in e["arches"]:
                        e["arches"].append(arch)
                    e["at"] = max(e["at"], int(os.path.getmtime(fp)))
    res = list(out.values())
    res.sort(key=lambda x: x["at"], reverse=True)
    return res

