                            and (not _awg_datapath(snap).get("ok") or _awg_datapath(snap).get("userspace"))
                            or ((snap.get("kind") or c.get("kind")) == "docker"
                                and (any((e or {}).get("down") for e in (snap.get("interfaces") or {}).values())
                                     or any(tp.get("running") is False for tp in (snap.get("turn_proxies") or []))))),
                        "interfaces": list((snap.get("interfaces") or {}).keys()),
                        "missing_ifaces": _missing_ifaces(c, snap, _ivk_now),                  # user ifaces expected but gone (restore signal + last-known config)
                        "broken_ifaces": _broken_ifaces(c, snap, _ivk_now),
