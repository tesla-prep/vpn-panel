def _turn_field_classify(active, inventory_fields, wireable):
    """Field-level 3-way split, all args iterables of UPSTREAM field names:
      added        → green `+n` : upstream has it, not adopted, AND the encoder can emit it (∈ wireable)
      needs_wiring  → orange `+x`: upstream has it, not adopted, encoder can't emit it yet (∉ wireable)
      removed       → red `−m`   : we expose it, upstream dropped it
    """
    active, inv, W = set(active or ()), set(inventory_fields or ()), set(wireable or ())
    added_all = inv - active
    return {"added": sorted(added_all & W), "needs_wiring": sorted(added_all - W), "removed": sorted(active - inv)}

