def static_exit_clients(roster):
    users = roster.get("users") or {}
    now = int(time.time())
    clients = set()
    for peer in (roster.get("peers") or {}).values():
        if not isinstance(peer, dict):
            continue
        uid = peer.get("user_id")
        user = users.get(uid) if isinstance(uid, str) else None
        ref = static_exit_ref(user.get("static_exit")) if isinstance(user, dict) else None
        if not ref or access_cut(peer, user):
            continue
        for target in peer.get("targets") or ():
            if not isinstance(target, dict) or _is_self_contained_target(target):
                continue
            node, iface = (target.get(k) for k in ("node", "iface"))
            if not all(isinstance(v, str) and v for v in (node, iface)):
                continue
            with contextlib.suppress(ValueError):
                source = str(ipaddress.IPv4Address(str(target.get("ip") or "").split("/", 1)[0])) + "/32"
                clients.add((uid, ref, node, iface, source))
    return sorted(clients)


def static_exit_state(uid, ref, nodes, snaps, origins):
    nid, xid = ref
    exit_ = static_socks_exit(nodes, nid, xid)
    if not exit_ or exit_.get("enabled") is False:
        return "unavailable"
    if not static_exit_supported(snaps.get(nid)):
        return "unsupported"
    key = static_exit_key(uid, nid, xid)
    reports = [(snaps.get(node) or {}).get("static_egress") or {} for node in origins | {nid}]
    if any(isinstance(status.get("blocked"), list) and key in status["blocked"] for status in reports):
        return "unavailable"
    if origins and all(isinstance(status.get("active"), list) and key in status["active"] for status in reports):
        return "active"
    return "pending"


CASCADE_PATH_NET = ipaddress.IPv4Network("198.18.128.0/17")
CASCADE_SELECTOR_DEV = "s5-selector"


def _cascade_identity(origin, path):
    pin = tuple(path.get(k, "") for k in ("egress_ip", "wan_iface"))
    suffix = pin if any(pin) else ()
    if path.get("pool"):
        mode = ("direct",) if path.get("proxy_mode") == "direct" else ()
        return (origin, tuple(path["nodes"]), tuple(path.get("backup") or ()), "pool") + suffix + mode
    if path.get("probe"):
        return (origin, tuple(path["nodes"]), path.get("profile", ""), path.get("cfg_sig", ""), "probe") + suffix
    if path.get("profile"):
        return origin, tuple(path["nodes"]), path["profile"], "fixed"
    return origin, tuple(path["nodes"]), path.get("socks5", "")


def _cascade_address(identity, paths):
    if identity not in paths:
        used = set(paths.values())
        size = CASCADE_PATH_NET.num_addresses
        start = int(hashlib.sha256(json.dumps(identity).encode()).hexdigest(), 16) % size
        for offset in range(size):
            address = str(CASCADE_PATH_NET[(start + offset) % size])
            if address not in used:
                paths[identity] = address
                break
    return paths.get(identity)


def cascade_path_key(origin, path):
    return hashlib.sha256(json.dumps([_cascade_identity(origin, path), path["address"]]).encode()).hexdigest()[:24]


def _configured_cascades(nodes, active=False):
    for nid, node in nodes.items():
        rules = list(node.get("default_routing") or [])
        for group in ("ifaces", "wdtt", "csqtt"):
            for ov in (node.get(group) or {}).values():
                if (isinstance(ov, dict) and not ov.get("system")
                        and (not active or iface_egress_mode(ov) == "smart")):
                    rules.extend(ov.get("routing") or [])
        for rule in rules:
            if isinstance(rule, dict) and rule.get("action") == "exit" and rule.get("cascade"):
                yield nid, rule, rule["cascade"]


def migrate_legacy_egress(deps):
    """Move node SOCKS5 accounts and old forwarding rules into the shared model."""
    nodes = deps["nodes"]
    roster_path = deps["roster_path"]
    roster = roster_load(roster_path)
    pool = dict(socks_pool(deps))
    migrated = {}
    nodes_changed = False
    for nid, node in nodes.items():
        exits = node.get("exits") or []
        kept = []
        for position, proxy in enumerate(exits):
            if not isinstance(proxy, dict) or proxy.get("provider") != "socks5":
                kept.append(proxy)
                continue
            ref = [nid, proxy.get("id") or proxy.get("device") or str(position)]
            # A restart between the file writes must reuse the copied account.
            for index in itertools.count():
                pid = hashlib.sha256(json.dumps([ref, index]).encode()).hexdigest()[:8]
                if pid not in pool or pool[pid].get("migrated_from") == ref:
                    break
            if pid not in pool:
                credentials = proxy.get("socks")
                credentials = credentials if isinstance(credentials, dict) else {}
                pool[pid] = {"label": proxy.get("label") or "SOCKS5 exit", "socks": credentials,
                             "enabled": bool(credentials.get("host") and credentials.get("port"))
                             and proxy.get("enabled") is not False, "migrated_from": ref}
            migrated[tuple(ref)] = pid
        if kept != exits:
            nodes_changed = True
            if kept:
                node["exits"] = kept
            else:
                node.pop("exits", None)
            if (nid, node.get("default_exit")) in migrated:
                node.pop("default_exit", None)

    assigned = False
    for user in roster["users"].values():
        if not isinstance(user, dict) or "static_exit" not in user:
            continue
        assigned = True
        ref = static_exit_ref(user.pop("static_exit"))
        if ref in migrated and not (user.get("socks_profile") or {}).get("id"):
            user["socks_profile"] = {"id": migrated[ref], "failure": "block"}

    paths = {_cascade_identity(nid, path): path["address"]
             for nid, _, path in _configured_cascades(nodes)}

    def uses_relay(nid, peer):
        link = (nodes[nid].get("links") or {}).get(peer) or {}
        return (link.get("relay") or {}).get("mode") == "relay"

    def convert(nid, rule, pins):
        nonlocal nodes_changed
        if not isinstance(rule, dict) or rule.get("action") != "exit":
            return
        old = rule.get("cascade") or {}
        if old.get("pool") or old.get("profile"):
            return
        hops = old.get("nodes") or ([rule["node"]] if rule.get("node") else [])
        # TCP relay legs use the old route's mark and cannot select a cascade per device.
        if not old and hops and uses_relay(nid, hops[0]):
            return
        proxy = old.get("socks5")
        path = {"nodes": hops}
        if proxy and hops and (hops[-1], proxy) in migrated:
            path["profile"] = migrated[hops[-1], proxy]
        elif not proxy and hops and nid not in hops:
            path.update(pool=True, **{k: v for k, v in pins.get(hops[-1], {}).items() if v})
        if len(path) > 1:
            address = _cascade_address(_cascade_identity(nid, path), paths)
            if not address:
                raise RuntimeError("No addresses are available for the saved cascades.")
            rule.update(node=hops[0], cascade=dict(path, address=address))
        else:
            rule.update(action="block")
            rule.pop("node", None)
            rule.pop("cascade", None)
        nodes_changed = True

    def address_pins(record, key):
        return {nid: {"egress_ip": ip} for nid, ip in (record.get(key) or {}).items()}

    for nid, node in nodes.items():
        default_pins = address_pins(node, "default_routing_exit_ips")
        for rule in node.get("default_routing") or ():
            convert(nid, rule, default_pins)
        for group in ("ifaces", "wdtt", "csqtt"):
            for ov in (node.get(group) or {}).values():
                if not isinstance(ov, dict) or ov.get("system"):
                    continue
                if ov.get("egress_mode") == "forward":
                    if uses_relay(nid, ov.get("egress_node")):
                        continue
                    target = ov.pop("egress_node", None)
                    pins = {target: {k: ov.pop(k, "") for k in ("egress_ip", "wan_iface")}}
                    ov["egress_mode"] = "smart"
                    ov["routing"] = [{"category": "all", "action": "exit", "node": target, "enabled": True}]
                    convert(nid, ov["routing"][0], pins)
                else:
                    pins = address_pins(ov, "routing_exit_ips")
                    for rule in ov.get("routing") or ():
                        convert(nid, rule, pins)

    if pool != socks_pool(deps):
        save_socks_pool(deps, pool)
    if assigned:
        roster_save(roster_path, roster)
    if nodes_changed:
        nodes_save(deps["nodes_path"], nodes)


def _pool_sources(roster):
    users = roster.get("users") or {}
    sources = {}
    for peer in (roster.get("peers") or {}).values():
        if not isinstance(peer, dict):
            continue
        user = users.get(peer.get("user_id")) or {}
        profile = user.get("socks_profile") or {}
        if not profile.get("id") or access_cut(peer, user):
            continue
        for target in peer.get("targets") or []:
            if not isinstance(target, dict) or _is_self_contained_target(target):
                continue
            address = _ip4(str(target.get("ip") or "").split("/")[0])
            if address and target.get("node") and target.get("iface"):
                key = (target["iface"], address)
                sources.setdefault(target["node"], {})[key] = (profile["id"], profile.get("failure") == "direct")
    return sources


