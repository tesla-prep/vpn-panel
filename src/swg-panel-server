    if method == "POST" and path == "/api/peers/create":
        pubkey = (body.get("pubkey") or "").strip()
        targets = body.get("targets")
        if not isinstance(targets, list) or not targets:
            t = body.get("target")
            targets = [t] if t else []
        if not targets:
            return 400, {"ok": False, "error": "at least one target is required", "code": "bad_request"}
        for t in targets:
            for f in ("node", "iface"):
                if not (t or {}).get(f):
                    return 400, {"ok": False, **perr("target.{v1} is required", v1=f), "code": "bad_request"}
            if not known(t["node"]):
                return 400, {"ok": False, **perr("unknown node {v1}", v1=repr(t["node"])), "code": "bad_request"}
            if is_system_iface(deps, nodes, t["node"], t["iface"]):
                return 400, {"ok": False, **perr("{v1} is a system mesh link — not a peer interface", v1=t["iface"]), "code": "system_iface"}
            t["type"] = iface_kind(deps, nodes, snaps, t["node"], t["iface"], t.get("type") or "")
            if is_keyless_kind(t["type"]):
                t["ip"] = ""
            elif not t.get("ip"):
                return 400, {"ok": False, **perr("target.{v1} is required", v1="ip"), "code": "bad_request"}
        keyed = [t for t in targets if not is_keyless_kind(t["type"])]
        if keyed and not pubkey:
            return 400, {"ok": False, "error": "pubkey is required", "code": "bad_request"}
        seen = set()
        for t in targets:
            k = (t["node"], t["iface"])
            if k in seen:
                return 400, {"ok": False, **perr("duplicate target {v1}", v1=f"{t['node']}/{t['iface']}"), "code": "bad_request"}
            seen.add(k)
        be = bad_targets(keyed)
        if be:
            return 400, {"ok": False, "error": be, "code": "bad_request"}
        roster = roster_load(roster_path)
        if pubkey and find_peer_by_pubkey(roster, pubkey):
            return 409, {"ok": False, "error": "a peer with this key already exists "
                         "(use add-target to deploy it elsewhere)", "code": "exists"}
        uid = body.get("user_id")
        if uid and uid not in roster["users"]:
            return 400, {"ok": False, "error": "unknown user", "code": "bad_request"}
        psk = (body.get("psk") or gen_psk()) if keyed else ""
        fields = {"user_id": uid or None, "title": strip_ctrl(body.get("title", "")),
                  "pubkey": pubkey, "psk": psk, "targets": targets,
                  "overrides": body.get("overrides") or {}}
        fields.update(mint_keyless_secrets(targets, {}))
        pid = gen_id()
        while pid in roster["peers"]:
            pid = gen_id()
        p = peer_set(roster, pid, fields, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Created peer", peer_label(roster, p),
                  f"{len(targets)} target{'' if len(targets) == 1 else 's'} · {targets[0]['node']}/{targets[0]['iface']}",
                  detail_key="{count} · {where}",
                  detail_vars={"count": {"n": len(targets), "noun": "target"},
                               "where": f"{targets[0]['node']}/{targets[0]['iface']}"})
        webhook_emit(deps, "peer.added", {"peer_id": pid, "title": p.get("title") or None,
                     "user": (roster["users"].get(uid) or {}).get("name") if uid else None,
                     "targets": [{"node": t["node"], "iface": t["iface"], "address": t.get("ip")} for t in targets]})
        return 200, {"ok": True, "data": p}

    if method == "POST" and path == "/api/peers/add-target":
        pid = body.get("peer_id") or ""
        target = body.get("target") or {}
        for f in ("node", "iface"):
            if not target.get(f):
                return 400, {"ok": False, **perr("target.{v1} is required", v1=f), "code": "bad_request"}
        if not known(target["node"]):
            return 400, {"ok": False, **perr("unknown node {v1}", v1=repr(target["node"])), "code": "bad_request"}
        if is_system_iface(deps, nodes, target["node"], target["iface"]):
            return 400, {"ok": False, **perr("{v1} is a system mesh link — not a peer interface", v1=target["iface"]), "code": "system_iface"}
        target["type"] = iface_kind(deps, nodes, snaps, target["node"], target["iface"], target.get("type") or "")
        if is_keyless_kind(target["type"]):
            target["ip"] = ""
        else:
            if not target.get("ip"):
                return 400, {"ok": False, **perr("target.{v1} is required", v1="ip"), "code": "bad_request"}
            if not valid_addr(target["ip"]):
                return 400, {"ok": False, **perr("invalid address {v1}", v1=repr(target["ip"])), "code": "bad_request"}
        roster = roster_load(roster_path)
        p = roster["peers"].get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        if any(t["node"] == target["node"] and t["iface"] == target["iface"] for t in p["targets"]):
            return 409, {"ok": False, "error": "peer already has a target on that node/interface",
                         "code": "exists"}
        if not is_keyless_kind(target["type"]) and not p.get("pubkey"):
            return 400, {"ok": False, **perr("{v1} needs a client key — this peer has none (rotate its keys first)", v1=target["iface"]), "code": "bad_request"}
        _add = {"targets": p["targets"] + [target]}
        _add.update(mint_keyless_secrets([target], p))
        p2 = peer_set(roster, pid, _add, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Added deployment", peer_label(roster, p2),
                  f"{target['node']}/{target['iface']}")
        return 200, {"ok": True, "data": p2}

    if method == "POST" and path == "/api/peers/remove-target":
