# why an outbound fetch failed, in a sentence the operator can act on
def _why_fetch_failed(url, e):
    """What stopped this fetch, as a perr() message — the panel's own convention for a sentence carrying values,
    so the browser looks the English up and puts {v1} where its own language puts it.

    ⚠️ EVERY SENTENCE IS WRITTEN INLINE AT ITS OWN perr() CALL, not handed to one later as a (key, vars)
    pair: .campaign/i18n-extract.mjs finds a server sentence by the SHAPE around it, and a perr call with the
    literal right there is one of the shapes it knows. Written any other way these read as ORPHANED in the
    catalog — which, as that file warns twice, is how a working translation gets deleted as dead.

    ⚠️ And do not spell that shape out in prose here. The first version of this docstring quoted it, opening
    quote and all, and the gate scraped the REST OF THE DOCSTRING as an untranslated panel sentence — red on
    a comment explaining why the gate goes red. A scraper cannot tell the thing from the mention of it."""
    host = ""
    with contextlib.suppress(Exception):
        host = urlparse(url).hostname or ""
    host = host or (url or "the repo")
    # HTTPError IS a URLError, and it carries its own meaning — so it is read before the unwrap below.
    if isinstance(e, urllib.error.HTTPError):
        if e.code in (401, 403, 429):
            return perr("{v1} is rate-limiting this server's address — try the check again in a few minutes.", v1=host)
        return perr("{v1} answered {v2} to the update check.", v1=host, v2="HTTP %d" % e.code)
    # Everything else arrives WRAPPED: urlopen raises URLError(reason=<the real OSError>), so testing the
    # outer object would match nothing below and every cause would read as the generic fallback.
    if isinstance(e, urllib.error.URLError) and isinstance(getattr(e, "reason", None), BaseException):
        e = e.reason
    if isinstance(e, ssl.SSLCertVerificationError):    # a subclass of SSLError — must be tested first
        return perr("Couldn't reach {v1} to check for updates — its TLS certificate could not be verified. "
                    "The CA certificates on this server may be missing or out of date.", v1=host)
    if isinstance(e, ssl.SSLError):
        return perr("Couldn't reach {v1} to check for updates — the TLS connection failed.", v1=host)
    if isinstance(e, socket.gaierror):
        return perr("Couldn't reach {v1} to check for updates — its name could not be resolved.", v1=host)
    if isinstance(e, ConnectionRefusedError):
        return perr("Couldn't reach {v1} to check for updates — the connection was refused.", v1=host)
    if isinstance(e, ConnectionResetError):
        return perr("Couldn't reach {v1} to check for updates — the connection was reset.", v1=host)
    # socket.timeout IS TimeoutError, and TimeoutError is an OSError — so this precedes the errno test.
    if isinstance(e, (socket.timeout, TimeoutError)):
        return perr("Couldn't reach {v1} to check for updates — it did not answer in time.", v1=host)
    if isinstance(e, OSError) and e.errno in (errno.ENETUNREACH, errno.EHOSTUNREACH):
        return perr("Couldn't reach {v1} to check for updates — there is no route to it from this server.", v1=host)
    return perr("Couldn't reach {v1} to check for updates — {v2}.", v1=host, v2=type(e).__name__)


# Повторы делят срок всей проверки обновлений. При сбое чтения проверяем тот же файл через GitHub API.
def _api_contents_url(url):
    """The same file, through the GitHub API's contents endpoint instead of raw. "" for anything that is not
    a github raw URL — an operator's own mirror (SWG_LATEST_URL) has no such second door, and guessing one
    would be inventing a source.

    The `?cb=` buster is dropped on the way: it exists to fight raw's CDN, and this is not that CDN."""
    m = re.match(r"^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.+)$", url or "")
    if not m:
        return ""
    owner, repo, ref, path = m.groups()
    path = path.split("?", 1)[0].split("#", 1)[0]
    if not path:
        return ""
    return ("https://api.github.com/repos/%s/%s/contents/%s?ref=%s"
            % (quote(owner, safe=""), quote(repo, safe=""), quote(path), quote(ref, safe="")))


def _gh_get(url, headers, nbytes, deadline, timeout=12, tries=3):
    """Fetch `url`, retried, bounded by `deadline` — falling back to the API door if raw cannot be had.

    Raises the RAW error when both fail, not the fallback's: raw is the primary source and its cause is the
    one an operator can act on ("the connection was reset" names a middlebox; the API's 403 that follows
    would only name our own quota)."""
    def _fetch(u, hdrs):
        def _do():
            left = deadline - time.time()
            req = urllib.request.Request(u, headers=hdrs)
            with urllib.request.urlopen(req, timeout=max(3.0, min(timeout, left))) as r:
                return r.read(nbytes)
        return _http_retry(_do, tries=tries, deadline=deadline)   # defined further down; resolved at call time
    try:
        return _fetch(url, headers)
    except Exception as e:
        first = e
    # Only worth trying while there is budget left to try it in — a raw fetch that timed out slowly has
    # already spent what the click had, and a second door opened after the answer is due helps nobody.
    alt = _api_contents_url(url)
    if not alt or time.time() >= deadline:
        raise first
    try:
        return _fetch(alt, dict(headers, Accept="application/vnd.github.raw"))
    except Exception:
        raise first


def _check_latest_remote(budget=120):
    """Ask the repo what the newest published version is. True only if we actually reached it.

    `budget` is the WHOLE check's, in seconds, not one fetch's — the hourly loop can afford to sit through
    every retry, but a click cannot, and the same code serves both. On failure LATEST_REMOTE["why"] holds a
    perr() message naming the cause, so the header's check button can say what stopped it instead of shrugging."""
    ok, why, url = False, None, REMOTE_VERSION_URL
    deadline = time.time() + max(5, budget)
    try:
        url = REMOTE_VERSION_URL + (("&" if "?" in REMOTE_VERSION_URL else "?") + "cb=" + str(int(time.time())))
        v = _short_ver(_gh_get(url, {"User-Agent": "swg-panel", "Cache-Control": "no-cache"},
                               64, deadline).decode("utf-8", "replace").strip())
        if _vtuple(v) == (0, 0, 0):      # not a version -> treat it as no answer at all
            v = ""
        if v:
            if not LATEST_REMOTE.get("version") or _vtuple(v) >= _vtuple(LATEST_REMOTE["version"]):
                LATEST_REMOTE["version"] = v        # the notes are read when a bubble opens (/api/changelog?want=)
            ok = True
        else:
            # Reached it, and what came back was not a version — a captive portal or a block page answering
            # 200 for raw.githubusercontent.com looks exactly like this, and says nothing about the network.
            why = perr("{v1} answered, but not with a version.", v1=(urlparse(url).hostname or url))
    except Exception as e:
        why = _why_fetch_failed(url, e)
    LATEST_REMOTE["checked"] = int(time.time())
    LATEST_REMOTE["why"] = None if ok else why
    return ok


def _resolve_turn_tag(owner):
    """Latest release tag of a turn-proxy fork repo, read from the 302 of releases/latest/download (no API →
    no rate limit). Mirrors swg-noded's _turn_resolve_tag. "" if unreachable. Used by /api/turn/check-updates."""
    if not owner or "/" not in owner:
        return ""
    url = "https://github.com/" + owner + "/releases/latest/download/server-linux-amd64"
    try:
        r = subprocess.run(["curl", "-4", "-fsS", "-o", os.devnull, "-w", "%{redirect_url}",
                            "--connect-timeout", "12", "--max-time", "25", url],
                           capture_output=True, text=True, timeout=30)
        m = re.search(r"/releases/download/([^/]+)/", r.stdout or "")
        return m.group(1) if m else ""
    except Exception:
        return ""


