_VK_HASH_RE = re.compile(r"[A-Za-z0-9_-]{%d,}" % _CSQTT_VK_MINLEN)


VK_JOIN_URL = "https://vk.ru/call/join/"


def _vk_link_norm(s):
    s = str(s or "").strip()
    return VK_JOIN_URL + s if _VK_HASH_RE.fullmatch(s) else s


def _norm_vk_links(fields, u):
    prev = u.get("vk_links")
    if not isinstance(prev, list):
        prev = [u["vk_link"]] if u.get("vk_link") else []
    links = fields.get("vk_links", prev)
    if not isinstance(links, list):
        links = []
    links = [s for s in (_vk_link_norm(x)[:512] for x in links) if s][:16]
    seen = set(); links = [x for x in links if not (x in seen or seen.add(x))]
    if "vk_link" in fields:
        vk = _vk_link_norm(fields.get("vk_link"))[:512]
        links = ([vk] + [x for x in links if x != vk]) if vk else links
    return links, (links[0] if links else "")

