        with open("/run/swg-update.running") as f:
            _pid = int((f.read() or "0").strip() or 0)
        upd = _pid > 0 and os.path.exists("/proc/%d" % _pid)
    try:
        awg_used = any(os.path.exists(p) for p in ("/usr/bin/awg", "/usr/local/bin/awg", "/sbin/awg", "/usr/sbin/awg"))
        if awg_used:
            loaded = False
            try:
                with open("/proc/modules") as f:
                    loaded = any(ln.startswith("amneziawg ") for ln in f)
            except Exception:
                pass
            built = False
            if not loaded:
                kr = os.uname().release
                for d in ("/lib/modules/%s/updates/dkms" % kr, "/lib/modules/%s/updates" % kr, "/lib/modules/%s/kernel/drivers/net" % kr):
                    try:
                        if any(f.startswith("amneziawg.ko") for f in os.listdir(d)):
                            built = True; break
                    except Exception:
                        continue
            _ref = None if loaded else _host_awg_record("awg-module-refused")
            _key = bool(built and _ref and _ref.get("boot") and _ref.get("boot") == _host_boot_id())
            out["awg"] = {"needed": True, "ok": bool(loaded or (built and not _key)), "updating": upd}
            if not out["awg"]["ok"]:
                out["awg"]["fallback"] = any(os.access(p, os.X_OK) for p in ("/usr/local/sbin/amneziawg-go", "/usr/local/bin/amneziawg-go", "/usr/sbin/amneziawg-go", "/usr/bin/amneziawg-go"))
            if _key:
                out["awg"]["why"] = "key"
                if _MOK_PATH_RE.match(_ref.get("mok") or ""):
                    out["awg"]["mok"] = _ref["mok"]
            elif not out["awg"]["ok"] and _host_awg_record("awg-module-failed"):
                out["awg"]["why"] = "compile"
    except Exception:
        return _DATAPATH_SVC["data"]
    _DATAPATH_SVC["at"] = now; _DATAPATH_SVC["data"] = out
    return out


