    keep = [e for e in smart if "ports" not in e]
    cats = {e["category"] for e in keep} | {e["category"] for e in ((my.get("arrivals") or {}).get("entries") or [])}
    return dict(my, smart=keep, **{k: {c: v for c, v in (my.get(k) or {}).items() if c in cats}
