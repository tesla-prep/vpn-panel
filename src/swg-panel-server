    def _node_list(self, u):
        nid, _node, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(_node, b""):
            return
        q = parse_qs(u.query)
        cat = (q.get("cat") or [""])[0].strip()
        tier = (q.get("tier") or [""])[0].strip()
        _isblku = cat.startswith("blku:")
        _isblk = _isblku or cat.startswith("blk:")
        if tier not in ("ip", "host") or (not _isblk and not _is_routed_list_cat(cat)):
            return self._send(400, {"error": "bad cat/tier"})
        if _isblk and not _isblku:
            _bprov, _, _blid = cat[4:].partition(":")
            if _blid not in BLOCK_PROVIDER_LISTS.get(_bprov, {}):
                return self._send(404, {"error": "unknown block list"})
            if not block_providers_enabled(Handler.deps.get("panel_settings"))[_bprov]:
                return self._send(403, {"error": "provider disabled"})
        elif not _isblk and not ((Handler.deps.get("panel_settings") or {}).get("providers") or {}).get(cat.split(":", 1)[0], False):
            return self._send(403, {"error": "provider disabled"})
        meta = list_meta(cat, tier)
        try:
            with open(_list_path(cat, tier), "rb") as f:
                data = f.read()
        except OSError:
            list_ensure(cat, tier)
            return self._send(404, {"error": "not resolved yet"})
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-List-Version", (meta or {}).get("v", ""))
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(data)

    def _node_turn_binary(self, u):
        nid, _node, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(_node, b""):
            return
        q = parse_qs(u.query)
        owner = (q.get("owner") or [""])[0].strip()
        tag = (q.get("tag") or [""])[0].strip()
        arch = (q.get("arch") or [""])[0].strip()
        if not _OWNER_RE.match(owner) or not tag or "/" in tag or ".." in tag or arch not in TURN_ARCHES:
            return self._send(400, {"error": "bad owner/tag/arch"})
        if owner == HEV_OWNER:
            dest = hev_mirror_file(arch) if tag == HEV_TAG else ""
            sha = HEV_SHA256.get(arch, "") if dest else ""
        else:
            sha = turn_sum(owner, tag, arch, need_file=True)
            dest = _turn_store_path(owner, tag, arch)
        if not sha or not os.path.isfile(dest):
            return self._send(404, {"error": "binary unavailable"})
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Turn-Sha256", sha)
        self.send_header("Content-Length", str(os.path.getsize(dest)))
        self.end_headers()
        with contextlib.suppress(Exception):
            with open(dest, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    self.wfile.write(chunk)

    def _node_rename(self):
        nid, _rnode, _ = self._node_token()
        if not nid:
            return
        length = self._body_len()
        if length is None:
            return
        raw = self.rfile.read(length) if length else b""
        if not self._node_sig_ok(_rnode, raw, require=False):
            return
        try:
            body = json.loads(raw or b"{}") if raw else {}
        except Exception:
            body = {}
        name = strip_ctrl((body.get("name") or "").strip())[:40]
        if not name:
            return self._send(400, {"ok": False, "error": "empty name"})
        with _api_lock:
            nodes = nodes_load(Handler.deps["nodes_path"])
            old = (nodes.get(nid) or {}).get("name", nid)
            if nid in nodes:
                nodes[nid]["name"] = name
                nodes_save(Handler.deps["nodes_path"], nodes)
        if nid not in nodes:
            return self._send(404, {"ok": False, "error": "unknown node"})
        if name != old:
            ev_append(Handler.deps["roster_path"], "node", nid, "Renamed node", name)
        return self._send(200, {"ok": True, "data": {"id": nid, "name": name}})

    def do_GET(self):
        _REQ.lang = self.headers.get("X-SWG-Lang") or ""
        u = urlparse(self.path)
        path = strip_base(u.path)
        if path is None:
            return self.send_error(404)
        if static_rel(path) is not None:
            return self._static(path)
        if path == "/api/node/whoami":
            return self._node_whoami()
        if path == "/api/node/list":
            return self._node_list(u)
        if path == "/api/node/turn-binary":
            return self._node_turn_binary(u)
        if path == "/healthz" or path == "/metrics" or path.startswith("/api/v1/"):
            return self._ext_api(path, u)
        if not self._require_auth():
            return
        if path.startswith("/wgstats/"):
            return self._wgstats(path)
        if path.startswith("/api/"):
            if path == "/api/state":
                return self._send_state()
            if path == "/api/logs/live":
                code, obj = live_api_get(parse_qs(u.query), self.deps)
                return self._send_state_bytes({"bytes": json.dumps(obj).encode(), "gz": None}) if code == 200 else self._send(code, obj)
            if path == "/api/logs/range":
                code, obj = range_api_get(parse_qs(u.query), self.deps)
                return self._send_state_bytes({"bytes": json.dumps(obj).encode(), "gz": None}) if code == 200 else self._send(code, obj)
            if path.startswith("/api/logs/download/"):
                return self._range_file(path[len("/api/logs/download/"):])
            try:
                code, obj = api("GET", path, parse_qs(u.query), {}, self.deps)
            except Exception as e:
                log(LOG_WARNING, "GET %s failed: %s", path, e)
                return self._send(500, {"ok": False, "error": "Internal server error", "code": "internal"})
            if code == 200 and path in _LEDGER_GZ:
                return self._send_state_bytes({"bytes": json.dumps(obj).encode(), "gz": None})
            return self._send(code, obj)
        self.send_error(404)

    def do_POST(self):
        _REQ.lang = self.headers.get("X-SWG-Lang") or ""
        u = urlparse(self.path)
        path = strip_base(u.path)
        if path is None:
            return self.send_error(404)
        if path == "/api/node/sync":
            try:
                return self._node_sync()
            except Exception as e:
                log(LOG_ERR, traceback.format_exc().rstrip("\n"))
                return self._send(500, {"ok": False, "error": str(e), "code": "internal"})
        if path == "/api/node/goodbye":
            return self._node_goodbye()
        if path == "/api/node/logs":
            return self._node_logs()
        if path == "/api/node/rename":
            return self._node_rename()
        if path == "/api/login":
            return self._login()
        if path == "/api/logout":
            return self._logout()
        if not self._require_auth():
            return
        if path is None or not path.startswith("/api/"):
            return self.send_error(404)
        length = self._body_len()
        if length is None:
            return
        raw = self.rfile.read(length) if length else b"{}"
        try:
            bodyobj = json.loads(raw or b"{}")
            if not isinstance(bodyobj, dict):
                raise ValueError
        except (json.JSONDecodeError, ValueError):
            return self._send(400, {"ok": False, "error": "invalid JSON body", "code": "bad_request"})
        if path in ("/api/logs/live", "/api/logs/live/close"):
            return self._send(*live_api_post(path, bodyobj, self.deps))
        if path in ("/api/logs/range", "/api/logs/range/make", "/api/logs/range/close"):
            return self._send(*range_api_post(path, bodyobj, self.deps))
        try:
            if path in _LOCKLESS_POST or path in _SELF_LOCKING_POST:
                code, obj = api("POST", path, {}, bodyobj, self.deps)
            else:
                with _api_lock:
                    code, obj = api("POST", path, {}, bodyobj, self.deps)
        except Exception as e:
            code, obj = 500, {"ok": False, "error": str(e), "code": "internal"}
        if 200 <= code < 300:
            _invalidate_state_cache()
        self._send(code, obj)

    def log_message(self, *a):
        pass


