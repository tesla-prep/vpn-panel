LOG_DEBUG_FOR = (3600, 86400, -1)                      # "Turn off debugging after": 1 hour, 24 hours, never


def log_debug_left(ps, now=None):
    """Seconds of Debug left (-1 = until changed, 0 = none), on this panel's clock. Computed on every read: a time
    that has passed is simply no Debug, and the next Settings save clears it."""
    try:
        until = int((ps or {}).get("log_debug_until") or 0)
    except (TypeError, ValueError):
        return 0
    if until == -1:
        return -1
    return max(0, int(until - (now if now is not None else time.time())))


LOG_MB_DEFAULT, LOG_MB_MIN = 100, 16    # the disk budget per row (the panel, each node): absent = 100, never below 16


def log_mb(v):
    """A stored budget in MB, read defensively: absent or unreadable is the default."""
    try:
        return max(LOG_MB_MIN, int(v)) if v not in (None, "") else LOG_MB_DEFAULT
    except (TypeError, ValueError):
        return LOG_MB_DEFAULT


def log_mb_parse(v):
    """(MB, error) for an incoming budget: an integer, at least LOG_MB_MIN; blank is the default. The error is a perr()
    dict, so the browser shows it translated."""
    if v in (None, ""):
        return LOG_MB_DEFAULT, None
    try:
        mb = int(v)
    except (TypeError, ValueError):
        mb = None
    if mb is None or mb < LOG_MB_MIN or mb > 999999:    # the field takes six digits
        return None, perr("The log budget must be a whole number of MB, at least {v1}.", v1=LOG_MB_MIN)
    return mb, None


def log_wire(ps, now=None, mb=None):
    """The sync reply's `panel.log` = {level, debug_left?, mb?}, or None at the defaults (Info, no Debug, 100 MB):
    omitted then, so a default fleet's reply is byte-identical to one from before levels, and a node reads an absent key
    as the defaults. `debug_left` is a duration, so the node counts it down on its own clock — clock skew does not
    matter, and a node cut off from the panel still leaves Debug on time. `mb` is that node's own disk budget."""
    base = (ps or {}).get("log_level")
    base = base if base in LOG_BASE_LEVELS else "info"
    left = log_debug_left(ps, now)
    mb = log_mb(mb)
    if base == "info" and not left and mb == LOG_MB_DEFAULT:
        return None
    return {"level": base, **({"debug_left": left} if left else {}), **({"mb": mb} if mb != LOG_MB_DEFAULT else {})}


PANEL_LOG_FILE = {"path": None}    # docker: <state>/log/swg-panel.log, set at start (main)


def panel_log_apply(ps):
    """This process logs at the fleet's level too. Debug's end is the helper's clock, checked per line. In a container
    (no journald) its lines also go to a file of the panel's budget; Off removes it."""
    base = (ps or {}).get("log_level")
    log_set(LOG_LEVELS.get(base if base in LOG_BASE_LEVELS else "info"), log_debug_left(ps))
    if PANEL_LOG_FILE["path"]:
        log_file(PANEL_LOG_FILE["path"], 0 if log_level() == LOG_OFF else log_mb((ps or {}).get("log_mb_panel")) << 20)


def panel_log_follow():
    """docker: the level in force went to Off (Debug ran out) while the file is still written → it goes, as a save to Off
    removes it. The helper's clock decides and no settings are read, so a save in between is never undone: under the
    file's lock, a save's log_file() comes either before (Debug on: nothing done) or after (the file is named again)."""
    with _LOG_FILE["lock"]:
        if _LOG_FILE["path"] and log_level() == LOG_OFF:
            log_file(_LOG_FILE["path"], 0)


def _panel_log_follow_loop():
    while True:                                       # every 30 s, as a node checks its own each pass
        time.sleep(30)
        with contextlib.suppress(Exception):
            panel_log_follow()


def panel_log_status(deps):
    """The Panel row of the budget table: {mb, used_mb, oldest?, err?} as swg-netctl last measured the `swg-panel`
    journal (it writes netctl/status/_log.json; this process cannot read the journals), or the panel's own files in a
    container. None while nothing has reported. On NixOS there is no swg-netctl, so the panel logs to the system
    journal: {"err": "nixos"}."""
    if PANEL_LOG_FILE["path"]:
        d = os.path.dirname(PANEL_LOG_FILE["path"])
        used = 0
        with contextlib.suppress(OSError):
            for n in os.listdir(d):
                with contextlib.suppress(OSError):
                    used += os.stat(os.path.join(d, n)).st_blocks * 512
        out = {"mb": log_mb((deps.get("panel_settings") or {}).get("log_mb_panel")), "used_mb": round(used / 1048576.0, 1),
               "docker": True}
        for p in (PANEL_LOG_FILE["path"] + ".1", PANEL_LOG_FILE["path"]):   # its first line: `.1` is the older half
            with contextlib.suppress(OSError, ValueError, UnicodeDecodeError):
                with open(p, "rb") as f:
                    out["oldest"] = _live_cal.timegm(time.strptime(f.read(20).decode(), "%Y-%m-%dT%H:%M:%SZ"))
                break
        return out
    if PANEL_PLATFORM == "nixos":
        return {"err": "nixos"}
    try:
        with open(os.path.join(os.path.dirname(deps.get("nodes_path") or ".") or ".", "netctl", "status", "_log.json")) as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict):
        return None
    return {k: doc[k] for k in ("mb", "used_mb", "oldest", "err", "unsupported") if isinstance(doc.get(k), (int, float, str))}


_DROPPED_CAP = 20      # entries carried back per save; the total is kept whole


def _dropped_report(entries):
    """{entries, total} — capped, because nothing bounds how many targets a rule may carry and the panel should
    not echo a client's garbage back at it by the hundredweight. `total` is what the UI counts."""
    return {"entries": entries[:_DROPPED_CAP], "total": len(entries)} if entries else {"entries": [], "total": 0}


# A SNAPSHOT IS REMOTE INPUT, AND A NODE ONLY RECONCILES ON A 200
_SNAP_TELEMETRY = ("inet", "cat_rate", "exit_rate")
_SNAP_STATE = ("interfaces", "wdtt", "csqtt")
_SNAP_SHAPE = {
    **dict.fromkeys(("container_ifaces", "csqtt_candidates", "devexit", "exit_candidates", "exits",
                     "node_ip_ifaces", "turn_proxies", "wdtt_dormant"), (list, dict)),
    **dict.fromkeys(("ether_ifaces", "exit_kinds", "ifaces_awaiting_key", "node_ifaces", "node_ips"), (list, str)),
    **dict.fromkeys(("iface_drops", "mesh_health"), (dict, dict)),
    "udp_listen": (list, int),                           # S9e: walked by _host_listen inside reconcile_mesh (review F4)
    **dict.fromkeys(("iface_key_sealed", "ip_forward", "relay", "rp_filter", "static_egress", "wdtt_key_sealed"), (dict, None)),
}
_SNAP_SAID = set()                                       # (node, field) already logged as dropped — once each per process


def _snap_num(v):
    """A reported number, or None. NOT an isinstance test: this project's own nodes send numbers as strings
    in places (`wdtt[].raw_port` is str beside an int `wg_port`), so a numeric string has to count."""
    try:
        n = max(0.0, float(v or 0))
    except (TypeError, ValueError, OverflowError):   # an int past a double (a 10**400 generated_at, kept as an int):
        return None                                  # the warm start raised on it, so the panel did not boot (q189 R2 PANEL-1b)
    # …but not "inf" / "1e999", which float() reads and JSON cannot carry: kept, /api/state answered with a bare
    # `Infinity` that the browser's r.json() refuses, and every operator's console froze (1.8.9 qualification R2 PANEL-1).
    return n if math.isfinite(n) else None


def _json_finite(s):
    """json.loads hook — parse_constant AND parse_float — for a node's sync body (1.8.9 qualification R2 PANEL-1).

    Python's json reads `NaN`, `Infinity`, `-Infinity` and a literal past a double's range (`1e400` → inf), none of
    which is JSON: stored in a snapshot, they came back out of /api/state, which the browser's r.json() refuses — one
    node's report froze every operator's console. Refused here as any unreadable body is (400): that node's pass is
    skipped (noded reconciles only on a 200 with `desired`) and no other node's sync is touched. swg-noded never sends
    one — its numbers are counters, rates and figures parsed from /proc and ping."""
    n = float(s)
    if not math.isfinite(n) or abs(n) > 1e100:           # …and one past any real reading (PANEL-1d, see _json_int)
        raise ValueError("not a finite number: %.24s" % s)
    return n


def _json_int(s):
    """parse_int's twin of _json_finite (1.8.9 qualification R2 PANEL-1d). A FINITE number can still break what the
    whole panel shares: two peers' rx_speed of 1.7e308 summed to inf (Infinity in /api/state again), and an integer of
    401 digits — read exactly — made the first float() of it raise OverflowError, /api/state 500 for every operator. No
    real reading comes near 1e100 (the test fleet's largest is a disk's 1.6e11 bytes; a petabyte counter is 1e15, a
    nanosecond clock 1.8e18), and a million readings that size still sum to 1e106 — so a number past it is refused as
    any unreadable body is, before int() spends time on its digits."""
    if len(s.lstrip("-")) > 100:
        raise ValueError("a number past 1e100: %.24s…" % s)
    return int(s)


def _snap_sanitise(snap, nid=""):
    """Clean the telemetry in `snap` IN PLACE and return a refusal reason for malformed state, or None. `nid` names
    the node in the one log line a dropped field gets.

    Telemetry is reduced to exactly what every reader below assumes — `{key: {…: number}}` — so no consumer
    needs its own guard, and a value that cannot be read is simply not there rather than raising three
    functions later."""
    if not isinstance(snap, dict):
        return "snapshot must be an object"
    _g = snap.get("generated_at")
    if _g is not None and not isinstance(_g, int):
        _gn = _snap_num(_g)                              # numeric strings count, as they do for every rate…
        if _gn is None or _gn <= 0:                      # …but _snap_num reads a null-ish value as 0, which is
            snap.pop("generated_at")                     # right for a rate and wrong for an instant: no reading
        else:                                            # at all is a shape every reader handles, a 1970 one is not
            snap["generated_at"] = int(_gn)
    for k in _SNAP_TELEMETRY:
        if k not in snap:
            continue
        v = snap.get(k)
        if not isinstance(v, dict):
            snap.pop(k)                                  # a list or a string here is not a rate map
            continue
        if k == "inet":                                  # one flat {up, down}
            snap[k] = {kk: _snap_num(vv) for kk, vv in v.items() if _snap_num(vv) is not None}
            continue
        clean = {}                                       # {key: {up, dn|down}}
        for kk, vv in v.items():
            if not isinstance(vv, dict):
                continue
            inner = {ik: _snap_num(iv) for ik, iv in vv.items() if _snap_num(iv) is not None}
            if inner:
                clean[str(kk)] = inner
        snap[k] = clean
    if isinstance(snap.get("interfaces"), list):         # walked BY NAME everywhere: a list raised in every node's sync
        return "snapshot field 'interfaces' must be an object, got list"   # and in /api/state (q189 R2 PANEL-1c)
    for k in _SNAP_STATE:
        if k not in snap:
            continue
        v = snap[k]
        if isinstance(v, dict):
            bad = next((kk for kk, vv in v.items() if not isinstance(vv, dict)), None)
            if bad is not None:
                return "snapshot field %r: entry %r must be an object, got %s" % (k, bad, type(v[bad]).__name__)
        elif isinstance(v, list):
            bad = next((i for i, vv in enumerate(v) if not isinstance(vv, dict)), None)
            if bad is not None:
                return "snapshot field %r: item %d must be an object, got %s" % (k, bad, type(v[bad]).__name__)
        else:
            return "snapshot field %r must be an object or a list, got %s" % (k, type(v).__name__)
    def _said(field, got, want):                         # once per (node, field) per process, as _TURN_PRUNE_WARNED does
        if (nid, field) not in _SNAP_SAID:
            _SNAP_SAID.add((nid, field))
            log(LOG_WARNING, "node %s: snapshot field %r is %s, not %s — ignored", nid or "?", field, got, want)
    for blk in (snap.get("interfaces") or {}).values():
        if blk.get("meta") and not isinstance(blk["meta"], dict):
            _said("interfaces.*.meta", type(blk.pop("meta")).__name__, "dict")
    for k in ("wdtt", "csqtt"):
        for e in (snap[k] if isinstance(snap.get(k), list) else ()):
            if e.get("listen") and not isinstance(e["listen"], str):
                _said(k + "[].listen", type(e.pop("listen")).__name__, "str")
    for k, (outer, inner) in _SNAP_SHAPE.items():
        v = snap.get(k)
        if not v:
            continue                                     # absent, or empty: every reader reads it as nothing
        if not isinstance(v, outer):                     # a number does not walk; a map or a string walks as keys / letters
            _said(k, type(snap.pop(k)).__name__, outer.__name__)
        elif inner and not all(isinstance(x, inner) for x in (v if outer is list else v.values())):
            _said(k, "a %s holding other things" % outer.__name__, "a %s of %s" % (outer.__name__, inner.__name__))
            snap[k] = ([x for x in v if isinstance(x, inner)] if outer is list
                       else {kk: x for kk, x in v.items() if isinstance(x, inner)})
    _bad = (snap.get("rp_filter") or {}).get("bad")     # the one walked a level further in: ", ".join(bad)
    if _bad and not (isinstance(_bad, list) and all(isinstance(b, str) for b in _bad)):
        _said("rp_filter.bad", type(_bad).__name__ if not isinstance(_bad, list) else "a list holding other things", "a list of str")
        snap["rp_filter"]["bad"] = [b for b in _bad if isinstance(b, str)] if isinstance(_bad, list) else []
    return None


def _warm_seen(mtime, snap, now=None):
    """The `node_seen` a warm start may claim for a node: when THIS PANEL last heard from it, on its own clock.

    ⚠️ THE OLDEST OF THE THREE READINGS, because this value can outlive the boot. `node_seen` is only ever
    rewritten by a real sync, so a node that never syncs again keeps whatever is seeded here FOR EVER — and a
    state dir restored from a backup, or copied without timestamps, hands every mirror file a fresh mtime. The
    mtime alone would then resurrect long-dead nodes as "reporting" and un-grey every destructive action on
    them. The snapshot's own `generated_at` is on the node's clock, not ours, but it names the same instant, so
    the older of the two is the honest floor; `now` caps a file stamped in the future (a clock step, or a copy
    made by a box whose clock runs ahead). Neither reading usable → `now`, which is what warm start is for:
    show the last-known state for one pass instead of "awaiting enroll", and let the next sync correct it.
    """
    now = int(now if now is not None else time.time())
    def _t(v):
        n = _snap_num(v)
        return int(n) if n is not None and n > 0 else 0
    seen = [t for t in (_t(mtime), _t((snap or {}).get("generated_at"))) if t > 0]
    return min(seen + [now])


def _mint_device_exit(nodes, nid, ref, snap=None):
    """`dev:<name>` — a device the NODE reports but the panel has no exit record for — resolved to an exit
    id, minting the record if this is the first reference to it. Returns `(exit_id, error)`; a ref that is
    not `dev:` comes back untouched, so callers can hand this every reference they get.

    ⚠️ WHY THE SERVER AND NOT THE BROWSER. Every picker offers these devices, because a device the node
    reports is a way out whether or not the panel has written it down — but a REFERENCE is by id, and a
    candidate has no id. Something must turn one into a record. Doing it in the browser when the row is
    clicked was the obvious place and the wrong one: the interface sheet is a DRAFT, so cancelling it left a
    node-level exit behind that the operator never agreed to create. Here it is part of the save that needs
    it — one save, one record, or neither.

    ⚠️ AN EXISTING EXIT FOR THE SAME DEVICE IS REUSED, never duplicated. Two interfaces pointed at `wg-lab0`
    are two references to one exit, not two exits that happen to share a device — which would give the same
    device two kill-switch settings and two rows to keep in step.

    The device is judged by the SAME refusal set the editor and the plan use (`exit_device_refusal`), so a
    NIC, a mesh link or one of our own ingress interfaces cannot become an exit by being referenced."""
    ref = str(ref or "").strip()
    if not ref.startswith("dev:"):
        return ref, None
    dev = ref[4:].strip()
    c = nodes.get(nid) or {}
    exits = list(c.get("exits") or [])
    have = next((x for x in exits if isinstance(x, dict) and str(x.get("device") or "") == dev), None)
    if have:
        return str(have.get("id") or ""), None
    _lk = {(l or {}).get("iface") for l in (c.get("links") or {}).values()}
    _sn = snap or {}
    why = exit_device_refusal(c, dev, link_ifaces=_lk, nics=(_sn.get("ether_ifaces") or []),
                              gws=_sn.get("ether_gws"), wan=(_sn.get("wan_iface") or ""))
    if why:
        return "", "exit device refused: " + why
    eid = uuid.uuid4().hex[:8]
    exits.append({"id": eid, "label": "", "producer": "adopted", "device": dev,
                  "enabled": True, "killswitch": False})
    clean, err = _validate_exits(exits, c, link_ifaces=_lk, prev=c.get("exits") or [],
                                 nics=(_sn.get("ether_ifaces") or []), gws=_sn.get("ether_gws"),
                                 wan=(_sn.get("wan_iface") or ""))
    if err:
        return "", err
    nodes.setdefault(nid, c)["exits"] = clean
    # the id survives _validate_exits (it matches EXIT_ID_RE and cannot collide — it was just minted)
    return eid, None


def rule_on(r):
    p = r.get("ports") if isinstance(r, dict) else None
    if isinstance(p, dict):
        return p.get("on") is True
    w = r.get("who") if isinstance(r, dict) else None
    if isinstance(w, dict):
        return w.get("on") is True
    return isinstance(r, dict) and r.get("enabled", True) is not False


PORTS_PROTOS = ("tcp", "udp", "both")
PORTS_MAX_TOKENS = 32


def _ports_toks(raw):
    """The port grammar's tokens: commas or spaces between, an en dash read as a hyphen — the SPA's `portsToks`, exactly.
    One tokenizer for ports_clean and for naming what a list could not take (p2p_portok_clean)."""
    return [t for t in re.split(r"[, \t\r\n\u00a0]+", (raw or "").replace("\u2013", "-")) if t]


def ports_clean(proto, raw):
    """A rule's ports → (proto, canonical list) or (None, why). The list is ports and ranges, any separators of commas and
    spaces, an en dash read as a hyphen; canonical = sorted, overlapping and adjacent ranges merged, joined by "," with no
    spaces ("443,8000-8100"). Empty means every port of `proto`; `both` with none is not a port rule. The SPA reads the same
    grammar (`portsClean` in js/rulerows.js), both gated on tests/ports_vectors.json."""
    if proto not in PORTS_PROTOS:
        return None, "proto"
    if raw is not None and not isinstance(raw, str):
        return None, "list"
    toks = _ports_toks(raw)                                      # the SPA's exact separators
    if len(toks) > PORTS_MAX_TOKENS:
        return None, "too_many"
    spans = []
    for t in toks:
        m = re.fullmatch(r"([0-9]{1,5})(?:-([0-9]{1,5}))?", t)   # ASCII digits, as the SPA's \d
        if not m:
            return None, "list"
        a, b = int(m.group(1)), int(m.group(2) or m.group(1))
        if not (1 <= a <= b <= 65535):
            return None, "list"
        spans.append([a, b])
    if not spans and proto == "both":
        return None, "empty"
    spans.sort()
    out = []
    for a, b in spans:
        if out and a <= out[-1][1] + 1:
            out[-1][1] = max(out[-1][1], b)
        else:
            out.append([a, b])
    return proto, ",".join(str(a) if a == b else "%d-%d" % (a, b) for a, b in out)


def _exit_nodes(n):
    """Every node this node's configuration sends traffic out through: its default list's and its interfaces' (and WDTT /
    csqtt instances') exit rules, a forward's egress node, and a torrent route through a node — the ways cascade_plan reaches
    a peer (see mesh_need)."""
    out = set()
    if isinstance(n.get("default_routing"), list):
        out |= {str(r.get("node") or "") for r in n["default_routing"] if isinstance(r, dict) and rule_on(r) and r.get("action") == "exit"}
    for ov in [*(n.get("ifaces") or {}).values(), *(n.get("wdtt") or {}).values(), *(n.get("csqtt") or {}).values()]:
        if not isinstance(ov, dict) or ov.get("system"):
            continue
        if ov.get("egress_mode") == "forward":
            out.add(str(ov.get("egress_node") or ""))
        elif ov.get("egress_mode") == "smart":
            out |= {str(r.get("node") or "") for r in (ov.get("routing") or []) if isinstance(r, dict) and rule_on(r) and r.get("action") == "exit"}
        _rp = ov.get("p2p") if isinstance(ov.get("p2p"), dict) else {}
        if _rp.get("action") == "exit" and p2p_policy(n) == "iface" and "torrents" not in (ov.get("block") or []):
            out.add(str(_rp.get("node") or ""))      # …its own torrent route through a node (S11 review F10)
    if isinstance(n.get("p2p"), dict) and n["p2p"].get("action") == "exit":
        out.add(str(n["p2p"].get("node") or ""))     # …and the node's torrent policy's
    out.discard("")
    return out


def who_wid(subnet, who):
    """The selection's id on the wire: 12 hex of sha1(subnet + the canonical lists). The lists are sorted, so an unchanged
    selection keeps its id; 48 bits, because a collision would hand one row another row's people."""
    canon = json.dumps({k: sorted(_who_ids(who.get(k))) for k in ("users", "groups", "peers")},   # the ids the resolver reads; a bad shape names nobody
                       sort_keys=True, separators=(",", ":"))
    return hashlib.sha1((subnet + canon).encode()).hexdigest()[:12]


def _routing_roster(routing, deps):
    """The roster, loaded only when a rule in `routing` names people — a save without one never reads it."""
    if isinstance(routing, list) and any(isinstance(r, dict) and r.get("who") is not None for r in routing):
        return roster_load(deps["roster_path"])
    return None


def _ip4(v):
    """A stored value → an IPv4 literal, or "" — the ONE reader of an operator-supplied source address.

    The door validates what it writes, so this is about the file rather than the request: a hand-edited
    `routing_exit_ips` must not become `--to-source <junk>` on somebody's node, where iptables accepts it and
    every packet leaves with a source the box cannot receive on. Not a refusal — a plan that raised here
    would take down the sync of every node in the fleet over one bad character in one interface's map."""
    v = str(v or "").strip()
    if not v:
        return ""
    try:
        ipaddress.IPv4Address(v)
    except Exception:
        return ""
    return v


ROUTING_AUDS = ("local", "cascaded")    # D9 — a node default-list rule's audience; absent = All (docs/ROUTING-PEERS-MESH-PLAN.md §4.2)


def _validate_routing(routing, nodes, nid, custom_list_ids=(), prev=(), snap=None, roster=None, node_scope=False):
    """Validate + normalize a smart-routing rule list. Returns (clean_rules, error, dropped). Each rule:
    {enabled:bool, category:<in SMART_CATEGORIES | a custom_list id | "custom" | "tld">, action:"exit"|"direct"|"block",
    node:<exit nid if exit>}. A "tld" rule additionally carries match:"tld" + tlds:[label…] (route/block a whole
    top-level domain; see docs/PROTOCOL-ROUTING-PLAN.md §3.1). The implicit 'everything else → direct' default is
    NOT stored (appended at compile time).

    `dropped` is {entries: [{entry, reason}], total: n} — everything this refused to KEEP, so the caller can say
    so instead of the save quietly returning less than it was given (§5.4). Two reasons, and they are
    discriminators rather than sentences: the SPA owns the wording, because only the browser can name
    `mc:foo`'s provider or show the token the way the operator typed it. (No non-browser consumer exists — no
    /api/v1 route saves routing. Give them English here if one ever does.)

    CAPPED, with the true count kept. Nothing bounds how many targets a rule may carry, so a client posting two
    thousand unreadable tokens got all two thousand back — a 102 KB response echoing its own garbage, measured.
    The report exists to be read by a person; twenty is more than anyone reads and the total says how many
    there really were.
      unreadable   — a token that means nothing anywhere, in any mode ("goo gle..com", a bare "ru")
      unknown_list — a category id the catalog, the custom lists and the built-ins have all never heard of
    NOT in here: a rule this node's engine cannot enforce. That one is KEPT, shown inert and skipped at plan
