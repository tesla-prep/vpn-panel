                _pc = _port_conflict(deps, nodes, nid, p, own=_own + [ov.get("listen_port")],   # (its record's and where it listens now;
                                     me=("iface", iface))   # its other claims by identity) — not already bound by another holder
                if _pc:
                    return 400, {"ok": False, **perr("port {v1} is already used by {v2} on this node — pick another port", v1=p, v2=_pc), "code": "bad_request"}
                ov["listen_port"] = p
        if "dns" in body:
            dns = body.get("dns")
            if isinstance(dns, str):
                dns = [s.strip() for s in dns.split(",") if s.strip()]
            ov["dns"] = dns or []
        if "mtu" in body:
            raw = body.get("mtu")
            if raw in (None, "", 0, "0"):
                ov.pop("mtu", None)
            else:
                try:
                    m = int(raw)
                except (TypeError, ValueError):
                    return 400, {"ok": False, "error": "mtu must be a number", "code": "bad_request"}
                if not (576 <= m <= 9200):
                    return 400, {"ok": False, "error": "mtu must be 576–9200", "code": "bad_request"}
                ov["mtu"] = m
        if "keepalive" in body:
            raw = body.get("keepalive")
            if raw in (None, ""):
                ov.pop("keepalive", None)
            else:
                try:
                    k = int(raw)
                except (TypeError, ValueError):
                    return 400, {"ok": False, "error": "keepalive must be a number", "code": "bad_request"}
                if not (0 <= k <= 65535):
                    return 400, {"ok": False, "error": "keepalive must be 0-65535", "code": "bad_request"}
                ov["keepalive"] = k          # 0 is meaningful: "no PersistentKeepalive line"
        _rec0 = ov.get("awg_params") or {}   # the set as stored before this Save: the 3.1 switch asks if it was on 3.1 (CL-F1b)
        if "awg_params" in body:
            awg = body.get("awg_params")
            if not awg:
                ov.pop("awg_params", None)
            elif isinstance(awg, dict):
                clean, _om = awg_template(awg, gen3=True)
                _snap_u = (deps.get("node_snaps") or {}).get(nid) or {}
                _rep_u = (((_snap_u.get("interfaces") or {}).get(iface) or {}).get("meta") or {})
                _rec_u = dict(ov.get("awg_params") or {})
                _rep_ap = _rep_u.get("awg_params") if isinstance(_rep_u.get("awg_params"), dict) else {}
                for _k in clean:
