    return {}

def _turn_roster_save(d):
    with _TURN_ROSTER_LOCK, contextlib.suppress(Exception):
        tmp = TURN_ROSTER_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, TURN_ROSTER_PATH)

def _turn_roster_check(seed=True):
    roster = _turn_roster_load()
    out = {}
    seeded = False
    for cid in TURN_CLIENTS:
        if cid in TURN_GONE_CLIENTS:
            continue
        srcs = _client_sources(cid)
        if not srcs:
            out[cid] = {"name": (TURN_CLIENTS[cid].get("name") or cid), "status": "unwatched",
                        "files": [], "sources": [], "acknowledged_at": None}
            continue
        prev = (roster.get(cid) or {}).get("files") or {}
        files, any_unknown, any_changed, seen = [], False, False, {}
        for s in srcs:
            p = s["path"]
            latest = _gh_latest_commit(s["owner"], s["repo"], s["branch"], p)
            if not latest or not latest.get("sha"):
                files.append({"path": p, "status": "unknown", "url": "https://github.com/%s/%s/commits/%s/%s" % (s["owner"], s["repo"], s["branch"], p)})
                any_unknown = True
                continue
            seen[p] = {"commit": latest["sha"], "at": int(time.time())}
            old = (prev.get(p) or {}).get("commit")
            ch = bool(old) and old != latest["sha"]
            any_changed = any_changed or ch
            frec = {"path": p, "status": ("changed" if ch else "up_to_date"),
                    "latest_commit": (latest["sha"] or "")[:7], "latest_date": latest.get("date"), "url": latest.get("url"),
                    "compare_url": ("https://github.com/%s/%s/compare/%s...%s" % (s["owner"], s["repo"], old, latest["sha"])) if ch else None}
            if _source_field_parseable(p):
                prev_fields = (prev.get(p) or {}).get("fields")
                if ch or not old:
                    raw = _gh_raw(s["owner"], s["repo"], s["branch"], p)
                    cur_fields = _parse_source_fields(p, raw, s.get("message")) if raw is not None else None
                    if cur_fields is not None:
                        seen[p]["fields"] = cur_fields
                        if ch and prev_fields is not None:
                            frec["field_diff"] = {"added": [x for x in cur_fields if x not in prev_fields],
                                                  "removed": [x for x in prev_fields if x not in cur_fields],
                                                  "assisted": not p.endswith(".proto")}
                    elif prev_fields is not None:
                        seen[p]["fields"] = prev_fields
                elif prev_fields is not None:
                    seen[p]["fields"] = prev_fields
            files.append(frec)
        fresh = {p: v for p, v in seen.items() if p not in prev}
        if seed and fresh:
            rec, watched = roster.get(cid) or {}, {s["path"] for s in srcs}
            kept = {p: v for p, v in prev.items() if p in watched}
            roster[cid] = dict(rec, files=dict(kept, **fresh), at=rec.get("at") or int(time.time()))
            seeded = True
        if not prev and seed and seen:
            status = "up_to_date"
        elif any_changed:
            status = "changed"
        elif any_unknown and not any(f["status"] == "up_to_date" for f in files):
            status = "unknown"
        else:
            status = "up_to_date"
        out[cid] = {"name": (TURN_CLIENTS[cid].get("name") or cid), "status": status, "files": files,
                    "sources": srcs, "acknowledged_at": (roster.get(cid) or {}).get("at")}
    if seeded:
        _turn_roster_save(roster)
    rl = int(_GH_RATE.get("until") or 0)
    _tok = os.environ.get("SWG_GH_TOKEN", "").strip()
    return {"clients": out, "checked_at": int(time.time()),
            "watch_via": "api-token" if _tok else ("file" if _GH_FP.get("ok") else "api"),
            "rate_limited": (rl if rl > int(time.time()) else 0)}

def _turn_roster_ack(cid):
    srcs = _client_sources(cid)
    if not srcs:
        return None
    files = {}
    for s in srcs:
        latest = _gh_latest_commit(s["owner"], s["repo"], s["branch"], s["path"])
        if latest and latest.get("sha"):
            rec = {"commit": latest["sha"], "at": int(time.time())}
            if _source_field_parseable(s["path"]):
                raw = _gh_raw(s["owner"], s["repo"], s["branch"], s["path"])
                flds = _parse_source_fields(s["path"], raw, s.get("message")) if raw is not None else None
                if flds is not None:
                    rec["fields"] = flds
            files[s["path"]] = rec
    roster = _turn_roster_load()
    roster[cid] = {"files": files, "at": int(time.time())}
    _turn_roster_save(roster)
    return files

