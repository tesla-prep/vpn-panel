        host = urlparse(url).hostname or ""
    host = host or (url or "the repo")
    if isinstance(e, urllib.error.HTTPError):
        if e.code in (401, 403, 429):
            return perr("{v1} is rate-limiting this server's address — try the check again in a few minutes.", v1=host)
        return perr("{v1} answered {v2} to the update check.", v1=host, v2="HTTP %d" % e.code)
    if isinstance(e, urllib.error.URLError) and isinstance(getattr(e, "reason", None), BaseException):
        e = e.reason
    if isinstance(e, ssl.SSLCertVerificationError):
        return perr("Couldn't reach {v1} to check for updates — its TLS certificate could not be verified. "
                    "The CA certificates on this server may be missing or out of date.", v1=host)
    if isinstance(e, ssl.SSLError):
        return perr("Couldn't reach {v1} to check for updates — the TLS connection failed.", v1=host)
    if isinstance(e, socket.gaierror):
        return perr("Couldn't reach {v1} to check for updates — its name could not be resolved.", v1=host)
    if isinstance(e, ConnectionRefusedError):
        return perr("Couldn't reach {v1} to check for updates — the connection was refused.", v1=host)
    if isinstance(e, ConnectionResetError):
        return perr("Couldn't reach {v1} to check for updates — the connection was reset.", v1=host)
    if isinstance(e, (socket.timeout, TimeoutError)):
        return perr("Couldn't reach {v1} to check for updates — it did not answer in time.", v1=host)
    if isinstance(e, OSError) and e.errno in (errno.ENETUNREACH, errno.EHOSTUNREACH):
        return perr("Couldn't reach {v1} to check for updates — there is no route to it from this server.", v1=host)
    return perr("Couldn't reach {v1} to check for updates — {v2}.", v1=host, v2=type(e).__name__)


def _api_contents_url(url):
    m = re.match(r"^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.+)$", url or "")
    if not m:
        return ""
    owner, repo, ref, path = m.groups()
    path = path.split("?", 1)[0].split("#", 1)[0]
    if not path:
        return ""
    return ("https://api.github.com/repos/%s/%s/contents/%s?ref=%s"
            % (quote(owner, safe=""), quote(repo, safe=""), quote(path), quote(ref, safe="")))


def _gh_get(url, headers, nbytes, deadline, timeout=12, tries=3):
    def _fetch(u, hdrs):
        def _do():
            left = deadline - time.time()
            req = urllib.request.Request(u, headers=hdrs)
            with urllib.request.urlopen(req, timeout=max(3.0, min(timeout, left))) as r:
                return r.read(nbytes)
        return _http_retry(_do, tries=tries, deadline=deadline)
    try:
        return _fetch(url, headers)
    except Exception as e:
        first = e
    alt = _api_contents_url(url)
    if not alt or time.time() >= deadline:
        raise first
    try:
        return _fetch(alt, dict(headers, Accept="application/vnd.github.raw"))
    except Exception:
        raise first


def _check_latest_remote(budget=120):
    ok, why, url = False, None, REMOTE_VERSION_URL
    deadline = time.time() + max(5, budget)
    try:
        url = REMOTE_VERSION_URL + (("&" if "?" in REMOTE_VERSION_URL else "?") + "cb=" + str(int(time.time())))
        v = _short_ver(_gh_get(url, {"User-Agent": "swg-panel", "Cache-Control": "no-cache"},
                               64, deadline).decode("utf-8", "replace").strip())
        if _vtuple(v) == (0, 0, 0):
            v = ""
        if v:
            if not LATEST_REMOTE.get("version") or _vtuple(v) >= _vtuple(LATEST_REMOTE["version"]):
                LATEST_REMOTE["version"] = v
            ok = True
        else:
            why = perr("{v1} answered, but not with a version.", v1=(urlparse(url).hostname or url))
    except Exception as e:
        why = _why_fetch_failed(url, e)
    LATEST_REMOTE["checked"] = int(time.time())
    LATEST_REMOTE["why"] = None if ok else why
    return ok


def _resolve_turn_tag(owner):
    if not owner or "/" not in owner:
