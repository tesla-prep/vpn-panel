def socks_pool_public(pool):
    profiles = []
    for pid, entry in sorted(pool.items(), key=lambda item: (item[1]["label"].casefold(), item[0])):
        item = {"id": pid, "label": entry["label"], "enabled": entry.get("enabled", True),
                "provider": entry.get("provider", "socks5"), "socks": socks_public(entry["socks"])}
        test = entry.get("check")
        if test and test["sig"] == _pool_exit(pid, entry)["cfg_sig"]:
            item["check"] = {"node": test["node"], "result": test["result"]}
        profiles.append(item)
    return profiles


EXIT_TEST_TTL = 90
