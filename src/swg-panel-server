    return tuple(out)


def _blk_bucket(cache, srcpaths, host):
    if host in cache:
        return cache[host] or None
    labels = host.split(".")
    suffixes = [".".join(labels[k:]) for k in range(max(0, len(labels) - 1))]
    hit = ""
    for cid, paths in srcpaths:
        if any(_blk_file_has(p, suf) for p in paths for suf in suffixes):
            hit = cid; break
    if len(cache) > 6000:
        cache.clear()
    cache[host] = hit
    return hit or None


def _block_feeds(cat, bpe, node_id, mode, blk_ids):
    feeds, mids = {}, []
    for cid in (blk_ids or []):
        c = cat.get(cid) or {}
        if not c.get("enabled", True):
            continue
        if c.get("kind") == "mechanism":
            mids.append(cid)
            continue
        if node_id not in (c.get("enabled_nodes") or []):
            continue
        for s in (c.get("sources") or []):
            prov = (s.get("provider") or "").strip(); lst = (s.get("list") or "").strip()
            if not prov or not bpe.get(prov, True):
                continue
            tier = (BLOCK_PROVIDERS.get(prov) or {}).get("tier", "host")
            if tier == "host" and mode in ("kernel", "sni_kernel"):
                continue
            pair = ("blk:" + prov + ":" + lst, tier)
            if pair not in feeds.setdefault(cid, []):
                feeds[cid].append(pair)
        if not feeds.get(cid):
            feeds.pop(cid, None)
    return feeds, mids


def _node_block_lists(node):
    out = [ov.get("block") for ov in (node.get("ifaces") or {}).values() if isinstance(ov, dict) and not ov.get("system")]
    out += [(w or {}).get("block") for k in ("wdtt", "csqtt") for w in (node.get(k) or {}).values()]
    return [b for b in out if b]


def _resolve_iface_blocks(node, snap, panel_settings, mode, node_id):
    cat = block_catalog(panel_settings)
    bpe = block_providers_enabled(panel_settings)
    _nb_nets = block_allow_split(panel_settings)[1]
    ifaces = (snap or {}).get("interfaces") or {}
    entries = []; srcs = {}; mech = {}
    def _add(subnet, blk_ids):
        if not subnet or not blk_ids:
            return
        feeds, mids = _block_feeds(cat, bpe, node_id, mode, blk_ids)
        for mid in mids:
            mech.setdefault(subnet, set()).add(mid)
        tier_srcs = {"host": [], "ip": []}
        for pairs in feeds.values():
            for sid, tier in pairs:
                if sid not in tier_srcs[tier]:
                    tier_srcs[tier].append(sid)
        for tier in ("host", "ip"):
            ready = [sid for sid in tier_srcs[tier] if _blku_ready(sid, tier) is not None]
            for sid in tier_srcs[tier]:
                if sid not in ready:
                    list_ensure(sid, tier)
            if not ready:
                continue
            _al = _nb_nets if tier == "ip" else ()
            key = _blku_key(tier, ready, _al)
            _BLKU_REG[key] = sorted(ready)
            if _al:
                _BLKU_ALLOW[key] = list(_al)
            srcs[key] = tier
            entries.append({"subnet": subnet, "category": key, "action": "block"})
    for ifn, ov in (node.get("ifaces") or {}).items():
        if ov.get("system"):
            continue
        _add((((ifaces.get(ifn) or {}).get("meta") or {}).get("subnet")) or "", _validate_block(ov.get("block"), panel_settings))
    for _wov in (node.get("wdtt") or {}).values():
        _add(_wdtt_net((_wov or {}).get("wg_addr") or ""), _validate_block((_wov or {}).get("block"), panel_settings))
        if (_wov or {}).get("raw_port"):
            _add(_wdtt_net((_wov or {}).get("raw_addr") or ""), _validate_block((_wov or {}).get("block"), panel_settings))
    for _cov in (node.get("csqtt") or {}).values():
        _add(_wdtt_net((_cov or {}).get("tun_addr") or ""), _validate_block((_cov or {}).get("block"), panel_settings))
    return entries, srcs, {s: sorted(v) for s, v in mech.items()}


