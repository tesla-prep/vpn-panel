#!/usr/bin/env python3
"""
swg-panel-server — the panel broker.

Serves the app and brokers peer operations to nodes over a per-node transport
(local subprocess / ssh forced-command / async queue). A peer is one identity
that can be deployed to several nodes for redundancy: the panel picks an address
free on every selected node, pushes the same pubkey + IP + PSK to each, and
records the node set. Reads (describe / next-ip) for local & ssh hit the agent
live; for queue nodes they come from the node's pushed snapshot.

The browser generates the private key and PSK. The PSK transits once to
configure each node and is never written to the roster. Per-node client configs
are stored only when store_configs is on (then they contain the private key).

Config: /etc/swg-panel/fleet.json. Public HTTPS is served by nginx.

"""

# Run through compile(), not the script runner
import os, sys

_SWG_LOADER = ("import sys;d=sys.argv.pop(1);c=sys.argv.pop(1);p=sys.argv.pop(1);"
               "sys.path[:1]=[d]if sys.path[:1]==['']else sys.path[:1];"      # -c put the cwd first: the script's dir
               "import runpy;runpy.run_path(p,{'_SWG_REEXEC':1,'_SWG_COMM':c},'__main__')")   # goes back BEFORE any import


def _swg_reexec(hold_sighup=False):
    """Replace this process with the compile() load above — or return, and the process carries on unchanged.
    Called at module level, so it checks __name__ itself: the file's only main guard stays the one at its end —
    the line the test loaders cut the source at."""
    if __name__ != "__main__":
        return                                   # loaded as a module (tests, tooling): nothing to do
    if globals().get("_SWG_REEXEC") or _SWG_LOADER in getattr(sys, "orig_argv", ()):
        name = globals().get("_SWG_COMM")        # the second load (two independent marks: it can never loop) takes back
        if name:                                 # the script run's process name: `swg-noded` where the shebang names the
            try:                                 # interpreter itself (Nix), `python3` behind `env` — the exec made it python3
                with open("/proc/self/comm") as f:
                    now = f.read().strip()
                if now != name:
                    with open("/proc/self/comm", "w") as f:
                        f.write(name)
            except Exception:
                pass
        return
    if os.environ.get("SWG_NO_REEXEC"):
        return                                   # the operator's switch back to the plain script run
    script = globals().get("__file__")
    if not (script and sys.executable and sys.argv and os.path.isfile(script)
            and os.path.realpath(sys.argv[0]) == os.path.realpath(script)):
        return                                   # not a plain script run (a test loading the module, an exec …)
    if hasattr(sys, "orig_argv"):                # 3.10+: only when the interpreter was given no options at all
        if sys.orig_argv[1:] != sys.argv:
            return
    else:                                        # 3.7–3.9: none visible in sys.flags, and no -u
        try:
            import subprocess
            if subprocess._args_from_interpreter_flags():
                return
        except Exception:
            return
        if getattr(sys.stdout, "write_through", False) and not os.environ.get("PYTHONUNBUFFERED"):
            return
    try:
        with open("/proc/self/comm") as f:
            comm = f.read().strip()
    except Exception:
        comm = ""                                # no /proc: the second load keeps the interpreter's name
    held = None
    if hold_sighup:
        import signal
        held = signal.getsignal(signal.SIGHUP)
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    try:
        os.execv(sys.executable, [sys.executable, "-c", _SWG_LOADER, sys.path[0] if sys.path else "", comm, script]
                 + sys.argv[1:])
    except OSError:
        if held is not None:
            signal.signal(signal.SIGHUP, held)   # the exec failed: back to exactly how this process started


_swg_reexec(hold_sighup=len(sys.argv) == 1)   # the server start (no arguments) holds SIGHUP; `passwd` does not

