def _sub_url_base(url):
    with contextlib.suppress(Exception):
        p = urlparse((url if "://" in (url or "") else "https://" + (url or ""))).path.rstrip("/")
        if p and p != "/":
            return p
    return ""
def _raise_fd_limit():
    try:
        import resource
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        want = min(hard, 65536) if hard != resource.RLIM_INFINITY else 65536
        if soft < want:
            resource.setrlimit(resource.RLIMIT_NOFILE, (want, hard))
            log(LOG_INFO, "swg-panel: raised open-file limit %d -> %d", soft, want)
    except Exception as e:
        log(LOG_WARNING, "swg-panel: could not raise the open-file limit (%s) — staying at the default" % e)


_FD_WARNED = {"at": 0.0}


def _fd_watchdog_loop():
    try:
        import faulthandler, resource
        faulthandler.register(signal.SIGUSR1, all_threads=True)
    except Exception:
        faulthandler = None
    while True:
        try:
            time.sleep(30)
            soft = resource.getrlimit(resource.RLIMIT_NOFILE)[0]
            try:
                n = len(os.listdir("/proc/self/fd"))
            except OSError:
                continue
            if soft and n > soft * 0.6 and time.time() - _FD_WARNED["at"] > 600:
                _FD_WARNED["at"] = time.time()
                log(LOG_ERR, "swg-panel: OPEN FILES %d of %d (%d threads) — dumping thread stacks so the "
                                 "holder is named while it is still happening", n, soft, threading.active_count())
                sys.stderr.flush()
                if faulthandler:
                    faulthandler.dump_traceback(file=sys.stderr, all_threads=True)
                    sys.stderr.flush()
        except Exception:
            pass


def _release_startup_memory():
    try:
        import ctypes
        trim = ctypes.CDLL(None).malloc_trim
        trim.argtypes, trim.restype = (ctypes.c_size_t,), ctypes.c_int
        trim(0)
    except Exception:
        pass


