        kept = pool.get(profile_id) if isinstance(profile_id, str) else None
        if profile_id and not kept:
            return 404, {"ok": False, **perr("Proxy profile not found"), "code": "not_found"}
        if body.get("delete") is True:
            if not kept:
                return 400, {"ok": False, **perr("Choose a proxy profile"), "code": "bad_request"}
            owner = next((u.get("name") or uid for uid, u in roster_load(roster_path)["users"].items()
                          if (u.get("socks_profile") or {}).get("id") == profile_id), None)
            if owner is not None:
                return 409, {"ok": False, **perr("Remove the proxy assignment in {v1}'s user card first",
                                                 v1=owner), "code": "conflict"}
            fixed = next((nid for nid, _, rule_path in _configured_cascades(nodes)
                          if rule_path.get("profile") == profile_id), None)
            if fixed is not None:
                return 409, {"ok": False, **perr("A routing rule on {v1} still uses this proxy profile",
                                                 v1=nodes[fixed].get("name") or fixed), "code": "conflict"}
            del pool[profile_id]
        else:
            label = str(body.get("label") or "").strip()[:40]
            if not label:
                return 400, {"ok": False, **perr("Choose a name for the proxy profile"), "code": "bad_request"}
            provider = body.get("provider", (kept or {}).get("provider", "socks5"))
            if provider not in PROXY_KINDS:
                return 400, {"ok": False, **perr("Choose SOCKS5 or HTTP CONNECT"), "code": "bad_request"}
            old = (kept or {}).get("socks") or {}
            sk, err = socks_resolve(body.get("socks_text"), body.get("socks_pass"), old, provider)
            if err:
                return 400, {"ok": False, **perr(err), "code": "bad_request"}
            same_proxy = all(sk.get(k) == old.get(k) for k in ("host", "port", "user", "pass"))
            sk["salt"] = (old.get("salt") if same_proxy else "") or secrets.token_hex(8)
            if not profile_id:
                while not profile_id or profile_id in pool:
                    profile_id = uuid.uuid4().hex[:8]
            entry = {**(kept or {}), "label": label, "provider": provider,
                     "socks": sk, "enabled": body.get("enabled", True) is not False}
            if entry.get("check") and entry["check"]["sig"] != _pool_exit(profile_id, entry)["cfg_sig"]:
                entry.pop("check")
            pool[profile_id] = entry
        save_socks_pool(deps, pool)
