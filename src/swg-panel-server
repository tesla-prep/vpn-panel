    return {k: doc[k] for k in ("mb", "used_mb", "oldest", "err", "unsupported") if isinstance(doc.get(k), (int, float, str))}


_DROPPED_CAP = 20


def _dropped_report(entries):
    return {"entries": entries[:_DROPPED_CAP], "total": len(entries)} if entries else {"entries": [], "total": 0}


_SNAP_TELEMETRY = ("inet", "cat_rate", "exit_rate")
_SNAP_STATE = ("interfaces", "wdtt", "csqtt")
_SNAP_SHAPE = {
    **dict.fromkeys(("container_ifaces", "devexit", "exit_candidates", "exits",
                     "node_ip_ifaces", "turn_proxies"), (list, dict)),
    **dict.fromkeys(("ether_ifaces", "exit_kinds", "ifaces_awaiting_key", "node_ifaces", "node_ips"), (list, str)),
    **dict.fromkeys(("iface_drops", "mesh_health"), (dict, dict)),
    "endpoint_host": (str, None),
    "udp_listen": (list, int),
    **dict.fromkeys(("cascade_paths", "iface_key_sealed", "ip_forward", "relay", "rp_filter", "static_egress", "wdtt_key_sealed"), (dict, None)),
}
_SNAP_SAID = set()


def _snap_num(v):
    try:
        n = max(0.0, float(v or 0))
    except (TypeError, ValueError, OverflowError):
        return None
    return n if math.isfinite(n) else None


def _json_finite(s):
    n = float(s)
    if not math.isfinite(n) or abs(n) > 1e100:
        raise ValueError("not a finite number: %.24s" % s)
    return n


def _json_int(s):
    if len(s.lstrip("-")) > 100:
        raise ValueError("a number past 1e100: %.24s…" % s)
    return int(s)


def _snap_sanitise(snap, nid=""):
    if not isinstance(snap, dict):
        return "snapshot must be an object"
    _g = snap.get("generated_at")
    if _g is not None and not isinstance(_g, int):
        _gn = _snap_num(_g)
        if _gn is None or _gn <= 0:
            snap.pop("generated_at")
        else:
            snap["generated_at"] = int(_gn)
    for k in _SNAP_TELEMETRY:
        if k not in snap:
            continue
        v = snap.get(k)
        if not isinstance(v, dict):
            snap.pop(k)
            continue
        if k == "inet":
            snap[k] = {kk: _snap_num(vv) for kk, vv in v.items() if _snap_num(vv) is not None}
            continue
        clean = {}
        for kk, vv in v.items():
            if not isinstance(vv, dict):
                continue
            inner = {ik: _snap_num(iv) for ik, iv in vv.items() if _snap_num(iv) is not None}
            if inner:
                clean[str(kk)] = inner
        snap[k] = clean
    if isinstance(snap.get("interfaces"), list):
        return "snapshot field 'interfaces' must be an object, got list"
    for k in _SNAP_STATE:
        if k not in snap:
            continue
        v = snap[k]
        if isinstance(v, dict):
            bad = next((kk for kk, vv in v.items() if not isinstance(vv, dict)), None)
            if bad is not None:
                return "snapshot field %r: entry %r must be an object, got %s" % (k, bad, type(v[bad]).__name__)
        elif isinstance(v, list):
            bad = next((i for i, vv in enumerate(v) if not isinstance(vv, dict)), None)
            if bad is not None:
                return "snapshot field %r: item %d must be an object, got %s" % (k, bad, type(v[bad]).__name__)
        else:
            return "snapshot field %r must be an object or a list, got %s" % (k, type(v).__name__)
    def _said(field, got, want):
        if (nid, field) not in _SNAP_SAID:
            _SNAP_SAID.add((nid, field))
            log(LOG_WARNING, "node %s: snapshot field %r is %s, not %s — ignored", nid or "?", field, got, want)
    for blk in (snap.get("interfaces") or {}).values():
        if blk.get("meta") and not isinstance(blk["meta"], dict):
            _said("interfaces.*.meta", type(blk.pop("meta")).__name__, "dict")
    for k in ("wdtt", "csqtt"):
        for e in (snap[k] if isinstance(snap.get(k), list) else ()):
            if e.get("listen") and not isinstance(e["listen"], str):
                _said(k + "[].listen", type(e.pop("listen")).__name__, "str")
    for k, (outer, inner) in _SNAP_SHAPE.items():
        v = snap.get(k)
        if not v:
            continue
        if not isinstance(v, outer):
            _said(k, type(snap.pop(k)).__name__, outer.__name__)
        elif inner and not all(isinstance(x, inner) for x in (v if outer is list else v.values())):
            _said(k, "a %s holding other things" % outer.__name__, "a %s of %s" % (outer.__name__, inner.__name__))
            snap[k] = ([x for x in v if isinstance(x, inner)] if outer is list
                       else {kk: x for kk, x in v.items() if isinstance(x, inner)})
    _bad = (snap.get("rp_filter") or {}).get("bad")
    if _bad and not (isinstance(_bad, list) and all(isinstance(b, str) for b in _bad)):
        _said("rp_filter.bad", type(_bad).__name__ if not isinstance(_bad, list) else "a list holding other things", "a list of str")
        snap["rp_filter"]["bad"] = [b for b in _bad if isinstance(b, str)] if isinstance(_bad, list) else []
    return None


def _warm_seen(mtime, snap, now=None):
    now = int(now if now is not None else time.time())
    def _t(v):
        n = _snap_num(v)
        return int(n) if n is not None and n > 0 else 0
    seen = [t for t in (_t(mtime), _t((snap or {}).get("generated_at"))) if t > 0]
    return min(seen + [now])


def _mint_device_exit(nodes, nid, ref, snap=None):
    ref = str(ref or "").strip()
    if not ref.startswith("dev:"):
        return ref, None
    dev = ref[4:].strip()
    c = nodes.get(nid) or {}
    exits = list(c.get("exits") or [])
    have = next((x for x in exits if isinstance(x, dict) and str(x.get("device") or "") == dev), None)
    if have:
        return str(have.get("id") or ""), None
    _lk = {(l or {}).get("iface") for l in (c.get("links") or {}).values()}
    _sn = snap or {}
    why = exit_device_refusal(c, dev, link_ifaces=_lk, nics=(_sn.get("ether_ifaces") or []),
                              gws=_sn.get("ether_gws"), wan=(_sn.get("wan_iface") or ""))
    if why:
        return "", "exit device refused: " + why
    eid = uuid.uuid4().hex[:8]
    exits.append({"id": eid, "label": "", "producer": "adopted", "device": dev,
                  "enabled": True, "killswitch": False})
    clean, err = _validate_exits(exits, c, link_ifaces=_lk, prev=c.get("exits") or [],
                                 nics=(_sn.get("ether_ifaces") or []), gws=_sn.get("ether_gws"),
                                 wan=(_sn.get("wan_iface") or ""))
    if err:
        return "", err
    nodes.setdefault(nid, c)["exits"] = clean
    return eid, None


def rule_on(r):
    p = r.get("ports") if isinstance(r, dict) else None
    if isinstance(p, dict):
        return p.get("on") is True
    w = r.get("who") if isinstance(r, dict) else None
    if isinstance(w, dict):
        return w.get("on") is True
    return isinstance(r, dict) and r.get("enabled", True) is not False


PORTS_PROTOS = ("tcp", "udp", "both")
PORTS_MAX_TOKENS = 32


def _ports_toks(raw):
    return [t for t in re.split(r"[, \t\r\n\u00a0]+", (raw or "").replace("\u2013", "-")) if t]


def ports_clean(proto, raw):
    if proto not in PORTS_PROTOS:
        return None, "proto"
    if raw is not None and not isinstance(raw, str):
        return None, "list"
    toks = _ports_toks(raw)
    if len(toks) > PORTS_MAX_TOKENS:
        return None, "too_many"
    spans = []
    for t in toks:
        m = re.fullmatch(r"([0-9]{1,5})(?:-([0-9]{1,5}))?", t)
        if not m:
            return None, "list"
        a, b = int(m.group(1)), int(m.group(2) or m.group(1))
        if not (1 <= a <= b <= 65535):
            return None, "list"
        spans.append([a, b])
    if not spans and proto == "both":
        return None, "empty"
    spans.sort()
    out = []
    for a, b in spans:
        if out and a <= out[-1][1] + 1:
            out[-1][1] = max(out[-1][1], b)
        else:
            out.append([a, b])
    return proto, ",".join(str(a) if a == b else "%d-%d" % (a, b) for a, b in out)


def _exit_nodes(n):
    out = set()
    if isinstance(n.get("default_routing"), list):
        out |= {str(r.get("node") or "") for r in n["default_routing"] if isinstance(r, dict) and rule_on(r) and r.get("action") == "exit"}
    for ov in [*(n.get("ifaces") or {}).values(), *(n.get("wdtt") or {}).values(), *(n.get("csqtt") or {}).values()]:
        if not isinstance(ov, dict) or ov.get("system"):
            continue
        if ov.get("egress_mode") == "forward":
            out.add(str(ov.get("egress_node") or ""))
        elif ov.get("egress_mode") == "smart":
            out |= {str(r.get("node") or "") for r in (ov.get("routing") or []) if isinstance(r, dict) and rule_on(r) and r.get("action") == "exit"}
        _rp = ov.get("p2p") if isinstance(ov.get("p2p"), dict) else {}
        if _rp.get("action") == "exit" and p2p_policy(n) == "iface" and "torrents" not in (ov.get("block") or []):
            out.add(str(_rp.get("node") or ""))
    if isinstance(n.get("p2p"), dict) and n["p2p"].get("action") == "exit":
        out.add(str(n["p2p"].get("node") or ""))
    out.discard("")
    return out


def who_wid(subnet, who):
    canon = json.dumps({k: sorted(_who_ids(who.get(k))) for k in ("users", "peers")},
                       sort_keys=True, separators=(",", ":"))
    return hashlib.sha1((subnet + canon).encode()).hexdigest()[:12]


def _routing_roster(routing, deps):
    if isinstance(routing, list) and any(isinstance(r, dict) and r.get("who") is not None for r in routing):
        return roster_load(deps["roster_path"])
    return None


def _ip4(v):
    v = str(v or "").strip()
    if not v:
        return ""
    try:
        ipaddress.IPv4Address(v)
    except Exception:
        return ""
    return v


ROUTING_AUDS = ("local", "cascaded")


def _validate_routing(routing, nodes, nid, custom_list_ids=(), prev=(), snap=None, roster=None, node_scope=False):
    if not isinstance(routing, list):
        return None, "routing must be a list of rules", _dropped_report([])
    dropped = []
    _cat_idx, _cat_have = catalog_cached()
    clean = []
    paths = None
    for r in routing:
        if not isinstance(r, dict):
            return None, "each routing rule must be an object", _dropped_report(dropped)
        cat = (r.get("category") or "").strip()
        tgt = None
        if cat == "tld" or r.get("match") == "tld" or r.get("tlds"):
            _raw_tlds = r.get("value") if r.get("value") is not None else r.get("tlds")
            for _t in (re.split(r"[,\s]+", str(_raw_tlds or "")) if isinstance(_raw_tlds, str) else (_raw_tlds or [])):
                _t = str(_t).strip()
                if _t and not _clean_tlds([_t]):
                    dropped.append({"entry": _t[:120], "reason": "unreadable"})
            _pats = tld_patterns(_raw_tlds)
            if not _pats:
                continue
            r = {k: v for k, v in r.items() if k not in ("match", "tlds", "value")}
            r["category"] = cat = "custom"
            r["targets"] = ", ".join(_pats)
        if cat == "custom":
            _bad = []
            doms, cidrs, asns, pats = _clean_targets(
                r.get("targets") if r.get("targets") is not None
                else [*(r.get("domains") or []), *(r.get("cidrs") or []), *(r.get("asns") or []),
                      *(r.get("patterns") or [])], keep_asns=True, dropped=_bad, keep_patterns=True)
            for _t in _bad:
                dropped.append({"entry": str(_t)[:120], "reason": "unreadable"})
            if not doms and not cidrs and not asns and not pats:
                continue
            tgt = (doms, cidrs, asns, pats)
        elif cat in custom_list_ids:
            pass
        elif _is_routed_list_cat(cat) and (cat in _cat_idx or not _cat_have):
            pass
        elif cat != "all":
            dropped.append({"entry": cat, "reason": "unknown_list"})
            continue
        act = (r.get("action") or "exit").strip()
        if act not in ("exit", "direct", "block"):
            return None, "rule action must be exit|direct|block", _dropped_report(dropped)
        out = {"enabled": r.get("enabled", True) is not False, "category": cat, "action": act}
        row_id = r.get("row_id")
        if cat != "all" and isinstance(row_id, str) and re.fullmatch(r"[a-f0-9]{16}", row_id):
            out["row_id"] = row_id
        if tgt is not None:
            out["domains"], out["cidrs"] = tgt[0], tgt[1]
            if tgt[2]:
                out["asns"] = tgt[2]
            if tgt[3]:
                out["patterns"] = tgt[3]
        if act == "exit":
            path = r.get("cascade")
            if path is not None:
                if paths is None:
                    paths = {_cascade_identity(n, p): p["address"] for n, _, p in _configured_cascades(nodes)}
                path, error = _validate_cascade_path(path, nodes, nid, prev, paths)
                if error:
                    return None, error, _dropped_report(dropped)
                out["cascade"] = path
            en = path["nodes"][0] if path else str(r.get("node") or "").strip()
            if not path and (en not in nodes or en == nid):
                return None, f"rule for '{cat}': exit node must be another known node", _dropped_report(dropped)
            if not path and not any(isinstance(old, dict) and old.get("action") == "exit"
                                    and old.get("node") == en and not old.get("cascade") for old in prev or ()):
                return None, "Choose Through nodes and set the primary chain.", _dropped_report(dropped)
            out["node"] = en
        if act == "dev":
            xid = (r.get("exit_id") or "").strip()
            xid, _merr = _mint_device_exit(nodes, nid, xid, snap)
            if _merr:
                return None, f"rule for '{cat}': " + _merr, _dropped_report(dropped)
            _have = {str((x or {}).get("id")) for x in ((nodes.get(nid) or {}).get("exits") or [])}
            _was = {str((o or {}).get("exit_id") or "") for o in (prev or []) if (o or {}).get("action") == "dev"}
            if not xid or (xid not in _have and xid not in _was):
                return None, f"rule for '{cat}': exit must be one of this node's exits", _dropped_report(dropped)
            out["exit_id"] = xid
        if node_scope:
            if r.get("who") is not None:
                return None, "A node's default rules apply to its own clients or to traffic cascaded in, not to chosen people", _dropped_report(dropped)
            _aud = r.get("aud")
            if _aud not in (None, ""):
                if _aud not in ROUTING_AUDS:
                    return None, "a rule's audience must be local or cascaded", _dropped_report(dropped)
                if cat == "all":
                    return None, "“Everything else” applies to both this node's clients and traffic cascaded in", _dropped_report(dropped)
                out["aud"] = _aud
        if r.get("who") is not None:
            w = r["who"]
            lists = {k: (w.get(k) if isinstance(w, dict) else None) or [] for k in ("users", "peers")}
            if not isinstance(w, dict) or not all(isinstance(v, list) and all(isinstance(x, str) for x in v)
                                                  for v in lists.values()):
                return None, "“For whom” must list users or devices", _dropped_report(dropped)
            if cat == "all":
                return None, "“Everything else” applies to everyone on the interface", _dropped_report(dropped)
            ro = roster or {}
            known = {"users": ro.get("users") or {}, "peers": ro.get("peers") or {}}
            stored = {k: {x for o in (prev or ()) if isinstance(o, dict) and isinstance(o.get("who"), dict)
                          for x in (o["who"].get(k) or [])} for k in lists}
            keep = {}
            for k, ids in lists.items():
                if any(x not in known[k] and x not in stored[k] for x in ids):
                    return None, "A chosen user or device no longer exists — reload and choose again", _dropped_report(dropped)
                keep[k] = sorted({x for x in ids if x in known[k]})
            if (not any(lists.values()) and not any(isinstance(o, dict) and isinstance(o.get("who"), dict)
                                                    and not any(o["who"].get(k) for k in lists) for o in (prev or ()))):
                return None, "Choose at least one person or device, or pick “Everyone on this interface”.", _dropped_report(dropped)
            out["enabled"] = False
            out["who"] = {"on": (w.get("on") is True) if "on" in w else (r.get("enabled", True) is not False), **keep}
        if r.get("ports") is not None:
            p = r["ports"]
            _ns = (lambda v: {k: x for k, x in v.items() if k != "on"} if isinstance(v, dict) else v)
            if any(isinstance(o, dict) and "ports" in o and _ns(o["ports"]) == _ns(p) for o in (prev or ())) \
                    and (node_scope or cat == "all" or not isinstance(p, dict) or ports_clean(p.get("proto"), p.get("list"))[0] is None):
                out["enabled"] = False
                if "who" in out:
                    out["who"]["on"] = False
                out["ports"] = {**p, "on": (p.get("on") is True) if "on" in p else rule_on(out)} if isinstance(p, dict) else p
                clean.append(out)
                continue
            if node_scope:
                return None, "A node's default rules can't name ports — set them on an interface's rule", _dropped_report(dropped)
            if cat == "all":
                return None, "“Everything else” applies to every port — use a rule to 0.0.0.0/0 with ports", _dropped_report(dropped)
            pp, pl = ports_clean(p.get("proto"), p.get("list")) if isinstance(p, dict) else (None, "proto")
            if pp is None:
                return None, ("Ports: “Any” protocol needs at least one port" if pl == "empty"
                              else "Ports: at most 32 ports or ranges" if pl == "too_many"
                              else "Ports: write ports and ranges from 1 to 65535, like 443, 8000-8100"), _dropped_report(dropped)
            _on = (p.get("on") is True) if "on" in p else rule_on(out)
            out["enabled"] = False
            if "who" in out:
                out["who"]["on"] = False
            out["ports"] = {"on": _on, "proto": pp, "list": pl}
        clean.append(out)
    return clean, None, _dropped_report(dropped)


def _validate_cascade_path(path, nodes, origin, prev, paths):
    hops = path.get("nodes") if isinstance(path, dict) else None
    proxy = path.get("socks5", "") if isinstance(path, dict) else None
    if (not isinstance(hops, list) or not hops or not all(isinstance(n, str) and n for n in hops)
            or origin in hops or len(set(hops)) != len(hops) or not isinstance(proxy, str)):
        return None, "Choose an ordered cascade of distinct nodes."
    pooled = path.get("pool") is True
    backup = path.get("backup", [])
    if (not isinstance(path.get("pool", False), bool)
            or not isinstance(backup, list) or not all(isinstance(n, str) and n for n in backup)
            or origin in backup or len(set(backup)) != len(backup)
            or (backup and (not pooled or backup == hops)) or (pooled and proxy)):
        return None, "Choose a distinct backup chain without repeated nodes."
    clean = {"nodes": hops, **({"socks5": proxy} if proxy else {})}
    proxy_mode = path.get("proxy_mode", "user")
    if proxy_mode not in ("user", "direct") or ("proxy_mode" in path and not pooled):
        return None, "Choose direct access or the user's proxy for this cascade."
    if proxy_mode == "direct":
        clean["proxy_mode"] = "direct"
    profile = path.get("profile")
    if profile:
        if pooled or proxy or not isinstance(profile, str):
            return None, "A fixed SOCKS5 profile can only be kept on its saved cascade."
        clean["profile"] = profile
    if path.get("egress_ip"):
        ip = _ip4(path["egress_ip"])
        if not ip or not pooled:
            return None, "Choose a valid IPv4 address on the final node."
        clean["egress_ip"] = ip
    if path.get("wan_iface"):
        wan = path["wan_iface"]
        if not isinstance(wan, str) or not any(
                isinstance(r, dict) and (r.get("cascade") or {}).get("wan_iface") == wan
                and (r["cascade"].get("nodes") or [None])[-1] == hops[-1] for r in prev or ()):
            return None, "The saved WAN interface belongs to a different exit node."
        clean["wan_iface"] = wan
    if pooled:
        clean["pool"] = True
        if backup:
            clean["backup"] = backup
    identity = _cascade_identity(origin, clean)
    saved = any(isinstance(rule, dict) and rule.get("cascade")
                and _cascade_identity(origin, rule["cascade"]) == identity for rule in prev or ())
    if not saved:
        if profile or proxy:
            return None, "A fixed SOCKS5 profile can only be kept on its saved cascade."
        if not pooled:
            return None, "Choose Through nodes and set the primary chain."
        if not all(n in nodes for n in hops + backup):
            return None, "A cascade node no longer exists."
    clean["address"] = _cascade_address(identity, paths)
    if not clean["address"]:
        return None, "No addresses are available for another cascade."
    return clean, None


EXIT_ID_RE = re.compile(r"^[a-f0-9]{8}$")

EXIT_KEY_KEEP = "(unchanged — the panel never shows a stored private key)"
EXIT_PSK_KEEP = "(unchanged — the panel never shows a stored preshared key)"


_WG_KEY_RE = re.compile(r"^[A-Za-z0-9+/]{43}=$")


def parse_wg_profile(text):
    if not isinstance(text, str) or len(text) > 8000:
        return None, "that doesn't look like a WireGuard profile"
    sec, iface, peer, npeer = "", {}, {}, 0
    for ln in text.splitlines():
        ln = ln.split("#", 1)[0].strip()
        if not ln:
            continue
        if ln.startswith("["):
            sec = ln.strip("[]").strip().lower()
            npeer += sec == "peer"
            continue
        if "=" not in ln:
            continue
        k, v = ln.split("=", 1)
        (iface if sec == "interface" else peer if sec == "peer" else {})[k.strip().lower()] = v.strip()
    v4 = [a2.strip() for a2 in (iface.get("address") or "").split(",") if ":" not in a2 and a2.strip()]
    addr = (v4[0].split("/")[0] if v4 else "")
    _awg = sanitize_awg_params({k: iface.get(k.lower()) for k in AWG_FIELDS}, gen3=True)
    _awg.pop("DisableCookies", None)
    if _awg.get("HeaderProtectionKey"):
        _awg, _e3 = awg3_check(_awg)
        if _e3:
            return None, _e3
    else:
        _awg = {k: v for k, v in _awg.items() if k not in AWG3_FIELDS}
    _ka = re.fullmatch(r"\s*(\d+)\s*(?:-\s*\d+\s*)?", str(peer.get("persistentkeepalive") or ""))
    prof = {"private_key": iface.get("privatekey") or "", "address": addr,
            "mtu": max(576, min(1500, int(iface.get("mtu") or 1280) if str(iface.get("mtu") or "").strip().isdigit() else 1280)),
            "peer_key": peer.get("publickey") or "", "endpoint": peer.get("endpoint") or "",
            "psk": peer.get("presharedkey") or "",
            "keepalive": int(_ka.group(1)) if _ka and int(_ka.group(1)) <= 65535 else 0,
            "awg": _awg}
    if not _WG_KEY_RE.match(prof["private_key"] or ""):
        return None, "the profile has no usable PrivateKey"
    if not _WG_KEY_RE.match(prof["peer_key"] or ""):
        return None, "the profile has no usable peer PublicKey"
    if prof["psk"] and not _WG_KEY_RE.match(prof["psk"]):
        return None, "the profile's PresharedKey is not a usable key"
    if not prof["address"]:
        return None, "the profile has no IPv4 Address (this exit is IPv4-only)"
    try:
        ipaddress.IPv4Address(prof["address"])
    except Exception:
        return None, "the profile's Address is not an IPv4 address"
    _lp = str(iface.get("listenport") or "").strip()
    if not prof["endpoint"] and _lp:
        if npeer != 1:
            return None, "a dial-in exit has exactly one peer — the upstream"
        if not re.fullmatch(r"[0-9]{1,5}", _lp) or not 1 <= int(_lp) <= 65535:
            return None, "the profile's ListenPort is not a usable port"
        prof["listen_port"], prof["keepalive"] = int(_lp), 0
        return prof, ""
    if not prof["endpoint"] or ":" not in prof["endpoint"] or len(prof["endpoint"]) > 200:
        return None, "the profile has no usable Endpoint"
    if any(ch in prof["endpoint"] for ch in " \t\"'\\"):
        return None, "the profile's Endpoint contains characters an endpoint cannot have"
    return prof, ""


