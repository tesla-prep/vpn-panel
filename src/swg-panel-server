_PANEL_SVC = {"at": 0.0, "data": {}}
def panel_service_health(ttl=20):
    if IN_DOCKER:
        return {}                                    # container: host units aren't ours to probe (deferred path)
    if not _PANEL_UNITS:
        return {}                                    # nothing declared to expect — and `systemctl show` with no
                                                     # unit shows the MANAGER, which would parse as junk

    now = time.time()
    if _PANEL_SVC["data"] and now - _PANEL_SVC["at"] < ttl:
        return _PANEL_SVC["data"]                     # fresh enough → skip the re-shell (many tabs poll every 5s)
    try:
        units = [u for _, u in _PANEL_UNITS]
        p = subprocess.run(["systemctl", "show", *units, "-p", "Id,LoadState,ActiveState,UnitFileState"],
                           capture_output=True, text=True, timeout=5)
        blocks, cur = {}, {}                          # systemctl show separates multiple units by a blank line
        for line in (p.stdout or "").splitlines():
            if not line.strip():
                if cur.get("Id"): blocks[cur["Id"]] = cur
                cur = {}; continue
            k, _, v = line.partition("="); cur[k] = v
        if cur.get("Id"): blocks[cur["Id"]] = cur
        out = {}
        for key, unit in _PANEL_UNITS:
            b = blocks.get(unit) or {}
            load = b.get("LoadState", "")
            out[key] = {"unit": unit,
                        "active": b.get("ActiveState", "unknown"),    # active|inactive|failed|activating|…
                        "enabled": b.get("UnitFileState", ""),         # enabled|disabled|masked|static|""
                        "present": bool(load) and load != "not-found"} # LoadState=not-found → unit file gone
    except Exception:
        return _PANEL_SVC["data"]                     # probe failed → keep the last good reading; never break /api/state
    _PANEL_SVC["at"] = now; _PANEL_SVC["data"] = out
    return out


_DATAPATH_SVC = {"at": 0.0, "data": {}}
def _host_awg_record(name):
    """One of the installer's per-kernel AmneziaWG records on THIS host — a dict only when it names the running kernel."""
    try:
        with open(os.path.join(os.environ.get("SWG_NODED_STATE", "/var/lib/swg-noded"), name)) as f:
            d = dict(ln.rstrip("\n").split("=", 1) for ln in f if "=" in ln)
    except (OSError, ValueError):
        return None
    return d if d.get("kernel") == os.uname().release else None


_MOK_PATH_RE = re.compile(r"^/[\w./+-]{1,200}$")   # a key path a node or the installer's record names — a plain path or nothing


def _host_boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id") as f:
            return f.read().strip()
    except OSError:
        return ""


def host_datapath_health(ttl=20):
    """This host's kernel-datapath health for the self-heal check — right now: is the AmneziaWG kernel module
    LOADABLE when a local node actually uses awg? A broken/absent DKMS module (the "Unknown device type" class)
    is exactly what `swg-update`'s ensure_awg_module rebuilds, so the SPA surfaces it as a healable issue with a
    'Fix' action. Unprivileged read-only probe (no modprobe): loaded (/proc/modules) OR the .ko is on disk for
    the running kernel. Only reported when awg is in use ({} otherwise, e.g. a wg-only or host-only box)."""
    if IN_DOCKER:
        return {}                                        # container uses userspace amneziawg-go — no kernel module
    now = time.time()
    if _DATAPATH_SVC["data"] and now - _DATAPATH_SVC["at"] < ttl:
        return _DATAPATH_SVC["data"]
    out = {}
    upd = False
    with contextlib.suppress(Exception):
        with open("/run/swg-update.running") as f:
            _pid = int((f.read() or "0").strip() or 0)
        upd = _pid > 0 and os.path.exists("/proc/%d" % _pid)
    try:
        awg_used = any(os.path.exists(p) for p in ("/usr/bin/awg", "/usr/local/bin/awg", "/sbin/awg", "/usr/sbin/awg"))
        if awg_used:
            loaded = False
            try:
                with open("/proc/modules") as f:
                    loaded = any(ln.startswith("amneziawg ") for ln in f)
            except Exception:
                pass
            built = False
            if not loaded:
                kr = os.uname().release
                for d in ("/lib/modules/%s/updates/dkms" % kr, "/lib/modules/%s/updates" % kr, "/lib/modules/%s/kernel/drivers/net" % kr):
                    try:
                        if any(f.startswith("amneziawg.ko") for f in os.listdir(d)):
                            built = True; break
                    except Exception:
                        continue
            _ref = None if loaded else _host_awg_record("awg-module-refused")
            _key = bool(built and _ref and _ref.get("boot") and _ref.get("boot") == _host_boot_id())
            out["awg"] = {"needed": True, "ok": bool(loaded or (built and not _key)), "updating": upd}
            if not out["awg"]["ok"]:   # D2: degraded (a fallback runs the interfaces) vs down — the SPA words the two apart
                out["awg"]["fallback"] = any(os.access(p, os.X_OK) for p in ("/usr/local/sbin/amneziawg-go", "/usr/local/bin/amneziawg-go", "/usr/sbin/amneziawg-go", "/usr/bin/amneziawg-go"))
            if _key:
                out["awg"]["why"] = "key"
                if _MOK_PATH_RE.match(_ref.get("mok") or ""):
                    out["awg"]["mok"] = _ref["mok"]
            elif not out["awg"]["ok"] and _host_awg_record("awg-module-failed"):
                out["awg"]["why"] = "compile"
    except Exception:
        return _DATAPATH_SVC["data"]                     # probe failed → keep last good; never break /api/state
    _DATAPATH_SVC["at"] = now; _DATAPATH_SVC["data"] = out
    return out


