def _missing_ifaces(c, snap, ivk_pub=None):
    live = snap.get("interfaces") or {}
    backups = snap.get("iface_key_backups") or {}
    out = {}
    for ifn, ov in (c.get("ifaces") or {}).items():
        if ifn in live or ov.get("system"):
            continue
        lc = ov.get("_lastcfg")
        if not lc:
            continue
        blessed = ov.get("public_key") or ""
        key_src = _iface_key_source(ov, backups.get(ifn), ivk_pub)
        _lp = ov.get("listen_port") or lc.get("listen_port")
        _mtu_o = ov.get("mtu") or lc.get("mtu")
        _awg_o = ov.get("awg_params") if isinstance(ov.get("awg_params"), dict) and ov["awg_params"] else lc.get("awg_params")
        out[ifn] = {"subnet": lc.get("subnet"), "listen_port": _lp,
                    "mtu": _mtu_o,
                    "address": lc.get("address"), "awg_params": _awg_o or {},
                    "endpoint_host": ov.get("endpoint_host") or "",
                    "dns": list(ov["dns"]) if isinstance(ov.get("dns"), list) else None,
                    "keepalive": (ov["keepalive"] if isinstance(ov.get("keepalive"), int)
                                  and not isinstance(ov.get("keepalive"), bool) else None),
                    "reach": reach_level(ov.get("reach")),
                    "public_key": blessed, "key_source": key_src,
                    **({"awaiting_key": True} if ifn in set(snap.get("ifaces_awaiting_key") or []) else {})}
        if key_src == "vault":
            out[ifn]["key_blob"] = ov.get("key_blob")
    return out


def _iface_key_source(ov, backup_pub, ivk_pub):
    blessed = ov.get("public_key") or ""
    if backup_pub and backup_pub == blessed:
        return "backup"
    _kb = ov.get("key_blob") or {}
    if blessed and _kb.get("pub") == blessed and ivk_pub and _kb.get("vault") == ivk_pub:
        return "vault"
    return ""


def _unmanaged_ifaces(c, snap):
    ifs, dele = (c.get("ifaces") or {}), (c.get("delete") or {})
    return [ifn for ifn in sorted((snap.get("interfaces") or {})) if ifn not in ifs and ifn not in dele]


def _broken_ifaces(c, snap, ivk_pub=None):
    live = snap.get("interfaces") or {}
    backups = snap.get("iface_key_backups") or {}
    out = {}
    for ifn, ov in (c.get("ifaces") or {}).items():
        ent = live.get(ifn)
        if ent is None or ov.get("system") or not ent.get("down"):
            continue
        lc = ov.get("_lastcfg") or {}
        out[ifn] = {"state": "down", "repair": ("recreate" if lc.get("subnet") else ""),
                    "subnet": lc.get("subnet"), "listen_port": lc.get("listen_port"),
