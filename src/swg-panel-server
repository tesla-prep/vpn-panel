        # and every cut-off peer still on the wire here (cut_off_for_node). Just the retirements when nobody is cut off.
        _remove = {_ifn: list(_pks) for _ifn, _pks in (node.get("retire") or {}).items()}
        for _ifn, _pks in cut_off_for_node(roster, nid, snap).items():
            _rl = _remove.setdefault(_ifn, [])
            _rl.extend(_pk for _pk in _pks if _pk not in _rl)
        return (200, {"desired": desired, "desired_ifaces": desired_ifaces,
                                "owned_ifaces": owned_ifaces,
                                # NETWORKS P2: only when the operator closed this node's LAN — absent means share,
                                # so a node nobody switched gets exactly the reply it got before (D1).
                                **({} if lan_open(node, Handler.deps.get("panel_settings")) else {"lan_share": False}),
                                # NETWORKS P4: a reachability test, only while one is waiting for its answer (D1).
                                **({"net_probe": _nprobe} if _nprobe else {}),
                                # Logs P2: a live log viewer's requests, only while one names this node (D1).
                                **({"logs": _live} if _live else {}),
                                # Logs P3: a range download's request, only while one waits on this node (D1).
                                **({"logrange": _lrange} if _lrange else {}),
