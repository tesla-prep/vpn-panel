def accepts_gzip(hdr):
    for part in (hdr or "").split(","):
        bits = part.strip().split(";")
        if bits[0].strip().lower() != "gzip":
            continue
        for pair in bits[1:]:
            k, _, v = pair.partition("=")
            if k.strip().lower() == "q":
                try:
                    return float(v) > 0
                except ValueError:
                    return False
        return True
    return False


