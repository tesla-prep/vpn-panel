def normalize_stats_files(nodes_path, stats_dir):
    """Make every node's snapshot mirror id-keyed: `stats_file` -> `stats-<id>.json`, renaming the file
    on disk if it's still under a legacy name (auto-enrolled nodes were written `stats-<hostname>.json`).
    The health RRD is already `health-<id>.rrd`, so after this BOTH health files share the stable id —
    they always travel together (e.g. through a convert) and the warm-start can't be orphaned by a
    hostname change. Idempotent."""
    nodes = load_json(nodes_path, {})
    if not isinstance(nodes, dict) or not nodes:
        return
    changed = False
    for nid, c in nodes.items():
        if not isinstance(c, dict):
            continue
        canon = f"stats-{nid}.json"
        old = c.get("stats_file")
        if old == canon:
            continue
        if old and stats_dir:                       # carry the existing mirror over to the canonical name
            with contextlib.suppress(OSError):
                src = os.path.join(stats_dir, old)
                if os.path.exists(src) and not os.path.exists(os.path.join(stats_dir, canon)):
                    os.replace(src, os.path.join(stats_dir, canon))
        c["stats_file"] = canon
        changed = True
    if changed:
        nodes_save(nodes_path, nodes)
        log(LOG_INFO, "normalized node stats_file -> stats-<id>.json")


NODE_SIG_WINDOW = max(30, int(os.environ.get("SWG_PANEL_SIG_WINDOW", "300") or 300))   # ± seconds a timestamp may be off
REQUIRE_NODE_SIG = os.environ.get("SWG_PANEL_REQUIRE_SIG", "").strip().lower() in ("1", "true", "yes", "on")
_NODE_SIG_SEEN = {}                    # mac -> expiry epoch; a mac seen twice inside the window is a replay
_NODE_SIG_LOCK = threading.Lock()



# brute-force back-pressure
AUTH_FAIL_FREE   = 5      # failures on a bucket before back-pressure starts at all
AUTH_FAIL_DELAY  = 0.4    # seconds added to the first throttled attempt; doubles per failure after it
AUTH_FAIL_MAX    = 4.0    # ...capped here. A cap is the point: the real operator who mistyped waits, never locks out
AUTH_FAIL_WINDOW = 900    # a bucket idle this long is forgotten, so yesterday's typo costs nothing today
_AUTH_FAILS = {}                      # bucket -> [count, last_failure_ts]
_AUTH_FAILS_LOCK = threading.Lock()


def _authfail_state(bucket):
    """(count, seconds_since_last) for `bucket`, forgetting anything older than the window."""
    with _AUTH_FAILS_LOCK:
        n, at = _AUTH_FAILS.get(bucket, (0, 0.0))
        if n and (time.time() - at) > AUTH_FAIL_WINDOW:
            _AUTH_FAILS.pop(bucket, None)
            return 0, 0.0
        return n, (time.time() - at if at else 0.0)


def _authfail_note(bucket):
    """Record one failed attempt. Returns the new count."""
    with _AUTH_FAILS_LOCK:
        n, at = _AUTH_FAILS.get(bucket, (0, 0.0))
        if n and (time.time() - at) > AUTH_FAIL_WINDOW:
            n = 0
        n += 1
        _AUTH_FAILS[bucket] = (n, time.time())
        return n


def _authfail_clear(bucket):
    """A success wipes the bucket — the operator who mistyped once then got it right pays nothing."""
    with _AUTH_FAILS_LOCK:
        _AUTH_FAILS.pop(bucket, None)


def _authfail_delay(bucket):
    """Seconds to hold an attempt on `bucket` before answering. 0 until AUTH_FAIL_FREE failures, then
    exponential to AUTH_FAIL_MAX. A DELAY, never a refusal: at the cap a brute-forcer gets a quarter of
    an attempt per second and the operator who fat-fingered their password waits four seconds."""
    n, _ = _authfail_state(bucket)
    if n < AUTH_FAIL_FREE:
        return 0.0
    return min(AUTH_FAIL_MAX, AUTH_FAIL_DELAY * (2 ** (n - AUTH_FAIL_FREE)))




def _verify_node_sig(token_sha, ts, mac, body):
    """Return (ok, reason). Verifies the timestamp is fresh, the HMAC matches, and the mac hasn't been replayed."""
    if not token_sha:
        return False, "unverifiable"                 # legacy node without a token_sha index — can't key the HMAC
    try:
        t = int(ts)
    except (TypeError, ValueError):
        return False, "bad-timestamp"
    now = int(time.time())
    if abs(now - t) > NODE_SIG_WINDOW:
        return False, "stale"
    bsha = hashlib.sha256(body or b"").hexdigest()
    expect = hmac.new(token_sha.encode(), (str(ts) + "." + bsha).encode(), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expect, (mac or "").strip().lower()):
        return False, "mismatch"
    with _NODE_SIG_LOCK:                              # replay: a mac is unique per (node, ts, body); reject a repeat
        if _NODE_SIG_SEEN.get(mac, 0) > now:
            return False, "replay"
        if len(_NODE_SIG_SEEN) > 20000:              # bound the cache; drop everything already expired
            for k in [k for k, e in _NODE_SIG_SEEN.items() if e <= now]:
                _NODE_SIG_SEEN.pop(k, None)
        _NODE_SIG_SEEN[mac] = now + NODE_SIG_WINDOW + 5
    return True, ""


def _node_cred_same(before, now):
    """Does the node record `now` still carry the credential `before` was authenticated against? O(1) and pbkdf2-free
    (a sync re-checks this under _api_lock): a rotation replaces token_sha, a legacy node's token_hash, or both."""
    if now.get("token_sha") and before.get("token_sha"):
        return hmac.compare_digest(now["token_sha"], before["token_sha"])
    return bool(now.get("token_hash")) and now.get("token_hash") == before.get("token_hash")


def find_node_by_token(nodes, token):
    if not token:
        return None, None
    tsha = hashlib.sha256(token.encode()).hexdigest()
    for nid, n in nodes.items():
        ts = n.get("token_sha")
        if ts and hmac.compare_digest(ts, tsha):
            return nid, n
    for nid, n in nodes.items():
        if n.get("token_sha"):
            continue                                  # already indexed → not a legacy candidate
        if verify_password(n.get("token_hash", ""), token):
            return nid, n
    return None, None


def _archive_node(deps, nid, nm, node_entry, peers, sf):
    """Back a node up before it's purged → <state_dir>/archive/<name>-<nid>-<ts>/ with node.json,
    peers.json (the peer entries that referenced it), and its MOVED stats + health files. Best-effort:
    a backup must never block the delete."""
    try:
        state_dir = os.path.dirname(deps["nodes_path"]) or "."
        safe = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in str(nm))[:40] or nid
        dest = os.path.join(state_dir, "archive", f"{safe}-{nid}-{int(time.time())}")
        os.makedirs(dest, exist_ok=True)
        atomic_write(os.path.join(dest, "node.json"), json.dumps(node_entry, indent=2) + "\n", mode=0o600)
        atomic_write(os.path.join(dest, "peers.json"), json.dumps(peers, indent=2) + "\n", mode=0o600)
        sd = deps.get("stats_dir")
        if sd:
            for fn in (sf, f"health-{nid}.rrd"):
                src = os.path.join(sd, fn)
                if os.path.exists(src):
                    with contextlib.suppress(Exception):
                        shutil.move(src, os.path.join(dest, fn))   # cross-fs safe (state vs stats may differ)
        return dest
    except Exception:
        return None

def node_remove(deps, nid):
    """Drop a node from the store and cascade: ARCHIVE its data (node + peer targets + stats/health) as a
    recoverable backup, then purge its peer targets (deleting peers whose only deployment was here), forget
    its live snapshot, and remove its stats + health files. Returns the removed node's display name, or None
    if it wasn't there. Shared by force-remove + goodbye."""
    nodes = nodes_load(deps["nodes_path"])
    if nid not in nodes:
        return None
    nm = nodes[nid].get("name", nid)
    sf = nodes[nid].get("stats_file", f"stats-{nid}.json")
    node_entry = dict(nodes[nid])
    roster = roster_load(deps["roster_path"])
    affected = {pid: p for pid, p in roster["peers"].items()
                if any(t.get("node") == nid for t in p.get("targets", []))}
    _archive_node(deps, nid, nm, node_entry, affected, sf)   # back up BEFORE purging (moves stats/health out)
    mesh_unlink_node(nodes, nid)                              # tear down this node's mesh links on every survivor
    del nodes[nid]
    _orphans = prune_node_refs(nodes)
    _p2p_pruned = prune_p2p_refs(nodes)                       # …and a torrent route to it becomes Block
    nodes_save(deps["nodes_path"], nodes)
    changed = False
    for pid in list(roster["peers"].keys()):
        p = roster["peers"][pid]
        kept = [t for t in p.get("targets", []) if t.get("node") != nid]
        if len(kept) != len(p.get("targets", [])):
            changed = True
            if kept:
                p["targets"] = kept; p["modified_at"] = int(time.time())
            else:
                del roster["peers"][pid]
    if changed:
        roster_save(deps["roster_path"], roster)
    (deps.get("node_snaps") or {}).pop(nid, None)
    (deps.get("node_seen") or {}).pop(nid, None)
    with contextlib.suppress(Exception):  # its dial-in exits' router keys go with it, and the key they were sealed under
        drop_sub_blobs(deps, sub_exit_bucket(nid))
        _esc = load_sub_escrow(deps)
        if _esc.pop(sub_exit_bucket(nid), None) is not None:
            save_sub_escrow(deps, _esc)
    sd = deps.get("stats_dir")            # _archive_node moved these out; unlink any leftover
    if sd:
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(sd, sf))
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(sd, f"health-{nid}.rrd"))
    ev_append(deps["roster_path"], "node", nid, "Removed node", nm)
    _report_orphan_egress(deps, nodes, _orphans)
    _report_p2p_pruned(deps, _p2p_pruned)
    return nm


def _report_orphan_egress(deps, nodes, orphans):
    """Write one event per node whose interfaces were repointed, with the right reason for each.

    ⚠️ SAY WHOSE ROUTING THIS CHANGED. Rewriting an interface's egress is a traffic change on a node the
    operator did not touch, so it is reported per node rather than folded into whatever triggered it — the
    one thing worse than an interface silently forwarding to a ghost is one silently repointed.

    ⚠️ AND EVERY CALLER MUST REPORT. `prune_node_refs` is fleet-wide and unconditional, so it heals on any
    node save — which means an interface on a node nobody touched can be rewritten by a save somewhere
    else. The `/api/node/update` path discarded the return value and said nothing at all."""
    for _onid in sorted({h[0] for h in orphans}):
        mine = [h for h in orphans if h[0] == _onid]
        nm = (nodes.get(_onid) or {}).get("name") or _onid
        _gone_n = ", ".join(sorted(h[2] for h in mine if h[3]))
        _blank_n = ", ".join(sorted(h[2] for h in mine if not h[3]))
        if _gone_n:
            ev_append(deps["roster_path"], "node", _onid,
                      "Egress reset to direct — its target node was removed", nm, _gone_n)
        if _blank_n:
            ev_append(deps["roster_path"], "node", _onid,
                      "Egress reset to direct — it forwarded to no node at all", nm, _blank_n)


NETWORK_CAP = 8
_NET_RESERVED = ("0.0.0.0/8", "127.0.0.0/8", "169.254.0.0/16", "224.0.0.0/4", "240.0.0.0/4")
_NETWORK_REFUSALS = ("invalid", "not_v4", "default_route", "reserved", "self_contained", "no_snapshot", "node_lan",
                     "iface_subnet", "mesh", "node_gateway", "node_too_old", "node_panel", "node_resolver",
                     "resolver_unknown", "overlap", "taken", "cap", "blocked")
_NETWORK_NOT_A_VERDICT = ("no_snapshot", "node_too_old", "resolver_unknown")


def network_prefix(s):
    """A v4 CIDR normalised (`192.168.1.7/24` → `192.168.1.0/24`, a bare address → /32), or ""."""
    try:
        n = ipaddress.ip_network(str(s or "").strip(), strict=False)
    except ValueError:
        return ""
    return str(n) if n.version == 4 else ""


def network_subnet_refusal(prefix, snap, target=None):
    """(reason, address) for a network this panel must not lower onto the node `snap` describes, or (None, "").

    Mirrors `swg-noded` `network_route_refusal()`. Where they differ it is because the panel knows less: it has the
    node's ADDRESSES (`node_ips`) but not their prefixes, so "the node's own LAN" is containment here and overlap
    there. That asymmetry fails closed — the node refuses what this passes — and it is why D7 makes the node
    authoritative."""
    try:
        net = ipaddress.ip_network(str(prefix or "").strip(), strict=False)
    except ValueError:
        return "invalid", ""
    if net.version != 4:
        return "not_v4", ""
    if net.prefixlen == 0:
        return "default_route", ""
    if any(net.overlaps(ipaddress.ip_network(r)) for r in _NET_RESERVED):
        return "reserved", ""
    if target is not None and _is_self_contained_target(target):
        return "self_contained", ""          # keyless: no peer entry, no AllowedIPs to attach to (§4.8)
    snap = snap if isinstance(snap, dict) else {}
    if not snap:
        return "no_snapshot", ""
    def _in(a):
        with contextlib.suppress(ValueError, TypeError):
            return ipaddress.ip_address(str(a)) in net
        return False
    for ifn, blk in sorted((snap.get("interfaces") or {}).items()):
        meta = (blk or {}).get("meta") or {}
        with contextlib.suppress(ValueError, TypeError):
            if meta.get("subnet") and net.overlaps(ipaddress.ip_network(meta["subnet"], strict=False)):
                return ("mesh" if str(ifn).startswith("swg_") else "iface_subnet"), \
                       str(meta.get("address") or meta["subnet"]).split("/")[0]
    for kind, keys in (("wdtt", ("wg_addr", "raw_addr")), ("csqtt", ("tun_addr",))):
        for inst in (snap.get(kind) or []):
            for k in keys:
                with contextlib.suppress(ValueError, TypeError, AttributeError):
                    if inst.get(k) and net.overlaps(ipaddress.ip_network(str(inst[k]), strict=False)):
                        return "iface_subnet", str(inst[k]).split("/")[0]
    for a in snap.get("node_ips") or []:
        if _in(a):
            return "node_lan", str(a)        # ⚠️ a REDIRECT, not a no: the node is already a provider for it (§4.1)
    gws = snap.get("ether_gws")
    for g in (gws.values() if isinstance(gws, dict) else ()):
        if g and _in(g):
            return "node_gateway", str(g)
    nd = snap.get("net_deps")
    if not isinstance(nd, dict):
        return "node_too_old", ""            # D7: a node that cannot say what it depends on cannot guard itself
    if nd.get("panel") and _in(nd["panel"]):
        return "node_panel", str(nd["panel"])
    for r in nd.get("resolvers") or []:
        if _in(r):
            return "node_resolver", str(r)
    if not nd.get("resolvers_known"):
        return "resolver_unknown", ""
    return None, ""


def node_networks(roster, nid, snap):
    """The networks one node carries, and every one it does not with its reason:
        {"carry": {pid: {"iface": <iface>, "nets": [prefix, …]}}, "inert": {pid: {prefix: {why, addr, by?}}}}

    A network attaches to its provider's FIRST deployment on this node — a kernel route has one device. Two
    providers cannot hold one prefix (§4.3: wg's trie has one owner per prefix, and `192.168.1.0/24` is the normal
    case, not the rare one), so an overlap is resolved DETERMINISTICALLY — earliest `created_at`, then id — and the
    loser is inert with `taken` + who took it. Deterministic so it cannot flap; resolved here rather than refused
    at save because a transfer can put two stored records side by side, and refusing the save then is how a record
    becomes unsavable, including the save that would fix it. A blocked or expired provider carries nothing.

    P5 (§15.2 S8): a RESTRICTED provider is carried only by a node that says it can enforce the restriction
    (`net_deps.share`). Anywhere else it is inert, `share_unsupported` — its owner included — because carrying it open
    is the operator believing a network is restricted while it is not."""
    users = roster.get("users") or {}
    nowv = int(time.time())
    provs = []
    for key, p in (roster.get("peers") or {}).items():
        if not isinstance(p, dict) or not p.get("routes"):
            continue
        u = users.get(p.get("user_id")) or {}
        if p.get("disabled") or u.get("disabled") or is_expired(p, nowv) or is_expired(u, nowv):
            continue
        _ts = [t for t in (p.get("targets") or []) if t.get("node") == nid and t.get("iface")]
        tg = next((t for t in _ts if not _is_self_contained_target(t)), None) or (_ts[0] if _ts else None)
        if tg is not None:
            provs.append((int(p.get("created_at") or 0), str(p.get("id") or key), p, tg))
    carry, inert, held = {}, {}, []
    _enforces = isinstance((snap or {}).get("net_deps"), dict) and bool(snap["net_deps"].get("share"))
    for _c, pid, p, tg in sorted(provs, key=lambda x: (x[0], x[1])):
        # A node too old to enforce sharing must HOLD BACK a restricted network, not carry it open — and "restricted"
        # includes private, which used to be carried openly here while a shared one was held. Backwards, and silently.
        _unenforced = net_restricted(p) and not _enforces
        for i, raw in enumerate(p.get("routes") or []):
            pre = network_prefix(raw) or str(raw)
            by = ""
            why, addr = ("cap", "") if i >= NETWORK_CAP else network_subnet_refusal(pre, snap, tg)
            if not why and _unenforced:
                why, addr = "share_unsupported", ""
            if not why:
                n = ipaddress.ip_network(pre)
                hit = next((h for h in held if n.overlaps(h[0])), None)
                if hit:
                    why, addr, by = ("overlap" if hit[1] == pid else "taken"), str(hit[0]), hit[1]
            if why:
                inert.setdefault(pid, {})[pre] = dict({"why": why, "addr": addr}, **({"by": by} if by else {}))
            else:
                held.append((ipaddress.ip_network(pre), pid))
                carry.setdefault(pid, {"iface": tg.get("iface"), "nets": []})["nets"].append(pre)
    for ent in carry.values():
        ent["nets"].sort(key=ipaddress.ip_network)
    return {"carry": carry, "inert": inert}


