                return None, "A node's default rules can't name ports — set them on an interface's rule", _dropped_report(dropped)
            if cat == "all":
                return None, "“Everything else” applies to every port — use a rule to 0.0.0.0/0 with ports", _dropped_report(dropped)
            pp, pl = ports_clean(p.get("proto"), p.get("list")) if isinstance(p, dict) else (None, "proto")
            if pp is None:                                 # `pl` is the reason then
                return None, ("Ports: “Any” protocol needs at least one port" if pl == "empty"
                              else "Ports: at most 32 ports or ranges" if pl == "too_many"
                              else "Ports: write ports and ranges from 1 to 65535, like 443, 8000-8100"), _dropped_report(dropped)
            _on = (p.get("on") is True) if "on" in p else rule_on(out)
            out["enabled"] = False
            if "who" in out:
                out["who"]["on"] = False
            out["ports"] = {"on": _on, "proto": pp, "list": pl}
        clean.append(out)
    return clean, None, _dropped_report(dropped)


EXIT_ID_RE = re.compile(r"^[a-f0-9]{8}$")

EXIT_KEY_KEEP = "(unchanged — the panel never shows a stored private key)"
# The peer PSK is the second secret in a profile and gets the same treatment: shown as a sentinel, kept on
# save unless the operator replaces it. Its own string, so a profile carrying both round-trips unambiguously.
EXIT_PSK_KEEP = "(unchanged — the panel never shows a stored preshared key)"


# A base64 X25519 key as WireGuard writes it — the same shape swg-agent's PUBKEY_RE enforces on the
# other side of the wire, so a profile the panel accepts cannot be one the agent would refuse.
_WG_KEY_RE = re.compile(r"^[A-Za-z0-9+/]{43}=$")


def parse_wg_profile(text):
    """A pasted WireGuard profile → the fields the node needs, or (None, why).

    §6's second producer: the operator brings a profile from anywhere — another VPS, a commercial provider,
    a WARP config they already had. We read it rather than trust it: a profile is a file from outside this
    system, and the only thing standing between it and `wg-quick up` is this function.

    IPv4 ONLY (decision 6). A profile written for a laptop carries an `Address` and `AllowedIPs` for both
    families; the v6 halves are dropped here, at the door, so nothing downstream has to remember to.
    `Table`, `DNS`, `PostUp` and friends are IGNORED rather than copied — this node decides its own routing
    (§5.1 is exactly what happens when a pasted file gets to decide it), and a `PostUp` from a stranger's
    file is arbitrary root command execution."""
    if not isinstance(text, str) or len(text) > 8000:
        return None, "that doesn't look like a WireGuard profile"
    sec, iface, peer, npeer = "", {}, {}, 0
    for ln in text.splitlines():
        ln = ln.split("#", 1)[0].strip()
        if not ln:
            continue
        if ln.startswith("["):
            sec = ln.strip("[]").strip().lower()
            npeer += sec == "peer"
            continue
        if "=" not in ln:
            continue
        k, v = ln.split("=", 1)
        (iface if sec == "interface" else peer if sec == "peer" else {})[k.strip().lower()] = v.strip()
    v4 = [a2.strip() for a2 in (iface.get("address") or "").split(",") if ":" not in a2 and a2.strip()]
    addr = (v4[0].split("/")[0] if v4 else "")
    _awg = sanitize_awg_params({k: iface.get(k.lower()) for k in AWG_FIELDS}, gen3=True)
    _awg.pop("DisableCookies", None)
    if _awg.get("HeaderProtectionKey"):
        _awg, _e3 = awg3_check(_awg)
        if _e3:
            return None, _e3
    else:
        _awg = {k: v for k, v in _awg.items() if k not in AWG3_FIELDS}
    # PersistentKeepalive: a 3.1 client config writes it as a range (clientKeepalive, 25 → `25-35`); the node's conf takes
    # one number, so a range keeps its lower end rather than turning the keepalive off.
    _ka = re.fullmatch(r"\s*(\d+)\s*(?:-\s*\d+\s*)?", str(peer.get("persistentkeepalive") or ""))
    prof = {"private_key": iface.get("privatekey") or "", "address": addr,
            "mtu": max(576, min(1500, int(iface.get("mtu") or 1280) if str(iface.get("mtu") or "").strip().isdigit() else 1280)),
            "peer_key": peer.get("publickey") or "", "endpoint": peer.get("endpoint") or "",
            "psk": peer.get("presharedkey") or "",
            "keepalive": int(_ka.group(1)) if _ka and int(_ka.group(1)) <= 65535 else 0,
            "awg": _awg}
    if not _WG_KEY_RE.match(prof["private_key"] or ""):
        return None, "the profile has no usable PrivateKey"
    if not _WG_KEY_RE.match(prof["peer_key"] or ""):
        return None, "the profile has no usable peer PublicKey"
    if prof["psk"] and not _WG_KEY_RE.match(prof["psk"]):
        return None, "the profile's PresharedKey is not a usable key"
    if not prof["address"]:
        return None, "the profile has no IPv4 Address (this exit is IPv4-only)"
    try:
        ipaddress.IPv4Address(prof["address"])
    except Exception:
        return None, "the profile's Address is not an IPv4 address"
    _lp = str(iface.get("listenport") or "").strip()
    if not prof["endpoint"] and _lp:
        if npeer != 1:
            return None, "a dial-in exit has exactly one peer — the upstream"
        if not re.fullmatch(r"[0-9]{1,5}", _lp) or not 1 <= int(_lp) <= 65535:   # ASCII only: '²'.isdigit()
            return None, "the profile's ListenPort is not a usable port"
        prof["listen_port"], prof["keepalive"] = int(_lp), 0
        return prof, ""
    if not prof["endpoint"] or ":" not in prof["endpoint"] or len(prof["endpoint"]) > 200:
        return None, "the profile has no usable Endpoint"
    if any(ch in prof["endpoint"] for ch in " \t\"'\\"):
        return None, "the profile's Endpoint contains characters an endpoint cannot have"
    return prof, ""


def devexit_live(snap):
    """{device: {state[, no_traffic]}} — what the node says about each exit DEVICE its routing names (`snap.devexit`), for an
    ADOPTED exit's `live` on /api/state: an adopted device has no row in `snap.exits` (the node did not create it), and its
    dead-tunnel verdict (SOCKS5-EXIT-PLAN §5.4) is carried per devexit entry. State and verdict are the device's, so the
    first entry stands for all of a device's subnets. A device the routing does not name is absent: nothing is judged."""
    out = {}
    for e in (snap or {}).get("devexit") or []:
        d = str((e or {}).get("dev") or "") if isinstance(e, dict) else ""
        if d and d not in out:
            out[d] = dict({"state": str(e.get("state") or "")},
                          **({"no_traffic": e["no_traffic"]} if isinstance(e.get("no_traffic"), dict) else {}))
    return out


def exit_cfg_sig(rec):
    """A digest of ONLY what an imported exit hands the node — the answer to "has the node applied what I
    just saved?", which nothing else on the wire could give.

    Signed over the payload the node is actually sent (see the `exits` block in the sync response), not over
    the whole record, because the two are not the same question. Renaming an exit gives the node no work to
    do, and a spinner that claims otherwise is one more state that does not mean what it says — which is the
    complaint this whole change came from. Change the endpoint, the profile, the licence, the dial source or
    the enabled flag and the node HAS work; change the label and it does not.

    ⚠️ DERIVED, NOT COUNTED. A stored revision number would be state, and state has to survive a restore from
    backup, a hand-edited store and a panel that lost a write — all of which leave a counter claiming the
    node is up to date with a config it has never seen. A digest moves with the content instead: restore an
    older `nodes.json` and the record and its digest revert together, still describing each other, where a
    counter would revert to 5 while the node echoes 9 and the row spins for ever.

    ⚠️ BUT IT IS COMPUTED ON SAVE AND STORED, NOT RECOMPUTED ON READ — `_validate_exits` is the only caller,
    and both of ITS callers are write paths. So "it cannot drift" is a property of the SIGNED SET, not of the
    mechanism: it holds exactly while every field the node is handed is either in `mat` below or knowingly
    left out. Today the one omission is `key_restore`, a one-shot escrow relay the panel clears as soon as
    the node reports a public key for it — a request, not a config, and signing it would make every restore
    rewrite the digest of a configuration that did not change. That boundary is not left to this docstring:
    tests/exit_cfg_rev_selftest.py derives both sets from the source and fails if either grows without the
    other. Recomputing at SEND time would make the property unconditional, at the cost of re-stamping every
    exit on the fleet the day this formula changes — a worse trade while the omission is one dead field.

    (It covers the private key, whose 256 bits are the entropy here: this is a fingerprint of a secret, not
    an oracle for one. It reaches only the node, which already holds that key, and `/api/state`, which is
    session-authed; `/api/v1` is GET-only and exposes no exits at all.)"""
    mat = {"device": str(rec.get("device") or ""), "provider": str(rec.get("provider") or ""),
           "licence": str(rec.get("licence") or ""), "dial_src": str(rec.get("dial_src") or ""),
           "down": rec.get("enabled", True) is False, "profile": rec.get("profile") or {}}
    if isinstance(rec.get("socks"), dict):              # only when there is one: every other exit keeps its signature
        mat["socks"] = _socks_sig_part(rec["socks"])
    return hashlib.sha256(json.dumps(mat, sort_keys=True, separators=(",", ":")).encode()).hexdigest()[:12]


