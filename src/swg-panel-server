SESSION_TTL = 7 * 24 * 3600
_B64PAD = lambda s: s + "=" * (-len(s) % 4)


SESSION_KEY_EPHEMERAL = ""


def load_session_secret(roster_path):
    global SESSION_KEY_EPHEMERAL
    p = os.path.join(os.path.dirname(roster_path) or ".", "session.key")
    try:
        with open(p, "rb") as f:
            s = f.read().strip()
        if len(s) >= 32:
            SESSION_KEY_EPHEMERAL = ""
            return s
        why = "it is too short to be a signing secret"
    except FileNotFoundError:
        why = ""
    except OSError as e:
        why = e.strerror or str(e)
    s = base64.b64encode(os.urandom(48))
    try:
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(s)
        SESSION_KEY_EPHEMERAL = ""
        if why:
            log(LOG_INFO, "session.key: replaced (%s)" % why)
    except OSError as e:
        SESSION_KEY_EPHEMERAL = why or e.strerror or str(e)
        log(LOG_ERR, "session.key: cannot persist the session-signing secret (%s: %s). Sessions are being signed "
              "with a throwaway secret, so EVERY signed-in operator is signed out each time the panel "
              "restarts. It is almost always ownership: run  chown -R %s %s", p, SESSION_KEY_EPHEMERAL, _proc_user_name(), os.path.dirname(p) or ".")
    return s


def _proc_user_name():
    try:
        import pwd
        return pwd.getpwuid(os.geteuid()).pw_name
    except Exception:
        return str(os.geteuid())


def rotate_session_secret(roster_path):
    global SESSION_KEY_EPHEMERAL
    p = os.path.join(os.path.dirname(roster_path) or ".", "session.key")
    s = base64.b64encode(os.urandom(48))
    try:
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(s)
        SESSION_KEY_EPHEMERAL = ""
    except OSError as e:
        SESSION_KEY_EPHEMERAL = e.strerror or str(e)
        log(LOG_ERR, "session.key: could not write the rotated secret (%s: %s). The old one is still on disk and "
              "would come back on the next restart. Run  chown -R %s %s", p, SESSION_KEY_EPHEMERAL, _proc_user_name(), os.path.dirname(p) or ".")
    return s


def make_session(user, secret, ttl=SESSION_TTL):
    payload = (user + "|" + str(int(time.time()) + ttl)).encode()
    sig = hmac.new(secret, payload, hashlib.sha256).digest()
    return (base64.urlsafe_b64encode(payload).rstrip(b"=").decode() + "."
            + base64.urlsafe_b64encode(sig).rstrip(b"=").decode())


def verify_session(token, secret):
    try:
        p_s, sig_s = token.split(".", 1)
        payload = base64.urlsafe_b64decode(_B64PAD(p_s))
        sig = base64.urlsafe_b64decode(_B64PAD(sig_s))
        if not hmac.compare_digest(sig, hmac.new(secret, payload, hashlib.sha256).digest()):
            return None
        user, exp = payload.decode().rsplit("|", 1)
        return user if int(exp) >= int(time.time()) else None
    except Exception:
        return None


def cfg_hash(pubkey, node, iface=""):
