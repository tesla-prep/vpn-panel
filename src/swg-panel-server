    _lp = os.path.join(_statedir, ".panel.lock")
    def _grab_lock():
        try:
            _fd = os.open(_lp, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC, 0o600)
        except OSError as _e:
            raise SystemExit(f"refusing to start: can't open {_lp} ({_e.strerror}) — the state dir {_statedir} "
                             f"is not writable by this process (uid {os.getuid()}, gid {os.getgid()}). If you moved "
                             f"this panel's state onto this machine, its files still carry the old machine's owner: "
                             f"chown -R <panel user>:swg {_statedir}")
        try:
            fcntl.flock(_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(_fd); raise
        return _fd
    try:
        _lockfd = _grab_lock()
    except OSError:
        _pid, _state = _flock_holder(_lp)
        if _state == "free":
            try:
                _lockfd = _grab_lock()
            except OSError:
                raise SystemExit(f"refusing to start: {_lp} (state dir {_statedir}) cannot be locked, yet the kernel "
                                 f"reports no holder. Retry; if it persists, something is taking the lock repeatedly.")
            log(LOG_WARNING, "access: the state-dir lock was released while starting — took it on the retry")
        elif _state == "unknown":
            raise SystemExit(f"refusing to start: {_lp} (state dir {_statedir}) is locked and /proc/locks could not be "
                             f"read, so the holder cannot be identified. Refusing rather than taking it: two panels on "
                             f"one state dir clobber nodes.json (desyncs node tokens → sync 401). Check for another "
                             f"swg-panel-server on this state dir; remove the lock file only if you are sure none runs.")
        else:
            _argv = _proc_cmdline(_pid) if _pid else []
            _args = _argv[1:] if _argv and os.path.basename(_argv[0]).startswith("python") else _argv[:1]
            if _SWG_LOADER in _args:
                _args = _args[_args.index(_SWG_LOADER) + 3:]
            _base = os.path.basename(_args[0]) if _args else ""
            if _base == "swg-panel-server":
                _who = f"another swg-panel-server (pid {_pid})"
            elif _argv:
                _who = f"pid {_pid} (`{' '.join(_argv)[:80]}`)"
            elif _pid:
                _who = f"pid {_pid} (gone from /proc — another namespace, or it just exited)"
            else:
                _who = "another process the kernel does not name (an OFD lock)"
            raise SystemExit(f"refusing to start: {_who} already holds {_lp} (state dir {_statedir}). Two panels on one "
                             f"state dir clobber nodes.json (desyncs node tokens → sync 401). Stop that process first, "
                             f"or point this one at a separate state dir.")
    os.ftruncate(_lockfd, 0); os.write(_lockfd, (str(os.getpid()) + "\n").encode())
    globals()["_STATE_LOCK_FD"] = _lockfd
    with contextlib.suppress(Exception):
        hrrd_repair_all(fleet.get("stats_dir"))
    _rp = fleet.get("roster_path", "/var/lib/swg-panel/users.json")
