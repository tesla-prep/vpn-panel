        return 200, {"ok": True, "data": {"range": rng, "cats": out, **({"axis": axis} if axis else {})}}

    if method == "GET" and path == "/api/block-stats":
        rng = (qs.get("range") or ["day"])[0]
        rr, bad = range_or_400(qs)
        if bad:
            return bad
        ring, want, since, until, axis = rr
        step = HRRD_RINGS[ring][0]
        torrents = scan = reach = blocked = mechd = 0
        tser = {}; bser = {}; mser = {}                               # bucket epoch → Σ torrents/hr, Σ blocked/hr, Σ mech/hr across nodes (sparklines)
        try:
            files = os.listdir(stats_dir) if stats_dir else []
        except OSError:
            files = []
        for fn in files:
            if not (fn.startswith("block-") and fn.endswith(".rrd")):
                continue
            nid = fn[6:-4]
            if nid not in nodes:
                continue
            d = hrrd_read(os.path.join(stats_dir, fn), ring=ring, want=want, since=since, until=until)
            if not d:
                continue
            torrents += int(sum(d.get("rx") or []) * step / 3600)     # torrents/hr rate → total connections over the window
            blocked += int(sum(d.get("tx") or []) * step / 3600)      # blocked/hr rate → total packets dropped to block sets over the window
            mechd += int(sum(d.get("arx") or []) * step / 3600)       # mech/hr rate → packets the free port rules dropped over the window
            scan += int(max((d.get("pon") or [0])))                   # gauges → PEAK per node (max over in-window buckets), summed
            reach += int(max((d.get("ptot") or [0])))
            for t, r in zip(d.get("t") or [], d.get("rx") or []):     # buckets align across nodes (shared ring step) → sum by epoch
                tser[t] = tser.get(t, 0) + (r or 0)
            for t, b in zip(d.get("t") or [], d.get("tx") or []):
                bser[t] = bser.get(t, 0) + (b or 0)
            for t, m in zip(d.get("t") or [], d.get("arx") or []):
                mser[t] = mser.get(t, 0) + (m or 0)
        series = [tser[t] for t in sorted(tser)]                      # torrents/hr per bucket, oldest→newest; sparkline shape only
        bseries = [bser[t] for t in sorted(bser)]                     # blocked/hr per bucket — the "blocked" tile's sparkline
        mseries = [mser[t] for t in sorted(mser)]                     # mech/hr per bucket — the port-rule tile's sparkline
        _ps = Handler.deps.get("panel_settings")
        cat = block_catalog(_ps); _bpe = block_providers_enabled(_ps)
        enforced = {}; n_ifaces = 0; mech = {}          # enforced: category → {(blk sid, tier)} across the fleet
        waiting = {}                                    # category → node names whose caps the panel withheld (_CAPS_WITHHELD)
        for _nid, n in (nodes or {}).items():
            if not isinstance(n, dict):
                continue
            for b in _node_block_lists(n):
                feeds, mids = _block_feeds(cat, _bpe, _nid, n.get("routing_mode") or "kernel", _validate_block(b, _ps))
                if not feeds and not mids:
                    continue
                for mid in mids:
                    mech[mid] = mech.get(mid, 0) + 1
                if _CAPS_WITHHELD.get(_nid):            # its sync carried no caps: these lists filter nothing there yet
                    for cid in feeds:
                        waiting.setdefault(cid, set()).add(n.get("name") or _nid)
                    if mids:
                        n_ifaces += 1
                    continue
                n_ifaces += 1
                for cid, pairs in feeds.items():
                    enforced.setdefault(cid, set()).update(pairs)
        dom = ips = 0; seen = set(); catcov = {}
        for cid, pairs in enforced.items():
            c = cat.get(cid) or {}; cd = ci = 0
            for sid, tier in sorted(pairs):
                m = list_meta(sid, tier)
                n = int(m["n"]) if (m and m.get("n")) else 0
                if tier == "ip": ci += n
                else: cd += n
                if sid not in seen:                      # fleet TOTAL de-dups a list shared by two categories; per-category size doesn't
                    seen.add(sid); ips += n if tier == "ip" else 0; dom += n if tier != "ip" else 0
            if cd or ci:
                catcov[cid] = {"label": c.get("label") or c.get("name") or cid, "domains": cd, "threat_ips": ci}
        cats = sorted(catcov.values(), key=lambda x: -(x["domains"] + x["threat_ips"]))
        cov = {"domains": dom, "threat_ips": ips, "categories": len(enforced), "ifaces": n_ifaces, "mechanisms": mech, "cats": cats,
               **({"waiting": [{"label": (cat.get(cid) or {}).get("label") or cid, "nodes": sorted(ns)}
                               for cid, ns in sorted(waiting.items())]} if waiting else {})}
        # Per-category BLOCKED COUNTS (SNI mode) — sum each content category's blkc ring over the window. Filename
        # blkc-<nid>-<sanitised cat>.rrd; nid is hex + cat is sanitised → exactly one '-'. Ranged like the other tiles.
        blkcat_tot = {}
        for fn in files:
            if not (fn.startswith("blkc-") and fn.endswith(".rrd")):
                continue
            rest = fn[5:-4]
            if "-" not in rest:
                continue
            bnid, bsan = rest.split("-", 1)
            if bnid not in nodes:
                continue
            d = hrrd_read(os.path.join(stats_dir, fn), ring=ring, want=want, since=since, until=until)
            if not d:
                continue
            t = int(max((d.get("pon") or [0])))                    # distinct sites → PEAK per node over the window (gauge, never meaned)
            if t > 0:
                blkcat_tot[bsan] = blkcat_tot.get(bsan, 0) + t     # sum peaks across nodes (each node's own sites)
        blocked_cats = []
        if blkcat_tot:
            _san2lab = {re.sub(r"[^a-z0-9_]", "_", str(k).lower()): ((v or {}).get("label") or k) for k, v in cat.items()}
            blocked_cats = sorted(({"label": _san2lab.get(s, s), "count": c} for s, c in blkcat_tot.items()),
                                  key=lambda x: -x["count"])
        who = {}; _now = int(time.time())
        _t0 = int(since)                                      # the SAME window the tiles read over → the bubble and the tile always agree
        _t1 = int(until) if until is not None and until < _now else _now + 1
        _in = lambda first, last: last >= _t0 and first < _t1
        with contextlib.suppress(Exception):
            _r = roster_load(roster_path); _users = _r.get("users") or {}
            ip2peer = {}
            for _pid, _p in (_r.get("peers") or {}).items():
                for _t in (_p.get("targets") or []):
                    if _t.get("ip"):
                        ip2peer[str(_t["ip"]).split("/")[0]] = _p
            _off = Handler.deps.get("_offenders") or {}
            for _mtr in OFFENDER_METRICS:
                grp = {}
                for _ip, _e in (_off.get(_mtr) or {}).items():
                    first, last = int(_e[0]), int(_e[1])
                    if not _in(first, last):                  # not seen in the window → not an offender in this range
                        continue
                    p = ip2peer.get(_ip); uid = (p or {}).get("user_id"); pid = (p or {}).get("id")
                    key = ("u:" + uid) if uid else (("p:" + pid) if pid else ("ip:" + _ip))
                    g = grp.setdefault(key, {"user": (_users.get(uid) or {}).get("name") if uid else None,
                                             "user_id": uid, "peers": {}, "last": 0})
                    nm = (p.get("title") if p else None) or (("Peer ." + _ip.split(".")[-1]) if p else _ip)
                    pk = pid or ("ip:" + _ip)
                    pe = g["peers"].get(pk)
                    if pe:                                    # a peer with several target IPs → merge to its newest window
                        pe["last"] = max(pe["last"], last); pe["first"] = min(pe["first"], first)
                    else:
                        g["peers"][pk] = {"name": nm, "last": last, "first": first}
                    g["last"] = max(g["last"], last)
                rows = []
                for g in grp.values():
                    peers = sorted(g["peers"].values(), key=lambda x: -x["last"])   # newest peer first within a user
                    rows.append({"user": g["user"], "user_id": g["user_id"], "n": len(peers), "last_ago": _now - g["last"],
                                 "peers": [{"name": q["name"], "ago": _now - q["last"], "dur": max(0, q["last"] - q["first"])} for q in peers]})
                if rows:
                    who[_mtr] = sorted(rows, key=lambda x: x["last_ago"])           # most-recent offender first
            scan = sum(1 for _e in (_off.get("scan") or {}).values() if _in(int(_e[0]), int(_e[1])))   # tile = DISTINCT scanners in the window (from the SAME offender data the bubble uses), not peak-concurrent → tile == bubble
        return 200, {"ok": True, "data": {"range": rng, "torrents": torrents, "blocked": blocked, "scan": scan, "reach": reach,
                                          "mech": mechd, "series": series, "bseries": bseries, "mseries": mseries,
                                          "who": who, "coverage": cov, "blocked_cats": blocked_cats, **({"axis": axis} if axis else {})}}

