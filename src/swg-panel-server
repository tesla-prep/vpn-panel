                with contextlib.suppress(ValueError, TypeError):
                    others.append(ipaddress.ip_network(str(_x["profile"].get("address") or "") + "/32"))
    _mc = node_mesh_cfg(deps, c)
    return {"ports": ports, "nets": nets, "udp_ranges": _parse_port_ranges(snap.get("udp_ports")), "dialin_addrs": others,
            "listen": _host_listen(snap), "mesh_band": range(_mc["port_base"], _mc["port_base"] + _mc.get("port_span", 100)),
            "awg3": awg3_defaults(deps), "awg3_omit": awg3_omitted(deps),
