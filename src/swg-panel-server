        return {}
    if "userspace" in awg:
        us = awg.get("userspace")
        awg = dict(awg, userspace=[u for u in us if isinstance(u, str) and u] if isinstance(us, list) else [])
    return awg


def _node_issues(c, snap, ivk_pub="", capped=(), unplaced=None, reach=None, clash=None, exits_offline=(), never_block=False,
                 p2p_iface=None):
    issues = []
    nips = snap.get("node_ips") or []; nifs = snap.get("node_ifaces") or []
    _eh = (c.get("endpoint_host") or "").strip()
    if _eh and nips and _is_ip(_eh) and _eh not in nips:
        issues.append(perr("the address clients dial ({v1}) is not on this node — fine behind NAT that forwards it here; "
                           "otherwise clients cannot reach this node", v1=_eh) if snap.get("turn_bind_any") else
                      perr("the address clients dial ({v1}) is no longer on this node — new turn-proxies "
                           "are created with it and will fail to start", v1=_eh))
    _at = lambda r: r["bind"] if isinstance(r.get("bind"), str) else r.get("listen")
    _bound = [("WDTT", w.get("iface") or "?", _at(w)) for w in (snap.get("wdtt") or []) if isinstance(w, dict)]
    _bound += [("csqtt", q.get("iface") or "?", _at(q)) for q in (snap.get("csqtt") or []) if isinstance(q, dict)]
    _bound += [("exit", (x.get("label") or x.get("id") or "?"), x.get("dial_src"))
               for x in (c.get("exits") or []) if isinstance(x, dict)]
    for _kind, _who, _addr in _bound:
        _h, _ = _hostport_split(_addr) if _addr and ":" in str(_addr) else ((_addr or "").strip(), None)
        _h = (_h or "").strip()
        if _h and _h not in ("0.0.0.0", "::", "*") and nips and _is_ip(_h) and _h not in nips:
            issues.append(perr("{v1} {v2} is bound to {v3}, which is no longer on this node",
                               v1=_kind, v2=_who, v3=_h))
    for ifn, ov in (c.get("ifaces") or {}).items():
        if ov.get("_drift"):
            issues.append(perr("{v1}: edited directly on the server", v1=ifn))
        _kb = ov.get("key_blob") or {}
        if _kb.get("ct") and ivk_pub and not ov.get("system") \
                and _kb.get("pub") == (ov.get("public_key") or "") and _kb.get("vault") != ivk_pub:
            issues.append(perr("{v1}: the escrowed key hasn't been proved to open — unlock the vault and the panel checks it", v1=ifn))
        eg = ov.get("egress_ip")
        if eg and nips and eg not in nips:
            issues.append(perr("{v1}: egress IP {v2} is no longer on the node", v1=ifn, v2=eg))
        wn = ov.get("wan_iface")
        if wn and nifs and wn not in nifs:
            issues.append(perr("{v1}: WAN interface {v2} is no longer on the node", v1=ifn, v2=wn))
    _sr = snap.get("smartroute")
    if isinstance(_sr, dict) and not _sr.get("src") and any(
            rule_on(r) and isinstance(r.get("who"), dict)
            for k in ("ifaces", "wdtt", "csqtt") for ov in (c.get(k) or {}).values()
            if isinstance(ov, dict) and ov.get("egress_mode") == "smart" for r in (ov.get("routing") or [])):
        issues.append(perr("{v1} needs an update to route per person — these rules apply to nobody there until it is.",
                           v1=c.get("name") or "this node"))
    if isinstance(_sr, dict) and not _sr.get("ports") and any(
            rule_on(r) and isinstance(r.get("ports"), dict)
            for k in ("ifaces", "wdtt", "csqtt") for ov in (c.get(k) or {}).values()
            if isinstance(ov, dict) and ov.get("egress_mode") == "smart" for r in (ov.get("routing") or [])):
        issues.append(perr("{v1} needs an update to route by port — rules with ports don't apply there until it is.",
                           v1=c.get("name") or "this node"))
    _dl = c.get("default_routing") if isinstance(c.get("default_routing"), list) else []
    _fb = str(c.get("default_exit") or "")
    def _elsewhere(r):
        a = r.get("action")
        if r.get("category") == "all":
            return a in ("block", "exit")
        return a in ("block", "exit") or (a == "dev" and str(r.get("exit_id") or "") != _fb) or (a == "direct" and bool(_fb))
    _differs = any(isinstance(r, dict) and rule_on(r) and r.get("aud") != "local" and _elsewhere(r) for r in _dl)
    if (isinstance(_sr, dict) and not _sr.get("arr") and isinstance(c.get("default_routing"), list)
            and _differs and (reach or {}).get("arr")):
        _dxr = next((x for x in (c.get("exits") or []) if isinstance(x, dict)
                     and str(x.get("id") or "") == str(c.get("default_exit") or "")), None)
        _catch = ((str(_dxr.get("label") or "").strip() or str(_dxr.get("device") or "")) if _dxr
                  else perr("this node's own address"))
        issues.append(perr("{node} needs an update to route traffic cascaded in by destination — until then it all leaves by {catch}.",
                           node=c.get("name") or "this node", catch=_catch))
    for e in clash or ():
        why = (perr("{v1} on {v2} already sends it {v3}", v1=e.get("their"), v2=e.get("via"), v3=e.get("their_subnet"))
               if e.get("via") else perr("{v1} there uses {v2}", v1=e.get("their"), v2=e.get("their_subnet")))
        then = (perr("Forwarding is off for {v1}, so its traffic leaves by this server's own address until one of them gets "
                     "a different subnet.", v1=e.get("iface")) if e.get("kind") == "forward" else
                perr("Rules toward {v1} are skipped for {v2} until one of them gets a different subnet.",
                     v1=e.get("node"), v2=e.get("iface")))
        issues.append(perr("{v1} ({v2}) isn't sent to {v3}: {v4}, so replies couldn't find their way back. {v5}",
                           v1=e.get("iface"), v2=e.get("subnet"), v3=e.get("node"), v4=why, v5=then))
    _broken = _broken_ifaces(c, snap, ivk_pub)
    for ifn, e in (snap.get("interfaces") or {}).items():
        if e.get("down"):
            issues.append(perr("{v1}: interface down on the node (repair available)", v1=ifn)
                          if (_broken.get(ifn) or {}).get("repair") else
                          perr("{v1}: interface down on the node", v1=ifn))
        elif e.get("stopped"):
            issues.append(perr("{v1}: interface stopped", v1=ifn))
        elif e.get("boot_persist") is False:
            issues.append(perr("{v1}: will not start after a reboot — update this node to repair it", v1=ifn))
    for tp in (snap.get("turn_proxies") or []):
        if tp.get("flapping"):
            _for = tp.get("flapping_for")
            issues.append(perr("{v1}: crash-looping — {v2} restarts in {v3} min",
                               v1=(tp.get("service") or "turn-proxy"), v2=tp.get("flapping"),
                               v3=max(1, -(-_for // 60)) if isinstance(_for, int) else 1))
        elif tp.get("running") is False:
            issues.append(perr("{v1}: not running", v1=(tp.get("service") or "turn-proxy")))
    for ifn in _missing_ifaces(c, snap, ivk_pub):
        issues.append(perr("{v1}: interface missing on the node (restore available)", v1=ifn))
    _dp = _awg_datapath(snap)
    if _dp.get("needed") and not _dp.get("ok"):
