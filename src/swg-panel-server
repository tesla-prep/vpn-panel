def _cascade_node_updates(deps, nodes, roster_path):
    now = time.time()
    _ps = deps.get("panel_settings") or {}
    stale_s = max(5, int(((_ps.get("advanced") or {}).get("node_stale_ms") or 30000) / 1000)) * 2
    snaps = deps.get("node_snaps") or {}
    seen = deps.get("node_seen") or {}
    target = _update_target()
    host_names = {os.uname().nodename, os.environ.get("SWG_HOST_HOSTNAME") or ""}
    started, skipped = [], {}
    def _skip(why, nm): skipped.setdefault(why, []).append(nm)
    for nid, c in nodes.items():
        nm = c.get("name") or nid
        snap = snaps.get(nid) or {}
        if not snap: _skip("never reported", nm); continue
        if snap.get("hostname") and snap.get("hostname") in host_names: _skip("updates with the panel", nm); continue
        if now - (seen.get(nid) or 0) > stale_s: _skip("stale", nm); continue
        if snap.get("update_auto") is False: _skip("cannot self-update", nm); continue
        if not _ver_behind(snap.get("noded_version"), target): _skip("already current", nm); continue
        if c.get("update") and (now - ((c.get("update") or {}).get("at") or 0) <= PROC_GRACE):
            _skip("already updating", nm); continue
        c.pop("proc_status", None)
        c["update"] = {"to": target, "from": snap.get("noded_version"), "at": int(now)}
        started.append(nm)
        with contextlib.suppress(Exception):
            ev_append(roster_path, "node", nid, "Update requested", nm, "with the panel", detail_key="with the panel")
    return {"started": started, "skipped": skipped}


def _ver_ahead(have, ref):
    h, r = _vtuple(have), _vtuple(ref)
    return bool(h != (0, 0, 0) and r != (0, 0, 0) and h > r)

