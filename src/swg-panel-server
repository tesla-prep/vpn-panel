    return _INSTANCE


def _read_version():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    version_files = [os.path.join(WEB_DIR, "VERSION"), os.path.join(script_dir, "VERSION")]
    if os.path.basename(script_dir) == "src":
        version_files.append(os.path.join(os.path.dirname(script_dir), "VERSION"))
    for p in version_files:
        try:
            with open(p) as f:
                v = f.read().strip()
                if v:
                    return v
        except OSError:
            pass
    return ""


def _short_ver(s):
    for tok in s.replace(",", " ").split():
        t = tok.lstrip("vV")
        if t and t[0].isdigit():
            return t
    return s.strip()


def _detect_versions():
    """swg-panel version + whatever stack tooling is present on the panel host
    (awg / wg / docker). Computed once at startup; nodes vary, this is the host."""
    out = {"panel": _read_version()}
    for key, args in (("awg", ["awg", "--version"]),
                      ("wg", ["wg", "--version"]),
                      ("docker", ["docker", "--version"])):
        try:
            p = subprocess.run(args, capture_output=True, text=True, timeout=3)
            line = ((p.stdout or "") + (p.stderr or "")).strip().splitlines()
            if line:
                out[key] = _short_ver(line[0])
        except Exception:
            pass
    return {k: v for k, v in out.items() if v}

