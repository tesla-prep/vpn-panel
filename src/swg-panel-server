        ev_append(roster_path, "node", nid, "Updated node", nodes[nid].get("name", nid))
        return 200, {"ok": True, "data": {"id": nid, "name": nodes[nid].get("name"),
                                          # §5.4 — what the default list's save could not keep, as an interface's save says it
                                          **({"dropped": _rdrop_n} if _rdrop_n and _rdrop_n.get("total") else {})}}

    if method == "POST" and path == "/api/node/awg-load":   # "Load now": swap in the AmneziaWG module an update installed
        nid = body.get("id") or ""
