            if not (5 <= q <= RELAY_QUOTA_MAX):
                return 400, {"ok": False, **perr("relay_quota_pct must be between {v1} and {v2}", v1="5", v2=str(RELAY_QUOTA_MAX)), "code": "bad_request"}
            nodes[nid].setdefault("relay", {})["quota_pct"] = q
        _g0, _t0 = mesh_link_override(nodes, nid, peer), mesh_template_clean(mesh_link_awg_set(nodes, nid, peer))[0] or {}
        _g1, _t1 = _g0, _t0
        if "mesh_awg_gen" in body:
            _g1 = str(body.get("mesh_awg_gen") or "")
            if _g1 and _g1 not in MESH_AWG_GENS:
