        nodes_save(deps["nodes_path"], nodes)
        return 200, {"ok": True, "data": {"id": nid, "name": name, "token": token}}

    if method == "POST" and path == "/api/nodes/update":
        nid = body.get("id") or ""
        _rdrop_n = None
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if "name" in body:                      # name is a free-to-change display title (no refs to migrate)
            nm = (body.get("name") or "").strip()
            if not nm or len(nm) > 40 or not all(c.isalnum() or c in "-_" for c in nm):
                return 400, {"ok": False, "error": "name must be 1–40 chars: letters, digits, - or _", "code": "bad_request"}
            nodes[nid]["name"] = nm
        if "color" in body:
            nodes[nid]["color"] = sanitize_color(body.get("color"), nodes[nid].get("color"))
        if "endpoint_host" in body:
            nodes[nid]["endpoint_host"] = (body.get("endpoint_host") or "").strip()
        if "endpoint_hosts" in body:
            _hs, _seen = [], set()
            for _h in (body.get("endpoint_hosts") or []):
                _h = str(_h or "").strip().rstrip(".")
                if not _h or len(_h) > 253 or not no_ctrl(_h):
                    continue
                if not (_HOSTNAME_RE.match(_h.lower()) or _ip_literal(_h)):
                    return 400, {"ok": False, **perr("{v1} isn't a usable host or address", v1=_h[:60]), "code": "bad_request"}
                if _h.lower() in _seen:
                    continue
                _seen.add(_h.lower()); _hs.append(_h)
                if len(_hs) >= 12:
                    break
            nodes[nid]["endpoint_hosts"] = _hs
        # node IP roles: SNAT source for direct egress / source to dial the panel / source to dial mesh peers
        if "default_exit" in body and not isinstance(body["default_routing"] if "default_routing" in body
                                                      else nodes[nid].get("default_routing"), list):
            _de = str(body.get("default_exit") or "").strip()
            if _de:
                return 400, {"ok": False, "error": "Assign SOCKS5 in the user card", "code": "bad_request"}
            if _de and not any(str((x or {}).get("id")) == _de for x in (nodes[nid].get("exits") or [])):
                return 400, {"ok": False, "error": "default_exit must be one of this node's exits",
                             "code": "bad_request"}
            if _de:
                nodes[nid]["default_exit"] = _de
            else:
                nodes[nid].pop("default_exit", None)
        for k in ("default_egress_ip", "panel_ip", "mesh_egress_ip"):
            if k in body:
                v = (body.get(k) or "").strip()
                if v:
                    try:
                        if ipaddress.ip_address(v).version != 4:
                            raise ValueError
                    except ValueError:
                        return 400, {"ok": False, **perr("{v1} must be a valid IPv4 address (or blank)", v1=k), "code": "bad_request"}
                nodes[nid][k] = v
        if "routing_mode" in body:              # how THIS node adds a HOST layer on top of the always-on IP layer:
            rm = (body.get("routing_mode") or "kernel").strip()   # kernel (IP only) | forcedns (host via dnsmasq, blocks
            # client DoH) | sni (host via userspace SNI reader) | sni_kernel (host via in-kernel xt_string SNI reader).
            if rm not in ("kernel", "sni"):
                return 400, {"ok": False, "error": "routing_mode must be kernel|sni", "code": "bad_request"}
            nodes[nid]["routing_mode"] = rm
        if "ip_learning" in body:               # keep learned SNI IPs (True) vs stay fresh / no remembered IPs (False)
            nodes[nid]["ip_learning"] = bool(body.get("ip_learning"))
        if "log_mb" in body:                    # this node's disk budget for swg's logs; stored only when not the default
            _lmb, _lerr = log_mb_parse(body.get("log_mb"))
            if _lerr:
                return 400, {"ok": False, **_lerr, "code": "bad_request"}
            if _lmb == LOG_MB_DEFAULT:
                nodes[nid].pop("log_mb", None)
            else:
                nodes[nid]["log_mb"] = _lmb
        if "exits" in body:                     # the node's exit DEVICES (decision 10: a list from day one)
            _c = nodes[nid]
            _lk = {(l or {}).get("iface") for l in (_c.get("links") or {}).values()}
            _pf = node_mesh_cfg(deps, _c).get("iface_prefix") or "swg_"
            _sn = (deps.get("node_snaps") or {}).get(nid) or {}
            _nic = _sn.get("ether_ifaces") or []
            _ex, _err = _validate_exits(body.get("exits"), _c, mesh_prefix=_pf, link_ifaces=_lk,
                                        prev=_c.get("exits") or [], nics=_nic, dialin=_dialin_ctx(deps, nodes, nid),
                                        gws=_sn.get("ether_gws"), wan=(_sn.get("wan_iface") or ""), gen_snap=_sn)
            if isinstance(_err, dict):                   # a perr: a 3.1 profile this node cannot run, or a bad 3.x key
                return 400, {"ok": False, **_err, "code": "bad_request"}
            if _err:
                _b = {"ok": False, "error": _err, "code": "bad_request"}
                if _err.startswith("exit device refused: "):
                    _b["refusal"] = _err.split(": ", 1)[1]
                    _known = {str((x or {}).get("id") or ""): x for x in (_c.get("exits") or [])}
                    for _e in (body.get("exits") or []):
                        if not isinstance(_e, dict) or (_e.get("producer") or "adopted") == "imported":
                            continue
                        _d = str(_e.get("device") or "").strip()
                        if exit_device_refusal(_c, _d, mesh_prefix=_pf, link_ifaces=_lk, nics=_nic,
                                               gws=_sn.get("ether_gws"), wan=(_sn.get("wan_iface") or ""),
                                               gw_known=bool(str(_e.get("gw") or "").strip())) == _b["refusal"]:
                            _b["device"] = _d
                            break
                return 400, _b
            removed = {e["id"] for e in (_c.get("exits") or []) if isinstance(e, dict) and e.get("id")}
            removed.difference_update(e["id"] for e in _ex)
            if removed and any(ref[0] == nid and ref[1] in removed
                               for u in roster_load(roster_path)["users"].values()
                               if isinstance(u, dict) and (ref := static_exit_ref(u.get("static_exit")))):
                return 409, {"ok": False, **perr("Remove the user's static exit assignment before deleting the SOCKS5 exit"),
                             "code": "conflict"}
            if _ex:
                _c["exits"] = _ex
            else:
                _c.pop("exits", None)
        if "default_routing" in body:
            _dr = body.get("default_routing")
            if _dr is None:
                nodes[nid].pop("default_routing", None)
                nodes[nid].pop("default_routing_exit_ips", None)
            else:
                _drc = [cl.get("id") for cl in ((deps.get("panel_settings") or {}).get("custom_lists") or []) if cl.get("id")]
                _rules, _rerr, _rdrop_n = _validate_routing(_dr, nodes, nid, _drc,
                                                            snap=(deps.get("node_snaps") or {}).get(nid) or {},
                                                            prev=nodes[nid].get("default_routing") or [], node_scope=True)
                if _rerr:
                    return 400, {"ok": False, "error": _rerr, "code": "bad_request"}
                nodes[nid]["default_routing"] = _rules
        if "default_routing_exit_ips" in body and isinstance(nodes[nid].get("default_routing"), list):
            _xm, _xerr = _clean_exit_ips(body.get("default_routing_exit_ips"), nodes, nid,
                                         nodes[nid].get("default_routing_exit_ips") or {})
            if _xerr:
                return 400, {"ok": False, "error": _xerr, "code": "bad_request"}
            if _xm:
                nodes[nid]["default_routing_exit_ips"] = _xm
            else:
                nodes[nid].pop("default_routing_exit_ips", None)
        if "p2p" in body:                       # the node-wide P2P policy; null → back to the computed default (p2p_policy)
            _pp = body.get("p2p")
            if _pp is None:
                nodes[nid].pop("p2p", None)
            elif isinstance(_pp, dict) and _pp.get("action") in P2P_ACTIONS:
                _prec, _perr = _p2p_target(_pp, nodes, nid)   # after `exits` above, so an exit made in this save counts
