    def _node_goodbye(self):
        nid, _gnode, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(_gnode, b"", require=False):   # installer-driven (bash) → never require
            return
        with _api_lock:
            nodes = nodes_load(Handler.deps["nodes_path"])   # re-read under the lock
            if nid not in nodes:
                return self._send(200, {"ok": True, "kept": nid})
            if nodes[nid].get("removing"):
                nm = node_remove(Handler.deps, nid)
                return self._send(200, {"ok": True, "removed": nm or nid})
            nodes[nid]["uninstalled"] = int(time.time())
            nodes[nid].pop("proc_status", None)   # the node is gone now — supersede any "uninstalling" tag
            nodes_save(Handler.deps["nodes_path"], nodes)
            (Handler.deps.get("node_snaps") or {}).pop(nid, None)
            (Handler.deps.get("node_seen") or {}).pop(nid, None)
            ev_append(Handler.deps["roster_path"], "node", nid, "Node uninstalled — kept for re-install",
                      nodes[nid].get("name", nid))
        return self._send(200, {"ok": True, "kept": nid})

    def _node_logs(self):
        """Logs P2: a node's live lines for a viewer (live_absorb). Authorized by the key the node got in its sync reply for
        that request — not by find_node_by_token, whose check parses the whole node store (docs/LOGS-PLAN.md §23.1). The
        body is read only from the node token that reply went with (log_post_admits, a set lookup), and unpacked + parsed
        LOG_POST_SLOTS at a time (503: noded sends it again). gzip, at most LIVE_POST_MAX on the wire and LIVE_POST_RAW_MAX
        unpacked. No _api_lock, no store, no snapshot: the sync invariant (reconcile only on a 200 carrying `desired`) is
        not this route's business."""
        if not _LIVE_REQS and not _RANGE_REQS:          # nothing open (nearly always): no remote body is unpacked and
            return self._send(404, {"ok": False, "error": "no such request", "code": "gone"})   # parsed for nothing
        if not log_post_admits(_log_tok(self.headers.get("Authorization"))):   # before the body: anyone else parses nothing
            return self._send(401, {"ok": False, "error": "invalid node token", "code": "unauthorized"})
        n = self._body_len(cap=LIVE_POST_MAX)
        if n is None:
            return
        raw = self.rfile.read(n) if n else b""
        if not LOG_POST_SLOTS.acquire(blocking=False):
            return self._send(503, {"ok": False, "error": "busy — send it again", "code": "busy"})
        try:                                               # remote input, before any key: never a dropped connection
            try:
                if (self.headers.get("Content-Encoding") or "").strip().lower() == "gzip":
                    d = zlib.decompressobj(16 + zlib.MAX_WBITS)
                    raw = d.decompress(raw, LIVE_POST_RAW_MAX)
                    if d.unconsumed_tail:
                        return self._send(413, {"ok": False, "error": "request body too large", "code": "too_large"})
                body = json.loads(raw or b"{}")          # RecursionError (deep nesting) included
            finally:
                LOG_POST_SLOTS.release()                   # the absorb — a range part's spool too — runs outside it
            if not isinstance(body, dict):
                raise ValueError
            if body.get("id") in _RANGE_REQS and "seq" not in body:   # a range's progress: memory only, never refused
                code, obj = range_absorb(body)
            elif body.get("id") in _RANGE_REQS:            # a range download's part (Logs P3): to the spool, a few at a time
                if not RANGE_POST_SLOTS.acquire(blocking=False):
                    return self._send(503, {"ok": False, "error": "busy — send it again", "code": "busy"})
                try:
                    code, obj = range_absorb(body)
                finally:
                    RANGE_POST_SLOTS.release()
            else:
                code, obj = live_absorb(body)
        except Exception:
            code, obj = 400, {"ok": False, "error": "invalid body", "code": "bad_request"}
        return self._send(code, obj)

    def _range_file(self, rid):
        """Logs P3: GET /api/logs/download/<id> — the made file, as an attachment. Sent as it is on disk (gzip) to a
        browser that takes gzip, which saves the decoded .log; unpacked on the way to one that does not. No HEAD, no
        Range: the file stays RANGE_KEEP after each download, and a broken one is clicked again."""
        got = range_download(rid)
        if got is None:
            return self._send(404, {"ok": False, **perr("no such download (made files are kept {v1} min)", v1=RANGE_KEEP // 60),
                                    "code": "gone"})
        path, raw, size, name = got
        gz = accepts_gzip(self.headers.get("Accept-Encoding"))
        try:
            f = open(path, "rb")
        except OSError:
            return self._send(404, {"ok": False, "error": "no such download", "code": "gone"})
        with f:
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Disposition", 'attachment; filename="%s"' % name)
            if gz:
                self.send_header("Content-Encoding", "gzip")
            self.send_header("Content-Length", str(size if gz else raw))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            with contextlib.suppress(BrokenPipeError, ConnectionError, OSError, EOFError, zlib.error):
                if gz:
                    shutil.copyfileobj(f, self.wfile, 65536)
                else:
                    with gzip.GzipFile(fileobj=f) as g:
                        shutil.copyfileobj(g, self.wfile, 65536)
                self.wfile.flush()

    def _node_whoami(self):
        # Identify a node by its bearer token — for the installer's leftover-token salvage, so it can show
        # the operator the node's name / method / last-online instead of an opaque token. Read-only.
        nid, node, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(node, b"", require=False):   # installer salvage also hits this (unsigned) → never require
            return
        snap = (Handler.deps.get("node_snaps") or {}).get(nid) or {}
        return self._send(200, {"ok": True, "data": {
            "name": node.get("name", nid),
            "kind": node.get("kind") or snap.get("kind") or "",
            "created": node.get("created"),
            "last_seen": (Handler.deps.get("node_seen") or {}).get(nid)}})

    def _node_list(self, u):
        # Serve a resolved provider list (raw text: one CIDR/domain per line) for a routed category+tier.
        # Node-token auth; the node pulls this only for cats named in its own list_manifest, on version change.
        nid, _node, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(_node, b""):
            return
        q = parse_qs(u.query)
        cat = (q.get("cat") or [""])[0].strip()
        tier = (q.get("tier") or [""])[0].strip()
        _isblku = cat.startswith("blku:")                                        # per-interface block UNION — always served (feeds pre-filtered)
        _isblk = _isblku or cat.startswith("blk:")                                # block feed (blk:<provider>:<list>) → block-provider gate
        _curated = (not _isblk) and ":" not in cat and cat in SMART_CATEGORIES and cat != "all"   # built-in → panel-resolved, always served
        if tier not in ("ip", "host") or (not _isblk and ":" not in cat and not _curated):
            return self._send(400, {"error": "bad cat/tier"})
        if _isblk and not _isblku:
            _bprov = cat.split(":", 2)[1] if cat.count(":") >= 2 else ""
            if not block_providers_enabled(Handler.deps.get("panel_settings")).get(_bprov, True):
                return self._send(403, {"error": "provider disabled"})           # never serve a disabled block feed
        elif not _isblk and not _curated and not ((Handler.deps.get("panel_settings") or {}).get("providers") or {}).get(cat.split(":", 1)[0], False):
            return self._send(403, {"error": "provider disabled"})   # never serve a not-enabled provider's list
        meta = list_meta(cat, tier)
        try:
            with open(_list_path(cat, tier), "rb") as f:
                data = f.read()
        except OSError:
            list_ensure(cat, tier)                                    # kick a resolve; node retries next sync
            return self._send(404, {"error": "not resolved yet"})
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-List-Version", (meta or {}).get("v", ""))
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(data)

    def _node_turn_binary(self, u):
        nid, _node, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(_node, b""):
            return
        q = parse_qs(u.query)
        owner = (q.get("owner") or [""])[0].strip()
        tag = (q.get("tag") or [""])[0].strip()
        arch = (q.get("arch") or [""])[0].strip()
        if not _OWNER_RE.match(owner) or not tag or "/" in tag or ".." in tag or arch not in TURN_ARCHES:
            return self._send(400, {"error": "bad owner/tag/arch"})
        if owner == HEV_OWNER:                          # a SOCKS5 exit's hev: the pinned release, the pinned bytes, only
            dest = hev_mirror_file(arch) if tag == HEV_TAG else ""
            sha = HEV_SHA256.get(arch, "") if dest else ""
        else:
            sha = turn_sum(owner, tag, arch, need_file=True)   # ensures it's mirrored (fetch-on-miss, a pruned one too) + its hash
            dest = _turn_store_path(owner, tag, arch)
        if not sha or not os.path.isfile(dest):
            return self._send(404, {"error": "binary unavailable"})
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Turn-Sha256", sha)
        self.send_header("Content-Length", str(os.path.getsize(dest)))
        self.end_headers()
        with contextlib.suppress(Exception):
            with open(dest, "rb") as f:                 # stream in chunks — a fleet-wide update pull mustn't buffer 22MB per request
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    self.wfile.write(chunk)

    def _node_rename(self):
        # A node renames ITSELF (node-token auth) — so a re-install/convert can push a box-name change the
        # operator entered in the installer. name is a free display field (id-keyed store); no refs to migrate.
        nid, _rnode, _ = self._node_token()
        if not nid:
            return
        length = self._body_len()
        if length is None:
            return
        raw = self.rfile.read(length) if length else b""
        if not self._node_sig_ok(_rnode, raw, require=False):   # installer-driven (bash) → never require
            return
        try:
            body = json.loads(raw or b"{}") if raw else {}
        except Exception:
            body = {}
        name = strip_ctrl((body.get("name") or "").strip())[:40]   # node names itself (node-token) — drop control chars
        if not name:
            return self._send(400, {"ok": False, "error": "empty name"})
        # ⚠️ This wrote through `nodes` without ever binding it (_node_token's copy is discarded above), so every
        # self-rename raised NameError and dropped the connection — silent, the installer's call ends in `|| true`.
        with _api_lock:
            nodes = nodes_load(Handler.deps["nodes_path"])   # re-read under the lock, as _node_goodbye / _node_transfer do
            old = (nodes.get(nid) or {}).get("name", nid)
            if nid in nodes:
                nodes[nid]["name"] = name
                nodes_save(Handler.deps["nodes_path"], nodes)
        if nid not in nodes:                             # removed meanwhile — replied AFTER the lock, as _node_sync does
            return self._send(404, {"ok": False, "error": "unknown node"})
        if name != old:
            ev_append(Handler.deps["roster_path"], "node", nid, "Renamed node", name)
        return self._send(200, {"ok": True, "data": {"id": nid, "name": name}})

    def do_GET(self):
        _REQ.lang = self.headers.get("X-SWG-Lang") or ""                # the browser's UI language (changelog only)
        u = urlparse(self.path)
        path = strip_base(u.path)
        if path is None:
            return self.send_error(404)
        if static_rel(path) is not None:   # SPA assets are public so the login page can load
            return self._static(path)
        if path == "/api/node/whoami":     # node-token auth (not a session) — lets a re-installer identify a leftover token
            return self._node_whoami()
        if path == "/api/node/list":       # node-token auth — serve a resolved provider list (raw text) for a routed cat/tier
            return self._node_list(u)
        if path == "/api/node/turn-binary":  # node-token auth — serve a mirrored turn-proxy fork binary (Axis 2 · P2)
            return self._node_turn_binary(u)
        if path == "/healthz" or path == "/metrics" or path.startswith("/api/v1/"):
            return self._ext_api(path, u)  # external integration API — its OWN token/session auth (read-only)
        if not self._require_auth():       # everything else (data) needs a session
            return
        if path.startswith("/wgstats/"):
            return self._wgstats(path)
        if path.startswith("/api/"):
            if path == "/api/state":       # the hot poll path — served from the short-TTL memo
                return self._send_state()
            if path == "/api/logs/live":   # the log viewer's poll: memory only, never api() (it parses the node store)
                code, obj = live_api_get(parse_qs(u.query), self.deps)
                return self._send_state_bytes({"bytes": json.dumps(obj).encode(), "gz": None}) if code == 200 else self._send(code, obj)
            if path == "/api/logs/range":  # a range download's progress: memory only, never api()
                code, obj = range_api_get(parse_qs(u.query), self.deps)
                return self._send_state_bytes({"bytes": json.dumps(obj).encode(), "gz": None}) if code == 200 else self._send(code, obj)
            if path.startswith("/api/logs/download/"):   # the made file, from the spool: never api(), never a Blob
                return self._range_file(path[len("/api/logs/download/"):])
            try:
                code, obj = api("GET", path, parse_qs(u.query), {}, self.deps)
            except Exception as e:
                log(LOG_WARNING, "GET %s failed: %s", path, e)
                return self._send(500, {"ok": False, "error": "Internal server error", "code": "internal"})
            if code == 200 and path in _LEDGER_GZ:   # a row per peer: compressed exactly the way /api/state is
                return self._send_state_bytes({"bytes": json.dumps(obj).encode(), "gz": None})
            return self._send(code, obj)
        self.send_error(404)

    def do_POST(self):
        _REQ.lang = self.headers.get("X-SWG-Lang") or ""                # the browser's UI language (changelog only)
        u = urlparse(self.path)
        path = strip_base(u.path)
        if path is None:
            return self.send_error(404)
        if path == "/api/node/sync":
            try:
                return self._node_sync()
            except Exception as e:        # never drop the connection (a proxy turns that into a 5xx/520) — a node skips a non-200 pass safely
                log(LOG_ERR, traceback.format_exc().rstrip("\n"))
                return self._send(500, {"ok": False, "error": str(e), "code": "internal"})
        if path == "/api/node/goodbye":
            return self._node_goodbye()
        if path == "/api/node/logs":       # a viewer's / range's lines — admitted by the node token its sync reply carried (a
            #                                set lookup, before the body), parsed LOG_POST_SLOTS at a time, then the request's key; no store, no lock
            return self._node_logs()
        if path == "/api/node/rename":     # node-token auth — installer pushes a box-name change
            return self._node_rename()
        if path == "/api/login":
            return self._login()
        if path == "/api/logout":
            return self._logout()
        if not self._require_auth():
            return
        if path is None or not path.startswith("/api/"):
            return self.send_error(404)
        length = self._body_len()
        if length is None:
            return
        raw = self.rfile.read(length) if length else b"{}"
        try:
            bodyobj = json.loads(raw or b"{}")
            if not isinstance(bodyobj, dict):
                raise ValueError
        except (json.JSONDecodeError, ValueError):
            return self._send(400, {"ok": False, "error": "invalid JSON body", "code": "bad_request"})
        if path in ("/api/logs/live", "/api/logs/live/close"):   # the log viewer: its own memory store, no lock, no api()
            return self._send(*live_api_post(path, bodyobj, self.deps))
        if path in ("/api/logs/range", "/api/logs/range/make", "/api/logs/range/close"):   # a range download: the same
            return self._send(*range_api_post(path, bodyobj, self.deps))
        try:
            if path in _LOCKLESS_POST or path in _SELF_LOCKING_POST:   # network-bound → never waits holding the lock (see both)
                code, obj = api("POST", path, {}, bodyobj, self.deps)
            else:
                with _api_lock:                   # mutations are read-modify-write; serialize them
                    code, obj = api("POST", path, {}, bodyobj, self.deps)
        except Exception as e:
            code, obj = 500, {"ok": False, "error": str(e), "code": "internal"}
        if 200 <= code < 300:
            _invalidate_state_cache()             # a successful mutation → next poll rebuilds immediately
        self._send(code, obj)

    def log_message(self, *a):
        pass


def passwd_cmd(argv):
    """`swg-panel-server passwd` → the dedicated `swg-passwd` command, so this invocation resets the
    login instead of (the old footgun) falling through and starting a second server."""
    sp = shutil.which("swg-passwd") or "/usr/local/bin/swg-passwd"
    if os.path.exists(sp):
        os.execv(sp, [sp] + list(argv[2:]))
    raise SystemExit("reset the panel login with:  sudo swg-passwd")


