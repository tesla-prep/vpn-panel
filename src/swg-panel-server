def catalog_providers_view(enabled, nodes=None):
    pulled = {}
    for cat in routed_catalog_cats(nodes or {}):
        pid = cat.split(":", 1)[0]
        for tier in ("host", "ip"):
            at = int((list_meta(cat, tier) or {}).get("at") or 0)
            if at > pulled.get(pid, 0):
                pulled[pid] = at
    out = []
    for pid in CATALOG_PROVIDER_ORDER:
        cfg = CATALOG_PROVIDERS[pid]
        tiers = sorted(set(cfg["lists"].values()) if "lists" in cfg else {t for t, _ in cfg["trees"]})
        st = _PROV_STATUS.get(pid) or {}
        out.append({"id": pid, "label": cfg["label"], "url": cfg.get("url", ""),
                    "tiers": tiers, "enabled": bool((enabled or {}).get(pid, False)),
                    "desc": cfg.get("note", ""),
                    "error": (_CATALOG.get("perr") or {}).get(pid, "") or st.get("error", ""),
                    "status": st.get("status", "idle"),
                    "last_updated": max(pulled.get(pid, 0), int(st.get("last_updated", 0) or 0))})
    return out

def _is_routed_list_cat(cat):
    if not isinstance(cat, str):
        return False
    provider, _, name = cat.partition(":")
    cfg = CATALOG_PROVIDERS.get(provider)
    return bool(name and cfg and ("lists" not in cfg or name in cfg["lists"]))

def routed_catalog_cats(nodes):
    out = set()
    for n in (nodes or {}).values():
        if not isinstance(n, dict):
            continue
        for c in (n.get("catalog_cats") or []):
            if _is_routed_list_cat(c):
                out.add(c)
        for _src in ("ifaces", "wdtt", "csqtt"):
            for ifo in (n.get(_src) or {}).values():
                for r in ((ifo or {}).get("routing") or []):
                    c = r.get("category") if isinstance(r, dict) else None
                    if _is_routed_list_cat(c):
                        out.add(c)
        for r in (n.get("default_routing") if isinstance(n.get("default_routing"), list) else ()):
            c = r.get("category") if isinstance(r, dict) else None
            if _is_routed_list_cat(c):
                out.add(c)
    return out

def provider_update_all(nodes_path):
    if _PROV_UPDATING["on"]:
        return
    _PROV_UPDATING["on"] = True
    def _work():
        try:
            cats = routed_catalog_cats(nodes_load(nodes_path))
            by_prov = {}
            for c in cats:
                by_prov.setdefault(c.split(":", 1)[0], []).append(c)
            for pid in CATALOG_PROVIDER_ORDER:
                _PROV_STATUS.setdefault(pid, {})["status"] = "updating"
            _prov_status_save()
            catalog_index(force=True)
            cix = catalog_index()
            for pid in CATALOG_PROVIDER_ORDER:
                st = _PROV_STATUS.setdefault(pid, {})
                changed = False; failed = False; err = ""; touched = 0
                for c in by_prov.get(pid, []):
                    caps = cix.get(c) or {}
                    for tier in ("ip", "host"):
                        if not caps.get(tier):
                            continue
                        touched += 1
                        before = (list_meta(c, tier) or {}).get("v", "")
                        meta, status = list_store(c, tier)
                        if status == "fetch-failed":
                            failed = True; err = "couldn't fetch " + c
                            continue
                        if status == "collapsed":
                            failed = True; err = "kept " + c + " — a re-fetch returned far fewer records"
                            continue
                        if meta and meta.get("v") != before:
                            changed = True
                st["status"] = "failed" if failed else ("updated" if changed else "uptodate")
                st["at"] = int(time.time())
                if err:
                    st["error"] = err[:120]
                else:
                    st.pop("error", None)
                if changed:
                    st["last_updated"] = int(time.time())
                _prov_status_save()
        finally:
            _PROV_UPDATING["on"] = False
    threading.Thread(target=_work, daemon=True).start()

def _http_retry(fn, tries=4, backoff=1.2, deadline=None):
    last = None
    for i in range(tries):
        try:
            return fn()
        except Exception as e:
            last = e
            if getattr(e, "code", None) in (401, 403, 429):
                raise
            if i == tries - 1:
                raise
            nap = backoff * (i + 1)
            if deadline is not None:
                nap = min(nap, deadline - time.time())
                if nap <= 0:
                    raise
            time.sleep(nap)
    raise last

def _catalog_gh(url):
    def _do():
        req = urllib.request.Request(url, headers={"User-Agent": "swg-panel", "Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    return _http_retry(_do)

def _runet_catalog_id(name):
    return name.replace("@", "--attr--").replace("!", "--bang--")


def _catalog_build(only=None):
    idx = {}; perr = {}
    for prov in [p for p in CATALOG_PROVIDER_ORDER if not only or p in only]:
        cfg = CATALOG_PROVIDERS[prov]; strip = cfg.get("strip", "")
        try:
            for tier, url in cfg["trees"]:
                t = _catalog_gh(url)
                for e in (t.get("tree") or []):
                    if e.get("type") != "blob":
                        continue
                    p = e.get("path", "")
                    host_text = False
                    if prov == "runet":
                        if tier == "host" and p.startswith("geosite-") and p.endswith(".srs"):
                            rid = _runet_catalog_id(p[8:-4])
                        elif p.endswith(".txt"):
                            rid = p[:-4]
                            host_text = tier == "host"
                        else:
                            continue
                    else:
                        if strip and not p.endswith(strip):
                            continue
                        if cfg.get("skip_at") and "@" in p:
                            continue
                        rid = p[:-len(strip)] if strip else p
                    if not rid or "/" in rid:
                        continue
                    if prov in ("runet", "rc") and not re.fullmatch(r"[a-z0-9_.-]+", rid):
                        continue
                    resolved_tier = cfg["lists"].get(rid) if "lists" in cfg else tier
                    if resolved_tier:
                        entry = idx.setdefault(prov + ":" + rid, {"p": prov, "ip": False, "host": False})
                        entry[resolved_tier] = True
                        if host_text:
                            entry["host_text"] = True
        except Exception as ex:
            perr[prov] = str(ex)[:120]
    if only:
        merged = dict(_CATALOG.get("perr") or {})
        for p in only:
            merged.pop(p, None)
        merged.update(perr)
        _CATALOG["perr"] = merged
    else:
        _CATALOG["perr"] = perr
    return idx

def catalog_index(force=False):
    now = int(time.time())
    if not force:
        cached, have = catalog_cached()
        if have and now - _CATALOG["at"] < CATALOG_TTL:
            return cached
    if not force and _CATALOG.get("fail_at") and now - _CATALOG["fail_at"] < CATALOG_FAIL_TTL:
        return _catalog_last_good()
    try:
        idx = _catalog_build()
    except Exception as ex:
        idx = None
        _CATALOG["err"] = str(ex)[:200]
    if not idx:
        _CATALOG["fail_at"] = now
        _CATALOG["err"] = _CATALOG["err"] or "every catalog provider failed to fetch"
        return _catalog_last_good()
    failed = _CATALOG.get("perr") or {}
    if failed:
        last = _catalog_last_good()
        keep = {p for p in failed if any(e.get("p") == p for e in last.values())}
        idx = {c: e for c, e in idx.items() if e.get("p") not in keep}
        idx.update({c: e for c, e in last.items() if e.get("p") in keep})
    _CATALOG.update(idx=idx, at=now, err="")
    _catalog_changed()
    _CATALOG.pop("fail_at", None)
    with contextlib.suppress(Exception):
        atomic_write(CATALOG_PATH, json.dumps({"idx": idx, "at": now}))
    return idx


def _catalog_last_good():
    return catalog_cached()[0]


def sync_cat_caps(plan_cats, cix, cix_have, blk_srcs, snap):
    caps = {**{c: cix[c] for c in plan_cats if c in cix},
            **{c: {t: True} for c, t in blk_srcs.items()}}
    keep = []
    if not cix_have:
        for c in sorted(plan_cats):
            if c in caps or not _is_routed_list_cat(c):
                continue
            held = {t: True for t in ("ip", "host") if list_meta(c, t)}
            if held:
                caps[c] = held
            else:
                keep.append(c)
        if keep and not node_keeps_caps(snap):
            return None, []
    return caps, keep


_CAPS_WITHHELD = {}


def node_keeps_caps(snap):
    _sr = snap.get("smartroute") if isinstance(snap, dict) else None
    return isinstance(_sr, dict) and _sr.get("caps_keep") == 1


def catalog_cached():
    if _CATALOG["idx"]:
        return _CATALOG["idx"], True
    try:
        with open(CATALOG_PATH) as f:
            d = json.load(f)
        idx = {c: e for c, e in (d.get("idx") or {}).items() if _is_routed_list_cat(c)}
        if idx:
            _CATALOG.update(idx=idx, at=int(d.get("at") or 0))
            _catalog_changed()
            return idx, True
    except Exception:
        pass
    return {}, False


_LIST_GC_GRACE = 30 * 86400


def lists_gc(nodes, panel_settings):
    live = set()
    for c in routed_catalog_cats(nodes or {}):
        live.add(c)
    bc = block_catalog(panel_settings or {})
    def _blk_srcs(ids):
        for cid in (ids or []):
            for sc in ((bc.get(cid) or {}).get("sources") or []):
                prov = (sc.get("provider") or "").strip()
                if prov:
                    live.add("blk:" + prov + ":" + (sc.get("list") or "").strip())
    for n in (nodes or {}).values():
        if not isinstance(n, dict):
            continue
        for key in ("ifaces", "wdtt", "csqtt"):
            for ov in (n.get(key) or {}).values():
                _blk_srcs((ov or {}).get("block"))
    if not live and not _BLKU_REG:
        return 0, "nothing is referenced — refusing to sweep"
    keep = {_list_key(c, t) for c in live for t in ("ip", "host")}
    keep |= {_list_key(*k.rsplit("|", 1)) for k in list(_LIST_INFLIGHT)}
    if _BLKU_REG:
        keep |= {_list_key(c, t) for c in _BLKU_REG for t in ("ip", "host")}
    now, removed = time.time(), 0
    try:
        names = os.listdir(LIST_DIR)
    except OSError:
        return 0, ""
    for fn in names:
        if fn.endswith(".tmp"):
            with contextlib.suppress(OSError):
                if now - os.path.getmtime(os.path.join(LIST_DIR, fn)) > 86400:
                    os.remove(os.path.join(LIST_DIR, fn)); removed += 1
            continue
        if not fn.endswith(".meta"):
            continue
        key = fn[:-5]
        if key in keep or (not _BLKU_REG and key.startswith("blku_")):
            continue
        try:
            at = int((json.load(open(os.path.join(LIST_DIR, fn))) or {}).get("at") or 0)
        except Exception:
            at = 0
        if at and now - at < _LIST_GC_GRACE:
            continue
        for ext in (".meta", ".txt"):
            with contextlib.suppress(OSError):
                os.remove(os.path.join(LIST_DIR, key + ext))
        removed += 1
    if removed:
        for mk in [k for k in list(_LIST_META) if _list_key(*k.rsplit("|", 1)) not in keep]:
            _LIST_META.pop(mk, None)
        log(LOG_INFO, "lists gc: removed %d unreferenced file(s) from %s", removed, LIST_DIR)
    return removed, ""


def _catalog_refresh_loop():
    _gc_at = [time.time()]
    while True:
        with contextlib.suppress(Exception):
            catalog_index()
        if time.time() - _gc_at[0] > 6 * 3600:
            _gc_at[0] = time.time()
            with contextlib.suppress(Exception):
                lists_gc(nodes_load(Handler.deps["nodes_path"]), Handler.deps.get("panel_settings"))
            with contextlib.suppress(Exception):
                rings_gc((Handler.deps.get("fleet") or {}).get("stats_dir"))
        time.sleep(900)


def catalog_label(cid):
