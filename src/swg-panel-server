def clean_overrides(raw):
    if not isinstance(raw, dict):
        return {}
    ov = {}
    if "dns" in raw and isinstance(raw["dns"], list):
        ov["dns"] = [str(x).strip() for x in raw["dns"][:8] if isinstance(x, str) and str(x).strip() and no_ctrl(str(x))]
    if raw.get("mtu") not in (None, "", 0):
        with contextlib.suppress(Exception):
            ov["mtu"] = max(576, min(9200, int(raw["mtu"])))
    if isinstance(raw.get("allowed"), str) and raw["allowed"].strip() and no_ctrl(raw["allowed"]):
        ov["allowed"] = raw["allowed"].strip()[:512]
    if raw.get("keepalive") not in (None, ""):
        with contextlib.suppress(Exception):
            ov["keepalive"] = max(0, min(65535, int(raw["keepalive"])))
    return ov


