    ⚠️ A failure here USED TO BE SILENT, and the symptom did not look like a permissions problem: the panel
    came up fine and simply signed out every operator on each restart, with nothing in the journal. The
    cause found in the field is that state OUTLIVES the service user. `uninstall.sh` removes swgpanel but
    deliberately keeps /var/lib/swg-panel, so its files keep a numeric uid that no longer belongs to
    anyone; `useradd -r` then hands that uid to whichever service account is created FIRST next time — on
    the box where this was found, `swgsub` inherited the old panel's uid, and this 0600 file with it. The
    panel could no longer read its own secret and quietly minted a throwaway one every start.

    So: a MISSING file is first-run and creates one. A file we cannot read or replace is an error, said
    plainly here and surfaced in the UI — never papered over.
    """
    global SESSION_KEY_EPHEMERAL
    p = os.path.join(os.path.dirname(roster_path) or ".", "session.key")
    try:
        with open(p, "rb") as f:
            s = f.read().strip()
        if len(s) >= 32:
            SESSION_KEY_EPHEMERAL = ""
            return s
        why = "it is too short to be a signing secret"
    except FileNotFoundError:
        why = ""                                   # first run — creating it below IS the normal path
    except OSError as e:
        why = e.strerror or str(e)
    s = base64.b64encode(os.urandom(48))
    try:
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(s)
        SESSION_KEY_EPHEMERAL = ""
        if why:
            log(LOG_INFO, "session.key: replaced (%s)" % why)
    except OSError as e:
        SESSION_KEY_EPHEMERAL = why or e.strerror or str(e)
        log(LOG_ERR, "session.key: cannot persist the session-signing secret (%s: %s). Sessions are being signed "
              "with a throwaway secret, so EVERY signed-in operator is signed out each time the panel "
              "restarts. It is almost always ownership: run  chown -R %s %s", p, SESSION_KEY_EPHEMERAL, _proc_user_name(), os.path.dirname(p) or ".")
    return s


def _proc_user_name():
    """This process's user, for an error message that can be pasted as a command."""
    try:
        import pwd
        return pwd.getpwuid(os.geteuid()).pw_name
    except Exception:
        return str(os.geteuid())


def rotate_session_secret(roster_path):
    """Mint a NEW session-signing secret → every outstanding session cookie stops validating. Called on a
    password change so a captured cookie can't outlive the reset; the admin simply re-signs-in (the panel
    already documents 'you'll be asked to sign in again')."""
    global SESSION_KEY_EPHEMERAL
    p = os.path.join(os.path.dirname(roster_path) or ".", "session.key")
    s = base64.b64encode(os.urandom(48))
    try:
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(s)
        SESSION_KEY_EPHEMERAL = ""
    except OSError as e:
        # The in-memory secret rotates either way, so the captured cookie IS dead for this process — but the
        # OLD secret is still on disk, and the next restart would bring it back to life. Never silent.
        SESSION_KEY_EPHEMERAL = e.strerror or str(e)
        log(LOG_ERR, "session.key: could not write the rotated secret (%s: %s). The old one is still on disk and "
              "would come back on the next restart. Run  chown -R %s %s", p, SESSION_KEY_EPHEMERAL, _proc_user_name(), os.path.dirname(p) or ".")
    return s


def make_session(user, secret, ttl=SESSION_TTL):
    payload = (user + "|" + str(int(time.time()) + ttl)).encode()
    sig = hmac.new(secret, payload, hashlib.sha256).digest()
    return (base64.urlsafe_b64encode(payload).rstrip(b"=").decode() + "."
            + base64.urlsafe_b64encode(sig).rstrip(b"=").decode())


def verify_session(token, secret):
    try:
        p_s, sig_s = token.split(".", 1)
        payload = base64.urlsafe_b64decode(_B64PAD(p_s))
        sig = base64.urlsafe_b64decode(_B64PAD(sig_s))
        if not hmac.compare_digest(sig, hmac.new(secret, payload, hashlib.sha256).digest()):
            return None
        user, exp = payload.decode().rsplit("|", 1)
        return user if int(exp) >= int(time.time()) else None
    except Exception:
        return None


def cfg_hash(pubkey, node, iface=""):
    return hashlib.sha256((pubkey + "|" + node + "|" + iface).encode()).hexdigest() + ".conf"


def atomic_write(path, text, mode=0o600, keep_prev=False):
    """tmp + fsync + os.replace: a reader sees the old file or the new one, never a torn one. `text` may be bytes (the
    traffic ledger's binary files). `keep_prev` moves the replaced file to <path>.prev first — a crash between the two
    renames leaves .prev, which is what the ledger reads when base.bin is gone."""
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".tmp." + uuid.uuid4().hex[:8]
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        os.fchmod(fd, mode)   # force the exact mode regardless of the process umask (0640 must stay group-readable for swg-sub)
        with os.fdopen(fd, "wb" if isinstance(text, (bytes, bytearray)) else "w") as f:
            f.write(text); f.flush(); os.fsync(f.fileno())
        if keep_prev and os.path.exists(path):
            os.replace(path, path + ".prev")
        os.replace(tmp, path)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except (json.JSONDecodeError, OSError):
        return default


# Critical-state durability (users.json / nodes.json)
def _state_backups(path):
    d = os.path.dirname(path) or "."; base = os.path.basename(path) + ".bak."
    try:
        names = [n for n in os.listdir(d) if n.startswith(base)]
    except OSError:
        return []
    return [os.path.join(d, n) for n in sorted(names, reverse=True)]   # ts suffix → name sort == newest first

def save_critical(path, text, mode=0o600, keep=8):
    atomic_write(path, text, mode)                                     # primary (atomic)
    with contextlib.suppress(Exception):                              # + a rotating known-good backup (never fatal)
        atomic_write(path + ".bak." + str(int(time.time())), text, mode)
        for old in _state_backups(path)[keep:]:
            with contextlib.suppress(OSError):
                os.unlink(old)

def _proc_cmdline(pid):
    """argv of a pid as a list of str, or [] if it is gone / unreadable."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def _flock_holder(path):
    """Who holds the flock on `path` — asked of the KERNEL, not inferred from process names.

    Returns (pid, state):
        (int,  "held")     a FLOCK entry for this file, owned by that pid
        (None, "held")     an entry exists but the kernel names no pid (an OFD lock)
        (None, "free")     /proc/locks is readable and NOTHING holds this file
        (None, "unknown")  we could not look

    "free" and "unknown" must never be collapsed: one of them permits removing the lock file and the
    other must not. Guessing wrong there re-creates the two-panels-on-one-state-dir clobber this lock
    exists to prevent — which is how the previous version could steal a lock a live process held, by
    scanning for a process NAMED swg-panel-server and deleting the lock when it found none.

    Matched on INODE alone, deliberately. /proc/locks prints the device as hex major:minor, and on
    btrfs, zfs and overlayfs a file's st_dev is a synthetic id that will not match it — so requiring
    the device to agree would MISS real holders on exactly the filesystems people run, and missing a
    holder is the dangerous direction. An inode collision with some other flocked file costs a
    refusal, which is the safe one.
    """
    try:
        ino = os.stat(path).st_ino
    except OSError:
        return None, "unknown"
    try:
        with open("/proc/locks") as f:
            lines = f.read().splitlines()
    except OSError:
        return None, "unknown"
    for ln in lines:
        parts = ln.split()
        if len(parts) > 1 and parts[1] == "->":
            continue
        if len(parts) < 6 or parts[1] != "FLOCK":
            continue
        try:
            pid = int(parts[4])
            if int(parts[5].rsplit(":", 1)[-1]) != ino:
                continue
        except ValueError:
            continue
        return (pid if pid > 0 else None), "held"
    return None, "free"


def _state_owner():
    """The user/group this process runs as — what a state file must be owned by to be readable here.
    Derived, never hardcoded: the panel runs as swgpanel on a package install and as root in a container,
    so a fixed name would print the wrong fix on one of them."""
    import pwd, grp
    try:    u = pwd.getpwuid(os.geteuid()).pw_name
    except Exception: u = str(os.geteuid())
    try:    g = grp.getgrgid(os.getegid()).gr_name
    except Exception: g = str(os.getegid())
    return u, g


def load_critical(path, default, valid=None):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default                                                # legitimately absent → fresh install
    except (json.JSONDecodeError, OSError) as e:
        if isinstance(e, OSError) and e.errno in (errno.EMFILE, errno.ENFILE):
            raise RuntimeError(
                "%s could not be opened: %s. This is a DESCRIPTOR exhaustion in the panel, not corrupt "
                "state — the file has not been touched. Restart the panel; if it recurs, the fd watchdog "
                "logs a thread dump naming what is holding them." % (path, e)) from e
        _perm = isinstance(e, PermissionError)
        for b in _state_backups(path):                               # present but corrupt → recover newest good backup
            try:
                with open(b) as f:
                    data = json.load(f)
            except Exception:
                continue
            if valid is not None and not valid(data):                # parses, but is not this file's shape: the next
                continue                                             # older backup is tried
            if _perm:
                log(LOG_ERR, "swg-panel: %s could not be READ (%s) — the file is intact, this process just has no "
                    "access to it. Anything written there by another user has been DISCARDED and %s "
                    "restored in its place. Fix with: chown %s:%s %s && chmod 600 %s", path, e, b, _state_owner()[0], _state_owner()[1], path, path)
            else:
                log(LOG_WARNING, "swg-panel: %s unreadable (%s) — recovered from %s", path, e, b)
            with contextlib.suppress(Exception):
                atomic_write(path, json.dumps(data, indent=2) + "\n", mode=0o600)   # promote back → stop limping
            return data
        raise RuntimeError("critical state %s is corrupt and no good backup exists — refusing to start empty" % path)

def load_settings_critical(path):
    """Panel settings loader with the same backup safety net as the roster/node store — but softer: settings can be
    re-entered, so a corrupt/lost primary recovers the newest good backup and, failing that, falls back to defaults
    ({}) instead of refusing to start. Crucially it ALSO recovers when the primary parsed but is EMPTY {} while a
    backup has real content — i.e. it was clobbered/truncated to nothing (how vk_link + other settings kept vanishing;
    settings had no backup at all before). A genuine {} only arises from a clobber — the settings API always writes a
    populated dict — so preferring a non-empty backup is safe."""
    primary, primary_ok = {}, False
    try:
        with open(path) as f:
            primary = json.load(f); primary_ok = isinstance(primary, dict)
    except FileNotFoundError:
        return {}                                                          # legitimately absent → fresh install
    except (json.JSONDecodeError, OSError):
        primary_ok = False                                                 # corrupt/unreadable
    if primary_ok and primary:
        return primary                                                     # healthy, non-empty
    for b in _state_backups(path):                                         # corrupt OR clobbered-empty → newest good backup
        try:
            with open(b) as f:
                cand = json.load(f)
        except Exception:
            continue
        if isinstance(cand, dict) and cand:
            log(LOG_WARNING, "swg-panel: panel-settings %s — recovered from %s", "corrupt" if not primary_ok else "empty", b)
            with contextlib.suppress(Exception):
                atomic_write(path, json.dumps(cand, indent=2) + "\n", mode=0o600)   # promote back → stop losing it
            return cand
    return primary if primary_ok else {}                                   # nothing to recover → defaults


_DISK_WARN = {"t": 0.0}
def stats_disk_ok(path, min_free_mb=64, min_pct=2):
    try:
        st = os.statvfs(path)
        free = st.f_bavail * st.f_frsize; total = (st.f_blocks * st.f_frsize) or 1
        if free >= min_free_mb * 1048576 and (free * 100 // total) >= min_pct:
            return True
    except OSError:
        return True                                   # can't stat → don't block on a false alarm
    now = time.time()
    if now - _DISK_WARN["t"] > 300:
        _DISK_WARN["t"] = now
        log(LOG_ERR, "swg-panel: stats volume critically low — pausing snapshot/RRD writes (critical state still saved)")
    return False


# roster: users + peers

ROSTER_VERSION = 1
try:
    _KEY_RESTORE_TTL = max(1, int(os.environ.get("SWG_KEY_RESTORE_TTL") or 3600))
except ValueError:
    _KEY_RESTORE_TTL = 3600
STATE_FUTURE = {}     # {"file": …, "found": N, "known": N} when state came from a newer build — surfaced in /api/state


def roster_load(path):
    r = load_critical(path, {})
    if not isinstance(r, dict):
        r = {}
    _v = r.get("version")
    if isinstance(_v, int) and _v > ROSTER_VERSION:
        if not STATE_FUTURE:
            log(LOG_WARNING, "state: %s was written by a NEWER build (roster schema v%d, this panel understands v%d). "
                  "It is being read as-is — every field this build does not know is preserved untouched. If "
                  "anything reads wrong, run the newer version again rather than saving over it.", path, _v, ROSTER_VERSION)
        STATE_FUTURE.clear()
        STATE_FUTURE.update({"file": os.path.basename(path), "found": _v, "known": ROSTER_VERSION})
    r.setdefault("version", ROSTER_VERSION)
    if not isinstance(r.get("users"), dict):
        r["users"] = {}
    if not isinstance(r.get("peers"), dict):
        r["peers"] = {}
    return r


_ROSTER_SAVES = [0]


def roster_mark(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    return (_ROSTER_SAVES[0], st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)


def roster_save(path, roster):
    _ROSTER_SAVES[0] += 1                            # before the write: a parse racing it is never taken for current
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp." + uuid.uuid4().hex[:8]
    with open(tmp, "w") as f:
        os.fchmod(f.fileno(), 0o640)   # group(swg)-readable: the read-only swg-sub user reads the roster, no others
        fcntl.flock(f, fcntl.LOCK_EX)
        json.dump(roster, f, indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)
    with contextlib.suppress(Exception):   # rotating known-good backup — recovered by load_critical if the primary corrupts
        atomic_write(path + ".bak." + str(int(time.time())), json.dumps(roster, indent=2) + "\n", mode=0o600)
        for old in _state_backups(path)[8:]:
            with contextlib.suppress(OSError):
                os.unlink(old)


# audit / activity log (panel host only)

EVENTS_CAP = 1000          # keep at most this many events
EVENTS_TRIM_BYTES = 300_000

def events_path(roster_path):
    return os.path.join(os.path.dirname(roster_path) or ".", "events.jsonl")


def _ev_eid():
    return uuid.uuid4().hex[:10]


def _ev_synth_eid(raw_line):
    """A stable id for a legacy record written before `eid` existed: a content hash, so the
    Activity-history grid can still delete that exact row."""
    return "L" + hashlib.sha1(raw_line.encode()).hexdigest()[:9]


def ev_append(roster_path, kind, ident, verb, name, detail="", detail_key="", detail_vars=None):
    """Record one operator action. kind=user|peer|node|panel, verb is the human action
    ("Created peer"), name is the display label, detail is optional context.

    The VERB is English and stays that way on disk: the browser translates it on display by looking up
    that very sentence, so rows written months ago translate too, with no migration. `kind`/`id` carry the
    routing, so nothing downstream ever matches on the words.

    `detail` is almost always a bare value (a name, a node/iface, a URL) and needs no translation. The two
    that DO carry prose ("2 targets · node/iface") also pass detail_key + detail_vars — the same shape
    perr() uses for errors — and the browser prefers those. Old rows have neither and render `detail`."""
    rec = {"eid": _ev_eid(), "ts": int(time.time()), "kind": kind, "id": ident or "",
           "verb": verb, "name": name or "", "detail": detail or ""}
    if detail_key:
        rec["detail_key"] = detail_key
        # values are strings, EXCEPT a counted noun, which travels as {"n": 3, "noun": "target"} so the
        # browser can decline it — Russian has three plural forms and the server has no business guessing
        rec["detail_vars"] = {k: (v if isinstance(v, dict) else str(v)) for k, v in (detail_vars or {}).items()}
    p = events_path(roster_path)
    try:
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        with open(p, "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.write(json.dumps(rec, separators=(",", ":")) + "\n")
        if os.path.getsize(p) > EVENTS_TRIM_BYTES:        # trim to the last EVENTS_CAP lines
            with open(p) as f:
                lines = f.readlines()
            if len(lines) > EVENTS_CAP:
                tmp = p + ".tmp." + uuid.uuid4().hex[:8]
                with open(tmp, "w") as f:
                    f.writelines(lines[-EVENTS_CAP:])
                os.replace(tmp, p)
    except OSError:
        pass          # the log is best-effort; never fail a mutation because it couldn't be recorded


def _ev_load(roster_path):
    """All events oldest→newest, each guaranteed an `eid` (legacy lines get a content hash)."""
    p = events_path(roster_path)
    out = []
    try:
        with open(p) as f:
            for ln in f:
                s = ln.strip()
                if not s:
                    continue
                try:
                    rec = json.loads(s)
                except Exception:
                    continue
                if not rec.get("eid"):
                    rec["eid"] = _ev_synth_eid(s)
                out.append(rec)
    except OSError:
        pass
    return out


def ev_read(roster_path, limit=12):
    """Return (newest `limit` events newest-first, total count)."""
    recs = _ev_load(roster_path)
    total = len(recs)
    recs.reverse()
    return recs[:max(1, limit)], total


def ev_delete(roster_path, eid):
    """Drop one record by eid (or its synthesized content-hash id). Returns how many were removed."""
    p = events_path(roster_path)
    removed = 0
    try:
        with open(p, "r") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            lines = f.readlines()
            kept = []
            for ln in lines:
                s = ln.strip()
                if not s:
                    continue
                try:
                    rec = json.loads(s)
                except Exception:
                    kept.append(ln if ln.endswith("\n") else ln + "\n")
                    continue
                rid = rec.get("eid") or _ev_synth_eid(s)
                if rid == eid:
                    removed += 1
                    continue
                kept.append(ln if ln.endswith("\n") else ln + "\n")
            tmp = p + ".tmp." + uuid.uuid4().hex[:8]
            with open(tmp, "w") as g:
                g.writelines(kept)
            os.replace(tmp, p)
    except OSError:
        pass
    return removed


def ev_clear(roster_path):
    """Flush the whole activity log."""
    with contextlib.suppress(OSError):
        os.remove(events_path(roster_path))


def gen_id():
    """Short opaque id for users and peers — decoupled from the pubkey so a peer's
    key can rotate in place without losing its identity or history."""
    return uuid.uuid4().hex[:12]


def sanitize_color(v, fallback=None):
    """A themed colour {dark,light} (each #rrggbb). A legacy string is accepted and applied to both modes.
    Returns `fallback` if nothing valid was supplied."""
    hx = lambda s: bool(re.match(r"^#[0-9a-fA-F]{6}$", str(s)))
    if isinstance(v, dict):
        out = {}
        if hx(v.get("dark")):  out["dark"] = str(v["dark"])
        if hx(v.get("light")): out["light"] = str(v["light"])
        if out:
            return out
    if hx(v):
        return {"dark": str(v), "light": str(v)}
    return fallback


def gen_psk():
    """A WireGuard/AmneziaWG preshared key: 32 random bytes, base64 (stdlib only)."""
    return base64.b64encode(os.urandom(32)).decode()


_WDTT_PW_CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789"   # WDTT's own unambiguous alphabet
def gen_wdtt_password():
    """A WDTT WRAP/access password: 16 chars, panel-owned like the PSK. A WDTT peer's `wdtt_password` IS its
    identity (WDTT has no browser keypair — the server mints the WG keypair via GETCONF keyed on this password)."""
    return "".join(secrets.choice(_WDTT_PW_CHARS) for _ in range(16))


_CSQTT_VK_MAX, _CSQTT_VK_MINLEN, _CSQTT_VK_MAXLEN = 6, 16, 1024


def _csqtt_vk_hashes(p, u, fallback_vk=""):
    """Every VK hash this peer's LINK carries, joined the way csqtt stores them.

    Same order and the same cap of 6 as csqttArtifact in turn-artifacts.js — the peer's own hash, then each of
    the user's links, then the panel-wide fallback when the user has none — so the record on the server says
    what the client was actually issued.

    A RECORD, not a credential: csqtt authenticates on the password alone (protocol.rs
    CredentialSet::contains_password) and its dataplane never reads these fields. This keeps csqtt's own web
    panel honest about a client the panel created, and a link regenerated there identical to ours. Validated
    to upstream's rules HERE, because the reconcile in our patch stores what it is handed.
    """
    links = list((u or {}).get("vk_links") or [])
    if not links and (u or {}).get("vk_link"):
        links = [(u or {}).get("vk_link")]
    if not links and fallback_vk:
        links = [fallback_vk]
    out = []
    for raw in [(p or {}).get("vk_hash") or ""] + links:
        h = _wdtt_vk_hash(raw)
        if not h or len(h) < _CSQTT_VK_MINLEN or any(c.isspace() for c in h) or "," in h or h in out:
            continue
        out.append(h)
        if len(out) >= _CSQTT_VK_MAX:
            break
    joined = ",".join(out)
    return joined if len(joined) <= _CSQTT_VK_MAXLEN else ",".join(out[:1])


def _proc_msg(template, **vars):
    """One operator-facing proc_status message, as {err, err_key, err_vars}.

    The panel translates by looking a sentence up as a catalogue key, and a sentence with the interface and
    container names already in it can never match one. So keep the template and its values apart — exactly as
    swg-noded's `_ctr_err` does for the failures. `err` stays the finished English for a browser that cannot
    translate; `err_key` + `err_vars` are what the SPA renders (see procErr / srvVars). A COUNTED value is
    passed as {"n": <count>, "noun": "peer"} so the browser declines it — Russian picks between three forms
    and the rule is not derivable from English.
    """
    plain = {k: ("%d %s(s)" % (v["n"], v["noun"]) if isinstance(v, dict) and "n" in v else v)
             for k, v in vars.items()}
    return {"err": template.format(**plain), "err_key": template, "err_vars": dict(vars)}






def _ctr_key(x):
    return "ctr:%s:%s" % (x.get("container") or "", x.get("name") or "")


_WDTT_VK_MAX = 4


def _wdtt_vk_hashes(p, u, fallback_vk=""):
    """Every VK hash this peer's WDTT link carries, comma-joined the way the client parses it.

    ⚠️ THE SERVER RECORD USED TO CARRY ONE HASH WHILE THE LINK CARRIED SEVERAL. csqtt was fixed for this and
    WDTT was left behind only because nobody had checked whether its client could take a set; it can. Same
    order as _csqtt_vk_hashes and as the artifact builder — the peer's own hash, then the user's links, then
    the panel-wide fallback when the user has none — so the record says what the client was actually issued."""
    links = list((u or {}).get("vk_links") or [])
    if not links and (u or {}).get("vk_link"):
        links = [(u or {}).get("vk_link")]
    if not links and fallback_vk:
        links = [fallback_vk]
    out = []
    for raw in [(p or {}).get("vk_hash") or ""] + links:
        h = _wdtt_vk_hash(raw)
        if not h or len(h) < _CSQTT_VK_MINLEN or any(c.isspace() for c in h) or "," in h or h in out:
            continue
        out.append(h)
        if len(out) >= _WDTT_VK_MAX:
            break
    return ",".join(out)


def _peer_vk_hash(p, u, fallback_vk=""):
    """The ONE VK hash the SERVER is told to authorise for a peer — resolved the way the LINK is built.

    These two had drifted apart. js/peer-ui.js userVkLinks() resolves peer.vk_hash -> user.vk_links[] ->
    the panel-wide fallback, and bakes the result into the config the operator hands out. The server side
    stopped at the user's own link, so a peer relying on the fallback was handed a link carrying a hash the
    server had never heard of: it solves the captcha, allocates a TURN session, computes its key from the
    password — and is refused at the last step, with nothing anywhere naming the reason.

    The array needs no special case here: _norm_vk_links keeps user["vk_link"] synced to vk_links[0], so the
    PRIMARY is already covered. Carrying the rest is a separate change (the desired file ships one hash; the
    server's own store models several) and needs a csqtt build that reads them.
    """
    h = (p.get("vk_hash") or "").strip()
    if h:
        return h
    h = _wdtt_vk_hash((u or {}).get("vk_link") or "")
    return h or _wdtt_vk_hash(fallback_vk or "")


def _wdtt_vk_hash(vk_link):
    """Strip a VK call link to its bare hash (the WDTT `wdtt://…:<vkHash>` credential). Last path segment,
    query dropped — mirrors the WDTT server's stripVkUrl."""
    s = (vk_link or "").strip()
    if "/" in s:
        s = s.rsplit("/", 1)[-1]
    if "?" in s:
        s = s.split("?", 1)[0]
    return s.strip()


def peer_label(roster, p):
    """Best display label for a peer in the activity log: title → owner name → unassigned."""
    if p.get("title"):
        return p["title"]
    uid = p.get("user_id")
    if uid and uid in (roster.get("users") or {}):
        return (roster["users"][uid] or {}).get("name", "") or "unassigned peer"
    return "unassigned peer"


def clean_target(t):
    """Normalise one deployment target: {node, iface, ip, type, primary?, overrides?}. `primary` marks the
    peer's preferred connection (ordered first on the subscription page); at most one target carries it.

    `overrides` is this ONE deployment's client-config customisation (DNS / MTU / AllowedIPs / keepalive).
    It exists because a peer may now span interfaces that need different settings — and, more simply,
    because those settings were never really a property of the peer: they describe how one client reaches
    one interface. The peer-level `overrides` stays as the fallback (and is what every existing peer has),
    so this is additive: a target without its own block renders exactly as before."""
    out = {
        "node": t.get("node", ""),
        "iface": t.get("iface", ""),
        "ip": (t.get("ip", "") or "").split("/")[0],
        "type": t.get("type", "") or "wg",
    }
    _v = t.get("primary")
    _role = _v.strip().lower() if isinstance(_v, str) else ("primary" if _v else "")
    if _role in ("primary", "backup"):
        out["primary"] = _role
    ov = clean_overrides(t.get("overrides"))
    if ov:
        out["overrides"] = ov
    return out


def clean_overrides(raw):
    """Per-peer NON-secret render overrides kept in the roster: a custom DNS / MTU / AllowedIPs /
    keepalive the operator chose for THIS peer, that differs from the interface default. Only the set
    fields are stored — anything absent renders live from the interface defaults, so a fleet-wide
    default change still reaches every peer that never customised. This never holds a secret (the
    private key + PSK live encrypted in the blob); it just lets the panel + swg-sub re-render a
    faithful config without a plaintext copy. Returns {} when nothing is customised."""
    if not isinstance(raw, dict):
        return {}
    ov = {}
    if "dns" in raw and isinstance(raw["dns"], list):     # [] is meaningful: an explicit "no DNS line"
        ov["dns"] = [str(x).strip() for x in raw["dns"][:8] if isinstance(x, str) and str(x).strip() and no_ctrl(str(x))]
    if raw.get("mtu") not in (None, "", 0):
        with contextlib.suppress(Exception):
            ov["mtu"] = max(576, min(9200, int(raw["mtu"])))
    if isinstance(raw.get("allowed"), str) and raw["allowed"].strip() and no_ctrl(raw["allowed"]):
        ov["allowed"] = raw["allowed"].strip()[:512]
    if raw.get("keepalive") not in (None, ""):
        with contextlib.suppress(Exception):
            ov["keepalive"] = max(0, min(65535, int(raw["keepalive"])))
    return ov


def effective_client_params(peer, target, meta):
    """The four non-secret parameters a client config is RENDERED with for ONE deployment of one peer —
    DNS, MTU, AllowedIPs, PersistentKeepalive — resolved in the order the panel actually applies them:

        the interface's live defaults (`meta`)  <  the peer-wide `overrides`  <  THIS target's `overrides`

    The inverse of clean_overrides. That one decides what is worth STORING (only what differs from the
    interface default, so a peer left alone keeps tracking fleet-wide changes); this one puts the defaults
    back. They have to agree, or a peer that stored nothing renders unlike the peer it was copied from.

    THIS IS THE ONE DEFINITION. Two other programs must produce the same four values for the same peer —
    `swg-sub`, which resolves them into the subscription payload, and `js/crypto.js`, which rebuilds the
    panel's own QR from the encrypted blob — and each keeps a copy naming this one as its origin, exactly
    the way swg-sub's node_public_host names node_public_ip. That docstring exists because the copy before
    it was hand-rolled, claimed to mirror, and did not. This trio had the same defect and a worse one:
    js/crypto.js took no target at all, so it could not perform the per-target merge swg-sub does, and a
    peer with a per-target DNS/MTU/AllowedIPs/keepalive rendered one config in the panel and a different
    one on its own subscription page. tests/effective_params_selftest.py runs all three against one table.

    `dns`, `mtu` and `keepalive` fall back to the interface's value; `allowed` falls back to a fixed
    full-tunnel constant, because an interface has no AllowedIPs of its own to inherit — routing is a
    property of the client, not of the server it dials. That last one is the only asymmetry left.
    """
    _pov = peer.get("overrides") if isinstance(peer, dict) and isinstance(peer.get("overrides"), dict) else {}
    _tov = target.get("overrides") if isinstance(target, dict) and isinstance(target.get("overrides"), dict) else {}
    ov = {**_pov, **_tov}                               # the deployment's own setting wins, field by field
    meta = meta if isinstance(meta, dict) else {}
    _ka = ov.get("keepalive")
    _ika = meta.get("keepalive")
    if not (isinstance(_ka, int) and not isinstance(_ka, bool)):          # no per-peer/per-deployment value…
        _ka = _ika if isinstance(_ika, int) and not isinstance(_ika, bool) else 25   # …so the interface's, else 25
    return {
        # dns=[] is meaningful — an explicit "no DNS line" — so the test is "is there a list", not "is it truthy"
        "dns": list(ov["dns"]) if isinstance(ov.get("dns"), list) else list(meta.get("dns") or []),
        "mtu": ov.get("mtu") or meta.get("mtu") or 1280,
        "allowed": ov.get("allowed") or "0.0.0.0/0, ::/0",
        "keepalive": _ka,
    }


def find_peer_by_pubkey(roster, pubkey):
    for p in roster.get("peers", {}).values():
        if isinstance(p, dict) and p.get("pubkey") == pubkey:
            return p
    return None


def valid_addr(s):
    """A bare IP (v4 or v6); a trailing /prefix is tolerated and ignored."""
    try:
        ipaddress.ip_address((s or "").split("/")[0].strip())
        return True
    except ValueError:
        return False


# input hardening
_CTRL_RE = re.compile(r"[\x00-\x1f\x7f]")
def unignore_iface(node_cfg, iface):
    """Drop `iface` from a node's ignore list, removing the key entirely once empty. True if anything changed.

    An ignore entry is only meaningful while the interface is an ADOPTION CANDIDATE. Once it is managed the node
    stops offering it, so the entry can never render again — it just sits in nodes.json forever, and (observed) a
    later convert that hands the interface back as a candidate would resurrect a dismissal the operator made about
    a different situation entirely. Both adopt paths call this; so does the sync pass, for the interfaces that
    became managed WITHOUT going through adopt (a re-install or a convert rebuilding the node's config)."""
    ig = node_cfg.get("ignore_ifaces") or []
    if iface not in ig:
        return False
    ig = [x for x in ig if x != iface]
    if ig: node_cfg["ignore_ifaces"] = ig
    else: node_cfg.pop("ignore_ifaces", None)
    return True


def no_ctrl(s):                                   # no newline/control chars (heredoc + config-line injection)
    return not _CTRL_RE.search(s or "")
def strip_ctrl(s):                                # drop control chars from a cosmetic free-text field (title/name)
    return _CTRL_RE.sub("", s or "")
def bind_ip_ok(v):
    """A turn server's "Listen on" (`bind_ip`): "" (Auto — swg-noded turn_bind decides) or one IPv4 literal. The node
    binds it only if the box carries it, so this checks the shape, not the box."""
    v = str(v or "").strip()
    if not v:
        return True
    try:
        return ipaddress.ip_address(v).version == 4 and v == str(ipaddress.ip_address(v))
    except ValueError:
        return False


def valid_hostport(s):
    """host:port — host an IP or a safe hostname, port 1-65535, no shell metacharacters."""
    if not s or _CTRL_RE.search(s):
        return False
    host, sep, port = s.rpartition(":")
    if not sep or not host or not port.isdigit() or not (1 <= int(port) <= 65535):
        return False
    h = host.strip("[]")
    try:
        ipaddress.ip_address(h)
        return True
    except ValueError:
        return bool(re.match(r"^[A-Za-z0-9._-]+$", h))
_OWNER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$")   # GitHub owner/repo slug
_TURN_SVC_RE = re.compile(r"^vk-turn-proxy-[A-Za-z0-9._-]+-\d{1,5}$")                 # node writes this as a path/unit component
_WDTT_IFACE_RE = re.compile(r"^wdtt[0-9]{1,3}$")                                      # WDTT instance iface (node writes it as a unit/path component)
_WDTT_ADOPT_IFACE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$")
_WDTT_CIDR_RE = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}/\d{1,2}$")                      # WDTT instance subnet (IPv4 CIDR)
def _is_wdtt_target(t):
    """The ONE predicate for 'does this roster target land on a WDTT instance?' — authoritative `type`, with the
    iface-name regex as a fallback for any target written before `type` was set. WDTT owns its own interface and
    key custody, so such a target is never a WG ghost / missing / dangling concern; keep every enumeration site
    keyed off this rather than re-deriving."""
    return (t.get("type") == "wdtt") or bool(_WDTT_IFACE_RE.match(str(t.get("iface") or "")))

_CSQTT_IFACE_RE = re.compile(r"^csqtt[0-9]{1,4}$")   # csqtt instance iface (node writes it as a unit/path component)
_CSQTT_ADOPT_IFACE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,14}$")
def gen_csqtt_password():
    """A csqtt per-peer access password (panel-owned like the PSK; csqtt mints the device keypair keyed on it)."""
    return "".join(secrets.choice(_WDTT_PW_CHARS) for _ in range(16))
def _is_csqtt_target(t):
    """Does this roster target land on a csqtt instance? authoritative `type`, iface-name regex as fallback."""
    return (t.get("type") == "csqtt") or bool(_CSQTT_IFACE_RE.match(str(t.get("iface") or "")))
def _is_self_contained_target(t):
    """Does this roster target land on ANY self-contained turn-family instance (WDTT or csqtt)? Both own their
    interface + key custody, so shared gates (ghost/missing/dangling skips, egress) key off this one predicate."""
    return _is_wdtt_target(t) or _is_csqtt_target(t)

# THE kind authority
def iface_kind(deps, nodes, snaps, node, iface, declared=""):
    """"wg" | "awg" | "wdtt" | "csqtt" for one (node, iface). `declared` is a caller-supplied target `type`
    (the roster writes an authoritative one) and wins when it names a self-contained kind — a target may
    outlive the instance it points at, and a dangling wdtt target must not silently re-read as WireGuard."""
    if declared in ("wdtt", "csqtt"):
        return declared
    n = nodes.get(node) or {}
    if iface in (n.get("wdtt") or {}):            # the panel's own instance map — it created or adopted it
        return "wdtt"
    if iface in (n.get("csqtt") or {}):
        return "csqtt"
    snap = (snaps or {}).get(node) or {}
    if any((w or {}).get("iface") == iface for w in (snap.get("wdtt") or [])):     # the node's live readback
        return "wdtt"
    if any((c or {}).get("iface") == iface for c in (snap.get("csqtt") or [])):
        return "csqtt"
    if ((snap.get("interfaces") or {}).get(iface)):                # a real wg/awg interface the node reports
        return iface_type(snaps, node, iface)
    if _WDTT_IFACE_RE.match(str(iface or "")):                     # last resort: a name only WE would have minted
        return "wdtt"
    if _CSQTT_IFACE_RE.match(str(iface or "")):
        return "csqtt"
    return declared if declared in ("wg", "awg") else iface_type(snaps, node, iface)


def is_keyless_kind(kind):
    """WDTT + csqtt own their interface and mint the client's address (and, for WDTT, its keypair) on connect,
    so such a target carries NO browser keypair and NO client address — the panel-owned password IS the
    credential. ONE predicate so every "does this target need a pubkey / an ip / a client config?" gate agrees."""
    return kind in ("wdtt", "csqtt")


SMART_DNS_PORT = 5354          # the node's Force-DNS dnsmasq listens on 127.0.0.1 here (swg-noded SMART_DNS_PORT)


def node_dns_upstream(raw):
    """A node's Force-DNS upstream from a save body → (list to store, [] = the default; error).

    What the node's dnsmasq asks when it answers Force-DNS clients (docs/DNS-SETTINGS-PLAN.md §4) — until now a
    hardcoded 1.1.1.1 + 8.8.8.8. Up to four entries, each an IPv4/IPv6 address with an optional `#port` (dnsmasq's
    syntax). Refused: unspecified, multicast, and the node's own dnsmasq listener (loopback on SMART_DNS_PORT — it
    would ask itself). Loopback on another port and the node's own addresses stay allowed: a local unbound on
    127.0.0.1#5335, or a resolver on the node's LAN address, is the usual reason to set this at all.
    Twin: swg-noded `_dns_upstream`, which also falls back to the default rather than ever render no upstream."""
    parts = raw if isinstance(raw, list) else re.split(r"[\s,]+", str(raw or ""))
    parts = [str(p).strip() for p in parts if str(p).strip()]
    if len(parts) > 4:
        return None, "Upstream DNS takes at most four addresses."
    out = []
    for item in parts:
        host, sep, port = item.partition("#")
        try:
            a = ipaddress.ip_address(host.strip("[]"))
            pn = int(port) if sep else 53
        except ValueError:
            return None, perr("Upstream DNS: {v1} is not an IP address (optionally with #port).", v1=item)
        if not 1 <= pn <= 65535 or a.is_unspecified or a.is_multicast:
            return None, perr("Upstream DNS: {v1} can't answer DNS queries.", v1=item)
        if a.is_loopback and pn == SMART_DNS_PORT:
            return None, perr("Upstream DNS: {v1} is the node's own Force-DNS resolver — it would ask itself.", v1=item)
        out.append(str(a) + ("#%d" % pn if sep else ""))
    # de-duplicated AFTER normalising, as the node does: "2620:fe::fe" and "2620:fe:0:0:0:0:0:fe" are one resolver,
    # and a stored list that differs from the node's would read as "not on the node yet" for ever
    return list(dict.fromkeys(out)), None


def turn_client_dns(raw, fork, had, orig=None):
    """A WDTT / csqtt instance's client DNS from a save body → (value to store, or None = leave it unset; error).

    The server hands it to each client (WG `DNS =`, RAWCONF, TUNCONF); it never resolves with it. 1–2 IPv4 and
    nothing else: Android's VPN API takes addresses only, and csqtt / wdttplus refuse a third
    (docs/DNS-SETTINGS-PLAN.md §3.2). CLEARING a value that was set stores what the server gave before the panel
    first set one (`orig`), else the fork's default — never nothing: wdttplus and csqtt keep their last saved value
    when no flag comes, so an empty field would leave the panel's old address live while the form said "default"."""
    parts = raw if isinstance(raw, list) else re.split(r"[\s,]+", str(raw or ""))   # the SPA's and adopt's split
    parts = [str(p).strip() for p in parts if str(p).strip()]
    if not parts:
        if not had:
            return None, None
        dflt = ",".join(orig) if isinstance(orig, list) and orig else ((TURN_SERVERS.get(fork) or {}).get("client_dns") or "")
        return ([p for p in dflt.split(",") if p] or None), None
    parts = list(dict.fromkeys(parts))              # a repeat is one resolver, not two
    if len(parts) > 2:
        return None, "Client DNS takes at most two addresses."
    for p in parts:
        if not turn_dns_usable(p):
            return None, perr("Client DNS must be IPv4 addresses — {v1} is not one a phone can use.", v1=p)
    return parts, None


def apply_turn_client_dns(inst, body, fork, rep=None):
    """The one `dns` step both /api/wdtt/set and /api/csqtt/set take: only when the body names it. Returns an error
    payload for a 400, or None. `rep` = the node's report of this instance. The FIRST time the panel sets a DNS on
    a server that remembers its own (`dns_server`: csqtt, wdttplus), that value is kept as `dns_orig`, because
    setting ours overwrites it in the server's store — and clearing then restores it rather than the catalog
    default, so clearing never changes what clients get."""
    if "dns" not in body:
        return None
    if not inst.get("dns") and "dns_orig" not in inst:
        own, _e = turn_client_dns((rep or {}).get("dns_server"), fork, False)
        if own:
            inst["dns_orig"] = own
    val, err = turn_client_dns(body.get("dns"), fork, bool(inst.get("dns")), inst.get("dns_orig"))
    if err:
        return err if isinstance(err, dict) else {"error": err}
    if val:
        inst["dns"] = val
    else:
        inst.pop("dns", None)
    return None


def turn_dns_usable(p):
    """One address a phone can use as its resolver: canonical IPv4, not unspecified / loopback / link-local /
    multicast / reserved (which includes 255.255.255.255). A fork that parses it stricter than we do would refuse
    to START (csqtt, xxcipherx), so the doubtful ones are refused here. Twin: swg-noded `_turn_dns`, js `turnDnsErr`."""
    try:
        a = ipaddress.ip_address(p)
    except ValueError:
        return False
    return (a.version == 4 and str(a) == p and not a.is_unspecified and not a.is_loopback
            and not a.is_link_local and not a.is_multicast and not a.is_reserved and not p.startswith("0."))

def turn_iface_name_error(deps, nodes, snaps, nid, iface, kind):
    """Why this name can't be a NEW self-contained instance on this node, or None.

    Creation used to be gated to `wdtt0..wdtt999` / `csqtt0..csqtt9999`. That pattern was never the node's
    requirement (it accepts any safe path component — which is why ADOPTION already takes foreign names as
    found); it was standing in for the checks below, plus "the name alone tells you the kind". The panel no
    longer infers kind from the name (see iface_kind), so the pattern bought nothing but a refusal to name
    your own servers. These are the constraints that were actually load-bearing."""
    if not _WDTT_ADOPT_IFACE_RE.match(iface or ""):     # the node builds a unit name + a directory from it
        return "invalid interface name (letters, digits, - and _; max 15, must start alphanumeric)"
    if is_system_iface(deps, nodes, nid, iface):
        return f"{iface} is a system mesh link"
    n = nodes.get(nid) or {}
    other = "csqtt" if kind == "wdtt" else "wdtt"
    if iface in (n.get(other) or {}):
        return f"{iface} is already a {other.upper()} instance on this node"
    if iface in (n.get(kind) or {}):
        return None                                     # editing an instance we already manage — always allowed
    if ((snaps.get(nid) or {}).get("interfaces") or {}).get(iface):
        return f"{iface} is already a WireGuard interface on this node"
    rc = reserved_conflict(deps, nodes, n, name=iface)   # takes the node RECORD, not its id
    if rc:
        return rc
    return None


def mint_keyless_secrets(targets, existing):
    """The access passwords a target set CALLS FOR, minted only where the peer has none yet.

    One password per keyless KIND, not per target: a peer deployed to wdtt1 AND wdtt2 presents the same
    WDTT password to both (that is what makes them failover alternatives of one identity), and the same
    peer's csqtt deployments share a second, independent one. Idempotent by design — this runs on create
    AND on every path that can ADD a target later, and re-minting there would silently revoke the links
    already in the operator's hands. Returns only the fields to write; {} when nothing new is needed."""
    kinds = {t.get("type") for t in targets if is_keyless_kind(t.get("type"))}
    out = {}
    if "wdtt" in kinds and not (existing or {}).get("wdtt_password"):
        out["wdtt_password"] = gen_wdtt_password()
    if "csqtt" in kinds and not (existing or {}).get("csqtt_password"):
        out["csqtt_password"] = gen_csqtt_password()
    return out


def _wdtt_net(cidr):
    """A WDTT instance's wg_addr (e.g. 10.66.73.1/24) → its network (10.66.73.0/24) — the source subnet that the
    datapath rules (smart routing / block DROP) match with `ip saddr <net>`. "" if the CIDR is unparseable."""
    try:
        return str(ipaddress.ip_network(cidr, strict=False))
    except Exception:
        return ""
_WANIF_RE = re.compile(r"^[A-Za-z0-9._-]{1,15}$")                                     # Linux NIC name (IFNAMSIZ 16); blocks ; ` $ | & etc.
_VK_CALL_RE = re.compile(r"^https://(?:[\w.-]+\.)?vk(?:ontakte)?\.(?:com|ru)/call/join/[\w-]+/?(?:\?\S*)?$", re.I)   # a VK call-room link


def bad_targets(targets):
    """First validation error across a target list, or None. Defence-in-depth behind the UI."""
    for t in targets:
        if not valid_addr(t.get("ip", "")):
            return f"invalid address {t.get('ip')!r} for {t.get('node')}/{t.get('iface')}"
    return None


def iface_type(snaps, node, iface):
    """wg vs awg, read from the node's pushed snapshot: the TOOL it runs, and only failing that the old
    inference "it carries obfuscation params". The two can disagree — a plain-WG conf that picked up S/H/I
    lines (see op_set_iface's gate) read as AmneziaWG for a device `awg show` cannot even see."""
    blk = ((snaps.get(node) or {}).get("interfaces") or {}).get(iface) or {}
    meta = blk.get("meta") or {}
    if meta.get("tool") in ("wg", "awg"):
        return meta["tool"]
    return "awg" if meta.get("awg_params") else "wg"


def del_config(store_configs, config_dir, pubkey, node, iface):
    if config_dir:
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(config_dir, cfg_hash(pubkey, node, iface)))


def resolve_store_mode(panel_settings, fleet):
    """Resolve how the panel keeps client configs at rest, as an enum:
      "encrypted" — new peers store an AES-GCM blob the server can't read (the vault gates decrypt). Default.
      "off"       — nothing kept; a peer's QR is shown once at creation.
    Compat: the legacy boolean (panel_settings/fleet) maps True→"encrypted" (its plaintext is migrated by the
    browser ceremony) and False→"off". A fresh install with no setting defaults to "encrypted"."""
    v = (panel_settings or {}).get("store_configs")
    if v is None:
        v = (fleet or {}).get("store_configs")      # legacy fleet.json default (absent → new-install default)
    if v is True or v == "encrypted":
        return "encrypted"
    if v is False or v == "off":
        return "off"
    return "encrypted"


def count_plaintext_configs(config_dir):
    """How many LEGACY plaintext client configs are on disk — drives the migration prompt + the encrypted-store
    'still have plaintext' banner. Config files are sha256-named (64 hex chars), so match only those."""
    if not config_dir:
        return 0
    n = 0
    with contextlib.suppress(OSError):
        for fn in os.listdir(config_dir):
            if re.fullmatch(r"[0-9a-f]{64}\.conf", fn):   # cfg_hash() = sha256(...).hexdigest() + ".conf"
                n += 1
    return n


_VK_HASH_RE = re.compile(r"[A-Za-z0-9_-]{%d,}" % _CSQTT_VK_MINLEN)


VK_JOIN_URL = "https://vk.ru/call/join/"


def _vk_link_norm(s):
    """A bare call hash → its link; anything else as it came (stripped)."""
    s = str(s or "").strip()
    return VK_JOIN_URL + s if _VK_HASH_RE.fullmatch(s) else s


def _norm_vk_links(fields, u):
    """The user's VK call links as an ordered list — index 0 is the PRIMARY. `vk_link` (legacy single field) is
    kept in sync = the primary, so every existing reader keeps working. Migrates an old single vk_link into the
    list on first touch. A `vk_link` field in the update makes that URL the primary (moved to the front)."""
    prev = u.get("vk_links")
    if not isinstance(prev, list):
        prev = [u["vk_link"]] if u.get("vk_link") else []            # migrate the legacy single link
    links = fields.get("vk_links", prev)
    if not isinstance(links, list):
        links = []
    links = [s for s in (_vk_link_norm(x)[:512] for x in links) if s][:16]   # cleaned (a bare hash → its link), non-empty, capped
    seen = set(); links = [x for x in links if not (x in seen or seen.add(x))]   # dedupe, keep order
    if "vk_link" in fields:                                          # legacy single-field save → make it the primary
        vk = _vk_link_norm(fields.get("vk_link"))[:512]
        links = ([vk] + [x for x in links if x != vk]) if vk else links
    return links, (links[0] if links else "")

def coerce_expiry(v):
    """Parse an API expiry value into epoch seconds (int). Returns None for garbage (caller rejects);
    0 for an empty/absent value (= no expiry / clear). Expiry mirrors the block flag but with an
    effective DATE — an expired peer/user is dropped from every node's desired set, just like a block."""
    if v is None or v == "":
        return 0
    try:
        n = int(v)
    except (TypeError, ValueError):
        return None
    return n if n > 0 else 0


def is_expired(rec, nowv):
    """True if rec (a user or a peer) carries an expiry date that has already passed. 0/absent = never expires."""
    exp = (rec or {}).get("expiry") or 0
    return bool(exp) and nowv >= int(exp)


def access_cut(p, u, nowv):
    """True if peer `p` (owned by user `u`) may not connect: it is blocked, its owner is, or either one has expired.
    One predicate for BOTH halves of enforcement — desired_for_node leaves such a peer out, cut_off_for_node asks the
    node to drop it — so the two can never disagree about who is cut off."""
    return bool(p.get("disabled") or u.get("disabled") or is_expired(p, nowv) or is_expired(u, nowv))


def fmt_day(epoch):
    """An expiry epoch as a plain YYYY-MM-DD (server-local) — only for human-readable API error messages."""
    try:
        return time.strftime("%Y-%m-%d", time.localtime(int(epoch)))
    except Exception:
        return "?"


def user_set(roster, uid, fields, now):
    u = roster["users"].get(uid) or {}
    vk_links, vk_link = _norm_vk_links(fields, u)
    roster["users"][uid] = {
        "id": uid,
        "name": fields.get("name", u.get("name", "")),
        "tag": fields.get("tag", u.get("tag", "")),
        "note": fields.get("note", u.get("note", "")),
        "vk_link": vk_link,       # the PRIMARY VK call link (single-link forks + the panel-wide fallback use this)
        "vk_links": vk_links,     # all of the user's VK call links, ordered (primary first) — freeturn passes them all
        "expiry": int(fields.get("expiry", u.get("expiry", 0)) or 0),   # epoch secs; 0 = no expiry. Subscription-wide.
        "created_at": u.get("created_at", now),
        "modified_at": now,
    }
    for k in ("disabled", "disabled_at", "unblock_at"):
        if u.get(k):
            roster["users"][uid][k] = u[k]
    static_exit = static_exit_ref(fields.get("static_exit", u.get("static_exit")))
    if static_exit:
        roster["users"][uid]["static_exit"] = {"node_id": static_exit[0], "exit_id": static_exit[1]}
    return roster["users"][uid]


GROUP_NAME_MAX = 64


def roster_groups(roster):
    """The roster's `groups` map for READING (docs/GROUPS-PLAN.md G1) — `{}` when absent or not a map. A writer goes through
    `group_set`, which creates the key."""
    g = (roster or {}).get("groups")
    return g if isinstance(g, dict) else {}


def group_name_clean(roster, raw, gid=None):
    """(name, refusal or None) for a group name (docs/GROUPS-PLAN.md G2): control characters stripped, 1–64 characters,
    and unique case-insensitively — two "Family" groups make the person-and-group picker a guess. The refusal is a
    `perr()` dict for the reply, so the sentence is one the browser can translate."""
    name = strip_ctrl(str(raw or "")).strip()[:GROUP_NAME_MAX]
    if not name:
        return "", perr("name is required")
    if group_name_taken(roster, name, gid):
        return "", perr("a group with this name already exists")
    return name, None


def group_name_taken(roster, name, gid=None):
    """Does a group other than `gid` already carry `name`, ignoring case?"""
    return any(ogid != gid and isinstance(g, dict) and str(g.get("name") or "").casefold() == name.casefold()
               for ogid, g in roster_groups(roster).items())


def group_set(roster, gid, fields):
    """One group's record, `{name, users}` (docs/GROUPS-PLAN.md G1). ⚠️ A WHITELIST REBUILD like `user_set`: a field not
    passed is carried from the stored record. `users` sorted and unique, so a save that changes nothing changes no bytes."""
    if not isinstance(roster.get("groups"), dict):
        roster["groups"] = {}
    g = roster["groups"].get(gid) if isinstance(roster["groups"].get(gid), dict) else {}
    rec = {"name": fields.get("name", g.get("name") or ""),
           "users": sorted({u for u in fields.get("users", g.get("users") or []) if isinstance(u, str)})}
    roster["groups"][gid] = rec
    return rec


def peer_set(roster, pid, fields, now):
    p = roster["peers"].get(pid) or {}
    targets = fields.get("targets", p.get("targets", []))
    # overrides: re-clean only when the caller passes them explicitly; otherwise PRESERVE whatever's
    # stored (so add-target / update-target / rekey never drop a peer's custom DNS/MTU/AllowedIPs).
    ov = clean_overrides(fields["overrides"]) if "overrides" in fields else (p.get("overrides") or {})
    rec = {
        "id": pid,
        "user_id": fields.get("user_id", p.get("user_id")),   # None => unassigned
        "title": (fields.get("title", p.get("title", "")) or "")[:64],   # operator label to tell devices apart
        "pubkey": fields.get("pubkey", p.get("pubkey", "")),
        "psk": fields.get("psk", p.get("psk", "")),
        "targets": [clean_target(t) for t in targets],   # roles are per-deployment labels — no exclusivity to enforce
        "created_at": p.get("created_at", now),
        "modified_at": now,
    }
    if ov:                                                    # keep the roster tidy: no override key on a default peer
        rec["overrides"] = ov
    for k in ("disabled", "disabled_at", "unblock_at", "expiry", "wdtt_password", "csqtt_password", "vk_hash", "sub_hide",
              "routes", "share", "private", "router", "p2p_port"):
        v = fields.get(k, p.get(k))
        if v:
            rec[k] = v
    if "p2p_port" not in rec and p2p_port_wanted(rec):       # a WDTT / csqtt-only device takes none; one held is kept
        _free = p2p_port_take(roster, pid)
        if _free:                                             # pool full: no port, nothing forwarded for it
            rec["p2p_port"] = _free
    roster["peers"][pid] = rec
    return rec


SUB_SOURCES = ("wg", "awg", "wdtt", "csqtt", "turn")

def peer_sub_sources(peer, snaps):
    """Every source this peer actually offers, in SUB_SOURCES order — the set a hide list is validated against.

    A wg/awg deployment offers its own kind, plus "turn" when a proxy on that node forwards to its listen port
    (the same test the subscription and the admin turn view use). A self-contained deployment offers its kind."""
    out = []
    for t in (peer or {}).get("targets") or []:
        ty = (t or {}).get("type") or "wg"
        if ty not in out:
            out.append(ty)
        if ty in ("wdtt", "csqtt") or "turn" in out:
            continue
        snap = (snaps or {}).get(t.get("node")) or {}
        lp = (((snap.get("interfaces") or {}).get(t.get("iface")) or {}).get("meta") or {}).get("listen_port")
        if lp and any(_port_of(tp.get("connect")) == str(lp) for tp in (snap.get("turn_proxies") or []) if isinstance(tp, dict)):
            out.append("turn")
    return [s for s in SUB_SOURCES if s in out]


def clean_sub_hide(raw, peer, snaps):
    """Normalise a hide list: known sources only, and never every source the peer has — a peer with nothing left
    to publish would vanish from its own subscription with no way to tell why from the sub page."""
    hide = [s for s in SUB_SOURCES if s in set(raw or [])]
    have = peer_sub_sources(peer, snaps)
    if have and all(s in hide for s in have):
        return None
    return hide


def unassign_peer(p, store_configs, config_dir, now):
    """Detach a peer from its user AND revoke the old holder's access.

    The PSK is panel-owned and mixed into every WireGuard handshake, so rotating it
    here makes the config already on the previous owner's device fail on the node's
    next sync — instant revocation with no client in the loop. The keypair is left
    intact (re-keying needs the browser, where the private key lives); the peer is
    parked, present on its nodes but unusable until it's re-issued to someone.
    """
    p["user_id"] = None
    p["psk"] = gen_psk()
    if p.get("wdtt_password"):
        p["wdtt_password"] = gen_wdtt_password()   # WDTT peer has no keypair — rotate its WRAP password so the old link dies
    if p.get("csqtt_password"):
        p["csqtt_password"] = gen_csqtt_password()
    p["modified_at"] = now
    for t in p.get("targets", []):
        if p.get("pubkey"):                        # WG only; a keyless WDTT peer has no stored .conf
            del_config(store_configs, config_dir, p.get("pubkey", ""), t["node"], t["iface"])


def retire_pubkey(nodes, nodes_path, targets, old_pubkey):
    """Queue a pubkey for EXPLICIT removal on each target's node/iface. The node drops it even on an
    add-only (onboarded) interface — so a key the panel rotated/deleted is removed, while genuine
    external orphans (keys the panel never owned) are still left alone. Cleared once the node stops
    reporting the key (in _node_sync)."""
    if not old_pubkey:
        return
    changed = False
    for t in targets or []:
        nid = t.get("node"); iface = t.get("iface")
        if not nid or not iface or nid not in nodes:
            continue
        lst = nodes[nid].setdefault("retire", {}).setdefault(iface, [])
        if old_pubkey not in lst:
            lst.append(old_pubkey); changed = True
    if changed:
        with contextlib.suppress(Exception):
            nodes_save(nodes_path, nodes)


