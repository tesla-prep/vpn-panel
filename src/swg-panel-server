_ROSTER_SAVES = [0]


def roster_mark(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    return (_ROSTER_SAVES[0], st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)


def roster_save(path, roster):
    _ROSTER_SAVES[0] += 1
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp." + uuid.uuid4().hex[:8]
    with open(tmp, "w") as f:
        os.fchmod(f.fileno(), 0o640)
        fcntl.flock(f, fcntl.LOCK_EX)
        json.dump(roster, f, indent=2); f.write("\n"); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)
    with contextlib.suppress(Exception):
        atomic_write(path + ".bak." + str(int(time.time())), json.dumps(roster, indent=2) + "\n", mode=0o600)
        for old in _state_backups(path)[8:]:
            with contextlib.suppress(OSError):
                os.unlink(old)



EVENTS_CAP = 1000
EVENTS_TRIM_BYTES = 300_000

def events_path(roster_path):
    return os.path.join(os.path.dirname(roster_path) or ".", "events.jsonl")


def _ev_eid():
    return uuid.uuid4().hex[:10]


def _ev_synth_eid(raw_line):
    return "L" + hashlib.sha1(raw_line.encode()).hexdigest()[:9]


def ev_append(roster_path, kind, ident, verb, name, detail="", detail_key="", detail_vars=None):
    rec = {"eid": _ev_eid(), "ts": int(time.time()), "kind": kind, "id": ident or "",
           "verb": verb, "name": name or "", "detail": detail or ""}
    if detail_key:
        rec["detail_key"] = detail_key
        rec["detail_vars"] = {k: (v if isinstance(v, dict) else str(v)) for k, v in (detail_vars or {}).items()}
    p = events_path(roster_path)
    try:
        os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
        with open(p, "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.write(json.dumps(rec, separators=(",", ":")) + "\n")
        if os.path.getsize(p) > EVENTS_TRIM_BYTES:
            with open(p) as f:
                lines = f.readlines()
            if len(lines) > EVENTS_CAP:
                tmp = p + ".tmp." + uuid.uuid4().hex[:8]
                with open(tmp, "w") as f:
                    f.writelines(lines[-EVENTS_CAP:])
                os.replace(tmp, p)
    except OSError:
        pass


def _ev_load(roster_path):
    p = events_path(roster_path)
    out = []
    try:
        with open(p) as f:
            for ln in f:
                s = ln.strip()
                if not s:
                    continue
                try:
                    rec = json.loads(s)
                except Exception:
                    continue
                if not rec.get("eid"):
                    rec["eid"] = _ev_synth_eid(s)
                out.append(rec)
    except OSError:
        pass
    return out


def ev_read(roster_path, limit=12):
    recs = _ev_load(roster_path)
    total = len(recs)
    recs.reverse()
    return recs[:max(1, limit)], total


def ev_delete(roster_path, eid):
    p = events_path(roster_path)
    removed = 0
    try:
        with open(p, "r") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            lines = f.readlines()
            kept = []
            for ln in lines:
                s = ln.strip()
                if not s:
                    continue
                try:
                    rec = json.loads(s)
                except Exception:
                    kept.append(ln if ln.endswith("\n") else ln + "\n")
                    continue
                rid = rec.get("eid") or _ev_synth_eid(s)
                if rid == eid:
                    removed += 1
                    continue
                kept.append(ln if ln.endswith("\n") else ln + "\n")
            tmp = p + ".tmp." + uuid.uuid4().hex[:8]
            with open(tmp, "w") as g:
                g.writelines(kept)
            os.replace(tmp, p)
    except OSError:
        pass
    return removed


