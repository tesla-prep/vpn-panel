def _client_base_values(cid):
    vs, out = _client_value_sources(cid), {}
    for s in (_client_schema(cid) or []):
        k = s.get("key")
        if k in vs and s.get("type") == "enum" and isinstance(s.get("values"), list):
            out[k] = sorted(set(_strip_sentinels(s["values"])))
    return out

def _turn_value_classify(active_vals, inv_values, passthrough):
    out, keys = [], set(active_vals or {}) | set(inv_values or {})
    for k in sorted(keys):
        av, iv = set(_strip_sentinels((active_vals or {}).get(k))), set(_strip_sentinels((inv_values or {}).get(k)))
        added, removed = sorted(iv - av), sorted(av - iv)
        if added or removed:
            out.append({"field": k, "added": added, "removed": removed, "adoptable_add": k in (passthrough or set())})
    return out

def _p4_pick_snapshot(rec):
    snaps = (rec or {}).get("snapshots") or []
    if not snaps:
        return None
    pin = (rec or {}).get("pinned_snapshot")
    if isinstance(pin, int) and 0 <= pin < len(snaps):
        return snaps[pin]
    return snaps[-1]

def _turn_client_p4_report(cid, rec):
    snap = _p4_pick_snapshot(rec)
    if snap is None:
        return None
    inv = set(_filter_inventory(cid, snap.get("fields") or []))
    if rec.get("active") is None:
        rec["active"] = _turn_seed_active(cid, inv)
    cls = _turn_field_classify(rec.get("active") or [], inv, _client_wireable(cid))
    if rec.get("active_vals") is None:
        rec["active_vals"] = _client_base_values(cid)
    vdiff = _turn_value_classify(rec.get("active_vals") or {}, snap.get("values") or {}, _client_value_passthrough(cid))
    y = sum(len(v["added"]) for v in vdiff if v["adoptable_add"])
    z = sum(len(v["removed"]) for v in vdiff)
    xtra = sum(len(v["added"]) for v in vdiff if not v["adoptable_add"])
    return {**cls, "value_diff": vdiff,
            "counts": {"n": len(cls["added"]), "x": len(cls["needs_wiring"]) + xtra, "m": len(cls["removed"]), "y": y, "z": z},
            "app_version": snap.get("app_version"), "snapshot_at": snap.get("at")}

def _gh_latest_release(owner, repo):
    key = "rel:%s/%s" % (owner, repo)
    ent = _GH_COMMIT_CACHE.get(key)
    if ent and time.time() - ent["at"] < 3600:
        return ent["res"]
    res = None
    with contextlib.suppress(Exception):
        data = _gh_api("/repos/%s/%s/releases?per_page=1" % (quote(owner), quote(repo)))
        if isinstance(data, list) and data and isinstance(data[0], dict) and data[0].get("tag_name"):
            res = _gh_release_rec(data[0])
    _GH_COMMIT_CACHE[key] = {"res": res, "at": time.time()}
    return res

def _gh_api(path):
    hdr = {"User-Agent": "swg-panel", "Accept": "application/vnd.github+json"}
    tok = os.environ.get("SWG_GH_TOKEN", "").strip()
    if tok:
        hdr["Authorization"] = "Bearer " + tok
    with urllib.request.urlopen(urllib.request.Request("https://api.github.com" + path, headers=hdr), timeout=10) as r:
        return json.loads(r.read().decode("utf-8", "replace"))

def _gh_release_rec(x):
    return {"tag": x.get("tag_name"), "date": x.get("published_at"), "html_url": x.get("html_url"),
            "assets": [{"name": a.get("name"), "url": a.get("browser_download_url")}
                       for a in (x.get("assets") or []) if isinstance(a, dict) and a.get("browser_download_url")]}

_OS_ASSET_FORMATS = {
    "android": [r"\.apk$", r"\bclient-android-[^/]*$", r"[-_]android[-_.]"],
    "windows": [r"(?:setup|installer)[^/]*\.exe$", r"\.msi$", r"\bclient-windows-[^/]*\.exe$", r"\.exe$", r"win(?:dows|64|32)?[-_.][^/]*\.zip$", r"[-_]win(?:dows)?[-_.]"],
    "linux":   [r"\.appimage$", r"\.deb$", r"\.rpm$", r"\bclient-linux-[^/]*$", r"\.pkg\.tar\.[a-z]+$", r"\.tar(?:\.(?:gz|xz|zst))?$", r"[-_]linux[-_.]"],
    "macos":   [r"\.dmg$", r"\.pkg$", r"\bclient-darwin-[^/]*$", r"[-_](?:mac(?:os)?|darwin)[-_.]", r"\.app\.zip$"],
}
_OS_ARCH_PREF = {
    "android": [r"universal", r"arm64[-_]?v8a", r"arm64|aarch64", r"armeabi[-_]?v7a|armv7"],
    "windows": [r"x86[_-]?64|amd64|x64|win64", r"universal"],
    "linux":   [r"x86[_-]?64|amd64|x64", r"universal"],
    "macos":   [r"arm64|aarch64|apple", r"x86[_-]?64|amd64|x64|intel", r"universal"],
}
_PLATFORM_ASSET = {}
_RELEASE_INFO = {}

def _match_os_asset(assets, oskind):
    names = [(a.get("name") or "", a.get("url")) for a in (assets or []) if a.get("url")]
    names = [(n, u) for (n, u) in names if not re.match(r'server[-_]', n, re.I) and not re.search(r'tokenfetcher', n, re.I)]
    fmts = _OS_ASSET_FORMATS.get(oskind)
    if not fmts or not names:
        return None
    archp = _OS_ARCH_PREF.get(oskind, [])
    for fmt in fmts:
        cands = [(n, u) for (n, u) in names if re.search(fmt, n, re.I)]
        if not cands:
            continue
        for arch in archp:
            for (n, u) in cands:
                if re.search(arch, n, re.I):
                    return u
        return cands[0][1]
    return None

def _gh_owner_repo(url):
    m = re.match(r'https?://github\.com/([^/]+)/([^/#?]+)', url or "")
    return (m.group(1), m.group(2)) if m else (None, None)

def _turn_warm_assets():
    resolved = 0
    for _cat in (TURN_CLIENTS, WG_APPS):
      for cid, c in _cat.items():
        if cid in TURN_GONE_CLIENTS:
            continue
        for oskind, links in (c.get("platforms") or {}).items():
            owner, repo = _gh_owner_repo((links or {}).get("github"))
            if not owner:
                continue
            try:
                rel = _hosted_latest(owner, repo) or _gh_latest_release(owner, repo)
            except Exception:
                rel = None
            if not rel:
                continue
            assets = [{"name": a.get("name"), "url": a.get("url")} for a in (rel.get("assets") or []) if a.get("url")]
            _RELEASE_INFO[(owner, repo)] = {"tag": rel.get("tag"), "page": rel.get("html_url"), "assets": assets}
            resolved += 1
            u = _match_os_asset(assets, oskind)
            if u:
                _PLATFORM_ASSET[(owner, repo, oskind)] = u
    return resolved

_RELEASE_PIN = {}
_PIN_WANTED = {}
_PIN_TRIED = {}
_PIN_SEEN = {}
_PIN_KEEP = 3600
_PIN_TAG_OVERRIDE = {("ildarmaga", "1.5.40"): "v1.5.0", ("ildarmaga", "1.5.40-2"): "v1.5.0"}
_PIN_SOURCE_LINES = {"csqtt": {"2.1": "csqtt-app-2.1.9", "2.5": "csqtt-app-2.5.1+"}}
_HOSTED_TAG_TTL = 3600
_HOSTED_TAG_SETTLE = 600
def _hosted_tag(spec):
    m = re.fullmatch(r"(.*)\.(\d+)\+", spec)
    if not m:
        return spec
    prefix, floor = m.group(1), int(m.group(2))
    ck = "hosted:" + spec
    ent = _GH_COMMIT_CACHE.get(ck)
    if ent and time.time() - ent["at"] < _HOSTED_TAG_TTL:
        return ent["res"]
    tag_re = re.compile(re.escape(prefix) + r"\.(\d+)(?:-(\d+))?")
    def rank(t):
        tm = tag_re.fullmatch(str(t or ""))
        return tm and int(tm.group(1)) >= floor and (int(tm.group(1)), int(tm.group(2) or 0))
    rels, best = None, None
    with contextlib.suppress(Exception):
        rels = _gh_api("/repos/%s/releases?per_page=100" % WDTT_BUILD_REPO)
    for x in rels if isinstance(rels, list) else ():
        t = isinstance(x, dict) and not x.get("prerelease") and not x.get("draft") and str(x.get("tag_name") or "")
        rk = t and rank(t)
        assets = x.get("assets") if rk else None
        if rk and isinstance(assets, list) and any(isinstance(a, dict) and re.search(r"\.apk$", str(a.get("name") or ""), re.I)
                                                   for a in assets) and _released_since(x.get("published_at")) >= _HOSTED_TAG_SETTLE:
            if best is None or rk > best[0]:
                best = (rk, t)
    if best:
        _GH_COMMIT_CACHE[ck] = {"res": best[1], "at": time.time()}
        return best[1]
    if ent:
        res = ent["res"]
    else:
        known = [t for x in list(_RELEASE_PIN.values()) + list(_RELEASE_INFO.values())
                 for t in (str(x.get("page") or "").rpartition("/")[2],) if rank(t)]
        res = max(known, key=rank) if known else "%s.%d" % (prefix, floor)
    _GH_COMMIT_CACHE[ck] = {"res": res, "at": time.time() - (0 if isinstance(rels, list) else _HOSTED_TAG_TTL - 300)}
    return res
def _released_since(published_at):
    with contextlib.suppress(Exception):
        return time.time() - _live_cal.timegm(time.strptime(published_at, "%Y-%m-%dT%H:%M:%SZ"))
    return float("inf")
def _pin_source(owner, repo, version):
    for fork, lines in _PIN_SOURCE_LINES.items():
        if turn_fork_owner(fork) == owner + "/" + repo:
            for line, tag in lines.items():
                if str(version).startswith(line + ".") and any(b == version for b, _ in CSQTT_LINES.get(line) or ()):
                    return tuple(WDTT_BUILD_REPO.split("/", 1)) + (_hosted_tag(tag),)
    return None
def _hosted_latest(owner, repo):
    for fork, lines in _PIN_SOURCE_LINES.items():
        if turn_fork_owner(fork) == owner + "/" + repo and lines:
            tag = _hosted_tag(lines[max(lines, key=lambda l: tuple(int(x) for x in l.split(".")))])
            o, r = WDTT_BUILD_REPO.split("/", 1)
            try:
                rec = _pin_lookup(o, r, [tag], asset_re=r"\.apk$")
            except Exception:
                rec = None
            return {"tag": _hosted_app_ver(tag), "html_url": rec["page"], "assets": rec["assets"]} if rec and rec["assets"] else None
    return None
def _hosted_app_ver(tag):
    return "v" + re.sub(r"^.*?-app-", "", tag)

def _pin_tags(version):
    v = str(version or "").strip()
    out = []
    for x in (v, re.sub(r"-\d+$", "", v)):
        for t in ((x,) if x.startswith("v") else ("v" + x, x)):
            if x and t not in out:
                out.append(t)
    return out

def _pin_wanted(deps):
    app_repos = {_gh_owner_repo((links or {}).get("github")) for c in TURN_CLIENTS.values()
                 for links in (c.get("platforms") or {}).values()}
    out = {}
    for fork, _kind, _nid, _ifc, ver in _turn_deployed(deps):
        orp = tuple(turn_fork_owner(str(fork).partition("@")[0]).split("/", 1))
        if ver and orp in app_repos:
            out.setdefault(orp, set()).add(str(ver))
    return out

def _pin_lookup(owner, repo, tags, asset_re=None):
    for t in tags:
        try:
            x = _gh_api("/repos/%s/%s/releases/tags/%s" % (quote(owner), quote(repo), quote(t, safe="")))
        except urllib.error.HTTPError as e:
            if e.code == 404:
                continue
            raise
        if isinstance(x, dict) and x.get("tag_name"):
            rec = _gh_release_rec(x)
            if asset_re:
                rec["assets"] = [a for a in rec["assets"] if re.search(asset_re, a.get("name") or "", re.I)]
            return {"tag": rec["tag"], "page": rec["html_url"], "assets": rec["assets"],
                    "url": {o: u for o in _OS_ASSET_FORMATS for u in (_match_os_asset(rec["assets"], o),) if u}}
    return None

def _turn_warm_pins(deps, refresh=False):
    global _PIN_WANTED
    seen = time.monotonic()
    for (o, r), vers in _pin_wanted(deps).items():
        for v in vers:
            _PIN_SEEN[(o, r, v)] = seen
    for k in [k for k, t in _PIN_SEEN.items() if seen - t >= _PIN_KEEP]:
        _PIN_SEEN.pop(k, None)
    wanted = {}
    for o, r, v in _PIN_SEEN:
        wanted.setdefault((o, r), set()).add(v)
    gone = [k for k in _RELEASE_PIN if k not in _PIN_SEEN]
    for k in gone:
        _RELEASE_PIN.pop(k, None)
    changed = bool(gone) or wanted != _PIN_WANTED
    now = time.time()
    hosted = {}
    for key in [(o, r, v) for (o, r), vers in wanted.items() for v in sorted(vers)]:
        owner, repo, v = key
        src = _pin_source(owner, repo, v)
        sk = src and "%s/%s@%s" % src
        if key in _RELEASE_PIN and not refresh and _RELEASE_PIN[key].get("src") == sk:
            continue
        if key not in _RELEASE_PIN and now - _PIN_TRIED.get(key, 0) < 3600:
            continue
        if src and hosted.get(sk) is False:
            _PIN_TRIED[key] = now
            continue
        try:
            rec = None
            if src:
                if sk not in hosted:
                    try:
                        hr = _pin_lookup(src[0], src[1], [src[2]], asset_re=r"\.apk$")
                    except urllib.error.HTTPError:
                        hosted[sk] = False
                        raise
                    hosted[sk] = hr if hr and hr["assets"] else None
                rec = hosted[sk] and dict(hosted[sk], tag=_hosted_app_ver(src[2]), src=sk)
            if rec is None:
                old = _RELEASE_PIN.get(key) or {}
                kt = None if old.get("src") else old.get("tag")
                tags = [kt] if kt else ([t for (f, ver), t in _PIN_TAG_OVERRIDE.items()
                                         if ver == v and turn_fork_owner(f) == owner + "/" + repo] or _pin_tags(v))
                rec = _pin_lookup(owner, repo, tags)
                if rec and src:
                    rec["src"] = sk
        except urllib.error.HTTPError:
            _PIN_TRIED[key] = now
            continue
        except Exception:
            break
        if rec is None:
            _PIN_TRIED[key] = now
            if _RELEASE_PIN.pop(key, None) is not None:
                changed = True
        elif rec != _RELEASE_PIN.get(key):
            _RELEASE_PIN[key] = rec
            changed = True
    _PIN_WANTED = wanted
    return changed

