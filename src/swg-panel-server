def _ghost_refs(roster):
    refs = {}
    for pid, p in (roster.get("peers") or {}).items():
        for t in (p.get("targets") or []):
            n, i = t.get("node"), t.get("iface")
            if _is_self_contained_target(t):
                continue
            if n and i:
                refs.setdefault(n, {}).setdefault(i, []).append(pid)
    return refs

def _ghost_ifaces(c, snap, refs, online):
    if not online or not refs:
        return {}
    live = snap.get("interfaces") or {}
    known = c.get("ifaces") or {}
    out = {}
    for ifn, pids in (refs or {}).items():
        if ifn in live:
            continue
        ov = known.get(ifn) or {}
        if ov.get("system"):
            continue
        if ov.get("_lastcfg"):
            continue
        uniq = sorted(set(pids))
        out[ifn] = {"peer_ids": uniq, "peer_count": len(uniq),
                    **({"reach": reach_level(ov.get("reach"))} if ifn in known else {})}
    return out

PROC_GRACE = 300
IFACE_AUTOSTART_GAPS = (0, 60, 300)
PROC_SUCCESS_SHOW = 20
PROC_INPROGRESS = ("reinstalling", "converting-bare", "converting-docker", "updating", "uninstalling")
PROC_SUCCESS = ("reinstalled", "reinstalled-updated", "converted-bare", "converted-docker", "updated", "uptodate",
                "adopted-container")
_PROC_FAIL = {"reinstalling": "reinstall-failed", "converting-bare": "convert-failed",
              "converting-docker": "convert-failed", "updating": "update-failed", "uninstalling": "uninstall-failed"}
def _proc_inprogress(s): return s in PROC_INPROGRESS
def _proc_terminal(s):   return bool(s) and (s in PROC_SUCCESS or s.endswith("-aborted") or s.endswith("-failed") or s == "failed")
def _proc_view(state, at):
    if not state:
        return None
    age = time.time() - (at or 0)
    if state in PROC_SUCCESS:
        return state if age <= PROC_SUCCESS_SHOW else None
    if state in PROC_INPROGRESS:
        return state if age <= PROC_GRACE else _PROC_FAIL.get(state, "failed")
    return state


def _ip_literal(s):
    if not isinstance(s, str):
        return False
    v = s.strip()
    if v[:1] == "[" and v[-1:] == "]":
        v = v[1:-1]
    if not v:
        return False
    try:
        ipaddress.ip_address(v)
        return True
    except ValueError:
        return False
def _hostport_split(s):
    v = (s or "").strip()
    if not v:
        return "", None
    if v[:1] == "[":
        end = v.find("]")
        if end < 0:
            return v, None
        host, rest = v[1:end], v[end + 1:]
        if rest[:1] == ":" and rest[1:].isdigit():
            return host, int(rest[1:])
        return host, None
    if v.count(":") > 1:
        return v, None
    host, sep, port = v.rpartition(":")
    if not sep:
        return v, None
    return (host, int(port)) if port.isdigit() else (v, None)
def _iface_field_eq(want, got):
    if isinstance(want, dict):
        return isinstance(got, dict) and all(str(got.get(k)) == str(v) for k, v in want.items())
    if want in (None, ""):
        return True
    return str(want) == str(got)
def iface_restore_req(ov, ivk_pub="", fresh=False):
    ov = ov or {}
    lc = ov.get("_lastcfg") or {}
    if not lc.get("subnet"):
        return None
    req = {"cmd": ["awg"], "subnet": lc.get("subnet"), "restore": True}
    _port = ov.get("listen_port") or lc.get("listen_port")
    if str(_port or "").isdigit() or isinstance(_port, int):
        req["listen_port"] = int(_port)
    if (lc.get("address") or "").strip():
        req["address"] = lc["address"].strip()
    _awg = ov.get("awg_params") if isinstance(ov.get("awg_params"), dict) and ov["awg_params"] else lc.get("awg_params")
    if isinstance(_awg, dict) and _awg:
        req["awg_params"] = _awg
        if ov.get("awg_exact") and _awg is ov.get("awg_params"):
            req["awg_params_exact"] = True
    else:
        req["cmd"] = ["wg"]
    _mtu = ov.get("mtu") or lc.get("mtu")
    if str(_mtu or "").isdigit() or isinstance(_mtu, int):
        req["mtu"] = str(int(_mtu))
    if not fresh and ivk_pub and _iface_key_source(ov, None, ivk_pub) == "vault":
        req["hold_key"] = True
    return req


