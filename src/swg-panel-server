SUB_ORPHAN = "_orphan"

def sub_live_peers(roster, uid):
    """Peers CURRENTLY in uid's bucket — the roster is authoritative, so this is the read-time gate. The orphan
    bucket holds every UNASSIGNED peer; a real uid holds the peers assigned to it."""
    if uid == SUB_ORPHAN:
        return {pid: p for pid, p in ((roster.get("peers") or {}).items()) if not p.get("user_id")}
    return {pid: p for pid, p in ((roster.get("peers") or {}).items()) if p.get("user_id") == uid}

def sub_gc_user(deps, uid, roster):
    """Prune the user's blob file to peers still assigned to them (housekeeping). Returns the live blobs."""
    live = sub_live_peers(roster, uid)
    blobs = load_sub_blobs(deps, uid)
    pruned = {pid: v for pid, v in blobs.items() if pid in live}
    if pruned != blobs:
        if pruned:
            save_sub_blobs(deps, uid, pruned)
        else:
            drop_sub_blobs(deps, uid)
    return pruned

def sub_gc_orphan(deps, roster):
    """Prune the orphan bucket GENTLY: a blob stays while its peer EXISTS and is either still unassigned OR not
    yet re-keyed into its user's bucket. Dropping only once migration is confirmed (or the peer is gone) avoids
    a race where a read-time GC deletes the ciphertext before the admin browser can re-key it on assignment."""
    peers = roster.get("peers") or {}
    blobs = load_sub_blobs(deps, SUB_ORPHAN)
    keep = {}
    for pid, v in blobs.items():
        p = peers.get(pid)
        if not p:
            continue                                              # peer deleted → drop
        uid = p.get("user_id")
        if not uid:
            keep[pid] = v; continue                               # still unassigned → keep
        if pid in load_sub_blobs(deps, uid):
            continue                                              # already migrated into the user's bucket → drop
        keep[pid] = v                                             # assigned but migration pending → keep
    if keep != blobs:
        if keep:
            save_sub_blobs(deps, SUB_ORPHAN, keep)
        else:
            drop_sub_blobs(deps, SUB_ORPHAN)
    return keep

SUB_EXIT_PFX = "_x_"

def sub_exit_bucket(nid): return SUB_EXIT_PFX + str(nid)

def sub_exit_node(uid):
    """The node a router-key bucket belongs to, or "" for any other bucket."""
    return uid[len(SUB_EXIT_PFX):] if isinstance(uid, str) and uid.startswith(SUB_EXIT_PFX) else ""

def _exit_nkh(prof):
    # The node key a router config was made against, as a digest: a config pasted over with a new node key leaves the kept
    # one naming a key the node no longer has. sha256 of a random 32-byte key says nothing about the key.
    return hashlib.sha256(str((prof or {}).get("private_key") or "").encode()).hexdigest()[:16]

def sub_live_exits(nodes, nid):
    """{exit id: (router public key, node-key digest)} for the node's dial-in exits — the read-time gate: the node record is
    authoritative, so a kept key outlives neither its exit nor a change of either side's key."""
    out = {}
    for x in ((nodes.get(nid) or {}).get("exits") or []):
        if isinstance(x, dict) and x.get("producer") == "imported" and exit_is_dialin(x) and x["profile"].get("peer_key"):
            out[str(x.get("id"))] = (x["profile"]["peer_key"], _exit_nkh(x["profile"]))
    return out

def sub_kept_exits(blobs, live):
    """The kept router keys that still open their exit: same exit, same router key, same node key. Pure."""
    return {eid: v for eid, v in (blobs or {}).items()
            if isinstance(v, dict) and eid in live and (v.get("pub"), v.get("nkh")) == live[eid]}

def sub_gc_exits(deps, nid):
    """Prune a node's router keys to its live dial-in exits. Returns (the live entries, sub_live_exits).
    ⚠️ Under the lock, against the record read THERE: a GET runs outside it with a nodes snapshot from its start, and a
    Regenerate that saved and kept a new router key meanwhile would read as stale against it — the key just kept, deleted."""
    uid = sub_exit_bucket(nid)
    with _api_lock:
        live = sub_live_exits(nodes_load(deps["nodes_path"]), nid)
