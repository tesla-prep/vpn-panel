                unassign_peer(p, store_configs, config_dir, now()); freed += 1
        del roster["users"][uid]
        for g in roster_groups(roster).values():
            if isinstance(g, dict) and isinstance(g.get("users"), list) and uid in g["users"]:
                g["users"] = [u for u in g["users"] if u != uid]
        for p in roster["peers"].values():
            su = p["share"].get("users") if isinstance(p, dict) and isinstance(p.get("share"), dict) else None
            if isinstance(su, dict):
                su.pop(uid, None)                # `{"users": {}}` stays truthy: the network stays restricted (§15.5)
        roster_save(roster_path, roster)
        with contextlib.suppress(Exception):
            drop_sub_blobs(deps, uid)
            _esc = load_sub_escrow(deps)
            if uid in _esc:
                del _esc[uid]; save_sub_escrow(deps, _esc)
            _su = load_sub_users(deps)
            if uid in _su:
                del _su[uid]; save_sub_users(deps, _su)
        ev_append(roster_path, "user", uid, "Deleted user", uname,
                  f"{freed} peer{'' if freed == 1 else 's'} unassigned" if freed else "",
                  detail_key="{count} unassigned" if freed else "",
                  detail_vars={"count": {"n": freed, "noun": "peer"}})
        return 200, {"ok": True, "data": {"id": uid, "unassigned_peers": freed}}

    if method == "POST" and path == "/api/groups/create":
        roster = roster_load(roster_path)
        name, why = group_name_clean(roster, body.get("name"))
        if why:
            return 400, {"ok": False, **why, "code": "bad_request"}
        add = body.get("users") or []
        if not isinstance(add, list) or any(not isinstance(u, str) for u in add):
            return 400, {"ok": False, "error": "users must be a list of user ids", "code": "bad_request"}
        if any(u not in roster["users"] for u in add):
            return 400, {"ok": False, "error": "unknown user", "code": "bad_request"}
        gid = gen_id()
        while gid in roster_groups(roster):
            gid = gen_id()
        g = group_set(roster, gid, {"name": name, "users": add})
        roster_save(roster_path, roster)
        ev_append(roster_path, "group", gid, "Created group", name,
                  f"{len(g['users'])} member{'' if len(g['users']) == 1 else 's'}" if g["users"] else "",
                  detail_key="{count}" if g["users"] else "", detail_vars={"count": {"n": len(g["users"]), "noun": "member"}})
        return 200, {"ok": True, "data": dict(g, id=gid)}

    if method == "POST" and path == "/api/groups/update":
        roster = roster_load(roster_path)
        gid = body.get("id") if isinstance(body.get("id"), str) else ""      # an id that is not a string is no group's
        cur = roster_groups(roster).get(gid)
        if not isinstance(cur, dict):
            return 404, {"ok": False, "error": "unknown group", "code": "not_found"}
        add, rem = body.get("add") or [], body.get("remove") or []
        if (not isinstance(add, list) or not isinstance(rem, list)
                or any(not isinstance(u, str) for u in add + rem)):
            return 400, {"ok": False, "error": "add and remove must be lists of user ids", "code": "bad_request"}
        if any(u not in roster["users"] for u in add):
            return 400, {"ok": False, "error": "unknown user", "code": "bad_request"}
        fields = {}
        if "name" in body:
            name, why = group_name_clean(roster, body.get("name"), gid)
            if why:
                return 400, {"ok": False, **why, "code": "bad_request"}
            if name != cur.get("name"):
                fields["name"] = name
        was = set(cur.get("users") or [])
        now_set = (was | set(add)) - set(rem)
        added, removed = now_set - was, was - now_set
        if added or removed:
            fields["users"] = sorted(now_set)
        if not fields:
            return 200, {"ok": True, "data": dict(cur, id=gid)}
        old_name = cur.get("name") or ""
        g = group_set(roster, gid, fields)
        roster_save(roster_path, roster)
        if "name" in fields:
            ev_append(roster_path, "group", gid, "Renamed group", g["name"], old_name)
        if "users" in fields:
            ev_append(roster_path, "group", gid, "Changed group members", g["name"], f"+{len(added)} −{len(removed)}")
        return 200, {"ok": True, "data": dict(g, id=gid)}

    if method == "POST" and path == "/api/groups/delete":
        roster = roster_load(roster_path)
        gid = body.get("id") if isinstance(body.get("id"), str) else ""
        groups = roster_groups(roster)
        if gid not in groups:
            return 404, {"ok": False, "error": "unknown group", "code": "not_found"}
        # A share naming this group keeps the id and grants nothing through it (GROUPS-PLAN G7): no peer is rewritten, and
        # the id is dropped quietly the next time that device's networks are saved.
        name = (groups.pop(gid) or {}).get("name") or ""
        roster_save(roster_path, roster)
        ev_append(roster_path, "group", gid, "Deleted group", name)
        return 200, {"ok": True, "data": {"id": gid}}

    # ─────────────── peers (credential + targets) ───────────────

    if method == "POST" and path == "/api/peers/create":
        pubkey = (body.get("pubkey") or "").strip()
        targets = body.get("targets")
        if not isinstance(targets, list) or not targets:
            t = body.get("target")
            targets = [t] if t else []
        if not targets:
            return 400, {"ok": False, "error": "at least one target is required", "code": "bad_request"}
        for t in targets:
            for f in ("node", "iface"):
                if not (t or {}).get(f):
                    return 400, {"ok": False, **perr("target.{v1} is required", v1=f), "code": "bad_request"}
            if not known(t["node"]):
                return 400, {"ok": False, **perr("unknown node {v1}", v1=repr(t["node"])), "code": "bad_request"}
            if is_system_iface(deps, nodes, t["node"], t["iface"]):
                return 400, {"ok": False, **perr("{v1} is a system mesh link — not a peer interface", v1=t["iface"]), "code": "system_iface"}
            t["type"] = iface_kind(deps, nodes, snaps, t["node"], t["iface"], t.get("type") or "")
            if is_keyless_kind(t["type"]):
                t["ip"] = ""            # the server mints the client address on connect — there is none to assign
            elif not t.get("ip"):
                return 400, {"ok": False, **perr("target.{v1} is required", v1="ip"), "code": "bad_request"}
        keyed = [t for t in targets if not is_keyless_kind(t["type"])]
        if keyed and not pubkey:
            return 400, {"ok": False, "error": "pubkey is required", "code": "bad_request"}
        seen = set()
        for t in targets:
            k = (t["node"], t["iface"])
            if k in seen:
                return 400, {"ok": False, **perr("duplicate target {v1}", v1=f"{t['node']}/{t['iface']}"), "code": "bad_request"}
            seen.add(k)
        be = bad_targets(keyed)         # only a keyed target carries an address to validate
        if be:
            return 400, {"ok": False, "error": be, "code": "bad_request"}
        roster = roster_load(roster_path)
        if pubkey and find_peer_by_pubkey(roster, pubkey):
            return 409, {"ok": False, "error": "a peer with this key already exists "
                         "(use add-target to deploy it elsewhere)", "code": "exists"}
        uid = body.get("user_id")
        if uid and uid not in roster["users"]:
            return 400, {"ok": False, "error": "unknown user", "code": "bad_request"}
        psk = (body.get("psk") or gen_psk()) if keyed else ""   # PSK is panel-owned; auto-mint when the client omits one
        fields = {"user_id": uid or None, "title": strip_ctrl(body.get("title", "")),
                  "pubkey": pubkey, "psk": psk, "targets": targets,
                  "overrides": body.get("overrides") or {}}
        fields.update(mint_keyless_secrets(targets, {}))   # one access password per keyless KIND the set touches
        pid = gen_id()
        while pid in roster["peers"]:
            pid = gen_id()
        p = peer_set(roster, pid, fields, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Created peer", peer_label(roster, p),
                  f"{len(targets)} target{'' if len(targets) == 1 else 's'} · {targets[0]['node']}/{targets[0]['iface']}",
                  detail_key="{count} · {where}",
                  detail_vars={"count": {"n": len(targets), "noun": "target"},
                               "where": f"{targets[0]['node']}/{targets[0]['iface']}"})
        webhook_emit(deps, "peer.added", {"peer_id": pid, "title": p.get("title") or None,
                     "user": (roster["users"].get(uid) or {}).get("name") if uid else None,
                     "targets": [{"node": t["node"], "iface": t["iface"], "address": t.get("ip")} for t in targets]})
        # No plaintext at rest: the browser encrypts {k,p} into the peer's blob (the config store). Any
        # body.configs a legacy client still sends is ignored.
        return 200, {"ok": True, "data": p}

    if method == "POST" and path == "/api/peers/add-target":
        pid = body.get("peer_id") or ""
        target = body.get("target") or {}
        for f in ("node", "iface"):
            if not target.get(f):
                return 400, {"ok": False, **perr("target.{v1} is required", v1=f), "code": "bad_request"}
        if not known(target["node"]):
            return 400, {"ok": False, **perr("unknown node {v1}", v1=repr(target["node"])), "code": "bad_request"}
        if is_system_iface(deps, nodes, target["node"], target["iface"]):
            return 400, {"ok": False, **perr("{v1} is a system mesh link — not a peer interface", v1=target["iface"]), "code": "system_iface"}
        target["type"] = iface_kind(deps, nodes, snaps, target["node"], target["iface"], target.get("type") or "")
        if is_keyless_kind(target["type"]):
            target["ip"] = ""
        else:
            if not target.get("ip"):
                return 400, {"ok": False, **perr("target.{v1} is required", v1="ip"), "code": "bad_request"}
            if not valid_addr(target["ip"]):
                return 400, {"ok": False, **perr("invalid address {v1}", v1=repr(target["ip"])), "code": "bad_request"}
        roster = roster_load(roster_path)
        p = roster["peers"].get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        if any(t["node"] == target["node"] and t["iface"] == target["iface"] for t in p["targets"]):
            return 409, {"ok": False, "error": "peer already has a target on that node/interface",
                         "code": "exists"}
        if not is_keyless_kind(target["type"]) and not p.get("pubkey"):
            return 400, {"ok": False, **perr("{v1} needs a client key — this peer has none (rotate its keys first)", v1=target["iface"]), "code": "bad_request"}
        if p.get("routes") and not is_keyless_kind(target["type"]):
            _nsnap = (snaps or {}).get(target["node"]) or {}
            _before = node_networks(roster, target["node"], _nsnap)["carry"]
            _draft = dict(roster, peers=dict(roster["peers"]))
            _draft["peers"][pid] = dict(p, targets=p["targets"] + [target])
            _after = node_networks(_draft, target["node"], _nsnap)["carry"]
            _took = [{"prefix": x, "node": target["node"], "why": "takes", "by": opid}
                     for opid, ent in sorted(_before.items()) if opid != pid
                     for x in ent["nets"] if x not in ((_after.get(opid) or {}).get("nets") or [])]
            if _took:
                return 409, {"ok": False, **perr("{v1} is already carried on this node by another device — deploying this one there would take it over",
                                                 v1=", ".join(r["prefix"] for r in _took)),
                             "code": "network_refused", "refusals": _took}
        _add = {"targets": p["targets"] + [target]}
        _add.update(mint_keyless_secrets([target], p))   # first wdtt/csqtt deployment on this peer → its password
        p2 = peer_set(roster, pid, _add, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Added deployment", peer_label(roster, p2),
                  f"{target['node']}/{target['iface']}")
        # same key as the peer's other deployments → its existing blob already covers this target; no write.
        return 200, {"ok": True, "data": p2}

    if method == "POST" and path == "/api/peers/remove-target":
        pid = body.get("peer_id") or ""
        node = body.get("node") or ""; iface = body.get("iface") or ""
        roster = roster_load(roster_path)
        p = roster["peers"].get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        kept = [t for t in p["targets"] if not (t["node"] == node and t["iface"] == iface)]
        if not kept:
            # Never silently delete via the last target — deletion is an explicit, gated act
            # (and only for unassigned peers). Caller must use peers/delete instead.
            return 409, {"ok": False, "error": "this is the peer's only deployment — "
                         "delete the peer instead (unassign it first)", "code": "last_target"}
        del_config(store_configs, config_dir, p["pubkey"], node, iface)
        retire_pubkey(nodes, deps["nodes_path"], [{"node": node, "iface": iface}], p["pubkey"])   # drop it even on add-only ifaces
        p2 = peer_set(roster, pid, {"targets": kept}, now())
        roster_save(roster_path, roster)
        ev_append(roster_path, "peer", pid, "Removed deployment", peer_label(roster, p2),
                  f"{node}/{iface}")
        return 200, {"ok": True, "data": p2}

    if method == "POST" and path == "/api/peers/set-role":
        pid = body.get("peer_id") or ""
        node = body.get("node") or ""; iface = body.get("iface") or ""
        role = str(body.get("role") or "").strip().lower()
        if role not in ("", "primary", "backup"):
            return 400, {"ok": False, "error": "role must be primary, backup, or empty", "code": "bad_role"}
        roster = roster_load(roster_path)
        p = roster["peers"].get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        tgts, found = [], False
        for t in p.get("targets", []):
            t = dict(t)
            if t.get("node") == node and t.get("iface") == iface:
                found = True
                if role:
                    t["primary"] = role
                else:
                    t.pop("primary", None)
            tgts.append(t)
        if not found:
            return 404, {"ok": False, "error": "unknown target", "code": "not_found"}
        p2 = peer_set(roster, pid, {"targets": tgts}, now())   # metadata only — no key/config touch
        roster_save(roster_path, roster)
        return 200, {"ok": True, "data": p2}

    if method == "POST" and path == "/api/peers/update":
        pid = body.get("peer_id") or ""
        roster = roster_load(roster_path)
        p = roster["peers"].get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        changed = {}
        if "title" in body:
            changed["title"] = strip_ctrl(body.get("title", ""))
        if "user_id" in body:
            uid = body.get("user_id")
            if uid and uid not in roster["users"]:
                return 400, {"ok": False, "error": "unknown user", "code": "bad_request"}
            changed["user_id"] = uid or None
        if "private" in body:
            # ⚠️ Stored ONLY as a departure from the default, the way `lan_share` is: a peer nobody marked carries no key,
            # so every existing roster keeps its exact meaning and an older panel reading this file sees what it saw.
            changed["private"] = True if body.get("private") is True else None
        if "router" in body:                    # several devices behind one address — never flagged (S11b), stored as private is
            changed["router"] = True if body.get("router") is True else None
        if "overrides" in body:                 # per-peer non-secret DNS/MTU/AllowedIPs/keepalive (the roster copy)
            changed["overrides"] = body.get("overrides") or {}
        if "sub_hide" in body:                  # which config sources this peer publishes to its subscription
            _h = body.get("sub_hide")
            if _h is not None and not isinstance(_h, list):
                return 400, {"ok": False, "error": "sub_hide must be a list", "code": "bad_request"}
            _clean = clean_sub_hide(_h, p, deps.get("node_snaps") or {})
            if _clean is None:
                return 400, {"ok": False, **perr("A peer has to publish at least one kind of config — keep one selected."), "code": "bad_request"}
            changed["sub_hide"] = _clean
        if "expiry" in body:                     # per-peer expiry date (epoch secs; 0/"" clears it)
            exp = coerce_expiry(body.get("expiry"))
            if exp is None:
                return 400, {"ok": False, "error": "expiry must be an epoch timestamp or 0", "code": "bad_request"}
            if exp:
                # A peer can't outlive its subscription — its expiry may not be later than the owning user's.
                owner_uid = changed.get("user_id", p.get("user_id"))
                uexp = int((roster["users"].get(owner_uid) or {}).get("expiry") or 0) if owner_uid else 0
                if uexp and exp > uexp:
                    return 400, {"ok": False, **perr("Peer expiry can't be later than the subscription's expiry ({v1})", v1=fmt_day(uexp)), "code": "bad_request"}
            changed["expiry"] = exp
        if "routes" in body:                    # the networks behind this device — refused at the door, tolerated once stored
            _rt = body.get("routes")
            if not isinstance(_rt, list) or any(not isinstance(x, str) for x in _rt):
                return 400, {"ok": False, "error": "routes must be a list of CIDR strings", "code": "bad_request"}
            _clean, _refused = network_routes_clean(roster, p, _rt, deps.get("node_snaps") or {})
            if _refused:
                return 400, {"ok": False, "error": "network refused", "code": "network_refused", "refusals": _refused}
            changed["routes"] = _clean
        if "share" in body:                     # NETWORKS P5: who may reach this device's networks — null = everyone on its node
            _sh, _why = share_clean(roster, dict(p, user_id=changed.get("user_id", p.get("user_id"))),
                                    body.get("share"), int(time.time()))
            if _why:
                return 400, {"ok": False, "error": "share refused", "code": "share_refused", "why": _why}
            changed["share"] = _sh
        if not changed:
            return 400, {"ok": False, "error": "nothing to update", "code": "bad_request"}
        p2 = peer_set(roster, pid, changed, now())
        roster_save(roster_path, roster)
        if "title" in changed:
            ev_append(roster_path, "peer", pid, "Renamed peer", peer_label(roster, p2))
        if "user_id" in changed:
            ev_append(roster_path, "peer", pid,
                      "Assigned peer" if changed["user_id"] else "Unassigned peer", peer_label(roster, p2))
        elif ("overrides" in changed or "expiry" in changed or "routes" in changed or "share" in changed) and "title" not in changed:
            ev_append(roster_path, "peer", pid, "Edited peer config", peer_label(roster, p2))
        if "router" in changed and bool(changed["router"]) != bool(p.get("router")):   # the torrent guard's reach changed
            ev_append(roster_path, "peer", pid, "Marked as a router" if changed["router"] else "Router mark removed",
                      peer_label(roster, p2))
        if "routes" in changed or "share" in changed:   # what the operator has just done, before they walk away (§4.5)
            return 200, {"ok": True, "data": p2, "networks": network_report(roster, pid, deps.get("node_snaps") or {})}
        return 200, {"ok": True, "data": p2}

    if method == "POST" and path == "/api/users/networks":
        # "My networks" for one user (NETWORKS-PLAN feature 13) — on demand, never per poll (§4.10).
        roster = roster_load(roster_path)
        if isinstance(body.get("user_ids"), list):
            _known = roster.get("users") or {}
            _ids = [x for x in dict.fromkeys(body["user_ids"]) if isinstance(x, str) and x in _known][:100]
            _snaps, _nodes = deps.get("node_snaps") or {}, nodes_load(deps["nodes_path"])
            _show = (deps.get("panel_settings") or {}).get("show_node_lans") is not False
            _plans, _memo = {}, {"grants": {}, "covers": {}}
            _cas = cascade_plan(_nodes, _snaps)            # the fleet's egress plan, once for the batch, not once per user
            _counts, _rows = {}, {}
            for _u in _ids:
                try:
                    _data = user_networks(roster, _u, _snaps, _nodes, show_lans=_show, plans=_plans, memo=_memo, cas=_cas)
                    _counts[_u] = net_rows_count(_data)
                    _rows[_u] = net_rows_brief(_data)
                except Exception:
                    continue                      # that user's chip keeps whatever it had; the rest of the page still answers
            return 200, {"ok": True, "data": {"counts": _counts, "rows": _rows}}
        uid = body.get("user_id") or ""
        if uid not in (roster.get("users") or {}):
            return 404, {"ok": False, "error": "unknown user", "code": "not_found"}
        return 200, {"ok": True, "data": user_networks(roster, uid, deps.get("node_snaps") or {},
                                                        nodes_load(deps["nodes_path"]),
                                                        show_lans=(deps.get("panel_settings") or {}).get("show_node_lans") is not False)}

    if method == "POST" and path == "/api/routing/who":
        nid, ifn, whos = body.get("node") or "", str(body.get("iface") or ""), body.get("rows")
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not isinstance(whos, list) or len(whos) > 200 or not all(isinstance(w, dict) for w in whos):
            return 400, {"ok": False, "error": "rows must be a list of selections", "code": "bad_request"}
        return 200, {"ok": True, "data": {"rows": who_report(roster_load(roster_path), nid,
                                                             (deps.get("node_snaps") or {}).get(nid) or {}, ifn, whos)}}

    if method == "POST" and path == "/api/peers/networks":
        roster = roster_load(roster_path)
        pid = body.get("peer_id") or ""
        if pid not in (roster.get("peers") or {}):
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        _snaps = deps.get("node_snaps") or {}
        if "routes" not in body and "share" not in body:
            return 200, {"ok": True, "data": network_report(roster, pid, _snaps)}
        _dp, _extra = dict(roster["peers"][pid]), {}                  # this one peer replaced; nothing else copied
        if "routes" in body:
            _rt = body.get("routes")
            if not isinstance(_rt, list) or any(not isinstance(x, str) for x in _rt):
                return 400, {"ok": False, "error": "routes must be a list of CIDR strings", "code": "bad_request"}
            _clean, _refused = network_routes_clean(roster, roster["peers"][pid], _rt, _snaps)
            _bad = {r["prefix"] for r in _refused}
            _dp["routes"] = [x for x in _clean if x not in _bad]
            _extra.update(refusals=_refused, routes=_clean)
        if "share" in body:                                          # P5: who the draft would let in — and who it cuts off
            _sh, _why = share_clean(roster, _dp, body.get("share"), int(time.time()))
            if _why:
                return 400, {"ok": False, "error": "share refused", "code": "share_refused", "why": _why}
            _dp.pop("share", None)
            if _sh is not None:
                _dp["share"] = _sh
        _draft = dict(roster, peers=dict(roster["peers"]))
        _draft["peers"][pid] = _dp
        _data = network_report(_draft, pid, _snaps)
        _data.update(_extra)
        return 200, {"ok": True, "data": _data}

    if method == "POST" and path == "/api/peers/networks/probe":
        roster = roster_load(roster_path)
        pid = body.get("peer_id") or ""
        if pid not in (roster.get("peers") or {}):
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        if body.get("id"):
            _pv = net_probe_status(pid, str(body.get("id")))
            if _pv is None:
                return 404, {"ok": False, "error": "no such test", "code": "not_found", "why": "unknown"}
            return 200, {"ok": True, "data": _pv}
        if not body.get("addr"):
            return 200, {"ok": True, "data": net_probe_status(pid)}
        _port = body.get("port")
        if isinstance(_port, str):
            _port = int(_port) if _port.strip().isdigit() else (None if not _port.strip() else -1)
        _adv = ((deps.get("panel_settings") or {}).get("advanced") or {})
        _st, _out = net_probe_request(roster, pid, str(body.get("node") or ""), body.get("addr"), _port,
                                      deps.get("node_snaps") or {}, deps.get("node_seen") or {},
                                      max(5, int((_adv.get("node_stale_ms") or 30000) / 1000)))
        if _st == 200:
            _d = _out["data"]
            ev_append(roster_path, "peer", pid, "Tested a network", peer_label(roster, roster["peers"][pid]),
                      "%s · %s/%s" % (_d["addr"] + (":%d" % _d["port"] if _d["port"] else ""), _d["node"], _d["iface"]))
        return _st, _out

    if method == "POST" and path == "/api/exit/test":
        nid = str(body.get("node") or "")
        nodes = nodes_load(deps["nodes_path"])
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if body.get("id"):
            _tv = exit_test_status(nid, str(body.get("id")))
            return (200, {"ok": True, "data": _tv}) if _tv else (404, {"ok": False, "error": "no such test", "code": "not_found"})
        _was = next((x for x in (nodes[nid].get("exits") or []) if isinstance(x, dict)
                     and str(x.get("id")) == str(body.get("exit_id") or "") and isinstance(x.get("socks"), dict)), None)
        _sk, _serr = socks_resolve(body.get("socks_text"), body.get("socks_pass"), (_was or {}).get("socks"))
        if _serr:
            return 400, {"ok": False, "error": _serr, "code": "bad_request"}
        _adv = ((deps.get("panel_settings") or {}).get("advanced") or {})
        _seen = (deps.get("node_seen") or {}).get(nid)
        return exit_test_request(nid, body.get("exit_id"), _sk, (deps.get("node_snaps") or {}).get(nid),
                                 (time.time() - _seen) if _seen else None,
