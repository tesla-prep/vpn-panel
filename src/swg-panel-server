                                "iface_start": list((node.get("iface_start") or {}).keys()),  # interfaces to start (up + enable)
                                "create": node.get("create") or None,
                                "turn": node.get("turn") or {}, "turn_onboard": node.get("turn_onboard") or [],
                                "iface_key": node.get("iface_key") or {},   # per-iface {restore|rebaseline} keypair requests
                                "cascade": {"forward": my_plan.get("forward") or [], "exit": my_plan.get("exit") or [],
                                            **({"static_egress": my_plan["static_egress"]} if my_plan.get("static_egress") else {}),
                                            "devexit": my_plan.get("devexit") or []},   # Phase 2: policy-route forwards + exit SNAT + device exits
                                "exits": [{"id": x.get("id"), "device": x.get("device"),
