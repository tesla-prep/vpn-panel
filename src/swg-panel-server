def _clean_exit_ips(m, nodes, nid, stored, lenient=False):
    if m is None:
        m = {}
    if not isinstance(m, dict):
        return None, "the exit addresses must be given per node"
    out = {}
    for k, v in m.items():
        k, v = str(k), str(v or "").strip()
        if not v:
            continue
        if not _ip4(v):
            return None, "the exit address must be an IPv4 address"
        if k == nid:
            return None, "the exit address must name another node in this panel"
        if k not in nodes and k not in stored:
            if not lenient:
                return None, "the exit address must name another node in this panel"
        out[k] = v
    return out, None


def _apply_exit_ips(rec, body, nodes, nid, lenient=False):
