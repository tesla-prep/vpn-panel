    line = line.strip()
    known = dict(CSQTT_BUILDS)
    builds = [(v.strip(), known[v.strip()]) for v in vers.split(",") if v.strip() in known]
    if _CSQTT_LINE_RE.match(line) and line not in CSQTT_LINES and builds:
        CSQTT_LINES[line] = builds
