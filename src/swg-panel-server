SMART_DNS_PORT = 5354


def node_dns_upstream(raw):
    parts = raw if isinstance(raw, list) else re.split(r"[\s,]+", str(raw or ""))
    parts = [str(p).strip() for p in parts if str(p).strip()]
    if len(parts) > 4:
        return None, "Upstream DNS takes at most four addresses."
    out = []
    for item in parts:
        host, sep, port = item.partition("#")
        try:
            a = ipaddress.ip_address(host.strip("[]"))
            pn = int(port) if sep else 53
        except ValueError:
            return None, perr("Upstream DNS: {v1} is not an IP address (optionally with #port).", v1=item)
        if not 1 <= pn <= 65535 or a.is_unspecified or a.is_multicast:
            return None, perr("Upstream DNS: {v1} can't answer DNS queries.", v1=item)
        if a.is_loopback and pn == SMART_DNS_PORT:
            return None, perr("Upstream DNS: {v1} is the node's own Force-DNS resolver — it would ask itself.", v1=item)
        out.append(str(a) + ("#%d" % pn if sep else ""))
    return list(dict.fromkeys(out)), None


def turn_client_dns(raw, fork, had, orig=None):
    parts = raw if isinstance(raw, list) else re.split(r"[\s,]+", str(raw or ""))
    parts = [str(p).strip() for p in parts if str(p).strip()]
    if not parts:
        if not had:
            return None, None
        dflt = ",".join(orig) if isinstance(orig, list) and orig else ((TURN_SERVERS.get(fork) or {}).get("client_dns") or "")
        return ([p for p in dflt.split(",") if p] or None), None
    parts = list(dict.fromkeys(parts))
    if len(parts) > 2:
        return None, "Client DNS takes at most two addresses."
    for p in parts:
        if not turn_dns_usable(p):
            return None, perr("Client DNS must be IPv4 addresses — {v1} is not one a phone can use.", v1=p)
    return parts, None


def apply_turn_client_dns(inst, body, fork, rep=None):
    if "dns" not in body:
        return None
    if not inst.get("dns") and "dns_orig" not in inst:
        own, _e = turn_client_dns((rep or {}).get("dns_server"), fork, False)
        if own:
            inst["dns_orig"] = own
    val, err = turn_client_dns(body.get("dns"), fork, bool(inst.get("dns")), inst.get("dns_orig"))
    if err:
        return err if isinstance(err, dict) else {"error": err}
    if val:
        inst["dns"] = val
    else:
        inst.pop("dns", None)
    return None


def turn_dns_usable(p):
    try:
        a = ipaddress.ip_address(p)
    except ValueError:
        return False
    return (a.version == 4 and str(a) == p and not a.is_unspecified and not a.is_loopback
            and not a.is_link_local and not a.is_multicast and not a.is_reserved and not p.startswith("0."))

def turn_iface_name_error(deps, nodes, snaps, nid, iface, kind):
    if not _WDTT_ADOPT_IFACE_RE.match(iface or ""):
        return "invalid interface name (letters, digits, - and _; max 15, must start alphanumeric)"
    if is_system_iface(deps, nodes, nid, iface):
        return f"{iface} is a system mesh link"
    n = nodes.get(nid) or {}
    other = "csqtt" if kind == "wdtt" else "wdtt"
    if iface in (n.get(other) or {}):
        return f"{iface} is already a {other.upper()} instance on this node"
    if iface in (n.get(kind) or {}):
        return None
    if ((snaps.get(nid) or {}).get("interfaces") or {}).get(iface):
        return f"{iface} is already a WireGuard interface on this node"
    rc = reserved_conflict(deps, nodes, n, name=iface)
    if rc:
        return rc
    return None


