def panel_update_ref():
    if not UPDATE_TRIGGER or PANEL_DECLARATIVE:
        return ""
    try:
        st = os.stat(UPDATE_WRAPPER)
    except OSError:
        return ""
    key = (st.st_ino, st.st_mtime_ns, st.st_size)
    if _WRAPPER_REF["key"] != key:
        try:
            with open(UPDATE_WRAPPER, encoding="utf-8") as f:
                m = _WRAPPER_REF_RE.search(f.read(65536))
        except (OSError, UnicodeDecodeError):
            return ""
        ref = m.group(1) if m else ""
        _WRAPPER_REF.update(key=key, ref="" if ref == "main" else ref)
    return _WRAPPER_REF["ref"]


