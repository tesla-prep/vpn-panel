    clean, err = _clean_exit_ips(body.get("routing_exit_ips"), nodes, nid,
                                 rec.get("routing_exit_ips") or {}, lenient=lenient)
    if err:
        return err
    if clean:
        rec["routing_exit_ips"] = clean
    else:
        rec.pop("routing_exit_ips", None)
