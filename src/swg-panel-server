def err(op, msg, code="internal"):
    return {"ok": False, "op": op, "error": msg, "code": code}


def perr(key, **vals):
    """A user-facing error whose sentence carries VALUES.

    The panel does not translate anything — the browser does, keying on the English sentence, which is the
    same convention the SPA uses for its own strings. That works directly for a fixed sentence because the
    wire already carries it. It cannot work for "couldn't bind 0.0.0.0:443 — permission denied": once the
    values are baked in, there is nothing stable to look up.

    So a parameterised error ships three things:
      error       the interpolated English, exactly as before — logs, /api/v1 consumers and any older
                  cached SPA build keep reading what they always read; nothing downstream has to change
      error_key   the same sentence with {v1}, {v2} left as markers — what the browser looks up
      error_vars  the values, so a translation can put them where that language puts them

        return 400, {"ok": False, **perr("couldn't bind {v1} — {v2}", v1=addr, v2=str(e)),
                     "code": "bind_failed"}

    A value may itself be a perr() — a PHRASE that has to be translated where it lands, not a name ("traffic cascaded
    in" as the subject of an exit alarm). It travels whole, so the browser translates it with srvText() before putting it
    in; the English `error` gets its English, and the extractor sees its literal like any other perr().
    """
    vals = {k: ("" if v is None else v if isinstance(v, dict) and "error_key" in v else str(v)) for k, v in vals.items()}
    msg = key
    for k, v in vals.items():
        msg = msg.replace("{" + k + "}", v["error"] if isinstance(v, dict) else v)
    return {"error": msg, "error_key": key, "error_vars": vals}


def verify_password(stored, password):
    # stored = "pbkdf2_sha256$<iterations>$<salt_b64>$<hash_b64>"
    try:
        algo, iters, salt_b64, hash_b64 = stored.split("$")
        if algo != "pbkdf2_sha256":
            return False
        actual = hashlib.pbkdf2_hmac("sha256", password.encode(),
                                     base64.b64decode(salt_b64), int(iters))
        return hmac.compare_digest(actual, base64.b64decode(hash_b64))
    except Exception:
        return False


AUTH_UNUSABLE = ""
# …and which fix it takes: "perm" (the file is there and this process cannot read it — chown/chmod), anything else
# ("missing", "empty", "hash": gone, blank, or holding a hash nobody can check) — a new login, swg-passwd.
AUTH_UNUSABLE_KIND = ""


def _pbkdf2_hash_ok(h):
    """Could ANY password match `h` in verify_password()? Read exactly as it reads it: pbkdf2_sha256, a positive
    iteration count, a salt and a hash that decode as it decodes them — and a hash of 32 bytes, what pbkdf2_hmac("sha256")
    gives (compare_digest against any other length is always False). Anything else fails every sign-in."""
    try:
        algo, iters, salt_b64, hash_b64 = h.split("$")
        base64.b64decode(salt_b64)
        return algo == "pbkdf2_sha256" and int(iters) > 0 and len(base64.b64decode(hash_b64)) == 32
    except Exception:
        return False


def load_auth():
    """(user, hash), or None when there is no usable credential. Sets AUTH_UNUSABLE to the reason when a
    file was named but could not be read or parsed, so the caller can refuse instead of failing open.

    ⚠️ A HASH NO ONE CAN CHECK IS AN UNUSABLE FILE TOO. verify_password() refuses anything that is not
    pbkdf2_sha256, so such a file answered every sign-in with a plain 401 — the operator's right password included —
    and nothing anywhere said why (1.8.8 qualification, round 10, N2). It stays closed, and now says so: the startup
    line and the login screen name the reason and the fix, as for a file that cannot be read."""
    global AUTH_UNUSABLE, AUTH_UNUSABLE_KIND
    if not AUTH_FILE:
        AUTH_UNUSABLE = AUTH_UNUSABLE_KIND = ""   # the documented no-login mode: nothing was named
        return None
    try:
        user, _, h = open(AUTH_FILE).read().strip().partition(":")
        if user and h and _pbkdf2_hash_ok(h):
            AUTH_UNUSABLE = AUTH_UNUSABLE_KIND = ""
            return (user, h)
        if user and h:                           # a line, but a hash verify_password() cannot check
            AUTH_UNUSABLE, AUTH_UNUSABLE_KIND = "its password hash is not a pbkdf2_sha256 one, which no password can match", "hash"
        else:                                    # empty, truncated, or missing its "user:hash" colon
            AUTH_UNUSABLE, AUTH_UNUSABLE_KIND = "it has no 'user:hash' line", "empty"
    except FileNotFoundError as e:
        AUTH_UNUSABLE, AUTH_UNUSABLE_KIND = e.strerror or str(e), "missing"
    except OSError as e:
        AUTH_UNUSABLE, AUTH_UNUSABLE_KIND = e.strerror or str(e), ("perm" if isinstance(e, PermissionError) else "missing")
    return None


def _auth_fix_cmd():
    """The fix for a closed login, by what closed it and where this panel runs (N1): a file this process cannot READ
    takes an owner and a mode; one that is gone, blank or holds no hash a password can match takes a new login —
    swg-passwd; and a Docker panel is never told to run systemctl. (swg-passwd restarts a bare panel itself; in a
    container it cannot, so the restart is part of the command.)"""
    if IN_DOCKER:
        return "docker exec -it swg-panel swg-passwd; docker restart swg-panel"
    if AUTH_UNUSABLE_KIND == "perm":
        return "chown root:swg %s; chmod 640 %s; systemctl restart swg-panel-server" % (AUTH_FILE, AUTH_FILE)
    return "sudo swg-passwd"


def _auth_fix_line():
    """_auth_fix_cmd, with what it does when that is not plain from the command — for the log line."""
    c = _auth_fix_cmd()
    if IN_DOCKER:
        return c + "  (on the Docker host: a new login, then the panel restarted to read it)"
    return c if AUTH_UNUSABLE_KIND == "perm" else c + "  (it sets a new login and restarts the panel)"


