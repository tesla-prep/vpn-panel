def reach_unvouched_report(snap):
    """DEVICE ACCESS (§10.6, §11.2 F4) → (instances whose REPORTED build vouches for NO path, WDTT instances with RAW on whose
    build vouches for WG but not RAW — qWDTT 1.4.3). At "Same user and their groups" the first act as Nobody for every device
    (A7, §10.2 R1); the second only for the devices connected over RAW. Each edit sheet says which. An instance the node does not
    report is not named; nothing here is guessed from the record."""
    def ok(ki, fam, path):
        return keyless_share_capable(str(ki.get("fork") or ("csqtt" if fam == "csqtt" else "amurcanov")).strip(), path,
                                     str(ki.get("version") or ""))
    rep = [(fam, ki) for fam in ("wdtt", "csqtt") for ki in ((snap or {}).get(fam) or []) if isinstance(ki, dict) and ki.get("iface")]
    none = sorted(str(ki["iface"]) for fam, ki in rep
                  if not any(ok(ki, fam, p) for p in (("wg", "raw") if fam == "wdtt" else ("raw",))))
    raw = sorted(str(ki["iface"]) for fam, ki in rep
                 if fam == "wdtt" and ki.get("raw_iface") and ok(ki, fam, "wg") and not ok(ki, fam, "raw"))
    return none, raw


