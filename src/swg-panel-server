def _flock_holder(path):
    try:
        ino = os.stat(path).st_ino
    except OSError:
        return None, "unknown"
    try:
        with open("/proc/locks") as f:
            lines = f.read().splitlines()
    except OSError:
        return None, "unknown"
    for ln in lines:
        parts = ln.split()
        if len(parts) > 1 and parts[1] == "->":
            continue
        if len(parts) < 6 or parts[1] != "FLOCK":
            continue
        try:
            pid = int(parts[4])
            if int(parts[5].rsplit(":", 1)[-1]) != ino:
                continue
        except ValueError:
            continue
        return (pid if pid > 0 else None), "held"
    return None, "free"


def _state_owner():
    import pwd, grp
    try:    u = pwd.getpwuid(os.geteuid()).pw_name
    except Exception: u = str(os.geteuid())
    try:    g = grp.getgrgid(os.getegid()).gr_name
    except Exception: g = str(os.getegid())
    return u, g


def load_critical(path, default, valid=None):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except (json.JSONDecodeError, OSError) as e:
        if isinstance(e, OSError) and e.errno in (errno.EMFILE, errno.ENFILE):
            raise RuntimeError(
                "%s could not be opened: %s. This is a DESCRIPTOR exhaustion in the panel, not corrupt "
                "state — the file has not been touched. Restart the panel; if it recurs, the fd watchdog "
                "logs a thread dump naming what is holding them." % (path, e)) from e
        _perm = isinstance(e, PermissionError)
        for b in _state_backups(path):
            try:
                with open(b) as f:
                    data = json.load(f)
            except Exception:
                continue
            if valid is not None and not valid(data):
                continue
            if _perm:
                log(LOG_ERR, "swg-panel: %s could not be READ (%s) — the file is intact, this process just has no "
                    "access to it. Anything written there by another user has been DISCARDED and %s "
                    "restored in its place. Fix with: chown %s:%s %s && chmod 600 %s", path, e, b, _state_owner()[0], _state_owner()[1], path, path)
            else:
                log(LOG_WARNING, "swg-panel: %s unreadable (%s) — recovered from %s", path, e, b)
            with contextlib.suppress(Exception):
                atomic_write(path, json.dumps(data, indent=2) + "\n", mode=0o600)
            return data
        raise RuntimeError("critical state %s is corrupt and no good backup exists — refusing to start empty" % path)

def load_settings_critical(path):
    primary, primary_ok = {}, False
    try:
        with open(path) as f:
            primary = json.load(f); primary_ok = isinstance(primary, dict)
    except FileNotFoundError:
        return {}
    except (json.JSONDecodeError, OSError):
        primary_ok = False
    if primary_ok and primary:
        return primary
    for b in _state_backups(path):
        try:
            with open(b) as f:
                cand = json.load(f)
        except Exception:
            continue
        if isinstance(cand, dict) and cand:
            log(LOG_WARNING, "swg-panel: panel-settings %s — recovered from %s", "corrupt" if not primary_ok else "empty", b)
            with contextlib.suppress(Exception):
                atomic_write(path, json.dumps(cand, indent=2) + "\n", mode=0o600)
            return cand
    return primary if primary_ok else {}


_DISK_WARN = {"t": 0.0}
def stats_disk_ok(path, min_free_mb=64, min_pct=2):
    try:
        st = os.statvfs(path)
        free = st.f_bavail * st.f_frsize; total = (st.f_blocks * st.f_frsize) or 1
        if free >= min_free_mb * 1048576 and (free * 100 // total) >= min_pct:
            return True
    except OSError:
        return True
    now = time.time()
    if now - _DISK_WARN["t"] > 300:
        _DISK_WARN["t"] = now
        log(LOG_ERR, "swg-panel: stats volume critically low — pausing snapshot/RRD writes (critical state still saved)")
    return False



