def _sub_suspend_user(deps, uid, enabled):
    """Flip a user's subscription enabled flag WITHOUT touching token_sha or the escrow — the URL stays valid,
    swg-sub just serves the "Subscription disabled" screen while enabled is False. Used by user block/unblock so
    a re-enable is instant (no re-mint, no re-share). No-op if the user has no subscription. Best-effort."""
    try:
        users = load_sub_users(deps)
        if uid in users and bool(users[uid].get("enabled")) != bool(enabled):
            users[uid]["enabled"] = bool(enabled)
            save_sub_users(deps, users)
    except Exception:
        pass

