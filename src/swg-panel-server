def node_public_ip(snap):
    for ip in (snap or {}).get("node_ips") or []:
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            continue
        if a.version == 4 and not (a.is_private or a.is_loopback or a.is_link_local):
            return ip
    return ""


def mesh_advertised_host(snap, iface):
    ep = str(((((snap or {}).get("interfaces") or {}).get(iface) or {}).get("meta") or {}).get("endpoint") or "")
    host = ep.rsplit(":", 1)[0] if ":" in ep else ""
    if not host or ":" in host or host in ("0.0.0.0", "localhost") or host.startswith("127."):
        return ""
    return host


def mesh_endpoint_host(node, snap, iface=None):
    return (node.get("endpoint_host") or "").strip() or node_public_ip(snap) or mesh_advertised_host(snap, iface)


def desired_mesh_for_node(nodes, nid, keepalive, allowed_overrides=None, snaps=None):
    ov_map = allowed_overrides or {}
    snaps = snaps or {}
    out = {}
    me = nodes.get(nid) or {}
    for peer_nid, lr in (me.get("links") or {}).items():
        peer = nodes.get(peer_nid)
        if not peer:
            continue
        iface = lr.get("iface")
        rlr = (peer.get("links") or {}).get(nid) or {}
        rov = (peer.get("ifaces") or {}).get(rlr.get("iface")) or {}
        pub = rov.get("public_key"); rport = rlr.get("listen_port")
        rhost = (lr.get("dial_endpoint") or "").strip() or mesh_endpoint_host(peer, snaps.get(peer_nid), rlr.get("iface"))
        if not (pub and rport and rhost and iface):
            continue
        out.setdefault(iface, []).append({
            "public_key": pub,
            "allowed_ips": ov_map.get(iface) or ((lr.get("peer_address") or "") + "/32"),
            "preshared_key": lr.get("psk") or "none",
            "endpoint": f"{rhost}:{rport}",
            "persistent_keepalive": keepalive,
            "dial_src": (lr.get("dial_src") or "").strip() or (me.get("mesh_egress_ip") or "").strip(),
            "name": "mesh:" + (peer.get("name") or peer_nid)})
    return out


