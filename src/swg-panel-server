        if _dr:
            issues.append(perr("torrents on {v1}: their route's way out is down — blocked until it is back", v1=", ".join(_dr)))
        elif _dn is None:                                     # a node that names no device: the line as before. One that names
            issues.append(perr("the torrent route's way out is down — torrent traffic is blocked until it is back"))   # devices no
    if _p2pa == "iface" and p2p_iface is not None and _srp is not None and not _srp.get("p2pi"):
        issues.append(perr("per-interface torrent choices need a node update — until then those interfaces' torrents are not checked"))
    elif (_p2pa == "iface" and p2p_iface and _srp is not None and _srp.get("p2pi")          # blocked only where they run (F8,
          and not (_p2pn and _p2pn.get("state") == "error")):                                 # pick F5: a node never heard from too)
        issues.append(perr("torrents on {v1} have no way out (the route is unavailable) — blocked until it is", v1=", ".join(p2p_iface)))
    for _xn in exits_offline or ():
        issues.append(perr("Routing on this node sends traffic out through {v1}, which is offline — that traffic is refused "
                           "until {v1} is back", v1=_xn))
    return issues

# A DNS name as an operator may type it: labels of letters/digits/hyphens, at least one dot, or a bare
# single label (a short internal name). Deliberately not a URL — this field holds a host, never a scheme.
_HOSTNAME_RE = re.compile(r"^(?!-)[a-z0-9-]{1,63}(?<!-)(\.(?!-)[a-z0-9-]{1,63}(?<!-))*$")


def _current_ivk_pub(deps):
    """The vault public key nodes are currently asked to seal to — "" when escrow is off or unset. A blob
    sealed to anything else cannot be opened by the vault the operator holds now."""
    v = load_sub_vault(deps) or {}
    return (v.get("ivk_pub") or "") if v.get("ivk_enabled") else ""


def _missing_ifaces(c, snap, ivk_pub=None):
    """USER interfaces the panel EXPECTS (it holds a persisted _lastcfg from when they were up) but the node
    no longer reports — a delete / wipe / re-install. Keyed by iface, each entry carries the last-known config
    to recreate it plus the key source: 'backup' (node still has the private key on disk → clean restore) or
    'vault' (node key gone → recover from the operator vault, if escrowed) or '' (no key → recreate = clients
    re-import). Empty when nothing is missing. Mesh/system links are panel-owned and self-heal, so excluded."""
    live = snap.get("interfaces") or {}
    backups = snap.get("iface_key_backups") or {}
    out = {}
    for ifn, ov in (c.get("ifaces") or {}).items():
        if ifn in live or ov.get("system"):
            continue
        lc = ov.get("_lastcfg")
        if not lc:
            continue                       # never captured a config → can't offer a clean recreate
        blessed = ov.get("public_key") or ""
        key_src = _iface_key_source(ov, backups.get(ifn), ivk_pub)
        _lp = ov.get("listen_port") or lc.get("listen_port")
        _mtu_o = ov.get("mtu") or lc.get("mtu")
        _awg_o = ov.get("awg_params") if isinstance(ov.get("awg_params"), dict) and ov["awg_params"] else lc.get("awg_params")
        out[ifn] = {"subnet": lc.get("subnet"), "listen_port": _lp,
                    "mtu": _mtu_o,
                    "address": lc.get("address"), "awg_params": _awg_o or {},
                    "endpoint_host": ov.get("endpoint_host") or "",
                    "dns": list(ov["dns"]) if isinstance(ov.get("dns"), list) else None,
                    "keepalive": (ov["keepalive"] if isinstance(ov.get("keepalive"), int)
                                  and not isinstance(ov.get("keepalive"), bool) else None),
                    # the device-access level the record holds, absent said out loud as "user" (A3), so a recreate never
                    # seeds the panel-wide default over a chosen level (DEVICE-ACCESS §11.2 F1)
                    "reach": reach_level(ov.get("reach")),
                    "public_key": blessed, "key_source": key_src,
                    **({"awaiting_key": True} if ifn in set(snap.get("ifaces_awaiting_key") or []) else {})}
        if key_src == "vault":   # the escrowed ciphertext blob — the browser unseals it (operator-unlock) at restore
            out[ifn]["key_blob"] = ov.get("key_blob")
    return out


def _iface_key_source(ov, backup_pub, ivk_pub):
    """Where an interface's ORIGINAL private key can come back from: 'backup' (the node still holds it on
    disk) > 'vault' (a blob for this blessed key, sealed to the vault the operator holds NOW) > '' (nowhere
    — a recreate mints a new identity and every client on it re-imports).

    Extracted because `_missing_ifaces` and `_broken_ifaces` both need it and answering it twice is how two
    lists start disagreeing about whether a restore will keep the clients working. The vault arm carries the
    provenance rule the escrow fix established: a blob sealed to a DIFFERENT vault matches the interface key
    perfectly and opens for nobody, so it must not read as escrow."""
    blessed = ov.get("public_key") or ""
    if backup_pub and backup_pub == blessed:
        return "backup"
    _kb = ov.get("key_blob") or {}
    if blessed and _kb.get("pub") == blessed and ivk_pub and _kb.get("vault") == ivk_pub:
        return "vault"
    return ""


def _unmanaged_ifaces(c, snap):
    """Report configured node interfaces missing from the panel record."""
    ifs, dele = (c.get("ifaces") or {}), (c.get("delete") or {})
    return [ifn for ifn in sorted((snap.get("interfaces") or {})) if ifn not in ifs and ifn not in dele]


def _broken_ifaces(c, snap, ivk_pub=None):
    """USER interfaces the node DOES report, but whose device is not there — reported with `down` set,
    every meta field null. The "present but wrong" case, which `_missing_ifaces` is structurally blind to
    because it keys on ABSENCE from the snapshot.

    Measured on a live node (§7.5 of the rebuild plan): delete an interface's device and .conf but leave
    the node's own record, and every repair door in the product is shut — `_missing_ifaces` cannot see it,
    `/api/iface/recreate` refuses it as "already present", the node declines the create, and the op its own
    error recommends cannot rewrite a conf that is gone. This list is what opens them.

    ⚠️ SCOPE, and it is narrower than T-8 was first written to be. A re-keyed interface — up and healthy,
    serving a key that is not the blessed one — is NOT here, because the panel already handles it: the sync
    loop records `_drift["public_key"]`, `/api/iface/restore` stages `iface_key {action:"restore"}`, and the
    node reverts from its on-disk backup. Repeating that condition in a second list is how two lists start
    disagreeing about one interface. The two never overlap by construction: a down interface reports
    `public_key: null`, and drift is only recorded `if rep_pub`.

    ⚠️ `stopped` is not broken either. An interface stopped by the operator is doing what was asked; the
    node reports the two separately and so must this. Mesh/system links self-heal, so they are excluded."""
    live = snap.get("interfaces") or {}
    backups = snap.get("iface_key_backups") or {}
    out = {}
    for ifn, ov in (c.get("ifaces") or {}).items():
        ent = live.get(ifn)
        if ent is None or ov.get("system") or not ent.get("down"):
            continue                       # absent -> _missing_ifaces' job; mesh -> self-heals; up -> fine
        lc = ov.get("_lastcfg") or {}
        # A recreate needs somewhere to recreate FROM. With no _lastcfg there is nothing to rebuild the
        # subnet / port / address out of, so say so rather than offer a button that cannot work.
        out[ifn] = {"state": "down", "repair": ("recreate" if lc.get("subnet") else ""),
                    "subnet": lc.get("subnet"), "listen_port": lc.get("listen_port"),
                    "address": lc.get("address"), "awg_params": lc.get("awg_params") or {},
                    "public_key": ov.get("public_key") or "",
                    "key_source": _iface_key_source(ov, backups.get(ifn), ivk_pub)}
    return out


def _ghost_refs(roster):
    """{node_id: {iface: [peer_id,...]}} — every (node, iface) the roster references, walked ONCE per
    /api/state (not per node) so ghost detection adds no measurable cost."""
    refs = {}
    for pid, p in (roster.get("peers") or {}).items():
        for t in (p.get("targets") or []):
            n, i = t.get("node"), t.get("iface")
            if _is_self_contained_target(t):   # WDTT/csqtt own their own interface (snap.wdtt/.csqtt,
                continue                        # not snap.interfaces) — never a WG ghost/missing interface
            if n and i:
                refs.setdefault(n, {}).setdefault(i, []).append(pid)
    return refs

def _ghost_ifaces(c, snap, refs, online):
    """GHOST interfaces: the roster still references (node, iface) but the node no longer reports it AND the
    panel has NO persisted _lastcfg for it — a lost/keyless interface with nothing to restore (the user's
    original 'why no restore, no missing interface?' case: wg1 gone, _lastcfg None). _missing_ifaces skips
    these (it requires _lastcfg), so Restore can't help — the ONLY fix is recreate-fresh + rekey every peer
    (clients re-import). Warm-but-keyless ifaces (a _lastcfg exists but key_source '') DO surface via
    _missing_ifaces and are handled there. Mesh/system links self-heal → excluded. Keyed by iface →
    {peer_ids, peer_count}.
    ONLINE-GATED: an OFFLINE node's interfaces aren't 'lost' — we just can't see them; only a node that's
    reporting NOW but without the iface is a real ghost (the SPA adds a further ~2min grace on top)."""
    if not online or not refs:
        return {}
    live = snap.get("interfaces") or {}
    known = c.get("ifaces") or {}
    out = {}
    for ifn, pids in (refs or {}).items():
        if ifn in live:                      # node still has it → not a ghost
            continue
        ov = known.get(ifn) or {}
        if ov.get("system"):                 # mesh/system link → self-heals
            continue
        if ov.get("_lastcfg"):               # has a saved config → surfaced (recoverable or keyless) via _missing_ifaces
            continue
        uniq = sorted(set(pids))
        out[ifn] = {"peer_ids": uniq, "peer_count": len(uniq),
                    # DEVICE ACCESS §11.2 review R6 — a record with no saved config can still hold a chosen level; with no record
                    # at all there is none to keep, so the recreate sheet's panel-wide default stands
                    **({"reach": reach_level(ov.get("reach"))} if ifn in known else {})}
    return out

PROC_GRACE = 300          # 5 min in-progress window; a stuck op (lost connection) then falls back to failed
IFACE_AUTOSTART_GAPS = (0, 60, 300)   # wait before the 1st / 2nd / 3rd automatic start of a DOWN interface.
#                                     Length = how many tries; after that the panel stops and leaves the issue standing.
PROC_SUCCESS_SHOW = 20    # success tag lifetime — long enough to ride through a master convert's node phase (so the
                          # host "converted" stays put instead of blanking between the panel-up stamp and the node
                          # stage), still short enough to clear shortly after the operator has seen it
PROC_INPROGRESS = ("reinstalling", "converting-bare", "converting-docker", "updating", "uninstalling")
PROC_SUCCESS = ("reinstalled", "reinstalled-updated", "converted-bare", "converted-docker", "updated", "uptodate",
                "adopted-container")
_PROC_FAIL = {"reinstalling": "reinstall-failed", "converting-bare": "convert-failed",
              "converting-docker": "convert-failed", "updating": "update-failed", "uninstalling": "uninstall-failed"}
def _proc_inprogress(s): return s in PROC_INPROGRESS
def _proc_terminal(s):   return bool(s) and (s in PROC_SUCCESS or s.endswith("-aborted") or s.endswith("-failed") or s == "failed")
def _proc_view(state, at):
    if not state:
        return None
    age = time.time() - (at or 0)
    if state in PROC_SUCCESS:                     # green confirmation, then gone
        return state if age <= PROC_SUCCESS_SHOW else None
    if state in PROC_INPROGRESS:                  # running; a stuck one (no terminal ever arrived) → failed
        return state if age <= PROC_GRACE else _PROC_FAIL.get(state, "failed")
    return state                                  # explicit aborted/failed terminal → persists until dismissed


def _ip_literal(s):
    """True when `s` is an IP address literal rather than a hostname — the §1.5 test that decides whether
    an address may be carried across a rebuild. A hostname always survives (it re-resolves to the new box);
    an IP has to be re-checked against what the box actually has.

    Takes str only: `ipaddress.ip_address(10)` cheerfully returns 0.0.0.10, so an int slipping in here
    would classify a port number as an address."""
    if not isinstance(s, str):
        return False
    v = s.strip()
    if v[:1] == "[" and v[-1:] == "]":              # bracketed v6, as it appears inside a host:port
        v = v[1:-1]
    if not v:
        return False
    try:
        ipaddress.ip_address(v)
        return True
    except ValueError:
        return False
def _hostport_split(s):
    """"host:port" -> (host, port|None). Handles a bracketed IPv6 literal and a BARE one, which is the
    case a plain rsplit(":") silently corrupts — it turns "2001:db8::1" into host "2001:db8:" port None.

    ⚠️ The panel's own writers do not bracket: apply_iface_meta builds f"{host}:{port}" whatever `host`
    is, so an IPv6 endpoint_host would already be malformed before it reached here (node_public_ip is
    IPv4-only, so nothing generates one today). This parses the correct forms anyway rather than encoding
    that limitation into the fingerprint, which has to keep working when the endpoint side grows v6."""
    v = (s or "").strip()
    if not v:
        return "", None
    if v[:1] == "[":                                 # [v6]:port  /  [v6]
        end = v.find("]")
        if end < 0:
            return v, None                           # malformed — hand it back whole rather than inventing a split
        host, rest = v[1:end], v[end + 1:]
        if rest[:1] == ":" and rest[1:].isdigit():
            return host, int(rest[1:])
        return host, None
    if v.count(":") > 1:                             # bare IPv6 literal: no port can be expressed
        return v, None
    host, sep, port = v.rpartition(":")
    if not sep:
        return v, None
    return (host, int(port)) if port.isdigit() else (v, None)
def _iface_field_eq(want, got):
    """Did the node build this interface field as the panel asked? Compared by VALUE, not by type: the
    request writes `mtu` as a string (`create[<if>]["mtu"] = str(_mtu)`) while the snapshot reports it as an
    int, and a naive `!=` would call every restored interface a mismatch. A dict (awg_params) is compared
    only over the keys the request named — the node reports the full set."""
    if isinstance(want, dict):
        return isinstance(got, dict) and all(str(got.get(k)) == str(v) for k, v in want.items())
    if want in (None, ""):
        return True                        # the request did not ask for this field
    return str(want) == str(got)
def iface_restore_req(ov, ivk_pub="", fresh=False):
    """The `create` request that puts ONE interface back with its ORIGINAL identity — or None when the panel
    holds nothing to rebuild it from.

    ONE function, deliberately: /api/iface/recreate restores a single interface an operator pointed at, and
    the rebuild adapter restores every interface on a box being replaced. Written twice they would be two
    lists that drift, which is the failure this whole plan exists to stop.

    ⚠️ THE BLESSED VALUE WINS OVER `_lastcfg`. `_lastcfg` is rebuilt from whatever the node last REPORTED,
    so a box that came back with a fresh interface has already overwritten it — restoring from it would
    faithfully recreate the wrong identity. `ov["awg_params"]` / `ov["listen_port"]` / `ov["mtu"]` are what
    the panel OWNS (blessed on first sight, a later node-side change held as `_drift`), so they are the
    identity to put back; `_lastcfg` is the fallback for whatever the panel owns nothing of.

    The private key is NOT here. The node restores it from its own on-disk backup, or the browser unseals it
    from the operator vault and passes `sealed_key` at the call site — the panel never holds one."""
    ov = ov or {}
    lc = ov.get("_lastcfg") or {}
    if not lc.get("subnet"):
        return None                       # never captured a config → nothing to recreate it from
    req = {"cmd": ["awg"], "subnet": lc.get("subnet"), "restore": True}      # the tool is settled below, from the AWG params
    _port = ov.get("listen_port") or lc.get("listen_port")
    if str(_port or "").isdigit() or isinstance(_port, int):
        req["listen_port"] = int(_port)
    if (lc.get("address") or "").strip():
        req["address"] = lc["address"].strip()
    _awg = ov.get("awg_params") if isinstance(ov.get("awg_params"), dict) and ov["awg_params"] else lc.get("awg_params")
    if isinstance(_awg, dict) and _awg:
        req["awg_params"] = _awg
        if ov.get("awg_exact") and _awg is ov.get("awg_params"):
            req["awg_params_exact"] = True     # the set is whole: the node writes it as it is and fills in nothing it omits
    else:
        req["cmd"] = ["wg"]
    _mtu = ov.get("mtu") or lc.get("mtu")
    if str(_mtu or "").isdigit() or isinstance(_mtu, int):
        req["mtu"] = str(int(_mtu))       # recreate at the MTU it was serving, not the agent's 1280
    if not fresh and ivk_pub and _iface_key_source(ov, None, ivk_pub) == "vault":
        req["hold_key"] = True
    return req


def node_describe(snapshot):
    """Server/interface info from a node's pushed snapshot (config-building + UI)."""
    interfaces = {}
    for iface, blk in (snapshot.get("interfaces") or {}).items():
        meta = blk.get("meta") or {}
        peers = blk.get("peers") or []
        used = sorted({(p.get("allowed_ips") or "").split("/")[0]
                       for p in peers if p.get("allowed_ips")})
        interfaces[iface] = {
            "public_key": meta.get("public_key"), "listen_port": meta.get("listen_port"),
            "backup_public_key": meta.get("backup_public_key"),   # node's key-backup pubkey → drift restorability
            "endpoint": meta.get("endpoint"), "address": meta.get("address"),
            "subnet": meta.get("subnet"), "awg_params": meta.get("awg_params", {}),
            # WHICH TOOL drives it, as the node reports it (absent from a node too old to say). The UI
            # prefers this over "does it carry obfuscation params", which is a fact about the FILE.
            **({"tool": meta["tool"]} if meta.get("tool") in ("wg", "awg") else {}),
            "mtu_reported": meta.get("mtu"),   # the node's ACTUAL link MTU (None from a node too old to report it)
            "dns": meta.get("dns", []), "used_ips": used, "peer_count": len(peers),
            "rx_speed": sum(p.get("rx_speed", 0) or 0 for p in peers),   # per-iface throughput (mesh link cards)
            "tx_speed": sum(p.get("tx_speed", 0) or 0 for p in peers),
            "rx_bytes": sum(p.get("rx_bytes", 0) or 0 for p in peers),   # cumulative totals (connection card)
            "tx_bytes": sum(p.get("tx_bytes", 0) or 0 for p in peers),
            "handshake_age": min((p.get("handshake_age") for p in peers if p.get("handshake_age") is not None), default=None),
            "peer_endpoint": (peers[0].get("endpoint") if len(peers) == 1 else None),   # the actual dialed peer endpoint (mesh link → connection card "Endpoint")
        }
    return {"ok": True, "op": "describe",
            "data": {"hostname": snapshot.get("hostname"), "interfaces": interfaces}}


def apply_iface_meta(node_cfg, interfaces, ivk_pub="", vault_restore_ok=False):
    """Overlay panel-side per-interface overrides onto node-reported metadata, in place:
    a public endpoint host/port (what clients dial — may differ from the node's listen port
    behind NAT), and a default DNS / MTU used when rendering configs & creating new peers.
    Does not change the node — only what the panel emits in client configs. Returns interfaces."""
    node_ep = (node_cfg or {}).get("endpoint_host")
    ifov = (node_cfg or {}).get("ifaces") or {}
    for ifn, ifc in interfaces.items():
        ov = ifov.get(ifn) or {}
        rep = ifc.get("endpoint") or ""
        rep_host = rep.rsplit(":", 1)[0] if ":" in rep else rep
        host = ov.get("endpoint_host") or node_ep or rep_host
        # listen_port is the desired UDP port — the node converges its ListenPort to it, and the
        # client Endpoint uses it (listen IP == connection IP for our purposes).
        want_port = ov.get("listen_port")
        port = want_port or ifc.get("listen_port")
        if host and port:
            ifc["endpoint"] = f"{host}:{port}"
        if want_port:
            ifc["desired_port"] = want_port   # != reported listen_port => "updating" in the UI
        if ov.get("dns") is not None:                # always serve dns as a list (the UI expects one)
            d = ov["dns"]
            ifc["dns"] = d if isinstance(d, list) else [s.strip() for s in str(d).split(",") if s.strip()]
        want_mtu = ov.get("mtu")
        ifc["mtu"] = want_mtu or ifc.get("mtu_reported") or 1280
        if want_mtu:
            ifc["desired_mtu"] = want_mtu            # != mtu_reported => "updating" (same tell as desired_port)
        if ov.get("keepalive") is not None:
            ifc["keepalive"] = ov["keepalive"]
        ifc["egress_ip"] = ov.get("egress_ip") or ""   # per-interface source/egress IP (blank = auto/MASQUERADE)
        ifc["wan_iface"] = ov.get("wan_iface") or ""   # per-interface egress WAN NIC (blank = auto-detect)
        ifc["egress_mode"] = ov.get("egress_mode") or "direct"   # direct = SNAT a NIC | forward = whole-iface cascade (P2) | smart = per-dest rules (P3)
        ifc["egress_node"] = ov.get("egress_node") or ""         # forward target node id
        ifc["exit_id"] = ov.get("exit_id") or ""                 # egress via an exit DEVICE on this node (P2), by id
        ifc["routing"] = ov.get("routing") or []                 # smart-routing rule list (P3): [{category,action,node}]
        ifc["routing_exit_ips"] = dict(ov.get("routing_exit_ips") or {})   # {far node: address} its rules leave that node by (P2 §4.2)
        ifc["reach"] = reach_level(ov.get("reach"))                 # device access: who may open connections to devices here (absent = user, A3)
        ifc["block"] = ov.get("block") or []                     # active block-category ids (content-filter + traffic/abuse); drives the Block-traffic modal section
        ifc["p2p"] = ov.get("p2p") or None                        # its own torrent choice (IFACE-P2P-PICK §2.1) — published, or the next save clears it
        ifc["system"] = bool(ov.get("system"))         # panel-managed mesh link interface (a node↔node connection)
        ifc["link_node"] = ov.get("link_node") or ""   # the peer node this link connects to (SPA resolves the name)
        _lr = ((node_cfg.get("links") or {}).get(ifc["link_node"]) or {}) if ifc["link_node"] else {}
        ifc["dial_src"] = _lr.get("dial_src") or ""             # source IP this node dials the peer FROM
        ifc["dial_endpoint"] = _lr.get("dial_endpoint") or ""   # which of the peer's IPs this node dials TO (override the peer's ingress)
        ifc["relay"] = _lr.get("relay") or {}                   # this leg's datapath: {} / {mode: forward|relay, cc_cli}
        _ukb = ov.get("key_blob") or {}
        if (ivk_pub and _ukb.get("ct") and not ov.get("system")
                and _ukb.get("pub") == (ov.get("public_key") or "") and _ukb.get("vault") != ivk_pub):
            ifc["escrow_unverified"] = {k: _ukb.get(k) for k in ("pub", "eph", "ct", "mac")}
        ifc["drift"] = dict(ov.get("_drift") or {})    # settings edited directly on the server (key → the node's value)
        if ifc["drift"].get("public_key"):
            _bk = ifc.get("backup_public_key")
            if _bk:
                ifc["drift_restorable"] = (_bk == ov.get("public_key"))
            if ivk_pub and vault_restore_ok and _iface_key_source(ov, None, ivk_pub) == "vault":
                ifc["drift_key_blob"] = ov.get("key_blob")
        ovawg = ov.get("awg_params")
        if isinstance(ovawg, dict) and ovawg:
            rep_awg = dict(ifc.get("awg_params") or {})
            ifc["awg_reported"] = rep_awg
            # The RECORD decides the generation (docs/AWG3-PLAN.md §7.1): a 3.x key the node still reports after a switch
            # back to 2.0 is not rendered into a single config.
            ifc["awg_params"] = {**{k: v for k, v in rep_awg.items() if k not in AWG3_FIELDS},
                                 **{k: ovawg[k] for k in ovawg if ovawg[k] not in (None, "")}}
            if ov.get("awg_exact"):
                # …and a WHOLE record is the set, alone: a key set to none and still on the device until the node applies
                # it must not come back through the report — the Edit sheet, filled from this, would send it back.
                ifc["awg_params"] = {k: ovawg[k] for k in ovawg if ovawg[k] not in (None, "")}
                ifc["awg_exact"] = True
    return interfaces


def node_held_addrs(snap, node_rec=None):
    """IPv4 addresses a node holds ITSELF, outside any peer: what it reports (its own IPs, every exit's tunnel address,
    every tunnel or card it could use as one) plus the address of each imported exit profile the panel stores, which a
    disabled exit keeps. Anything unreadable is skipped, and a node too old to report these adds nothing.

    ⚠️ MEASURED on swgt, 2026-09-17: an imported exit's profile carried its provider's client address 10.9.0.2, inside
    awg2's 10.9.0.0/24, and the picker handed the same address to a new router peer on awg2. The node then owned the
    router's address: every packet from it was dropped as spoofed and every reply was delivered to the node itself, while
    the handshake kept the peer reading online."""
    out = set()
    def add(v):
        for part in re.split(r"[,\s]+", v if isinstance(v, str) else ""):
            try:
                out.add(str(ipaddress.IPv4Address(part.split("/")[0])))
            except ValueError:
                pass
    snap = snap if isinstance(snap, dict) else {}
    for a in snap.get("node_ips") or []:
        add(a)
    for key in ("exits", "exit_candidates"):
        for e in snap.get(key) or []:
            add((e or {}).get("address") if isinstance(e, dict) else None)
    for e in ((node_rec or {}).get("exits") if isinstance(node_rec, dict) else None) or []:
        prof = e.get("profile") if isinstance(e, dict) else None
        add(prof.get("address") if isinstance(prof, dict) else None)
    return out


def panel_next_ip(snaps, roster, nodes, iface, node_store=None):
    """Lowest address free on every selected node's iface, unclaimed in the roster, and not one the node holds itself
    (`node_held_addrs`)."""
    used, subnet = set(), None
    for node in nodes:
        snap = snaps.get(node)
        if not snap:
            return err("next-ip", f"{node}: no snapshot yet (is the node online?)", "offline")
        blk = (snap.get("interfaces") or {}).get(iface)
        if not blk:
            return err("next-ip", f"{node} has no interface {iface!r}", "bad_request")
        used |= node_held_addrs(snap, (node_store or {}).get(node))
        meta = blk.get("meta") or {}
        for p in (blk.get("peers") or []):
            ip = (p.get("allowed_ips") or "").split("/")[0]
            if ip:
                used.add(ip)
        used.add((meta.get("address") or "").split("/")[0])
        if subnet is None:
            subnet = meta.get("subnet")
    for p in (roster.get("peers") or {}).values():
        if not isinstance(p, dict):
            continue
        for t in p.get("targets", []):
            if t.get("iface") == iface and t.get("ip"):   # IPs only collide within one iface's subnet
                used.add(t["ip"].split("/")[0])
    if not subnet:
        return err("next-ip", "no subnet info in snapshot")
    net = ipaddress.ip_network(subnet, strict=False)
    for host in net.hosts():
        if str(host) not in used:
            return {"ok": True, "op": "next-ip",
                    "data": {"iface": iface, "next_ip": str(host) + "/32", "subnet": subnet}}
    return err("next-ip", "no free addresses across selected nodes", "subnet_full")


# fleet mesh (node↔node tunnels)

def mesh_cfg(deps):
    f = deps.get("fleet") or {}
    r = (deps.get("panel_settings") or {}).get("reserved") or {}   # Panel settings override the fleet/defaults
    return {"subnet": r.get("mesh_subnet") or f.get("mesh_subnet", "10.255.0.0/16"), "mtu": int(f.get("mesh_mtu", 1280)),
            "keepalive": int(f.get("mesh_keepalive", 25)),
            "port_base": int(r.get("mesh_port_base") or f.get("mesh_port_base", 9999)),
            "port_span": int(r.get("port_span") or 100),
            "iface_prefix": (r.get("iface_prefix") or f.get("mesh_iface_prefix") or "swg_")}


def node_mesh_cfg(deps, node):
    """Global mesh_cfg with this node's per-node overrides applied (Node settings → mesh subnet / port /
    prefix). New links involving the node use these; empty fields fall back to the global (panel) values."""
    mc = dict(mesh_cfg(deps)); n = node or {}
    if n.get("mesh_subnet"):
        mc["subnet"] = n["mesh_subnet"]
    if str(n.get("mesh_port") or "").strip().isdigit():
        mc["port_base"] = int(n["mesh_port"])
    if n.get("mesh_prefix"):
        mc["iface_prefix"] = n["mesh_prefix"]
    return mc


def is_system_iface(deps, nodes, node_id, iface):
    """True if (node_id, iface) is a panel-managed inter-node mesh link (swg_*) — never a valid
    user-peer target. Authoritative signal is the stored `.system` flag; fall back to the node's
    reserved mesh prefix so a link that predates the flag is still rejected."""
    if not iface:
        return False
    n = nodes.get(node_id) or {}
    ov = (n.get("ifaces") or {}).get(iface)
    if isinstance(ov, dict) and ov.get("system"):
        return True
    pfx = node_mesh_cfg(deps, n).get("iface_prefix") or "swg_"
    return str(iface).startswith(pfx) or str(iface).startswith("swg_")


def reserved_conflict(deps, nodes, node, subnet=None, port=None, name=None, keep=()):
    """Reject user interfaces / turn-proxies that collide with the mesh's reserved ranges (subnet / port
    band / iface-name prefix) — evaluated against THIS node's EFFECTIVE mesh config (per-node overrides over
    the panel default). Also reserves the /16 around every in-use link subnet across the fleet, so an
    existing fleet on a different range stays protected. Returns an error string, or None if no conflict.
    A port in the devices' torrent pool (P2P_PORT_POOL) is refused unless it is one the record already holds (`keep`)."""
    mc = node_mesh_cfg(deps, node)
    prefix = mc.get("iface_prefix") or "swg_"
    if name and str(name).startswith(prefix):
        return f"names starting with '{prefix}' are reserved for system mesh links"
    if subnet:
        try:
            net = ipaddress.ip_network(subnet, strict=False)
        except Exception:
            net = None
        if net is not None:
            reserved = []
            with contextlib.suppress(Exception):
                reserved.append(ipaddress.ip_network(mc["subnet"], strict=False))
            for n in (nodes or {}).values():
                for lr in (n.get("links") or {}).values():
                    with contextlib.suppress(Exception):
                        ln = ipaddress.ip_network(lr.get("subnet"), strict=False)
                        reserved.append(ln.supernet(new_prefix=16) if ln.version == 4 and ln.prefixlen > 16 else ln)
            for rn in reserved:
                if net.version == rn.version and net.overlaps(rn):
                    return f"subnet overlaps the reserved system mesh range ({rn})"
    if port is not None and str(port).strip().isdigit():
        base = mc["port_base"]; span = mc.get("port_span", 100)
        if base <= int(port) < base + span:
            return f"port {port} is in the reserved system mesh range ({base}–{base + span - 1})"
        return p2p_pool_refusal(port, keep)
    return None


def _tunnel_networks(node):
    """A node's WDTT (and RAW) and csqtt subnets, from its record, as [(name, ip_network)] — the subnets it holds that no
    describe reports. ONE walk for the fleet-unique check at create and the cascade plan's clash guard (T37), so a subnet
    kind added later is added to both. A RAW subnet is named "<instance> (raw)"."""
    out = []
    for ifn, w in ((node or {}).get("wdtt") or {}).items():
        for nm, a in ((ifn, (w or {}).get("wg_addr")), (ifn + " (raw)", (w or {}).get("raw_addr"))):
            if a:
                with contextlib.suppress(ValueError, TypeError):
                    out.append((nm, ipaddress.ip_network(str(a), strict=False)))
    for ifn, c in ((node or {}).get("csqtt") or {}).items():
        if (c or {}).get("tun_addr"):
            with contextlib.suppress(ValueError, TypeError):
                out.append((ifn, ipaddress.ip_network(str(c["tun_addr"]), strict=False)))
    return out


def _fleet_user_networks(deps, nodes, skip_node=None, skip_iface=None):
    """Every USER interface subnet in use across the fleet — wg/awg (from each node's reported describe) + WDTT
    (wg_addr) — as (node_id, iface, ip_network), excluding a (skip_node, skip_iface) being created/edited and
    system/mesh links. Interface subnets must be UNIQUE fleet-wide: two nodes sharing a subnet make the mesh's
    per-subnet return routing ambiguous (a cascaded client's return traffic can't be told from the other node's
    identical subnet), which black-holes it — see the wdtt0/wdtt0 10.66.66.0/24 collision."""
    snaps = deps.get("node_snaps") or {}
    out = []
    for nid, node in (nodes or {}).items():
        snap = snaps.get(nid)
        if snap:
            with contextlib.suppress(Exception):
                for ifn, m in ((node_describe(snap).get("data") or {}).get("interfaces") or {}).items():
                    if (m or {}).get("system") or (nid == skip_node and ifn == skip_iface):
                        continue
                    with contextlib.suppress(Exception):
                        out.append((nid, ifn, ipaddress.ip_network((m or {}).get("subnet") or "", strict=False)))
        # WDTT (a qWDTT RAW listener owns a SECOND subnet — just as unique-per-fleet) and csqtt TUN subnets; an instance
        # being created/edited is skipped whole, RAW with it
        for nm, net in _tunnel_networks(node):
            if nid == skip_node and nm.split(" (raw)")[0] == skip_iface:
                continue
            out.append((nid, nm, net))
    return out


def subnet_fleet_conflict(deps, nodes, subnet, skip_node=None, skip_iface=None):
    """Error string if `subnet` overlaps another user interface's subnet anywhere in the fleet, else None."""
    try:
        net = ipaddress.ip_network(subnet, strict=False)
    except Exception:
        return None
    for nid, ifn, on in _fleet_user_networks(deps, nodes, skip_node, skip_iface):
        if net.version == on.version and net.overlaps(on):
            nm = ((nodes.get(nid) or {}).get("name") or nid)
            return "subnet overlaps %s on %s (%s) — interface subnets must be unique across the fleet" % (ifn, nm, on)
    return None


WDTT_RAW_PORT = 56003


def _wdtt_listen_ip(inst):
    """The address half of an instance's `listen` ("203.0.113.5:56010" → "203.0.113.5"); "" for a wildcard bind.

    This is what a client's link carries as the host, and the app NEVER overrides it — so it, not the node, is
    what scopes RAW: two instances on two addresses of one box can each run a raw listener on the same port."""
    ip = (inst or {}).get("listen") or ""
    ip = ip.rsplit(":", 1)[0].strip() if ":" in ip else ""
    return "" if ip in ("0.0.0.0", "::", "[::]") else ip


def _csqtt_default_fork():
    """The csqtt fork to assume when a caller names none — the catalog's first csqtt entry. One implementation
    exists today (amurcanov's), but the catalog is fork-shaped and others are being built, so nothing hardcodes
    the id."""
    for fid, meta in TURN_SERVERS.items():
        if (meta or {}).get("kind") == "csqtt":
            return fid
    return "csqtt"


def _wdtt_alloc_raw_iface(nodes, nid, iface):
    """A free TUN name for an instance's RAW listener. `wdtt3` → `wdttraw3` reads best, but ADOPTED servers keep
    whatever name they had (letters, digits, _ and -), so a digit-strip can collide or come out empty — fall back
    to the first free wdttrawN on the node."""
    taken = {(w or {}).get("raw_iface") for ifn, w in ((nodes.get(nid) or {}).get("wdtt") or {}).items() if ifn != iface}
    digits = re.sub(r"\D", "", iface or "")
    if digits and ("wdttraw" + digits) not in taken:
        return "wdttraw" + digits
    for n in range(1, 10000):
        if ("wdttraw%d" % n) not in taken:
            return "wdttraw%d" % n
    return ""


def _fork_raw_default(deps, fork):
    """Does a NEWLY created server of this fork come up with RAW-IP on?

    Per fork, stored beside that fork's other server defaults. `wdtt_raw_default` is the fleet-wide key this
    used to be; it stays as the fallback so panels that set it keep the behaviour they chose, without a
    migration pass rewriting anyone's settings."""
    ps = deps.get("panel_settings") or {}
    per = ((ps.get("turn_server_defaults") or {}).get(fork) or {})
    if isinstance(per.get("raw"), bool):
        return per["raw"]
    return ps.get("wdtt_raw_default", True) is not False


def _wdtt_raw_holder(nodes, nid, ip, skip_iface=None):
    """The interface on `nid` already offering RAW on address `ip`, or "" — one raw listener per ADDRESS.

    A wildcard-bound instance ("" ip) grabs the port on every address, so it collides with, and is collided
    with by, any address on the node."""
    for ifn, w in ((nodes.get(nid) or {}).get("wdtt") or {}).items():
        if ifn == skip_iface or not isinstance(w, dict) or not w.get("raw_port"):
            continue
        wip = _wdtt_listen_ip(w)
        if wip == ip or not wip or not ip:      # same address, or either side is a wildcard bind
            return ifn
    return ""


def _wdtt_raw_clear_others(nodes, nid, ip, keep_iface):
    """Hand RAW over to `keep_iface`: strip it from the instances it would collide with — those on the SAME
    listen address (or on a wildcard bind). Returns the interface it was taken from, or "".

    Why it must move rather than coexist: the app resolves ONE raw port for every server and replaces the
    link's port with it, so two raw listeners on one ADDRESS can never both be reachable — the second is a
    port no client dials, and its users fail with nothing to see. Their links keep working; those peers fall
    back to WireGuard mode. Instances on a DIFFERENT address are untouched: the host is the one thing the app
    does take from the link."""
    moved = ""
    for ifn, w in ((nodes.get(nid) or {}).get("wdtt") or {}).items():
        if ifn == keep_iface or not isinstance(w, dict) or not w.get("raw_port"):
            continue
        wip = _wdtt_listen_ip(w)
        if not (wip == ip or not wip or not ip):
            continue
        moved = moved or ifn
        for k in ("raw_port", "raw_iface", "raw_addr"):
            w.pop(k, None)
    return moved


def _wdtt_alloc_raw_subnet(deps, nodes, nid, iface):
    """First free /24 in 10.70.0.0/16 for a qWDTT RAW TUN, or "" if the space is full.

    10.70/16 is the fork's own raw range, kept so an unpatched build's defaults still land inside it. A /24
    per instance is plenty (a raw peer is one address) and leaves 256 instances fleet-wide; the allocation
    goes through the SAME fleet-uniqueness check as any interface subnet, so it can never overlap a wg,
    csqtt or sibling raw subnet.
    """
    for third in range(0, 256):
        cand = "10.70.%d.1/24" % third
        if not subnet_fleet_conflict(deps, nodes, cand, skip_node=nid, skip_iface=iface):
            return cand
    return ""


DEFAULT_AWG_GEN = "3.1"
AWG31_MIN_S = 12
AWG31_MAX_S = 20
AWG31_HEADERS = {"H1": 1, "H2": 2, "H3": 3, "H4": 4}


def gen_awg_params(gen=DEFAULT_AWG_GEN, s_max=AWG31_MAX_S):
    """Panel-generated AmneziaWG obfuscation params (dict form). The panel owns each LINK's params and
    pushes the SAME dict to both ends, because AmneziaWG only handshakes when both peers share identical
    obfuscation — the node's own random per-iface params (swg-agent _awg_obfuscation) would differ."""
    if gen == "3.1":
        s = AWG31_MIN_S + secrets.randbelow(min(AWG31_MAX_S, s_max) - AWG31_MIN_S + 1)
        return {"Jc": 4 + secrets.randbelow(3), "Jmin": 40, "Jmax": 70,
                "S1": s, "S2": s, "S3": s, "S4": s, **AWG31_HEADERS}
    s1 = 15 + random.randint(0, 135); s2 = 15 + random.randint(0, 135)
    while s2 == s1 or s2 == s1 + 56:
        s2 = 15 + random.randint(0, 135)
    s3 = 15 + random.randint(0, 85); s4 = 15 + random.randint(0, 85)
    b = [base + random.randint(0, 899999999) for base in (5, 1000000000, 2000000000, 3000000000)]
    w = 15
    return {"Jc": 4, "Jmin": 40, "Jmax": 70, "S1": s1, "S2": s2, "S3": s3, "S4": s4,
            "H1": f"{b[0]}-{b[0]+w}", "H2": f"{b[1]}-{b[1]+w}", "H3": f"{b[2]}-{b[2]+w}", "H4": f"{b[3]}-{b[3]+w}",
            "I1": "<b 0xc000000001><r 64><t>", "I2": "<r 24><t>", "I3": "<r 32>",
            "I4": "<b 0xc000000001><r 32><t>", "I5": "<t><r 48>"}


AWG_FIELDS = ("Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4", "H1", "H2", "H3", "H4",
              "I1", "I2", "I3", "I4", "I5",
              # AmneziaWG 3.x (docs/AWG3-PLAN.md §7.1) — DisableCookies is never written, but known. Twins: swg-noded,
              # swg-agent, js/crypto.js, sub.js, turn-artifacts.js (tests/cross_language_twins_selftest.py [3]).
              "HeaderProtectionKey", "RandomTrailers", "ContentPaddingAddition", "RekeyAfterTime", "RekeyTimeout",
              "RejectAfterTime", "KeepaliveTimeout", "MaxHandshakeAttempts", "DisableCookies")
AWG3_FIELDS = AWG_FIELDS[AWG_FIELDS.index("HeaderProtectionKey"):]


def awg2_profile(params, replace_standard_headers, previous=None):
    """Remove 3.x fields and replace standard IDs when they came from a protected profile."""
    out = {k: v for k, v in params.items() if k not in AWG3_FIELDS}
    if replace_standard_headers and out:
        standard = {k: (str(i), f"{i}-{i}") for k, i in AWG31_HEADERS.items()}
        if all(str(out.get(k, ids[0])).replace(" ", "") in ids for k, ids in standard.items()):
            # A repeated save can still carry the old 3.1 fields while the node applies the downgrade.
            previous = previous or {}
            assigned = not previous.get("HeaderProtectionKey") and all(
                k in previous and str(previous[k]).replace(" ", "") not in ids for k, ids in standard.items())
            legacy = previous if assigned else gen_awg_params("2.0")
            out.update({k: legacy[k] for k in AWG31_HEADERS})
    return out


def sanitize_awg_params(raw, gen3=False):
    """Keep only recognised AmneziaWG obfuscation fields with non-empty values, as strings. Empty → {}.
    The 3.x keys only with `gen3` — an interface's own record, and a pasted exit profile that carries a HeaderProtectionKey
    (parse_wg_profile: that profile is 3.1, and its server ignores a handshake without them). What else passes through here
    uses its own template parser: the panel-wide interface and mesh defaults never store a shared HeaderProtectionKey."""
    if not isinstance(raw, dict):
        return {}
    out = {}
    for k in AWG_FIELDS:
        v = raw.get(k)
        # …and never the "none" marker (AWG_OMIT): it lives in templates only (awg_template), so no record, link or
        # request can carry it to a node.
        if v is None or str(v).strip() in ("", AWG_OMIT) or (k in AWG3_FIELDS and not gen3):
            continue
        out[k] = str(v).strip()
    return out


AWG_OMIT = "-"


def awg_template(raw, gen3=False):
    """A stored template read as (values, omitted): the concrete values (sanitize_awg_params) and the keys set to "-" —
    what every template READER uses (link_awg_params, a node's mesh_awg, the create's interface defaults, awg3_defaults)."""
    if not isinstance(raw, dict):
        return {}, frozenset()
    om = frozenset(k for k in AWG_FIELDS if k != "DisableCookies" and (gen3 or k not in AWG3_FIELDS)
                   and str(raw.get(k) if raw.get(k) is not None else "").strip() == AWG_OMIT)
    return sanitize_awg_params(raw, gen3), om


def awg_template_clean(raw, gen3=False):
    """What a template SAVE stores and a comparison reads: sanitize_awg_params's values plus "-" for the keys set to none,
    in field order — the same dict sanitize_awg_params returns for a template with no "-". (⚠️ Round 1: the saves and the
    per-node re-provision comparison called sanitize_awg_params, which drops "-": every "-" would be erased on save.)"""
    vals, om = awg_template(raw, gen3)
    return {k: (AWG_OMIT if k in om else vals[k]) for k in AWG_FIELDS if k in vals or k in om}


def awg_exact_reported(snap):
    """Does this node report `datapath.awg.exact` — create a whole set as it is and take a key it leaves out off the device?
    An older node (or one not reporting at all) drops `exact` on create and keeps a key an edit leaves out."""
    return _awg_datapath(snap).get("exact") == 1


def awg_exact_refusal(snap, name):
    """The perr refusing an omission on node `name` until it can hold one — or None."""
    if awg_exact_reported(snap):
        return None
    return perr("{v1} cannot hold an empty AmneziaWG field yet — it is offline or needs an update", v1=name)


def awg_rules(d, where="", gen3=None):
    """The rules a set with an omitted field must keep (§A2) — a perr, or None. `d` is the WHOLE concrete set being stored;
    `where` names it ("the interface defaults", an interface) for the message; `gen3` says it was AmneziaWG 3.1 before (R2).
      R1 an AmneziaWG interface keeps at least one AmneziaWG key — none at all is what plain WireGuard is;
      R2 a 3.1 interface keeps at least one 3.x key — the generation switch owns going back to 2.0;
      R3 Jc, Jmin and Jmax: all three or none;
      R4 a HeaderProtectionKey wants S1–S4 (the ≥ 12 check then applies);
      R5 S1 + 56 ≠ S2 when both are present (the two handshake messages would be the same size)."""
    if not any(k in d for k in AWG_FIELDS):
        return perr("{v1} would have no AmneziaWG field left — make it a WireGuard interface instead", v1=where)
    if gen3 and not any(k in d for k in AWG3_FIELDS):
        return perr("{v1} would have no AmneziaWG 3.1 field left — switch it to AmneziaWG 2.0 instead", v1=where)
    if len([k for k in ("Jc", "Jmin", "Jmax") if k in d]) not in (0, 3):
        return perr("{v1}: Jc, Jmin and Jmax go together — set all three, or all three to none", v1=where)
    if "HeaderProtectionKey" in d and not all(k in d for k in ("S1", "S2", "S3", "S4")):
        return perr("{v1}: header protection needs S1–S4 — {v2} cannot be none while it is on", v1=where,
                    v2=", ".join(k for k in ("S1", "S2", "S3", "S4") if k not in d))
    if str(d.get("S1", "")).strip().isdigit() and str(d.get("S2", "")).strip().isdigit() \
            and int(str(d["S1"]).strip()) + 56 == int(str(d["S2"]).strip()):
        return perr("{v1}: S2 must not be S1 + 56 — the two handshake messages would be the same size", v1=where)
    return None


AWG_I_KEYS = ("I1", "I2", "I3", "I4", "I5")
AWG_I_TAG_MAX, AWG_I_LINE_MAX, AWG_I_UDP_MAX = 1000, 4096, 65507
_AWG_I_TAG = re.compile(r"<([a-z]+)(?: ([^<>]*))?>")
_AWG_BAD_CHAR = re.compile(r"[^\x20-\x7e]")


def _awg_trim(v):
    return ("" if v is None else str(v)).strip(" \t\n\r\f\v")


def awg_i_check(v):
    """One I line → (ok, bytes, why, tag): `bytes` it puts on the wire, or why an app refuses it — "ctl" a character outside
    printable ASCII (a line break, a tab, a Unicode space or line separator), "long" over 4096 characters, "tag" a tag no app
    reads, "c" a <c>, "big" a random part over 1000 bytes, "t2" <t> twice, "huge" more than one UDP packet carries (65,507
    bytes). Blank and "-" are no packet."""
    s = _awg_trim(v)
    if _AWG_BAD_CHAR.search(s):
        return False, 0, "ctl", ""
    if s in ("", AWG_OMIT):
        return True, 0, "", ""
    if len(s) > AWG_I_LINE_MAX:
        return False, 0, "long", ""
    n = t = 0
    rest = s
    while True:
        rest = rest.lstrip(" ")
        if not rest:
            return (False, 0, "huge", "") if n > AWG_I_UDP_MAX else (True, n, "", "")
        m = _AWG_I_TAG.match(rest)
        if not m:
            mm = re.match(r"<[^>]*>?", rest)
            return False, 0, "tag", mm.group(0) if mm else rest[:16]
        name, arg = m.group(1), m.group(2)
        rest = rest[m.end():]
        if name == "c":
            return False, 0, "c", m.group(0)
        if name == "t" and arg is None:
            t += 1
            if t > 1:
                return False, 0, "t2", m.group(0)
            n += 4
            continue
        if name == "b" and arg is not None and re.fullmatch(r"0x(?:[0-9a-fA-F]{2})+", arg):
            n += (len(arg) - 2) // 2
            continue
        if name in ("r", "rc", "rd") and arg is not None and re.fullmatch(r"[0-9]+", arg):
            if int(arg) > AWG_I_TAG_MAX:
                return False, 0, "big", m.group(0)
            n += int(arg)
            continue
        return False, 0, "tag", m.group(0)


def awg_i_refusal(key, v):
    """The perr refusing I line `key` = `v`, in the Edit sheet's own words (js/iface.js mimicWhy) — or None."""
    ok, _n, why, tag = awg_i_check(v)
    if ok:
        return None
    if why == "big":
        return perr("{v1}: a random part is at most 1000 bytes — split it, like <r 1000><r 214>.", v1=key)
    if why == "c":
        return perr("{v1}: <c> is gone from AmneziaWG 3.x, and apps refuse the whole config.", v1=key)
    if why == "t2":
        return perr("{v1}: <t> appears twice — once per packet at most.", v1=key)
    if why == "ctl":
        return perr("{v1}: holds a character apps cannot read — a line break, a tab, or anything outside plain ASCII.", v1=key)
    if why == "huge":
        return perr("{v1}: more than one UDP packet can carry (65,507 bytes).", v1=key)
    if why == "long":
        return perr("{v1}: longer than 4096 characters.", v1=key)
    return perr("{v1}: apps cannot read {v2} — use <b 0x…>, <r N>, <rc N>, <rd N> or <t>.", v1=key, v2=tag)


def awg_value_refusal(key, v):
    """Any AmneziaWG field: an I line must be one every app reads (awg_i_refusal); every other field must hold no control
    character outside printable ASCII — a line break in S1 or H1 would put a line of its own into the server conf and every
    client config."""
    if key in AWG_I_KEYS:
        return awg_i_refusal(key, v)
    if _AWG_BAD_CHAR.search(_awg_trim(v)):
        return perr("{v1}: holds a character apps cannot read — a line break, a tab, or anything outside plain ASCII.", v1=key)
    return None


# Built-in 3.1 defaults use Amnezia's timer ranges with small transport padding. With RandomTrailers alone, small
# packets can grow to the largest size already seen on that peer. Cookie protection stays enabled by default.
AWG31_SET = {"RandomTrailers": "1", "ContentPaddingAddition": "2-10", "RekeyAfterTime": "100-120", "RekeyTimeout": "3-7",
             "RejectAfterTime": "150-180", "KeepaliveTimeout": "5-15", "MaxHandshakeAttempts": "15-20"}
_AWG3_RANGED = ("ContentPaddingAddition", "RekeyAfterTime", "RekeyTimeout", "RejectAfterTime", "KeepaliveTimeout",
                "MaxHandshakeAttempts")


def awg_template_refusal(raw, where, gen3=False, was=None):
    """The rules a TEMPLATE with "-" must keep — a perr, or None. R3: Jc, Jmin and Jmax are all three none or none of them
    (a blank one is auto, which is a value). R1: not every 2.0 field none — every interface made from it would be plain
    WireGuard by another name, and every create refused (awg_rules); a WireGuard interface is the way to that.
    And a value this save CHANGES from `was` (the stored template) must be one every app and conf reads (awg_value_refusal):
    every interface or mesh link made from the template would carry it. A stored value never blocks an unrelated save."""
    vals, om = awg_template(raw, gen3)
    _was = awg_template(was, gen3)[0]
    for k, v in vals.items():
        if v != _was.get(k):
            _b = awg_value_refusal(k, v)
            if _b:
                return _b
    trio = [k in om for k in ("Jc", "Jmin", "Jmax")]
    if any(trio) and not all(trio):
        return perr("{v1}: Jc, Jmin and Jmax go together — set all three, or all three to none", v1=where)
    if all(k in om for k in AWG_FIELDS if k not in AWG3_FIELDS):
        return perr("{v1}: every AmneziaWG field is none — leave at least one, or use WireGuard interfaces", v1=where)
    return None


def mesh_template(deps, node):
    """The mesh AWG template a link is made from — (values, omitted), FIELD BY FIELD: its own (`node` is the link's layer,
    mesh_link_layer) where it names a field (a value or a "-"), else the panel's — what the link sheet's blank cells show as
    background text (code review of round 13: a link that set only Jc took the generator's H and I over the fleet's)."""
    pv, pom = awg_template((deps.get("panel_settings") or {}).get("mesh_awg"))
    v, om = awg_template((node or {}).get("mesh_awg"))
    if not (v or om):
        return pv, pom
    return ({k: (v[k] if k in v else pv[k]) for k in AWG_FIELDS if k in v or (k in pv and k not in om)},
            frozenset(om | (pom - set(v))))


def mesh_omit_s_refusal(gen, om, where):
    """R4 for mesh: a 3.1 mesh type with a template that sets an S to none can never build a 3.1 link — refused at save."""
    if gen == "3.1" and any(k in om for k in ("S1", "S2", "S3", "S4")):
        return perr("{v1}: AmneziaWG 3.1 links need S1–S4 for header protection — the mesh AWG params set {v2} to none",
                    v1=where, v2=", ".join(k for k in ("S1", "S2", "S3", "S4") if k in om))
    return None


def awg3_defaults(deps):
    """The operator's AmneziaWG 3.1 defaults (Settings → Interfaces, `interface_defaults.awg3_params`): only the six values an
    interface's Edit sheet may change too — ContentPaddingAddition and the timings. Never the HeaderProtectionKey (one key on
    every interface would be no key) and never RandomTrailers (on is the 3.1 set). Filtered here again because the file is
    the panel's, not proof of what the save let in. A field set to none ("-") is no value here; awg3_omitted names it."""
    a = (((deps.get("panel_settings") or {}).get("interface_defaults") or {}).get("awg3_params")) or {}
    return {k: str(a[k]).strip() for k in _AWG3_RANGED if isinstance(a, dict) and a.get(k) not in (None, "")
            and str(a[k]).strip() not in ("", AWG_OMIT)}


def awg3_omitted(deps):
    """The 3.1 defaults set to none ("-") — a 3.1 interface created from them gets no such line (awg3_full's `omit`)."""
    a = (((deps.get("panel_settings") or {}).get("interface_defaults") or {}).get("awg3_params")) or {}
    return frozenset(k for k in _AWG3_RANGED if isinstance(a, dict) and str(a.get(k) if a.get(k) is not None else "").strip() == AWG_OMIT)


def awg3_left_out(rec, was=None):
    """The six 3.1 fields `rec` has no value for, when the interface was ALREADY on 3.1: `was` (the set as stored before this
    Save; `rec` itself by default) holds a HeaderProtectionKey. Such a set was stored whole — every switch, create and recreate
    draws all six (awg3_full), a bless takes the device's own — so a missing one is a "-" (the operator's, or the 3.1 defaults'
    at its switch or create) or its own conf's choice, never "not set yet": a re-switch or a recreate on 3.1 leaves them out,
    and switching twice changes nothing (q189 CL-F1b). A 2.0 record lacks them for being 2.0."""
    rec = rec if isinstance(rec, dict) else {}
    was = rec if was is None else was if isinstance(was, dict) else {}
    return (frozenset(k for k in _AWG3_RANGED if not str(rec.get(k) or "").strip())
            if str(was.get("HeaderProtectionKey") or "").strip() else frozenset())


def awg3_template_clean(raw):
    """The six AmneziaWG 3.1 template fields of `raw` (ContentPaddingAddition and the timings) as a save stores them — (dict,
    None) or (None, perr): values checked the way an interface's are (awg3_check, over Amnezia's set for whatever is blank, so
    timings that cross are refused at the save, not by every 3.1 link or interface after it), "-" kept, a blank or "0" no value.
    Used by the interface defaults' 3.1 six and by the mesh templates (docs/AWG-OMIT-AND-MESH-GEN-PLAN.md §8, round 11)."""
    a = {k: str(raw[k]).strip() for k in _AWG3_RANGED if isinstance(raw, dict) and raw.get(k) is not None and str(raw[k]).strip()}
    om = [k for k in a if a[k] == AWG_OMIT]
    ac, err = awg3_check({**{k: v for k, v in AWG31_SET.items() if k not in om}, **{k: v for k, v in a.items() if k not in om}})
    if err:
        return None, err
    return {k: (AWG_OMIT if k in om else ac[k]) for k in a if k in om or k in ac}, None


def mesh_template_clean(raw):
    """A mesh AWG template as a save stores it — (dict, None) or (None, perr): the 2.0 fields (awg_template_clean) and the six
    AmneziaWG 3.1 fields an AmneziaWG 3.1 link takes (awg3_template_clean). With no 3.1 field it is awg_template_clean's dict."""
    d3, err = awg3_template_clean(raw)
    if err:
        return None, err
    return {**awg_template_clean(raw), **d3}, None


def mesh_awg3_refusal(deps, node):
    """Why the AmneziaWG 3.1 fields a 3.1 link anchored on `node` would take (mesh_awg3, field by field over every layer) cannot
    run together — awg3_check's perr (timings that cross) — or None. Each template is checked alone at its save, but a link
    fills its blanks from the layers below, so only the resolved set can say whether its timings cross."""
    v3, om3 = mesh_awg3(deps, node)
    return awg3_check({**{k: v for k, v in AWG31_SET.items() if k not in om3}, **v3})[1]


def mesh_awg3(deps, node):
    """(values, omitted) — the six AmneziaWG 3.1 fields an AmneziaWG 3.1 link anchored on `node` takes, FIELD BY FIELD: the node's
    mesh template, else the panel's, else the interface 3.1 defaults (Settings → Interfaces), else the built-in set (awg3_full
    fills that). The first layer that names a field decides it — a value, or "-" for no such line."""
    vals, om = {}, set()
    layers = [(node or {}).get("mesh_awg"), (deps.get("panel_settings") or {}).get("mesh_awg")]
    d3, o3 = awg3_defaults(deps), awg3_omitted(deps)
    for k in _AWG3_RANGED:
        for raw in layers:
            v = str(raw.get(k) if isinstance(raw, dict) and raw.get(k) is not None else "").strip()
            if v:
                (om.add(k) if v == AWG_OMIT else vals.__setitem__(k, v))
                break
        else:
            if k in d3:
                vals[k] = d3[k]
            elif k in o3:
                om.add(k)
    return vals, frozenset(om)


def awg3_full(base, reported=None, defaults=None, omit=(), s_max=AWG31_MAX_S):
    """The FULL 3.1 dict for a switch or a 3.1 create (§7.1): what the interface has — the record over the node's report,
    over a fresh generator set for whatever neither holds (a create, or a switch while the node is away) — plus the 3.1
    set wherever it has none (the operator's `defaults`, awg3_defaults, over AWG31_SET), so switching twice changes nothing
    (the HeaderProtectionKey is generated only when absent; a second one would cut every client again). S1–S4 are re-drawn
    together when any is under 12: header protection refuses them, and the switch re-issues every client config anyway.
    Stored WHOLE, because a restore sends the record and the agent fills what a partial one lacks with random values — new
    S/H, every client cut.

    `omit` — keys set to none (docs/AWG-OMIT-AND-MESH-GEN-PLAN.md A5): taken out of the merge and never filled from the set,
    the generator or the report. ⚠️ Round 9: without it the 3.1 switch of an interface with an omitted field put every
    omitted key back from the generator. An omitted S is not re-drawn either (R4 then refuses it beside a key)."""
    fresh = gen_awg_params("3.1", s_max)
    d = {k: str(v).strip() for k, v in {**fresh, **(reported or {}), **(base or {})}.items()
         if k in AWG_FIELDS and k != "DisableCookies" and k not in omit and v is not None and str(v).strip() != ""}   # D-cookies: never by us
    for k, v in {**AWG31_SET, **{k: v for k, v in (defaults or {}).items() if k in _AWG3_RANGED}}.items():
        if k not in omit:
            d.setdefault(k, v)
    if "HeaderProtectionKey" not in omit and "HeaderProtectionKey" not in d:
        d["HeaderProtectionKey"] = base64.b64encode(os.urandom(32)).decode()
    _ss = [k for k in ("S1", "S2", "S3", "S4") if k not in omit]
    if any(not d.get(k, "").isdigit() or int(d[k]) < AWG31_MIN_S for k in _ss):
        d.update({k: str(fresh[k]) for k in _ss})
    return d


def awg3_check(d):
    """(the dict with its 3.x values in their one spelling, None) — or (None, a perr naming the field). The checks a save
    makes while an interface's dict holds a 3.x key (§7.1): header protection wants S1–S4 ≥ 12 (the kernel refuses less,
    netlink.c:812-850 — the edit would fail in silence and the next restart be refused), and the timings must not cross:
    RekeyAfterTime + RekeyTimeout + KeepaliveTimeout (upper bounds) ≤ RejectAfterTime's lower bound, else the node drops
    data a client still sends with an aging key (go timers.go:262-299; absent ones at WireGuard's defaults). Booleans
    become "1", the one spelling every parser takes (§3), and off removes the key; a range is `a` or `a-b` with a ≤ b."""
    out = dict(d)
    for k in ("RandomTrailers", "DisableCookies"):
        if k in out:
            v = str(out[k]).strip().lower()
            if v in ("1", "on", "true", "yes"):
                out[k] = "1"
            elif v in ("0", "off", "false", "no"):
                out.pop(k)
            else:
                return None, perr("{v1} must be on or off", v1=k)
    for k in _AWG3_RANGED:
        if k in out:
            m = re.fullmatch(r"\s*(\d+)\s*(?:-\s*(\d+)\s*)?", str(out[k]))
            if not m or (m.group(2) and int(m.group(1)) > int(m.group(2))):
                return None, perr("{v1} must be a number or a range like 10-100", v1=k)
            out[k] = m.group(1) + ("-" + m.group(2) if m.group(2) else "")
            if out[k] == "0":
                out.pop(k)                        # what a 3.1 kernel prints for "unset" — not a setting
    if "HeaderProtectionKey" in out:
        try:
            _hk = base64.b64decode(str(out["HeaderProtectionKey"]).strip(), validate=True)
            _ok = len(_hk) == 32 and any(_hk)     # all-zero: ON in the kernel, OFF in amneziawg-go — never a handshake
        except Exception:
            _ok = False
        if not _ok:
            return None, perr("HeaderProtectionKey must be a 32-byte key in base64, not all zeros")
        low = [k for k in ("S1", "S2", "S3", "S4") if not str(out.get(k, "")).strip().isdigit() or int(str(out[k]).strip()) < 12]
        if low:
            return None, perr("{v1} must be 12 or more while header protection is on", v1=", ".join(low))
    if any(k in out for k in ("RekeyAfterTime", "RekeyTimeout", "RejectAfterTime", "KeepaliveTimeout")):
        hi = lambda k, dflt: int(str(out.get(k, dflt)).split("-")[-1])
        lo = int(str(out.get("RejectAfterTime", 180)).split("-")[0])
        tot = hi("RekeyAfterTime", 120) + hi("RekeyTimeout", 5) + hi("KeepaliveTimeout", 10)
        if tot > lo:
            return None, perr("RekeyAfterTime + RekeyTimeout + KeepaliveTimeout (up to {v1} s) must not exceed "
                              "RejectAfterTime ({v2} s at least) — the node would drop data a client still sends",
                              v1=tot, v2=lo)
    return out, None


def awg_gen_reported(snap):
    """Does this node report its AmneziaWG generation (`datapath.awg.gen`)? Every node that knows the 3.x keys does, on every
    snapshot — so False means an older node, which must be sent none of them and asked for no switch (§7.2, §7.8).
    Read through _awg_datapath: a snapshot is remote input, and since P3 this runs inside the /api/state loop (awg31_no),
    where one node's malformed `datapath` must never fail the poll for every node."""
    return isinstance(_awg_datapath(snap).get("gen"), dict)


def awg_gen_refusal(snap, name, iface=None):
    """Why node `name` cannot run an AmneziaWG 3.1 interface — a perr — or None when it can (§7.2). The datapath first — the
    one `iface` already runs on when the node reports it on the userspace fallback, else what a new interface gets (the
    kernel module when one is loaded, else the fallback) — then the awg tools, as the node's own generation report says;
    an older node makes none and is told to update. Nothing NixOS-specific: a channel that ships 2.0 lands here, and
    unlocks itself when it moves."""
    if not awg_gen_reported(snap):
        return perr("{v1}: this node does not report its AmneziaWG version — update it", v1=name)
    g = {k: v for k, v in _awg_datapath(snap)["gen"].items() if isinstance(v, str)}   # a version is a string; anything else is none
    order = {"2.0": 0, "3.0": 1, "3.1": 2}
    on_fallback = bool(iface) and iface in (_awg_datapath(snap).get("userspace") or [])
    if g.get("module") and not on_fallback and order.get(g.get("module"), -1) < 2:
        if awg_loadable(snap):                  # installed by an update, not loaded yet (docs/AWG31-LOAD-PLAN.md D2)
            return perr("{v1}: AmneziaWG 3.1 is installed, but the kernel module in use is still {v2} — load it now, or it "
                        "loads at the next reboot if the kernel accepts it; the node page says why when it does not",
                        v1=name, v2=g.get("module"))     # a promise only a kernel that takes the module keeps (q189 FP-3)
        if _awg_31_waiting(snap):               # …and Load now is not offered: nothing to fall back on (q189 HE-4)
            return perr("{v1}: AmneziaWG 3.1 is installed, but the kernel module in use is still {v2} — it loads at the next "
                        "reboot if the kernel accepts it (the node page says why when it does not). It cannot be loaded now: "
                        "this node has no userspace AmneziaWG (amneziawg-go) to run its interfaces on if the new module did "
                        "not load", v1=name, v2=g.get("module"))
        return perr("{v1}: its AmneziaWG kernel module is {v2} — an AmneziaWG 3.1 interface needs 3.1", v1=name,
                    v2=g.get("module"))
    if (not g.get("module") or on_fallback) and order.get(g.get("fallback"), -1) < 2:
        return perr("{v1}: its userspace AmneziaWG (amneziawg-go), which this interface would run on, is {v2} — an "
                    "AmneziaWG 3.1 interface needs 3.1", v1=name, v2=g.get("fallback") or "none")
    if order.get(g.get("tools"), -1) < 2:
        return perr("{v1}: its awg tools are AmneziaWG {v2} — an AmneziaWG 3.1 interface needs 3.1", v1=name,
                    v2=g.get("tools") or "none")
    return None



def _awg_31_waiting(snap):
    """Is AmneziaWG 3.1 waiting to load on this node — 3.1 installed for the running kernel, an older module in use, tools
    that drive 3.1, and a module that is the node's own (not a container's host)? docs/AWG31-LOAD-PLAN.md D2/D3."""
    if not awg_gen_reported(snap) or (snap.get("kind") == "docker"):
        return False
    g = {k: v for k, v in _awg_datapath(snap)["gen"].items() if isinstance(v, str)}
    return g.get("disk") == "3.1" and g.get("module") in ("2.0", "3.0") and g.get("tools") == "3.1"


def awg_loadable(snap):
    """Can "Load now" bring AmneziaWG 3.1 to this node — 3.1 waiting to load, and a userspace AmneziaWG (amneziawg-go, the
    node's `gen.fallback`) to run its interfaces on if the new module does not load? Without one the node's op refuses
    `no_fallback` before anything stops — a module that did not load left every AmneziaWG interface and mesh link down
    (q189 HE-4) — so the panel does not offer it. The node's op checks it all again and refuses with a code; this only
    decides whether the panel offers the button."""
    return _awg_31_waiting(snap) and isinstance(_awg_datapath(snap)["gen"].get("fallback"), str)


def _awg_int(v):
    """A counter from a record or a node's report: an int, or 0 for anything else — never an exception in the state loop."""
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return 0


AWG_LOAD_LOST_S = 660        # the node acts on a press only while it is under 600 s old (AWG_LOAD_MAX_AGE) — past that plus one
                             # sync it never will: offline, or a node without the op. Said then, not after a longer wait


def awg_load_status(node, snap, name, now=None):
    """The last "Load now" for this node as the operator should read it: None (never pressed), pending, or its result —
    a perr the browser translates. The node reports `datapath.awg.load = {n, ok, code, ifaces, loaded, error}`."""
    req = node.get("awg_load") if isinstance(node.get("awg_load"), dict) else {}
    try:
        n, at = int(req.get("n") or 0), float(req.get("at") or 0)
    except (TypeError, ValueError):
        return None
    if n <= 0:
        return None
    now = now or time.time()
    age = max(0, int(now - at))                  # the SPA stops showing a result an hour after the press
    got = _awg_datapath(snap).get("load") if isinstance(_awg_datapath(snap).get("load"), dict) else {}
    # The press is its counter AND its time: a node record re-created here restarts the counter, and n alone would pair a
    # new press with the node's result for an old one. A node without `id` in its report is matched by n, as before.
    pid = "%d:%d" % (n, int(at))
    if (str(got.get("id")) != pid) if got.get("id") else (_awg_int(got.get("n")) != n):
        if now - at > AWG_LOAD_LOST_S:
            return {"n": n, "age": age, "state": "lost", "msg": perr("{v1} has not answered the request to load the AmneziaWG module — it "
                                                         "may be offline, or on a version without it", v1=name)}
        return {"n": n, "age": age, "state": "pending"}
    ifs = got.get("ifaces") if isinstance(got.get("ifaces"), dict) else {}
    us = sorted(k for k, v in ifs.items() if v == "userspace"); dn = sorted(k for k, v in ifs.items() if v == "down")
    code, ver = str(got.get("code") or ""), str(got.get("loaded") or "")
    if got.get("ok") and not us and not dn:
        msg = perr("{v1}: AmneziaWG {v2} is loaded — every AmneziaWG interface is back on the kernel module", v1=name, v2=ver)
    elif got.get("ok"):
        msg = perr("{v1}: AmneziaWG {v2} is loaded, but not every interface came back on it — on the userspace fallback: "
                   "{v3}; down: {v4}", v1=name, v2=ver, v3=", ".join(us) or "—", v4=", ".join(dn) or "—")
    elif code == "load_failed" and not dn:
        msg = perr("{v1}: the new AmneziaWG module did not load — its interfaces run on the userspace fallback until the "
                   "next reboot", v1=name)
    elif code == "load_failed":                  # the node's word per interface — one that did not come back is not on any fallback
        msg = perr("{v1}: the new AmneziaWG module did not load — on the userspace fallback: {v2}; down: {v3}", v1=name,
                   v2=", ".join(us) or "—", v3=", ".join(dn))
    elif code == "busy":
        msg = perr("{v1}: the AmneziaWG module could not be unloaded — every interface was brought back as it was", v1=name)
    elif code == "tools_old":
        msg = perr("{v1}: nothing was changed — its awg tools cannot drive the new module", v1=name)
    elif code == "no_way_back":
        msg = perr("{v1}: nothing was changed — nothing would bring back {v2}", v1=name,
                   v2=str(got.get("error") or "").split(": ", 1)[-1][:200])
    elif code == "cannot_record":
        msg = perr("{v1}: nothing was changed — the node could not record the request (its state directory is not writable)",
                   v1=name)
    elif code == "cannot_check":
        msg = perr("{v1}: nothing was changed — the node cannot check its other network namespaces (lsns or nsenter is "
                   "missing)", v1=name)
    elif code == "other_netns":
        msg = perr("{v1}: nothing was changed — an AmneziaWG device lives in another network namespace", v1=name)
    elif code == "nothing_newer":
        msg = perr("{v1}: nothing was changed — the installed module is not newer than the one in use", v1=name)
    elif code == "no_fallback":
        msg = perr("{v1}: nothing was changed — this node has no userspace AmneziaWG (amneziawg-go) to fall back on if the new "
                   "module did not load", v1=name)
    else:
        msg = perr("{v1}: the AmneziaWG module was not loaded — {v2}", v1=name, v2=str(got.get("error") or code)[:200])
    # "partial": the module is loaded but not every interface came back on it — shown as a problem, not as a success
    return {"n": n, "age": age, "state": ("partial" if us or dn else "done") if got.get("ok") else "failed", "msg": msg}

def awg31_rendered(rec, rep):
    """Is an interface AmneziaWG 3.1 in the configs its clients are given? The dict apply_iface_meta renders — the record's
    3.x keys when there is a record, else the node's report — holds a HeaderProtectionKey (§7.1)."""
    d = rec if isinstance(rec, dict) and rec else (rep if isinstance(rep, dict) else {})
    return bool(str(d.get("HeaderProtectionKey") or "").strip())


def turn_awg3_blockers(deps, nodes, nid, ports):
    """The turn proxies on node `nid` that point at one of `ports` and whose fork cannot serve an AmneziaWG 3.1 interface
    (catalog `awg3: False`) — [{service, title, connect, fork}], by service name. "Points" is the rule turnProxiesFor and
    swg-sub use to hang a proxy under an interface: its connect port is the interface's port — where the node REPORTS it,
    or where a pending install or manage will put it. A re-point or a delete still pending does not clear it: the node may
    never apply it (a request expires, a node can have turn management off), and counting it as done would let a switch
    through for good while the proxy stays."""
    ports = {str(p) for p in ports if str(p or "").strip().isdigit()}
    rep = {tp.get("service"): tp for tp in ((((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies")) or [])
           if isinstance(tp, dict) and tp.get("service")}
    pend = {s: r for s, r in (((nodes.get(nid) or {}).get("turn")) or {}).items() if isinstance(r, dict)}
    out = []
    for svc in sorted(set(rep) | set(pend)):
        req, tp = pend.get(svc) or {}, rep.get(svc) or {}
        if not ports or (TURN_SERVERS.get(turn_fork(svc)) or {}).get("awg3", True):
            continue
        conns = [tp.get("connect") or ""] + ([req["connect"]] if req.get("action") in ("install", "manage") and req.get("connect") else [])
        hit = [c for c in conns if _port_of(c) in ports]
        if hit:
            out.append({"service": svc, "title": req.get("title") or tp.get("title") or "", "connect": hit[0],
                        "fork": turn_fork(svc)})
    return out


def turn_listen_now(deps, nid, svc):
    """Where turn proxy `svc` on node `nid` listens, as the node reports it ("" when it does not)."""
    v = (((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies"))
    return next((str(tp.get("listen") or "") for tp in (v if isinstance(v, list) else ()) if isinstance(tp, dict) and tp.get("service") == svc), "")


def turn_connect_now(deps, nodes, nid, svc):
    """Where turn proxy `svc` on node `nid` points: a pending install/manage's connect, else what the node reports."""
    req = (((nodes.get(nid) or {}).get("turn")) or {}).get(svc) or {}
    if req.get("action") in ("install", "manage") and req.get("connect"):
        return req["connect"]
    for tp in ((((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies")) or []):
        if isinstance(tp, dict) and tp.get("service") == svc:
            return tp.get("connect") or ""
    return ""


def _turn_awg3_app(fork):
    """The app a fork is served to natively (the compat matrix's `native` client) — the one that cannot carry 3.x."""
    return ", ".join(sorted((TURN_CLIENTS.get(c) or {}).get("name") or c
                            for c, cls in (_TURN_CLIENT_COMPAT.get(fork) or {}).items() if cls == "native")) or fork


def turn_awg3_refusal(blockers, iface):
    """The perr refusing to make `iface` AmneziaWG 3.1 while `blockers` (turn_awg3_blockers) point at it — each named,
    so the operator can move or delete it (D-apps, operator 2026-09-19: refuse and name, no automatic unlink)."""
    names = "; ".join("%s (%s · %s)" % (b["title"] or b["service"], (TURN_SERVERS.get(b["fork"]) or {}).get("label")
                                         or b["fork"], _turn_awg3_app(b["fork"])) for b in blockers)   # proper nouns only: {v2} is not translated
    return perr("{v1} cannot run AmneziaWG 3.1 while a turn proxy whose app carries AmneziaWG 2.0 only points at its port: "
                "{v2}. Point it at a 2.0 interface, or delete it, and try again once the node has applied that", v1=iface, v2=names)


def turn_awg3_target(deps, nodes, nid, fork, connect):
    """The perr refusing to point a proxy of `fork` at `connect` on node `nid` — the interface whose port it names is AmneziaWG
    3.1 and the fork's app cannot carry 3.x — else None."""
    if (TURN_SERVERS.get(fork) or {}).get("awg3", True):
        return None
    port = _port_of(connect)
    snap = (deps.get("node_snaps") or {}).get(nid) or {}
    recs = (nodes.get(nid) or {}).get("ifaces") or {}
    made = (nodes.get(nid) or {}).get("create") or {}          # an interface asked for, not yet reported: its port is only here
    for ifn in sorted(set(snap.get("interfaces") or {}) | set(recs)):   # (a create writes its record — the dict — at once)
        meta = ((snap.get("interfaces") or {}).get(ifn) or {}).get("meta") or {}
        ov, mk = recs.get(ifn) or {}, made.get(ifn) or {}
        if port and port in (str(meta.get("listen_port") or ""), str(ov.get("listen_port") or ""), str(mk.get("listen_port") or "")) \
                and awg31_rendered(ov.get("awg_params") or mk.get("awg_params"), meta.get("awg_params")):
            return perr("{v1} proxies cannot point at {v2}: it runs AmneziaWG 3.1, and their app ({v3}) carries AmneziaWG 2.0 "
                        "only — point it at a 2.0 interface", v1=(TURN_SERVERS.get(fork) or {}).get("label") or fork, v2=ifn,
                        v3=_turn_awg3_app(fork))
    return None


MESH_AWG_GENS = ("2.0", "3.1", "wg")
MESH_LINK_KEEP = ("relay", "dial_endpoint", "dial_src")


def mesh_gen_of(deps):
    """The fleet's default type for new links, before the two nodes' capabilities are checked."""
    g = str((deps.get("panel_settings") or {}).get("mesh_awg_gen") or "")
    return g if g in MESH_AWG_GENS else DEFAULT_AWG_GEN


def mesh_link_cfg(nodes, a, b):
    """The pair a↔b's own settings ({} = the fleet's defaults) — `{type, awg}`, stored on its anchor (smaller id)."""
    x, y = (a, b) if a < b else (b, a)
    c = ((nodes.get(x) or {}).get("mesh_link") or {}).get(y)
    return c if isinstance(c, dict) else {}


def mesh_link_cfg_put(nodes, a, b, **kv):
    """Set the pair's own settings (`type=`, `awg=`); an empty value removes its key, an empty entry and map go too — so a
    pair back on the fleet's defaults leaves nothing stored."""
    x, y = (a, b) if a < b else (b, a)
    m = nodes[x].get("mesh_link") if isinstance(nodes[x].get("mesh_link"), dict) else {}
    c = dict(m.get(y) or {})
    for k, v in kv.items():
        if v:
            c[k] = v
        else:
            c.pop(k, None)
    if c:
        m[y] = c
    else:
        m.pop(y, None)
    if m:
        nodes[x]["mesh_link"] = m
    else:
        nodes[x].pop("mesh_link", None)


def mesh_link_override(nodes, a, b):
    """The type chosen for the pair a↔b on its own ("" = the fleet's default)."""
    g = str(mesh_link_cfg(nodes, a, b).get("type") or "")
    return g if g in MESH_AWG_GENS else ""


def mesh_gen_for(deps, nodes, a, b):
    """The type the link a↔b is made as: its own choice, else the fleet's default."""
    return mesh_link_override(nodes, a, b) or mesh_gen_of(deps)


def mesh_pair_name(nodes, a, b):
    """"msk-main ↔ svo-im" — a link as messages name it, smaller id first."""
    x, y = (a, b) if a < b else (b, a)
    return "%s ↔ %s" % ((nodes.get(x) or {}).get("name") or x, (nodes.get(y) or {}).get("name") or y)


def mesh_link_awg_set(nodes, a, b):
    """The AWG template chosen for the pair a↔b on its own ({} = the fleet's)."""
    t = mesh_link_cfg(nodes, a, b).get("awg")
    return t if isinstance(t, dict) else {}


def mesh_link_layer(nodes, a, b):
    """The pair's own template as the layer the template readers take (mesh_template, mesh_awg3, mesh_awg3_refusal): it
    stands where a node's mesh_awg stood before a link's params were set on the link (plan §8 round 13)."""
    return {"mesh_awg": mesh_link_awg_set(nodes, a, b)}




def mesh_link_extras(lr):
    """The operator's settings on one end's link record that DO something — relay mode "relay", a dial address or source
    that is not blank (MESH_LINK_KEEP). What mesh_need counts as needing the pair and what a teardown parks: an inert
    `relay: {mode: forward}` (every sheet save writes one) is neither."""
    lr = lr if isinstance(lr, dict) else {}
    kv = {}
    for k in MESH_LINK_KEEP:
        if k == "relay":
            if isinstance(lr.get("relay"), dict) and lr["relay"].get("mode") == "relay":
                kv["relay"] = lr["relay"]
        elif str(lr.get(k) or "").strip():
            kv[k] = str(lr[k]).strip()
    return kv


def mesh_link_park(nodes, who, other, park=True, now=None):
    """Tear down `who`'s half of its link to `other` — THE one teardown (a re-provision, one link's rebuild, retirement,
    a node's removal): cancel a pending create, stage the interface's delete, drop its override and the link record. With
    `park`, the operator's own settings on it (mesh_link_extras) go to `link_keep[other]` first, which the next
    _mesh_make_link of the pair puts back and mesh_need counts, so a rebuild never resets them — never for a peer no
    longer in the store (nothing would ever consume it)."""
    n = nodes.get(who) or {}
    lr = (n.get("links") or {}).get(other)
    if lr is None:
        return
    kv = mesh_link_extras(lr) if park and other in nodes else {}
    if kv:
        n.setdefault("link_keep", {})[other] = kv
    ifc = (lr if isinstance(lr, dict) else {}).get("iface")
    if ifc:
        (n.get("create") or {}).pop(ifc, None)
        n.setdefault("delete", {})[ifc] = {"at": int(now or time.time())}
        (n.get("ifaces") or {}).pop(ifc, None)
    n["links"].pop(other, None)


def mesh_link_unpark(nodes, who, other, *keys):
    """Drop `keys` from what is parked on `who` for `other` (the rebuild's address reset); an emptied entry and map go."""
    kp = (nodes.get(who) or {}).get("link_keep") or {}
    for k in keys:
        (kp.get(other) or {}).pop(k, None)
    if other in kp and not kp[other]:
        kp.pop(other)
    if "link_keep" in (nodes.get(who) or {}) and not kp:
        nodes[who].pop("link_keep")


def mesh_relink_pair(nodes, a, b):
    """Tear down the ONE link a↔b on both ends so the next reconcile_mesh rebuilds it — under a fresh link id (the anchor's
    mesh_gen moves on, as mesh_reprovision_node does, so the new interfaces never share a name with the ones being deleted),
    its operator settings parked for the rebuild (mesh_link_park)."""
    x = a if a < b else b
    nodes[x]["mesh_gen"] = int(nodes[x].get("mesh_gen") or 0) + 1   # only NEW link ids change; existing links keep their names
    mesh_link_park(nodes, a, b)
    mesh_link_park(nodes, b, a)


def mesh_link_gen(node, lr):
    """What an existing link IS on `node`'s end: "wg" by its record's `proto` (never from missing params — a re-stage
    setdefaults a params-less record, and a lost record would silently read as plain WireGuard), "3.1" when its params hold
    a HeaderProtectionKey, else "2.0"."""
    if (lr or {}).get("proto") == "wg":
        return "wg"
    p = (((node or {}).get("ifaces") or {}).get((lr or {}).get("iface")) or {}).get("awg_params") or {}
    return "3.1" if str(p.get("HeaderProtectionKey") or "").strip() else "2.0"


def mesh_31_refusal(deps, nodes, snaps, a, b, mtu):
    """Why the link a↔b cannot be made at AmneziaWG 3.1 — a perr — or None. Both ends must run 3.1 (awg_gen_refusal), and
    header protection wants S1–S4 ≥ 12, so the link's S4 room (mesh_s4_room) must hold 12."""
    for nid in (a, b):
        why = awg_gen_refusal((snaps or {}).get(nid), (nodes.get(nid) or {}).get("name") or nid)
        if why:
            return why
    if (mesh_s4_room(mtu) or 0) < 12:
        return perr("the mesh MTU ({v1}) is too high for AmneziaWG 3.1 — header protection needs a link MTU of 1428 or less",
                    v1=mtu)
    _t3 = mesh_awg3_refusal(deps, mesh_link_layer(nodes, a, b))
    if _t3:                                   # the timings its layers resolve to cross: never a link that drops data
        return _t3
    _om = mesh_template(deps, mesh_link_layer(nodes, a, b))[1]
    if any(k in _om for k in ("S1", "S2", "S3", "S4")) and all(awg_exact_reported((snaps or {}).get(x)) for x in (a, b)):
        return mesh_omit_s_refusal("3.1", _om, mesh_pair_name(nodes, a, b))   # the save refuses it too
    return None


def mesh_types_in_play(deps, nodes):
    """Is a mesh type, or a "-" in a mesh template, set anywhere — the panel's or any node's? Only then are the node cards'
    reasons computed (mesh_gen_reasons walks every link: ~1.5 ms a poll at 30 nodes). The cost of the gate: once every
    setting is back to its default, a link still made at another type is not listed (the settings no longer ask for one)."""
    ps = deps.get("panel_settings") or {}
    if ps.get("mesh_awg_gen") or (isinstance(ps.get("mesh_awg"), dict) and AWG_OMIT in ps["mesh_awg"].values()):
        return True
    if any(isinstance(c, dict) and (c.get("type") or (isinstance(c.get("awg"), dict) and AWG_OMIT in c["awg"].values()))
           for n in nodes.values() if isinstance(n, dict) and isinstance(n.get("mesh_link"), dict)
           for c in n["mesh_link"].values()):
        return True
    # …or a link 1.8.8 made from part of a template (q189 PR-11): a dict lookup per link record, no snapshot walked
    return any(mesh_link_partial(ov) for n in nodes.values() if isinstance(n, dict)
               for ov in (n.get("ifaces") or {}).values() if isinstance(ov, dict) and ov.get("system"))


_MESH_MUST = ("S1", "S2", "H1", "H2", "H3", "H4")


def mesh_link_partial(ov):
    """The S / H keys an AmneziaWG mesh link's record lacks — a link 1.8.8 made from PART of a template (f8ebb5b fixed new
    links only): its ends never handshake (each rolled its own S/H), or after both restart they run with no S or H line at
    all — plain WireGuard on the wire, while the panel shows AmneziaWG (q189 PR-11). An exact link (a template's "-") omits
    keys on purpose and is not one; a WireGuard link has no params."""
    p = (ov or {}).get("awg_params") if isinstance(ov, dict) else None
    if not isinstance(p, dict) or not p or ov.get("awg_exact"):
        return []
    return [k for k in _MESH_MUST if k not in p]


MESH_GEN_LABEL = {"wg": "WG", "2.0": "AWG 2.0", "3.1": "AWG 3.1"}   # the link type picker's own names (js meshGenLabel)


def _mesh_relink_how(deps, nodes, a, b, want):
    """How to rebuild ONE link, a↔b, as `want` — a phrase for the reasons below. A change of its type on its card under Node
    connections rebuilds that link alone, on both ends (plan §8 round 12); re-provisioning a node rebuilds EVERY link it has,
    so a reason about one link never sends the operator there (q189 PR-4). Naming the type is a change while the link follows
    the default; a link with a type of its own changes by going back to Default — which is `want` only when the fleet's is."""
    lbl = MESH_GEN_LABEL.get(want, want)
    if not mesh_link_override(nodes, a, b):
        return perr("to rebuild this link alone, pick {v1} as its type on its card under Node connections and Save", v1=lbl)
    if mesh_gen_of(deps) == want:
        return perr("to rebuild this link alone, pick Default as its type on its card under Node connections and Save")
    return perr("to rebuild this link alone, pick Default as its type on its card under Node connections and Save, then {v1} "
                "and Save again", v1=lbl)


def mesh_gen_reasons(deps, nodes, snaps, nid):
    """The node's links that are not the type the mesh settings ask for, and why — [{peer, iface, type, want, msg}], the
    list its mesh card renders. Derived on every read from the link records against the settings (nothing stored): a
    3.1 link built at 2.0 says what stopped it; any other mismatch is a link that kept what it was made with — made before
    the setting changed, or while an end could not run it (a module or tools updated since) — and says how to rebuild that
    one link. (A node enrolled after the type was set no longer lands here: its pairs wait for its report, mesh_link_waits.)"""
    me = nodes.get(nid) or {}
    mtu = mesh_cfg(deps)["mtu"]
    out = []
    for peer, lr in sorted((me.get("links") or {}).items()):
        if peer not in nodes or not isinstance(lr, dict):
            continue
        want, have = mesh_gen_for(deps, nodes, nid, peer), mesh_link_gen(me, lr)
        row = {"peer": (nodes.get(peer) or {}).get("name") or peer, "iface": lr.get("iface") or "", "type": have, "want": want}
        _miss = mesh_link_partial((me.get("ifaces") or {}).get(lr.get("iface")))
        if _miss:                                    # made from part of a template (q189 PR-11) — before any type question
            out.append(dict(row, msg=perr("made from part of a template — {v1} missing, so this link may not handshake, or runs "
                                          "without those lines (plain WireGuard on the wire); {v2}", v1=", ".join(_miss),
                                          v2=_mesh_relink_how(deps, nodes, nid, peer, want))))
        elif want != have:
            why = mesh_31_refusal(deps, nodes, snaps, nid, peer, mtu) if (want, have) == ("3.1", "2.0") else None
            out.append(dict(row, msg=why or perr("it should be {v1}, but a link keeps the type it was made with until it is "
                                                 "rebuilt — {v2}", v1=MESH_GEN_LABEL.get(want, want),
                                                 v2=_mesh_relink_how(deps, nodes, nid, peer, want))))
        elif have != "wg":
            # …and a link that holds a field its template sets to none (A4): an end could not hold the omission when it was
            # made — or it was made before the template said so
            _ly = mesh_link_layer(nodes, nid, peer)
            _om = mesh_template(deps, _ly)[1] | (mesh_awg3(deps, _ly)[1] if have == "3.1" else frozenset())
            _p = ((me.get("ifaces") or {}).get(lr.get("iface")) or {}).get("awg_params") or {}
            _kept = [k for k in AWG_FIELDS if k in _om and k in _p]
            if _kept:
                _cant = [(nodes.get(y) or {}).get("name") or y for y in sorted((nid, peer))
                         if not awg_exact_reported((snaps or {}).get(y))]
                out.append(dict(row, msg=perr("{v1} has generated values: {v2} cannot hold an empty AmneziaWG field yet — it "
                                              "is offline or needs an update", v1=", ".join(_kept), v2=", ".join(_cant))
                                if _cant else perr("{v1} has generated values where its AWG params say none — a link keeps "
                                                   "the values it was made with until it is rebuilt; {v2}", v1=", ".join(_kept),
                                                   v2=_mesh_relink_how(deps, nodes, nid, peer, want))))
    return out


# A mesh link's S4 must fit its MTU
MESH_WIRE_OVERHEAD = 60


def mesh_s4_room(mtu):
    """The largest S4 that keeps a full-size packet of a link with this MTU inside 1500 bytes; None when mtu is not a number."""
    try:
        return max(0, 1500 - MESH_WIRE_OVERHEAD - int(mtu))
    except (TypeError, ValueError):
        return None


def mesh_s4_fits(s4, mtu):
    """True when S4 fits — or when either value is not a number, because nothing can be judged then (never refit on a
    guess: a refit breaks the link until both ends have it)."""
    room = mesh_s4_room(mtu)
    try:
        return room is None or int(str(s4).strip()) <= room
    except (TypeError, ValueError):
        return True


def mesh_s4_draw(mtu, floor=0):
    """A fresh S4 inside the room, from 15 up like the generators (the whole room when it is smaller than 15) — and never
    under `floor`: 12 on an AmneziaWG 3.1 link, whose header protection refuses less (a caller checks the room holds it)."""
    room = mesh_s4_room(mtu) or 0
    lo = max(floor, min(15, room))
    return random.randint(lo, max(lo, room))


def awg_set_s4(awg, s4):
    """Keep the padding lengths equal when fitting S4 of a profile that uses one shared length."""
    fields = ("S1", "S2", "S3", "S4")
    if awg.get("HeaderProtectionKey") and len({str(awg.get(k)) for k in fields}) == 1:
        awg.update(dict.fromkeys(fields, s4))
    else:
        awg["S4"] = s4


def _link_iface_name(node, link_id, prefix="swg_"):
    """`<prefix><8hex>` (≤ IFNAMSIZ 15), same on both ends of a link. On the rare 8-hex collision
    within one node, slide along the hash until a free window is found."""
    existing = {lr.get("iface") for lr in (node.get("links") or {}).values()}
    existing |= set(node.get("delete") or {})
    for i in range(0, len(link_id) - 8 + 1):
        nm = prefix + link_id[i:i + 8]
        if nm not in existing:
            return nm
    return prefix + link_id[:8]


def _used_ports(nodes, snaps, nid):
    """The UDP ports a new mesh link must not take on node `nid`: the shared inventory every create and edit door asks
    (_node_ports — interfaces reported and created, turn-proxies, WDTT and its internal WG port, csqtt, mesh links, container
    ports, dial-in exits), the RAW-IP reserve and the ports the host listens on (_host_listen). ⚠️ It kept a list of its
    own that knew only the reported interfaces, turn-proxies, links and exits — a WDTT or csqtt port in the mesh range was
    handed to a link (S9e)."""
    return set(_node_ports({"node_snaps": snaps or {}}, nodes, nid)) | {WDTT_RAW_PORT} | _host_listen((snaps or {}).get(nid))


def exit_is_dialin(x):
    """A DIAL-IN exit (docs/LISTEN-EXIT-PLAN.md §2): a profile with a `listen_port` and no `endpoint` — nothing else marks it.
    The one spelling of the test on the panel (the SPA's is exitIsDialin, the node's _exit_dialin)."""
    pr = x.get("profile") if isinstance(x, dict) else None
    return isinstance(pr, dict) and x.get("provider") == "profile" and bool(pr.get("listen_port")) and not pr.get("endpoint")


def _dialin_ports(node):
    """[(exit, port)] — the UDP ports this node's dial-in exits listen on (docs/LISTEN-EXIT-PLAN.md §2.3)."""
    out = []
    for x in (node or {}).get("exits") or []:
        if exit_is_dialin(x):
            with contextlib.suppress(TypeError, ValueError):
                out.append((x, int(x["profile"]["listen_port"])))
    return out


def _node_ports(deps, nodes, nid, skip_exits=False, skip=None):
    """Every UDP port CLAIMED on a node → {port: holder-label}: wg/awg interfaces, turn-proxies, WDTT (DTLS listen +
    internal WG port), mesh links, and wg/awg servers in FOREIGN containers that publish a host port, from BOTH
    the live snapshot AND the desired store (so a just-created but not-yet-reported one still counts). The
    single source of truth for port-collision checks on create/edit.
    `skip` = the holder being edited, by IDENTITY — ("iface" | "turn" | "wdtt" | "csqtt", name): none of its ports count,
    its record's or what the node reports. By identity, never by port number: a server whose report differs from its record
    (a move not applied yet, a restore with no record) is not a clash with itself, and no port it names can hide another
    holder's claim."""
    snap = (deps.get("node_snaps") or {}).get(nid) or {}
    node = nodes.get(nid) or {}
    out = {}
    def add(p, label, who=None):
        if who is not None and who == skip:
            return
        try:
            p = int(str(p).strip())
        except (TypeError, ValueError):
            return
        out.setdefault(p, label)
    def tail(v):
        m = re.search(r":(\d+)$", str(v or ""))
        return m.group(1) if m else None
    for ifn, blk in (snap.get("interfaces") or {}).items():
        add((blk.get("meta") or {}).get("listen_port"), ifn, ("iface", ifn))
    for ifn, ov in (node.get("ifaces") or {}).items():
        add(ov.get("desired_port") or ov.get("listen_port"), ifn, ("iface", ifn))
    for tp in (snap.get("turn_proxies") or []):
        add(tail(tp.get("listen")), tp.get("service") or "a turn-proxy", ("turn", tp.get("service")))
    for svc, req in (node.get("turn") or {}).items():
        add(tail(req.get("listen")), svc, ("turn", svc))
    for ifn, w in (node.get("wdtt") or {}).items():
        add(tail(w.get("listen")), ifn + " (WDTT)", ("wdtt", ifn))
        add(w.get("wg_port"), perr("{v1} (WDTT internal WG)", v1=ifn), ("wdtt", ifn))
    def ents(v):                                       # a list of objects, or an object of them keyed by iface (_snap_sanitise takes both)
        return [(e.get("iface") or (k if isinstance(v, dict) else "") or "", e)
                for k, e in (v.items() if isinstance(v, dict) else enumerate(v or ())) if isinstance(e, dict)]
    for ifn, w in ents(snap.get("wdtt")):
        add(tail(w.get("listen")), ifn + " (WDTT)", ("wdtt", ifn))
        add(w.get("wg_port"), perr("{v1} (WDTT internal WG)", v1=ifn), ("wdtt", ifn))
    for ifn, c in (node.get("csqtt") or {}).items():   # csqtt binds ONE DTLS listen port (raw TUN, no internal WG port)
        add(tail(c.get("listen")), ifn + " (csqtt)", ("csqtt", ifn))
    for ifn, c in ents(snap.get("csqtt")):
        add(tail(c.get("listen")), ifn + " (csqtt)", ("csqtt", ifn))
    for lr in (node.get("links") or {}).values():
        add(lr.get("listen_port"), "a mesh link")
    for x in (snap.get("container_ifaces") or []):
        if isinstance(x, dict) and x.get("host_port"):
            add(x["host_port"], "%s in container %s" % (x.get("name") or "an interface", x.get("container") or "?"))
    if not skip_exits:                                 # last: a port an interface also claims is named after the interface
        for x, p in _dialin_ports(node):
            add(p, "the dial-in exit " + (x.get("label") or x.get("device") or ""))
    return out


def _host_listen(snap):
    """The UDP ports the node's HOST listens on (`udp_listen`, S9e) — a resolver on 53, chrony, an xray / hysteria on 443,
    and our own sockets too. Only a port the PANEL picks steers clear of them (a generated dial-in exit, a mesh link); a
    port the operator types is never refused for one: an unconnected client socket (dnsmasq's upstream queries) reads the
    same as a listener, and a socket we just moved off stays listed until the next report (S9e review F1/F2/F16/F19). An
    older node sends none."""
    return {p for p in ((snap or {}).get("udp_listen") or ()) if isinstance(p, int)}

def _port_conflict(deps, nodes, nid, port, own=(), me=None):
    """Label of whoever already binds `port` on the node, or None.
    `me` = the edited holder's identity (see _node_ports): the port is judged against every holder BUT it, so a port the
    node reports it on is not a clash with itself.
    `own` = ports tolerated by NUMBER, before anything else — RAW-IP 56003 and every other holder included. It is a trade:
    an Edit sheet re-sends the unchanged port on every save, which must stay savable, but a number tolerated here can no
    longer meet another holder's claim. Each door passes:
      interface update   its record's ports + the one the node reports (as before S12; a stale report is trusted)
      turn-proxy edit    the port it listens on now, as reported — never its service-name port, which after a move may be
                         another holder's since; none before the node reports it (the save is then judged in full)
      WDTT / csqtt save  its record's ports only — what the node reports is covered by `me`, never by number: a stale or
                         wrong report must not hide another holder or 56003 (pool-doors F17)
      interface create   its record's ports only when the node no longer reports it (a ghost recreate keeps its port)
      turn-proxy install nothing of its own"""
    try:
        port = int(str(port).strip())
    except (TypeError, ValueError):
        return None
    if port in {int(str(p)) for p in own if str(p).strip().isdigit()}:
        return None
    if port == WDTT_RAW_PORT:
        return _wdtt_raw_holder(nodes, nid, "") or perr("RAW-IP (reserved)")   # a phrase: translated where it lands
    return _node_ports(deps, nodes, nid, skip=me).get(port)


def _alloc_port(used, base):
    p = base
    while p in used:
        p += 1
    return p


def mesh_pool_refusal(subnet):
    """"" when `subnet` can serve as a mesh pool — an IPv4 network with room for at least one /31 — else why not:
    "cidr" (not a network at all), "range" (IPv6, or narrower than a /31). Both doors and the allocator ask this one
    question, so a value the allocator would choke on can neither be saved nor, if it arrives some other way
    (fleet.json, a hand edit, a store written before the door checked), take the sync down."""
    try:
        net = ipaddress.ip_network(str(subnet or "").strip(), strict=False)
    except (TypeError, ValueError):
        return "cidr"
    return "range" if net.version != 4 or net.prefixlen > 31 else ""


def mesh_pool_room(subnet):
    """How many links (/31s) a valid pool holds."""
    return 2 ** (31 - ipaddress.ip_network(str(subnet).strip(), strict=False).prefixlen)


def _mesh_in(sub, net):
    """True when the stored link subnet `sub` lies inside `net` (a malformed stored value is simply not inside)."""
    try:
        return ipaddress.ip_network(sub, strict=False).subnet_of(net)
    except (TypeError, ValueError):
        return False


def _mesh_anchored(nodes, deps=None):
    """{node id: how many links it ANCHORS} — every linked pair takes its /31 from the pool of its smaller id, the same
    rule _mesh_make_link allocates by, so a door that counts with this cannot disagree with the allocator. In the pair
    set of the mode in force: every pair in a full mesh, the needed ones on demand (given `deps` to say which)."""
    if deps is not None and mesh_mode_effective(deps, nodes) == "demand":
        out = {}
        for p in mesh_need(nodes, deps):
            out[min(p)] = out.get(min(p), 0) + 1
        return out
    ids = sorted(nodes)
    return {x: len(ids) - 1 - i for i, x in enumerate(ids)}


class _MeshAlloc:
    """One reconcile's /31 allocator. The taken-set is built once, and each pool is walked by ONE cursor per reconcile:
    everything behind the cursor is taken or was just handed out, so the answer is exactly the first-free /31 a walk
    from the start would find — at linear cost however many pairs are linked in one pass. `miss` holds (pool, why) for
    the last pair that could not be placed.

    ⚠️ Reversed in review: a full pool used to be remembered for 60 s and not walked again. A re-provision frees /31s
    without telling it, so "Rebuild links" right after the pool filled rebuilt NOTHING (measured: HEAD 4 links, the memo
    0) and the node read "no free /31 left" with four free. The cursor alone already takes a full pool from one walk per
    unlinked pair to one per reconcile, which is what the cost was."""

    def __init__(self, nodes):
        self.nodes, self.taken, self.walk, self.miss = nodes, None, {}, None

    def release(self, sub):
        """A /31 a link record held and no longer does (a stale half-record just overwritten). The walk from the start
        would now find it free, so every cursor restarts — rare, and it keeps the answer identical to that walk."""
        if self.taken is not None and sub in self.taken:
            self.taken.discard(sub)
            self.walk = {}

    def take(self, pool):
        why = mesh_pool_refusal(pool)
        if why:
            self.miss = (str(pool or ""), "bad")
            return None
        key = str(ipaddress.ip_network(str(pool).strip(), strict=False))
        if self.taken is None:
            self.taken = {lr.get("subnet") for n in self.nodes.values() for lr in (n.get("links") or {}).values()}
        it = self.walk.get(key)
        if it is None:
            it = self.walk[key] = ipaddress.ip_network(key).subnets(new_prefix=31)
        for sub in it:
            if str(sub) not in self.taken:
                self.taken.add(str(sub))
                return sub
        self.miss = (key, "full")
        return None


def _link_id(nodes, a, b):
    """Deterministic link id (same from either end). Folds in each end's `mesh_gen` so bumping a node's
    generation (on a mesh-settings change) yields a NEW id → new iface names, so a re-provision is a clean
    delete-old + create-new rather than a same-name address swap."""
    lo, hi = sorted((a, b))
    glo = int((nodes.get(lo) or {}).get("mesh_gen") or 0)
    ghi = int((nodes.get(hi) or {}).get("mesh_gen") or 0)
    return hashlib.sha256(f"{lo}|{glo}|{hi}|{ghi}".encode()).hexdigest()


def mesh_reprovision_node(nodes, nid):
    """Re-provision node `nid`'s mesh links: bump its generation and tear down its current links on BOTH
    ends (stage iface deletes + drop the link records). reconcile_mesh (called next) then rebuilds every
    pair — `nid`'s links come back with NEW iface names + `nid`'s current per-node mesh config (subnet /
    port / prefix). `nid` is briefly off the mesh until peers pull the new config and reconnect."""
    me = nodes.get(nid) or {}
    me["mesh_gen"] = int(me.get("mesh_gen") or 0) + 1
    _peers = set((me.get("links") or {}))
    _peers |= {k for k, v in nodes.items()
               if k != nid and isinstance(v, dict) and nid in (v.get("links") or {})}
    for peer in sorted(_peers):
        mesh_link_park(nodes, nid, peer)          # both halves; each end's relay / dial settings parked for the rebuild
        mesh_link_park(nodes, peer, nid)
    me["links"] = {}


def mesh_link_waits(deps, nodes, snaps, a, b):
    """Is the pair a↔b not to be made YET — its type needs to know both ends (AmneziaWG 3.1: can both run it? a template
    with a field set to none: can both hold the omission?) and an end has never reported? q189 PR-4: a node enrolled after
    the fleet's mesh type was set to 3.1 had its links made at /api/nodes/create, before it ever reported, so every one was
    made at 2.0 (mesh_31_refusal refuses an end with no report) — and nothing rebuilds a link that works. Waiting costs
    nothing: an end that has never reported cannot bring a link up anyway, and its first sync stores its report before the
    reconcile that then makes the pair at the type in force. A pair that needs nothing from the ends (2.0 or WireGuard with
    no "-" in its template) is made at once; an existing link is never touched."""
    if a in (snaps or {}) and b in (snaps or {}):
        return False
    return mesh_gen_for(deps, nodes, a, b) == "3.1" or bool(mesh_template(deps, mesh_link_layer(nodes, a, b))[1])


def _mesh_make_link(nodes, snaps, deps, a, b, mc, alloc=None, log=True):
    """Create the link between nodes a and b on BOTH ends (link records + create requests + matching
    awg_params/psk overrides). Caller ensures the pair isn't already linked. False when the x-end's pool cannot place
    it — `alloc.miss` says which pool and why."""
    link_id = _link_id(nodes, a, b)
    x_nid = min(a, b)                            # the smaller id is the .0 end (deterministic, both ends agree)
    alloc = alloc or _MeshAlloc(nodes)
    sub = alloc.take(node_mesh_cfg(deps, nodes[x_nid])["subnet"])   # link /31 from the x-end's mesh subnet
    if sub is None:
        return False
    hosts = list(sub)                            # /31 → [.0, .1]
    # Both ends share one draw with the link and fleet templates layered on top. Older or mixed pairs fall back to 2.0.
    psk = gen_psk()
    gen = mesh_gen_for(deps, nodes, a, b)
    _is31 = gen == "3.1" and mesh_31_refusal(deps, nodes, snaps, a, b, mc["mtu"]) is None
    _ly = mesh_link_layer(nodes, a, b)
    _tv, _tom = mesh_template(deps, _ly)
    _v3, _om3 = mesh_awg3(deps, _ly) if _is31 else ({}, frozenset())
    _exact = bool(_is31 or _tom) and all(awg_exact_reported((snaps or {}).get(x)) for x in (a, b))
    if gen == "wg":
        awg = None
    elif _is31:
        awg = awg3_full(_tv, defaults=_v3, omit=(_tom | _om3) if _exact else (), s_max=mesh_s4_room(mc["mtu"]))
        if not mesh_s4_fits(awg["S4"], mc["mtu"]):
            awg_set_s4(awg, str(mesh_s4_draw(mc["mtu"], AWG31_MIN_S)))
    else:
        if all(k in _tv for k in AWG_FIELDS if k not in AWG3_FIELDS):
            awg = dict(_tv)
        elif _tv or _tom:
            awg = {k: str(v) for k, v in {**gen_awg_params("2.0"), **_tv}.items() if not (_exact and k in _tom)}
        else:
            awg = gen_awg_params("2.0")
        if gen == "3.1" and AWG31_HEADERS.keys() <= awg.keys():
            awg = awg2_profile(awg, replace_standard_headers=True)
        if not mesh_s4_fits(awg.get("S4"), mc["mtu"]):
            awg["S4"] = mesh_s4_draw(mc["mtu"])
    for nid, peer in ((a, b), (b, a)):
        n = nodes[nid]
        nmc = node_mesh_cfg(deps, n)             # per-node prefix / port base
        iface = _link_iface_name(n, link_id, nmc.get("iface_prefix") or "swg_")
        mine, theirs = (hosts[0], hosts[1]) if nid == x_nid else (hosts[1], hosts[0])
        port = _alloc_port(_used_ports(nodes, snaps, nid), nmc["port_base"])
        _stale = ((n.get("links") or {}).get(peer) or {}).get("subnet")   # a half-link's leftover record, replaced below
        # this end's own settings: parked by the teardown, else on the half-link record replaced below
        _kv = (n.get("link_keep") or {}).pop(peer, None) or mesh_link_extras((n.get("links") or {}).get(peer))
        if "link_keep" in n and not n["link_keep"]:
            n.pop("link_keep")
        n.setdefault("links", {})[peer] = {
            "iface": iface, "link_id": link_id, "subnet": str(sub),
            "address": str(mine), "peer_address": str(theirs),
            "listen_port": port, "psk": psk, "role": "x" if nid == x_nid else "y",
            **({"proto": "wg"} if awg is None else {}),       # absent = AmneziaWG; the re-stage reads it (reconcile_mesh)
            **_kv}
        n.setdefault("create", {})[iface] = {
            "cmd": ["wg"] if awg is None else ["awg"], "subnet": str(sub), "address": f"{mine}/31",
            "listen_port": port, "mtu": nmc["mtu"], "table": "off"}   # Table=off: cascade manages routing, no /0 hijack
        n.setdefault("ifaces", {})[iface] = {**({} if awg is None else {"awg_params": dict(awg)}), "system": True,
                                             "link_node": peer, **({"awg_exact": True} if awg is not None and _exact else {})}
        if _stale and _stale != str(sub):
            alloc.release(_stale)
    if log:
        ev_append(deps["roster_path"], "node", a, "Linked node", nodes[b].get("name", b))
    return True


MESH_MODES = ("auto", "full", "demand")
MESH_AUTO_FULL_MAX = 30       # auto = a full mesh up to this many nodes, on demand above
MESH_RETIRE_GRACE_S = 3600    # a link nothing has needed for this long is retired (so flipping a target back and forth is free)
MESH_LINK_EVENTS_MAX = MESH_AUTO_FULL_MAX   # per-pair "Linked node" events one reconcile writes; any more are one summary
#                             line. Tied to the auto line so an enrolment in any full mesh auto keeps logs exactly as before.
_MESH_IDLE = {}               # frozenset({a, b}) -> time.time() it was first found unneeded. Memory only: a restart
#                               restarts the grace, which only ever keeps a link longer.


def mesh_mode_effective(deps, nodes):
    """"full" or "demand" — the mode in force. ONE place, read by the reconcile, the node door and the SPA (the
    threshold is never copied into the browser)."""
    m = str((deps.get("panel_settings") or {}).get("mesh_mode") or "auto")
    if m in ("full", "demand"):
        return m
    return "full" if len(nodes) <= MESH_AUTO_FULL_MAX else "demand"


def mesh_need(nodes, deps):
    """Find the inter-node links required by stored routes and user assignments."""
    need = set()
    def want(a, b):
        if a and b and a != b and a in nodes and b in nodes:
            need.add(frozenset((a, b)))
    for nid, n in nodes.items():
        if not isinstance(n, dict):
            continue
        recs = [ov for ov in (n.get("ifaces") or {}).values() if isinstance(ov, dict) and not ov.get("system")]
        recs += [v for k in ("wdtt", "csqtt") for v in (n.get(k) or {}).values() if isinstance(v, dict)]
        _pif = p2p_policy(n) == "iface"
        for ov in recs:
            mode = ov.get("egress_mode")
            _rp = ov.get("p2p") if isinstance(ov.get("p2p"), dict) else {}
            if _pif and _rp.get("action") == "exit" and "torrents" not in (ov.get("block") or []):
                want(nid, str(_rp.get("node") or ""))   # its own "Route through node Q" (IFACE-P2P-PICK; S11 review F2)
            if mode == "forward":                    # `egress_node` exists only in forward mode
                want(nid, str(ov.get("egress_node") or ""))
            elif mode == "smart":                    # `routing` is kept, inert, outside smart mode
                for r in (ov.get("routing") or []):
                    if rule_on(r) and r.get("action") == "exit":
                        want(nid, str(r.get("node") or ""))
        if isinstance(n.get("default_routing"), list):
            for r in n["default_routing"]:
                if isinstance(r, dict) and rule_on(r) and r.get("action") == "exit":
                    want(nid, str(r.get("node") or ""))
        # …and its torrent policy's "Route through node Q" (P2P-POLICY-PLAN P3): cascade_plan sends every one of its client
        # subnets' P2P over the N↔Q link, so demand mode must link that pair too — it never came up there (q189 PR-2)
        _pp = n.get("p2p") if isinstance(n.get("p2p"), dict) else {}
        if _pp.get("action") == "exit":
            want(nid, str(_pp.get("node") or ""))
        for peer, lr in (n.get("links") or {}).items():
            if mesh_link_extras(lr):
                want(nid, peer)
        for peer in (n.get("link_keep") or {}):    # …and the same settings parked by a teardown, until the rebuild returns them
            want(nid, peer)
    if deps.get("roster_path"):
        for _, (dest, _), origin, _, _ in static_exit_clients(roster_load(deps["roster_path"])):
            want(origin, dest)
    for nid, legs in (deps.get("cas_legs") or {}).items():
        for lg in legs or ():
            want(nid, str((lg or {}).get("peer") or ""))
    return need


def _mesh_retire(nodes, need, deps):
    """Demand mode: a linked pair nothing needs starts a timer; after MESH_RETIRE_GRACE_S it is unlinked on every end
    that holds a record (a half-link whose other end or peer node is gone included) — pending create cancelled, delete
    staged, interface override and link record dropped: what `mesh_reprovision_node` does per pair, and the delete verb
    every node already honours (`orphan_mesh_links` is its backstop). One event per reconcile. True if it changed
    anything."""
    now_ = time.time()
    linked = {frozenset((a, b)) for a, n in nodes.items() for b in (n.get("links") or {}) if a != b}
    for p in [p for p in _MESH_IDLE if p not in linked or p in need]:
        _MESH_IDLE.pop(p, None)
    gone = []
    for p in linked:
        if p in need or now_ - _MESH_IDLE.setdefault(p, now_) < MESH_RETIRE_GRACE_S:
            continue
        _MESH_IDLE.pop(p, None)
        a, b = tuple(p)
        for x, y in ((a, b), (b, a)):    # retired, not rebuilt: nothing to park (an unneeded pair has no settings that act)
            mesh_link_park(nodes, x, y, park=False, now=now_)
        gone.append(p)
    if gone:
        names = sorted(" ↔ ".join(sorted(str((nodes.get(x) or {}).get("name") or x) for x in p)) for p in gone)
        # …and WHY: an auto fleet that has just grown past the line sees links go, and the row says it is on demand now.
        ev_append(deps["roster_path"], "node", "", "Removed unused mesh links",
                  ", ".join(names[:5]) + ((", … (+%d)" % (len(names) - 5)) if len(names) > 5 else ""),
                  "%d link(s) · on demand, %d node(s)" % (len(gone), len(nodes)),
                  detail_key="{count} · on demand, {nodes}",
                  detail_vars={"count": {"n": len(gone), "noun": "link"}, "nodes": {"n": len(nodes), "noun": "node"}})
    return bool(gone)


def reconcile_mesh(nodes, snaps, deps):
    """Self-healing mesh — run on every sync AND on node-add, so the mesh integrates with EVERY
    node lifecycle (panel add, auto-enrolled master/local node, convert, re-install, manual edits):
      1. ensure every node PAIR is linked (covers a node that entered nodes.json outside /api/nodes/create) — in
         demand mode (mesh_mode_effective) every NEEDED pair, and a pair nothing needs is retired after the grace;
      2. re-stage a `create` for any link interface a node isn't currently reporting AND isn't already
         creating (covers a lost/replaced conf after convert/re-install).
    Returns True if it changed anything (so the caller persists)."""
    mc = mesh_cfg(deps)
    changed = False
    ids = list(nodes.keys())
    alloc, unplaced, need = _MeshAlloc(nodes), {}, None
    mode = mesh_mode_effective(deps, nodes)
    if mode == "full":                                           # 1) every pair linked — today's loop, today's order
        _MESH_IDLE.clear()
        pairs = ((a, b) for i, a in enumerate(ids) for b in ids[i + 1:])
    else:                                                        # …or every NEEDED pair, in the same order
        need = mesh_need(nodes, deps)
        pos = {x: i for i, x in enumerate(ids)}
        pairs = sorted((tuple(sorted(p, key=pos.__getitem__)) for p in need), key=lambda ab: (pos[ab[0]], pos[ab[1]]))
    made = 0
    for a, b in pairs:
        if b not in (nodes[a].get("links") or {}):
            if mesh_link_waits(deps, nodes, snaps, a, b):
                continue                                         # made on the first reconcile after that end reports
            if _mesh_make_link(nodes, snaps, deps, a, b, mc, alloc, log=made < MESH_LINK_EVENTS_MAX):
                made += 1
                changed = True
                continue
            # …and a pair that cannot be placed is SAID, on the node whose pool it is (see _node_issues). Rebuilt
            # whole on every reconcile, so a pair placed later simply stops being named.
            _x = min(a, b); _pool, _why = alloc.miss
            unplaced.setdefault(_x, {"pool": _pool, "why": _why, "own": bool(nodes[_x].get("mesh_subnet")),
                                     "peers": []})["peers"].append(b if _x == a else a)
    if made > MESH_LINK_EVENTS_MAX:
        _more = made - MESH_LINK_EVENTS_MAX
        ev_append(deps["roster_path"], "node", "", "Linked more node pairs", "", "%d link(s)" % _more,
                  detail_key="{count}", detail_vars={"count": {"n": _more, "noun": "link"}})
    deps["mesh_unplaced"] = unplaced
    if mode == "demand":
        changed = _mesh_retire(nodes, need, deps) or changed
    for nid, n in nodes.items():                                 # 2) re-stage any missing link iface
        snap_ifs = set((((snaps or {}).get(nid) or {}).get("interfaces") or {}))
        _cr = n.get("create")
        if isinstance(_cr, dict):
            _own = n.get("ifaces") or {}
            for _ifc in [k for k in _cr if str(k).startswith("swg_") and k not in _own]:
                _cr.pop(_ifc, None)
                changed = True
        pending = set(n.get("create") or {})
        for peer, lr in (n.get("links") or {}).items():
            ifc = lr.get("iface")
            _ov = (n.get("ifaces") or {}).get(ifc)
            if isinstance(_ov, dict) and int(_ov.get("mtu") or 0) != int(mc["mtu"]):
                _ov["mtu"] = int(mc["mtu"]); changed = True
            if ifc and ifc not in snap_ifs and ifc not in pending:
                n.setdefault("create", {})[ifc] = {"cmd": ["wg"] if lr.get("proto") == "wg" else ["awg"], "subnet": lr["subnet"],
                    "address": lr["address"] + "/31", "listen_port": lr["listen_port"], "mtu": mc["mtu"], "table": "off"}
                ov = n.setdefault("ifaces", {}).setdefault(ifc, {})
                ov.setdefault("system", True); ov.setdefault("link_node", peer)
                changed = True
    seen = set()
    for a, n in nodes.items():
        for b, lr in (n.get("links") or {}).items():
            pair = (a, b) if a < b else (b, a)
            if pair in seen or b not in nodes:
                continue
            seen.add(pair)
            back = (nodes[b].get("links") or {}).get(a) or {}
            ends = [((x.get("ifaces") or {}).get(l.get("iface")) or {}).get("awg_params")
                    for x, l in ((n, lr), (nodes[b], back))]
            if not all(isinstance(p, dict) and p for p in ends):
                continue                                         # a link still being made: _mesh_make_link fitted it
            if all(mesh_s4_fits(p.get("S4"), mc["mtu"]) for p in ends):
                continue
            # An AmneziaWG 3.1 link keeps S4 ≥ 12 (header protection refuses less, and the node would roll the edit back on
            # every pass). Where a raised MTU leaves no room for 12 it is left as it is — it fragments, but it stays up.
            _floor = 12 if any(str(p.get("HeaderProtectionKey") or "").strip() for p in ends) else 0
            if _floor and (mesh_s4_room(mc["mtu"]) or 0) < _floor:
                continue
            old = "/".join(sorted({str(p.get("S4")) for p in ends}))
            s4 = mesh_s4_draw(mc["mtu"], _floor)
            for p in ends:
                awg_set_s4(p, s4)
            ev_append(deps["roster_path"], "node", a, "Fitted mesh link padding to its MTU (live)",
                      n.get("name", a) + " ↔ " + nodes[b].get("name", b), f"S4 {old} → {s4} · MTU {mc['mtu']}")
            changed = True
    return changed


def node_public_ip(snap):
    """A node's first public IPv4 from its reported node_ips — the address other nodes dial for the mesh
    (used when an operator hasn't set an explicit endpoint_host). Skips private/loopback/link-local."""
    for ip in (snap or {}).get("node_ips") or []:
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            continue
        if a.version == 4 and not (a.is_private or a.is_loopback or a.is_link_local):
            return ip
    return ""


def mesh_advertised_host(snap, iface):
    """The host a node ADVERTISES on one of its interfaces — what it tells that interface's clients to dial (its agent
    config's endpoint, reported with the interface as `meta.endpoint`). "" for a wildcard, a loopback, or an IPv6
    literal (the mesh is sized for IPv4 — see mesh_s4_room)."""
    ep = str(((((snap or {}).get("interfaces") or {}).get(iface) or {}).get("meta") or {}).get("endpoint") or "")
    host = ep.rsplit(":", 1)[0] if ":" in ep else ""
    if not host or ":" in host or host in ("0.0.0.0", "localhost") or host.startswith("127."):
        return ""
    return host


def mesh_endpoint_host(node, snap, iface=None):
    """The host a peer dials for this node's mesh: the explicit endpoint_host, else its reported public IP, else the
    host the node itself advertises on that link.

    ⚠️ THE LAST RESORT IS WHAT MAKES A PRIVATE-ADDRESS FLEET MESH AT ALL. With only the first two, a node whose every
    address is private — a LAN, a NAT'd cloud VM, the qualification lab — had no dial host unless an operator typed
    its ingress address, and a link whose REMOTE end has none gets no peer (desired_mesh_for_node): WireGuard drops a
    handshake from a key it does not hold, so one blank end took the whole link down, with no issue raised anywhere.
    Measured (1.8.8 qualification, q3m ↔ q4n, both Docker, both 192.168.77.x): both ends peerless; the master's own
    endpoint set → the node dialled it and was ignored; both set → handshake within seconds. The advertised host is
    the address that node's clients are already handed — a link that works today resolves before reaching it, so
    nothing that meshes now changes; a remote behind NAT that dials OUT is answered too (WireGuard roams to where the
    handshake came from, and swg-noded re-asserts an endpoint only when the DESIRED one changes)."""
    return (node.get("endpoint_host") or "").strip() or node_public_ip(snap) or mesh_advertised_host(snap, iface)


def desired_mesh_for_node(nodes, nid, keepalive, allowed_overrides=None, snaps=None):
    """The mesh peer set for `nid`, grouped by link iface — one remote peer per link, emitted only once
    the REMOTE end is ready (its pubkey blessed, its listen_port known, its dial endpoint resolvable).
    `allowed_overrides` (Phase 2 cascade) maps a local link iface → the AllowedIPs the mesh peer should
    carry (e.g. "0.0.0.0/0" on a forwarding entry, "<base>/32,<subnet>" on an exit); default = link /32."""
    ov_map = allowed_overrides or {}
    snaps = snaps or {}
    out = {}
    me = nodes.get(nid) or {}
    for peer_nid, lr in (me.get("links") or {}).items():
        peer = nodes.get(peer_nid)
        if not peer:
            continue
        iface = lr.get("iface")
        rlr = (peer.get("links") or {}).get(nid) or {}
        rov = (peer.get("ifaces") or {}).get(rlr.get("iface")) or {}
        pub = rov.get("public_key"); rport = rlr.get("listen_port")
        # per-connection override → peer's ingress IP → reported public IP → the host the peer advertises on this link
        rhost = (lr.get("dial_endpoint") or "").strip() or mesh_endpoint_host(peer, snaps.get(peer_nid), rlr.get("iface"))
        if not (pub and rport and rhost and iface):
            continue                                   # remote not ready → no peer yet (the iface still exists)
        out.setdefault(iface, []).append({
            "public_key": pub,
            "allowed_ips": ov_map.get(iface) or ((lr.get("peer_address") or "") + "/32"),   # cascade override, else link /32
            "preshared_key": lr.get("psk") or "none",
            "endpoint": f"{rhost}:{rport}",
            "persistent_keepalive": keepalive,
            "dial_src": (lr.get("dial_src") or "").strip() or (me.get("mesh_egress_ip") or "").strip(),
            "name": "mesh:" + (peer.get("name") or peer_nid)})
    return out


