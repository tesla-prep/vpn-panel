                if not exit_ or exit_.get("enabled") is False:
                    return 400, {"ok": False, **perr("Choose an enabled SOCKS5 exit"), "code": "bad_request"}
                if not static_exit_supported((deps.get("node_snaps") or {}).get(nid)):
                    return 409, {"ok": False, **perr("Update the exit server before assigning a static exit"), "code": "conflict"}
                if any(k != uid and static_exit_ref(u.get("static_exit")) == ref
                       for k, u in roster["users"].items() if isinstance(u, dict)):
                    return 409, {"ok": False, **perr("This SOCKS5 exit is already assigned to another user"), "code": "conflict"}
                fields["static_exit"] = {"node_id": nid, "exit_id": xid}
        renamed = "name" in fields
