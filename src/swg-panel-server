def _csqtt_vk_hashes(p, u, fallback_vk=""):
    links = list((u or {}).get("vk_links") or [])
    if not links and (u or {}).get("vk_link"):
        links = [(u or {}).get("vk_link")]
    if not links and fallback_vk:
        links = [fallback_vk]
    out = []
    for raw in [(p or {}).get("vk_hash") or ""] + links:
        h = _wdtt_vk_hash(raw)
        if not h or len(h) < _CSQTT_VK_MINLEN or any(c.isspace() for c in h) or "," in h or h in out:
            continue
        out.append(h)
        if len(out) >= _CSQTT_VK_MAX:
            break
    joined = ",".join(out)
    return joined if len(joined) <= _CSQTT_VK_MAXLEN else ",".join(out[:1])


