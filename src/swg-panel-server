class PanelServer(ThreadingHTTPServer):
    def get_request(self):
        sock, addr = super().get_request()
        sock.settimeout(60)
        return sock, addr


_REQ = threading.local()                 # per-request: which listener this request arrived on (set in do_GET/POST)
_SIGTERM_SEEN = []


def _sigterm_exit(_sig, _frm):
    """SIGTERM → write the traffic ledger's open state (TrafficLedger.shutdown), then exit 0. As a docker container's PID
    1 the panel used to IGNORE SIGTERM (a PID 1 has no default action) and was killed 10 s later — it now stops at once.
    ⚠️ os._exit, not SystemExit: interpreter finalization with daemon threads still printing (syncs, requests) can abort
    in the stdout lock — SIGABRT, a core, a failed unit. The listeners and the writer are daemons holding nothing to
    close, and nothing registers atexit. ⚠️ ONCE: a second SIGTERM during a slow flush re-enters this handler on the
    same thread, and the ledger's locks are not reentrant — it exits at once instead of deadlocking."""
    if _SIGTERM_SEEN:
        os._exit(0)
    _SIGTERM_SEEN.append(1)
    _api_lock.acquire(timeout=8)
    with contextlib.suppress(Exception):
        LEDGER.shutdown()
    with contextlib.suppress(Exception):
        sys.stdout.flush(); sys.stderr.flush()
    os._exit(0)


def _sub_url_base(url):
    """The reverse-proxy mount base from a sub PUBLIC url's path (e.g. https://h/swgsub → '/swgsub'), '' for root."""
    with contextlib.suppress(Exception):
        p = urlparse((url if "://" in (url or "") else "https://" + (url or ""))).path.rstrip("/")
        if p and p != "/":
            return p
    return ""
def _raise_fd_limit():
    """systemd hands this unit LimitNOFILE=524288 as the HARD limit but leaves the SOFT one at 1024, and
    Python obeys the soft one — so the panel ran into a 1024-descriptor wall while the kernel was willing to
    give it far more. Raise soft to hard (capped), which costs nothing and turns a hard outage into headroom."""
    try:
        import resource
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        want = min(hard, 65536) if hard != resource.RLIM_INFINITY else 65536
        if soft < want:
            resource.setrlimit(resource.RLIMIT_NOFILE, (want, hard))
            log(LOG_INFO, "swg-panel: raised open-file limit %d -> %d", soft, want)
    except Exception as e:
        log(LOG_WARNING, "swg-panel: could not raise the open-file limit (%s) — staying at the default" % e)


_FD_WARNED = {"at": 0.0}


def _fd_watchdog_loop():
    """Descriptors are the panel's real ceiling, and hitting it is silent until EVERYTHING fails at once —
    reads, writes, even loading the node store, which then gets misreported as corruption.

    So watch the count, and when it crosses 60% of the limit DUMP EVERY THREAD'S STACK to the journal. The
    outage this was written for left 1027 threads parked on a futex and 932 sockets in CLOSE-WAIT, and the
    stacks — the one thing that would have named the holder — died with the restart that fixed it. Cheap: one
    listdir of /proc/self/fd every 30s. SIGUSR1 dumps on demand too (`kill -USR1 <pid>`)."""
    try:
        import faulthandler, resource
        faulthandler.register(signal.SIGUSR1, all_threads=True)
    except Exception:
        faulthandler = None
    while True:
        try:
            time.sleep(30)
            soft = resource.getrlimit(resource.RLIMIT_NOFILE)[0]
            try:
                n = len(os.listdir("/proc/self/fd"))
            except OSError:
                continue                                   # no /proc (odd container) → nothing to watch
            if soft and n > soft * 0.6 and time.time() - _FD_WARNED["at"] > 600:
                _FD_WARNED["at"] = time.time()
                log(LOG_ERR, "swg-panel: OPEN FILES %d of %d (%d threads) — dumping thread stacks so the "
                                 "holder is named while it is still happening", n, soft, threading.active_count())
                sys.stderr.flush()
                if faulthandler:
                    faulthandler.dump_traceback(file=sys.stderr, all_threads=True)
                    sys.stderr.flush()
        except Exception:
            pass


def _release_startup_memory():
    """Give the startup heap back to the kernel, once, when startup is done (~4 ms).

    The prologue at the top of this file stops the AST from staying LIVE, but compile()'s scratch memory (~90 MB
    for this file) is freed into glibc's heap, and glibc keeps it: RSS would stay at the compile peak.
    malloc_trim(0) returns the free pages. glibc only — elsewhere (musl, no ctypes) it does nothing."""
    try:
        import ctypes
        trim = ctypes.CDLL(None).malloc_trim             # AttributeError where libc has none (musl)
        trim.argtypes, trim.restype = (ctypes.c_size_t,), ctypes.c_int   # int malloc_trim(size_t pad)
        trim(0)
    except Exception:                                    # no ctypes, no symbol, a refused load: no trim, nothing else
        pass


