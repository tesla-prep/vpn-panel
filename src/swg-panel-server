                                "iface_vault_want": _ivk_want,   # ifaces the panel needs a current sealed key for
                                "panel_url": _panel_public_url(Handler.deps),
                                "remove": _remove,   # pubkeys to drop even on add-only ifaces (retired, or cut off and still live)
                                "delete": list((node.get("delete") or {}).keys()),
                                "restart": list((node.get("restart") or {}).keys()),   # interfaces to bounce
                                # "Load now": the counter WITH ITS AGE on this clock — the node acts once, and only on a fresh press
                                **({"awg_load": {"n": _awg_int((node.get("awg_load") or {}).get("n")),
