def _short_ver(s):
    for tok in s.replace(",", " ").split():
        t = tok.lstrip("vV")
        if t and t[0].isdigit():
            return t
    return s.strip()


def _detect_versions():
    out = {"panel": _read_version()}
    for key, args in (("awg", ["awg", "--version"]),
                      ("wg", ["wg", "--version"]),
                      ("docker", ["docker", "--version"])):
        try:
            p = subprocess.run(args, capture_output=True, text=True, timeout=3)
            line = ((p.stdout or "") + (p.stderr or "")).strip().splitlines()
            if line:
                out[key] = _short_ver(line[0])
        except Exception:
            pass
    return {k: v for k, v in out.items() if v}

def _panel_units():
    raw = os.environ.get("SWG_PANEL_UNITS")
    if raw is None:
        return (("panel", "swg-panel-server.service"), ("sub", "swg-sub.service"),
                ("netctl_path", "swg-netctl.path"), ("netctl_timer", "swg-netctl.timer"),
                ("update", "swg-update.timer"))
    out = []
    for part in raw.split(","):
        key, _, unit = part.strip().partition(":")
        if key.strip() and unit.strip():
            out.append((key.strip(), unit.strip()))
    return tuple(out)


