_SOCKS_HOST_RE = re.compile(r"(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\.?")


PROXY_KINDS = ("socks5", "http")


def parse_socks_text(text, provider="socks5"):
    t = str(text or "").strip()
    if not t:
        return None, "paste the proxy's address"
    m = re.match(r"([A-Za-z][A-Za-z0-9+.-]*)://", t)
    url = bool(m)
    if m:
        schemes = ("http",) if provider == "http" else ("socks5", "socks5h")
        if m.group(1).lower() not in schemes:
            return None, "Use an http:// address for HTTP CONNECT." if provider == "http" else _SOCKS_NOT
        t = t[m.end():].rstrip("/")
    if any(c.isspace() for c in t):
        return None, "the proxy address has a space in it"
    user = pw = ""
    def _host(h):
        with contextlib.suppress(ValueError):
            return ipaddress.ip_address(h).version == 4
        return bool(_SOCKS_HOST_RE.fullmatch(h))
    _isport = lambda x: bool(re.fullmatch(r"[0-9]{1,5}", x or "")) and 1 <= int(x) <= 65535
    _hp = lambda x: x.count(":") == 1 and _host(x.partition(":")[0]) and _isport(x.partition(":")[2])
    parts = t.split(":")
    reads, _at = set(), False
    if not url and "@" in t and _hp(t.rpartition("@")[2]):
        _at = True
        _c, _, _h = t.rpartition("@")
        reads.add((_h,) + tuple(_c.partition(":")[::2]))
    if not url and len(parts) >= 4 and _host(parts[0]) and _isport(parts[1]):
        reads.add((parts[0] + ":" + parts[1], parts[2], ":".join(parts[3:])))
    if not url and len(parts) == 4 and _hp(parts[2] + ":" + parts[3]):
        reads.add((parts[2] + ":" + parts[3], parts[0], parts[1]))
    if len(reads) > 1:
        def _named(h):
            with contextlib.suppress(ValueError):
                return ipaddress.ip_address(h).version == 4
            return h.lower() == "localhost" or h.count(".") >= 2
        _real = [r for r in reads if _named(r[0].rpartition(":")[0])]
        if len(parts) == 4 and not _at and len(_real) == 1:
            reads = set(_real)
    if len(reads) > 1:
        return None, ("this proxy address can be read more than one way — paste it as http://user:password@host:port"
                      if provider == "http" else "this proxy address can be read more than one way — paste it as socks5://user:password@host:port")
    if url:
        cred, _, hp = t.rpartition("@") if "@" in t else ("", "", t)
        user, _, pw = cred.partition(":")
    elif reads:
        hp, user, pw = next(iter(reads))
    elif len(parts) == 2:
        hp = t
    elif "::" in t or "[" in t:
        return None, "an IPv6 proxy address cannot be used — exits are IPv4"
    else:
        return None, "the proxy address must be host:port, host:port:user:password or user:password@host:port"
    if "[" in hp or hp.count(":") > 1:
        return None, "an IPv6 proxy address cannot be used — exits are IPv4"
    host, _, port = hp.rpartition(":")
    if not re.fullmatch(r"[0-9]{1,5}", port or "") or not 1 <= int(port) <= 65535:
        return None, "the proxy's port must be a number from 1 to 65535"
    try:
        ipaddress.ip_address(host)
        if ":" in host:
            return None, "an IPv6 proxy address cannot be used — exits are IPv4"
    except ValueError:
        if not _SOCKS_HOST_RE.fullmatch(host):
            return None, "the proxy's host is not an address or a name"
    if url:
        try:
            user, pw = urllib.parse.unquote(user, errors="strict"), urllib.parse.unquote(pw, errors="strict")
        except UnicodeDecodeError:
            return None, "the proxy login has a %-escape that is not text — write it without one"
    if len(user) > 255 or len(pw) > 255:
        return None, "the proxy login is longer than SOCKS5 allows (255 characters)"
    if any(ord(c) < 32 for c in user + pw):
        return None, "the proxy login has a control character in it"
    if pw and not user:
        return None, "the proxy has a password but no user name"
    if provider == "http" and ":" in user:
        return None, "HTTP Basic authentication does not allow a colon in the user name."
    return {"host": host.rstrip(".").lower(), "port": int(port), "user": user, "pass": pw}, ""


def socks_resolve(text, pw, kept, provider="socks5"):
    kept = kept if isinstance(kept, dict) else {}
    t = str(text or "").strip()
    if t:
        sk, err = parse_socks_text(t, provider)
        if err:
            return None, err
    elif kept.get("host"):
        sk = {k: kept.get(k) or ("" if k != "port" else 0) for k in ("host", "port", "user", "pass")}
    else:
        return None, "paste the proxy's address"
    new = pw[:255] if isinstance(pw, str) and pw and pw != EXIT_PASS_KEEP else ""
    pasted = bool(t and sk["pass"])
    if new and not pasted:
        sk["pass"] = new
    elif t and not pasted:
        same = (sk["host"], int(sk["port"]), sk["user"]) == (kept.get("host"), int(kept.get("port") or 0), kept.get("user"))
        if kept.get("pass") and sk["user"] and same:
            sk["pass"] = kept["pass"]
        elif kept.get("pass") and sk["user"] and pw == EXIT_PASS_KEEP:
            return None, "the proxy's address or user changed — type its password again"
        else:
            sk["pass"] = ""
    if sk["pass"] and not sk["user"]:
        return None, "the proxy has a password but no user name"
    if provider == "http" and ":" in sk["user"]:
        return None, "HTTP Basic authentication does not allow a colon in the user name."
    if any(ord(ch) < 32 for ch in sk["pass"]):
        return None, "the proxy login has a control character in it"
    return sk, ""


def exit_kind_refusal(snap, kind, name="this node"):
    if kind not in PROXY_KINDS:
        return None
    _k = (snap or {}).get("exit_kinds")
    if isinstance(_k, list) and kind in _k:
        return None
    if kind == "http":
        return perr("{v1}: update the node to use HTTP CONNECT proxies", v1=name)
    return perr("{v1}: this node cannot run a SOCKS5 exit yet — update the node to 1.8.11", v1=name)


