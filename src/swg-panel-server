def _release_cache_path(deps):
    return os.path.join(os.path.dirname(deps.get("nodes_path") or ".") or ".", "release-cache.json")

def _release_cache_save(deps):
    with contextlib.suppress(Exception):
        data = {"release_info": {o + "/" + r: v for (o, r), v in _RELEASE_INFO.items()},
                "platform_asset": {o + "/" + r + "/" + osk: u for (o, r, osk), u in _PLATFORM_ASSET.items()},
                "release_pin": {o + "/" + r + "/" + v: x for (o, r, v), x in _RELEASE_PIN.items()}}
        p = _release_cache_path(deps); tmp = p + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, p)

def _release_cache_load(deps):
    with contextlib.suppress(Exception):
        data = json.load(open(_release_cache_path(deps)))
        for k, v in (data.get("release_info") or {}).items():
            o, r = k.split("/", 1)
            _RELEASE_INFO[(o, r)] = v
        for k, u in (data.get("platform_asset") or {}).items():
            o, r, osk = k.rsplit("/", 2)
            _PLATFORM_ASSET[(o, r, osk)] = u
        for k, x in (data.get("release_pin") or {}).items():
            o, r, v = k.split("/", 2)
            if isinstance(x, dict) and isinstance(x.get("url"), dict):
                _RELEASE_PIN[(o, r, v)] = x
                _PIN_SEEN[(o, r, v)] = time.monotonic()

_SUB_SERVE_LOCK = threading.RLock()

def _turn_warm_assets_loop(deps):
    def flush():
        with _SUB_SERVE_LOCK:
            ba = ""
            with contextlib.suppress(Exception):
                ba = ((json.load(open(_sub_serve_path(deps))).get("serve") or {}).get("base_alt") or "")
            write_sub_serve(deps, base_alt=ba)
    def pins(refresh):
        with contextlib.suppress(Exception):
            return _turn_warm_pins(deps, refresh)
        return False
    if pins(False):
        with contextlib.suppress(Exception):
            flush()
    while True:
        resolved = 0
        try:
            resolved = _turn_warm_assets()
            if (pins(bool(resolved)) or resolved):
                _release_cache_save(deps)
            flush()
        except Exception:
            pass
        until = time.time() + (3600 if resolved else 120)
        while time.time() < until:
            time.sleep(min(300, max(1, until - time.time())))
            if time.time() >= until:
                break
            if pins(False):
                with contextlib.suppress(Exception):
                    _release_cache_save(deps)
                    flush()

def _turn_p4_refresh(cid, roster):
    schema_srcs = [s for s in _client_sources(cid) if _source_field_parseable(s["path"])] if _p4_field_client(cid) else []
    vsrcs = _client_value_sources(cid)
    if not schema_srcs and not vsrcs:
        return False
    rec = roster.setdefault(cid, {})
    snaps = rec.setdefault("snapshots", [])
    last = snaps[-1] if snaps else None
    files = {}
    for s in schema_srcs:
        files[s["path"]] = (s["owner"], s["repo"], s["branch"], s["path"])
    for cfg in vsrcs.values():
        o, r, b, p = cfg["src"]
        files[p] = (o, r, b, p)
    commits = {}
    for p, loc in files.items():
        latest = _gh_latest_commit(*loc)
        if latest and latest.get("sha"):
            commits[p] = latest["sha"]
    if not commits:
        return False
    if last is not None and (last.get("commits") or {}) == commits:
        return False
    raw = {p: _gh_raw(*loc) for p, loc in files.items()}
    fields, ok = set(), False
    for s in schema_srcs:
        flds = _parse_source_fields(s["path"], raw.get(s["path"]), s.get("message")) if raw.get(s["path"]) is not None else None
        if flds is not None:
            fields.update(flds)
            ok = True
    values = {}
    for key, cfg in vsrcs.items():
        p = cfg["src"][3]
        if raw.get(p) is not None:
            vals = _extract_values(cfg["kind"], raw[p], cfg["marker"])
            if vals is not None:
                values[key] = vals
            ok = True
    if not ok:
        return False
    fields = sorted(fields)
    if last is not None and set(last.get("fields") or []) == set(fields) and (last.get("values") or {}) == values:
        last["commits"] = commits
        return False
    rel_loc = (schema_srcs[0]["owner"], schema_srcs[0]["repo"]) if schema_srcs else next(iter(vsrcs.values()))["src"][:2]
    rel = _gh_latest_release(*rel_loc)
    snaps.append({"app_version": (rel or {}).get("tag"), "at": int(time.time()), "commits": commits, "fields": fields, "values": values})
    return True

def _turn_p4_adopt(cid, roster, add=None, remove=None, vadd=None, vrem=None):
    rec = roster.setdefault(cid, {})
    rep = _turn_client_p4_report(cid, rec) or {}
    can_add, can_rm = set(rep.get("added") or []), set(rep.get("removed") or [])
    active, hidden = set(rec.get("active") or []), set(rec.get("hidden") or [])
    did_add = [f for f in (add or []) if f in can_add]
    did_rm = [f for f in (remove or []) if f in can_rm]
    active |= set(did_add)
    for f in did_rm:
        active.discard(f)
        hidden.add(f)
    rec["active"], rec["hidden"] = sorted(active), sorted(hidden)
    vd = {v["field"]: v for v in (rep.get("value_diff") or [])}
    av = dict(rec.get("active_vals") or {})
    vdid = {"added": {}, "removed": {}}
    for f, vals in (vadd or {}).items():
        allow = set(vd.get(f, {}).get("added") or []) if vd.get(f, {}).get("adoptable_add") else set()
        take = [v for v in (vals or []) if v in allow]
        if take:
            av[f] = sorted(set(av.get(f) or []) | set(take)); vdid["added"][f] = take
    for f, vals in (vrem or {}).items():
        allow = set(vd.get(f, {}).get("removed") or [])
        take = [v for v in (vals or []) if v in allow]
        if take:
            av[f] = sorted(set(av.get(f) or []) - set(take)); vdid["removed"][f] = take
    rec["active_vals"] = av
    return {"added": did_add, "removed": did_rm, "values": vdid}

def _turn_p4_setversion(cid, roster, index):
    rec = roster.setdefault(cid, {})
    snaps = rec.get("snapshots") or []
    if index is None:
        rec["pinned_snapshot"] = None
        snap = snaps[-1] if snaps else None
    elif isinstance(index, int) and 0 <= index < len(snaps):
        rec["pinned_snapshot"] = index
        snap = snaps[index]
    else:
        return None
    if snap is not None:
        rec["active"] = _turn_seed_active(cid, _filter_inventory(cid, snap.get("fields") or []))
        rec["hidden"] = []
        rec["active_vals"] = {k: sorted(set(_strip_sentinels(v))) for k, v in (snap.get("values") or {}).items()}
    return rec

def _turn_p4_report_all(do_refresh=False):
    roster = _turn_roster_load()
    dirty, out = False, {}
    for cid in TURN_CLIENTS:
        if not _p4_field_client(cid) and not _client_value_sources(cid):
            continue
        rec = roster.setdefault(cid, {})
        if do_refresh and _turn_p4_refresh(cid, roster):
            dirty = True
        had_active = rec.get("active") is not None
        rep = _turn_client_p4_report(cid, rec)
        if not had_active and rec.get("active") is not None:
            dirty = True
        if rep is None:
            continue
        out[cid] = {**rep, "name": TURN_CLIENTS[cid].get("name") or cid,
                    "versions": [{"app_version": s.get("app_version"), "at": s.get("at")} for s in (rec.get("snapshots") or [])],
                    "pinned_snapshot": rec.get("pinned_snapshot")}
    if dirty:
        _turn_roster_save(roster)
    return {"clients": out, "checked_at": int(time.time())}

_GH_RATE = {"until": 0}

_GH_FP_URL = os.environ.get(
    "SWG_FINGERPRINTS_URL",
    "https://raw.githubusercontent.com/tesla-prep/vpn-panel/fingerprints/client-fingerprints.json")
_GH_FP_TTL = 3600
_GH_FP = {"at": 0.0, "map": {}, "ok": False}


def _gh_fingerprints():
    now = time.time()
    if now - _GH_FP["at"] < _GH_FP_TTL:
        return _GH_FP["map"]
    flat = {}
    ok = False
    with contextlib.suppress(Exception):
        req = urllib.request.Request(_GH_FP_URL, headers={"User-Agent": "swg-panel", "Cache-Control": "no-cache"})
        with urllib.request.urlopen(req, timeout=10) as r:
            doc = json.loads(r.read(2_000_000).decode("utf-8", "replace"))
        if isinstance(doc, dict) and int(doc.get("schema") or 0) == 1:
            for _cid, files in (doc.get("clients") or {}).items():
                for key, rec in (files or {}).items():
                    if isinstance(rec, dict) and rec.get("sha"):
                        flat[key] = {"sha": rec.get("sha"), "date": rec.get("date"), "url": rec.get("url")}
            ok = True
    _GH_FP.update({"at": now, "map": flat, "ok": ok})
    return flat

def _gh_latest_commit(owner, repo, branch, path):
    key = "%s/%s@%s:%s" % (owner, repo, branch, path)
    if not os.environ.get("SWG_GH_TOKEN", "").strip():
        hit = _gh_fingerprints().get(key)
        if hit:
            return hit
    ent = _GH_COMMIT_CACHE.get(key)
    if ent and time.time() - ent["at"] < 3600:
        return ent["res"]
    res = None
    try:
        url = ("https://api.github.com/repos/%s/%s/commits?path=%s&sha=%s&per_page=1"
               % (quote(owner), quote(repo), quote(path), quote(branch)))
        hdr = {"User-Agent": "swg-panel", "Accept": "application/vnd.github+json"}
        tok = os.environ.get("SWG_GH_TOKEN", "").strip()
        if tok:
            hdr["Authorization"] = "Bearer " + tok
        with urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=10) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
        if isinstance(data, list) and data:
            c = data[0]
            res = {"sha": c.get("sha"), "date": (((c.get("commit") or {}).get("committer") or {}).get("date")), "url": c.get("html_url")}
    except Exception as e:
        res = None
        _h = getattr(e, "headers", None)
        if getattr(e, "code", None) in (403, 429) and _h is not None:
            with contextlib.suppress(Exception):
                if str(_h.get("X-RateLimit-Remaining", "")).strip() == "0":
                    _GH_RATE["until"] = int(_h.get("X-RateLimit-Reset") or 0)
                    return None
    _GH_COMMIT_CACHE[key] = {"res": res, "at": time.time()}
    return res

def _gh_raw(owner, repo, branch, path):
    try:
        url = "https://raw.githubusercontent.com/%s/%s/%s/%s" % (owner, repo, branch, path)
        req = urllib.request.Request(url, headers={"User-Agent": "swg-panel", "Cache-Control": "no-cache"})
        with urllib.request.urlopen(req, timeout=12) as r:
            return r.read().decode("utf-8", "replace")
    except Exception:
        return None

def _proto_message_block(text, msg):
    m = re.search(r'\bmessage\s+' + re.escape(msg) + r'\s*\{', text or "")
    if not m:
        return None
    i, start, depth = m.end(), m.end(), 1
    while i < len(text) and depth:
        depth += 1 if text[i] == "{" else (-1 if text[i] == "}" else 0)
        i += 1
    return text[start:i - 1]

def _parse_proto_fields(text, message=None):
    if message:
        text = _proto_message_block(text, message)
        if text is None:
            return None
    fields = set()
    for line in (text or "").splitlines():
        m = re.match(r'\s*(?:repeated\s+|optional\s+)?(?:map<[^>]+>|[\w.]+)\s+(\w+)\s*=\s*\d+\s*;', line)
        if m:
            fields.add(m.group(1))
    return sorted(fields)

def _parse_python_config_fields(text):
    try:
        tree = ast.parse(text or "")
    except Exception:
        return None
    named = {}
    for node in getattr(tree, "body", []):
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Dict):
            keys = {k.value for k in node.value.keys if isinstance(k, ast.Constant) and isinstance(k.value, str)}
            if keys:
                for t in node.targets:
                    if isinstance(t, ast.Name):
                        named[t.id] = keys
    if not named:
        return None
    if "CONFIG" in named:
        return sorted(named["CONFIG"])
    out = set()
    for v in named.values():
        out |= v
    return sorted(out)

def _parse_go_struct_fields(text):
    text = text or ""
    fields = set()
    for m in re.finditer(r'`[^`]*\b(?:json|yaml|toml|mapstructure):"([^",]+)(?:,[^"]*)?"', text):
        nm = m.group(1).strip()
        if nm and nm != "-":
            fields.add(nm)
    if not fields:
        for block in re.finditer(r'struct\s*\{([^{}]*)\}', text, re.S):
            for line in block.group(1).splitlines():
                fm = re.match(r'\s*([A-Z]\w*)\s+[\w\*\[\]\.]+', line)
                if fm:
                    fields.add(fm.group(1))
    return sorted(fields) if fields else None

def _parse_kotlin_fields(text):
    fields = set()
    for line in (text or "").splitlines():
        m = re.match(r'\s*(?:@\w+\s+)*(?:override\s+|private\s+|public\s+|internal\s+|protected\s+|const\s+)*(?:val|var)\s+(\w+)\s*:\s*[\w<>?.,\[\]* ]+', line)
        if m:
            fields.add(m.group(1))
    return sorted(fields) if fields else None

def _source_field_parseable(path):
    return (path or "").lower().endswith((".proto", ".py", ".go", ".kt"))

def _parse_source_fields(path, text, message=None):
    p = (path or "").lower()
    if p.endswith(".proto"):
        return _parse_proto_fields(text, message)
    if p.endswith(".py"):
        return _parse_python_config_fields(text)
    if p.endswith(".go"):
        return _parse_go_struct_fields(text)
    if p.endswith(".kt"):
        return _parse_kotlin_fields(text)
    return None

def _extract_values_jsarray(text, marker):
    m = re.search(re.escape(marker) + r'\s*=\s*\[(.*?)\]', text or "", re.S)
    if not m:
        return None
    vals = re.findall(r'\bvalue\s*:\s*[\'"]([^\'"]+)[\'"]', m.group(1))
    return sorted(set(vals)) if vals else None

def _extract_values_mdpipe(text, flag):
    for line in (text or "").splitlines():
        if ("`" + flag + "`") not in line or not re.search(r'\\\|', line):
            continue
        toks = [t for t in re.findall(r'`([\w.-]+)`', line) if not t.startswith("-")]
        if toks:
            return sorted(set(toks))
    return None

def _extract_values_pytuple(text, field):
    m = re.search(re.escape(field) + r'\b[^\n]*?\bin\s*[\(\[]([^)\]]*)[)\]]', text or "")
    if not m:
        return None
    vals = re.findall(r'[\'"]([^\'"]+)[\'"]', m.group(1))
    return sorted(set(vals)) if vals else None

def _extract_values_gochain(text, field):
    vals = {m.group(1) for m in re.finditer(re.escape(field) + r'\s*(?:==|!=)\s*"([^"]+)"', text or "")}
    return sorted(vals) if vals else None

_VALUE_EXTRACTORS = {"jsarray": _extract_values_jsarray, "mdpipe": _extract_values_mdpipe,
                     "pytuple": _extract_values_pytuple, "gochain": _extract_values_gochain}
def _extract_values(kind, text, marker):
    fn = _VALUE_EXTRACTORS.get(kind)
    return fn(text, marker) if fn else None

def _turn_roster_load():
