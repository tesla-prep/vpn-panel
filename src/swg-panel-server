            _awgput, _e3 = awg3_check(awg3_full(_awgput, None, awg3_defaults(deps), omit=(_omit or (
                frozenset(k for k in AWG_FIELDS if k not in AWG3_FIELDS and k not in _awgput) if _exact else frozenset()))
                | (awg3_omitted(deps) - set(_awgput)) | awg3_left_out(_awgput)))
            if _e3:
                return 400, {"ok": False, **_e3, "code": "bad_request"}
            _exact = _exact or awg_exact_reported(_snap)
            _bl = turn_awg3_blockers(deps, nodes, nid, {req.get("listen_port")})
            if _bl:
                return 409, {"ok": False, **turn_awg3_refusal(_bl, iface), "code": "turn_awg3", "turn_proxies": _bl}
        elif _gen == "2.0":
