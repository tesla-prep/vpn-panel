# What's new: read on demand, by VERSION
_CHANGELOG_CACHE = {}          # lang -> {"at": …, "tried": …, "entries": […]}
CHANGELOG_TTL_S = 3600         # a changelog that holds what was asked for is kept this long
CHANGELOG_RETRY_S = 60         # one that lacks the asked-for version is fetched again at most this often


def _changelog_entries(lang="en", want=""):
    """Parse the FULL remote changelog → [{version, date, notes[]}] newest-first — both bubbles read it. Cached an hour
    PER LANGUAGE, unless it lacks `want` (the version on the update badge): then it is fetched again, at most once a
    minute, so a copy read before the CDN caught up is not kept for the hour. Keeps the last good result on a failed
    fetch. Best-effort → []."""
    now = int(time.time())
    cache = _CHANGELOG_CACHE.setdefault(lang, {"at": 0, "tried": 0, "entries": []})
    has = not want or any(e.get("version") == want for e in cache["entries"])
    if cache["entries"] and now - cache["at"] < CHANGELOG_TTL_S and (has or now - cache.get("tried", 0) < CHANGELOG_RETRY_S):
        return cache["entries"]
    cache["tried"] = now
    try:
        base = _changelog_url(lang)
        url = base + (("&" if "?" in base else "?") + "cb=" + str(now))
        text = _gh_get(url, {"User-Agent": "swg-panel", "Cache-Control": "no-cache"},
                       200000, time.time() + 20, tries=1).decode("utf-8", "replace")
    except Exception:
        # not published in this language (yet) → English, so the browser always has something to show
        return cache["entries"] or (_changelog_entries("en", want) if lang != "en" else [])
    entries, cur_entry, cur = [], None, []
    def _flush():
        if cur_entry is not None and cur:
            b = re.sub(r"[*`]", "", " ".join(cur)).strip()
            if b:
                cur_entry["notes"].append(b)
    for ln in text.splitlines():
        s = ln.strip()
        m = re.match(r"^##\s*\[([^\]]+)\]\s*(?:—\s*(.+))?$", s)   # "## [1.4.2-beta] — 2026-07-24"
        if m:
            _flush(); cur = []
            cur_entry = {"version": m.group(1).strip(), "date": (m.group(2) or "").strip(), "notes": []}
            entries.append(cur_entry)
            continue
        if cur_entry is None:
            continue
        if s.startswith("- "):
            _flush(); cur = [s[2:]]
        elif s.startswith("### ") or not s:
            _flush(); cur = []
        elif cur:
            cur.append(s)
    _flush()
    for e in entries:
        e["notes"] = e["notes"][:20]
    entries = entries[:80]
    if entries:
        cache["at"] = now; cache["entries"] = entries
    return entries or cache["entries"]      # a 200 page with no headings (captive, block page) keeps the last good (q189 PLO-10)
