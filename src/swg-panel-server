_LB_MAGIC, _LB_VER = b"SWGL", 1
_LB_HEAD = struct.Struct("<4sHHQQIIIIIII")   # magic ver flags written newest day idx step nslots nnames nrecs crc
_LB_REC = struct.Struct("<IIIQQI")           # node iface pid (name-table indexes), last_rx, last_tx, ts
