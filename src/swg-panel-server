def _block_sources(sources):
    out = []
    seen = set()
    for source in sources if isinstance(sources, list) else ():
        if not isinstance(source, dict):
            continue
        pid = str(source.get("provider") or "").strip()
        lid = str(source.get("list") or "").strip()
        if lid in BLOCK_PROVIDER_LISTS.get(pid, {}) and (pid, lid) not in seen:
            seen.add((pid, lid))
            out.append({"provider": pid, "list": lid})
    return out


