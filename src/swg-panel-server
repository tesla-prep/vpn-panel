    by_uid, order = _who_owner_index(here), {pid: i for i, pid in enumerate(here)}
    old = bool(snap) and not ((snap.get("smartroute") or {}).get("src"))
    for who in whos:
        uids, pids = _who_names(who if isinstance(who, dict) else {})
        dev = {}
        for pid in sorted(pids.intersection(here) | {q for u in uids for q in by_uid.get(u, ())}, key=order.__getitem__):
            for ifn, prs, why in here[pid][1]:
                if ifn == iface:
                    dev[pid] = "no" if old else "ok" if prs else "no" if why in ("unenforced", "raw_excluded") else "soon"
        out.append({"devices": dev, "people": len({u for u in uids if u in users}), **({"node_old": True} if old else {})})
    return out


