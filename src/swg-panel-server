    if ((snap or {}).get("smartroute") or {}).get("src"):
        here = _who_here(roster, node_id, snap)
        by_uid, addr = _who_owner_index(here), {}
        for wid, (S, who) in my["_who"].items():
            (uids, pids), net, got = _who_names(who), ipaddress.ip_network(S, strict=False), set()
            for pid in pids.intersection(here) | {q for u in uids for q in by_uid.get(u, ())}:
                for _ifn, prs, _why in here[pid][1]:
                    for d, a in prs:
                        ip = addr.get(a)
                        if ip is None:
                            ip = addr[a] = ipaddress.ip_address(a.split("/")[0])
                        if ip in net:
                            got.add((d, a))
            if got:
                srcs[wid] = sorted([d, a] for d, a in got)
    keep = [e for e in (my.get("smart") or []) if not e.get("src") or e["src"] in srcs]
    cats = {e["category"] for e in keep} | {e["category"] for e in ((my.get("arrivals") or {}).get("entries") or [])}
    return dict(my, smart=keep, srcs=srcs,
                **{k: {c: v for c, v in (my.get(k) or {}).items() if c in cats} for k in ("domains", "cidrs", "patterns")})


def ports_plan_for_node(my, snap):
