    # runs it as Block — fail closed — and says so by reporting mode block. Said here, or "routed" would be a quiet lie.
    elif _p2pa in ("exit", "dev") and _p2pn and _p2pn.get("mode") == "block":
        issues.append(perr("the torrent route is unavailable — torrent traffic is blocked until it is"))
    elif _p2pa in ("exit", "dev", "iface") and _p2pn and _p2pn.get("route") == "down":
