    report = (snap or {}).get("cascade_paths")
    return report if isinstance(report, dict) else {}


def cascade_plan(nodes, snaps, custom_lists=None, roster=None, pool=None):
    plans = {}
    clients = static_exit_clients(roster or {})
    static_exits = {}
    for _, (nid, xid), _, _, _ in clients:
        static_exits.setdefault(nid, set()).add(xid)
    static_routes = {}
    paths = {cascade_path_key(nid, path): (nid, path)
             for nid, rule, path in _configured_cascades(nodes, active=True) if rule_on(rule)}
    managed = {key: paths.pop(key) for key, (_, path) in list(paths.items()) if path.get("pool")}
    all_sources = _pool_sources(roster or {})
    pool = pool or {}

    def _nlist(nid):
        v = (nodes.get(nid) or {}).get("default_routing")
        return [r for r in v if not (isinstance(r, dict) and r.get("ports") is not None)] if isinstance(v, list) else None

    def _arr_ok(nid):
        _sr = ((snaps or {}).get(nid) or {}).get("smartroute")
        return isinstance(_sr, dict) and bool(_sr.get("arr"))

    def _nlist_selective(nid):
        nl = _nlist(nid) or []
        for r in nl:
            if not isinstance(r, dict) or not rule_on(r) or r.get("aud") == "cascaded":
                continue
            if r.get("category") != "all" or r.get("action") == "block" or r.get("cascade"):
                return True
            if r.get("action") == "exit" and r.get("node") in nodes and r.get("node") != nid and all(_link_devs(nodes, nid, r["node"])):
                return True
        return False

    def slot(nid):
        return plans.setdefault(nid, {"forward": [], "smart": [], "exit": [], "devexit": [], "allowed": {},
                                      "domains": {}, "cidrs": {},
                                      "patterns": {},
                                      "_legs": [],
                                      "_fwd_seen": set(), "_smart_seen": set(), "_exit_seen": set(),
                                      "_leg_seen": set(), "_targets": {}})

    _own_nets_of, _clash_memo, _into = {}, {}, {}

    def _own_nets(P):
        if P not in _own_nets_of:
            n, out = nodes.get(P) or {}, []
            _mesh = {str((lr or {}).get("iface") or "") for lr in (n.get("links") or {}).values()}
            for ifn, blk in ((((snaps or {}).get(P) or {}).get("interfaces")) or {}).items():
                meta = (blk or {}).get("meta") or {}
                if (ifn in _mesh or str(ifn).startswith("swg_") or meta.get("system")
                        or ((n.get("ifaces") or {}).get(ifn) or {}).get("system")):
                    continue
                with contextlib.suppress(ValueError, TypeError):
                    out.append((ifn, ipaddress.ip_network(meta.get("subnet") or "", strict=False)))
            _own_nets_of[P] = out + _tunnel_networks(n)
        return _own_nets_of[P]

    def _clash_of(nid, S, P):
        if (S, P) not in _clash_memo:
            try:
                s = ipaddress.ip_network(S, strict=False)
            except (ValueError, TypeError):
                s = None
            hit = s and next(((i, o) for i, o in _own_nets(P) if o.version == s.version and o.overlaps(s)), None)
            _clash_memo[(S, P)] = (s, {"their": hit[0], "their_subnet": str(hit[1]), "via": ""} if hit else None)
        s, own = _clash_memo[(S, P)]
        if own or not s:
            return own
        dup = next((e for e in _into.get(P) or () if e[1] != nid and e[0].version == s.version and e[0].overlaps(s)), None)
        return {"their": dup[2], "their_subnet": str(dup[0]), "via": dup[1]} if dup else None

    def _note_clash(nid, name, S, P, kind, why):
        slot(nid).setdefault("_clash", {})[(name or S, P)] = {"iface": name or S, "subnet": S, "node": P, "kind": kind, **why}

    def _clashes(nid, name, S, P, kind):
        why = _clash_of(nid, S, P)
        if why:
            _note_clash(nid, name, S, P, kind, why)
            return True
        with contextlib.suppress(ValueError, TypeError):
            _into.setdefault(P, []).append((ipaddress.ip_network(S, strict=False), nid, name or S))
        return False

    def add_exit(P, S, dev_p, T, X, W, base_p, personal=False, explicit=False):
        sp = slot(P)
        if (S, dev_p, T) not in sp["_exit_seen"]:
            sp["_exit_seen"].add((S, dev_p, T))
            sp["exit"].append({"subnet": S, "via_iface": dev_p, "table": T, "egress_ip": X, "wan_iface": W,
                               **({"personal": True} if personal else {}),
                               **({"explicit": True} if explicit else {})})
        if sp["allowed"].get(dev_p) != "0.0.0.0/0":
            cur = set(filter(None, (sp["allowed"].get(dev_p) or (base_p + "/32")).split(",")))
            cur |= {base_p + "/32", S if "/" in S else S + "/32"}
            _base = base_p + "/32"
            sp["allowed"][dev_p] = ",".join([_base] + sorted(cur - {_base}))

    fwd_items, smart_items = [], []
    p2p_items = []
    exit_ips_of = {}

    def _rule_cat(nid, r):
        _ip_only = ((nodes.get(nid) or {}).get("routing_mode") or "kernel") == "kernel"
        cat = r.get("category")
        if not cat:
            return None
        extra = None
        if cat == "custom":
            doms, cidrs, asns, pats = _clean_targets(
                r.get("targets") if r.get("targets") is not None
                else [*(r.get("domains") or []), *(r.get("cidrs") or []), *(r.get("asns") or []),
                      *(r.get("patterns") or [])], keep_asns=True, keep_patterns=True)
            cidrs = _asn_expand(asns, cidrs)
            if _ip_only:
                doms = []
            if not doms and not cidrs and not pats:
                return None
            cat = custom_cat_id(doms, cidrs, pats)
            extra = (doms, cidrs, pats)
        elif custom_lists and cat in custom_lists:
            cl = custom_lists[cat]
            if cl.get("enabled", True) is False or nid in (cl.get("disabled_nodes") or []):
                return None
            doms, cidrs = list(cl.get("domains") or []), list(cl.get("cidrs") or [])
            pats = list(cl.get("patterns") or [])
            cidrs = _asn_expand(cl.get("asns"), cidrs)
            if _ip_only:
                doms = []
            if not doms and not cidrs and not pats:
                return None
            cat = custom_cat_id(doms, cidrs, pats)
            extra = (doms, cidrs, pats)
        elif cat != "all" and not _is_routed_list_cat(cat):
            return None
        return cat, extra

    def _collect_egress(nid, ov, S, targets, auto_label="", name=""):
        mode = iface_egress_mode(ov)
        _auto = mode == "node"
        if _auto and _nlist(nid) is not None and _nlist_selective(nid):
            mode = "smart"
            ov = dict(ov, routing=[], routing_exit_ips={})
            if auto_label:
                slot(nid).setdefault("_auto", []).append(auto_label)
        elif _auto and auto_label and _nlist(nid) is not None:
            slot(nid).setdefault("_auto", []).append(auto_label)
        if mode == "forward":
            P = ov.get("egress_node")
            if not P or P not in nodes:
                return
            dev_n, dev_p, base_p = _link_devs(nodes, nid, P)
            if not (dev_n and dev_p and base_p):
                return
            if _clashes(nid, name or auto_label, S, P, "forward"):
                return
            if P not in targets:
                targets.append(P)
            fwd_items.append((nid, P, S, dev_n, dev_p, base_p,
                              (ov.get("egress_ip") or "").strip(), (ov.get("wan_iface") or "").strip()))
        elif mode == "smart":
            _all_said = False
            def _lower(r):
                if not rule_on(r):
                    return False
                action = r.get("action")
                if action not in ("exit", "direct", "block"):
                    return False
                _pt = r.get("ports")
                if _pt is not None:
                    _pp, _pl = ports_clean(_pt.get("proto"), _pt.get("list")) if isinstance(_pt, dict) else (None, "")
                    if _pp is None or r.get("category") == "all":
                        return False
                    _pt = {"proto": _pp, "list": _pl}
                _rc = _rule_cat(nid, r)
                if not _rc:
                    return False
                cat, extra = _rc
                if action != "exit":
                    smart_items.append((nid, None, S, cat, action, None, None, None, extra, r.get("who"), _pt, r.get("row_id")))
                    return cat == "all"
                if r.get("cascade"):
                    key = cascade_path_key(nid, r["cascade"])
                    smart_items.append((nid, key, S, cat, "cascade", None, None, None, extra, r.get("who"), _pt, r.get("row_id")))
                    return cat == "all"
                P = r.get("node")
                if not P or P not in nodes:
                    return False
                dev_n, dev_p, base_p = _link_devs(nodes, nid, P)
                if not (dev_n and dev_p and base_p):
                    return False
                if _clashes(nid, name or auto_label, S, P, "rule"):
                    return False
                if P not in targets:
                    targets.append(P)
                smart_items.append((nid, P, S, cat, "exit", dev_n, dev_p, base_p, extra, r.get("who"), _pt, r.get("row_id")))
                return cat == "all"
            for r in (ov.get("routing") or []):
                _all_said = _lower(r) or _all_said
            _xm = exit_ips_of[(nid, S)] = dict(ov.get("routing_exit_ips") or {})
            _nl = _nlist(nid)
            if not _all_said and _nl is not None:
                exit_ips_of[(nid, S)] = {**((nodes.get(nid) or {}).get("default_routing_exit_ips") or {}), **_xm}
                for r in _nl:
                    if isinstance(r, dict) and r.get("aud") != "cascaded":
                        _lower(r)

    for nid, node in nodes.items():
        targets = []
        _own = []
        _ownr = []
        for iface, ov in (node.get("ifaces") or {}).items():
            if ov.get("system"):
                continue
            S = _iface_subnet_from_snap(snaps, nid, iface)
            if not S:
                continue
            _collect_egress(nid, ov, S, targets, iface)
            _own.append((iface, S)); _ownr.append(ov)
        for _wn, _wov in (node.get("wdtt") or {}).items():
            if not _wov:
                continue
            S = _wdtt_net((_wov or {}).get("wg_addr") or "")
            if not S:
                continue
            _collect_egress(nid, _wov, S, targets, _wn)
            _own.append((_wn, S)); _ownr.append(_wov)
            if (_wov or {}).get("raw_port"):
                _RS = _wdtt_net((_wov or {}).get("raw_addr") or "")
                if _RS:
                    _collect_egress(nid, _wov, _RS, targets, name=_wn + " (raw)")
                    _own.append((_wn + " (raw)", _RS)); _ownr.append(_wov)
        for _cn, _cov in (node.get("csqtt") or {}).items():
            if not _cov:
                continue
            S = _wdtt_net((_cov or {}).get("tun_addr") or "")
            if not S:
                continue
            _collect_egress(nid, _cov, S, targets, _cn)
            _own.append((_cn, S)); _ownr.append(_cov)
        _pp = node.get("p2p") if isinstance(node.get("p2p"), dict) else {}
        if _pp.get("action") == "exit":
            _Q = _pp.get("node")
            if _Q in nodes and _Q != nid and all(_link_devs(nodes, nid, _Q)):
                _dn, _dp, _bp = _link_devs(nodes, nid, _Q)
                _subs = [s for n_, s in _own if not _clashes(nid, n_, s, _Q, "rule")]
                if _subs:
                    if _Q not in targets:
                        targets.append(_Q)
                    p2p_items.append((nid, "exit", _Q, _dn, _dp, _bp, _subs, False, "", ""))
        if p2p_policy(node) == "iface":
            _pig = {}
            for (n_, S), _r in zip(_own, _ownr):
                _rp = (_r or {}).get("p2p")
                if not isinstance(_rp, dict) or "torrents" in ((_r or {}).get("block") or []):
                    continue
                _pa = _rp.get("action")
                if _pa == "direct":
                    slot(nid).setdefault("_p2pi", {}).setdefault("direct", []).append(S)
                    continue
                _g = None
                if _pa == "exit":
                    _Q = _rp.get("node")
                    _ld = _link_devs(nodes, nid, _Q) if _Q in nodes and _Q != nid else (None,)
                    if all(_ld) and not _clashes(nid, n_, S, _Q, "rule"):
                        _g = _pig.setdefault(_Q, ["iexit", *_ld, False, "", "", []])
                if _g is None:
                    slot(nid).setdefault("_p2pi", {}).setdefault("block", []).append(S)
                    slot(nid).setdefault("_p2p_dead", []).append(n_)
                else:
                    _g[7].append((n_, S))
            for _k, (_kd, _dn, _dp, _bp, _ks, _eg, _gw, _ns) in _pig.items():
                if _k not in targets:
                    targets.append(_k)
                p2p_items.append((nid, _kd, _k, _dn, _dp, _bp, _ns, _ks, _eg, _gw))
        if _nlist(nid) is not None and _arr_ok(nid):
            for _r in _nlist(nid):
                if (isinstance(_r, dict) and rule_on(_r) and _r.get("action") == "exit" and not _r.get("cascade") and _r.get("aud") != "local"
                      and _r.get("node") in nodes and _r.get("node") != nid and all(_link_devs(nodes, nid, _r["node"]))
                      and _r["node"] not in targets):
                    targets.append(_r["node"])
        personal = set()
        if static_exits.get(nid) and static_exit_supported((snaps or {}).get(nid)):
            for xid in static_exits[nid]:
                exit_ = static_socks_exit(nodes, nid, xid)
                dev = str((exit_ or {}).get("device") or "")
                if exit_ and exit_.get("enabled") is not False and dev.startswith("s5x-") and _WANIF_RE.fullmatch(dev):
                    key = "exit:" + xid
                    static_routes[(nid, xid)] = (dev, key)
                    personal.add(key)
        if targets or personal:
            _srt = sorted(targets) + sorted(personal.difference(targets))
            slot(nid)["_targets"] = {p: SWG_RT_BASE + i for i, p in enumerate(_srt)}
            _over = [key for key in _srt[SWG_RT_BAND:] if key in targets]
            if _over:
                slot(nid)["_capped"] = _over

    def _dx_add(sp_, ent):
        k = json.dumps(ent, sort_keys=True)
        seen = sp_.setdefault("_dx_seen", {json.dumps(e, sort_keys=True) for e in sp_["devexit"]})
        if k not in seen:
            seen.add(k)
            sp_["devexit"].append(ent)

    def _path_origin(nid, key, subnets, arrivals=None):
        sn = slot(nid)
        if key in managed:
            group = groups.get(key)
            if not group:
                return {"action": "block"}
            table, choices = group
            wire = sn.setdefault("cascade_paths", {}).setdefault("choices", {})
            direct_paths = choices.get("", ())
            direct = next((healthy[c] for c in direct_paths if c in healthy), None)
            direct_state = "unavailable"
            if direct:
                direct_state = "primary" if direct_paths[0] in healthy else "backup"
            elif any(c in probes and c not in probed for c in direct_paths):
                direct_state = "pending"
            path = managed[key][1]
            status = sn.setdefault("pool_route_status", {}).setdefault(path["address"], {
                "direct": direct_state, "personal_reserve": False, "personal_direct": False,
            })
            selection = wire.setdefault(table, {"table": table, "default": direct[2] if direct else 0, "sources": {}})
            sources = all_sources.get(nid, {}) if arrivals is None else arrivals
            if path.get("proxy_mode") == "direct":
                sources = {}
            nets = [ipaddress.IPv4Network(s, strict=False) for s in subnets] if sources else []
            for (dev, addr), (pid, allow_direct) in sources.items():
                if not any(ipaddress.IPv4Address(addr) in net for net in nets):
                    continue
                variants = choices.get(pid, [])
                selected = next((picked for candidate in variants if (picked := healthy.get(candidate))), None)
                if selected and any(healthy.get(c) == selected for c in variants[1:2]):
                    status["personal_reserve"] = True
                if not selected and allow_direct and not any(candidate in probes and candidate not in probed for candidate in variants):
                    selected = direct
                    if selected:
                        status["personal_direct"] = True
                selection["sources"][dev, addr] = selected[2] if selected else 0
            for subnet in subnets:
                _dx_add(sn, {"subnet": subnet, "dev": CASCADE_SELECTOR_DEV, "table": table, "scope": "cascade", "killswitch": True})
            return {"action": "exit", "via_iface": CASCADE_SELECTOR_DEV, "table": table}
        if key not in ready_paths:
            return {"action": "block"}
        alias, dev, table = ready_paths[key]
        origin = {"table": table, "dev": dev, "address": alias}
        wire = sn.setdefault("cascade_paths", {}).setdefault("origin", [])
        if origin not in wire:
            wire.append(origin)
        for subnet in subnets:
            _dx_add(sn, {"subnet": subnet, "dev": dev, "table": table, "scope": "cascade", "killswitch": True})
        return {"action": "exit", "via_iface": dev, "table": table}

    # One mark selects the rule. The actual path mark is chosen after matching
    # the originating device, while each probe follows its own complete path.
    relevant = {n: {profile for profile, _ in src.values()} for n, src in all_sources.items()}
    for src, dest, *_ in fwd_items:
        relevant.setdefault(dest, set()).update(profile for profile, _ in all_sources.get(src, {}).values())
    for src, dest, _, _, action, *_ in smart_items:
        if action == "exit":
            relevant.setdefault(dest, set()).update(profile for profile, _ in all_sources.get(src, {}).values())
    groups, variant_ids = {}, {}
    used = {path["address"] for _, path in paths.values()}
    for key, (origin, path) in sorted(managed.items()):
        local = slot(origin)["_targets"]
        table = SWG_RT_BASE + len(local)
        if table > SWG_RT_MAX or _cascade_report((snaps or {}).get(origin)).get("v") != 2:
            continue
        local["selector:" + key] = table
        choices = {}
        groups[key] = table, choices
        profile_ids = relevant.get(origin, ()) if path.get("proxy_mode") != "direct" else ()
        for pid in ["", *sorted(profile_ids)]:
            account = pool.get(pid) if pid else None
            if pid and (not account or account.get("enabled") is False):
                continue
            exit_ = _pool_exit(pid, account) if account else {}
            choices[pid] = []
            for index, hops in enumerate((path["nodes"], path.get("backup"))):
                if not hops:
                    continue
                variant = {"nodes": hops, "profile": pid, "probe": True, "cfg_sig": exit_.get("cfg_sig", "")}
                if not index and not pid:
                    variant.update({k: path[k] for k in ("egress_ip", "wan_iface") if path.get(k)})
                identity = _cascade_identity(origin, variant)
                if identity not in variant_ids:
                    size = CASCADE_PATH_NET.num_addresses
                    start = int(hashlib.sha256(json.dumps(identity).encode()).hexdigest(), 16) % size
                    for off in range(size):
                        addr = str(CASCADE_PATH_NET[(start + off) % size])
                        if addr not in used:
                            break
                    else:
                        continue
                    used.add(addr)
                    variant["address"] = addr
                    path_id = cascade_path_key(origin, variant)
                    variant_ids[identity] = path_id
                    paths[path_id] = origin, variant
                choices[pid].append(variant_ids[identity])

    counts = collections.Counter(path["address"] for _, path in paths.values())
    ready_paths, probes, probed, healthy = {}, set(), set(), {}
    for key, (nid, path) in sorted(paths.items()):
        hops = [nid, *path["nodes"]]
        alias = path["address"]
        if counts[alias] != 1 or any(n not in nodes for n in hops):
            continue
        reports = [((snaps or {}).get(n) or {}).get("cascade_paths") or {} for n in hops]
        if not all(isinstance(r, dict) and r.get("v") in ((2,) if path.get("probe") else (1, 2)) for r in reports):
            continue
        proxy = path.get("socks5")
        profile_id = path.get("profile")
        dev = ""
        http_proxy = False
        if profile_id:
            profile = pool.get(profile_id)
            if not profile or profile.get("enabled") is False or reports[-1].get("v") != 2:
                continue
            http_proxy = profile.get("provider") == "http"
            if http_proxy and any(exit_kind_refusal((snaps or {}).get(node), "http") for node in (nid, hops[-1])):
                continue
            dev = _pool_exit(profile_id, profile)["device"]
        elif proxy:
            exit_cfg = static_socks_exit(nodes, hops[-1], proxy) or {}
            dev = str(exit_cfg.get("device") or "")
            if exit_cfg.get("enabled") is False or not (dev.startswith("s5x-") and _WANIF_RE.fullmatch(dev)):
                continue
        links = [_link_devs(nodes, a, b) for a, b in zip(hops, hops[1:])]
        if any(not all(link) for link in links):
            continue
        targets = ["cascade:" + key, *["cascade-device:" + (links[i + 1][0] if i + 1 < len(links) else dev)
                                      for i in range(len(links))]]
        if not path.get("probe"):
            targets = ["cascade:" + key] * len(hops)
        tables = [slot(n)["_targets"].get(t, SWG_RT_BASE + len(slot(n)["_targets"])) for n, t in zip(hops, targets)]
        if any(t > SWG_RT_MAX for t in tables):
            continue
        for n, target, t in zip(hops, targets, tables):
            slot(n)["_targets"][target] = t
        if profile_id:
            slot(hops[-1]).setdefault("pool_profiles", set()).add(profile_id)
        for i, (a, b, (outgoing, incoming, peer_ip)) in enumerate(zip(hops, hops[1:], links)):
            slot(a)["allowed"][outgoing] = "0.0.0.0/0"
            sn = slot(b)
            table = tables[i + 1]
            next_dev = links[i + 1][0] if i + 1 < len(links) else dev
            x, w = (("", "") if next_dev else (path.get("egress_ip", ""), path.get("wan_iface", "")))
            add_exit(b, alias, incoming, table, x, w, peer_ip, personal=bool(next_dev), explicit=True)
            sn.setdefault("cascade_paths", {}).setdefault("incoming", []).append(
                {"key": key, "address": alias, "iif": incoming, "dev": next_dev, "table": table,
                 **({"http_dns": True} if http_proxy and i + 1 == len(links) else {}),
                 **({"wan_iface": w} if w else {})})
            if next_dev:
                sn["forward"].append({"subnet": alias, "via_iface": next_dev, "table": table})
            if next_dev and i + 1 == len(links):
                _dx_add(sn, {"subnet": alias, "dev": next_dev, "table": table, "scope": "rule", "killswitch": True})
        installed = all(isinstance(r.get("ready"), list) and key in r["ready"] for r in reports[1:])
        first = links[0][0]
        if path.get("probe"):
            probes.add(key)
            report = reports[0].get("health")
            if isinstance(report, dict) and isinstance(report.get(key), bool):
                probed.add(key)
                if installed and report[key]:
                    healthy[key] = (alias, first, tables[0])
            sn = slot(nid)
            sn.setdefault("cascade_paths", {}).setdefault("origin", []).append(
                {"table": tables[0], "dev": first, "address": alias, "probe": key,
                 **({"http_dns": True} if http_proxy else {})})
            _dx_add(sn, {"subnet": alias, "dev": first, "table": tables[0], "scope": "cascade", "killswitch": True})
        elif installed:
            ready_paths[key] = (alias, first, tables[0])

    for (nid, P, S, dev_n, dev_p, base_p, X, W) in fwd_items:
        T = slot(nid)["_targets"].get(P)
        if T is None or T > SWG_RT_MAX:
            continue
