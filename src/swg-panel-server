def _csqtt_tun_for_line(addr):
    ip, sep, mask = str(addr or "").partition("/")
    octs = ip.split(".")
    if len(octs) == 4 and octs[3].isdigit() and 2 <= int(octs[3]) <= 250:
        return ".".join(octs[:3]) + ".1" + sep + mask
    return addr
