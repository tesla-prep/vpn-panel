def block_catalog(panel_settings):
    """Effective block-category catalog = predefined (BLOCK_CATEGORIES + MECH_CATEGORIES) overlaid with the
    operator's panel_settings.block_catalog.categories deltas (sources / default_on / enabled / enabled_nodes)
    plus any custom categories. Predefined feed lists are a DEFAULT the operator may extend, replace, or disable.
    Returns {id: {id,label,kind,predefined,default_on,enabled, sources?|detect?, enabled_nodes?}} in stable order."""
    over = ((panel_settings or {}).get("block_catalog") or {}).get("categories") or {}
    out = {}
    for cid, (label, kind, don, srcs) in BLOCK_CATEGORIES.items():
        out[cid] = {"id": cid, "label": label, "kind": kind, "predefined": True, "default_on": don,
                    "enabled": True, "enabled_nodes": [],
                    "sources": [{"provider": p, "list": l} for (p, l) in srcs]}
    for cid, (label, don, detect, modes) in MECH_CATEGORIES.items():
        out[cid] = {"id": cid, "label": label, "kind": "mechanism", "predefined": True, "default_on": don,
                    "enabled": True, "detect": detect, "modes": modes}
    for cid, ov in over.items():                                # operator overrides + custom categories
        if not isinstance(ov, dict):
            continue
        base = out.get(cid)
        if base is None:                                        # a custom (user-created) category
            base = {"id": cid, "label": ov.get("label") or cid, "kind": ov.get("kind") or "content",
                    "predefined": False, "default_on": False, "enabled": True, "sources": [], "enabled_nodes": []}
            out[cid] = base
        for k in ("label", "default_on", "enabled", "sources", "enabled_nodes"):
            if k in ov:
                base[k] = ov[k]
    return out

