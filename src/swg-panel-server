    """{node_id: {dark,light}} for every enrolled node — mirrored into serve.json so the subscription page can
    paint each server name in the operator's chosen node colour without reading the node store itself."""
    out = {}
    with contextlib.suppress(Exception):
        for nid, n in (nodes_load(deps["nodes_path"]) or {}).items():
            c = (n or {}).get("color")
            if isinstance(c, str) and c.strip():          # legacy single-string colour (e.g. auto-enrolled master) → both themes
