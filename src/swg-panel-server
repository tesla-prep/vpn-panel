        if any(k in _awgput for k in AWG3_FIELDS) and not awg_gen_reported(_snap):
            return 400, {"ok": False, **perr("{v1}: this node does not report its AmneziaWG version — update it",
                                             v1=nodes[nid].get("name") or nid), "code": "bad_request"}
