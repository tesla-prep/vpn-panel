def _turn_update_due(sched, last_ts, now_ts):
    ev = int((sched or {}).get("every_days") or 0)
    if ev <= 0:
        return False
    if now_ts - last_ts < ev * 86400 - 1800:
        return False
    at = str((sched or {}).get("at") or "04:00")
    try:    hh, mm = int(at.split(":")[0]), int(at.split(":")[1])
    except Exception: hh, mm = 4, 0
    lt = time.localtime(now_ts); cur = lt.tm_hour * 60 + lt.tm_min; start = hh * 60 + mm
    return start <= cur < start + 60


def _turn_autoupdate_tick():
    deps = getattr(Handler, "deps", None) or {}
    psp = deps.get("panel_settings_path")
    if not psp:
        return
    sched = (load_panel_settings(psp) or {}).get("turn_update") or {}
    if int(sched.get("every_days") or 0) <= 0:
        return
    marker = os.path.join(os.path.dirname(deps.get("nodes_path") or ".") or ".", "turn_update_last")
    try:    last_ts = int((open(marker).read().strip() or "0"))
    except Exception: last_ts = 0
    now_ts = int(time.time())
    if not _turn_update_due(sched, last_ts, now_ts):
        return
    snaps = dict(deps.get("node_snaps") or {})
    nodes = nodes_load(deps["nodes_path"])
    latest = {}
    todo = []
    for nid, snap in snaps.items():
        if nid not in nodes or not isinstance(snap, dict):
            continue
        if snap.get("turn_manage") is False or snap.get("turn_capable") is False:
            continue
        for tp in (snap.get("turn_proxies") or []):
            svc = (tp.get("service") or "").strip(); ver = (tp.get("version") or "").strip()
            if not svc or not ver:
                continue
            fork = turn_fork(svc)
            if fork not in ("samosvalishe", "WINGS-N") or tp.get("stopped"):
                continue
            owner = turn_fork_owner(fork)
            if _turn_hold_get(nid, "fork:" + fork):
                continue
            if fork not in latest:
                latest[fork] = _resolve_turn_tag(owner)
            tag = latest[fork]
            if not tag or tag == ver:
                continue
            if (nodes[nid].get("turn") or {}).get(svc):
                continue
            todo.append((nid, svc, fork, owner, tag))
    if todo:
        pins = {(nid, owner): turn_pin(owner, _node_arch(deps, nid)) for nid, _svc, _f, owner, _tag in todo}
        with _api_lock:
            nodes = nodes_load(deps["nodes_path"])
            live = deps.get("node_snaps") or {}
            staged = []
            for nid, svc, fork, owner, tag in todo:
                if nid not in nodes:
                    continue
                if (nodes[nid].get("turn") or {}).get(svc):
                    continue
                if _turn_hold_get(nid, "fork:" + fork):
                    continue
                _now_v = {(t or {}).get("service"): (t or {}).get("version") for t in ((live.get(nid) or {}).get("turn_proxies") or [])}
                if svc not in _now_v or _now_v[svc] == tag:
                    continue
                pin = pins[(nid, owner)]
                if not pin or pin.get("tag") != tag or not pin.get("sums"):
                    continue
                nodes[nid].setdefault("turn", {})[svc] = {"action": "reinstall", "at": now_ts, "owner": owner,
                                                          "auto": True, "pin": pin}
                staged.append((nid, svc, tag))
            if staged:
                nodes_save(deps["nodes_path"], nodes)
                _invalidate_state_cache()
        for nid, svc, tag in staged:
            with contextlib.suppress(Exception):
                ev_append(deps["roster_path"], "node", nid, "Auto-updating turn-proxy", svc + " → " + tag)
    with contextlib.suppress(Exception):
        atomic_write(marker, str(now_ts))


def _turn_update_loop():
    while True:
        with contextlib.suppress(Exception):
            _turn_autoupdate_tick()
        time.sleep(15 * 60)

