def _apply_egress_mode(rec, body, nodes, nid, deps):
    _custom = [cl.get("id") for cl in ((deps.get("panel_settings") or {}).get("custom_lists") or []) if cl.get("id")]
    _rv = body.get("routing_v")
    _rv = _rv if isinstance(_rv, int) and not isinstance(_rv, bool) else 0
    if ((body.get("egress_mode") == "smart" or ("routing" in body and "egress_mode" not in body and rec.get("egress_mode") == "smart"))
            and any(isinstance(r, dict) and ((_rv < 2 and "who" in r) or (_rv < 3 and "ports" in r))
                    for r in (rec.get("routing") or []))):
        return "This browser tab is older than the panel — reload it before saving routing.", None
    if "egress_mode" in body:
        mode = (body.get("egress_mode") or "direct").strip()
        if (mode == "exit" and rec.get("egress_mode") == "exit" and rec.get("exit_id")
                and body.get("exit_id") == rec["exit_id"]):
            return None, None
        if mode not in ("node", "local", "direct", "forward", "smart"):
            return "egress_mode must be node|local|direct|smart", None
        if mode == "forward":
            en = (body.get("egress_node") or "").strip()
            if rec.get("egress_mode") != "forward" or rec.get("egress_node") != en:
                return "Choose Through nodes and set the primary chain.", None
        elif mode == "smart":
            rules, err, _drop = _validate_routing(body.get("routing"), nodes, nid, _custom,
                                                  snap=(deps.get("node_snaps") or {}).get(nid) or {},
                                                  prev=rec.get("routing") or [],
                                                  roster=_routing_roster(body.get("routing"), deps))
            if err:
                return err, None
            rec["egress_mode"] = "smart"; rec["routing"] = rules
            _xerr = _apply_exit_ips(rec, body, nodes, nid)
            if _xerr:
                return _xerr, None
            rec.pop("egress_node", None); rec.pop("exit_id", None); rec.pop("wan_iface", None)
            return None, _drop
        elif mode == "exit":
            xid = str(body.get("exit_id") or "").strip()
            xid, _merr = _mint_device_exit(nodes, nid, xid,
                                           (deps.get("node_snaps") or {}).get(nid) or {})
            if _merr:
                return _merr, None
            if not xid:
                return "exit_id must be one of this node's exits", None
            if (not any(str((x or {}).get("id")) == xid for x in ((nodes.get(nid) or {}).get("exits") or []))
                    and xid != str(rec.get("exit_id") or "")):
                return "exit_id must be one of this node's exits", None
            rec["egress_mode"] = "exit"; rec["exit_id"] = xid
            rec.pop("egress_node", None); rec.pop("wan_iface", None)
        else:
            if mode != "direct" or rec.get("egress_mode") != "local":
                rec["egress_mode"] = mode
            rec.pop("egress_node", None); rec.pop("exit_id", None)
            if mode == "node":
                rec.pop("wan_iface", None); rec.pop("egress_ip", None)
    elif "routing" in body and rec.get("egress_mode") == "smart":
        rules, err, _drop = _validate_routing(body.get("routing"), nodes, nid, _custom,
                                              snap=(deps.get("node_snaps") or {}).get(nid) or {},
                                              prev=rec.get("routing") or [],
                                              roster=_routing_roster(body.get("routing"), deps))
        if err:
            return err, None
        rec["routing"] = rules
        _xerr = _apply_exit_ips(rec, body, nodes, nid)
        if _xerr:
            return _xerr, None
        return None, _drop
    return None, None


_AR_PKG_RE = re.compile(r"[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+")
_AR_ADDR_RE = re.compile(r"[0-9./-]+")
_AR_MAX = 500
_AR_ALL4 = [ipaddress.IPv4Network("0.0.0.0/0")]

def _ar_wire_name(h):
    import unicodedata
    out = []
    for lb in h.split("."):
        try:
            u, ace = (lb[4:].encode("ascii").decode("punycode"), lb) if lb.startswith("xn--") else \
                     (None, lb) if lb.isascii() else (lb, "xn--" + lb.encode("punycode").decode("ascii"))
        except (UnicodeError, ValueError):
            return ""
        if u is not None and (u.isascii() or not all(c == "-" or unicodedata.category(c)[0] in "LMN" for c in u)):
            return ""
        out.append(ace)
    return ".".join(out)

def _validate_app_routing(v):
    if v is None or v == {}:
        return None, None
    if not isinstance(v, dict):
        return None, perr("App routing: not a valid setting")
    apps = v.get("apps_mode") or "all"
    dmode = v.get("domains_mode") or "direct"
    imode = v.get("ips_mode") or "direct"
    if (apps not in ("all", "except", "only") or dmode not in ("direct", "tunnel") or imode not in ("direct", "tunnel")
            or not isinstance(v.get("template_domains", False), bool)):
        return None, perr("App routing: not a valid setting")
    lists = {}
    for k, what in (("packages", "apps"), ("domains", "domains"), ("ips", "addresses")):
        x = v.get(k)
        if not (x is None or isinstance(x, str) or (isinstance(x, list) and all(isinstance(i, str) for i in x))):
            return None, perr("App routing: not a valid setting")
        x = list(dict.fromkeys(_split_targets(x.replace(";", ",") if isinstance(x, str) else x)))
        if len(x) > _AR_MAX:
            return None, perr("App routing: at most {v1} %s" % what, v1=_AR_MAX)
        lists[k] = x
    if apps == "except" and not lists["packages"]:
        apps = "all"
    pk = lists["packages"] if apps != "all" else []
    for x in pk:
        if len(x) > 255 or not _AR_PKG_RE.fullmatch(x):
            return None, perr("App routing: {v1} is not an Android app ID (like org.telegram.messenger)", v1=x[:80])
    dm = []
    for d in lists["domains"]:
        h = d.lower().split("://", 1)[-1].split("/", 1)[0]
        if h.count(":") == 1:
            h = h.split(":", 1)[0]
        h = (h[2:] if h.startswith("*.") else h).strip(".")
        h = h[4:] if h.startswith("www.") else h
        if h.startswith("www."):
            return None, perr("App routing: {v1} has www. twice — drop one", v1=d[:80])
        if not h or h == "*":
            continue
        if ":" in h or (_AR_ADDR_RE.fullmatch(h) and any(c.isdigit() for c in h)):
            return None, perr("App routing: {v1} is an address — list it under Addresses", v1=d[:80])
        a = _ar_wire_name(h) if len(h) <= 253 else ""
        if not ("." in a and len(a) <= 253 and _HOSTNAME_RE.fullmatch(a) and not a.rsplit(".", 1)[1].isdigit()):
            return None, perr("App routing: {v1} is not a domain (a full name, like ya.ru)", v1=d[:80])
        dm.append(a)
    dm = list(dict.fromkeys(dm))
    ips, nets = [], []
    for x in lists["ips"]:
        try:
            if "-" in x:
                lo, hi = (ipaddress.IPv4Address(p.strip()) for p in x.split("-", 1))
                if lo > hi:
                    raise ValueError
                ips.append("%s-%s" % (lo, hi))
                nets += ipaddress.summarize_address_range(lo, hi)
            else:
                n = ipaddress.IPv4Network(x, strict=False)
                ips.append(str(n) if n.prefixlen < 32 else str(n.network_address))
                nets.append(n)
        except ValueError:
            if ":" in x:
                return None, perr("App routing: {v1} — the app routes IPv4 addresses only", v1=x[:80])
            return None, perr("App routing: {v1} is not an IP address or range", v1=x[:80])
    ips = list(dict.fromkeys(ips))
    if imode == "direct" and nets and list(ipaddress.collapse_addresses(nets)) == _AR_ALL4:
        return None, perr("App routing: these addresses cover every address — everything would go outside the tunnel")
    if apps == "only" and not pk:
        return None, perr("App routing: list at least one app to send through the tunnel")
    if dmode == "tunnel" and not dm:
        return None, perr("App routing: list at least one domain to send through the tunnel")
    if imode == "tunnel" and not ips:
        return None, perr("App routing: list at least one address to send through the tunnel")
    tpl = v.get("template_domains") is True and dmode == "direct"
    if not (pk or dm or tpl or ips):
        return None, None
    return {"apps_mode": apps, "packages": pk, "domains_mode": dmode, "domains": dm, "template_domains": tpl,
            "ips_mode": imode, "ips": ips}, None


_AR_EXCEPT_MAX = 20
_AR_NONE = {"apps_mode": "all", "packages": [], "domains_mode": "direct", "domains": [], "template_domains": False,
            "ips_mode": "direct", "ips": []}


def _validate_ar_except(v, prev, roster):
    if v is None or v == []:
        return [], None
    if not isinstance(v, list):
        return None, perr("App routing: not a valid setting")
    if len(v) > _AR_EXCEPT_MAX:
        return None, perr("App routing: at most {v1} exceptions", v1=_AR_EXCEPT_MAX)
    ro, prev = roster or {}, [o for o in (prev if isinstance(prev, list) else ()) if isinstance(o, dict) and isinstance(o.get("who"), dict)]
    known = {k: ro.get(k) or {} for k in ("users", "peers")}
    stored = {k: {x for o in prev for x in _who_ids(o["who"].get(k))} for k in known}
    nobody = any(not any(o["who"].get(k) for k in known) for o in prev)
    out = []
    for n, e in enumerate(v, 1):
        w = e.get("who") if isinstance(e, dict) else None
        lists = {k: (w.get(k) if isinstance(w, dict) else None) or [] for k in known}
        if not isinstance(w, dict) or not all(isinstance(x, list) and all(isinstance(i, str) for i in x) for x in lists.values()):
            return None, perr("App routing: not a valid setting")
        if not any(lists.values()) and not nobody:
            return None, perr("Exception {v1}: choose at least one person or device", v1=n)
        if any(x not in known[k] and x not in stored[k] for k, ids in lists.items() for x in ids):
            return None, perr("A chosen user or device no longer exists — reload and choose again")
        body, err = _validate_app_routing(e.get("app_routing"))
        if err:
            return None, perr("Exception {v1}: {v2}", v1=n, v2=err)
        keep = {k: sorted({x for x in ids if x in known[k]}) for k, ids in lists.items()}
        out.append({"who": {k: x for k, x in keep.items() if x}, "app_routing": body})
    return out, None


def _ar_except_index(entries):
    by_pid, by_uid = {}, {}
    es = [(e["who"], e.get("app_routing") or _AR_NONE) for e in (entries if isinstance(entries, list) else ())
          if isinstance(e, dict) and isinstance(e.get("who"), dict)]
    for w, body in es:
        for pid in _who_ids(w.get("peers")):
            by_pid.setdefault(pid, body)
        for uid in _who_ids(w.get("users")):
            by_uid.setdefault(uid, body)
    return by_pid, by_uid


