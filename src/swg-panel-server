def iface_kind(deps, nodes, snaps, node, iface, declared=""):
    if declared in ("wdtt", "csqtt"):
        return declared
    n = nodes.get(node) or {}
    if iface in (n.get("wdtt") or {}):
        return "wdtt"
    if iface in (n.get("csqtt") or {}):
        return "csqtt"
    snap = (snaps or {}).get(node) or {}
    if any((w or {}).get("iface") == iface for w in (snap.get("wdtt") or [])):
        return "wdtt"
    if any((c or {}).get("iface") == iface for c in (snap.get("csqtt") or [])):
        return "csqtt"
    if ((snap.get("interfaces") or {}).get(iface)):
        return iface_type(snaps, node, iface)
    if _WDTT_IFACE_RE.match(str(iface or "")):
        return "wdtt"
    if _CSQTT_IFACE_RE.match(str(iface or "")):
        return "csqtt"
    return declared if declared in ("wg", "awg") else iface_type(snaps, node, iface)


