            if ((_idf.get("awg_gen") or DEFAULT_AWG_GEN) == "3.1" and not awg_gen_refusal(_snap, _node_name)
                    and not turn_awg3_blockers(deps, nodes, nid, {req.get("listen_port")})):
                _gen = "3.1"
        _exact = bool(_awgprev) and bool(_prev_ov.get("awg_exact"))
        _omit = frozenset() if _awgprev else (_awgom | (awg3_omitted(deps) if _gen == "3.1" and cmd == ["awg"]
                                                       else frozenset()))
        if _omit:
            _no = awg_exact_refusal(_snap, _node_name)
            if _no:
                return 400, {"ok": False, **_no, "code": "bad_request"}
            if _gen != "3.1":
                _awgput = {k: str(v) for k, v in {**gen_awg_params("2.0"), **_awgdef}.items() if k not in _omit}
