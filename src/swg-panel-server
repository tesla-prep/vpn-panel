    stored = ((panel_settings or {}).get("block_catalog") or {}).get("categories") or {}
    out = {}
    for cid, (label, default_on, detect, modes) in MECH_CATEGORIES.items():
        ov = stored.get(cid)
        if not isinstance(ov, dict):
            ov = {}
        out[cid] = {"id": cid, "label": label, "kind": "mechanism",
                    "default_on": ov.get("default_on", default_on), "enabled": ov.get("enabled", True),
                    "detect": detect, "modes": modes}
    for cid, ov in stored.items():
        if cid in out or not isinstance(ov, dict) or not ov.get("label"):
            continue
        out[cid] = {"id": cid, "label": ov["label"], "kind": ov.get("kind") or "content",
                    "default_on": ov.get("default_on", False), "enabled": ov.get("enabled", True),
                    "sources": _block_sources(ov.get("sources")), "enabled_nodes": ov.get("enabled_nodes") or []}
    return out


