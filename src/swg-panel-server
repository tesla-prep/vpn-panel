            def _sanv(d):
                return {re.sub(r"[^\w.\-]", "", str(k))[:64]: _san(v) for k, v in (d if isinstance(d, dict) else {}).items()} if isinstance(d, dict) else {}
            applied = _turn_p4_adopt(cid, roster, add=_san(body.get("add")), remove=_san(body.get("remove")),
