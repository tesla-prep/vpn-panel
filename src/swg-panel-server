def _match_os_asset(assets, oskind):
    """The single best installer for an OS from a release's assets: highest-ranked FORMAT, then preferred ARCH within
    it. Drops `server-*` role binaries (the free-turn CLI ships client+server; end users want the client)."""
    names = [(a.get("name") or "", a.get("url")) for a in (assets or []) if a.get("url")]
    names = [(n, u) for (n, u) in names if not re.match(r'server[-_]', n, re.I) and not re.search(r'tokenfetcher', n, re.I)]
    fmts = _OS_ASSET_FORMATS.get(oskind)
    if not fmts or not names:
        return None
    archp = _OS_ARCH_PREF.get(oskind, [])
    for fmt in fmts:
        cands = [(n, u) for (n, u) in names if re.search(fmt, n, re.I)]
        if not cands:
            continue
        for arch in archp:                            # prefer the default arch within this format
            for (n, u) in cands:
                if re.search(arch, n, re.I):
                    return u
        return cands[0][1]                            # no arch token in this format → first candidate
    return None

def _gh_owner_repo(url):
    m = re.match(r'https?://github\.com/([^/]+)/([^/#?]+)', url or "")
    return (m.group(1), m.group(2)) if m else (None, None)

def _turn_warm_assets():
    """Pre-resolve, for every catalog client, the LATEST release's full asset list (→ _RELEASE_INFO, the bubble source)
    and the single best per-OS installer (→ _PLATFORM_ASSET, the button). Non-blocking readers merge from these caches;
    best-effort — any repo/OS that fails just keeps its /releases dir link. Returns the number of releases resolved
    this pass, so the loop can tell a total wash (network not ready at boot) from a normal run and retry sooner."""
    resolved = 0
    for _cat in (TURN_CLIENTS, WG_APPS):              # turn forks AND the plain WG/AWG apps share the resolver
      for cid, c in _cat.items():
        if cid in TURN_GONE_CLIENTS:
            continue                                  # its repository is gone: an hourly 404, and no fork offers it
        for oskind, links in (c.get("platforms") or {}).items():
            owner, repo = _gh_owner_repo((links or {}).get("github"))
            if not owner:
                continue
            try:
                rel = _hosted_latest(owner, repo) or _gh_latest_release(owner, repo)
            except Exception:
                rel = None
            if not rel:
                continue
            assets = [{"name": a.get("name"), "url": a.get("url")} for a in (rel.get("assets") or []) if a.get("url")]
            _RELEASE_INFO[(owner, repo)] = {"tag": rel.get("tag"), "page": rel.get("html_url"), "assets": assets}
            resolved += 1
            u = _match_os_asset(assets, oskind)       # None for ios (no format prefs) → button falls back to store/page
            if u:
                _PLATFORM_ASSET[(owner, repo, oskind)] = u
    return resolved

_RELEASE_PIN = {}        # (owner, repo, server version) -> {tag, page, assets, url:{os: installer}} — refreshed hourly
_PIN_WANTED = {}         # (owner, repo) -> {server versions seen running within _PIN_KEEP} — what serve.json publishes pins for
_PIN_TRIED = {}          # (owner, repo, server version) -> when a lookup last gave no pin (retried hourly)
_PIN_SEEN = {}           # (owner, repo, server version) -> when (time.monotonic) a snapshot last showed a server running it
_PIN_KEEP = 3600         # a version unseen this long is retired: its pin leaves serve.json and the cache
# A build label that does NOT name its upstream source. ildarmaga's "1.5.40" / "1.5.40-2" were source 1.5.0 + our patch
# (forks/wdtt/ildarmaga/README.md) — reading them as upstream v1.5.40 would offer a PWDTT that is not this server's.
_PIN_TAG_OVERRIDE = {("ildarmaga", "1.5.40"): "v1.5.0", ("ildarmaga", "1.5.40-2"): "v1.5.0"}
_PIN_SOURCE_LINES = {"csqtt": {"2.1": "csqtt-app-2.1.9", "2.5": "csqtt-app-2.5.1+"}}   # fork id → line → OUR app release
_HOSTED_TAG_TTL = 3600
_HOSTED_TAG_SETTLE = 600   # a new release is offered 10 minutes after it is published: its APKs all uploaded
def _hosted_tag(spec):
    """The release tag a _PIN_SOURCE_LINES entry names now. A plain tag is itself. "<prefix>.<n>+" is our newest
    "<prefix>.<m>[-<k>]" with m >= n, by number (2.5.10 above 2.5.9, a rebuild 2.5.2-2 above 2.5.2), that is not a
    prerelease, holds an APK and was published at least _HOSTED_TAG_SETTLE ago (its files all uploaded). One listing of
    our releases an hour, from the background passes only. A listing that fails, or names no such release, never moves
    a sub page back: the last answer stands — this run's, else the newest release of ours a restored pin or the catalog
    was served from — else the floor. A failed listing is asked again in five minutes (once, not once per server build);
    one that answered without a qualifying release stands for the hour."""
    m = re.fullmatch(r"(.*)\.(\d+)\+", spec)
    if not m:
        return spec
    prefix, floor = m.group(1), int(m.group(2))
    ck = "hosted:" + spec
    ent = _GH_COMMIT_CACHE.get(ck)
    if ent and time.time() - ent["at"] < _HOSTED_TAG_TTL:
        return ent["res"]
    tag_re = re.compile(re.escape(prefix) + r"\.(\d+)(?:-(\d+))?")
    def rank(t):
        tm = tag_re.fullmatch(str(t or ""))
        return tm and int(tm.group(1)) >= floor and (int(tm.group(1)), int(tm.group(2) or 0))
    rels, best = None, None
    with contextlib.suppress(Exception):              # GitHub refused or unreachable: no listing (below)
        rels = _gh_api("/repos/%s/releases?per_page=100" % WDTT_BUILD_REPO)
    for x in rels if isinstance(rels, list) else ():  # every release is weighed on its own: an odd one is skipped, never a
        t = isinstance(x, dict) and not x.get("prerelease") and not x.get("draft") and str(x.get("tag_name") or "")
        rk = t and rank(t)                            # half-read listing taken for a whole one
        assets = x.get("assets") if rk else None
        if rk and isinstance(assets, list) and any(isinstance(a, dict) and re.search(r"\.apk$", str(a.get("name") or ""), re.I)
                                                   for a in assets) and _released_since(x.get("published_at")) >= _HOSTED_TAG_SETTLE:
            if best is None or rk > best[0]:
                best = (rk, t)
    if best:
        _GH_COMMIT_CACHE[ck] = {"res": best[1], "at": time.time()}
        return best[1]
    if ent:
        res = ent["res"]
    else:                                             # a page is the release a pin or the catalog was served from: a stand-in
        known = [t for x in list(_RELEASE_PIN.values()) + list(_RELEASE_INFO.values())   # of his names his tag, never ours
                 for t in (str(x.get("page") or "").rpartition("/")[2],) if rank(t)]
        res = max(known, key=rank) if known else "%s.%d" % (prefix, floor)
    _GH_COMMIT_CACHE[ck] = {"res": res, "at": time.time() - (0 if isinstance(rels, list) else _HOSTED_TAG_TTL - 300)}
    return res
def _released_since(published_at):
    """Seconds since a release's published_at ("2026-10-23T05:09:01Z"); a missing or odd value counts as long ago."""
    with contextlib.suppress(Exception):
        return time.time() - _live_cal.timegm(time.strptime(published_at, "%Y-%m-%dT%H:%M:%SZ"))
    return float("inf")
def _pin_source(owner, repo, version):
    """(owner, repo, tag) of OUR app release for a build the panel itself lists on a hosted line (CSQTT_LINES) AND of that
    line's own version, else None: a build it does not list (a hand-placed 2.1.5), or an older protocol kept on the line
    only as a rollback row (2.0.1, whose app 2.1.9 is not proven to speak), keeps its own upstream app, as before."""
    for fork, lines in _PIN_SOURCE_LINES.items():
        if turn_fork_owner(fork) == owner + "/" + repo:
            for line, tag in lines.items():
                if str(version).startswith(line + ".") and any(b == version for b, _ in CSQTT_LINES.get(line) or ()):
                    return tuple(WDTT_BUILD_REPO.split("/", 1)) + (_hosted_tag(tag),)
    return None
def _hosted_latest(owner, repo):
    """The newest hosted line's app release, shaped as _gh_latest_release shapes one: the catalog's "latest" (a server
    with no pin yet) leans on our repository too, not on his. None = not hosted, or our release is not there."""
    for fork, lines in _PIN_SOURCE_LINES.items():
        if turn_fork_owner(fork) == owner + "/" + repo and lines:
            tag = _hosted_tag(lines[max(lines, key=lambda l: tuple(int(x) for x in l.split(".")))])
            o, r = WDTT_BUILD_REPO.split("/", 1)
            try:      # a GitHub error, or a release whose APKs are still uploading → None: his latest stands in, as before
                rec = _pin_lookup(o, r, [tag], asset_re=r"\.apk$")
            except Exception:
                rec = None
            return {"tag": _hosted_app_ver(tag), "html_url": rec["page"], "assets": rec["assets"]} if rec and rec["assets"] else None
    return None
def _hosted_app_ver(tag):   # csqtt-app-2.5.1 → v2.5.1 (a rebuild csqtt-app-2.5.1-2 → v2.5.1-2): the app's version, not our release's name
    return "v" + re.sub(r"^.*?-app-", "", tag)

def _pin_tags(version):
    """Release tags a server version may name, most exact first: upstream's tag as reported ("v4.0.3"), or our build
    of it — "<upstream>-<N>" (csqtt 2.1.9-4 → v2.1.9, WDTT-Plus 18-2 → v18)."""
    v = str(version or "").strip()
    out = []
    for x in (v, re.sub(r"-\d+$", "", v)):
        for t in ((x,) if x.startswith("v") else ("v" + x, x)):
            if x and t not in out:
                out.append(t)
    return out

def _pin_wanted(deps):
    """{(owner, repo): {version}} for every turn-family server the fleet runs whose repository also publishes an app."""
    app_repos = {_gh_owner_repo((links or {}).get("github")) for c in TURN_CLIENTS.values()
                 for links in (c.get("platforms") or {}).values()}
    out = {}
    for fork, _kind, _nid, _ifc, ver in _turn_deployed(deps):
        orp = tuple(turn_fork_owner(str(fork).partition("@")[0]).split("/", 1))
        if ver and orp in app_repos:
            out.setdefault(orp, set()).add(str(ver))
    return out

def _pin_lookup(owner, repo, tags, asset_re=None):
    """The release these tags name, as a pin record; None = none of them is a release (404); raises on anything else.
    `asset_re` keeps only the matching files (an app release that also holds a patch, a licence, a build recipe)."""
    for t in tags:
        try:
            x = _gh_api("/repos/%s/%s/releases/tags/%s" % (quote(owner), quote(repo), quote(t, safe="")))
        except urllib.error.HTTPError as e:
            if e.code == 404:
                continue                              # no release by this tag — try the next spelling
            raise
        if isinstance(x, dict) and x.get("tag_name"):
            rec = _gh_release_rec(x)
            if asset_re:
                rec["assets"] = [a for a in rec["assets"] if re.search(asset_re, a.get("name") or "", re.I)]
            # each OS's installer is decided here, once — the catalog only copies it
            return {"tag": rec["tag"], "page": rec["html_url"], "assets": rec["assets"],
                    "url": {o: u for o in _OS_ASSET_FORMATS for u in (_match_os_asset(rec["assets"], o),) if u}}
    return None

def _turn_warm_pins(deps, refresh=False):
    """Find the release of every running server version not pinned yet (by tag, one small request per spelling; a
    version no release names, or a lookup GitHub refuses, is retried hourly). `refresh` (the hourly pass) re-reads the
    pinned ones too — a release captured mid-upload gains its late installers. A version is retired only when no
    snapshot has shown it for _PIN_KEEP: a row one sync misses (a WDTT restart, a node posting late, the nodes not yet
    back after a panel restart) unpublishes nothing.
    True when what serve.json publishes changed — the caller saves the cache and rewrites serve.json."""
    global _PIN_WANTED
    seen = time.monotonic()                           # a clock step at boot (NTP) never retires or keeps a version
    for (o, r), vers in _pin_wanted(deps).items():
        for v in vers:
            _PIN_SEEN[(o, r, v)] = seen
    for k in [k for k, t in _PIN_SEEN.items() if seen - t >= _PIN_KEEP]:
        _PIN_SEEN.pop(k, None)                        # no server has run this version for an hour: retired
    wanted = {}
    for o, r, v in _PIN_SEEN:
        wanted.setdefault((o, r), set()).add(v)
    gone = [k for k in _RELEASE_PIN if k not in _PIN_SEEN]
    for k in gone:
        _RELEASE_PIN.pop(k, None)
    changed = bool(gone) or wanted != _PIN_WANTED
    now = time.time()
    hosted = {}
    for key in [(o, r, v) for (o, r), vers in wanted.items() for v in sorted(vers)]:
        owner, repo, v = key
        src = _pin_source(owner, repo, v)
        sk = src and "%s/%s@%s" % src
        if key in _RELEASE_PIN and not refresh and _RELEASE_PIN[key].get("src") == sk:
            continue                                  # (a pin cached from the other source is asked again — an upgrade)
        if key not in _RELEASE_PIN and now - _PIN_TRIED.get(key, 0) < 3600:
            continue
        if src and hosted.get(sk) is False:           # GitHub refused our release this pass: the builds sharing it rest too
            _PIN_TRIED[key] = now
            continue
        try:
            rec = None
            if src:                                   # one lookup per hosted release per pass, however many builds share it
                if sk not in hosted:
                    try:
                        hr = _pin_lookup(src[0], src[1], [src[2]], asset_re=r"\.apk$")
                    except urllib.error.HTTPError:
                        hosted[sk] = False
                        raise
                    hosted[sk] = hr if hr and hr["assets"] else None   # no APK yet (an upload in progress) = missing
                rec = hosted[sk] and dict(hosted[sk], tag=_hosted_app_ver(src[2]), src=sk)
            if rec is None:                           # not hosted, or our release is missing: his release by tag, as before
                old = _RELEASE_PIN.get(key) or {}
                kt = None if old.get("src") else old.get("tag")   # a refresh asks the pin's own tag, once
                tags = [kt] if kt else ([t for (f, ver), t in _PIN_TAG_OVERRIDE.items()
                                         if ver == v and turn_fork_owner(f) == owner + "/" + repo] or _pin_tags(v))
                rec = _pin_lookup(owner, repo, tags)
                if rec and src:                       # his release standing in for ours: marked so the 5-minute pass keeps
                    rec["src"] = sk                   # it (only the hourly refresh asks ours again), not re-asked every pass
        except urllib.error.HTTPError:
            _PIN_TRIED[key] = now                     # GitHub answered (a rate limit, a deleted repository): an hour's rest
            continue
        except Exception:
            break                                     # no network (a boot before egress, GitHub blocked): no verdict, and
                                                      # one timeout per pass, not one per version — the next pass asks
        if rec is None:
            _PIN_TRIED[key] = now                     # no such release: the latest stands in, as it always did
            if _RELEASE_PIN.pop(key, None) is not None:
                changed = True
        elif rec != _RELEASE_PIN.get(key):
            _RELEASE_PIN[key] = rec
            changed = True
    _PIN_WANTED = wanted                              # one rebind: a serve.json build meanwhile sees the old set or the new
    return changed

def _turn_pins_view():
    """serve.json's pins: {"owner/repo": {server version: {tag, page, assets, url:{os: installer}}}} — once per release,
    not per client and OS. swg-sub hands each subscriber only those of the versions its own servers run."""
    out = {}
    for (owner, repo), vers in _PIN_WANTED.items():
        for v in vers:
            x = _RELEASE_PIN.get((owner, repo, v))
            if isinstance(x, dict):
                out.setdefault(owner + "/" + repo, {})[v] = x
    return out

def _client_platforms_resolved(c):
    """A client's `platforms` with, per OS, the resolved best installer (`url`), the latest-release page (`page`), its
    version (`tag`), and the FULL latest-release asset list (`assets`) for the download bubble. Leaves `.github` as the
    fallback page; any OS whose repo hasn't resolved yet just keeps its original links."""
    out = {}
    for oskind, links in (c.get("platforms") or {}).items():
        links = dict(links or {})
        owner, repo = _gh_owner_repo(links.get("github"))
        if owner:
            u = _PLATFORM_ASSET.get((owner, repo, oskind))
            if u:
                links["url"] = u
            info = _RELEASE_INFO.get((owner, repo))
            if info:
                links["page"] = info.get("page") or links.get("github")
                links["tag"] = info.get("tag")
                links["assets"] = info.get("assets") or []
        out[oskind] = links
    return out

def _release_cache_path(deps):
    return os.path.join(os.path.dirname(deps.get("nodes_path") or ".") or ".", "release-cache.json")

def _release_cache_save(deps):
    """Persist the resolved release/asset caches so a panel RESTART serves the last-known download assets IMMEDIATELY
    (before the background warm re-resolves). Without this, every restart starts cold → serve.json gets written with
    empty assets → the sub's download bubbles show only the GitHub page until the next successful warm. Tuple keys
    (owner,repo[,os]) → 'owner/repo[/os]' strings for JSON."""
    with contextlib.suppress(Exception):
        data = {"release_info": {o + "/" + r: v for (o, r), v in _RELEASE_INFO.items()},
                "platform_asset": {o + "/" + r + "/" + osk: u for (o, r, osk), u in _PLATFORM_ASSET.items()},
                "release_pin": {o + "/" + r + "/" + v: x for (o, r, v), x in _RELEASE_PIN.items()}}
        p = _release_cache_path(deps); tmp = p + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, p)

def _release_cache_load(deps):
    """Seed the in-memory release/asset caches from disk at startup (best-effort) so serve.json is written with real
    download assets before the first warm completes — makes the sub's download bubbles survive restarts / GitHub blips."""
    with contextlib.suppress(Exception):
        data = json.load(open(_release_cache_path(deps)))
        for k, v in (data.get("release_info") or {}).items():
            o, r = k.split("/", 1)
            _RELEASE_INFO[(o, r)] = v
        for k, u in (data.get("platform_asset") or {}).items():
            o, r, osk = k.rsplit("/", 2)
            _PLATFORM_ASSET[(o, r, osk)] = u
        for k, x in (data.get("release_pin") or {}).items():
            o, r, v = k.split("/", 2)
            if isinstance(x, dict) and isinstance(x.get("url"), dict):   # a b1bb5d34 cache entry has no per-OS url: re-resolve it
                _RELEASE_PIN[(o, r, v)] = x
                _PIN_SEEN[(o, r, v)] = time.monotonic()   # seen as of the restart: published until the nodes report, an hour at most

_SUB_SERVE_LOCK = threading.RLock()   # serve.json's base_alt read-then-write vs the dual-base grace's writers

def _turn_warm_assets_loop(deps):
    def flush():
        with _SUB_SERVE_LOCK:
            ba = ""
            with contextlib.suppress(Exception):
                ba = ((json.load(open(_sub_serve_path(deps))).get("serve") or {}).get("base_alt") or "")
            write_sub_serve(deps, base_alt=ba)
    def pins(refresh):
        with contextlib.suppress(Exception):          # a pin failure never costs the assets' save and flush
            return _turn_warm_pins(deps, refresh)
        return False
    # the running servers' own releases first: after a restart serve.json publishes the cached pins within seconds,
    # not after a whole pass over every client's latest release
    if pins(False):
        with contextlib.suppress(Exception):
            flush()
    while True:
        resolved = 0
        try:
            resolved = _turn_warm_assets()
            if (pins(bool(resolved)) or resolved):   # the refresh re-asks every pin: hourly, never on the 2-minute retries
                _release_cache_save(deps)   # persist so the NEXT restart serves these assets immediately (no cold-start empty bubbles)
            flush()
        except Exception:
            pass
        until = time.time() + (3600 if resolved else 120)
        while time.time() < until:
            time.sleep(min(300, max(1, until - time.time())))
            if time.time() >= until:
                break
            if pins(False):
                with contextlib.suppress(Exception):
                    _release_cache_save(deps)
                    flush()

def _turn_p4_refresh(cid, roster):
    """NETWORK. Snapshot-on-change across BOTH the parseable schema-sources (→ field inventory) and the value-sources
    (→ per-field enum values). Bails before any raw fetch when no source-file commit moved. Appends a snapshot only
    when the (fields, values) pair differs from the latest, stamped with the app's latest release. Returns True iff so."""
    schema_srcs = [s for s in _client_sources(cid) if _source_field_parseable(s["path"])] if _p4_field_client(cid) else []
    vsrcs = _client_value_sources(cid)
    if not schema_srcs and not vsrcs:
        return False
    rec = roster.setdefault(cid, {})
    snaps = rec.setdefault("snapshots", [])
    last = snaps[-1] if snaps else None
    # 1) every distinct source file (schema + value), keyed by path → (owner,repo,branch,path)
    files = {}
    for s in schema_srcs:
        files[s["path"]] = (s["owner"], s["repo"], s["branch"], s["path"])
    for cfg in vsrcs.values():
        o, r, b, p = cfg["src"]
        files[p] = (o, r, b, p)
    commits = {}
    for p, loc in files.items():
        latest = _gh_latest_commit(*loc)
        if latest and latest.get("sha"):
            commits[p] = latest["sha"]
    if not commits:
        return False
    if last is not None and (last.get("commits") or {}) == commits:
        return False
    # 2) a file moved (or first snapshot) → fetch each distinct file once
    raw = {p: _gh_raw(*loc) for p, loc in files.items()}
    fields, ok = set(), False
    for s in schema_srcs:
        flds = _parse_source_fields(s["path"], raw.get(s["path"]), s.get("message")) if raw.get(s["path"]) is not None else None
        if flds is not None:
            fields.update(flds)
            ok = True
    values = {}
    for key, cfg in vsrcs.items():
        p = cfg["src"][3]
        if raw.get(p) is not None:
            vals = _extract_values(cfg["kind"], raw[p], cfg["marker"])
            if vals is not None:
                values[key] = vals
            ok = True
    if not ok:
        return False
    fields = sorted(fields)
    if last is not None and set(last.get("fields") or []) == set(fields) and (last.get("values") or {}) == values:
        last["commits"] = commits          # files moved but (fields, values) identical → refresh commits only
        return False
    rel_loc = (schema_srcs[0]["owner"], schema_srcs[0]["repo"]) if schema_srcs else next(iter(vsrcs.values()))["src"][:2]
    rel = _gh_latest_release(*rel_loc)
    snaps.append({"app_version": (rel or {}).get("tag"), "at": int(time.time()), "commits": commits, "fields": fields, "values": values})
    return True

def _turn_p4_adopt(cid, roster, add=None, remove=None, vadd=None, vrem=None):
    """Adopt per-field (`add`→active / `remove`→hidden) AND per-VALUE (`vadd`/`vrem` = {field:[values]} → active_vals).
    Everything validated against the current report so only genuine items apply. Returns what was applied."""
    rec = roster.setdefault(cid, {})
    rep = _turn_client_p4_report(cid, rec) or {}
    can_add, can_rm = set(rep.get("added") or []), set(rep.get("removed") or [])
    active, hidden = set(rec.get("active") or []), set(rec.get("hidden") or [])
    did_add = [f for f in (add or []) if f in can_add]
    did_rm = [f for f in (remove or []) if f in can_rm]
    active |= set(did_add)
    for f in did_rm:
        active.discard(f)
        hidden.add(f)
    rec["active"], rec["hidden"] = sorted(active), sorted(hidden)
    # value adopts
    vd = {v["field"]: v for v in (rep.get("value_diff") or [])}
    av = dict(rec.get("active_vals") or {})
    vdid = {"added": {}, "removed": {}}
    for f, vals in (vadd or {}).items():
        allow = set(vd.get(f, {}).get("added") or []) if vd.get(f, {}).get("adoptable_add") else set()
        take = [v for v in (vals or []) if v in allow]
        if take:
            av[f] = sorted(set(av.get(f) or []) | set(take)); vdid["added"][f] = take
    for f, vals in (vrem or {}).items():
        allow = set(vd.get(f, {}).get("removed") or [])
        take = [v for v in (vals or []) if v in allow]
        if take:
            av[f] = sorted(set(av.get(f) or []) - set(take)); vdid["removed"][f] = take
    rec["active_vals"] = av
    return {"added": did_add, "removed": did_rm, "values": vdid}

def _turn_p4_setversion(cid, roster, index):
    """Rollback: pin snapshot `index` (None = track latest) and reset `active`/`hidden` + `active_vals` to that
    version's confirmed fields/values — toggling what's exposed to match the app version, curation metadata untouched."""
    rec = roster.setdefault(cid, {})
    snaps = rec.get("snapshots") or []
    if index is None:
        rec["pinned_snapshot"] = None
        snap = snaps[-1] if snaps else None
    elif isinstance(index, int) and 0 <= index < len(snaps):
        rec["pinned_snapshot"] = index
        snap = snaps[index]
    else:
        return None
    if snap is not None:
        rec["active"] = _turn_seed_active(cid, _filter_inventory(cid, snap.get("fields") or []))
        rec["hidden"] = []
        rec["active_vals"] = {k: sorted(set(_strip_sentinels(v))) for k, v in (snap.get("values") or {}).items()}
    return rec

def _turn_p4_report_all(do_refresh=False):
    """Every P4-capable client's field report for the grid. `do_refresh` (operator re-check) hits GitHub; otherwise
    reads stored snapshots only (fast, per-poll safe). Persists on refresh or first-seed."""
    roster = _turn_roster_load()
    dirty, out = False, {}
    for cid in TURN_CLIENTS:
        if not _p4_field_client(cid) and not _client_value_sources(cid):
            continue                                    # not a field-diff client AND no value-source → P1 ack path covers it
        rec = roster.setdefault(cid, {})
        if do_refresh and _turn_p4_refresh(cid, roster):
            dirty = True
        had_active = rec.get("active") is not None
        rep = _turn_client_p4_report(cid, rec)          # seeds rec["active"] in place on first read
        if not had_active and rec.get("active") is not None:
            dirty = True
        if rep is None:
            continue
        out[cid] = {**rep, "name": TURN_CLIENTS[cid].get("name") or cid,
                    "versions": [{"app_version": s.get("app_version"), "at": s.get("at")} for s in (rec.get("snapshots") or [])],
                    "pinned_snapshot": rec.get("pinned_snapshot")}
    if dirty:
        _turn_roster_save(roster)
    return {"clients": out, "checked_at": int(time.time())}

_GH_RATE = {"until": 0}

_GH_FP_URL = os.environ.get(
    "SWG_FINGERPRINTS_URL",
    "https://raw.githubusercontent.com/tesla-prep/vpn-panel/fingerprints/client-fingerprints.json")
_GH_FP_TTL = 3600
_GH_FP = {"at": 0.0, "map": {}, "ok": False}


def _gh_fingerprints():
    """{"owner/repo@branch:path": {sha,date,url}} from the published file. {} when it can't be read — the
    caller then falls back to the API exactly as before, so an unreachable file degrades to today's
    behaviour rather than to a wrong answer."""
    now = time.time()
    if now - _GH_FP["at"] < _GH_FP_TTL:
        return _GH_FP["map"]
    flat = {}
    ok = False
    with contextlib.suppress(Exception):
        req = urllib.request.Request(_GH_FP_URL, headers={"User-Agent": "swg-panel", "Cache-Control": "no-cache"})
        with urllib.request.urlopen(req, timeout=10) as r:
            doc = json.loads(r.read(2_000_000).decode("utf-8", "replace"))
        if isinstance(doc, dict) and int(doc.get("schema") or 0) == 1:
            for _cid, files in (doc.get("clients") or {}).items():
                for key, rec in (files or {}).items():
                    if isinstance(rec, dict) and rec.get("sha"):
                        flat[key] = {"sha": rec.get("sha"), "date": rec.get("date"), "url": rec.get("url")}
            ok = True
    _GH_FP.update({"at": now, "map": flat, "ok": ok})
    return flat

def _gh_latest_commit(owner, repo, branch, path):
    """Latest commit {sha,date,url} touching `path` on `branch`, via the GitHub API. None on any error/rate-limit.
    Cached ~1h so a burst of re-checks doesn't exhaust the 60/hr unauthenticated budget (SWG_GH_TOKEN lifts it)."""
    key = "%s/%s@%s:%s" % (owner, repo, branch, path)
    if not os.environ.get("SWG_GH_TOKEN", "").strip():
        hit = _gh_fingerprints().get(key)
        if hit:
            return hit
    ent = _GH_COMMIT_CACHE.get(key)
    if ent and time.time() - ent["at"] < 3600:
        return ent["res"]
    res = None
    try:
        url = ("https://api.github.com/repos/%s/%s/commits?path=%s&sha=%s&per_page=1"
               % (quote(owner), quote(repo), quote(path), quote(branch)))
        hdr = {"User-Agent": "swg-panel", "Accept": "application/vnd.github+json"}
        tok = os.environ.get("SWG_GH_TOKEN", "").strip()
        if tok:
            hdr["Authorization"] = "Bearer " + tok
        with urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=10) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
        if isinstance(data, list) and data:
            c = data[0]
            res = {"sha": c.get("sha"), "date": (((c.get("commit") or {}).get("committer") or {}).get("date")), "url": c.get("html_url")}
    except Exception as e:
        res = None
        _h = getattr(e, "headers", None)
        if getattr(e, "code", None) in (403, 429) and _h is not None:
            with contextlib.suppress(Exception):
                if str(_h.get("X-RateLimit-Remaining", "")).strip() == "0":
                    _GH_RATE["until"] = int(_h.get("X-RateLimit-Reset") or 0)
                    return None
    _GH_COMMIT_CACHE[key] = {"res": res, "at": time.time()}
    return res

def _gh_raw(owner, repo, branch, path):
    """Raw file content from raw.githubusercontent.com. None on any error."""
    try:
        url = "https://raw.githubusercontent.com/%s/%s/%s/%s" % (owner, repo, branch, path)
        req = urllib.request.Request(url, headers={"User-Agent": "swg-panel", "Cache-Control": "no-cache"})
        with urllib.request.urlopen(req, timeout=12) as r:
            return r.read().decode("utf-8", "replace")
    except Exception:
        return None

def _proto_message_block(text, msg):
    """The balanced-brace body of `message <msg> { … }`, or None. Scopes parsing to ONE message — a single .proto can
    hold the app's entire config (dozens of messages); we only want the relevant one (e.g. Turn)."""
    m = re.search(r'\bmessage\s+' + re.escape(msg) + r'\s*\{', text or "")
    if not m:
        return None
    i, start, depth = m.end(), m.end(), 1
    while i < len(text) and depth:
        depth += 1 if text[i] == "{" else (-1 if text[i] == "}" else 0)
        i += 1
    return text[start:i - 1]

def _parse_proto_fields(text, message=None):
    """Message field names from a proto3 .proto — a field carries a TYPE before the name (`int32 threads = 1;`); enum
    values (`NAME = 0;`) don't → excluded. When `message` is given, only that message's block is scanned (else the
    whole file). Sorted unique list."""
    if message:
        text = _proto_message_block(text, message)
        if text is None:
            return None
    fields = set()
    for line in (text or "").splitlines():
        m = re.match(r'\s*(?:repeated\s+|optional\s+)?(?:map<[^>]+>|[\w.]+)\s+(\w+)\s*=\s*\d+\s*;', line)
        if m:
            fields.add(m.group(1))
    return sorted(fields)

def _parse_python_config_fields(text):
    """String keys of the top-level CONFIG dict in a quick_link.py-style module (anton48). Parses (never executes) via
    ast; falls back to the union of every module-level string-keyed dict literal if there's no CONFIG. None if unparseable.
    Best-effort ("assisted") — a rename/wrapper can hide keys, so the operator still confirms."""
    try:
        tree = ast.parse(text or "")
    except Exception:
        return None
    named = {}
    for node in getattr(tree, "body", []):
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Dict):
            keys = {k.value for k in node.value.keys if isinstance(k, ast.Constant) and isinstance(k.value, str)}
            if keys:
                for t in node.targets:
                    if isinstance(t, ast.Name):
                        named[t.id] = keys
    if not named:
        return None
    if "CONFIG" in named:
        return sorted(named["CONFIG"])
    out = set()
    for v in named.values():
        out |= v
    return sorted(out)

def _parse_go_struct_fields(text):
    """Config field names from a Go source (Moroka8 clientcore): prefers serialization tag names
    (`json/yaml/toml/mapstructure:"name"`), else exported field names inside `struct{…}` blocks. None if none found.
    Best-effort ("assisted") — nested structs and untagged fields can slip through."""
    text = text or ""
    fields = set()
    for m in re.finditer(r'`[^`]*\b(?:json|yaml|toml|mapstructure):"([^",]+)(?:,[^"]*)?"', text):
        nm = m.group(1).strip()
        if nm and nm != "-":
            fields.add(nm)
    if not fields:
        for block in re.finditer(r'struct\s*\{([^{}]*)\}', text, re.S):
            for line in block.group(1).splitlines():
                fm = re.match(r'\s*([A-Z]\w*)\s+[\w\*\[\]\.]+', line)
                if fm:
                    fields.add(fm.group(1))
    return sorted(fields) if fields else None

def _parse_kotlin_fields(text):
    """Property names from a Kotlin data-class/settings source — `val/var <name>: <Type>` (the TYPE annotation is
    required, so constructor params & class properties match but untyped locals don't). Best-effort ('assisted')."""
    fields = set()
    for line in (text or "").splitlines():
        m = re.match(r'\s*(?:@\w+\s+)*(?:override\s+|private\s+|public\s+|internal\s+|protected\s+|const\s+)*(?:val|var)\s+(\w+)\s*:\s*[\w<>?.,\[\]* ]+', line)
        if m:
            fields.add(m.group(1))
    return sorted(fields) if fields else None

def _source_field_parseable(path):
    """True when a source path is one we can extract field names from (proto authoritative; py/go/kotlin assisted)."""
    return (path or "").lower().endswith((".proto", ".py", ".go", ".kt"))

def _parse_source_fields(path, text, message=None):
    """Best-effort field-name list for a curated schema source; None for commit-only types (Markdown). `message`
    scopes a proto to one message block (a wingsv.proto holds the whole app config; we want only Turn)."""
    p = (path or "").lower()
    if p.endswith(".proto"):
        return _parse_proto_fields(text, message)
    if p.endswith(".py"):
        return _parse_python_config_fields(text)
    if p.endswith(".go"):
        return _parse_go_struct_fields(text)
    if p.endswith(".kt"):
        return _parse_kotlin_fields(text)
    return None

def _extract_values_jsarray(text, marker):
    """JS options array `<marker> = [{ value: 'x', … }, …]` (wings VkTurnSettingsView.vue). `marker` = the const name."""
    m = re.search(re.escape(marker) + r'\s*=\s*\[(.*?)\]', text or "", re.S)
    if not m:
        return None
    vals = re.findall(r'\bvalue\s*:\s*[\'"]([^\'"]+)[\'"]', m.group(1))
    return sorted(set(vals)) if vals else None

def _extract_values_mdpipe(text, flag):
    """Enum values for a flag from a markdown-table cell (samosvalishe flags.md): the value column is an ESCAPED-pipe
    alternation of backtick tokens, possibly with annotations (`` `plain` (UDP/53) \\| `doh` \\| `auto` ``). On the
    flag's row (which must contain an escaped `\\|` alternation) collect every backtick token that isn't a flag
    reference (leading `-`) — that yields the value set while tolerating annotation text and the default column."""
    for line in (text or "").splitlines():
        if ("`" + flag + "`") not in line or not re.search(r'\\\|', line):
            continue
        toks = [t for t in re.findall(r'`([\w.-]+)`', line) if not t.startswith("-")]
        if toks:
            return sorted(set(toks))
    return None

def _extract_values_pytuple(text, field):
    """Python membership check `<field> … in ("a","b",…)` / `[…]` (anton quick_link.py obfProfile)."""
    m = re.search(re.escape(field) + r'\b[^\n]*?\bin\s*[\(\[]([^)\]]*)[)\]]', text or "")
    if not m:
        return None
    vals = re.findall(r'[\'"]([^\'"]+)[\'"]', m.group(1))
    return sorted(set(vals)) if vals else None

def _extract_values_gochain(text, field):
    """Go equality chain `<field> != "a" && <field> != "b"` / `== "a"` (Moroka8 main.go CaptchaSolver)."""
    vals = {m.group(1) for m in re.finditer(re.escape(field) + r'\s*(?:==|!=)\s*"([^"]+)"', text or "")}
    return sorted(vals) if vals else None

_VALUE_EXTRACTORS = {"jsarray": _extract_values_jsarray, "mdpipe": _extract_values_mdpipe,
                     "pytuple": _extract_values_pytuple, "gochain": _extract_values_gochain}
def _extract_values(kind, text, marker):
    fn = _VALUE_EXTRACTORS.get(kind)
    return fn(text, marker) if fn else None

def _turn_roster_load():
    with contextlib.suppress(Exception):
        with open(TURN_ROSTER_PATH) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return d
    return {}

def _turn_roster_save(d):
    with _TURN_ROSTER_LOCK, contextlib.suppress(Exception):
        tmp = TURN_ROSTER_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, TURN_ROSTER_PATH)

def _turn_roster_check(seed=True):
    """For every client with curated sources, fetch each source file's latest commit and compare to the last-
    acknowledged fingerprint. A watched PATH with no stored fingerprint is SEEDED to current (baseline) — drift is
    unknowable without one; a client with none at all reads up_to_date. Paths that have one are never re-seeded here
    (that would acknowledge their drift unseen). status: up_to_date | changed | unknown (fetch failed)."""
    roster = _turn_roster_load()
    out = {}
    seeded = False
    for cid in TURN_CLIENTS:
        if cid in TURN_GONE_CLIENTS:
            continue                                    # its repository is gone: nothing to watch, and no row
        srcs = _client_sources(cid)
        if not srcs:
            out[cid] = {"name": (TURN_CLIENTS[cid].get("name") or cid), "status": "unwatched",
                        "files": [], "sources": [], "acknowledged_at": None}
            continue
        prev = (roster.get(cid) or {}).get("files") or {}
        files, any_unknown, any_changed, seen = [], False, False, {}
        for s in srcs:
            p = s["path"]
            latest = _gh_latest_commit(s["owner"], s["repo"], s["branch"], p)
            if not latest or not latest.get("sha"):
                files.append({"path": p, "status": "unknown", "url": "https://github.com/%s/%s/commits/%s/%s" % (s["owner"], s["repo"], s["branch"], p)})
                any_unknown = True
                continue
            seen[p] = {"commit": latest["sha"], "at": int(time.time())}
            old = (prev.get(p) or {}).get("commit")
            ch = bool(old) and old != latest["sha"]
            any_changed = any_changed or ch
            frec = {"path": p, "status": ("changed" if ch else "up_to_date"),
                    "latest_commit": (latest["sha"] or "")[:7], "latest_date": latest.get("date"), "url": latest.get("url"),
                    "compare_url": ("https://github.com/%s/%s/compare/%s...%s" % (s["owner"], s["repo"], old, latest["sha"])) if ch else None}
            if _source_field_parseable(p):                    # P2/P3: field-name diff (proto authoritative; py/go assisted)
                prev_fields = (prev.get(p) or {}).get("fields")
                if ch or not old:                             # fetch the raw source only when it moved (or seeding)
                    raw = _gh_raw(s["owner"], s["repo"], s["branch"], p)
                    cur_fields = _parse_source_fields(p, raw, s.get("message")) if raw is not None else None
                    if cur_fields is not None:
                        seen[p]["fields"] = cur_fields
                        if ch and prev_fields is not None:
                            frec["field_diff"] = {"added": [x for x in cur_fields if x not in prev_fields],
                                                  "removed": [x for x in prev_fields if x not in cur_fields],
                                                  "assisted": not p.endswith(".proto")}
                    elif prev_fields is not None:
                        seen[p]["fields"] = prev_fields       # raw fetch/parse failed → keep the baseline fields
                elif prev_fields is not None:
                    seen[p]["fields"] = prev_fields           # unchanged → carry the stored fields forward
            files.append(frec)
        fresh = {p: v for p, v in seen.items() if p not in prev}
        if seed and fresh:
            rec, watched = roster.get(cid) or {}, {s["path"] for s in srcs}
            kept = {p: v for p, v in prev.items() if p in watched}   # a path no longer watched drops out
            roster[cid] = dict(rec, files=dict(kept, **fresh), at=rec.get("at") or int(time.time()))
            seeded = True
        if not prev and seed and seen:
            status = "up_to_date"
        elif any_changed:
            status = "changed"
        elif any_unknown and not any(f["status"] == "up_to_date" for f in files):
            status = "unknown"
        else:
            status = "up_to_date"
        out[cid] = {"name": (TURN_CLIENTS[cid].get("name") or cid), "status": status, "files": files,
                    "sources": srcs, "acknowledged_at": (roster.get(cid) or {}).get("at")}
    if seeded:
        _turn_roster_save(roster)
    # Reported ONCE for the whole check, not per client: it is one condition affecting all of them, and repeating
    # it on nineteen rows would read as nineteen broken paths.
    rl = int(_GH_RATE.get("until") or 0)
    _tok = os.environ.get("SWG_GH_TOKEN", "").strip()
    return {"clients": out, "checked_at": int(time.time()),
            "watch_via": "api-token" if _tok else ("file" if _GH_FP.get("ok") else "api"),
            "rate_limited": (rl if rl > int(time.time()) else 0)}

def _turn_roster_ack(cid):
    """Acknowledge a client's current upstream as the new baseline (writes its latest commits into the fingerprint)."""
    srcs = _client_sources(cid)
    if not srcs:
        return None
    files = {}
    for s in srcs:
        latest = _gh_latest_commit(s["owner"], s["repo"], s["branch"], s["path"])
        if latest and latest.get("sha"):
            rec = {"commit": latest["sha"], "at": int(time.time())}
            if _source_field_parseable(s["path"]):
                raw = _gh_raw(s["owner"], s["repo"], s["branch"], s["path"])
                flds = _parse_source_fields(s["path"], raw, s.get("message")) if raw is not None else None
                if flds is not None:
                    rec["fields"] = flds
            files[s["path"]] = rec
    roster = _turn_roster_load()
    roster[cid] = {"files": files, "at": int(time.time())}
    _turn_roster_save(roster)
    return files

def turn_catalog_view(pins=False):
    """The turn catalog as the SPA + swg-sub consume it: servers in display order + the clients map (each client
    carries its own `settings` schema + `native_fork`, so the Clients tab edits an app's knobs once). RAW — colour
    overrides (turn_fork_colors) and the install-picker filter (enabled_turn_forks) stay in the consumers. `pins`
    (serve.json only) adds each running server version's own app release: /api/state carries this catalog every
    5 s, and the SPA never reads them."""
    return {"servers": [{"id": sid, "compat": cm,
                         # per (this fork, client) schema — the mysorez app's knobs depend on which core THIS fork loads
                         "client_schemas": {cid: _client_schema_for(sid, cid) for cid in cm},
                         # per-author CLI builds (native first) for the picker — N/A for a self-contained kind (its clients are fixed, not catalog-driven), so no dead default
                         "cli_authors": ([] if TURN_SERVERS[sid].get("kind") == "wdtt" else _turn_cli_authors(sid)),
                         # WDTT forks are OUR versioned builds — ship the published versions (newest first) so the SPA shows current + rollback targets
                         "wdtt_versions": [v for v, _ in _wdtt_versions(sid)],
                         # DEVICE ACCESS §11.2 F4 — does the build a CREATE installs prove which user a device belongs to? The create
                         # sheet warns before the instance exists; the edit sheet then reads the node's reported build instead.
                         **({"reach_vouched": keyless_share_capable(sid, "wg", _wdtt_current_version(sid))
                                              if TURN_SERVERS[sid].get("kind") == "wdtt"
                                              else keyless_share_capable(sid, "raw", _csqtt_current_version())}
                            if TURN_SERVERS[sid].get("kind") in ("wdtt", "csqtt") else {}),
                         "hidden": sid in TURN_HIDDEN_FORKS,   # in the catalog (deployed instances still resolve label/colour) but skipped by every operator-facing fork list
                         **TURN_SERVERS[sid]} for sid, cm in ((s, _turn_compat(s)) for s in TURN_SERVER_ORDER if s in SUPPORTED_TURN_FORKS)],
            **({"pins": _turn_pins_view()} if pins else {}),
            "clients": {cid: {**c, "platforms": _client_platforms_resolved(c),
