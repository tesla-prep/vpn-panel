                        # routing / filters. Config fields only — never the owner password / sealed key material.
                        "wdtt_cfg": {ifn: {k: (reach_level(ov.get(k)) if k == "reach" else ov.get(k)) for k in ("wg_addr", "listen", "fork", "wg_port", "max_passwords",
                                                                   "stopped", "block", "p2p", "egress_mode", "egress_node",
                                                                   "egress_ip", "wan_iface", "routing", "routing_exit_ips", "title", "params",
                                                                   "raw_port", "raw_iface", "raw_addr", "exit_id", "reach", "dns", "dns_orig", "bind_ip") if k in ov}
                                     for ifn, ov in _w.items()},
