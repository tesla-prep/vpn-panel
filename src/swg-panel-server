def peer_sub_sources(peer, snaps):
    out = []
    for t in (peer or {}).get("targets") or []:
        ty = (t or {}).get("type") or "wg"
        if ty not in out:
            out.append(ty)
        if ty in ("wdtt", "csqtt") or "turn" in out:
            continue
        snap = (snaps or {}).get(t.get("node")) or {}
        lp = (((snap.get("interfaces") or {}).get(t.get("iface")) or {}).get("meta") or {}).get("listen_port")
        if lp and any(_port_of(tp.get("connect")) == str(lp) for tp in (snap.get("turn_proxies") or []) if isinstance(tp, dict)):
            out.append("turn")
    return [s for s in SUB_SOURCES if s in out]


def clean_sub_hide(raw, peer, snaps):
    hide = [s for s in SUB_SOURCES if s in set(raw or [])]
    have = peer_sub_sources(peer, snaps)
    if have and all(s in hide for s in have):
        return None
    return hide


