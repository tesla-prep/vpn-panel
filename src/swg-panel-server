P2P_PORT_POOL = (20000, 29999)


def _running_ports(deps, nid, kind, iface):
    v, out = (((deps.get("node_snaps") or {}).get(nid) or {}).get(kind)), []
    for k, x in (v.items() if isinstance(v, dict) else enumerate(v) if isinstance(v, list) else ()):
        if isinstance(x, dict) and (x.get("iface") or k) == iface:
            out += [_port_of(str(x.get("listen") or "")), str(x.get("wg_port") or "")]
    return [p for p in out if p.isdigit()]


def p2p_pool_refusal(port, keep=()):
    with contextlib.suppress(TypeError, ValueError):
        p = int(str(port).strip())
        if P2P_PORT_POOL[0] <= p <= P2P_PORT_POOL[1] and str(p) not in {str(k).strip() for k in keep if k is not None}:
            return "Ports 20000–29999 are kept for devices' incoming torrent ports — pick another port."
    return None


def p2p_port_wanted(p):
    return any(isinstance(t, dict) and not _is_self_contained_target(t) for t in (p.get("targets") or []))


def _p2p_free(roster, used):
    lo, hi = P2P_PORT_POOL
    nx = roster.get("p2p_next")
    if not (type(nx) is int and lo <= nx <= hi):
        nx = min(max([u for u in used if type(u) is int and lo <= u <= hi], default=lo - 1) + 1, hi)
    return (x for r in (range(nx, hi + 1), range(lo, nx)) for x in r if x not in used)


def _p2p_mark(roster, x):
    roster["p2p_next"] = x + 1 if x < P2P_PORT_POOL[1] else P2P_PORT_POOL[0]


def p2p_port_take(roster, pid):
    used = {q.get("p2p_port") for k, q in (roster.get("peers") or {}).items() if k != pid and isinstance(q, dict)}
    x = next(_p2p_free(roster, used), None)
    if x is not None:
        _p2p_mark(roster, x)
    return x


def p2p_ports_fill(roster, first=()):
    peers, used, todo, changed = roster.get("peers") or {}, set(), [], False
    for pid in sorted(peers, key=lambda k: (k not in first, k)):
        q = peers[pid]
        if not isinstance(q, dict):
            continue
        v = q.get("p2p_port")
        with contextlib.suppress(TypeError, ValueError, OverflowError):
            if not isinstance(v, (bool, int)) and float(v) == int(float(v)):
                v = int(float(v))
        if type(v) is int and P2P_PORT_POOL[0] <= v <= P2P_PORT_POOL[1] and v not in used:
            used.add(v)
            if type(q.get("p2p_port")) is not int:
                q["p2p_port"], changed = v, True
        elif p2p_port_wanted(q):
            todo.append(q)
    if used and roster.get("p2p_next") is None:
        _p2p_mark(roster, max(used))
        changed = True
    free = _p2p_free(roster, used)
    for q in todo:
        x = next(free, None)
        if x != q.get("p2p_port"):
            changed = True
            q.update(p2p_port=x) if x else q.pop("p2p_port", None)
        if x is not None:
            _p2p_mark(roster, x)
    return changed


def p2p_ports_at_start(path):
    r = roster_load(path)
    if p2p_ports_fill(r):
        roster_save(path, r)


_P2P_FWD = {}


def p2p_fwd_for_node(mark, roster, node_id, scope):
    if not scope:
        return []
    hit = _P2P_FWD.get(node_id)
    if mark is not None and hit and hit[0] == (mark, scope):
        return hit[1]
    nets, out = [ipaddress.ip_network(x, strict=False) for x in scope[1]], []
    for p in (roster.get("peers") or {}).values():
        port = p.get("p2p_port") if isinstance(p, dict) else None
        ts = []
        for t in (p.get("targets") or []) if type(port) is int else []:
            if not isinstance(t, dict) or t.get("node") != node_id or _is_self_contained_target(t):
                continue
            with contextlib.suppress(ValueError, TypeError):
                a = ipaddress.ip_address(str(t.get("ip") or "").split("/")[0])
                if a.version == 4 and any(a in n for n in nets) == (scope[0] == "iface"):
                    role = t.get("primary")
                    primary = role.strip().lower() == "primary" if isinstance(role, str) else bool(role)
                    ts.append((not primary, str(t.get("iface") or ""), a))
        if ts:
            out.append((min(ts)[2], port))
    out = [[str(a), q] for a, q in sorted(out)]
    if mark is not None:
        _P2P_FWD[node_id] = ((mark, scope), out)
    return out


