                        # routing / filters. Config fields only — never the owner password / minted access passwords.
                        "csqtt_cfg": {ifn: {k: (reach_level(ov.get(k)) if k == "reach" else ov.get(k)) for k in ("listen", "tun_addr", "max_passwords", "stopped", "fork",
                                                                    "block", "p2p", "egress_mode", "egress_node", "egress_ip",
                                                                    "wan_iface", "routing", "routing_exit_ips", "title", "params", "exit_id", "reach", "dns", "dns_orig", "bind_ip", "line",
                                                                    "app_routing", "app_routing_except") if k in ov}
                                      for ifn, ov in _c.items()},
                        "wdtt_restoring": sorted((c.get("wdtt_restore") or {}).keys()),  # identity restores in flight (cleared when the node reports the blessed pubkey)
                        "wdtt_recreating": sorted((c.get("wdtt_recreate") or {}).keys()),  # fresh-identity recreates in flight (vault abandoned)
                        "wdtt_adopting": sorted(k for k, v in _w.items() if (v or {}).get("adopt_foreign")),   # foreign-server take-overs in flight (cleared once the node reports the instance)
                        "csqtt_adopting": sorted(k for k, v in _c.items() if (v or {}).get("adopt_foreign")),  # same, for csqtt
                        "wdtt_claimed_dirs": sorted(_claimed_wdtt_dirs),
                        "ghost_ifaces": _ghost_ifaces(c, snap, _refmap.get(nid), online)})   # lost KEYLESS ifaces (no _lastcfg) → recreate-fresh + rekey, not restore (online-gated)
        return out

    def describe_view():
        """Per-node interface metadata (server key / endpoint / subnet / awg / dns) the
        create + copy flows need, with the panel's endpoint_host override applied — so the
        UI builds client configs without a describe round-trip per node. Keyed by node id."""
        out = {}
        for nid in nodes:
            snap = snaps.get(nid)
            if not snap:
                continue
            d = node_describe(snap)["data"]["interfaces"]
            apply_iface_meta(nodes.get(nid), d, _current_ivk_pub(deps),
                             bool((snap or {}).get("iface_key_vault_restore")))
            for _ifn, _h in ((snap or {}).get("mesh_health") or {}).items():
                if _ifn in d and isinstance(d[_ifn], dict):
                    d[_ifn]["link"] = _h
            # …and the node's own errored/dropped share for every interface, mesh or client-facing.
            for _ifn, _h in ((snap or {}).get("iface_drops") or {}).items():
                if _ifn in d and isinstance(d[_ifn], dict):
                    d[_ifn]["drops"] = _h
            out[nid] = d
        return out

