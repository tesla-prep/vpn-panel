        has_ip = bool((body.get("ip") or "").strip())
        has_ov = "overrides" in body
        if not has_ip and not has_ov:
            return 400, {"ok": False, "error": "nothing to change (send ip and/or overrides)", "code": "bad_request"}
        ip = (body.get("ip") or "").split("/")[0].strip()
        if has_ip and not valid_addr(ip):
            return 400, {"ok": False, **perr("invalid address {v1}", v1=repr(body.get("ip"))), "code": "bad_request"}
        roster = roster_load(roster_path)
        p = roster["peers"].get(pid)
        if not p:
            return 404, {"ok": False, "error": "unknown peer", "code": "not_found"}
        cur = next((t for t in p["targets"] if t["node"] == node and t["iface"] == iface), None)
        if cur is None:
            return 404, {"ok": False, "error": "peer has no target on that node/interface", "code": "not_found"}
        if has_ip and is_keyless_kind(iface_kind(deps, nodes, snaps, node, iface, cur.get("type") or "")):
            return 400, {"ok": False, **perr("{v1} assigns the client address on connect — it can't be set here", v1=iface), "code": "bad_request"}
        if has_ip:
            for op in roster["peers"].values():
                if op.get("id") == pid:
                    continue
                for t in op.get("targets", []):
                    if t.get("node") == node and t.get("iface") == iface and (t.get("ip") or "").split("/")[0] == ip:
                        return 409, {"ok": False, **perr("{v1} is already used on {v2}", v1=ip, v2=f"{node}/{iface}"), "code": "exists"}
        def _upd(t):
            if t["node"] != node or t["iface"] != iface:
                return t
            t = dict(t)
            if has_ip:
                t["ip"] = ip
            if has_ov:
                t["overrides"] = body.get("overrides") or {}
            return t
        targets = [_upd(t) for t in p["targets"]]
        p2 = peer_set(roster, pid, {"targets": targets}, now())
        roster_save(roster_path, roster)
        if has_ip:
            ev_append(roster_path, "peer", pid, "Changed address", peer_label(roster, p2), f"{node}/{iface} → {ip}")
