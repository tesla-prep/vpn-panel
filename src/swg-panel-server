        # one group down is not every routed interface (S11 backlog F48); a node that names none, the line as before
        _dn = _p2pn.get("down") if _p2pa == "iface" and isinstance(_p2pn.get("down"), list) else None
        # only records that RUN that route: not one on Block (strictest wins), not one already named dead (p2p_iface)
        _dr = sorted(rn for _k in ("ifaces", "wdtt", "csqtt") for rn, _r in ((c.get(_k) or {}).items() if isinstance(c.get(_k), dict) else ())
                     if isinstance(_r, dict) and rn not in (p2p_iface or ()) and "torrents" not in (_r.get("block") or [])
