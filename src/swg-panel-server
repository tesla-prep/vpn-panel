        _carry = node_networks(roster, nid, snap)["carry"] if (_share_any or (_routes_any and _dr_on)) else {}
        _nshare = net_share_for_node(roster, nid, _carry, snap) if _share_any else []
        _dreach = dev_reach_for_node(roster, node, nid, snap, _carry, _promo) if _dr_on else {}
        owned_ifaces = sorted((node.get("ifaces") or {}).keys())
        _nprobe = net_probe_reply(nid)
        _xtest = exit_test_reply(nid)
        _ltok = _log_tok(self.headers.get("Authorization"))   # this sync's node token: its log posts are read (F1)
        _live = live_reply(nid, tok=_ltok)          # Logs P2: only while a viewer names this node
        _lrange = range_reply(nid, tok=_ltok)       # Logs P3: only while a range download waits on this node
