def sub_gc_user(deps, uid, roster):
    live = sub_live_peers(roster, uid)
    blobs = load_sub_blobs(deps, uid)
    pruned = {pid: v for pid, v in blobs.items() if pid in live}
    if pruned != blobs:
        if pruned:
            save_sub_blobs(deps, uid, pruned)
        else:
            drop_sub_blobs(deps, uid)
    return pruned

def sub_gc_orphan(deps, roster):
    peers = roster.get("peers") or {}
    blobs = load_sub_blobs(deps, SUB_ORPHAN)
    keep = {}
    for pid, v in blobs.items():
        p = peers.get(pid)
        if not p:
            continue
        uid = p.get("user_id")
        if not uid:
            keep[pid] = v; continue
        if pid in load_sub_blobs(deps, uid):
            continue
        keep[pid] = v
    if keep != blobs:
        if keep:
            save_sub_blobs(deps, SUB_ORPHAN, keep)
        else:
            drop_sub_blobs(deps, SUB_ORPHAN)
    return keep

