                       for p in peers if p.get("allowed_ips")})
        interfaces[iface] = {
            "public_key": meta.get("public_key"), "listen_port": meta.get("listen_port"),
            "backup_public_key": meta.get("backup_public_key"),
            "endpoint": meta.get("endpoint"), "address": meta.get("address"),
            "subnet": meta.get("subnet"), "awg_params": meta.get("awg_params", {}),
            **({"tool": meta["tool"]} if meta.get("tool") in ("wg", "awg") else {}),
            "mtu_reported": meta.get("mtu"),
            "dns": meta.get("dns", []), "used_ips": used, "peer_count": len(peers),
            "rx_speed": sum(p.get("rx_speed", 0) or 0 for p in peers),
            "tx_speed": sum(p.get("tx_speed", 0) or 0 for p in peers),
            "rx_bytes": sum(p.get("rx_bytes", 0) or 0 for p in peers),
            "tx_bytes": sum(p.get("tx_bytes", 0) or 0 for p in peers),
            "handshake_age": min((p.get("handshake_age") for p in peers if p.get("handshake_age") is not None), default=None),
            "peer_endpoint": (peers[0].get("endpoint") if len(peers) == 1 else None),
        }
    return {"ok": True, "op": "describe",
            "data": {"hostname": snapshot.get("hostname"), "interfaces": interfaces}}


def iface_egress_mode(rec):
    mode = rec.get("egress_mode")
    if not mode or mode == "direct":
        # Older panels stored Auto and pinned direct output under the same value.
        return "local" if any(str(rec.get(k) or "").strip() for k in ("wan_iface", "egress_ip")) else "node"
    return mode


def apply_iface_meta(node_cfg, interfaces, ivk_pub="", vault_restore_ok=False):
    node_ep = (node_cfg or {}).get("endpoint_host")
    ifov = (node_cfg or {}).get("ifaces") or {}
    for ifn, ifc in interfaces.items():
        ov = ifov.get(ifn) or {}
        rep = ifc.get("endpoint") or ""
        rep_host = rep.rsplit(":", 1)[0] if ":" in rep else rep
        host = ov.get("endpoint_host") or node_ep or rep_host
        want_port = ov.get("listen_port")
        port = want_port or ifc.get("listen_port")
        if host and port:
            ifc["endpoint"] = f"{host}:{port}"
        if want_port:
            ifc["desired_port"] = want_port
        if ov.get("dns") is not None:
            d = ov["dns"]
            ifc["dns"] = d if isinstance(d, list) else [s.strip() for s in str(d).split(",") if s.strip()]
        want_mtu = ov.get("mtu")
        ifc["mtu"] = want_mtu or ifc.get("mtu_reported") or 1280
        if want_mtu:
            ifc["desired_mtu"] = want_mtu
        if ov.get("keepalive") is not None:
            ifc["keepalive"] = ov["keepalive"]
        ifc["egress_ip"] = ov.get("egress_ip") or ""
        ifc["wan_iface"] = ov.get("wan_iface") or ""
        ifc["egress_mode"] = iface_egress_mode(ov)
        ifc["egress_node"] = ov.get("egress_node") or ""
        ifc["exit_id"] = ov.get("exit_id") or ""
        ifc["routing"] = ov.get("routing") or []
        ifc["routing_exit_ips"] = dict(ov.get("routing_exit_ips") or {})
        ifc["reach"] = reach_level(ov.get("reach"))
        ifc["block"] = ov.get("block") or []
        ifc["p2p"] = ov.get("p2p") or None
        ifc["system"] = bool(ov.get("system"))
        ifc["link_node"] = ov.get("link_node") or ""
        _lr = ((node_cfg.get("links") or {}).get(ifc["link_node"]) or {}) if ifc["link_node"] else {}
        ifc["dial_src"] = _lr.get("dial_src") or ""
        ifc["dial_endpoint"] = _lr.get("dial_endpoint") or ""
        ifc["relay"] = _lr.get("relay") or {}
        _ukb = ov.get("key_blob") or {}
        if (ivk_pub and _ukb.get("ct") and not ov.get("system")
                and _ukb.get("pub") == (ov.get("public_key") or "") and _ukb.get("vault") != ivk_pub):
            ifc["escrow_unverified"] = {k: _ukb.get(k) for k in ("pub", "eph", "ct", "mac")}
        ifc["drift"] = dict(ov.get("_drift") or {})
        if ifc["drift"].get("public_key"):
            _bk = ifc.get("backup_public_key")
            if _bk:
                ifc["drift_restorable"] = (_bk == ov.get("public_key"))
            if ivk_pub and vault_restore_ok and _iface_key_source(ov, None, ivk_pub) == "vault":
                ifc["drift_key_blob"] = ov.get("key_blob")
        ovawg = ov.get("awg_params")
        if isinstance(ovawg, dict) and ovawg:
            rep_awg = dict(ifc.get("awg_params") or {})
            ifc["awg_reported"] = rep_awg
            ifc["awg_params"] = {**{k: v for k, v in rep_awg.items() if k not in AWG3_FIELDS},
                                 **{k: ovawg[k] for k in ovawg if ovawg[k] not in (None, "")}}
            if ov.get("awg_exact"):
                ifc["awg_params"] = {k: ovawg[k] for k in ovawg if ovawg[k] not in (None, "")}
                ifc["awg_exact"] = True
    return interfaces


def node_held_addrs(snap, node_rec=None):
    out = set()
    def add(v):
        for part in re.split(r"[,\s]+", v if isinstance(v, str) else ""):
            try:
                out.add(str(ipaddress.IPv4Address(part.split("/")[0])))
            except ValueError:
                pass
    snap = snap if isinstance(snap, dict) else {}
    for a in snap.get("node_ips") or []:
        add(a)
    for key in ("exits", "exit_candidates"):
        for e in snap.get(key) or []:
            add((e or {}).get("address") if isinstance(e, dict) else None)
    for e in ((node_rec or {}).get("exits") if isinstance(node_rec, dict) else None) or []:
        prof = e.get("profile") if isinstance(e, dict) else None
        add(prof.get("address") if isinstance(prof, dict) else None)
    return out


def panel_next_ip(snaps, roster, nodes, iface, node_store=None):
    used, subnet = set(), None
    for node in nodes:
        snap = snaps.get(node)
        if not snap:
            return err("next-ip", f"{node}: no snapshot yet (is the node online?)", "offline")
        blk = (snap.get("interfaces") or {}).get(iface)
        if not blk:
            return err("next-ip", f"{node} has no interface {iface!r}", "bad_request")
        used |= node_held_addrs(snap, (node_store or {}).get(node))
        meta = blk.get("meta") or {}
        for p in (blk.get("peers") or []):
            ip = (p.get("allowed_ips") or "").split("/")[0]
            if ip:
                used.add(ip)
        used.add((meta.get("address") or "").split("/")[0])
        if subnet is None:
            subnet = meta.get("subnet")
    for p in (roster.get("peers") or {}).values():
        if not isinstance(p, dict):
            continue
        for t in p.get("targets", []):
            if t.get("iface") == iface and t.get("ip"):
                used.add(t["ip"].split("/")[0])
    if not subnet:
        return err("next-ip", "no subnet info in snapshot")
    net = ipaddress.ip_network(subnet, strict=False)
    for host in net.hosts():
        if str(host) not in used:
            return {"ok": True, "op": "next-ip",
                    "data": {"iface": iface, "next_ip": str(host) + "/32", "subnet": subnet}}
    return err("next-ip", "no free addresses across selected nodes", "subnet_full")



def mesh_cfg(deps):
    f = deps.get("fleet") or {}
    r = (deps.get("panel_settings") or {}).get("reserved") or {}
    return {"subnet": r.get("mesh_subnet") or f.get("mesh_subnet", "10.255.0.0/16"), "mtu": int(f.get("mesh_mtu", 1280)),
            "keepalive": int(f.get("mesh_keepalive", 25)),
            "port_base": int(r.get("mesh_port_base") or f.get("mesh_port_base", 9999)),
            "port_span": int(r.get("port_span") or 100),
            "iface_prefix": (r.get("iface_prefix") or f.get("mesh_iface_prefix") or "swg_")}


def node_mesh_cfg(deps, node):
    mc = dict(mesh_cfg(deps)); n = node or {}
    if n.get("mesh_subnet"):
        mc["subnet"] = n["mesh_subnet"]
    if str(n.get("mesh_port") or "").strip().isdigit():
        mc["port_base"] = int(n["mesh_port"])
    if n.get("mesh_prefix"):
        mc["iface_prefix"] = n["mesh_prefix"]
    return mc


def is_system_iface(deps, nodes, node_id, iface):
    if not iface:
        return False
    n = nodes.get(node_id) or {}
    ov = (n.get("ifaces") or {}).get(iface)
    if isinstance(ov, dict) and ov.get("system"):
        return True
    pfx = node_mesh_cfg(deps, n).get("iface_prefix") or "swg_"
    return str(iface).startswith(pfx) or str(iface).startswith("swg_")


def reserved_conflict(deps, nodes, node, subnet=None, port=None, name=None, keep=()):
    mc = node_mesh_cfg(deps, node)
    prefix = mc.get("iface_prefix") or "swg_"
    if name and str(name).startswith(prefix):
        return f"names starting with '{prefix}' are reserved for system mesh links"
    if subnet:
        try:
            net = ipaddress.ip_network(subnet, strict=False)
        except Exception:
            net = None
        if net is not None:
            reserved = []
            with contextlib.suppress(Exception):
                reserved.append(ipaddress.ip_network(mc["subnet"], strict=False))
            for n in (nodes or {}).values():
                for lr in (n.get("links") or {}).values():
                    with contextlib.suppress(Exception):
                        ln = ipaddress.ip_network(lr.get("subnet"), strict=False)
                        reserved.append(ln.supernet(new_prefix=16) if ln.version == 4 and ln.prefixlen > 16 else ln)
            for rn in reserved:
                if net.version == rn.version and net.overlaps(rn):
                    return f"subnet overlaps the reserved system mesh range ({rn})"
    if port is not None and str(port).strip().isdigit():
        base = mc["port_base"]; span = mc.get("port_span", 100)
        if base <= int(port) < base + span:
            return f"port {port} is in the reserved system mesh range ({base}–{base + span - 1})"
        return p2p_pool_refusal(port, keep)
    return None


def _tunnel_networks(node):
    out = []
    for ifn, w in ((node or {}).get("wdtt") or {}).items():
        for nm, a in ((ifn, (w or {}).get("wg_addr")), (ifn + " (raw)", (w or {}).get("raw_addr"))):
            if a:
                with contextlib.suppress(ValueError, TypeError):
                    out.append((nm, ipaddress.ip_network(str(a), strict=False)))
    for ifn, c in ((node or {}).get("csqtt") or {}).items():
        if (c or {}).get("tun_addr"):
            with contextlib.suppress(ValueError, TypeError):
                out.append((ifn, ipaddress.ip_network(str(c["tun_addr"]), strict=False)))
    return out


def _fleet_user_networks(deps, nodes, skip_node=None, skip_iface=None):
    snaps = deps.get("node_snaps") or {}
    out = []
    for nid, node in (nodes or {}).items():
        snap = snaps.get(nid)
        if snap:
            with contextlib.suppress(Exception):
                for ifn, m in ((node_describe(snap).get("data") or {}).get("interfaces") or {}).items():
                    if (m or {}).get("system") or (nid == skip_node and ifn == skip_iface):
                        continue
                    with contextlib.suppress(Exception):
                        out.append((nid, ifn, ipaddress.ip_network((m or {}).get("subnet") or "", strict=False)))
        for nm, net in _tunnel_networks(node):
            if nid == skip_node and nm.split(" (raw)")[0] == skip_iface:
                continue
            out.append((nid, nm, net))
    return out


def subnet_fleet_conflict(deps, nodes, subnet, skip_node=None, skip_iface=None):
    try:
        net = ipaddress.ip_network(subnet, strict=False)
    except Exception:
        return None
    for nid, ifn, on in _fleet_user_networks(deps, nodes, skip_node, skip_iface):
        if net.version == on.version and net.overlaps(on):
            nm = ((nodes.get(nid) or {}).get("name") or nid)
            return "subnet overlaps %s on %s (%s) — interface subnets must be unique across the fleet" % (ifn, nm, on)
    return None


WDTT_RAW_PORT = 56003


def _wdtt_listen_ip(inst):
    ip = (inst or {}).get("listen") or ""
    ip = ip.rsplit(":", 1)[0].strip() if ":" in ip else ""
    return "" if ip in ("0.0.0.0", "::", "[::]") else ip


def _csqtt_default_fork():
    for fid, meta in TURN_SERVERS.items():
        if (meta or {}).get("kind") == "csqtt":
            return fid
    return "csqtt"


def _wdtt_alloc_raw_iface(nodes, nid, iface):
    taken = {(w or {}).get("raw_iface") for ifn, w in ((nodes.get(nid) or {}).get("wdtt") or {}).items() if ifn != iface}
    digits = re.sub(r"\D", "", iface or "")
    if digits and ("wdttraw" + digits) not in taken:
        return "wdttraw" + digits
    for n in range(1, 10000):
        if ("wdttraw%d" % n) not in taken:
            return "wdttraw%d" % n
    return ""


def _fork_raw_default(deps, fork):
    ps = deps.get("panel_settings") or {}
    per = ((ps.get("turn_server_defaults") or {}).get(fork) or {})
    if isinstance(per.get("raw"), bool):
        return per["raw"]
    return ps.get("wdtt_raw_default", True) is not False


def _wdtt_raw_holder(nodes, nid, ip, skip_iface=None):
    for ifn, w in ((nodes.get(nid) or {}).get("wdtt") or {}).items():
        if ifn == skip_iface or not isinstance(w, dict) or not w.get("raw_port"):
            continue
        wip = _wdtt_listen_ip(w)
        if wip == ip or not wip or not ip:
            return ifn
    return ""


def _wdtt_raw_clear_others(nodes, nid, ip, keep_iface):
    moved = ""
    for ifn, w in ((nodes.get(nid) or {}).get("wdtt") or {}).items():
        if ifn == keep_iface or not isinstance(w, dict) or not w.get("raw_port"):
            continue
        wip = _wdtt_listen_ip(w)
        if not (wip == ip or not wip or not ip):
            continue
        moved = moved or ifn
        for k in ("raw_port", "raw_iface", "raw_addr"):
            w.pop(k, None)
    return moved


def _wdtt_alloc_raw_subnet(deps, nodes, nid, iface):
    for third in range(0, 256):
        cand = "10.70.%d.1/24" % third
        if not subnet_fleet_conflict(deps, nodes, cand, skip_node=nid, skip_iface=iface):
            return cand
    return ""


DEFAULT_AWG_GEN = "3.1"
AWG31_MIN_S = 12
AWG31_MAX_S = 20
AWG31_HEADERS = {"H1": 1, "H2": 2, "H3": 3, "H4": 4}


def gen_awg_params(gen=DEFAULT_AWG_GEN, s_max=AWG31_MAX_S):
    if gen == "3.1":
        s = AWG31_MIN_S + secrets.randbelow(min(AWG31_MAX_S, s_max) - AWG31_MIN_S + 1)
        return {"Jc": 4 + secrets.randbelow(3), "Jmin": 40, "Jmax": 70,
                "S1": s, "S2": s, "S3": s, "S4": s, **AWG31_HEADERS}
    s1 = 15 + random.randint(0, 135); s2 = 15 + random.randint(0, 135)
    while s2 == s1 or s2 == s1 + 56:
        s2 = 15 + random.randint(0, 135)
    s3 = 15 + random.randint(0, 85); s4 = 15 + random.randint(0, 85)
    b = [base + random.randint(0, 899999999) for base in (5, 1000000000, 2000000000, 3000000000)]
    w = 15
    return {"Jc": 4, "Jmin": 40, "Jmax": 70, "S1": s1, "S2": s2, "S3": s3, "S4": s4,
            "H1": f"{b[0]}-{b[0]+w}", "H2": f"{b[1]}-{b[1]+w}", "H3": f"{b[2]}-{b[2]+w}", "H4": f"{b[3]}-{b[3]+w}",
            "I1": "<b 0xc000000001><r 64><t>", "I2": "<r 24><t>", "I3": "<r 32>",
            "I4": "<b 0xc000000001><r 32><t>", "I5": "<t><r 48>"}


AWG_FIELDS = ("Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4", "H1", "H2", "H3", "H4",
              "I1", "I2", "I3", "I4", "I5",
              "HeaderProtectionKey", "RandomTrailers", "ContentPaddingAddition", "RekeyAfterTime", "RekeyTimeout",
              "RejectAfterTime", "KeepaliveTimeout", "MaxHandshakeAttempts", "DisableCookies")
AWG3_FIELDS = AWG_FIELDS[AWG_FIELDS.index("HeaderProtectionKey"):]


def awg2_profile(params, replace_standard_headers, previous=None):
    out = {k: v for k, v in params.items() if k not in AWG3_FIELDS}
    if replace_standard_headers and out:
        standard = {k: (str(i), f"{i}-{i}") for k, i in AWG31_HEADERS.items()}
        if all(str(out.get(k, ids[0])).replace(" ", "") in ids for k, ids in standard.items()):
            previous = previous or {}
            assigned = not previous.get("HeaderProtectionKey") and all(
                k in previous and str(previous[k]).replace(" ", "") not in ids for k, ids in standard.items())
            legacy = previous if assigned else gen_awg_params("2.0")
            out.update({k: legacy[k] for k in AWG31_HEADERS})
    return out


def sanitize_awg_params(raw, gen3=False):
    if not isinstance(raw, dict):
        return {}
    out = {}
    for k in AWG_FIELDS:
        v = raw.get(k)
        if v is None or str(v).strip() in ("", AWG_OMIT) or (k in AWG3_FIELDS and not gen3):
            continue
        out[k] = str(v).strip()
    return out


AWG_OMIT = "-"


def awg_template(raw, gen3=False):
    if not isinstance(raw, dict):
        return {}, frozenset()
    om = frozenset(k for k in AWG_FIELDS if k != "DisableCookies" and (gen3 or k not in AWG3_FIELDS)
                   and str(raw.get(k) if raw.get(k) is not None else "").strip() == AWG_OMIT)
    return sanitize_awg_params(raw, gen3), om


def awg_template_clean(raw, gen3=False):
    vals, om = awg_template(raw, gen3)
    return {k: (AWG_OMIT if k in om else vals[k]) for k in AWG_FIELDS if k in vals or k in om}


def awg_exact_reported(snap):
    return _awg_datapath(snap).get("exact") == 1


def awg_exact_refusal(snap, name):
    if awg_exact_reported(snap):
        return None
    return perr("{v1} cannot hold an empty AmneziaWG field yet — it is offline or needs an update", v1=name)


def awg_rules(d, where="", gen3=None):
    if not any(k in d for k in AWG_FIELDS):
        return perr("{v1} would have no AmneziaWG field left — make it a WireGuard interface instead", v1=where)
    if gen3 and not any(k in d for k in AWG3_FIELDS):
        return perr("{v1} would have no AmneziaWG 3.1 field left — switch it to AmneziaWG 2.0 instead", v1=where)
    if len([k for k in ("Jc", "Jmin", "Jmax") if k in d]) not in (0, 3):
        return perr("{v1}: Jc, Jmin and Jmax go together — set all three, or all three to none", v1=where)
    if "HeaderProtectionKey" in d and not all(k in d for k in ("S1", "S2", "S3", "S4")):
        return perr("{v1}: header protection needs S1–S4 — {v2} cannot be none while it is on", v1=where,
                    v2=", ".join(k for k in ("S1", "S2", "S3", "S4") if k not in d))
    if str(d.get("S1", "")).strip().isdigit() and str(d.get("S2", "")).strip().isdigit() \
            and int(str(d["S1"]).strip()) + 56 == int(str(d["S2"]).strip()):
        return perr("{v1}: S2 must not be S1 + 56 — the two handshake messages would be the same size", v1=where)
    return None


AWG_I_KEYS = ("I1", "I2", "I3", "I4", "I5")
AWG_I_TAG_MAX, AWG_I_LINE_MAX, AWG_I_UDP_MAX = 1000, 4096, 65507
_AWG_I_TAG = re.compile(r"<([a-z]+)(?: ([^<>]*))?>")
_AWG_BAD_CHAR = re.compile(r"[^\x20-\x7e]")


def _awg_trim(v):
    return ("" if v is None else str(v)).strip(" \t\n\r\f\v")


def awg_i_check(v):
    s = _awg_trim(v)
    if _AWG_BAD_CHAR.search(s):
        return False, 0, "ctl", ""
    if s in ("", AWG_OMIT):
        return True, 0, "", ""
    if len(s) > AWG_I_LINE_MAX:
        return False, 0, "long", ""
    n = t = 0
    rest = s
    while True:
        rest = rest.lstrip(" ")
        if not rest:
            return (False, 0, "huge", "") if n > AWG_I_UDP_MAX else (True, n, "", "")
        m = _AWG_I_TAG.match(rest)
        if not m:
            mm = re.match(r"<[^>]*>?", rest)
            return False, 0, "tag", mm.group(0) if mm else rest[:16]
        name, arg = m.group(1), m.group(2)
        rest = rest[m.end():]
        if name == "c":
            return False, 0, "c", m.group(0)
        if name == "t" and arg is None:
            t += 1
            if t > 1:
                return False, 0, "t2", m.group(0)
            n += 4
            continue
        if name == "b" and arg is not None and re.fullmatch(r"0x(?:[0-9a-fA-F]{2})+", arg):
            n += (len(arg) - 2) // 2
            continue
        if name in ("r", "rc", "rd") and arg is not None and re.fullmatch(r"[0-9]+", arg):
            if int(arg) > AWG_I_TAG_MAX:
                return False, 0, "big", m.group(0)
            n += int(arg)
            continue
        return False, 0, "tag", m.group(0)


def awg_i_refusal(key, v):
    ok, _n, why, tag = awg_i_check(v)
    if ok:
        return None
    if why == "big":
        return perr("{v1}: a random part is at most 1000 bytes — split it, like <r 1000><r 214>.", v1=key)
    if why == "c":
        return perr("{v1}: <c> is gone from AmneziaWG 3.x, and apps refuse the whole config.", v1=key)
    if why == "t2":
        return perr("{v1}: <t> appears twice — once per packet at most.", v1=key)
    if why == "ctl":
        return perr("{v1}: holds a character apps cannot read — a line break, a tab, or anything outside plain ASCII.", v1=key)
    if why == "huge":
        return perr("{v1}: more than one UDP packet can carry (65,507 bytes).", v1=key)
    if why == "long":
        return perr("{v1}: longer than 4096 characters.", v1=key)
    return perr("{v1}: apps cannot read {v2} — use <b 0x…>, <r N>, <rc N>, <rd N> or <t>.", v1=key, v2=tag)


def awg_value_refusal(key, v):
    if key in AWG_I_KEYS:
        return awg_i_refusal(key, v)
    if _AWG_BAD_CHAR.search(_awg_trim(v)):
        return perr("{v1}: holds a character apps cannot read — a line break, a tab, or anything outside plain ASCII.", v1=key)
    return None


AWG31_SET = {"RandomTrailers": "1", "ContentPaddingAddition": "2-10", "RekeyAfterTime": "100-120", "RekeyTimeout": "3-7",
             "RejectAfterTime": "150-180", "KeepaliveTimeout": "5-15", "MaxHandshakeAttempts": "15-20"}
_AWG3_RANGED = ("ContentPaddingAddition", "RekeyAfterTime", "RekeyTimeout", "RejectAfterTime", "KeepaliveTimeout",
                "MaxHandshakeAttempts")


def awg_template_refusal(raw, where, gen3=False, was=None):
    vals, om = awg_template(raw, gen3)
    _was = awg_template(was, gen3)[0]
    for k, v in vals.items():
        if v != _was.get(k):
            _b = awg_value_refusal(k, v)
            if _b:
                return _b
    trio = [k in om for k in ("Jc", "Jmin", "Jmax")]
    if any(trio) and not all(trio):
        return perr("{v1}: Jc, Jmin and Jmax go together — set all three, or all three to none", v1=where)
    if all(k in om for k in AWG_FIELDS if k not in AWG3_FIELDS):
        return perr("{v1}: every AmneziaWG field is none — leave at least one, or use WireGuard interfaces", v1=where)
    return None


def mesh_template(deps, node):
    pv, pom = awg_template((deps.get("panel_settings") or {}).get("mesh_awg"))
    v, om = awg_template((node or {}).get("mesh_awg"))
    if not (v or om):
        return pv, pom
    return ({k: (v[k] if k in v else pv[k]) for k in AWG_FIELDS if k in v or (k in pv and k not in om)},
            frozenset(om | (pom - set(v))))


def mesh_omit_s_refusal(gen, om, where):
    if gen == "3.1" and any(k in om for k in ("S1", "S2", "S3", "S4")):
        return perr("{v1}: AmneziaWG 3.1 links need S1–S4 for header protection — the mesh AWG params set {v2} to none",
                    v1=where, v2=", ".join(k for k in ("S1", "S2", "S3", "S4") if k in om))
    return None


def awg3_defaults(deps):
    a = (((deps.get("panel_settings") or {}).get("interface_defaults") or {}).get("awg3_params")) or {}
    return {k: str(a[k]).strip() for k in _AWG3_RANGED if isinstance(a, dict) and a.get(k) not in (None, "")
            and str(a[k]).strip() not in ("", AWG_OMIT)}


def awg3_omitted(deps):
    a = (((deps.get("panel_settings") or {}).get("interface_defaults") or {}).get("awg3_params")) or {}
    return frozenset(k for k in _AWG3_RANGED if isinstance(a, dict) and str(a.get(k) if a.get(k) is not None else "").strip() == AWG_OMIT)


def awg3_left_out(rec, was=None):
    rec = rec if isinstance(rec, dict) else {}
    was = rec if was is None else was if isinstance(was, dict) else {}
    return (frozenset(k for k in _AWG3_RANGED if not str(rec.get(k) or "").strip())
            if str(was.get("HeaderProtectionKey") or "").strip() else frozenset())


def awg3_template_clean(raw):
    a = {k: str(raw[k]).strip() for k in _AWG3_RANGED if isinstance(raw, dict) and raw.get(k) is not None and str(raw[k]).strip()}
    om = [k for k in a if a[k] == AWG_OMIT]
    ac, err = awg3_check({**{k: v for k, v in AWG31_SET.items() if k not in om}, **{k: v for k, v in a.items() if k not in om}})
    if err:
        return None, err
    return {k: (AWG_OMIT if k in om else ac[k]) for k in a if k in om or k in ac}, None


def mesh_template_clean(raw):
    d3, err = awg3_template_clean(raw)
    if err:
        return None, err
    return {**awg_template_clean(raw), **d3}, None


def mesh_awg3_refusal(deps, node):
    v3, om3 = mesh_awg3(deps, node)
    return awg3_check({**{k: v for k, v in AWG31_SET.items() if k not in om3}, **v3})[1]


def mesh_awg3(deps, node):
    vals, om = {}, set()
    layers = [(node or {}).get("mesh_awg"), (deps.get("panel_settings") or {}).get("mesh_awg")]
    d3, o3 = awg3_defaults(deps), awg3_omitted(deps)
    for k in _AWG3_RANGED:
        for raw in layers:
            v = str(raw.get(k) if isinstance(raw, dict) and raw.get(k) is not None else "").strip()
            if v:
                (om.add(k) if v == AWG_OMIT else vals.__setitem__(k, v))
                break
        else:
            if k in d3:
                vals[k] = d3[k]
            elif k in o3:
                om.add(k)
    return vals, frozenset(om)


def awg3_full(base, reported=None, defaults=None, omit=(), s_max=AWG31_MAX_S):
    fresh = gen_awg_params("3.1", s_max)
    d = {k: str(v).strip() for k, v in {**fresh, **(reported or {}), **(base or {})}.items()
         if k in AWG_FIELDS and k != "DisableCookies" and k not in omit and v is not None and str(v).strip() != ""}
    for k, v in {**AWG31_SET, **{k: v for k, v in (defaults or {}).items() if k in _AWG3_RANGED}}.items():
        if k not in omit:
            d.setdefault(k, v)
    if "HeaderProtectionKey" not in omit and "HeaderProtectionKey" not in d:
        d["HeaderProtectionKey"] = base64.b64encode(os.urandom(32)).decode()
    _ss = [k for k in ("S1", "S2", "S3", "S4") if k not in omit]
    if any(not d.get(k, "").isdigit() or int(d[k]) < AWG31_MIN_S for k in _ss):
        d.update({k: str(fresh[k]) for k in _ss})
    return d


def awg3_check(d):
    out = dict(d)
    for k in ("RandomTrailers", "DisableCookies"):
        if k in out:
            v = str(out[k]).strip().lower()
            if v in ("1", "on", "true", "yes"):
                out[k] = "1"
            elif v in ("0", "off", "false", "no"):
                out.pop(k)
            else:
                return None, perr("{v1} must be on or off", v1=k)
    for k in _AWG3_RANGED:
        if k in out:
            m = re.fullmatch(r"\s*(\d+)\s*(?:-\s*(\d+)\s*)?", str(out[k]))
            if not m or (m.group(2) and int(m.group(1)) > int(m.group(2))):
                return None, perr("{v1} must be a number or a range like 10-100", v1=k)
            out[k] = m.group(1) + ("-" + m.group(2) if m.group(2) else "")
            if out[k] == "0":
                out.pop(k)
    if "HeaderProtectionKey" in out:
        try:
            _hk = base64.b64decode(str(out["HeaderProtectionKey"]).strip(), validate=True)
            _ok = len(_hk) == 32 and any(_hk)
        except Exception:
            _ok = False
        if not _ok:
            return None, perr("HeaderProtectionKey must be a 32-byte key in base64, not all zeros")
        low = [k for k in ("S1", "S2", "S3", "S4") if not str(out.get(k, "")).strip().isdigit() or int(str(out[k]).strip()) < 12]
        if low:
            return None, perr("{v1} must be 12 or more while header protection is on", v1=", ".join(low))
    if any(k in out for k in ("RekeyAfterTime", "RekeyTimeout", "RejectAfterTime", "KeepaliveTimeout")):
        hi = lambda k, dflt: int(str(out.get(k, dflt)).split("-")[-1])
        lo = int(str(out.get("RejectAfterTime", 180)).split("-")[0])
        tot = hi("RekeyAfterTime", 120) + hi("RekeyTimeout", 5) + hi("KeepaliveTimeout", 10)
        if tot > lo:
            return None, perr("RekeyAfterTime + RekeyTimeout + KeepaliveTimeout (up to {v1} s) must not exceed "
                              "RejectAfterTime ({v2} s at least) — the node would drop data a client still sends",
                              v1=tot, v2=lo)
    return out, None


def awg_gen_reported(snap):
    return isinstance(_awg_datapath(snap).get("gen"), dict)


def awg_gen_refusal(snap, name, iface=None):
    if not awg_gen_reported(snap):
        return perr("{v1}: this node does not report its AmneziaWG version — update it", v1=name)
    g = {k: v for k, v in _awg_datapath(snap)["gen"].items() if isinstance(v, str)}
    order = {"2.0": 0, "3.0": 1, "3.1": 2}
    on_fallback = bool(iface) and iface in (_awg_datapath(snap).get("userspace") or [])
    if g.get("module") and not on_fallback and order.get(g.get("module"), -1) < 2:
        if awg_loadable(snap):
            return perr("{v1}: AmneziaWG 3.1 is installed, but the kernel module in use is still {v2} — load it now, or it "
                        "loads at the next reboot if the kernel accepts it; the node page says why when it does not",
                        v1=name, v2=g.get("module"))
        if _awg_31_waiting(snap):
            return perr("{v1}: AmneziaWG 3.1 is installed, but the kernel module in use is still {v2} — it loads at the next "
                        "reboot if the kernel accepts it (the node page says why when it does not). It cannot be loaded now: "
                        "this node has no userspace AmneziaWG (amneziawg-go) to run its interfaces on if the new module did "
                        "not load", v1=name, v2=g.get("module"))
        return perr("{v1}: its AmneziaWG kernel module is {v2} — an AmneziaWG 3.1 interface needs 3.1", v1=name,
                    v2=g.get("module"))
    if (not g.get("module") or on_fallback) and order.get(g.get("fallback"), -1) < 2:
        return perr("{v1}: its userspace AmneziaWG (amneziawg-go), which this interface would run on, is {v2} — an "
                    "AmneziaWG 3.1 interface needs 3.1", v1=name, v2=g.get("fallback") or "none")
    if order.get(g.get("tools"), -1) < 2:
        return perr("{v1}: its awg tools are AmneziaWG {v2} — an AmneziaWG 3.1 interface needs 3.1", v1=name,
                    v2=g.get("tools") or "none")
    return None



def _awg_31_waiting(snap):
    if not awg_gen_reported(snap) or (snap.get("kind") == "docker"):
        return False
    g = {k: v for k, v in _awg_datapath(snap)["gen"].items() if isinstance(v, str)}
    return g.get("disk") == "3.1" and g.get("module") in ("2.0", "3.0") and g.get("tools") == "3.1"


def awg_loadable(snap):
    return _awg_31_waiting(snap) and isinstance(_awg_datapath(snap)["gen"].get("fallback"), str)


def _awg_int(v):
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return 0


AWG_LOAD_LOST_S = 660


def awg_load_status(node, snap, name, now=None):
    req = node.get("awg_load") if isinstance(node.get("awg_load"), dict) else {}
    try:
        n, at = int(req.get("n") or 0), float(req.get("at") or 0)
    except (TypeError, ValueError):
        return None
    if n <= 0:
        return None
    now = now or time.time()
    age = max(0, int(now - at))
    got = _awg_datapath(snap).get("load") if isinstance(_awg_datapath(snap).get("load"), dict) else {}
    pid = "%d:%d" % (n, int(at))
    if (str(got.get("id")) != pid) if got.get("id") else (_awg_int(got.get("n")) != n):
        if now - at > AWG_LOAD_LOST_S:
            return {"n": n, "age": age, "state": "lost", "msg": perr("{v1} has not answered the request to load the AmneziaWG module — it "
                                                         "may be offline, or on a version without it", v1=name)}
        return {"n": n, "age": age, "state": "pending"}
    ifs = got.get("ifaces") if isinstance(got.get("ifaces"), dict) else {}
    us = sorted(k for k, v in ifs.items() if v == "userspace"); dn = sorted(k for k, v in ifs.items() if v == "down")
    code, ver = str(got.get("code") or ""), str(got.get("loaded") or "")
    if got.get("ok") and not us and not dn:
        msg = perr("{v1}: AmneziaWG {v2} is loaded — every AmneziaWG interface is back on the kernel module", v1=name, v2=ver)
    elif got.get("ok"):
        msg = perr("{v1}: AmneziaWG {v2} is loaded, but not every interface came back on it — on the userspace fallback: "
                   "{v3}; down: {v4}", v1=name, v2=ver, v3=", ".join(us) or "—", v4=", ".join(dn) or "—")
    elif code == "load_failed" and not dn:
        msg = perr("{v1}: the new AmneziaWG module did not load — its interfaces run on the userspace fallback until the "
                   "next reboot", v1=name)
    elif code == "load_failed":
        msg = perr("{v1}: the new AmneziaWG module did not load — on the userspace fallback: {v2}; down: {v3}", v1=name,
                   v2=", ".join(us) or "—", v3=", ".join(dn))
    elif code == "busy":
        msg = perr("{v1}: the AmneziaWG module could not be unloaded — every interface was brought back as it was", v1=name)
    elif code == "tools_old":
        msg = perr("{v1}: nothing was changed — its awg tools cannot drive the new module", v1=name)
    elif code == "no_way_back":
        msg = perr("{v1}: nothing was changed — nothing would bring back {v2}", v1=name,
                   v2=str(got.get("error") or "").split(": ", 1)[-1][:200])
    elif code == "cannot_record":
        msg = perr("{v1}: nothing was changed — the node could not record the request (its state directory is not writable)",
                   v1=name)
    elif code == "cannot_check":
        msg = perr("{v1}: nothing was changed — the node cannot check its other network namespaces (lsns or nsenter is "
                   "missing)", v1=name)
    elif code == "other_netns":
        msg = perr("{v1}: nothing was changed — an AmneziaWG device lives in another network namespace", v1=name)
    elif code == "nothing_newer":
        msg = perr("{v1}: nothing was changed — the installed module is not newer than the one in use", v1=name)
    elif code == "no_fallback":
        msg = perr("{v1}: nothing was changed — this node has no userspace AmneziaWG (amneziawg-go) to fall back on if the new "
                   "module did not load", v1=name)
    else:
        msg = perr("{v1}: the AmneziaWG module was not loaded — {v2}", v1=name, v2=str(got.get("error") or code)[:200])
    return {"n": n, "age": age, "state": ("partial" if us or dn else "done") if got.get("ok") else "failed", "msg": msg}

def awg31_rendered(rec, rep):
    d = rec if isinstance(rec, dict) and rec else (rep if isinstance(rep, dict) else {})
    return bool(str(d.get("HeaderProtectionKey") or "").strip())


def turn_awg3_blockers(deps, nodes, nid, ports):
    ports = {str(p) for p in ports if str(p or "").strip().isdigit()}
    rep = {tp.get("service"): tp for tp in ((((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies")) or [])
           if isinstance(tp, dict) and tp.get("service")}
    pend = {s: r for s, r in (((nodes.get(nid) or {}).get("turn")) or {}).items() if isinstance(r, dict)}
    out = []
    for svc in sorted(set(rep) | set(pend)):
        req, tp = pend.get(svc) or {}, rep.get(svc) or {}
        if not ports or (TURN_SERVERS.get(turn_fork(svc)) or {}).get("awg3", True):
            continue
        conns = [tp.get("connect") or ""] + ([req["connect"]] if req.get("action") in ("install", "manage") and req.get("connect") else [])
        hit = [c for c in conns if _port_of(c) in ports]
        if hit:
            out.append({"service": svc, "title": req.get("title") or tp.get("title") or "", "connect": hit[0],
                        "fork": turn_fork(svc)})
    return out


def turn_listen_now(deps, nid, svc):
    v = (((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies"))
    return next((str(tp.get("listen") or "") for tp in (v if isinstance(v, list) else ()) if isinstance(tp, dict) and tp.get("service") == svc), "")


def turn_connect_now(deps, nodes, nid, svc):
    req = (((nodes.get(nid) or {}).get("turn")) or {}).get(svc) or {}
    if req.get("action") in ("install", "manage") and req.get("connect"):
        return req["connect"]
    for tp in ((((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies")) or []):
        if isinstance(tp, dict) and tp.get("service") == svc:
            return tp.get("connect") or ""
    return ""


def _turn_awg3_app(fork):
    return ", ".join(sorted((TURN_CLIENTS.get(c) or {}).get("name") or c
                            for c, cls in (_TURN_CLIENT_COMPAT.get(fork) or {}).items() if cls == "native")) or fork


def turn_awg3_refusal(blockers, iface):
    names = "; ".join("%s (%s · %s)" % (b["title"] or b["service"], (TURN_SERVERS.get(b["fork"]) or {}).get("label")
                                         or b["fork"], _turn_awg3_app(b["fork"])) for b in blockers)
    return perr("{v1} cannot run AmneziaWG 3.1 while a turn proxy whose app carries AmneziaWG 2.0 only points at its port: "
                "{v2}. Point it at a 2.0 interface, or delete it, and try again once the node has applied that", v1=iface, v2=names)


def turn_awg3_target(deps, nodes, nid, fork, connect):
    if (TURN_SERVERS.get(fork) or {}).get("awg3", True):
        return None
    port = _port_of(connect)
    snap = (deps.get("node_snaps") or {}).get(nid) or {}
    recs = (nodes.get(nid) or {}).get("ifaces") or {}
    made = (nodes.get(nid) or {}).get("create") or {}
    for ifn in sorted(set(snap.get("interfaces") or {}) | set(recs)):
        meta = ((snap.get("interfaces") or {}).get(ifn) or {}).get("meta") or {}
        ov, mk = recs.get(ifn) or {}, made.get(ifn) or {}
        if port and port in (str(meta.get("listen_port") or ""), str(ov.get("listen_port") or ""), str(mk.get("listen_port") or "")) \
                and awg31_rendered(ov.get("awg_params") or mk.get("awg_params"), meta.get("awg_params")):
            return perr("{v1} proxies cannot point at {v2}: it runs AmneziaWG 3.1, and their app ({v3}) carries AmneziaWG 2.0 "
                        "only — point it at a 2.0 interface", v1=(TURN_SERVERS.get(fork) or {}).get("label") or fork, v2=ifn,
                        v3=_turn_awg3_app(fork))
    return None


MESH_AWG_GENS = ("2.0", "3.1", "wg")
MESH_LINK_KEEP = ("relay", "dial_endpoint", "dial_src")


def mesh_gen_of(deps):
    g = str((deps.get("panel_settings") or {}).get("mesh_awg_gen") or "")
    return g if g in MESH_AWG_GENS else DEFAULT_AWG_GEN


def mesh_link_cfg(nodes, a, b):
    x, y = (a, b) if a < b else (b, a)
    c = ((nodes.get(x) or {}).get("mesh_link") or {}).get(y)
    return c if isinstance(c, dict) else {}


def mesh_link_cfg_put(nodes, a, b, **kv):
    x, y = (a, b) if a < b else (b, a)
    m = nodes[x].get("mesh_link") if isinstance(nodes[x].get("mesh_link"), dict) else {}
    c = dict(m.get(y) or {})
    for k, v in kv.items():
        if v:
            c[k] = v
        else:
            c.pop(k, None)
    if c:
        m[y] = c
    else:
        m.pop(y, None)
    if m:
        nodes[x]["mesh_link"] = m
    else:
        nodes[x].pop("mesh_link", None)


def mesh_link_override(nodes, a, b):
    g = str(mesh_link_cfg(nodes, a, b).get("type") or "")
    return g if g in MESH_AWG_GENS else ""


def mesh_gen_for(deps, nodes, a, b):
    return mesh_link_override(nodes, a, b) or mesh_gen_of(deps)


def mesh_pair_name(nodes, a, b):
    x, y = (a, b) if a < b else (b, a)
    return "%s ↔ %s" % ((nodes.get(x) or {}).get("name") or x, (nodes.get(y) or {}).get("name") or y)


def mesh_link_awg_set(nodes, a, b):
    t = mesh_link_cfg(nodes, a, b).get("awg")
    return t if isinstance(t, dict) else {}


def mesh_link_layer(nodes, a, b):
    return {"mesh_awg": mesh_link_awg_set(nodes, a, b)}




def mesh_link_extras(lr):
    lr = lr if isinstance(lr, dict) else {}
    kv = {}
    for k in MESH_LINK_KEEP:
        if k == "relay":
            if isinstance(lr.get("relay"), dict) and lr["relay"].get("mode") == "relay":
                kv["relay"] = lr["relay"]
        elif str(lr.get(k) or "").strip():
            kv[k] = str(lr[k]).strip()
    return kv


def mesh_link_park(nodes, who, other, park=True, now=None):
    n = nodes.get(who) or {}
    lr = (n.get("links") or {}).get(other)
    if lr is None:
        return
    kv = mesh_link_extras(lr) if park and other in nodes else {}
    if kv:
        n.setdefault("link_keep", {})[other] = kv
    ifc = (lr if isinstance(lr, dict) else {}).get("iface")
    if ifc:
        (n.get("create") or {}).pop(ifc, None)
        n.setdefault("delete", {})[ifc] = {"at": int(now or time.time())}
        (n.get("ifaces") or {}).pop(ifc, None)
    n["links"].pop(other, None)


def mesh_link_unpark(nodes, who, other, *keys):
    kp = (nodes.get(who) or {}).get("link_keep") or {}
    for k in keys:
        (kp.get(other) or {}).pop(k, None)
    if other in kp and not kp[other]:
        kp.pop(other)
    if "link_keep" in (nodes.get(who) or {}) and not kp:
        nodes[who].pop("link_keep")


def mesh_relink_pair(nodes, a, b):
    x = a if a < b else b
    nodes[x]["mesh_gen"] = int(nodes[x].get("mesh_gen") or 0) + 1
    mesh_link_park(nodes, a, b)
    mesh_link_park(nodes, b, a)


def mesh_link_gen(node, lr):
    if (lr or {}).get("proto") == "wg":
        return "wg"
    p = (((node or {}).get("ifaces") or {}).get((lr or {}).get("iface")) or {}).get("awg_params") or {}
    return "3.1" if str(p.get("HeaderProtectionKey") or "").strip() else "2.0"


def mesh_31_refusal(deps, nodes, snaps, a, b, mtu):
    for nid in (a, b):
        why = awg_gen_refusal((snaps or {}).get(nid), (nodes.get(nid) or {}).get("name") or nid)
        if why:
            return why
    if (mesh_s4_room(mtu) or 0) < 12:
        return perr("the mesh MTU ({v1}) is too high for AmneziaWG 3.1 — header protection needs a link MTU of 1428 or less",
                    v1=mtu)
    _t3 = mesh_awg3_refusal(deps, mesh_link_layer(nodes, a, b))
    if _t3:
        return _t3
    _om = mesh_template(deps, mesh_link_layer(nodes, a, b))[1]
    if any(k in _om for k in ("S1", "S2", "S3", "S4")) and all(awg_exact_reported((snaps or {}).get(x)) for x in (a, b)):
        return mesh_omit_s_refusal("3.1", _om, mesh_pair_name(nodes, a, b))
    return None


def mesh_types_in_play(deps, nodes):
    ps = deps.get("panel_settings") or {}
    if ps.get("mesh_awg_gen") or (isinstance(ps.get("mesh_awg"), dict) and AWG_OMIT in ps["mesh_awg"].values()):
        return True
    if any(isinstance(c, dict) and (c.get("type") or (isinstance(c.get("awg"), dict) and AWG_OMIT in c["awg"].values()))
           for n in nodes.values() if isinstance(n, dict) and isinstance(n.get("mesh_link"), dict)
           for c in n["mesh_link"].values()):
        return True
    return any(mesh_link_partial(ov) for n in nodes.values() if isinstance(n, dict)
               for ov in (n.get("ifaces") or {}).values() if isinstance(ov, dict) and ov.get("system"))


_MESH_MUST = ("S1", "S2", "H1", "H2", "H3", "H4")


def mesh_link_partial(ov):
    p = (ov or {}).get("awg_params") if isinstance(ov, dict) else None
    if not isinstance(p, dict) or not p or ov.get("awg_exact"):
        return []
    return [k for k in _MESH_MUST if k not in p]


MESH_GEN_LABEL = {"wg": "WG", "2.0": "AWG 2.0", "3.1": "AWG 3.1"}


def _mesh_relink_how(deps, nodes, a, b, want):
    lbl = MESH_GEN_LABEL.get(want, want)
    if not mesh_link_override(nodes, a, b):
        return perr("to rebuild this link alone, pick {v1} as its type on its card under Node connections and Save", v1=lbl)
    if mesh_gen_of(deps) == want:
        return perr("to rebuild this link alone, pick Default as its type on its card under Node connections and Save")
    return perr("to rebuild this link alone, pick Default as its type on its card under Node connections and Save, then {v1} "
                "and Save again", v1=lbl)


def mesh_gen_reasons(deps, nodes, snaps, nid):
    me = nodes.get(nid) or {}
    mtu = mesh_cfg(deps)["mtu"]
    out = []
    for peer, lr in sorted((me.get("links") or {}).items()):
        if peer not in nodes or not isinstance(lr, dict):
            continue
        want, have = mesh_gen_for(deps, nodes, nid, peer), mesh_link_gen(me, lr)
        row = {"peer": (nodes.get(peer) or {}).get("name") or peer, "iface": lr.get("iface") or "", "type": have, "want": want}
        _miss = mesh_link_partial((me.get("ifaces") or {}).get(lr.get("iface")))
        if _miss:
            out.append(dict(row, msg=perr("made from part of a template — {v1} missing, so this link may not handshake, or runs "
                                          "without those lines (plain WireGuard on the wire); {v2}", v1=", ".join(_miss),
                                          v2=_mesh_relink_how(deps, nodes, nid, peer, want))))
        elif want != have:
            why = mesh_31_refusal(deps, nodes, snaps, nid, peer, mtu) if (want, have) == ("3.1", "2.0") else None
            out.append(dict(row, msg=why or perr("it should be {v1}, but a link keeps the type it was made with until it is "
                                                 "rebuilt — {v2}", v1=MESH_GEN_LABEL.get(want, want),
                                                 v2=_mesh_relink_how(deps, nodes, nid, peer, want))))
        elif have != "wg":
            _ly = mesh_link_layer(nodes, nid, peer)
            _om = mesh_template(deps, _ly)[1] | (mesh_awg3(deps, _ly)[1] if have == "3.1" else frozenset())
            _p = ((me.get("ifaces") or {}).get(lr.get("iface")) or {}).get("awg_params") or {}
            _kept = [k for k in AWG_FIELDS if k in _om and k in _p]
            if _kept:
                _cant = [(nodes.get(y) or {}).get("name") or y for y in sorted((nid, peer))
                         if not awg_exact_reported((snaps or {}).get(y))]
                out.append(dict(row, msg=perr("{v1} has generated values: {v2} cannot hold an empty AmneziaWG field yet — it "
                                              "is offline or needs an update", v1=", ".join(_kept), v2=", ".join(_cant))
                                if _cant else perr("{v1} has generated values where its AWG params say none — a link keeps "
                                                   "the values it was made with until it is rebuilt; {v2}", v1=", ".join(_kept),
                                                   v2=_mesh_relink_how(deps, nodes, nid, peer, want))))
    return out


MESH_WIRE_OVERHEAD = 60


def mesh_s4_room(mtu):
    try:
        return max(0, 1500 - MESH_WIRE_OVERHEAD - int(mtu))
    except (TypeError, ValueError):
        return None


def mesh_s4_fits(s4, mtu):
    room = mesh_s4_room(mtu)
    try:
        return room is None or int(str(s4).strip()) <= room
    except (TypeError, ValueError):
        return True


def mesh_s4_draw(mtu, floor=0):
    room = mesh_s4_room(mtu) or 0
    lo = max(floor, min(15, room))
    return random.randint(lo, max(lo, room))


def awg_set_s4(awg, s4):
    fields = ("S1", "S2", "S3", "S4")
    if awg.get("HeaderProtectionKey") and len({str(awg.get(k)) for k in fields}) == 1:
        awg.update(dict.fromkeys(fields, s4))
    else:
        awg["S4"] = s4


def _link_iface_name(node, link_id, prefix="swg_"):
    existing = {lr.get("iface") for lr in (node.get("links") or {}).values()}
    existing |= set(node.get("delete") or {})
    for i in range(0, len(link_id) - 8 + 1):
        nm = prefix + link_id[i:i + 8]
        if nm not in existing:
            return nm
    return prefix + link_id[:8]


def _used_ports(nodes, snaps, nid):
    return set(_node_ports({"node_snaps": snaps or {}}, nodes, nid)) | {WDTT_RAW_PORT} | _host_listen((snaps or {}).get(nid))


def exit_is_dialin(x):
    pr = x.get("profile") if isinstance(x, dict) else None
    return isinstance(pr, dict) and x.get("provider") == "profile" and bool(pr.get("listen_port")) and not pr.get("endpoint")


def _dialin_ports(node):
    out = []
    for x in (node or {}).get("exits") or []:
        if exit_is_dialin(x):
            with contextlib.suppress(TypeError, ValueError):
                out.append((x, int(x["profile"]["listen_port"])))
    return out


def _node_ports(deps, nodes, nid, skip_exits=False, skip=None):
    snap = (deps.get("node_snaps") or {}).get(nid) or {}
    node = nodes.get(nid) or {}
    out = {}
    def add(p, label, who=None):
        if who is not None and who == skip:
            return
        try:
            p = int(str(p).strip())
        except (TypeError, ValueError):
            return
        out.setdefault(p, label)
    def tail(v):
        m = re.search(r":(\d+)$", str(v or ""))
        return m.group(1) if m else None
    for ifn, blk in (snap.get("interfaces") or {}).items():
        add((blk.get("meta") or {}).get("listen_port"), ifn, ("iface", ifn))
    for ifn, ov in (node.get("ifaces") or {}).items():
        add(ov.get("desired_port") or ov.get("listen_port"), ifn, ("iface", ifn))
    for tp in (snap.get("turn_proxies") or []):
        add(tail(tp.get("listen")), tp.get("service") or "a turn-proxy", ("turn", tp.get("service")))
    for svc, req in (node.get("turn") or {}).items():
        add(tail(req.get("listen")), svc, ("turn", svc))
    for ifn, w in (node.get("wdtt") or {}).items():
        add(tail(w.get("listen")), ifn + " (WDTT)", ("wdtt", ifn))
        add(w.get("wg_port"), perr("{v1} (WDTT internal WG)", v1=ifn), ("wdtt", ifn))
    def ents(v):
        return [(e.get("iface") or (k if isinstance(v, dict) else "") or "", e)
                for k, e in (v.items() if isinstance(v, dict) else enumerate(v or ())) if isinstance(e, dict)]
    for ifn, w in ents(snap.get("wdtt")):
        add(tail(w.get("listen")), ifn + " (WDTT)", ("wdtt", ifn))
        add(w.get("wg_port"), perr("{v1} (WDTT internal WG)", v1=ifn), ("wdtt", ifn))
    for ifn, c in (node.get("csqtt") or {}).items():
        add(tail(c.get("listen")), ifn + " (csqtt)", ("csqtt", ifn))
    for ifn, c in ents(snap.get("csqtt")):
        add(tail(c.get("listen")), ifn + " (csqtt)", ("csqtt", ifn))
    for lr in (node.get("links") or {}).values():
        add(lr.get("listen_port"), "a mesh link")
    for x in (snap.get("container_ifaces") or []):
        if isinstance(x, dict) and x.get("host_port"):
            add(x["host_port"], "%s in container %s" % (x.get("name") or "an interface", x.get("container") or "?"))
    if not skip_exits:
        for x, p in _dialin_ports(node):
            add(p, "the dial-in exit " + (x.get("label") or x.get("device") or ""))
    return out


def _host_listen(snap):
    return {p for p in ((snap or {}).get("udp_listen") or ()) if isinstance(p, int)}

def _port_conflict(deps, nodes, nid, port, own=(), me=None):
    try:
        port = int(str(port).strip())
    except (TypeError, ValueError):
        return None
    if port in {int(str(p)) for p in own if str(p).strip().isdigit()}:
        return None
    if port == WDTT_RAW_PORT:
        return _wdtt_raw_holder(nodes, nid, "") or perr("RAW-IP (reserved)")
    return _node_ports(deps, nodes, nid, skip=me).get(port)


def _alloc_port(used, base):
    p = base
    while p in used:
        p += 1
    return p


def mesh_pool_refusal(subnet):
    try:
        net = ipaddress.ip_network(str(subnet or "").strip(), strict=False)
    except (TypeError, ValueError):
        return "cidr"
    return "range" if net.version != 4 or net.prefixlen > 31 else ""


def mesh_pool_room(subnet):
    return 2 ** (31 - ipaddress.ip_network(str(subnet).strip(), strict=False).prefixlen)


def _mesh_in(sub, net):
    try:
        return ipaddress.ip_network(sub, strict=False).subnet_of(net)
    except (TypeError, ValueError):
        return False


def _mesh_anchored(nodes, deps=None):
    if deps is not None and mesh_mode_effective(deps, nodes) == "demand":
        out = {}
        for p in mesh_need(nodes, deps):
            out[min(p)] = out.get(min(p), 0) + 1
        return out
    ids = sorted(nodes)
    return {x: len(ids) - 1 - i for i, x in enumerate(ids)}


class _MeshAlloc:

    def __init__(self, nodes):
        self.nodes, self.taken, self.walk, self.miss = nodes, None, {}, None

    def release(self, sub):
        if self.taken is not None and sub in self.taken:
            self.taken.discard(sub)
            self.walk = {}

    def take(self, pool):
        why = mesh_pool_refusal(pool)
        if why:
            self.miss = (str(pool or ""), "bad")
            return None
        key = str(ipaddress.ip_network(str(pool).strip(), strict=False))
        if self.taken is None:
            self.taken = {lr.get("subnet") for n in self.nodes.values() for lr in (n.get("links") or {}).values()}
        it = self.walk.get(key)
        if it is None:
            it = self.walk[key] = ipaddress.ip_network(key).subnets(new_prefix=31)
        for sub in it:
            if str(sub) not in self.taken:
                self.taken.add(str(sub))
                return sub
        self.miss = (key, "full")
        return None


def _link_id(nodes, a, b):
    lo, hi = sorted((a, b))
    glo = int((nodes.get(lo) or {}).get("mesh_gen") or 0)
    ghi = int((nodes.get(hi) or {}).get("mesh_gen") or 0)
    return hashlib.sha256(f"{lo}|{glo}|{hi}|{ghi}".encode()).hexdigest()


def mesh_reprovision_node(nodes, nid):
    me = nodes.get(nid) or {}
    me["mesh_gen"] = int(me.get("mesh_gen") or 0) + 1
    _peers = set((me.get("links") or {}))
    _peers |= {k for k, v in nodes.items()
               if k != nid and isinstance(v, dict) and nid in (v.get("links") or {})}
    for peer in sorted(_peers):
        mesh_link_park(nodes, nid, peer)
        mesh_link_park(nodes, peer, nid)
    me["links"] = {}


def mesh_link_waits(deps, nodes, snaps, a, b):
    if a in (snaps or {}) and b in (snaps or {}):
        return False
    return mesh_gen_for(deps, nodes, a, b) == "3.1" or bool(mesh_template(deps, mesh_link_layer(nodes, a, b))[1])


def _mesh_make_link(nodes, snaps, deps, a, b, mc, alloc=None, log=True):
    link_id = _link_id(nodes, a, b)
    x_nid = min(a, b)
    alloc = alloc or _MeshAlloc(nodes)
    sub = alloc.take(node_mesh_cfg(deps, nodes[x_nid])["subnet"])
    if sub is None:
        return False
    hosts = list(sub)
    psk = gen_psk()
    gen = mesh_gen_for(deps, nodes, a, b)
    _is31 = gen == "3.1" and mesh_31_refusal(deps, nodes, snaps, a, b, mc["mtu"]) is None
    _ly = mesh_link_layer(nodes, a, b)
    _tv, _tom = mesh_template(deps, _ly)
    _v3, _om3 = mesh_awg3(deps, _ly) if _is31 else ({}, frozenset())
    _exact = bool(_is31 or _tom) and all(awg_exact_reported((snaps or {}).get(x)) for x in (a, b))
    if gen == "wg":
        awg = None
    elif _is31:
        awg = awg3_full(_tv, defaults=_v3, omit=(_tom | _om3) if _exact else (), s_max=mesh_s4_room(mc["mtu"]))
        if not mesh_s4_fits(awg["S4"], mc["mtu"]):
            awg_set_s4(awg, str(mesh_s4_draw(mc["mtu"], AWG31_MIN_S)))
    else:
        if all(k in _tv for k in AWG_FIELDS if k not in AWG3_FIELDS):
            awg = dict(_tv)
        elif _tv or _tom:
            awg = {k: str(v) for k, v in {**gen_awg_params("2.0"), **_tv}.items() if not (_exact and k in _tom)}
        else:
            awg = gen_awg_params("2.0")
        if gen == "3.1" and AWG31_HEADERS.keys() <= awg.keys():
            awg = awg2_profile(awg, replace_standard_headers=True)
        if not mesh_s4_fits(awg.get("S4"), mc["mtu"]):
            awg["S4"] = mesh_s4_draw(mc["mtu"])
    for nid, peer in ((a, b), (b, a)):
        n = nodes[nid]
        nmc = node_mesh_cfg(deps, n)
        iface = _link_iface_name(n, link_id, nmc.get("iface_prefix") or "swg_")
        mine, theirs = (hosts[0], hosts[1]) if nid == x_nid else (hosts[1], hosts[0])
        port = _alloc_port(_used_ports(nodes, snaps, nid), nmc["port_base"])
        _stale = ((n.get("links") or {}).get(peer) or {}).get("subnet")
        _kv = (n.get("link_keep") or {}).pop(peer, None) or mesh_link_extras((n.get("links") or {}).get(peer))
        if "link_keep" in n and not n["link_keep"]:
            n.pop("link_keep")
        n.setdefault("links", {})[peer] = {
            "iface": iface, "link_id": link_id, "subnet": str(sub),
            "address": str(mine), "peer_address": str(theirs),
            "listen_port": port, "psk": psk, "role": "x" if nid == x_nid else "y",
            **({"proto": "wg"} if awg is None else {}),
            **_kv}
        n.setdefault("create", {})[iface] = {
            "cmd": ["wg"] if awg is None else ["awg"], "subnet": str(sub), "address": f"{mine}/31",
            "listen_port": port, "mtu": nmc["mtu"], "table": "off"}
        n.setdefault("ifaces", {})[iface] = {**({} if awg is None else {"awg_params": dict(awg)}), "system": True,
                                             "link_node": peer, **({"awg_exact": True} if awg is not None and _exact else {})}
        if _stale and _stale != str(sub):
            alloc.release(_stale)
    if log:
        ev_append(deps["roster_path"], "node", a, "Linked node", nodes[b].get("name", b))
    return True


MESH_MODES = ("auto", "full", "demand")
MESH_AUTO_FULL_MAX = 30
MESH_RETIRE_GRACE_S = 3600
MESH_LINK_EVENTS_MAX = MESH_AUTO_FULL_MAX
_MESH_IDLE = {}


def mesh_mode_effective(deps, nodes):
    m = str((deps.get("panel_settings") or {}).get("mesh_mode") or "auto")
    if m in ("full", "demand"):
        return m
    return "full" if len(nodes) <= MESH_AUTO_FULL_MAX else "demand"


def mesh_need(nodes, deps):
    need = set()
    def want(a, b):
        if a and b and a != b and a in nodes and b in nodes:
            need.add(frozenset((a, b)))
    def want_rule(origin, rule):
        path = rule.get("cascade")
        hops = [origin, *path["nodes"]] if path else [origin, rule.get("node")]
        for a, b in zip(hops, hops[1:]):
            want(a, b)
        if path and path.get("backup"):
            backup = [origin, *path["backup"]]
            for a, b in zip(backup, backup[1:]):
                want(a, b)
    for nid, n in nodes.items():
        if not isinstance(n, dict):
            continue
        recs = [ov for ov in (n.get("ifaces") or {}).values() if isinstance(ov, dict) and not ov.get("system")]
        recs += [v for k in ("wdtt", "csqtt") for v in (n.get(k) or {}).values() if isinstance(v, dict)]
        _pif = p2p_policy(n) == "iface"
        for ov in recs:
            mode = ov.get("egress_mode")
            _rp = ov.get("p2p") if isinstance(ov.get("p2p"), dict) else {}
            if _pif and _rp.get("action") == "exit" and "torrents" not in (ov.get("block") or []):
                want(nid, str(_rp.get("node") or ""))
            if mode == "forward":
                want(nid, str(ov.get("egress_node") or ""))
            elif mode == "smart":
                for r in (ov.get("routing") or []):
                    if rule_on(r) and r.get("action") == "exit":
                        want_rule(nid, r)
        if isinstance(n.get("default_routing"), list):
            for r in n["default_routing"]:
                if isinstance(r, dict) and rule_on(r) and r.get("action") == "exit":
                    want_rule(nid, r)
        _pp = n.get("p2p") if isinstance(n.get("p2p"), dict) else {}
        if _pp.get("action") == "exit":
            want(nid, str(_pp.get("node") or ""))
        for peer, lr in (n.get("links") or {}).items():
            if mesh_link_extras(lr):
                want(nid, peer)
        for peer in (n.get("link_keep") or {}):
            want(nid, peer)
    if deps.get("roster_path"):
        for _, (dest, _), origin, _, _ in static_exit_clients(roster_load(deps["roster_path"])):
            want(origin, dest)
    for nid, legs in (deps.get("cas_legs") or {}).items():
        for lg in legs or ():
            want(nid, str((lg or {}).get("peer") or ""))
    return need


def _mesh_retire(nodes, need, deps):
    now_ = time.time()
    linked = {frozenset((a, b)) for a, n in nodes.items() for b in (n.get("links") or {}) if a != b}
    for p in [p for p in _MESH_IDLE if p not in linked or p in need]:
        _MESH_IDLE.pop(p, None)
    gone = []
    for p in linked:
        if p in need or now_ - _MESH_IDLE.setdefault(p, now_) < MESH_RETIRE_GRACE_S:
            continue
        _MESH_IDLE.pop(p, None)
        a, b = tuple(p)
        for x, y in ((a, b), (b, a)):
            mesh_link_park(nodes, x, y, park=False, now=now_)
        gone.append(p)
    if gone:
        names = sorted(" ↔ ".join(sorted(str((nodes.get(x) or {}).get("name") or x) for x in p)) for p in gone)
        ev_append(deps["roster_path"], "node", "", "Removed unused mesh links",
                  ", ".join(names[:5]) + ((", … (+%d)" % (len(names) - 5)) if len(names) > 5 else ""),
                  "%d link(s) · on demand, %d node(s)" % (len(gone), len(nodes)),
                  detail_key="{count} · on demand, {nodes}",
                  detail_vars={"count": {"n": len(gone), "noun": "link"}, "nodes": {"n": len(nodes), "noun": "node"}})
    return bool(gone)


def reconcile_mesh(nodes, snaps, deps):
    mc = mesh_cfg(deps)
    changed = False
    ids = list(nodes.keys())
    alloc, unplaced, need = _MeshAlloc(nodes), {}, None
    mode = mesh_mode_effective(deps, nodes)
    if mode == "full":
        _MESH_IDLE.clear()
        pairs = ((a, b) for i, a in enumerate(ids) for b in ids[i + 1:])
    else:
        need = mesh_need(nodes, deps)
        pos = {x: i for i, x in enumerate(ids)}
        pairs = sorted((tuple(sorted(p, key=pos.__getitem__)) for p in need), key=lambda ab: (pos[ab[0]], pos[ab[1]]))
    made = 0
    for a, b in pairs:
        if b not in (nodes[a].get("links") or {}):
            if mesh_link_waits(deps, nodes, snaps, a, b):
                continue
            if _mesh_make_link(nodes, snaps, deps, a, b, mc, alloc, log=made < MESH_LINK_EVENTS_MAX):
                made += 1
                changed = True
                continue
            _x = min(a, b); _pool, _why = alloc.miss
            unplaced.setdefault(_x, {"pool": _pool, "why": _why, "own": bool(nodes[_x].get("mesh_subnet")),
                                     "peers": []})["peers"].append(b if _x == a else a)
    if made > MESH_LINK_EVENTS_MAX:
        _more = made - MESH_LINK_EVENTS_MAX
        ev_append(deps["roster_path"], "node", "", "Linked more node pairs", "", "%d link(s)" % _more,
                  detail_key="{count}", detail_vars={"count": {"n": _more, "noun": "link"}})
    deps["mesh_unplaced"] = unplaced
    if mode == "demand":
        changed = _mesh_retire(nodes, need, deps) or changed
    for nid, n in nodes.items():
        snap_ifs = set((((snaps or {}).get(nid) or {}).get("interfaces") or {}))
        _cr = n.get("create")
        if isinstance(_cr, dict):
            _own = n.get("ifaces") or {}
            for _ifc in [k for k in _cr if str(k).startswith("swg_") and k not in _own]:
                _cr.pop(_ifc, None)
                changed = True
        pending = set(n.get("create") or {})
        for peer, lr in (n.get("links") or {}).items():
            ifc = lr.get("iface")
            _ov = (n.get("ifaces") or {}).get(ifc)
            if isinstance(_ov, dict) and int(_ov.get("mtu") or 0) != int(mc["mtu"]):
                _ov["mtu"] = int(mc["mtu"]); changed = True
            if ifc and ifc not in snap_ifs and ifc not in pending:
                n.setdefault("create", {})[ifc] = {"cmd": ["wg"] if lr.get("proto") == "wg" else ["awg"], "subnet": lr["subnet"],
                    "address": lr["address"] + "/31", "listen_port": lr["listen_port"], "mtu": mc["mtu"], "table": "off"}
                ov = n.setdefault("ifaces", {}).setdefault(ifc, {})
                ov.setdefault("system", True); ov.setdefault("link_node", peer)
                changed = True
    seen = set()
    for a, n in nodes.items():
        for b, lr in (n.get("links") or {}).items():
            pair = (a, b) if a < b else (b, a)
            if pair in seen or b not in nodes:
                continue
            seen.add(pair)
            back = (nodes[b].get("links") or {}).get(a) or {}
            ends = [((x.get("ifaces") or {}).get(l.get("iface")) or {}).get("awg_params")
                    for x, l in ((n, lr), (nodes[b], back))]
            if not all(isinstance(p, dict) and p for p in ends):
                continue
            if all(mesh_s4_fits(p.get("S4"), mc["mtu"]) for p in ends):
                continue
