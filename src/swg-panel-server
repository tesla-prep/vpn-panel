            os.remove(_hpp)
    _psp = fleet.get("panel_settings_path") or os.path.join(os.path.dirname(nodes_path) or ".", "panel-settings.json")
    Handler.deps = {"fleet": fleet, "host_proc_path": _hpp,
                    "roster_path": fleet.get("roster_path", "/var/lib/swg-panel/users.json"),
                    "stats_dir": fleet.get("stats_dir", "/var/www/wgstats"),
                    "panel_settings_path": _psp, "panel_settings": load_panel_settings(_psp),
                    "nodes_path": nodes_path, "nodes": nodes_load(nodes_path),
                    "node_snaps": {}, "node_seen": {}, "live_samples": {},
                    "auth": load_auth(),
                    "session_secret": load_session_secret(fleet.get("roster_path", "/var/lib/swg-panel/users.json")),
                    "sub_dir": os.path.join(os.path.dirname(fleet.get("roster_path", "/var/lib/swg-panel/users.json")) or ".", "subs"),
                    "now": lambda: int(time.time())}
    migrate_legacy_egress(Handler.deps)
    settings = Handler.deps["panel_settings"]
    settings["access"] = {
        "panel": {"url": PANEL_PUBLIC_URL, "base": PANEL_BASE or "/", "host": BIND_HOST, "port": BIND_PORT},
        "sub": {"url": SUB_PUBLIC_URL, "base": _sub_url_base(SUB_PUBLIC_URL) or "/", "host": "0.0.0.0", "port": 8444},
    }
    settings.setdefault("subscriptions", {})["base_url"] = SUB_PUBLIC_URL
    panel_log_apply(settings)
    if PANEL_LOG_FILE["path"]:
        threading.Thread(target=_panel_log_follow_loop, name="log-follow", daemon=True).start()
    range_init(os.path.dirname(Handler.deps["roster_path"]))
    _tz0 = str(Handler.deps["panel_settings"].get("time_zone") or "")
    if _tz0 and not tz_apply(_tz0):
        _TZ_STATE["missing"] = _tz0
        log(LOG_WARNING, "swg-panel: time zone %s is not on this server — counting days in the server's own zone until "
              "another is picked in Settings → Display" % _tz0)
    LEDGER.start(Handler.deps)
    with contextlib.suppress(ValueError, OSError, AttributeError):
        signal.signal(signal.SIGTERM, _sigterm_exit)
    _release_cache_load(Handler.deps)
    Handler.deps["turn_ips"] = load_json(_turn_ips_path(Handler.deps), {}) or {}
    def _turn_store_prune_soon():
        time.sleep(60)
        with contextlib.suppress(Exception):
            _turn_bins_prune_all()
    threading.Thread(target=_turn_store_prune_soon, name="turn-store-prune", daemon=True).start()
    write_sub_serve(Handler.deps)
    normalize_sub_perms(Handler.deps)
    with contextlib.suppress(Exception):
        _cur_ver = _read_version()
        _vpath = os.path.join(os.path.dirname(nodes_path) or ".", "panel_version")
        _last = ""
        if os.path.exists(_vpath):
            with open(_vpath) as _vf:
                _last = (_vf.readline() or "").strip()
        if _cur_ver and _last and _last != _cur_ver:
            ev_append(Handler.deps["roster_path"], "panel", "update", "Panel updated", _last + " → " + _cur_ver)
        if _cur_ver and _last != _cur_ver:
            atomic_write(_vpath, _cur_ver + "\n")
    for _nid, _c in Handler.deps["nodes"].items():
        _sf = os.path.join(Handler.deps["stats_dir"], _c.get("stats_file", f"stats-{_nid}.json"))
        _snap = load_json(_sf, None)
        _mt = 0
        with contextlib.suppress(OSError):
            _mt = int(os.path.getmtime(_sf))
        if isinstance(_snap, dict) and _snap and _snap_sanitise(_snap, _nid) is None:
            Handler.deps["node_snaps"][_nid] = _snap
            Handler.deps["node_seen"][_nid] = _warm_seen(_mt, _snap)
        _lb = load_json(os.path.join(Handler.deps["stats_dir"], f"live-{_nid}.json"), None)
        if isinstance(_lb, list) and _lb:
            Handler.deps["live_samples"][_nid] = [tuple(s) for s in _lb if isinstance(s, (list, tuple)) and len(s) >= 6][-LIVE_MAX:]
    _ofm = load_json(os.path.join(Handler.deps["stats_dir"], "offenders.json"), None)
    for _nid, _c in Handler.deps["nodes"].items():
        for _f in (_c.get("stats_file", f"stats-{_nid}.json"), f"live-{_nid}.json"):
            with contextlib.suppress(OSError):
                os.chmod(os.path.join(Handler.deps["stats_dir"], _f), 0o640)
    with contextlib.suppress(OSError):
        os.chmod(os.path.join(Handler.deps["stats_dir"], "offenders.json"), 0o640)
    with contextlib.suppress(OSError):
        for _f in os.listdir(Handler.deps["stats_dir"]):
            if re.match(r".+\.tmp\.[0-9a-f]{8}$", _f):
                with contextlib.suppress(OSError):
                    _p = os.path.join(Handler.deps["stats_dir"], _f)
                    if time.time() - os.lstat(_p).st_mtime > 60:
                        os.unlink(_p)
    if isinstance(_ofm, dict):
        Handler.deps["_offenders"] = {m: {ip: list(e) for ip, e in (d or {}).items()
                                          if isinstance(e, (list, tuple)) and len(e) >= 3}
                                      for m, d in _ofm.items() if isinstance(d, dict)}
    threading.Thread(target=_turn_update_loop, daemon=True).start()
    threading.Thread(target=_turn_warm_assets_loop, args=(Handler.deps,), daemon=True).start()
    threading.Thread(target=_node_watch_loop, args=(Handler.deps,), daemon=True).start()
    threading.Thread(target=_catalog_refresh_loop, daemon=True).start()
    _raise_fd_limit()
    threading.Thread(target=_fd_watchdog_loop, daemon=True).start()
    auth_note = ("" if Handler.deps["auth"]
                 else ("  [AUTH FILE UNUSABLE — every request is refused]" if AUTH_UNUSABLE else "  [no auth!]"))
    log(LOG_WARNING if auth_note else LOG_INFO, f"swg-panel-server on http://{BIND_HOST}:{BIND_PORT}{auth_note}")
    if AUTH_UNUSABLE:
        log(LOG_ERR, "swg-panel-server: %s is unusable (%s) and this process runs as %s, so LOGIN IS CLOSED and "
              "every request is refused. Node sync, /healthz and the subscription page are unaffected. Fix: %s%s", AUTH_FILE, AUTH_UNUSABLE, _proc_user_name(), _auth_fix_line(), "" if IN_DOCKER else " — or, if this panel is MEANT to have no login, clear SWG_PANEL_AUTH in its unit "
                                      "(blank means no login by design).")
    _release_startup_memory()
    with PanelServer((BIND_HOST, BIND_PORT), Handler) as server:
        with contextlib.suppress(KeyboardInterrupt):
            server.serve_forever()


if __name__ == "__main__":
    main()
