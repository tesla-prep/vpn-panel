class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None
_WEBHOOK_OPENER = urllib.request.build_opener(_NoRedirect)


def webhook_host_ok(url):
    try:
        host = urlparse(url).hostname
    except Exception:
        return False
    if not host:
        return False
    try:
        infos = socket.getaddrinfo(host, None)
    except Exception:
        return True
    for ai in infos:
        try:
            ip = ipaddress.ip_address(ai[4][0])
        except ValueError:
            continue
        if ip.is_link_local or ip.is_multicast or ip.is_reserved or ip.is_unspecified:
            return False
    return True


def _webhook_post(url, secret, body_bytes, timeout=8):
    if not webhook_host_ok(url):
        raise ValueError("webhook target resolves to a disallowed (internal) address")
    headers = {"Content-Type": "application/json", "User-Agent": "swg-panel-webhook"}
    if secret:
        headers["X-SWG-Signature"] = "sha256=" + hmac.new(secret.encode(), body_bytes, hashlib.sha256).hexdigest()
    req = urllib.request.Request(url, data=body_bytes, headers=headers, method="POST")
    with _WEBHOOK_OPENER.open(req, timeout=timeout) as r:
        return getattr(r, "status", None) or r.getcode()


def webhook_emit(deps, event, data):
    a = _api_settings(deps)
    hooks = [h for h in (a.get("webhooks") or [])
             if h.get("enabled", True) is not False and h.get("url")
             and (not h.get("events") or event in h["events"])]
    if not hooks:
        return
    body = json.dumps({"event": event, "ts": int(time.time()), "data": data}, separators=(",", ":")).encode()
    def _deliver():
        for h in hooks:
            for attempt in range(2):
                try:
                    _webhook_post(h["url"], h.get("secret") or "", body)
                    break
                except Exception:
                    if attempt == 0:
                        time.sleep(1.5)
    threading.Thread(target=_deliver, daemon=True).start()


def _node_watch_loop(deps):
    state = {}
    first = True
    while True:
        with contextlib.suppress(Exception):
            if not (_api_settings(deps).get("webhooks")):
                first = True
                time.sleep(10)
                continue
            now = int(time.time())
            seen = deps.get("node_seen") or {}
            nodes = nodes_load(deps["nodes_path"])
            for nid in list(seen.keys()):
                ls = seen.get(nid)
                online = ls is not None and (now - ls) <= NODE_OFFLINE
                prev = state.get(nid)
                state[nid] = online
                if first or prev is None or prev == online:
                    continue
                nm = (nodes.get(nid) or {}).get("name", nid)
                webhook_emit(deps, "node.online" if online else "node.offline",
                             {"id": nid, "name": nm, "last_seen": ls})
            first = False
        time.sleep(10)



DRAIN_CAP = 256 * 1024


class _CountedRfile:
    __slots__ = ("_f", "n")

    def __init__(self, f):
        self._f = f
        self.n = 0

    def read(self, size=-1):
        b = self._f.read(size)
        self.n += len(b)
        return b

    def readline(self, *a):
        b = self._f.readline(*a)
        self.n += len(b)
        return b

    def __getattr__(self, k):
        return getattr(self._f, k)


class Handler(BaseHTTPRequestHandler):
    deps = None
    protocol_version = "HTTP/1.1"
    timeout = 75

    def handle_one_request(self):
        _raw = self.rfile
        self.rfile = _CountedRfile(_raw)
        try:
            BaseHTTPRequestHandler.handle_one_request(self)
        finally:
            try:
                self._drain_request_body()
            except Exception:
                self.close_connection = True
            self.rfile = _raw

    def parse_request(self):
        ok = BaseHTTPRequestHandler.parse_request(self)
        if ok and isinstance(self.rfile, _CountedRfile):
            self.rfile.n = 0
        return ok

    def _drain_request_body(self):
        if not getattr(self, "headers", None):
            return
        te = (self.headers.get("Transfer-Encoding") or "").strip().lower()
        if te and te != "identity":
            self.close_connection = True
            return
        try:
            n = int(self.headers.get("Content-Length", 0) or 0)
        except ValueError:
            n = 0
        left = n - getattr(self.rfile, "n", 0)
        if left <= 0:
            return
        if left > DRAIN_CAP:
            self.close_connection = True
            return
        with contextlib.suppress(Exception):
            self.rfile.read(left)

    def _send(self, code, obj):
        self._send_bytes(code, json.dumps(obj).encode())

    def _body_len(self, cap=MAX_BODY):
        try:
            n = int(self.headers.get("Content-Length", 0) or 0)
        except ValueError:
            n = -1
        if n < 0 or n > cap:
            self._send(413, {"ok": False, "error": "request body too large", "code": "too_large"})
            return None
        return n

    def _send_bytes(self, code, payload, encoding=None):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        if encoding:
            self.send_header("Content-Encoding", encoding)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        with contextlib.suppress(BrokenPipeError, ConnectionError):
            self.wfile.write(payload); self.wfile.flush()

    def _send_text(self, code, text, ctype="text/plain; charset=utf-8"):
        payload = text.encode() if isinstance(text, str) else text
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        with contextlib.suppress(BrokenPipeError, ConnectionError):
            self.wfile.write(payload)

    def _ext_token(self, u):
        hdr = self.headers.get("Authorization", "")
        if hdr.startswith("Bearer "):
            return hdr[7:].strip()
        xk = self.headers.get("X-API-Key", "")
        if xk:
            return xk.strip()
        return (parse_qs(u.query).get("token") or [""])[0]

    def _ext_authed(self, u):
        tok = self._ext_token(u)
        if tok and api_token_lookup(self.deps, tok) is not None:
            self.deps.setdefault("api_seen", {})[_api_token_hash(tok.strip())] = int(time.time())
            return True
        return self._authed_user() is not None

    def _ext_api(self, path, u):
        try:
            if path == "/healthz":
                return self._send_text(200, "ok\n")
            if path == "/api/v1/health":
                s = ext_summary(self.deps)
                return self._send(200, {"status": "ok", "version": s["version"], "nodes": s["nodes"], "peers": s["peers"]})
            if not self._ext_authed(u):
                _authfail_note("api")
                _d = _authfail_delay("api")
                if _d:
                    time.sleep(_d)
                return self._send(401, {"error": "unauthorized",
                                        "detail": "send a read-only API token as 'Authorization: Bearer <token>' "
                                                  "(mint one in Settings → Integrations, then enable the API)"})
            if path == "/metrics":
                return self._send_text(200, ext_metrics(self.deps), "text/plain; version=0.0.4; charset=utf-8")
            if path == "/api/v1/servers":
                return self._send(200, {"servers": ext_servers(self.deps)})
            m = re.match(r"^/api/v1/servers/([^/]+)/peers$", path)
            if m:
                r = ext_peers_for_node(self.deps, unquote(m.group(1)))
                return self._send(404, {"error": "unknown server"}) if r is None else self._send(200, r)
            m = re.match(r"^/api/v1/servers/([^/]+)$", path)
            if m:
                sid = unquote(m.group(1))
                hit = next((sv for sv in ext_servers(self.deps) if sv["id"] == sid or sv["name"] == sid), None)
                return self._send(200, hit) if hit else self._send(404, {"error": "unknown server"})
            if path == "/api/v1/peers":
                return self._send(200, {"peers": ext_peers_all(self.deps)})
            if path == "/api/v1/summary":
                return self._send(200, ext_summary(self.deps))
            return self._send(404, {"error": "not found"})
        except Exception as e:
            return self._send(500, {"error": "internal", "detail": str(e)})

    def _send_state(self):
        c = _STATE_CACHE
        if c["bytes"] is not None and (time.monotonic() - c["at"]) < STATE_CACHE_TTL:
            return self._send_state_bytes(c)
        with _state_cache_lock:
            if c["bytes"] is not None and (time.monotonic() - c["at"]) < STATE_CACHE_TTL:
                return self._send_state_bytes(c)
            try:
                code, obj = api("GET", "/api/state", {}, {}, self.deps)
            except Exception as e:
                return self._send(500, {"ok": False, "error": str(e), "code": "internal"})
            if code == 200:
                c["bytes"] = json.dumps(obj).encode()
                c["gz"] = None
                c["at"] = time.monotonic()
                return self._send_state_bytes(c)
        return self._send(code, obj)

    def _send_state_bytes(self, c):
        if accepts_gzip(self.headers.get("Accept-Encoding")):
            if c["gz"] is None:
                c["gz"] = gzip.compress(c["bytes"], 6)
            return self._send_bytes(200, c["gz"], encoding="gzip")
        return self._send_bytes(200, c["bytes"])

    def _static(self, key):
        rel = static_rel(key)
        if rel is None:
            return self.send_error(404)
        full = os.path.normpath(os.path.join(WEB_DIR, rel))
        if not full.startswith(os.path.realpath(WEB_DIR)) and not full.startswith(WEB_DIR):
            return self.send_error(403)
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            return self.send_error(404)
        _mb = getattr(_REQ, "matched_base", None)
        if _mb is None:
            _mb = PANEL_BASE
        if _mb and rel == "index.html":
            data = data.replace(b'<base href="/">', ('<base href="%s/">' % _mb).encode())
        if rel == "index.html":
            data = _localize_meta(data, _accept_lang(self.headers.get("Accept-Language", "")))
        if rel == "index.html":
            data = re.sub(rb'href="(js/[A-Za-z0-9_.-]+\.js)"',
                          lambda m: b'href="' + m.group(1) + _js_tree_q() + b'"', data)
            data = (data.replace(b'href="app.css"', b'href="app.css' + _asset_q("app.css") + b'"')
                        .replace(b'href="m/m.css"', b'href="m/m.css' + _asset_q("m/m.css") + b'"')
                        .replace(b'src="app.js"', b'src="app.js' + _asset_q("app.js") + b'"')
                        .replace(b'src="turn-artifacts.js"', b'src="turn-artifacts.js' + _asset_q("turn-artifacts.js") + b'"'))
        elif rel.endswith(".js"):
            data = _stamp_imports(data, rel)
        _, ext = os.path.splitext(full)
        if ext == ".woff2" or rel.startswith("js/"):
            self.send_response(200)
            self.send_header("Content-Type", CTYPES.get(ext, "application/octet-stream"))
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "public, max-age=31536000, immutable")
            if ext == ".js":
                self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            with contextlib.suppress(BrokenPipeError):
                self.wfile.write(data)
            return
        etag = '"%s"' % hashlib.sha256(data).hexdigest()[:16]
        if self.headers.get("If-None-Match") == etag:
            self.send_response(304)
            self.send_header("ETag", etag)
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", CTYPES.get(ext, "application/octet-stream"))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.send_header("ETag", etag)
        self.send_header("X-Content-Type-Options", "nosniff")
        if rel == "index.html":
            self.send_header("Content-Security-Policy",
                             "default-src 'self'; script-src 'self' 'unsafe-inline'; "
                             "style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; "
                             "connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "same-origin")
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(data)

    def _cookie(self, name):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == name:
                return v
        return ""

    def _authed_user(self):
        creds = Handler.deps.get("auth")
        if not creds:
            return None if AUTH_UNUSABLE else True
        secret = Handler.deps.get("session_secret")
        tok = self._cookie("swgsess")
        if tok and secret and verify_session(tok, secret) == creds[0]:
            return creds[0]
        hdr = self.headers.get("Authorization", "")
        if hdr.startswith("Basic "):
            try:
                user, _, pw = base64.b64decode(hdr[6:]).decode("utf-8", "replace").partition(":")
            except Exception:
                user, pw = "", ""
            if hmac.compare_digest(user, creds[0]) and verify_password(creds[1], pw):
                return creds[0]
        return None

    def _require_auth(self):
        if self._authed_user() is not None:
            return True
        self._send(401, {"ok": False, "error": "authentication required", "code": "unauthorized"})
        return False

    def _session_cookie(self, value, max_age):
        _cb = getattr(_REQ, "matched_base", None)
        base = (PANEL_BASE if _cb is None else _cb) + "/"
        secure = "; Secure"
        return f"swgsess={value}; Path={base}; HttpOnly; SameSite=Strict; Max-Age={max_age}{secure}"

    def _send_with_cookie(self, code, obj, cookie):
        payload = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        if cookie:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(payload)

    def _login(self):
        creds = Handler.deps.get("auth")
        length = self._body_len()
        if length is None:
            return
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            body = {}
        if not creds:
            if AUTH_UNUSABLE:
                if IN_DOCKER:
                    err = perr("the password file {v1} is unusable ({v2}), so nobody can sign in and every request is "
                               "refused. Set a new login on the Docker host: {v3} — the first command writes a new login, "
                               "the second restarts the panel so it reads it.", v1=AUTH_FILE, v2=AUTH_UNUSABLE,
                               v3=_auth_fix_cmd())
                elif AUTH_UNUSABLE_KIND == "perm":
                    err = perr("the password file {v1} cannot be read ({v2}) — this panel runs as {v3}, "
                               "so nobody can sign in and every request is refused. Fix it over SSH or the "
                               "provider console: chown root:swg {v1}; chmod 640 {v1}; systemctl restart "
                               "swg-panel-server  (or run swg-passwd to set a new password). If this panel "
                               "is MEANT to have no login — reached only over an SSH tunnel, say — clear "
                               "SWG_PANEL_AUTH in its unit instead: blank means no login by design, and "
                               "an empty file cannot say that.",
                               v1=AUTH_FILE, v2=AUTH_UNUSABLE, v3=_proc_user_name())
                else:
                    err = perr("the password file {v1} is unusable ({v2}), so nobody can sign in and every request is "
                               "refused. Set a new login over SSH or the provider console: {v3} — it writes a new login "
                               "and restarts the panel. If this panel is MEANT to have no login — reached only over an SSH "
                               "tunnel, say — clear SWG_PANEL_AUTH in its unit instead: blank means no login by design, and "
                               "an empty file cannot say that.",
                               v1=AUTH_FILE, v2=AUTH_UNUSABLE, v3=_auth_fix_cmd())
                return self._send(503, {"ok": False, "code": "auth_unusable", **err})
            return self._send(200, {"ok": True, "data": {"auth": False}})
        user = (body.get("username") or "").strip()
        pw = body.get("password") or ""
        _d = _authfail_delay("login")
        if _d:
            time.sleep(_d)
        if not (hmac.compare_digest(user, creds[0]) and verify_password(creds[1], pw)):
            _authfail_note("login")
            return self._send(401, {"ok": False, "error": "invalid username or password", "code": "bad_login"})
        _authfail_clear("login")
        tok = make_session(creds[0], Handler.deps.get("session_secret"))
        data = {"username": creds[0]}
        try:
            if os.path.exists(os.path.join(_sub_dir(Handler.deps), "vault.reset")):
                data["vault_reset"] = True
        except Exception:
            pass
        return self._send_with_cookie(200, {"ok": True, "data": data},
                                      self._session_cookie(tok, SESSION_TTL))

    def _logout(self):
        return self._send_with_cookie(200, {"ok": True}, self._session_cookie("", 0))

    def _wgstats(self, path):
        name = os.path.basename(path)
        if not name.endswith(".json") or "/" in name or name.startswith("."):
            return self.send_error(404)
        full = os.path.join(Handler.deps.get("stats_dir", "/var/www/wgstats"), name)
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            data = b"{}"
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(data)

    def _node_token(self):
        hdr = self.headers.get("Authorization", "")
        token = hdr[7:].strip() if hdr.startswith("Bearer ") else ""
        self._nodes_mark = nodes_mark(Handler.deps["nodes_path"])
        nodes = nodes_load(Handler.deps["nodes_path"])
        nid, node = find_node_by_token(nodes, token)
        if not nid:
            _authfail_note("node")
            _d = _authfail_delay("node")
            if _d:
                time.sleep(_d)
            self._send(401, {"error": "invalid node token"}); return None, None, None
        if token and not node.get("token_sha"):
            node["token_sha"] = hashlib.sha256(token.encode()).hexdigest()
            if _api_lock.acquire(timeout=2):
                try:
                    with contextlib.suppress(Exception):
                        nn = nodes_load(Handler.deps["nodes_path"])
                        if nid in nn and not nn[nid].get("token_sha"):
                            nn[nid]["token_sha"] = node["token_sha"]
                            nodes_save(Handler.deps["nodes_path"], nn)
                finally:
                    _api_lock.release()
        return nid, node, nodes

    def _node_sig_ok(self, node, body, require=None):
        if require is None:
            require = REQUIRE_NODE_SIG
        mac = self.headers.get("X-SWG-MAC", "")
        ts = self.headers.get("X-SWG-TS", "")
        if not mac and not ts:
            if require:
                self._send(401, {"error": "request signature required", "code": "signature_required"}); return False
            return True
        ok, why = _verify_node_sig(node.get("token_sha"), ts, mac, body)
        if not ok:
            self._send(401, {**perr("bad request signature ({v1})", v1=why), "code": "bad_signature"}); return False
        return True

    def _node_sync(self):
        nid, node, nodes = self._node_token()
        if not nid:
            return
        length = self._body_len(MAX_SYNC_BODY)
        if length is None:
            return
        raw = self.rfile.read(length) or b"{}"
        seq = next(_SYNC_SEQ)
        if not self._node_sig_ok(node, raw):
            return
        try:
            body = json.loads(raw or "{}", parse_constant=_json_finite, parse_float=_json_finite, parse_int=_json_int)
        except Exception:
            return self._send(400, {"error": "bad body"})
        snap = body.get("snapshot") or {}
        _serr = _snap_sanitise(snap, nid)
        if not _serr:
            Handler.deps.setdefault("node_snaps", {})[nid] = snap
            Handler.deps.setdefault("node_seen", {})[nid] = int(time.time())
            try:
                self._node_sync_history(nid, node, nodes, snap, seq)
            except Exception as e:
                log(LOG_WARNING, "stats: history for %s not recorded: %s", nid, e)
        if not _api_lock.acquire(timeout=SYNC_LOCK_WAIT):
            if not _serr and nid not in nodes_load(Handler.deps["nodes_path"]):
                (Handler.deps.get("node_snaps") or {}).pop(nid, None)
                (Handler.deps.get("node_seen") or {}).pop(nid, None)
            return self._send(503, {"ok": False, "error": "the panel is busy — this sync is skipped, the next one retries",
                                    "code": "busy"})
        try:
            tnode = node
            _mk = getattr(self, "_nodes_mark", None)
            if _mk is None or nodes_mark(Handler.deps["nodes_path"]) != _mk:
                nodes = nodes_load(Handler.deps["nodes_path"])
            node = nodes.get(nid)
            if not isinstance(node, dict):
                (Handler.deps.get("node_snaps") or {}).pop(nid, None)
                (Handler.deps.get("node_seen") or {}).pop(nid, None)
                code, obj = 401, {"error": "invalid node token"}
            elif not _node_cred_same(tnode, node):
                if (Handler.deps.get("node_snaps") or {}).get(nid) is snap:
                    Handler.deps["node_snaps"].pop(nid, None)
                code, obj = 401, {"error": "invalid node token"}
            else:
                code, obj = self._node_sync_apply(nid, node, nodes, snap, _serr)
        finally:
            _api_lock.release()
        return self._send(code, obj)

