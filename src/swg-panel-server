def _csqtt_row(snap, iface):                  # this server's row in a node report, or None
    return next((c for c in ((snap or {}).get("csqtt") or []) if isinstance(c, dict) and c.get("iface") == iface), None)
def _csqtt_run_line(snap, iface, rec):
    """The line a server RUNS — its node's report (the symlink), else its record, else 2.1. The update rows and the
    fork Version panel are built from the report, so every hold and build list is resolved the same way: during a
    pending or failed switch the record names the line ASKED for, and a hold set by it would land on the wrong binary.
    Raw — it can be a line this panel does not offer."""
    return str((_csqtt_row(snap, iface) or {}).get("line") or (rec or {}).get("line") or CSQTT_DEFAULT_LINE)
def _csqtt_hold_svc(line):                    # turn-holds key: 2.1 keeps the one it always had
    return "fork:csqtt" if line == CSQTT_DEFAULT_LINE else "fork:csqtt@" + line
def _csqtt_current_version(line=CSQTT_DEFAULT_LINE):
    b = CSQTT_LINES.get(line) or []
    return b[0][0] if b else ""
CSQTT_MIRROR_OWNER = "amurcanov/csqtt"        # the mirror KEY the node asks under — NOT where the binary lives
def _csqtt_tag_for(ver):                      # our release tag for an author version ("" / "csqtt" -> current 2.1 build), any line
    if not CSQTT_BUILDS:
        return ""
    if not ver or ver == "csqtt":
        return CSQTT_BUILDS[0][1]
    for builds in CSQTT_LINES.values():
        for v, tag in builds:
            if v == ver:
                return tag
    return ""
def _wdtt_tag_for(fork, ver):                 # our release tag for a specific author version ("" / "wdtt" -> current)
    vs = _wdtt_versions(fork)
    if not vs:
        return ""
    if not ver or ver == "wdtt":
        return vs[0][1]
    for v, tag in vs:
        if v == ver:
            return tag
    return ""

def _turn_asset_url(owner, tag, arch):    # the immutable per-tag release asset (OUR repo for kinds we BUILD, else the fork's)
    fork = _WDTT_OWNER_FORK.get(owner)
    if fork:
        rtag = _wdtt_tag_for(fork, tag)   # `tag` is an author version now (or "wdtt" -> current build)
        if rtag:
            return "https://github.com/" + WDTT_BUILD_REPO + "/releases/download/" + rtag + "/server-linux-" + arch
    if owner == CSQTT_MIRROR_OWNER:
        rtag = _csqtt_tag_for(tag)
        if rtag:
            return "https://github.com/" + WDTT_BUILD_REPO + "/releases/download/" + rtag + "/server-linux-" + arch
    return "https://github.com/" + owner + "/releases/download/" + tag + "/server-linux-" + arch

def _turn_sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()

_TURN_PRUNE_WARNED = set()                    # snapshot files already said to block the prune (once each per process)
_TURN_PRUNING = set()                         # owners a background prune is running for (one at a time per owner)
_TURN_PRUNING_LOCK = threading.Lock()
_TURN_VER_CUT = 40                            # swg-noded reports a version cut to this many characters (_turn_version)


def _turn_age(path):
    """Seconds since `path` last changed, or None once it is gone (a temp file finishing, a dir pruned under us)."""
    try:
        return time.time() - os.path.getmtime(path)
    except OSError:
        return None


def _turn_files(path):
    try:
        return os.listdir(path)
    except OSError:
        return []


def _turn_mirrored_at(path):
    """When the newest finished server binary in a tag dir landed (its mtime — what turn_available_tags orders the
    rollback menu by), or None: there is none in it (a download's temp file and an empty file are not one)."""
    at = None
    for f in _turn_files(path):
        if f.startswith("server-linux-") and ".dl." not in f:
            with contextlib.suppress(OSError):
                st = os.stat(os.path.join(path, f))
                if st.st_size > 0 and (at is None or st.st_mtime > at):
                    at = st.st_mtime
    return at


def _turn_bins_needed():
    """{owner: set(tag)} the store keeps whatever its age, or None when that cannot be known (then nothing is pruned).
    - what a node RUNS: every snapshot on disk, a silent node's last one included — a held or rolled-back version can be
      older than the newest TURN_BINS_KEEP, and a binary the fork deleted upstream would be gone for good;
    - what an operator HOLDS (turn-holds.json: fork:<turn fork> · fork:csqtt · wdtt:<fork>);
    - each of our forks' CURRENT build (what an install pins now).
    An owner a node reports WITHOUT a version is "*" in its set: nothing of it is pruned but a dir with no binary.
    Snapshots and holds are written by others: a field of the wrong type is skipped, never fatal."""
    sd = (getattr(Handler, "deps", None) or {}).get("stats_dir")
    if not sd or not os.path.isdir(sd):
        return None
    wdtt_owner = {fork: owner for owner, fork in _WDTT_OWNER_FORK.items()}
    need = {}
    def add(owner, tag):
        if owner:
            need.setdefault(owner, set()).add(_turn_safe(tag) if tag else "*")
    def text(x):
        return x if isinstance(x, str) else ""
    def rows(snap, key):
        v = snap.get(key)
        return [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []
    for owner, fork in _WDTT_OWNER_FORK.items():
        add(owner, _wdtt_current_version(fork) or None)
    for _cl in CSQTT_LINES:                   # every line's current build — 2.1's alone would let the prune take 2.5's
        if CSQTT_LINES[_cl]:
            add(CSQTT_MIRROR_OWNER, _csqtt_current_version(_cl))
    for k, v in (_turn_holds_load() or {}).items():
        rest = str(k).partition("|")[2]
        tag = (v.get("tag") if isinstance(v, dict) else v) or None
        if rest.startswith("wdtt:"):
            add(wdtt_owner.get(rest[5:]), tag)
        elif rest == "fork:csqtt" or rest.startswith("fork:csqtt@"):
            add(CSQTT_MIRROR_OWNER, tag)
        elif rest.startswith("fork:"):
            add(turn_fork_owner(rest[5:]), tag)
    try:
        names = [n for n in os.listdir(sd) if n.startswith("stats-") and n.endswith(".json")]
    except OSError:
        return None
    for n in names:
        try:
            with open(os.path.join(sd, n)) as fh:
                snap = json.load(fh)
            if not isinstance(snap, dict):
                raise ValueError("not a JSON object")
        except Exception as e:                # it might name a version: prune nothing — and say so once, or it never ends
            if n not in _TURN_PRUNE_WARNED:
                _TURN_PRUNE_WARNED.add(n)
                log(LOG_WARNING, "turn store: not pruned — %s cannot be read (%s)", os.path.join(sd, n), e)
            return None
        for w in rows(snap, "wdtt"):
            add(wdtt_owner.get(text(w.get("fork"))), w.get("version"))
        for c in rows(snap, "csqtt"):
            add(CSQTT_MIRROR_OWNER, c.get("version"))
        for t in rows(snap, "turn_proxies"):
            add(text(t.get("owner")) or turn_fork_owner(turn_fork(text(t.get("service")))), t.get("version"))
    return need


def _turn_bins_prune(owner, need=None):
    """Bound the store — the rollback cache, and for a turn proxy the rollback MENU (turn_available_tags) — without ever
    removing a version something needs (_turn_bins_needed) or the pseudo-tag a node with no version asks under (`wdtt` /
    `csqtt`: the current build). Removed, an hour old: a dir with no binary (a failed fetch — a needed tag's too, there is
    nothing in it to keep); a build of OURS no longer advertised (WDTT_BUILDS / CSQTT_BUILDS — no picker offers it; one
    fetched within the hour is being served). Then, of the dirs holding a binary, the newest TURN_BINS_KEEP by when it
    landed stay and an unneeded older one goes. A dir a download is writing into is left alone; a download's temp file an
    hour old goes from any dir (a crash mid-fetch). Not knowing what is needed prunes nothing.
    `need`: _turn_bins_needed(), computed here when not given."""
    if need is None:
        need = _turn_bins_needed()
    if need is None:
        return
    keep = set(need.get(owner) or ())
    if owner in _WDTT_OWNER_FORK:
        advertised = {_turn_safe(v) for v, _ in _wdtt_versions(_WDTT_OWNER_FORK[owner])}
        keep.add("wdtt")
    elif owner == CSQTT_MIRROR_OWNER:
        advertised = {_turn_safe(v) for _b in CSQTT_LINES.values() for v, _ in _b}   # every line's: CSQTT_BUILDS is 2.1's alone
        keep.add("csqtt")
    else:
        advertised = None                     # an upstream fork: what it publishes is not ours to judge
    cut = [k for k in keep if len(k) == _TURN_VER_CUT]   # a version swg-noded cut short: every tag it begins is needed
    d = os.path.join(TURN_BINS_DIR, _turn_safe(owner))
    landed, live = {}, set()                  # landed: dir -> when its binary landed (the ranking) · live: may go by count
    for t in sorted(_turn_files(d)):
        p = os.path.join(d, t)
        if not os.path.isdir(p):
            continue
        for f in _turn_files(p):              # a temp file an hour old is a fetch that died with its process (needed dirs too)
            if ".dl." in f and (_turn_age(os.path.join(p, f)) or 0) > 3600:
                with contextlib.suppress(OSError):
                    os.remove(os.path.join(p, f))
        age, at = _turn_age(p), _turn_mirrored_at(p)
        if age is None:
            continue                          # gone under us
        if at is not None:
            landed[p] = at
        if any(".dl." in f for f in _turn_files(p)):
            continue                          # a download is writing into it
        if at is None:
            if age > 3600:
                shutil.rmtree(p, ignore_errors=True)
                log(LOG_INFO, "turn store: removed %s/%s — no binary in it (a failed fetch)", owner, t)
            continue
        if "*" in keep or t in keep or any(t.startswith(k) for k in cut):
            continue                          # needed — or a node runs this fork at a version it did not report
        if advertised is not None and t not in advertised:
            if age > 3600:
                shutil.rmtree(p, ignore_errors=True)
                landed.pop(p, None)
                log(LOG_INFO, "turn store: removed %s/%s — a build no longer offered, and nothing runs or holds it",
                    owner, t)
            continue
        live.add(p)
    if "*" in keep:
        return
    for p in sorted(landed, key=landed.get, reverse=True)[TURN_BINS_KEEP:]:   # newest first
        if p in live:
            shutil.rmtree(p, ignore_errors=True)
            log(LOG_INFO, "turn store: removed %s/%s — older than the newest %d, and nothing runs or holds it",
                owner, os.path.basename(p), TURN_BINS_KEEP)


def _turn_bins_prune_soon(owner):
    """After a fetch, prune `owner` on a thread of its own: the request that fetched — often a node waiting for the bytes —
    never waits on the snapshot parse, and a prune cannot raise into it. One at a time per owner: a fetch that lands while
    one runs is pruned by the next (its dir is the newest and an hour young — nothing removes it meanwhile)."""
    with _TURN_PRUNING_LOCK:
        if owner in _TURN_PRUNING:
            return
        _TURN_PRUNING.add(owner)
    def _run():
        try:
            _turn_bins_prune(owner)
        except Exception as e:
            log(LOG_WARNING, "turn store: pruning %s stopped (%s) — what it had not reached stays", owner, e)
        finally:
            with _TURN_PRUNING_LOCK:
                _TURN_PRUNING.discard(owner)
    threading.Thread(target=_run, name="turn-store-prune", daemon=True).start()


def _turn_bins_prune_all():
    """Every fork in the store, once (at start): a leftover otherwise waits for that fork's next download. A dir that maps
    to no owner the panel knows is left alone."""
    need = _turn_bins_needed()
    if need is None:
        return
    owners = set(_WDTT_OWNER_FORK) | {CSQTT_MIRROR_OWNER} | {s.get("owner") for s in TURN_SERVERS.values() if s.get("owner")}
    with _TURN_SUMS_LOCK:
        owners |= {k.split("|")[0] for k in _TURN_SUMS}
    by_dir = {_turn_safe(o): o for o in owners if o and "/" in o}
    for dn in sorted(_turn_files(TURN_BINS_DIR)):
        if dn in by_dir:
            try:
                _turn_bins_prune(by_dir[dn], need)
            except Exception as e:
                log(LOG_WARNING, "turn store: pruning %s stopped (%s) — what it had not reached stays", by_dir[dn], e)


def turn_sum(owner, tag, arch, need_file=False):
    """sha256 of a fork's release binary at a PINNED tag — fetched once, the BYTES KEPT in the mirror store, the
    hash cached + persisted. "" if the panel can't fetch/hash it (only successes are cached, so a transient failure
    retries). The on-disk mirrored file is the SOURCE OF TRUTH: it is exactly what the node pulls (_node_turn_binary
    streams it), so whenever it's present we hash IT and refresh the cache to match. A cached sum could otherwise
    drift from the file (a racing re-fetch overwrote the bytes) — and a drifted pin makes the node reject the CORRECT
    binary with a checksum mismatch, silently breaking rollback/update.
    `need_file`: the caller serves the bytes (_node_turn_binary). A binary the store pruned keeps its remembered hash —
    enough to build a pin — so without this it was answered with the hash alone and served as a 404, forever: the
    mirror never fetched it again. With it the binary is fetched again, and the file is the truth again, as above: a
    release whose bytes changed since it was pinned is said, and the pin follows the file."""
    if not owner or "/" not in owner or not tag or arch not in TURN_ARCHES:
        return ""
    key = owner + "|" + tag + "|" + arch
    dest = _turn_store_path(owner, tag, arch)
    _st = None
    with contextlib.suppress(OSError):
        _st = os.stat(dest)
    if _st is not None and _st.st_size > 0:                   # mirrored → hash the FILE (authoritative), reconcile cache
        _stamp = (_st.st_mtime_ns, _st.st_size, _st.st_ino)
        with _TURN_SUMS_LOCK:
            _hot = _TURN_SUM_STAT.get(key)
        if _hot and _hot[0] == _stamp:
            return _hot[1]
        with contextlib.suppress(OSError):
            _fsha = _turn_sha256_file(dest)
            if _fsha:
                with _TURN_SUMS_LOCK:
                    _TURN_SUM_STAT[key] = (_stamp, _fsha)
                    if _TURN_SUMS.get(key) != _fsha:
                        _TURN_SUMS[key] = _fsha
                        with contextlib.suppress(Exception):
                            atomic_write(TURN_SUMS_PATH, json.dumps(_TURN_SUMS) + "\n", mode=0o600)
                return _fsha
    with _TURN_SUMS_LOCK:                 # file pruned but the sum is remembered → still lets a pin build
        cached = _TURN_SUMS.get(key)
    if cached and not need_file:
        return cached
    with _TURN_SUM_SEM:
        with _TURN_SUMS_LOCK:             # re-check: a peer may have filled it while we queued on the semaphore
            cached = _TURN_SUMS.get(key)
        if cached and not need_file:
            return cached
        sha = ""
        if os.path.isfile(dest) and os.path.getsize(dest) > 0:   # a peer just mirrored it → hash from disk
            with contextlib.suppress(OSError):
                sha = _turn_sha256_file(dest)
        else:
            try:
                os.makedirs(os.path.dirname(dest), exist_ok=True)
            except OSError:
                return ""
            with contextlib.suppress(OSError):   # a dir a failed fetch left an hour ago is "no binary, old" to the prune
                os.utime(os.path.dirname(dest), None)   # until curl writes its temp file — make it fresh first
            tmp = dest + ".dl." + str(os.getpid())
            try:
                r = subprocess.run(["curl", "-4", "-fsSL", "--connect-timeout", "15", "--max-time", "180",
                                    "--retry", "2", "--retry-delay", "2", _turn_asset_url(owner, tag, arch), "-o", tmp],
                                   capture_output=True, text=True, timeout=200)
                if r.returncode == 0 and os.path.isfile(tmp) and os.path.getsize(tmp) > 0:
                    sha = _turn_sha256_file(tmp)
                    os.replace(tmp, dest)   # KEEP the bytes — the mirror store (node pulls from here; rollback cache)
                    if cached and sha != cached:   # fetched again (it was pruned) — and the release's bytes changed
                        log(LOG_WARNING, "turn store: %s %s %s fetched again, and its sha256 is not the one it was pinned "
                            "with — the pin follows the file (a node pinned to the old one is refused it until then)",
                            owner, tag, arch)
            except Exception:
                sha = ""
            finally:
                with contextlib.suppress(OSError):
                    os.remove(tmp)
        if sha and sha != cached:         # cache successes only — a transient fetch failure must not pin "unverifiable" forever
            with _TURN_SUMS_LOCK:
                _TURN_SUMS[key] = sha
                with contextlib.suppress(Exception):
                    atomic_write(TURN_SUMS_PATH, json.dumps(_TURN_SUMS) + "\n", mode=0o600)
    if sha:
        _turn_bins_prune_soon(owner)      # in the background: never on this request, never holding a download slot
    return sha

def _node_arch(deps, nid):
    """The install-target node's arch, from its snapshot → so turn_pin fetches ONLY that arch. [arch] or None
    (unknown/old node → fall back to both arches)."""
    a = ((deps.get("node_snaps") or {}).get(nid) or {}).get("arch")
    return [a] if a in TURN_ARCHES else None

def turn_pin_tag(owner, tag, arches=None):
    """Pin a SPECIFIC (older) tag for a ROLLBACK — {tag, sums:{arch:sha}} straight from the mirror store (instant
    for a cached tag; fetches otherwise). No latest-resolve, no pin cache. {}/partial sums if the tag can't be
    mirrored — the caller rejects an empty pin so a rollback never proceeds to an unverifiable binary."""
    owner = (owner or "").strip()
    if not owner or "/" not in owner or not tag:
        return {}
    want = [a for a in (arches or TURN_ARCHES) if a in TURN_ARCHES] or list(TURN_ARCHES)
    sums = {}
    for a in want:
        s = turn_sum(owner, tag, a)
        if s:
            sums[a] = s
    return {"tag": tag, "sums": sums}

def turn_available_tags(owner):
    """The fork's mirrored tags — the rollback cache — newest-first: [{tag, arches:[...], at}]. Real tags come from
    the sums map (the on-disk dir names are sanitised) filtered to those whose binary is still present (not pruned)."""
    owner = (owner or "").strip()
    out = {}
    if owner and "/" in owner:
        with _TURN_SUMS_LOCK:
            keys = list(_TURN_SUMS.keys())
        for k in keys:
            p = k.split("|")
            if len(p) != 3 or p[0] != owner:
                continue
            tag, arch = p[1], p[2]
            fp = _turn_store_path(owner, tag, arch)
            with contextlib.suppress(OSError):
                if os.path.isfile(fp) and os.path.getsize(fp) > 0:
                    e = out.setdefault(tag, {"tag": tag, "arches": [], "at": 0})
                    if arch not in e["arches"]:
                        e["arches"].append(arch)
                    e["at"] = max(e["at"], int(os.path.getmtime(fp)))
    res = list(out.values())
    res.sort(key=lambda x: x["at"], reverse=True)
    return res

def _turn_holds_load():
    with contextlib.suppress(Exception):
        with open(TURN_HOLDS_PATH) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return d
    return {}

def _turn_hold_set(nid, svc, tag):
    with _TURN_HOLDS_LOCK:
        d = _turn_holds_load(); d[str(nid) + "|" + str(svc)] = {"tag": tag, "at": int(time.time())}
        with contextlib.suppress(Exception):
            atomic_write(TURN_HOLDS_PATH, json.dumps(d) + "\n", mode=0o600)

def _turn_hold_clear(nid, svc):
    with _TURN_HOLDS_LOCK:
        d = _turn_holds_load()
        if d.pop(str(nid) + "|" + str(svc), None) is not None:
            with contextlib.suppress(Exception):
                atomic_write(TURN_HOLDS_PATH, json.dumps(d) + "\n", mode=0o600)

def _turn_hold_get(nid, svc):
    return (_turn_holds_load().get(str(nid) + "|" + str(svc)) or {}).get("tag") or ""

def _turn_holds_migrate():
    """One-time: legacy per-SERVICE rollback holds → per (node, fork). Before the shared-binary fix a hold was keyed
    '<nid>|<service>'; now it's '<nid>|fork:<fork>' (a fork shares one binary per node). Convert legacy keys so an
    existing hold keeps holding instead of silently releasing. Runs at startup; a no-op once migrated."""
    d = _turn_holds_load()
    changed = False
    for k in list(d.keys()):
        nid, sep, rest = str(k).partition("|")
        if not sep or rest.startswith("fork:") or rest.startswith("wdtt:"):
            continue                                  # already per-fork/wdtt, or malformed
        fork = turn_fork(rest)                         # rest = the legacy service name → its fork
        if fork:
            d.setdefault(nid + "|fork:" + fork, d[k])  # keep the first if two same-fork services were both held
        del d[k]; changed = True
    if changed:
        with _TURN_HOLDS_LOCK:
            with contextlib.suppress(Exception):
                atomic_write(TURN_HOLDS_PATH, json.dumps(d) + "\n", mode=0o600)

def _turn_holds_view():
    """Per (node, fork) rollback holds for the UI (the fork-row 'held' flag). Keys are '<nid>|fork:<fork>' (-connect)
    or '<nid>|wdtt:<fork>' (WDTT); both collapse to {nid: {fork: held_version}}. Legacy per-svc keys are ignored."""
    out = {}
    for k, v in (_turn_holds_load() or {}).items():
        nid, _, rest = str(k).partition("|")
        fork = rest[5:] if (rest.startswith("fork:") or rest.startswith("wdtt:")) else ""
        tag = (v or {}).get("tag") or ""
        if nid and fork and tag:
            out.setdefault(nid, {})[fork] = tag
    return out

def turn_pin(owner, arches=None, wait=25, force=False):
    """{tag, sums:{arch:sha}} for a fork's latest release, attached to an install/reinstall request so the node
    pins + verifies. Fetches ONLY the target arch(es) (an install targets ONE node → one arch — no wasted/failing
    cross-arch fetch), in PARALLEL, with a BOUNDED wait so a slow/flaky GitHub fetch never blocks the request for
    long. Any arch not fetched within `wait` keeps mirroring in the BACKGROUND (daemon), so a later re-pin picks it
    up → the checksum gate self-heals instead of staying fail-open. {} if the tag is unresolvable."""
    owner = (owner or "").strip()
    if not owner or "/" not in owner:
        return {}
    want = [a for a in (arches or TURN_ARCHES) if a in TURN_ARCHES] or list(TURN_ARCHES)
    now = time.time()
    if not force:
        c = _TURN_PIN_CACHE.get(owner)
        if c and (now - c["at"]) < _TURN_PIN_TTL and all(a in (c["pin"].get("sums") or {}) for a in want):
            return c["pin"]                          # cached AND covers every wanted arch
    tag = _resolve_turn_tag(owner)
    if not tag:
        c = _TURN_PIN_CACHE.get(owner)
        return c["pin"] if c else {}                 # keep the last good pin if the tag is momentarily unreachable
    sums, threads = {}, []
    for a in want:
        with _TURN_SUMS_LOCK:
            cached = _TURN_SUMS.get(owner + "|" + tag + "|" + a)
        if cached:
            sums[a] = cached
        else:                                        # daemon: keeps mirroring past the deadline (populates _TURN_SUMS + the store)
            t = threading.Thread(target=turn_sum, args=(owner, tag, a), daemon=True)
            t.start(); threads.append((a, t))
    deadline = now + max(1, wait)
    for a, t in threads:
        t.join(max(0.1, deadline - time.time()))
        with _TURN_SUMS_LOCK:
            s = _TURN_SUMS.get(owner + "|" + tag + "|" + a)
        if s:
            sums[a] = s
    pin = {"tag": tag, "sums": sums}
    _TURN_PIN_CACHE[owner] = {"pin": pin, "at": now}   # a late daemon fills _TURN_SUMS → the next re-pin returns the complete pin
    return pin


TURN_LATEST = {"forks": {}, "checked": 0}   # fork id -> newest installable version (ours for what we build, upstream's tag otherwise)


def _turn_hold_key(kind, fork):
    """Rollback holds are keyed 'wdtt:<fork>' for the WDTT family and 'fork:<fork>' for everything else (csqtt
    included — see _csqtt_reply). One helper so a caller never has to remember which."""
    return ("wdtt:" + fork) if kind == "wdtt" else ("fork:" + fork)


def _turn_deployed(deps):
    """[(fork, kind, node, iface_or_service, installed_version)] for every turn-family server the fleet reports."""
    out = []
    for nid, snap in list((deps.get("node_snaps") or {}).items()):   # a copy — syncs insert and removals pop meanwhile
        if not isinstance(snap, dict):
            continue
        for c in (snap.get("csqtt") or []):
            if isinstance(c, dict) and c.get("iface"):
                _cf = (c.get("fork") or "").strip() or "csqtt"
                _cl = str(c.get("line") or "").strip()
                if _cl and _cl != CSQTT_DEFAULT_LINE:
                    _cf += "@" + _cl
                out.append((_cf, "csqtt", nid, c["iface"], str(c.get("version") or "").strip()))
        for w in (snap.get("wdtt") or []):
            if isinstance(w, dict) and w.get("iface") and w.get("fork"):
                out.append((w["fork"], "wdtt", nid, w["iface"], str(w.get("version") or "").strip()))
        for tp in (snap.get("turn_proxies") or []):
            if isinstance(tp, dict) and tp.get("service"):
                out.append((turn_fork(tp["service"]), "turn", nid, tp["service"], str(tp.get("version") or "").strip()))
    return out


def _wdtt_unbuilt(fork):
    """A WDTT fork with no build of ours (xxcipherx since 2026-10-14: hidden, its releases gone). A node installs WDTT only
    from OUR releases, so its upstream tag is nothing it can install: offering it put a row in Server updates whose
    Update could never do anything, on every server still running the fork (swgt, 2026-10-16)."""
    return fork not in WDTT_BUILDS and (TURN_SERVERS.get(fork) or {}).get("kind") == "wdtt"


def _turn_latest_for(fork):
    """The newest installable version of a fork. Same rule as /api/turn/check-updates — OUR published build for
    the ones we compile, the upstream release tag otherwise — so the header badge and that screen can never
    disagree about whether something is behind."""
    if fork in WDTT_BUILDS:
        return _wdtt_current_version(fork)
    if fork == "csqtt" or fork.startswith("csqtt@"):
        return _csqtt_current_version(fork.partition("@")[2] or CSQTT_DEFAULT_LINE)
    if _wdtt_unbuilt(fork):
        return ""
    owner = turn_fork_owner(fork)
    return _resolve_turn_tag(owner) if owner and "/" in owner else ""


def _check_turn_latest(deps):
    """Refresh the latest-version cache for the DEPLOYED forks only. Each unknown fork costs a network round trip,
    and one that is not deployed anywhere can never produce an actionable update — so the cost tracks the fleet,
    not the catalogue. Returns True if anything resolved."""
    got = {}
    for fork in sorted({f for f, _, _, _, _ in _turn_deployed(deps) if f}):
        with contextlib.suppress(Exception):
            v = _turn_latest_for(fork)
            if v:
                got[fork] = v
    TURN_LATEST["forks"] = got
    TURN_LATEST["checked"] = int(time.time())
    return bool(got)


def _turn_behind(inst, latest):
    """Is `inst` genuinely older than `latest`? Plain inequality was wrong: it reported a server running
    something NEWER than the published release as "behind" and offered the downgrade — the mistake _ver_behind
    exists to prevent for the panel's own version. That helper cannot be reused, because _vtuple rejects both
    schemes that meet here: upstream tags carry a leading "v" ("v3.2.0"), and OUR rebuilds carry a build suffix
    on an unchanged upstream version ("1.2.4" -> "1.2.4-2"), which the numeric triple alone cannot see.

    So: compare the triple ignoring a leading "v", strictly-older only; if the triples match but the strings
    differ, that IS one of our rebuilds; and if either side has no parseable triple, fall back to inequality —
    we cannot order them, and staying silent would hide a real update behind an unusual tag."""
    inst, latest = str(inst or "").strip(), str(latest or "").strip()
    if not inst or not latest or inst.lstrip("vV") == latest.lstrip("vV"):   # "2.0.0.72" is "v2.0.0.72"
        return False
    a, b = _vtuple(inst.lstrip("vV")), _vtuple(latest.lstrip("vV"))
    if a == (0, 0, 0) or b == (0, 0, 0):
        return True
    return a < b if a != b else True


def turn_updates_view(deps):
    """Actionable turn-family updates, ONE ROW PER (fork, node) — which is the real update unit: csqtt keeps one
    binary per node and WDTT one per (fork, node), so every instance there restarts together. Counting
    INTERFACES would promise work that does not exist (updating one csqtt server updates them all on that box).

    A HELD fork is a deliberate not-latest and is never counted as behind, or the badge could never clear for an
    operator who pinned on purpose. Comparison is plain inequality, matching the SPA's existing rule: the version
    strings are not a single scheme ("1.2.4-2" ours, "v3.2.0" upstream) and ordering them would invent meaning."""
    latest = TURN_LATEST.get("forks") or {}
    rows = {}
    for fork, kind, nid, ident, inst in _turn_deployed(deps):
        lt = latest.get(fork) or ""
        if not _turn_behind(inst, lt):
            continue
        if _turn_hold_get(nid, _turn_hold_key(kind, fork)):
            continue
        _fk, _, _ln = fork.partition("@")   # a csqtt line's internal id → the fork and the line, apart (the SPA labels the fork)
        r = rows.setdefault((fork, nid), {"fork": _fk, "kind": kind, "node": nid,
                                          "installed": inst, "latest": lt, "ids": [], **({"line": _ln} if _ln else {})})
        r["ids"].append(ident)
    return sorted(rows.values(), key=lambda r: (r["fork"], r.get("line", ""), r["node"]))


def _remote_version_loop():
    while True:
        _check_latest_remote()
        with contextlib.suppress(Exception):
            _check_turn_latest(getattr(Handler, "deps", None) or {})   # same cadence as the panel's own version
        time.sleep(60 * 60)   # every hour — the header reflects a freshly-published release within the hour (the "check" icon is still there for an instant, on-demand refresh)


# ── turn-proxy auto-update (panel-driven; see PANEL_SETTINGS_DEFAULTS["turn_update"]) ──
def _turn_update_due(sched, last_ts, now_ts):
    """every_days=0 → never (OFF). Else due when >= every_days elapsed since the last check AND now is inside the
    60-min window opening at the panel-local `at` time — so the fleet-wide restart lands at a chosen quiet hour."""
    ev = int((sched or {}).get("every_days") or 0)
    if ev <= 0:
        return False
    if now_ts - last_ts < ev * 86400 - 1800:              # not enough days since the last check (30-min slack)
        return False
    at = str((sched or {}).get("at") or "04:00")
    try:    hh, mm = int(at.split(":")[0]), int(at.split(":")[1])
    except Exception: hh, mm = 4, 0
    lt = time.localtime(now_ts); cur = lt.tm_hour * 60 + lt.tm_min; start = hh * 60 + mm
    return start <= cur < start + 60


def _turn_autoupdate_tick():
    deps = getattr(Handler, "deps", None) or {}
    psp = deps.get("panel_settings_path")
    if not psp:
        return
    sched = (load_panel_settings(psp) or {}).get("turn_update") or {}
    if int(sched.get("every_days") or 0) <= 0:            # OFF — nothing scheduled
        return
    marker = os.path.join(os.path.dirname(deps.get("nodes_path") or ".") or ".", "turn_update_last")
    try:    last_ts = int((open(marker).read().strip() or "0"))
    except Exception: last_ts = 0
    now_ts = int(time.time())
    if not _turn_update_due(sched, last_ts, now_ts):
        return
    snaps = dict(deps.get("node_snaps") or {})
    nodes = nodes_load(deps["nodes_path"])
    latest = {}                                           # fork -> latest release tag (one resolve per fork)
    todo = []                                             # (nid, svc, owner, tag) — what pass 1 found out of date
    for nid, snap in snaps.items():
        if nid not in nodes or not isinstance(snap, dict):
            continue
        if snap.get("turn_manage") is False or snap.get("turn_capable") is False:
            continue
        for tp in (snap.get("turn_proxies") or []):
            svc = (tp.get("service") or "").strip(); ver = (tp.get("version") or "").strip()
            if not svc or not ver:
                continue
            fork = turn_fork(svc)
            if fork not in ("samosvalishe", "WINGS-N") or tp.get("stopped"):
                continue
            owner = turn_fork_owner(fork)
            if _turn_hold_get(nid, "fork:" + fork):      # operator rolled this fork back to a specific version → don't auto-roll it forward (per node+fork: the binary is shared)
                continue
            if fork not in latest:
                latest[fork] = _resolve_turn_tag(owner)
            tag = latest[fork]
            if not tag or tag == ver:                    # unreachable, or already current
                continue
            if (nodes[nid].get("turn") or {}).get(svc):     # ANY pending action (re-checked under the lock) — skip its pin fetch
                continue
            todo.append((nid, svc, fork, owner, tag))
    if todo:
        pins = {(nid, owner): turn_pin(owner, _node_arch(deps, nid)) for nid, _svc, _f, owner, _tag in todo}   # checksum gate (this node's arch; bounded+bg)
        with _api_lock:
            nodes = nodes_load(deps["nodes_path"])       # the store as it is NOW
            live = deps.get("node_snaps") or {}
            staged = []
            for nid, svc, fork, owner, tag in todo:
                if nid not in nodes:                     # removed while GitHub answered
                    continue
                # ⚠️ ANY pending action wins — a delete, stop, install or rotate the operator staged is theirs; overwriting
                # it with a reinstall resurrected a deleted proxy (the pre-2026-09-18 check looked only for "reinstall").
                if (nodes[nid].get("turn") or {}).get(svc):
                    continue
                if _turn_hold_get(nid, "fork:" + fork):  # rolled back while pass 1 fetched → the hold stands
                    continue
                _now_v = {(t or {}).get("service"): (t or {}).get("version") for t in ((live.get(nid) or {}).get("turn_proxies") or [])}
                if svc not in _now_v or _now_v[svc] == tag:
                    continue                             # gone from the node, or already updated, meanwhile — nothing to do
                pin = pins[(nid, owner)]
                if not pin or pin.get("tag") != tag or not pin.get("sums"):
                    continue
                nodes[nid].setdefault("turn", {})[svc] = {"action": "reinstall", "at": now_ts, "owner": owner,
                                                          "auto": True, "pin": pin}
                staged.append((nid, svc, tag))
            if staged:
                nodes_save(deps["nodes_path"], nodes)
                _invalidate_state_cache()
        for nid, svc, tag in staged:
            with contextlib.suppress(Exception):
                ev_append(deps["roster_path"], "node", nid, "Auto-updating turn-proxy", svc + " → " + tag)
    with contextlib.suppress(Exception):                 # record the check ran (even if nothing changed) → fire once per window
        atomic_write(marker, str(now_ts))


def _turn_update_loop():
    while True:
        with contextlib.suppress(Exception):
            _turn_autoupdate_tick()
        time.sleep(15 * 60)                              # re-evaluate the schedule window every 15 min

_ASSET_Q = {}


def _asset_q(fname):
    """b"?v=<version>.<hash>" for fname — cached; falls back to the bare version if the file can't be read."""
    q = _ASSET_Q.get(fname)
    if q is not None:
        return q
    base = (VERSIONS.get("panel") or "").strip()
    h = ""
    with contextlib.suppress(Exception):
        with open(os.path.join(WEB_DIR, fname), "rb") as f:
            h = hashlib.sha1(f.read()).hexdigest()[:8]
    tag = base + ("." + h if h else "")
    q = (("?v=" + quote(tag, safe="")) if tag else "").encode()
    _ASSET_Q[fname] = q
    return q


# SPA js/ modules: ONE shared cache key for the whole tree
_JS_TREE = {"sig": None, "q": b""}


def _js_dir():
    return os.path.join(WEB_DIR, "js")


def _js_tree_q():
    """b"?v=<version>.<hash-of-every-js-module>" — the shared cache key for js/*.js.

    The signature covers everything that determines the SERVED bytes: each module's content, and this
    server's own build. The second half matters because _stamp_imports rewrites the modules on the way
    out — change the rewriting without touching js/ or VERSION and the key would otherwise stand still
    while the bytes moved, and an `immutable` client would keep the old copy."""
    sig, names, srv = [], [], b""
    with contextlib.suppress(Exception):
        _st = os.stat(os.path.abspath(__file__))
        srv = ("%d.%d" % (_st.st_mtime_ns, _st.st_size)).encode()
        sig.append(("<server>", int(_st.st_mtime_ns), _st.st_size))
    with contextlib.suppress(Exception):
        for root, _dirs, files in os.walk(_js_dir()):
            for fn in files:
                if fn.endswith(".js"):
                    p = os.path.join(root, fn)
                    with contextlib.suppress(OSError):
                        st = os.stat(p)
                        names.append(p)
                        sig.append((os.path.relpath(p, _js_dir()), int(st.st_mtime_ns), st.st_size))
    sig.sort()
    if sig == _JS_TREE["sig"]:
        return _JS_TREE["q"]
    h = hashlib.sha1()
    h.update(srv)                     # this build rewrites the modules on the way out — see the docstring
    for p in sorted(names):
        with contextlib.suppress(OSError):
            h.update(os.path.relpath(p, _js_dir()).encode())
            with open(p, "rb") as f:
                h.update(f.read())
    base = (VERSIONS.get("panel") or "").strip()
    tag = base + ("." + h.hexdigest()[:8] if names else "")
    _JS_TREE["sig"] = sig
    _JS_TREE["q"] = (("?v=" + quote(tag, safe="")) if tag else "").encode()
    return _JS_TREE["q"]


_IMPORT_SPEC_RE = re.compile(rb'((?:from|import)\s*\(?\s*")(\.{1,2}/[A-Za-z0-9_./-]+\.js)(")')


def _stamp_imports(data, rel):
    """Version-stamp every relative import inside a served .js (see _js_tree_q / _asset_q).

    `rel` is the WEB_DIR-relative path of the file being served, and specifiers resolve against ITS
    directory — "./util.js" inside js/store.js is js/util.js, not util.js. Resolving against WEB_DIR
    instead mints a different ?v= for the same file than the one app.js asks for, and the browser then
    fetches and INSTANTIATES the module twice: two copies of its state, silently."""
    base = os.path.dirname(rel)
    def one(m):
        spec = m.group(2).decode("utf-8", "replace")           # "./util.js" | "../reconcile.js"
        target = os.path.normpath(os.path.join(base, spec)).replace(os.sep, "/")
        q = _js_tree_q() if target.startswith("js/") else _asset_q(target)
        return m.group(1) + m.group(2) + q + m.group(3)
    return _IMPORT_SPEC_RE.sub(one, data)


_JS_MODULE_RE = re.compile(r"^/js/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\.js$")
# The phone UI's directory (docs/MOBILE-PLAN.md): its stylesheet, the app manifest and the icons. Flat, three kinds only.
_M_ASSET_RE = re.compile(r"^/m/[A-Za-z0-9_.-]+\.(?:css|png|webmanifest)$")


def static_rel(path):
    """WEB_DIR-relative file for a static request path, or None if it isn't one. Path containment is still
    enforced by _static's realpath check — this only decides what is offered."""
    if path in STATIC:
        return STATIC[path]
    if ".." not in path and (_JS_MODULE_RE.match(path) or _M_ASSET_RE.match(path)):
        return path.lstrip("/")
    return None


