    return HRRD_HEAD.size + sum(n for _, n in HRRD_RINGS[:i]) * HRRD_SLOT.size
_hrrd_lock = threading.Lock()

def _pctb(v):  return HRRD_NA if v == HRRD_NA else max(0, min(254, int(v)))
def _u32b(v):  return max(0, min(HRRD_U32, int(v)))
def _u16b(v):  return max(0, min(HRRD_U16, int(v)))


def snap_aggregates(snap, node_cfg):
    ov = (node_cfg or {}).get("ifaces") or {}
    a = {k: 0 for k in ("rx", "tx", "arx", "atx", "mrx", "mtx", "pon", "ptot", "paon", "patot")}
    for ifn, blk in ((snap or {}).get("interfaces") or {}).items():
        meta = blk.get("meta") or {}
        o = ov.get(ifn) or {}
        is_sys = bool(o.get("system") or meta.get("system"))
        is_awg = bool(meta.get("awg_params") or o.get("awg_params"))
        irx = itx = on = tot = 0
        for p in (blk.get("peers") or []):
            irx += p.get("rx_speed", 0) or 0
            itx += p.get("tx_speed", 0) or 0
            if not is_sys:
                tot += 1
                if p.get("online"):
                    on += 1
        a["rx"] += irx; a["tx"] += itx
        if is_sys:
            a["mrx"] += irx; a["mtx"] += itx
        else:
            a["pon"] += on; a["ptot"] += tot
            if is_awg:
                a["arx"] += irx; a["atx"] += itx; a["paon"] += on; a["patot"] += tot
    for w in ((snap or {}).get("wdtt") or []):
        if not w:
            continue
        wr = int(w.get("rx_speed", 0) or 0); wt = int(w.get("tx_speed", 0) or 0)
        a["rx"] += wr; a["tx"] += wt
        devs = (w.get("passwords") or {})
        on = sum(1 for e in devs.values() if (e or {}).get("online"))
        a["pon"] += on; a["ptot"] += len(devs)
    for c in ((snap or {}).get("csqtt") or []):
        if not c:
            continue
        a["rx"] += int(c.get("rx_speed", 0) or 0); a["tx"] += int(c.get("tx_speed", 0) or 0)
        devs = (c.get("passwords") or {})
        a["pon"] += sum(1 for e in devs.values() if (e or {}).get("online")); a["ptot"] += len(devs)
    return a


def snap_traffic(snap):
    rx = tx = 0
    for blk in ((snap or {}).get("interfaces") or {}).values():
        for p in (blk.get("peers") or []):
            rx += p.get("rx_speed", 0) or 0
            tx += p.get("tx_speed", 0) or 0
    return int(rx), int(tx)


CPU_SAT_PCT = 90


def health_pcts(health):
    if not isinstance(health, dict):
        return None
    def pc(used, total):
        return HRRD_NA if not total else max(0, min(100, round(used / total * 100)))
    cpu = HRRD_NA
    cpu_pct = health.get("cpu_pct")
    load = health.get("load")
    if isinstance(cpu_pct, (int, float)):
        cpu = max(0, min(100, round(cpu_pct)))
    elif isinstance(load, list) and load:
        cpu = max(0, min(254, round((load[0] or 0) / (health.get("ncpu") or 1) * 100)))
    m = health.get("mem") or {}
    mem = pc(m.get("used", 0), m.get("total", 0))
    disk = HRRD_NA
    for d in (health.get("disk") or []):
        if d.get("total"):
            disk = max(0 if disk == HRRD_NA else disk, pc(d["used"], d["total"]))
    return (cpu, mem, disk)


def _hrrd_ok(path):
    try:
        with open(path, "rb") as f:
            magic, ver, step, slots = HRRD_HEAD.unpack(f.read(HRRD_HEAD.size))
        return magic == HRRD_MAGIC and ver == HRRD_VER and (step, slots) == HRRD_RINGS[0]
    except (OSError, struct.error):
        return False


def _bucket_of(ts, step):
    off = time.localtime(ts).tm_gmtoff or 0
    return ((int(ts) + off) // step) & 0xFFFFFFFF


def _bucket_epoch(bucket, step):
    wall = bucket * step
    return wall - (time.localtime(wall).tm_gmtoff or 0)


def _avg_pct(old, new, cnt):
    if new == HRRD_NA: return old
    if old == HRRD_NA or cnt <= 0: return new
    return max(0, min(254, round((old * cnt + new) / (cnt + 1))))


def _avg_u(old, new, cnt, cap):
    new = min(max(int(new), 0), cap)
    if cnt <= 0: return new
    return min(round((old * cnt + new) / (cnt + 1)), cap)


def _slot_write(f, base, slots, bucket, M, cnt):
    vals = ([bucket & 0xFFFFFFFF, _pctb(M[0]), _pctb(M[1]), _pctb(M[2]), min(max(cnt, 0), 255) & 0xFF]
            + [_u32b(M[i]) for i in _U32_IDX] + [_u16b(M[i]) for i in _U16_IDX])
    f.seek(base + (bucket % slots) * HRRD_SLOT.size)
    f.write(HRRD_SLOT.pack(*vals))


def _slot_read(f, base, slots, bucket):
    f.seek(base + (bucket % slots) * HRRD_SLOT.size)
    cur = f.read(HRRD_SLOT.size)
    if len(cur) == HRRD_SLOT.size:
        u = HRRD_SLOT.unpack(cur)
        if u[0] == (bucket & 0xFFFFFFFF):
            M = [u[1], u[2], u[3]] + list(u[5:5 + len(_U32_IDX)]) + list(u[5 + len(_U32_IDX):])
            return (M, u[4])
    return None


def _hrrd_put_raw(f, base, slots, bucket, M):
    bucket &= 0xFFFFFFFF
    cur = _slot_read(f, base, slots, bucket)
    if cur is not None:
        M0, cnt = cur
        for j in _PCT_IDX: M[j] = _avg_pct(M0[j], M[j], cnt)
        for j in _U32_IDX: M[j] = _avg_u(M0[j], M[j], cnt, HRRD_U32)
        for j in _U16_IDX: M[j] = min(max(M0[j], M[j]), HRRD_U16)
        _slot_write(f, base, slots, bucket, M, cnt + 1)
    else:
        _slot_write(f, base, slots, bucket, M, 1)


def _hrrd_consolidate(f, i, ts):
    step, slots = HRRD_RINGS[i]
    cbase = _ring_base(i - 1); cslots = HRRD_RINGS[i - 1][1]
    ratio = HRRD_RATIO[i]
    bucket = _bucket_of(ts, step)
    kids = [r[0] for k in range(bucket * ratio, bucket * ratio + ratio)
            if (r := _slot_read(f, cbase, cslots, k)) is not None]
    if not kids:
        return
    out = [0] * HRRD_NM
    for j in _PCT_IDX:
        vs = [k[j] for k in kids if k[j] != HRRD_NA]
        out[j] = round(sum(vs) / len(vs)) if vs else HRRD_NA
    for j in _U32_IDX:
        out[j] = round(sum(k[j] for k in kids) / len(kids))
    for j in _U16_IDX:
        out[j] = max(k[j] for k in kids)
    _slot_write(f, _ring_base(i), slots, bucket, out, len(kids))


def _hrrd_feed(f, ts, M):
    step0, slots0 = HRRD_RINGS[0]
    _hrrd_put_raw(f, _ring_base(0), slots0, _bucket_of(ts, step0), list(M))
    for i in range(1, len(HRRD_RINGS)):
        _hrrd_consolidate(f, i, ts)


def _hrrd_salvage(path):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return None
    if len(data) < HRRD_HEAD.size or data[:4] != HRRD_MAGIC:
        return None
    _, ver, step0, slots0 = HRRD_HEAD.unpack_from(data, 0)
    if ver == HRRD_VER and (step0, slots0) == HRRD_RINGS[0]:
        return None
    if not (0 < step0 <= 86400 and 0 < slots0 <= 100000):
        return None
    sst = HRRD_SLOT_V5 if ver <= 5 else HRRD_SLOT_V6 if ver == 6 else HRRD_SLOT
    pts = []
    for i in range(slots0):
        off = HRRD_HEAD.size + i * sst.size
        if off + sst.size > len(data):
            break
        u = sst.unpack_from(data, off)
        b = u[0]
        if not b:
            continue
        if ver <= 5:
            M = [u[1], u[2], u[3], u[5], u[6]] + [0] * (HRRD_NM - 5)
        elif ver == 6:
            M = [u[1], u[2], u[3]] + list(u[5:11]) + [0, 0] + list(u[11:15])
        else:
            M = [u[1], u[2], u[3]] + list(u[5:5 + len(_U32_IDX)]) + list(u[5 + len(_U32_IDX):])
        pts.append((b * step0, M))
    pts.sort(key=lambda x: x[0])
    return pts or None


_hrrd_healed = set()


def _ring_drop_unwritable(path, make):
    with contextlib.suppress(OSError):
        os.unlink(path)
    ok = False
    with contextlib.suppress(OSError):
        make(path)
        ok = True
    if path not in _hrrd_healed:
        _hrrd_healed.add(path)
        log(LOG_WARNING, "stats: %s was not writable (owned by another user) — recreated%s", os.path.basename(path), "" if ok else " FAILED")
    return ok


def hrrd_update(path, ts, M):
    ts = int(ts)
    with _hrrd_lock:
        if not _hrrd_ok(path):
            carry = _hrrd_salvage(path)
            with contextlib.suppress(OSError):
                if carry and os.path.exists(path):
                    os.replace(path, path + ".bak")
                with open(path, "wb") as f:
                    f.write(HRRD_HEAD.pack(HRRD_MAGIC, HRRD_VER, HRRD_RINGS[0][0], HRRD_RINGS[0][1]))
                    f.write(b"\x00" * (HRRD_SLOT.size * HRRD_TOTAL))
                if carry:
                    with open(path, "r+b") as f:
                        for (cts, cM) in carry:
                            _hrrd_feed(f, cts, cM)
        for _try in (0, 1):
            try:
                with open(path, "r+b") as f:
                    _hrrd_feed(f, ts, M)
                return
            except PermissionError:
                if _try or not _ring_drop_unwritable(path, _hrrd_blank):
                    return
            except OSError:
                return


def _hrrd_blank(path):
    with open(path, "wb") as f:
        f.write(HRRD_HEAD.pack(HRRD_MAGIC, HRRD_VER, HRRD_RINGS[0][0], HRRD_RINGS[0][1]))
        f.write(b"\x00" * (HRRD_SLOT.size * HRRD_TOTAL))
    with contextlib.suppress(OSError):
        os.chmod(path, 0o644)


PRES_MAGIC = b"SWGP"
PRES_VER = 1
PRES_BITS0 = 512
PRES_HEAD = struct.Struct("<4sBIII")
_pres_lock = threading.Lock()


def pres_path(stats_dir, nid):
    return os.path.join(stats_dir, "presence-" + nid + ".rrd")


def _pres_slot(bits):
    return 4 + bits // 8


def _pres_base(i, bits):
    return PRES_HEAD.size + sum(n for _, n in HRRD_RINGS[:i]) * _pres_slot(bits)


def _pres_size(bits):
    return PRES_HEAD.size + sum(n for _, n in HRRD_RINGS) * _pres_slot(bits)


def pres_index_path(stats_dir):
    return os.path.join(stats_dir, "presence-index.json")


def pres_bits_for(pubkeys, stats_dir):
    path = pres_index_path(stats_dir)
    with _pres_lock:
        try:
            idx = json.loads(open(path).read())
        except Exception:
            idx = {}
        changed = False
        for pk in pubkeys:
            if pk not in idx:
                idx[pk] = len(idx)
                changed = True
        if changed:
            with contextlib.suppress(Exception):
                atomic_write(path, json.dumps(idx), mode=0o600)
        return idx


def pres_width(npeers):
    bits = PRES_BITS0
    while bits < max(1, npeers):
        bits *= 2
    return bits


def _pres_ensure(path, bits):
    with contextlib.suppress(OSError):
        with open(path, "rb") as f:
            head = f.read(PRES_HEAD.size)
        if len(head) == PRES_HEAD.size:
            magic, ver, s0, n0, obits = PRES_HEAD.unpack(head)
            if magic == PRES_MAGIC and ver == PRES_VER and (s0, n0) == HRRD_RINGS[0] \
               and obits >= bits and os.path.getsize(path) >= _pres_size(obits):
                return obits
    with open(path, "wb") as f:
        f.write(PRES_HEAD.pack(PRES_MAGIC, PRES_VER, HRRD_RINGS[0][0], HRRD_RINGS[0][1], bits))
        f.write(b"\x00" * (_pres_size(bits) - PRES_HEAD.size))
    os.chmod(path, 0o644)
    return bits


def pres_feed(path, ts, bit_list, bits):
    with _pres_lock:
        bits = _pres_ensure(path, bits)
        if not os.access(path, os.W_OK):
            _ring_drop_unwritable(path, lambda p2: _pres_ensure(p2, bits))
        slot = _pres_slot(bits); nb = bits // 8
        with open(path, "r+b") as f:
            def rd(i, bucket):
                ns = HRRD_RINGS[i][1]
                f.seek(_pres_base(i, bits) + (bucket % ns) * slot)
                raw = f.read(slot)
                if len(raw) != slot:
                    return (0, bytearray(nb))
                return (struct.unpack_from("<I", raw, 0)[0], bytearray(raw[4:]))

            def wr(i, bucket, bm):
                ns = HRRD_RINGS[i][1]
                f.seek(_pres_base(i, bits) + (bucket % ns) * slot)
                f.write(struct.pack("<I", bucket & 0xFFFFFFFF) + bytes(bm))

            b0 = _bucket_of(ts, HRRD_RINGS[0][0])
            cur, bm = rd(0, b0)
            acc = bytearray(nb) if cur != (b0 & 0xFFFFFFFF) else bm
            for bit in bit_list:
                if 0 <= bit < bits:
                    acc[bit >> 3] |= 1 << (bit & 7)
            wr(0, b0, acc)

            for i in range(1, len(HRRD_RINGS)):
                bucket = _bucket_of(ts, HRRD_RINGS[i][0])
                ratio = HRRD_RATIO[i]
                un = bytearray(nb)
                for k in range(bucket * ratio, bucket * ratio + ratio):
                    cb, cbm = rd(i - 1, k)
                    if cb == (k & 0xFFFFFFFF):
                        for j in range(nb):
                            un[j] |= cbm[j]
                wr(i, bucket, un)


def pres_scan(path, ring, since, until=None):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError:
        return []
    if len(data) < PRES_HEAD.size or data[:4] != PRES_MAGIC:
        return []
    _, ver, s0, n0, bits = PRES_HEAD.unpack_from(data, 0)
    if ver != PRES_VER or (s0, n0) != HRRD_RINGS[0] or len(data) < _pres_size(bits):
        return []
    step, ns = HRRD_RINGS[ring]
    base = _pres_base(ring, bits); slot = _pres_slot(bits); nb = bits // 8
    out = []
    for i in range(ns):
        off = base + i * slot
        b = struct.unpack_from("<I", data, off)[0]
        if not b:
            continue
        ep = _bucket_epoch(b, step)
        if ep < since or (until is not None and ep >= until):
            continue
        out.append((ep, data[off + 4:off + 4 + nb]))
    out.sort(key=lambda x: x[0])
    return out


def _bm_bits(bm):
    for i, byte in enumerate(bm):
        while byte:
            b = byte & -byte
            yield (i << 3) + b.bit_length() - 1
            byte ^= b


def hrrd_repair_counts(path):
    changed = False
    with _hrrd_lock:
        if not _hrrd_ok(path):
            return False
        try:
            with open(path, "r+b") as f:
                for i in range(1, len(HRRD_RINGS)):
                    slots = HRRD_RINGS[i][1]
                    cbase, cslots = _ring_base(i - 1), HRRD_RINGS[i - 1][1]
                    ratio = HRRD_RATIO[i]
                    for si in range(slots):
                        f.seek(_ring_base(i) + si * HRRD_SLOT.size)
                        raw = f.read(HRRD_SLOT.size)
                        if len(raw) != HRRD_SLOT.size:
                            break
                        b = HRRD_SLOT.unpack(raw)[0]
                        if not b:
                            continue
                        cur = _slot_read(f, _ring_base(i), slots, b)
                        if cur is None:
                            continue
                        M, cnt = cur
                        kids = [r[0] for k in range(b * ratio, b * ratio + ratio)
                                if (r := _slot_read(f, cbase, cslots, k)) is not None]
                        if not kids:
                            continue
                        newM = list(M)
                        for j in _U16_IDX:
                            newM[j] = max(k[j] for k in kids)
                        if newM != M:
                            _slot_write(f, _ring_base(i), slots, b, newM, cnt)
                            changed = True
        except OSError:
            return False
    return changed


def hrrd_repair_all(stats_dir):
    if not stats_dir:
        return
    marker = os.path.join(stats_dir, ".counts-repaired-v1")
    if os.path.exists(marker):
        return
    n = fixed = 0
    with contextlib.suppress(OSError):
        for fn in sorted(os.listdir(stats_dir)):
            if not fn.endswith(".rrd") or fn.startswith("presence-"):
                continue
            n += 1
            with contextlib.suppress(Exception):
                if hrrd_repair_counts(os.path.join(stats_dir, fn)):
                    fixed += 1
    with contextlib.suppress(Exception):
        atomic_write(marker, str(int(time.time())), mode=0o644)
    log(LOG_INFO, "headcount repair: rebuilt peak counts in %d of %d rings", fixed, n)


def _rings_dead_after():
    span = max(step * n for step, n in HRRD_RINGS)
    window = max(spec[2] for spec in RANGE_SPEC.values())
    return max(span, window) + 2 * 86400


def rings_gc(stats_dir):
    if not stats_dir:
        return 0, 0
    cutoff = time.time() - _rings_dead_after()
    gone = freed = 0
    with contextlib.suppress(OSError):
        for fn in os.listdir(stats_dir):
            if not fn.endswith(".rrd"):
                continue
            fp = os.path.join(stats_dir, fn)
            with contextlib.suppress(OSError):
                st = os.stat(fp)
                if st.st_mtime >= cutoff:
                    continue
                os.unlink(fp)
                gone += 1; freed += st.st_size
    if gone:
        log(LOG_INFO, "rings gc: removed %d ring(s) unwritten for over %d days (%.1f MB)", gone, _rings_dead_after() // 86400, freed / 1048576.0)
    return gone, freed


def hrrd_read(path, ring=0, want=HRRD_VIEW, slim=False, since=None, until=None):
    with _hrrd_lock:
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            return None
    if len(data) < HRRD_HEAD.size or data[:4] != HRRD_MAGIC:
        return None
    _, ver, step0, slots0 = HRRD_HEAD.unpack_from(data, 0)
    if ver != HRRD_VER or (step0, slots0) != HRRD_RINGS[0]:
        return None
    step, nslots = HRRD_RINGS[ring]
    base = _ring_base(ring)
    rows = []
    for i in range(nslots):
        off = base + i * HRRD_SLOT.size
        if off + HRRD_SLOT.size > len(data):
            break
        u = HRRD_SLOT.unpack_from(data, off)
        if u[0]:
            rows.append(u)
    if not rows:
        return None
    rows.sort(key=lambda r: r[0])
    if since is not None:
        rows = [r for r in rows if _bucket_epoch(r[0], step) >= since]
        if not rows:
            return None
    if until is not None:
        rows = [r for r in rows if _bucket_epoch(r[0], step) < until]
        if not rows:
            return None
    rows = rows[-want:]
    na = lambda v: None if v == HRRD_NA else v
    out = {"t": [_bucket_epoch(r[0], step) for r in rows],
           "cpu": [na(r[1]) for r in rows], "mem": [na(r[2]) for r in rows], "disk": [na(r[3]) for r in rows],
           "rx": [r[5] for r in rows], "tx": [r[6] for r in rows]}
    if slim:
        out["mrx"] = [r[9] for r in rows]; out["mtx"] = [r[10] for r in rows]
        out["pon"] = [r[13] for r in rows]
        return out
    out.update({"arx": [r[7] for r in rows], "atx": [r[8] for r in rows], "mrx": [r[9] for r in rows], "mtx": [r[10] for r in rows],
                "inet_up": [r[11] for r in rows], "inet_down": [r[12] for r in rows],
                "pon": [r[13] for r in rows], "ptot": [r[14] for r in rows], "paon": [r[15] for r in rows], "patot": [r[16] for r in rows]})
    return out


