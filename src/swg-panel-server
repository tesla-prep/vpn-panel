        prov = incoming.get("providers")
        if isinstance(prov, dict):                              # {prov_id: bool} — fetched catalog providers only; "curated"
            _prov_before = cur.get("providers") or {}            # is not one of them (it has no switch, see catalog_providers_view)
            cur["providers"] = {p: bool(prov[p]) for p in prov if p in CATALOG_PROVIDERS}
            _newly_on = [p for p in cur["providers"] if cur["providers"][p]
                         and not _prov_before.get(p, False) and p in CATALOG_PROVIDERS]
            _newly_off = [p for p in cur["providers"] if not cur["providers"][p]
                          and _prov_before.get(p, False) and p in CATALOG_PROVIDERS]
            if _newly_off:                                     # disabling clears the status → re-enabling shows a clean "Downloading", not a stale "up to date"
                for p in _newly_off:
                    _PROV_STATUS.pop(p, None)
                _prov_status_save()
            if _newly_on:
                provider_download(_newly_on)                   # fetch just-enabled providers' catalogs → "Downloading" + fresh search
        gu = incoming.get("geo_update")
        if isinstance(gu, dict):
            try:    _ed = max(0, min(30, int(gu.get("every_days"))))
            except Exception: _ed = 1
            _at = str(gu.get("at") or "04:00").strip()
            if not re.match(r"^([01]?\d|2[0-3]):[0-5]\d$", _at):
                _at = "04:00"
            cur["geo_update"] = {"every_days": _ed, "at": _at}
        tu = incoming.get("turn_update")
        if isinstance(tu, dict):
            try:    _ted = max(0, min(30, int(tu.get("every_days"))))
            except Exception: _ted = 0
            _tat = str(tu.get("at") or "04:00").strip()
            if not re.match(r"^([01]?\d|2[0-3]):[0-5]\d$", _tat):
                _tat = "04:00"
            cur["turn_update"] = {"every_days": _ted, "at": _tat}
        if "throughput_perspective" in incoming:
            cur["throughput_perspective"] = "peers" if incoming["throughput_perspective"] == "peers" else "nodes"
        if "throughput_units" in incoming:
            cur["throughput_units"] = "bits" if incoming["throughput_units"] == "bits" else "bytes"
        for _k in ("top_talkers", "top_destinations"):
            if _k in incoming:
                try: cur[_k] = max(1, min(50, int(incoming[_k])))
                except Exception: cur[_k] = 10
        if "expiry_warn_days" in incoming:
            try: cur["expiry_warn_days"] = max(0, min(365, int(incoming["expiry_warn_days"])))
            except Exception: cur["expiry_warn_days"] = 3
        # "Days are counted in" (tz_apply). Judged only when it CHANGES: every Save sends it, and a stored zone this
        # server has since lost must not fail a save of something else. Applied below, once the settings are in hand.
        _tz_new = incoming.get("time_zone")
        _tz_new = _tz_new.strip() if isinstance(_tz_new, str) and _tz_new.strip() != str(cur.get("time_zone") or "") else None
        if _tz_new:
            if not tz_file(_tz_new):
                return 400, {"ok": False, **perr("This server has no time zone called {v1}. Pick one from the list.",
                                                  v1=_tz_new[:64]), "code": "bad_request"}
        if _tz_new is not None:
            cur["time_zone"] = _tz_new
        if "infinite_history" in incoming:
            cur["infinite_history"] = incoming["infinite_history"] is not False   # default on; only an explicit false
        if "history_resolution" in incoming:
            try: _hr = int(incoming["history_resolution"])
            except Exception: _hr = LEDGER_STEP_DEFAULT
            cur["history_resolution"] = _hr if _hr in LEDGER_STEPS else LEDGER_STEP_DEFAULT
        if "show_node_lans" in incoming:
            cur["show_node_lans"] = incoming["show_node_lans"] is not False    # default is on; only an explicit false turns it off
        if "scan_allow" in incoming:          # SCAN-GUARD-PLAN: source IPs/CIDRs the scan-sweep guard never flags (our own fleet
            _raw = incoming["scan_allow"]
            _items = _raw if isinstance(_raw, list) else re.split(r"[\s,]+", str(_raw or ""))
            _allow, _bad, _broad = [], [], []
            _over = 0
            for _it in _items:
                _it = str(_it or "").strip()
                if not _it:
                    continue
                try:
                    _net = ipaddress.ip_network(_it, strict=False)
                except Exception:
                    _bad.append(_it[:40]); continue
                if _net.version != 4:         # the guard's sets are IPv4 (`ip saddr`); a v6 entry never matches and risks the node's older nft
                    _bad.append(_it[:40]); continue
                if _net.prefixlen < 16:        # 0.0.0.0/0 … /15 would exempt far too much — a footgun, not an allowlist
                    _broad.append(str(_net)); continue
                _c = str(_net)
                if _c in _allow:
                    continue
                if len(_allow) >= 256:        # a sanity cap nobody reaches — REFUSED (not silently truncated), so the operator knows the list wasn't fully saved
                    _over += 1; continue
