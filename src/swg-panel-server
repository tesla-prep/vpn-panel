RELAY_QUOTA_DEFAULT = 50
RELAY_QUOTA_MAX = 90


RELAY_PORT_BASE = 5590
RELAY_PORT_SPAN = 300


def _relay_iid(iface, peer=""):
    peer = (peer or "").strip()
    return iface + ("." + peer if peer else "")


def _relay_port_hash(iid):
    return RELAY_PORT_BASE + (int(hashlib.sha256(iid.encode()).hexdigest()[:4], 16) % RELAY_PORT_SPAN)


def _relay_ports(marks):
    out, taken = {}, set()
    for iid in sorted(marks, key=lambda i: (bool(marks[i]), i)):
        h = _relay_port_hash(iid)
        for k in range(RELAY_PORT_SPAN):
            q = RELAY_PORT_BASE + ((h - RELAY_PORT_BASE + k) % RELAY_PORT_SPAN)
            if q not in taken:
                taken.add(q)
                out[iid] = q
                break
    return out


def _relay_ineligible(ov, mark=0, up_table=0):
    if mark and not (SWG_RT_BASE <= mark <= SWG_RT_MAX):
        return "its routing table (%d) is outside the %d-%d band" % (mark, SWG_RT_BASE, SWG_RT_MAX)
    if up_table and not (SWG_RT_BASE <= up_table <= SWG_RT_MAX):
        return "its upstream table (%d) is outside the %d-%d band" % (up_table, SWG_RT_BASE, SWG_RT_MAX)
    return ""


def relay_eligibility(node_cfg, snaps, nid, legs=()):
    _rs = ((snaps.get(nid) or {}).get("relay") or {})
    container_bar = "" if _rs.get("capable", True) else (_rs.get("cannot") or "this node cannot run the relay")
    by_subnet, by_fwd = {}, {}
    for lg in (legs or ()):
        if (lg.get("mode") or "smart") == "forward":
            by_fwd[(lg.get("subnet") or "", lg.get("peer") or "")] = lg
        else:
            by_subnet.setdefault(lg.get("subnet") or "", []).append(lg)
    out = {}
    for iface, ov in ((node_cfg or {}).get("ifaces") or {}).items():
        ov = ov or {}
        mode = ov.get("egress_mode")
        if ov.get("system") or mode not in ("forward", "smart"):
            continue
        subnet = _iface_subnet_from_snap(snaps, nid, iface)
        if not subnet:
            continue
        if mode == "forward":
            peer = (ov.get("egress_node") or "").strip()
            if not peer:
                continue
            _u = int((by_fwd.get((subnet, peer)) or {}).get("mark") or 0)
            out[_relay_iid(iface, "")] = {"iface": iface, "peer": "", "via": peer, "subnet": subnet,
                                          "mark": 0, "up_table": _u,
                                          "why": container_bar or _relay_ineligible(ov, 0, _u)}
        elif mode == "smart":
            for lg in sorted(by_subnet.get(subnet) or (), key=lambda x: str(x.get("peer") or "")):
                _mk = int(lg.get("mark") or 0)
                out[_relay_iid(iface, lg["peer"])] = {
                    "iface": iface, "peer": lg["peer"], "via": lg["peer"], "subnet": subnet, "mark": _mk,
                    "up_table": _mk, "why": container_bar or _relay_ineligible(ov, _mk, _mk)}
    return out


def relay_plan(nodes, plans, nid, snaps):
    node = nodes.get(nid) or {}
    on = {}
    for peer, lr in (node.get("links") or {}).items():
        r = ((lr or {}).get("relay") or {})
        if (r.get("mode") or "forward") == "relay" and (lr or {}).get("iface"):
            on[peer] = r
    if not on:
        return {}
    want = {}
    _legs = ((plans or {}).get(nid) or {}).get("_legs") or ()
    forward_only = ((plans or {}).get(nid) or {}).get("_static_forward") or ()
    for iid, e in sorted(relay_eligibility(node, snaps, nid, _legs).items()):
        r = on.get(e["via"])
        if r is None:
            continue
        if e["why"]:
            continue
        if forward_only:
            net = ipaddress.ip_network(e["subnet"], strict=False)
            sources = sorted(s for s in forward_only if ipaddress.IPv4Interface(s).ip in net)
            if sources:
                if not static_exit_supported(snaps.get(nid)):
                    continue
                e = dict(e, forward_only=sources)
        want[iid] = (e, r)
    ports = _relay_ports({i: e["mark"] for i, (e, _r) in want.items()})
    legs = []
    for iid in sorted(want):
        e, r = want[iid]
        if iid not in ports:
            continue

        legs.append({"iface": e["iface"], "peer": e["peer"], "subnet": e["subnet"],
                     "mark": e["mark"], "up_table": e.get("up_table") or 0, "port": ports[iid],
                     "cc_cli": (r.get("cc_cli") or "").strip(),
                     "cc_up": (r.get("cc_up") or "").strip(),
                     **({"forward_only": e["forward_only"]} if e.get("forward_only") else {})})
    if not legs:
        return {"legs": [], "ifaces": {}}
    q = int(((node.get("relay") or {}).get("quota_pct")) or RELAY_QUOTA_DEFAULT)
    _reads_legs = bool(((snaps.get(nid) or {}).get("relay") or {}).get("legs"))
    return {"legs": legs,
            **({} if _reads_legs else
               {"ifaces": {l["iface"]: {"subnet": l["subnet"], "port": l["port"],
                                        "cc_cli": l["cc_cli"], "cc_up": l["cc_up"]}
                           for l in legs if not l["mark"]}}),
            "quota_pct": max(5, min(RELAY_QUOTA_MAX, q)),
            "max_conns": int(((node.get("relay") or {}).get("max_conns")) or 0)}


