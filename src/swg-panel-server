LOG_BASE_LEVELS = ("off", "error", "warning", "info")
LOG_DEBUG_FOR = (3600, 86400, -1)


def log_debug_left(ps, now=None):
    try:
        until = int((ps or {}).get("log_debug_until") or 0)
    except (TypeError, ValueError):
        return 0
    if until == -1:
        return -1
    return max(0, int(until - (now if now is not None else time.time())))


LOG_MB_DEFAULT, LOG_MB_MIN = 100, 16


def log_mb(v):
    try:
        return max(LOG_MB_MIN, int(v)) if v not in (None, "") else LOG_MB_DEFAULT
    except (TypeError, ValueError):
        return LOG_MB_DEFAULT


def log_mb_parse(v):
    if v in (None, ""):
        return LOG_MB_DEFAULT, None
    try:
        mb = int(v)
    except (TypeError, ValueError):
        mb = None
    if mb is None or mb < LOG_MB_MIN or mb > 999999:
        return None, perr("The log budget must be a whole number of MB, at least {v1}.", v1=LOG_MB_MIN)
    return mb, None


def log_wire(ps, now=None, mb=None):
    base = (ps or {}).get("log_level")
    base = base if base in LOG_BASE_LEVELS else "info"
    left = log_debug_left(ps, now)
    mb = log_mb(mb)
    if base == "info" and not left and mb == LOG_MB_DEFAULT:
        return None
    return {"level": base, **({"debug_left": left} if left else {}), **({"mb": mb} if mb != LOG_MB_DEFAULT else {})}


