def prune_node_refs(nodes):
    live = set(nodes or {})
    hit = []
    for nid, rec in (nodes or {}).items():
        for src in ("ifaces", "wdtt", "csqtt"):
            for name, ov in ((rec or {}).get(src) or {}).items():
                if not isinstance(ov, dict) or ov.get("system") or ov.get("egress_mode") != "forward":
                    continue
                gone = str(ov.get("egress_node") or "")
                if gone and gone in live:
                    continue
                ov["egress_mode"] = "direct"
                ov.pop("egress_node", None)
                hit.append((nid, src, name, gone))
    return hit


def prune_exit_refs(rec):
    live = {str((x or {}).get("id") or "") for x in (rec.get("exits") or [])}
    hit = []
    for src in ("ifaces", "wdtt", "csqtt"):
        for name, ov in (rec.get(src) or {}).items():
            if not isinstance(ov, dict):
                continue
            if ov.get("egress_mode") == "exit" and str(ov.get("exit_id") or "") not in live:
                ov["egress_mode"] = "direct"
                ov.pop("exit_id", None)
                hit.append(name)
            for r in (ov.get("routing") or []):
                if isinstance(r, dict) and r.get("action") == "dev" and str(r.get("exit_id") or "") not in live:
                    r["action"] = "direct"
                    r.pop("exit_id", None)
                    hit.append(name + "/" + str(r.get("category") or "?"))
    for r in (rec.get("default_routing") if isinstance(rec.get("default_routing"), list) else ()):
        if isinstance(r, dict) and r.get("action") == "dev" and str(r.get("exit_id") or "") not in live:
            r["action"] = "direct"
            r.pop("exit_id", None)
            hit.append("default/" + str(r.get("category") or "?"))
    return hit


def derive_default_exit(rec):
    if not isinstance(rec.get("default_routing"), list):
        return
    ca = next((r for r in rec["default_routing"] if isinstance(r, dict) and r.get("category") == "all" and rule_on(r)
               and r.get("ports") is None), None)
    xid = str(ca.get("exit_id") or "") if ca and ca.get("action") == "dev" else ""
    if xid and any(str((x or {}).get("id")) == xid for x in (rec.get("exits") or [])):
        rec["default_exit"] = xid
    else:
        rec.pop("default_exit", None)


def prune_p2p_refs(nodes):
    changed = []
    for _nid, _n in (nodes or {}).items():
        _p = (_n or {}).get("p2p")
        if not isinstance(_p, dict):
            continue
        if (_p.get("action") == "exit" and _p.get("node") not in nodes) or (
                _p.get("action") == "dev" and str(_p.get("exit_id")) not in {str((e or {}).get("id")) for e in (_n.get("exits") or [])}):
            _n["p2p"] = {"action": "block"}
            changed.append((_nid, _n.get("name", _nid)))
    for _nid, _n in (nodes or {}).items():
        if not isinstance(_n, dict):
            continue
        _live = p2p_policy(_n) == "iface"
        for _k in ("ifaces", "wdtt", "csqtt"):
            for _rn, _r in ((_n.get(_k) or {}) if isinstance(_n.get(_k), dict) else {}).items():
                _p = _r.get("p2p") if isinstance(_r, dict) else None
                if _live and isinstance(_p, dict) and _p.get("action") in ("exit", "dev") and _p2p_target(
                        {k: str(v) for k, v in _p.items() if k in ("action", "node", "exit_id")}, nodes, _nid)[1]:
                    _r.pop("p2p", None)
                    _r["block"] = [b for b in (_r.get("block") or []) if b != "torrents"] + ["torrents"]
                    changed.append((_nid, "%s · %s" % (_n.get("name", _nid), _rn)))
    return changed


