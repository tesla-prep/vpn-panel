                if _om or ov.get("awg_exact"):
                    if _om:
                        _no = awg_exact_refusal(_snap_u, nodes[nid].get("name") or nid)
                        if _no:
                            return 400, {"ok": False, **_no, "code": "bad_request"}
                    if not ov.get("awg_exact"):
                        _ra_u = _rep_u.get("awg_params") if isinstance(_rep_u.get("awg_params"), dict) else {}
                        if not _ra_u:
                            return 400, {"ok": False, **perr("{v1}: wait for the node to report this interface, then set a "
                                                             "field to none", v1=iface), "code": "bad_request"}
                        _rec_u = {**{k: str(v) for k, v in _ra_u.items() if k not in AWG3_FIELDS or _was3}, **_rec_u}
                    _m = {**_rec_u, **clean}
                    _m = {k: str(_m[k]).strip() for k in AWG_FIELDS if k in _m and k not in _om}
                    # the rules guard an OMISSION: a save that removes nothing is judged as any other save is — a whole
                    # set blessed from a foreign conf that breaks one (Jc alone, S2 = S1 + 56) keeps every other edit
                    _bad = awg_rules(_m, iface, gen3=_was3) if _om else None
                    if _bad:
                        return 400, {"ok": False, **_bad, "code": "bad_request"}
                    ov["awg_params"] = _m
                    ov["awg_exact"] = True
                else:
                    _m = {**_rec_u, **clean}
                    _m = {k: _m[k] for k in AWG_FIELDS if k in _m}
                    if _m:
                        ov["awg_params"] = _m
                    else:
                        ov.pop("awg_params", None)
            else:
                return 400, {"ok": False, "error": "awg_params must be an object", "code": "bad_request"}
        # A GENERATION SWITCH (docs/AWG3-PLAN.md §7.1) — an intent, never stored: "3.1" adds the 3.1 set to what the interface
        # has, "2.0" removes every 3.x key. The node applies either as a recreate, and every client re-imports.
        _gen = body.get("awg_gen")
        if _gen not in (None, "", "2.0", "3.1"):
            return 400, {"ok": False, "error": "awg_gen must be \"2.0\" or \"3.1\"", "code": "bad_request"}
        if _gen:
            if ov.get("system"):
                return 400, {"ok": False, **perr("{v1} is a mesh link — its type comes from the mesh settings (Settings → "
                                                 "Mesh), and a re-provision rebuilds it", v1=iface), "code": "bad_request"}
            # EITHER way: an older node can neither apply a 3.x key nor take one away (its agent keeps what it does not
            # know), so a switch back there would read as synced while the device kept the key (§7.8).
            if not awg_gen_reported((deps.get("node_snaps") or {}).get(nid)):
                return 400, {"ok": False, **perr("{v1}: this node does not report its AmneziaWG version — update it",
                                                 v1=nodes[nid].get("name") or nid), "code": "bad_request"}
            _rmeta = (((((deps.get("node_snaps") or {}).get(nid) or {}).get("interfaces") or {}).get(iface) or {})
                      .get("meta") or {})
            if _gen == "3.1":
                if not (ov.get("awg_params") or _rmeta.get("awg_params")) or (_rmeta.get("tool") or "awg") != "awg":
                    return 400, {"ok": False, **perr("{v1} is a plain WireGuard interface — only an AmneziaWG interface "
                                                     "can switch to AmneziaWG 3.1", v1=iface), "code": "bad_request"}
                _no3 = awg_gen_refusal((deps.get("node_snaps") or {}).get(nid), nodes[nid].get("name") or nid, iface)
                if _no3:
                    return 400, {"ok": False, **_no3, "code": "bad_request"}
                # An S set to none IN THIS SAVE is the operator's choice, and 3.1's header protection cannot keep it: refused,
                # saying why — never drawn over in silence (q189 PR-3's follow-up; the sheet stays open on it).
                _s_none = sorted(k for k in ("S1", "S2", "S3", "S4") if isinstance(body.get("awg_params"), dict)
                                 and str(body["awg_params"].get(k, "")).strip() == AWG_OMIT)
                if _s_none:
                    return 400, {"ok": False, **perr("{v1}: header protection needs S1–S4 — {v2} cannot be none while it is on",
                                                     v1=iface, v2=", ".join(_s_none)), "code": "bad_request"}
                _omit3 = (frozenset(k for k in AWG_FIELDS if k not in AWG3_FIELDS and k not in (ov.get("awg_params") or {})
                                    and k not in ("S1", "S2", "S3", "S4"))
                          if ov.get("awg_exact") else ())
                ov["awg_params"] = awg3_full(ov.get("awg_params"), _rmeta.get("awg_params"), awg3_defaults(deps),
                                             omit=frozenset(_omit3) | (awg3_omitted(deps) - set(ov.get("awg_params") or {}))
                                             | (awg_template(body.get("awg_params"), gen3=True)[1] & set(_AWG3_RANGED))
                                             | awg3_left_out(ov.get("awg_params"), _rec0))
                if _omit3:
                    _bad = awg_rules(ov["awg_params"], iface)
                    if _bad:
                        return 400, {"ok": False, **_bad, "code": "bad_request"}
            else:
                _reported_awg = sanitize_awg_params(_rmeta.get("awg_params"), gen3=True)
                _was_protected = bool(_rec0.get("HeaderProtectionKey") or _reported_awg.get("HeaderProtectionKey"))
                _awgb = ov.get("awg_params") or (_reported_awg if _was_protected and "awg_params" not in body else {})
                _a2 = awg2_profile(_awgb, _was_protected, previous=_rec0)
                if not _a2 and ov.get("awg_exact"):      # every 2.0 field set to none: 2.0 would be plain WireGuard (R1)
                    return 400, {"ok": False, **awg_rules({}, iface), "code": "bad_request"}
                if _a2:
                    ov["awg_params"] = _a2
                else:
                    ov.pop("awg_params", None)
        if not ov.get("awg_params"):
            ov.pop("awg_exact", None)               # no set left to be whole (an `awg_params: {}` body)
        if ("awg_params" in body or _gen) and any(k in (ov.get("awg_params") or {}) for k in AWG3_FIELDS):
            _a3, _e3 = awg3_check(ov["awg_params"])
            if _e3:
                return 400, {"ok": False, **_e3, "code": "bad_request"}
            ov["awg_params"] = _a3
        if body.get("mesh_reset"):
            # Empty this mesh leg's probe window at BOTH ends (see mesh_leg_ends). Same nonce shape as
            # drops_reset — the node acts on it once, a node that is down picks it up when it returns.
            _non = int(time.time())
            for _n, _i in mesh_leg_ends(nodes, nid, iface):
                if (_n, _i) == (nid, iface):
                    ov["mesh_reset"] = _non
                else:
                    nodes[_n].setdefault("ifaces", {}).setdefault(_i, {})["mesh_reset"] = _non
        if body.get("drops_reset"):
            ov["drops_reset"] = int(time.time())
        if "egress_ip" in body:                          # per-interface source/egress IP ("" = clear → MASQUERADE)
            e = (body.get("egress_ip") or "").strip()
            if e:
                try:
                    if ipaddress.ip_address(e).version != 4:
                        raise ValueError
                except ValueError:
                    return 400, {"ok": False, "error": "egress IP must be an IPv4 address", "code": "bad_request"}
                ov["egress_ip"] = e
            else:
                ov.pop("egress_ip", None)
        if "wan_iface" in body:                          # egress WAN NIC ("" = clear → auto-detect)
            w = (body.get("wan_iface") or "").strip()
            # the node splices this into an iptables rule; a shell metachar here would be RCE when a stale
            # rule is later replaced. A real NIC name (eth0, ens3, br-lan, eth0.100) passes; ; ` $ | & don't.
            if w and not _WANIF_RE.match(w):
                return 400, {"ok": False, "error": "WAN interface must be a bare device name", "code": "bad_request"}
            if w:
                ov["wan_iface"] = w
            else:
                ov.pop("wan_iface", None)
        _eerr, _edrop = _apply_egress_mode(ov, body, nodes, nid, deps)
        if _eerr:
            return 400, {"ok": False, "error": _eerr, "code": "bad_request"}
        if _edrop:
            _rdrop = _edrop            # §5.4 — the caller puts it in its 200; never swallow it
        if "block" in body:                          # active block-category ids on this interface (content filtering + traffic/abuse); independent of egress_mode
            b = _validate_block(body.get("block"), deps.get("panel_settings"))
            if b:
                ov["block"] = b
            else:
                ov.pop("block", None)
        _perr = _apply_iface_p2p(ov, body, nodes, nid)   # after block AND the ladder: "torrents" in block[] wins
        if _perr:
            return 400, {"ok": False, "error": _perr, "code": "bad_request"}
        _rv = reach_level_set(ov, body)              # device access: who may open connections to devices here (§10.4)
        if _rv:
            return 400, {"ok": False, **_rv, "code": "bad_request"}
        _rm = (((((deps.get("node_snaps") or {}).get(nid) or {}).get("interfaces") or {}).get(iface) or {}).get("meta") or {})
        _was = (nodes[nid].get("ifaces") or {}).get(iface) or {}
        if awg31_rendered(ov.get("awg_params"), _rm.get("awg_params")):
            _lp = lambda r: (r.get("listen_port") or _rm.get("listen_port") or r.get("desired_port")
                             or (r.get("_lastcfg") or {}).get("listen_port"))   # the port clients dial; a lost one's last
            _t3p = ({_lp(ov), _rm.get("listen_port")} if not awg31_rendered(_was.get("awg_params"), _rm.get("awg_params"))
                    else ({_lp(ov)} if str(_lp(ov)) != str(_lp(_was)) else set()))   # the Edit sheet re-sends an unmoved port
            _bl = turn_awg3_blockers(deps, nodes, nid, _t3p)
            if _bl:
                return 409, {"ok": False, **turn_awg3_refusal(_bl, iface), "code": "turn_awg3", "turn_proxies": _bl}
        for k in ("listen_port", "mtu", "awg_params"):   # a user-set value re-asserts: drop its drift + synced so it re-pushes
            if k in body:
                (ov.get("_synced") or {}).pop(k, None); (ov.get("_drift") or {}).pop(k, None)
        ifaces = nodes[nid].setdefault("ifaces", {})
        if ov:
            ifaces[iface] = ov
        else:
            ifaces.pop(iface, None)
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Updated interface", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface, "override": ov,
                                          **({"dropped": _rdrop} if _rdrop["total"] else {})}}

    if method == "POST" and path == "/api/iface/create":
        # Ask a node to create a BRAND-NEW wg/awg interface (the node genkeys + writes the conf +
        # auto-NATs + brings it up on its next sync, then manages it). Native datapath per node type.
        _rdrop = _dropped_report([])                 # §5.4: entries this save could not keep, reported rather than
        nid = body.get("node") or ""
        iface = (body.get("iface") or "").strip()
        subnet = (body.get("subnet") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not iface or " " in iface or "/" in iface:
            return 400, {"ok": False, "error": "interface name is required (no spaces or /)", "code": "bad_request"}
        try:
            ipaddress.ip_network(subnet, strict=False)
        except Exception:
            return 400, {"ok": False, "error": "subnet must be a CIDR like 10.8.0.0/24", "code": "bad_request"}
        _prev = (nodes[nid].get("ifaces") or {}).get(iface) or {}   # a recreate keeps its own port, in the torrent pool too
        rc = reserved_conflict(deps, nodes, nodes[nid], subnet=subnet, port=body.get("listen_port"), name=iface,
                               keep=(_prev.get("desired_port"), _prev.get("listen_port"), (_prev.get("_lastcfg") or {}).get("listen_port")))
        if rc:
            return 400, {"ok": False, "error": rc, "code": "bad_request"}
        fc = subnet_fleet_conflict(deps, nodes, subnet, skip_node=nid, skip_iface=iface)   # subnets must be unique across the fleet (mesh routes by subnet)
        if fc:
            return 400, {"ok": False, "error": fc, "code": "bad_request"}
        cmd = ["wg"] if (body.get("protocol") or "awg").lower() == "wg" else ["awg"]
        req = {"cmd": cmd, "subnet": subnet}
        _own_ports = ()
        _prev_ov = (nodes[nid].get("ifaces") or {}).get(iface) or {}
        if _prev_ov and iface not in (((deps.get("node_snaps") or {}).get(nid) or {}).get("interfaces") or {}):
            _own_ports = (_prev_ov.get("desired_port"), _prev_ov.get("listen_port"),
                          (_prev_ov.get("_lastcfg") or {}).get("listen_port"))
        if str(body.get("listen_port") or "").isdigit():
            _cp = int(body["listen_port"])
            _pc = _port_conflict(deps, nodes, nid, _cp, own=_own_ports)   # port free of every OTHER interface / turn-proxy / WDTT / mesh link on this node
            if _pc:
                return 400, {"ok": False, **perr("port {v1} is already used by {v2} on this node — pick another port", v1=_cp, v2=_pc), "code": "bad_request"}
            req["listen_port"] = _cp
        _mtu = None
        if str(body.get("mtu") or "").strip():
            try:
                _mtu = int(str(body["mtu"]).strip())
            except ValueError:
                return 400, {"ok": False, "error": "mtu must be a number", "code": "bad_request"}
            if not (576 <= _mtu <= 9200):
                return 400, {"ok": False, "error": "mtu must be 576-9200", "code": "bad_request"}
            req["mtu"] = str(_mtu)
        _idf = (deps.get("panel_settings") or {}).get("interface_defaults") or {}
        _awgdef, _awgom = awg_template(_idf.get("awg_params")) if cmd == ["awg"] else ({}, frozenset())
        _awgprev = _prev_ov.get("awg_params") if (cmd == ["awg"] and isinstance(_prev_ov.get("awg_params"), dict)) else None
        _awgput = dict(_awgprev) if _awgprev else (dict(_awgdef) if _awgdef else {})
        _snap = (deps.get("node_snaps") or {}).get(nid)
        _node_name = nodes[nid].get("name") or nid
        _gen = body.get("awg_gen")
        if _gen not in (None, "", "2.0", "3.1"):
            return 400, {"ok": False, "error": "awg_gen must be \"2.0\" or \"3.1\"", "code": "bad_request"}
        if not _gen and cmd == ["awg"] and not _prev_ov and iface not in ((_snap or {}).get("interfaces") or {}):
            if ((_idf.get("awg_gen") or DEFAULT_AWG_GEN) == "3.1" and not awg_gen_refusal(_snap, _node_name)
                    and not turn_awg3_blockers(deps, nodes, nid, {req.get("listen_port")})):
                _gen = "3.1"
        _exact = bool(_awgprev) and bool(_prev_ov.get("awg_exact"))
        _omit = frozenset() if _awgprev else (_awgom | (awg3_omitted(deps) if _gen == "3.1" and cmd == ["awg"]
                                                       else frozenset()))
        if _omit:
            _no = awg_exact_refusal(_snap, _node_name)
            if _no:
                return 400, {"ok": False, **_no, "code": "bad_request"}
            if _gen != "3.1":
                _awgput = {k: str(v) for k, v in {**gen_awg_params("2.0"), **_awgdef}.items() if k not in _omit}
            _exact = True
        if _gen == "3.1":
            if cmd != ["awg"]:
                return 400, {"ok": False, **perr("{v1} is a plain WireGuard interface — only an AmneziaWG interface "
                                                 "can switch to AmneziaWG 3.1", v1=iface), "code": "bad_request"}
            _no3 = awg_gen_refusal(_snap, _node_name)
            if _no3:
                return 400, {"ok": False, **_no3, "code": "bad_request"}
            _awgput, _e3 = awg3_check(awg3_full(_awgput, None, awg3_defaults(deps), omit=(_omit or (
                frozenset(k for k in AWG_FIELDS if k not in AWG3_FIELDS and k not in _awgput) if _exact else frozenset()))
                | (awg3_omitted(deps) - set(_awgput)) | awg3_left_out(_awgput)))
            if _e3:
                return 400, {"ok": False, **_e3, "code": "bad_request"}
            _exact = _exact or awg_exact_reported(_snap)
            _bl = turn_awg3_blockers(deps, nodes, nid, {req.get("listen_port")})   # a proxy left on this port by an older interface
            if _bl:
                return 409, {"ok": False, **turn_awg3_refusal(_bl, iface), "code": "turn_awg3", "turn_proxies": _bl}
        elif _gen == "2.0":
            _awgput = awg2_profile(_awgput, bool((_awgprev or {}).get("HeaderProtectionKey")))
        if any(k in _awgput for k in AWG3_FIELDS) and not awg_gen_reported(_snap):
            return 400, {"ok": False, **perr("{v1}: this node does not report its AmneziaWG version — update it",
                                             v1=nodes[nid].get("name") or nid), "code": "bad_request"}
        if _exact and not _awgprev:   # R1–R5 on the set the defaults made (R4: a 3.1 set from defaults that omit an S)
            _bad = awg_rules(_awgput, perr("the interface defaults"))
            if _bad:
                return 400, {"ok": False, **_bad, "code": "bad_request"}
        if _awgput:
            req["awg_params"] = dict(_awgput)
            if _exact:
                req["awg_params_exact"] = True
        nodes[nid].setdefault("create", {})[iface] = req
        _rv = reach_level_set({}, body)             # refuse a bad access level BEFORE the record below is touched
        if _rv:
            return 400, {"ok": False, **_rv, "code": "bad_request"}
        ov = nodes[nid].setdefault("ifaces", {}).setdefault(iface, {})   # config-render overrides
        if _awgput:
            ov["awg_params"] = dict(_awgput)
            if _exact:
                ov["awg_exact"] = True
        elif cmd != ["awg"]:
            ov.pop("awg_exact", None)               # a recreate as plain WireGuard: no AmneziaWG set to be whole
        if (body.get("endpoint_host") or "").strip():
            ov["endpoint_host"] = body["endpoint_host"].strip()
        if _mtu:
            ov["mtu"] = _mtu
        if (body.get("dns") or "").strip():
            ov["dns"] = [s.strip() for s in body["dns"].split(",") if s.strip()]   # list, like /iface/update
        if str(body.get("keepalive") or "").strip().isdigit():
            ov["keepalive"] = int(body["keepalive"])
        if (body.get("egress_ip") or "").strip():       # per-interface source/egress IP
            e = body["egress_ip"].strip()
            try:
                if ipaddress.ip_address(e).version == 4:
                    ov["egress_ip"] = e
            except ValueError:
                pass
        if (body.get("wan_iface") or "").strip():        # per-interface egress WAN NIC
            w = body["wan_iface"].strip()
            if " " not in w and "/" not in w:
                ov["wan_iface"] = w
        _cm = (body.get("egress_mode") or "direct").strip()
        if _cm == "forward":                              # cascade exit to another node (routing is Phase 2)
            en = (body.get("egress_node") or "").strip()
            if en in nodes and en != nid:
                ov["egress_mode"] = "forward"; ov["egress_node"] = en
        elif _cm == "smart":                              # per-destination smart routing (Phase 3)
            rules, err, _rdrop = _validate_routing(body.get("routing"), nodes, nid, [cl.get("id") for cl in ((deps.get("panel_settings") or {}).get("custom_lists") or []) if cl.get("id")], snap=(deps.get("node_snaps") or {}).get(nid) or {},
                                                   roster=_routing_roster(body.get("routing"), deps))
            if err:
                return 400, {"ok": False, "error": err, "code": "bad_request"}
            ov["egress_mode"] = "smart"; ov["routing"] = rules
            # …and the exit IPs with them: an interface CREATED with a rule already carrying one must keep
            # it, or the first save after creation is where the operator's choice quietly goes missing.
            _xerr = _apply_exit_ips(ov, body, nodes, nid, lenient=True)
            if _xerr:
                return 400, {"ok": False, "error": _xerr, "code": "bad_request"}
        elif _cm != "direct":
            return 400, {"ok": False, "error": "egress_mode must be direct|forward|smart", "code": "bad_request"}
        _blk = _validate_block(body.get("block"), deps.get("panel_settings"))   # active block-category ids (default-on set applied by the UI at create; validated here)
        if _blk:
            ov["block"] = _blk
        # the torrent choice, after block (it wins) — as the edit does; a create's `p2p: null` is "nothing chosen", so a ghost
        # Recreate (whose `ov` is the stored record) keeps the stored choice (S11 review F11)
        _perr = _apply_iface_p2p(ov, {k: v for k, v in body.items() if k != "p2p" or v is not None}, nodes, nid)
        if _perr:
            return 400, {"ok": False, "error": _perr, "code": "bad_request"}
        reach_level_set(ov, body)                    # the create sheet sends the level it preselected (§10.6); validated above
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Creating interface", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface, **({"dropped": _rdrop} if _rdrop["total"] else {})}}

    if method == "POST" and path == "/api/iface/recreate":
        nid = body.get("node") or ""; iface = (body.get("iface") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        ov = (nodes[nid].get("ifaces") or {}).get(iface)
        lc = (ov or {}).get("_lastcfg")
        if not ov or not lc:
            return 400, {"ok": False, "error": "no saved config for that interface — cannot recreate", "code": "bad_request"}
        snap = (deps.get("node_snaps") or {}).get(nid) or {}
        _ent = (snap.get("interfaces") or {}).get(iface)
        if _ent is not None:
            _rep_key = (_ent.get("meta") or {}).get("public_key")
            _healthy = not _ent.get("down") and not _ent.get("stopped")
            if _healthy and _rep_key and _rep_key == (ov.get("public_key") or ""):
                return 400, {"ok": False, "error": "interface is already present and healthy on the node with the key its clients use — nothing to recreate", "code": "bad_request"}
            if _healthy and _rep_key:
                return 400, {"ok": False, "error": "interface is up but serving a different server key — restore the key instead (Adopt/Restore on the interface), which keeps every client working",
                             "code": "wrong_verb"}
        req = iface_restore_req(ov, _current_ivk_pub(deps), fresh=bool(body.get("fresh")))
        if req is None:
            return 400, {"ok": False, "error": "no saved config for that interface — cannot recreate", "code": "bad_request"}
        if any(k in (req.get("awg_params") or {}) for k in AWG3_FIELDS) and not awg_gen_reported(snap):
            # an older node's agent drops the 3.x keys: the interface would come back 2.0 under a record that says 3.1
            return 400, {"ok": False, **perr("{v1}: this node does not report its AmneziaWG version — update it",
                                             v1=nodes[nid].get("name") or nid), "code": "bad_request"}
        # Vault path (full wipe — the node lost its on-disk backup): the browser unsealed the key from the operator
        # vault and RE-sealed it to this node's transport key, so we relay only ciphertext. The node unseals it.
        _sk = body.get("sealed_key")
        if isinstance(_sk, dict) and _sk.get("ct") and _sk.get("eph") and _sk.get("mac"):
            req["sealed_key"] = {k: _sk[k] for k in ("eph", "ct", "mac")}
        nodes[nid].setdefault("create", {})[iface] = req
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Restoring interface", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface}}

    if method == "POST" and path == "/api/iface/cancel":
        # Drop a pending create request. This
        # NOT touch anything the node already brought up — it only removes the panel-side request.
        nid = body.get("node") or ""
        iface = (body.get("iface") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        removed = False
        for key in ("create",):
            d = nodes[nid].get(key)
            if isinstance(d, dict) and iface in d:
                d.pop(iface, None)
                if not d:
                    nodes[nid].pop(key, None)
                removed = True
        if removed:
            nodes_save(deps["nodes_path"], nodes)
            ev_append(roster_path, "node", nid, "Cancelled interface request", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface, "removed": removed}}

    if method == "POST" and path in ("/api/iface/adopt", "/api/iface/restore"):
        # Resolve a drift (a setting edited directly on the server): ADOPT pulls the node's value into
        # the panel override (the panel stops fighting it); RESTORE re-asserts the panel's value.
        nid = body.get("node") or ""; iface = (body.get("iface") or "").strip(); key = (body.get("key") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        ov = (nodes[nid].get("ifaces") or {}).get(iface)
        if not ov or key not in (ov.get("_drift") or {}):
            return 400, {"ok": False, "error": "no pending drift for that setting", "code": "bad_request"}
        if key == "public_key":
            if path.endswith("/adopt"):
                ov["public_key"] = ov["_drift"]["public_key"]
                nodes[nid].setdefault("iface_key", {})[iface] = {"action": "rebaseline", "at": int(time.time())}
                ov.get("_drift", {}).pop("public_key", None)
                if not ov.get("_drift"):
                    ov.pop("_drift", None)
                verb = "Adopted new server key on"
            else:
                _rq = {"action": "restore", "at": int(time.time())}
                _sk = body.get("sealed_key")
                if isinstance(_sk, dict) and _sk.get("ct") and _sk.get("eph") and _sk.get("mac"):
                    _rq["sealed_key"] = {k: _sk[k] for k in ("eph", "ct", "mac")}
                nodes[nid].setdefault("iface_key", {})[iface] = _rq
                verb = "Restoring original server key on"
            nodes_save(deps["nodes_path"], nodes)
            ev_append(roster_path, "node", nid, verb, iface)
            return 200, {"ok": True, "data": {"node": nid, "iface": iface, "key": key}}
        if path.endswith("/adopt"):
            # Adopting what the node runs can make the record AmneziaWG 3.1 (the drift carries the 3.x keys since P1) — the same
            # line a switch crosses, so the same refusal: a WINGS-N proxy never serves a 3.1 interface (D-apps). Restore stays open.
            if key == "awg_params" and awg31_rendered(ov["_drift"][key], None) and not awg31_rendered(ov.get("awg_params"), None):
                _rm = (((((deps.get("node_snaps") or {}).get(nid) or {}).get("interfaces") or {}).get(iface) or {}).get("meta") or {})
                _bl = turn_awg3_blockers(deps, nodes, nid, {ov.get("listen_port") or _rm.get("listen_port"), _rm.get("listen_port")})
                if _bl:
                    return 409, {"ok": False, **turn_awg3_refusal(_bl, iface), "code": "turn_awg3", "turn_proxies": _bl}
            ov[key] = ov["_drift"][key]                 # panel override ← the node's actual value
            ov.setdefault("_synced", {})[key] = ov[key]
            verb = "Adopted server-edited value"
        else:                                           # restore → re-push the panel value
            (ov.get("_synced") or {}).pop(key, None)
            verb = "Restored panel value"
        ov.get("_drift", {}).pop(key, None)
        if not ov.get("_drift"):
            ov.pop("_drift", None)
        if not ov.get("_synced"):
            ov.pop("_synced", None)
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, verb, iface, key)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface, "key": key}}

    # ── turn-proxy management (only on nodes that report turn_manage=true) ──
    if method == "POST" and path == "/api/turn/check-updates":
        # Resolve the latest release tag for each requested fork (the SPA compares to deployed versions).
        forks = body.get("forks") if isinstance(body.get("forks"), list) else []
        latest = {}
        for f in forks[:32]:
            fid = re.sub(r"[^A-Za-z0-9_-]", "", str((f or {}).get("id") or ""))[:48]
            owner = str((f or {}).get("owner") or "").strip()
            if not fid:
                continue
            if fid in WDTT_BUILDS:                       # WDTT: our published build version, NOT the upstream Android tag
                latest[fid] = _wdtt_current_version(fid)
            elif fid == "csqtt":                         # csqtt is OURS to build too — same rule as WDTT above.
                latest[fid] = _csqtt_current_version()
            elif _wdtt_unbuilt(fid):                    # a WDTT fork we no longer build: nothing installable
                latest[fid] = ""
            elif "/" in owner:
                latest[fid] = _resolve_turn_tag(owner)
        return 200, {"ok": True, "data": {"latest": latest}}
    if method == "GET" and path == "/api/changelog":
        # Full panel changelog (newest-first) for the version info bubble's prev/next browser.
        # `want` = the version on the update badge: a cached copy without it is fetched again (at most once a minute).
        want = _short_ver((qs.get("want") or [""])[0])[:40]
        return 200, {"ok": True, "data": {"current": VERSIONS.get("panel") or "", "entries": _changelog_entries(_req_lang(), want)}}
    if method == "GET" and path == "/api/turn/roster-check":
        # Client-app schema drift: each curated source file's latest GitHub commit vs the last-acknowledged one.
        return 200, {"ok": True, "data": _turn_roster_check()}
    if method == "POST" and path == "/api/turn/roster-ack":
        cid = re.sub(r"[^a-z0-9_]", "", str(body.get("client") or ""))[:32]
        files = _turn_roster_ack(cid) if cid in TURN_CLIENTS else None
        if files is None:
            return 400, {"ok": False, "error": "unknown client"}
        return 200, {"ok": True, "data": {"client": cid, "files": files}}
    # ── P4a: versioned per-field roster (field diff + adopt + rollback) — the parseable forks. ?refresh=1 hits GitHub.
    if method == "GET" and path == "/api/turn/p4/report":
        return 200, {"ok": True, "data": _turn_p4_report_all((qs.get("refresh") or [""])[0] == "1")}
    if method == "POST" and path in ("/api/turn/p4/adopt", "/api/turn/p4/setversion"):
        cid = re.sub(r"[^a-z0-9_]", "", str(body.get("client") or ""))[:32]
        if cid not in TURN_CLIENTS:
            return 400, {"ok": False, "error": "unknown client"}
        roster = _turn_roster_load()
        if path.endswith("adopt"):
            def _san(xs):
                return [re.sub(r"[^\w.\-]", "", str(x))[:64] for x in (xs if isinstance(xs, list) else []) if str(x).strip()][:64]
            def _sanv(d):   # {field: [values]} → sanitised
                return {re.sub(r"[^\w.\-]", "", str(k))[:64]: _san(v) for k, v in (d if isinstance(d, dict) else {}).items()} if isinstance(d, dict) else {}
            applied = _turn_p4_adopt(cid, roster, add=_san(body.get("add")), remove=_san(body.get("remove")),
                                     vadd=_sanv(body.get("vadd")), vrem=_sanv(body.get("vrem")))
        else:
            idx = body.get("index")
            if idx is not None:
                try:
                    idx = int(idx)
                except Exception:
                    return 400, {"ok": False, "error": "bad index"}
            if _turn_p4_setversion(cid, roster, idx) is None:
                return 400, {"ok": False, "error": "bad snapshot index"}
            applied = {"pinned_snapshot": idx}
        _turn_roster_save(roster)
        return 200, {"ok": True, "data": {"client": cid, "applied": applied, "report": _turn_client_p4_report(cid, roster.get(cid) or {})}}
    if method == "POST" and path == "/api/turn/install":
        nid = body.get("node") or ""
        fork = (body.get("fork") or "").strip()
        owner = (body.get("owner") or "").strip()
        listen = (body.get("listen") or "").strip()
        connect = (body.get("connect") or "").strip()
        wrap_flags = (body.get("wrap_flags") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        _snap = ((deps.get("node_snaps") or {}).get(nid) or {})
        if _snap.get("turn_capable") is False:
            return 400, {"ok": False, **perr("no turn-proxy build for this node's architecture ({v1}) — forks publish amd64/arm64 only", v1=_snap.get("arch") or "unknown"), "code": "bad_request"}
        # STRICT validation — these values become a systemd unit + subprocess args on the node; a shell/heredoc
        # metacharacter here would be RCE. Legit forks/owners/ip:port/params all pass; injection payloads don't.
        if fork not in SUPPORTED_TURN_FORKS or owner != turn_fork_owner(fork):
            return 400, {"ok": False, "error": "a fork + owner repo are required (letters, digits, . _ - and one /)", "code": "bad_request"}
        if not valid_hostport(listen) or not valid_hostport(connect):
            return 400, {"ok": False, "error": "listen and connect must be ip:port", "code": "bad_request"}
        if not no_ctrl(wrap_flags) or not no_ctrl(body.get("params") or "") or not no_ctrl(body.get("title") or ""):
            return 400, {"ok": False, "error": "control characters are not allowed", "code": "bad_request"}
        if not bind_ip_ok(body.get("bind_ip")):
            return 400, {"ok": False, "error": "Listen on must be an IPv4 address of this node, or Auto", "code": "bad_request"}
        rc = reserved_conflict(deps, nodes, nodes[nid], port=listen.rsplit(":", 1)[1])
        if rc:
            return 400, {"ok": False, "error": rc, "code": "bad_request"}
        _lc = _port_conflict(deps, nodes, nid, listen.rsplit(":", 1)[1])   # not already bound by an interface / proxy / WDTT / mesh link on this node
        if _lc:
            return 400, {"ok": False, **perr("listen port {v1} is already used by {v2} on this node — pick another port", v1=listen.rsplit(":", 1)[1], v2=_lc), "code": "bad_request"}
        _t3 = turn_awg3_target(deps, nodes, nid, fork, connect)   # a WINGS-N proxy never serves an AmneziaWG 3.1 interface
        if _t3:
            return 400, {"ok": False, **_t3, "code": "bad_request"}
        svc = "vk-turn-proxy-" + fork + "-" + listen.rsplit(":", 1)[1]
        if svc in (nodes[nid].get("turn") or {}):
            return 409, {"ok": False, "error": "an install for this fork+port is already pending", "code": "conflict"}
        ireq = {"action": "install", "owner": owner, "listen": listen, "connect": connect,
                "wrap_flags": wrap_flags, "title": (body.get("title") or "").strip(), "at": now()}
        if "params" in body:   # explicit ExecStart tail from the create form (the node uses it verbatim, incl. its wrap key)
            ireq["params"] = body.get("params") or ""
        if (body.get("bind_ip") or "").strip():   # Listen on: the one address to bind (else the node decides)
            ireq["bind_ip"] = body["bind_ip"].strip()
        ireq["pin"] = turn_pin(owner, _node_arch(deps, nid))   # checksum gate: fetch+hash THIS node's-arch binary (bounded+bg) so the pin rides the FIRST sync delivery
        nodes[nid].setdefault("turn", {})[svc] = ireq
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Installed turn-proxy", svc)
        return 200, {"ok": True, "data": {"node": nid, "service": svc}}

    if method == "POST" and path in ("/api/turn/manage", "/api/turn/rotate", "/api/turn/delete", "/api/turn/restart", "/api/turn/reinstall", "/api/turn/stop", "/api/turn/start"):
        # The node pulls these on its next sync, rewrites the unit's ExecStart / regenerates the wrap
        # key / removes it, restarts, and reports the new state (which clears the request).
        nid = body.get("node") or ""; svc = (body.get("service") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not _TURN_SVC_RE.match(svc):                  # svc becomes a unit/path/subprocess component on the node
            return 400, {"ok": False, "error": "invalid service name", "code": "bad_request"}
        if path.endswith("/manage"):
            req = {"action": "manage", "at": now()}
            for k in ("listen", "connect"):
                if (body.get(k) or "").strip():
                    if not valid_hostport(body[k].strip()):
                        return 400, {"ok": False, **perr("{v1} must be ip:port", v1=k), "code": "bad_request"}
                    if k == "listen":   # a moved listen port must not land on another interface / proxy / WDTT / mesh link
                        _np = body["listen"].strip().rsplit(":", 1)[1]
                        _cp = svc.rsplit("-", 1)[-1]   # this proxy's current port (from its service name)…
                        _ownt = [_cp, _port_of(turn_listen_now(deps, nid, svc))]   # …and where it listens now (an earlier move)
                        # `own` = where it listens NOW (an unchanged re-send stays savable, as before) — never the service-name
                        # port: after a move that one may be another holder's (review F1); its other claims by identity
                        _lc = _port_conflict(deps, nodes, nid, _np, own=[_port_of(turn_listen_now(deps, nid, svc))], me=("turn", svc))
                        _pr = p2p_pool_refusal(_np, keep=_ownt)
                        if _pr:
                            return 400, {"ok": False, "error": _pr, "code": "bad_request"}
                        if _lc:
                            return 400, {"ok": False, **perr("listen port {v1} is already used by {v2} on this node — pick another port", v1=_np, v2=_lc), "code": "bad_request"}
                    elif _port_of(body[k].strip()) != _port_of(turn_connect_now(deps, nodes, nid, svc)):   # the Edit sheet re-sends an unchanged one
                        _t3 = turn_awg3_target(deps, nodes, nid, turn_fork(svc), body[k].strip())
                        if _t3:
                            return 400, {"ok": False, **_t3, "code": "bad_request"}
                    req[k] = body[k].strip()
            if "params" in body:                        # free-text ExecStart tail after -connect (node uses it verbatim)
                if not no_ctrl(body.get("params") or ""):
                    return 400, {"ok": False, "error": "control characters are not allowed", "code": "bad_request"}
                req["params"] = body.get("params") or ""
            if "title" in body:                          # optional display label (node stores it on the record)
                if not no_ctrl(body.get("title") or ""):
                    return 400, {"ok": False, "error": "control characters are not allowed", "code": "bad_request"}
                req["title"] = (body.get("title") or "").strip()
            if "bind_ip" in body:                        # Listen on: an address of the box, or "" = Auto
                if not bind_ip_ok(body.get("bind_ip")):
                    return 400, {"ok": False, "error": "Listen on must be an IPv4 address of this node, or Auto", "code": "bad_request"}
                req["bind_ip"] = (body.get("bind_ip") or "").strip()
            verb = "Editing turn-proxy"
        elif path.endswith("/rotate"):
            req = {"action": "rotate", "at": now()}; verb = "Rotating turn-proxy key"
        elif path.endswith("/restart"):
            req = {"action": "restart", "at": now()}; verb = "Restarting turn-proxy"
        elif path.endswith("/stop"):
            req = {"action": "stop", "at": now()}; verb = "Stopping turn-proxy"
        elif path.endswith("/start"):
            req = {"action": "start", "at": now()}; verb = "Starting turn-proxy"
        elif path.endswith("/reinstall"):
            req = {"action": "reinstall", "at": now()}; verb = "Reinstalling turn-proxy"
            if (body.get("owner") or "").strip():   # repo to re-fetch the binary from (UI maps fork → owner)
                if not _OWNER_RE.match(body["owner"].strip()):
                    return 400, {"ok": False, "error": "invalid owner repo", "code": "bad_request"}
                req["owner"] = body["owner"].strip()
            _owner = req.get("owner") or turn_fork_owner(turn_fork(svc))
            _tag = (body.get("tag") or "").strip()
            if _tag:                                 # ROLLBACK to a specific mirrored version
                if not _TAG_RE.match(_tag):
                    return 400, {"ok": False, "error": "invalid version tag", "code": "bad_request"}
                req["pin"] = turn_pin_tag(_owner, _tag, _node_arch(deps, nid))
                if not (req["pin"].get("sums") or {}):   # not in the rollback cache (pruned / never mirrored) → can't verify, refuse
                    return 409, {"ok": False, "error": "that version isn't in the rollback cache — the panel has no verified binary for it", "code": "no_mirror"}
                _turn_hold_set(nid, "fork:" + turn_fork(svc), _tag)   # pin the choice so the auto-updater doesn't roll it forward (per node+fork — shared binary)
                verb = "Rolling back turn-proxy"
            else:                                    # normal reinstall / update-to-latest → release any rollback hold
                req["pin"] = turn_pin(_owner, _node_arch(deps, nid))   # checksum gate (owner from the request, else the fork's catalog owner; this node's arch)
                _turn_hold_clear(nid, "fork:" + turn_fork(svc))
                _cur = ""
                for _tp in (((deps.get("node_snaps") or {}).get(nid) or {}).get("turn_proxies") or []):
                    if _tp.get("service") == svc:
                        _cur = (_tp.get("version") or "").strip(); break
                _newtag = (req["pin"] or {}).get("tag") or ""
                if _cur and _cur != _newtag and _TAG_RE.match(_cur):
                    threading.Thread(target=turn_pin_tag, args=(_owner, _cur, _node_arch(deps, nid)), daemon=True).start()
        else:
            req = {"action": "delete", "at": now()}; verb = "Deleting turn-proxy"
        nodes[nid].setdefault("turn", {})[svc] = req
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, verb, svc)
        return 200, {"ok": True, "data": {"node": nid, "service": svc}}

    if method == "GET" and path == "/api/resolve":
        h = (qs.get("host", [""])[0] or "").strip().lower().rstrip(".")
        if not h or len(h) > 253 or not _HOSTNAME_RE.match(h):
            return 400, {"ok": False, "error": "bad host", "code": "bad_request"}
        out = []
        with contextlib.suppress(Exception):
            for fam, _st, _pr, _cn, sa in socket.getaddrinfo(h, None, proto=socket.IPPROTO_TCP):
                if sa and sa[0] and sa[0] not in out:
                    out.append(sa[0])
        return 200, {"ok": True, "data": {"host": h, "ips": out}}

    if method == "GET" and path == "/api/exit/check":
        nid = (qs.get("node", [""])[0] or "").strip()
        dev = (qs.get("dev", [""])[0] or "").strip()
        ifc = (qs.get("iface", [""])[0] or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if len(dev) > 64 or not re.match(r"^[A-Za-z0-9_.@-]*$", dev):
            return 400, {"ok": False, "error": "bad device name", "code": "bad_request"}
        c = nodes[nid] or {}
        _links = {(lk or {}).get("iface") for lk in (c.get("links") or {}).values()}
        _pfx = node_mesh_cfg(deps, c).get("iface_prefix") or "swg_"
        snap = (deps.get("node_snaps") or {}).get(nid) or {}
        why = exit_device_refusal(c, dev, mesh_prefix=_pfx, link_ifaces=_links, iface=ifc or None,
                                  nics=(snap.get("ether_ifaces") or []), gws=snap.get("ether_gws"),
                                  wan=(snap.get("wan_iface") or ""),
                                  # the typed gateway of a STORED exit for this device, if there is one —
                                  # otherwise the picker would call a working exit bad
                                  gw_known=any(str((x or {}).get("device") or "") == dev
                                               and str((x or {}).get("gw") or "").strip()
                                               for x in (c.get("exits") or []) if isinstance(x, dict)))
        seen = (deps.get("node_seen") or {}).get(nid) or 0
        stale_ms = int(((deps.get("panel_settings") or {}).get("advanced") or {}).get("node_stale_ms") or 30000)
        age = (time.time() - seen) if seen else None
        cands = snap.get("exit_candidates")
        known, up, bootp = None, None, None
        # Every reason to say nothing, listed rather than collapsed — each is a different fact about US, and
        # none of them is a fact about the device the operator typed.
        if cands is not None and age is not None and (age * 1000) <= stale_ms:
            hit = next((x for x in cands if (x or {}).get("name") == dev), None)
            known = hit is not None
            if hit:
                up, bootp = hit.get("up"), hit.get("boot_persist")
        return 200, {"ok": True, "data": {
            "node": nid, "dev": dev, "known": known, "why_not": why or "",
            "offerable": (why is None) and (known is True),
            "up": up, "boot_persist": bootp,
            "seen_age_s": (int(age) if age is not None else None),
            "reports_exits": cands is not None}}

    if method == "POST" and path == "/api/exit/restore":
        nid = str(body.get("node") or "").strip()
        xid = str(body.get("id") or "").strip()
        blob = body.get("key_blob")
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not (isinstance(blob, dict) and blob.get("ct") and blob.get("eph") and blob.get("mac")):
            return 400, {"ok": False, "error": "not a sealed key", "code": "bad_request"}
        _x = next((x for x in (nodes[nid].get("exits") or [])
                   if isinstance(x, dict) and str(x.get("id")) == xid), None)
        if not _x:
            return 404, {"ok": False, "error": "unknown exit", "code": "not_found"}
        _x["key_restore"] = {k: blob[k] for k in ("eph", "ct", "mac")}
        _pub = str(body.get("pub") or "").strip()
        if _pub and len(_pub) <= 64:
            _x["key_restore_pub"] = _pub
        else:
            _x.pop("key_restore_pub", None)
        _x["key_restore_at"] = int(time.time())
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Restoring an exit key from the vault", _x.get("label") or xid, "")
        return 200, {"ok": True, "data": {"node": nid, "id": xid}}

    if method == "POST" and path == "/api/exit/escrow/forget":
        nid = str(body.get("node") or "").strip()
        xid = str(body.get("id") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        _x = next((x for x in (nodes[nid].get("exits") or [])
                   if isinstance(x, dict) and str(x.get("id")) == xid), None)
        if not _x:
            return 404, {"ok": False, "error": "unknown exit", "code": "not_found"}
        _had = bool((_x.get("key_blob_prev") or {}).get("ct"))
        _x.pop("key_blob_prev", None)
        if _had:
            nodes_save(deps["nodes_path"], nodes)
            ev_append(roster_path, "node", nid, "Kept the exit's new key and forgot the previous one",
                      _x.get("label") or xid, "")
        return 200, {"ok": True, "data": {"node": nid, "id": xid, "forgot": _had}}

    if method == "POST" and path == "/api/iface/escrow/verified":
        nid = str(body.get("node") or "").strip()
        iface = str(body.get("iface") or "").strip()
        fam = str(body.get("family") or "iface").strip()
        if fam not in ("iface", "wdtt"):
            return 400, {"ok": False, "error": "family must be iface or wdtt", "code": "bad_request"}
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        ov = ((nodes[nid].get("wdtt" if fam == "wdtt" else "ifaces") or {}).get(iface))
        if not isinstance(ov, dict):
            return 404, {"ok": False, "error": "unknown interface", "code": "not_found"}
        vp = _current_ivk_pub(deps)
        if not vp:
            return 400, {"ok": False, "error": "key escrow is not enabled on this panel", "code": "bad_request"}
        kb = ov.get("key_blob") or {}
        _ident = (ov.get("server_pub") or kb.get("pub") or "") if fam == "wdtt" else (ov.get("public_key") or "")
        if not kb.get("ct") or kb.get("pub") != _ident:
            return 400, {"ok": False, **perr("no escrowed key for {v1} to verify", v1=iface), "code": "bad_request"}
        ov["escrow_proved"] = {"vault": vp, "at": int(time.time())}
        if not kb.get("vault"):
            kb["vault"] = vp
            ov["key_blob"] = kb
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Verified the escrowed key opens", iface, fam)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface, "family": fam, "vault": vp}}

    if method == "POST" and path == "/api/turn/reclaim":
        nid = str(body.get("node") or "").strip()
        fam = str(body.get("family") or "").strip()
        iface = str(body.get("iface") or "").strip()
        if fam not in ("wdtt", "csqtt"):
            return 400, {"ok": False, "error": "family must be wdtt or csqtt", "code": "bad_request"}
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if iface in ((nodes[nid].get(fam)) or {}):
            return 400, {"ok": False, **perr("this node already manages {v1}", v1=iface), "code": "bad_request"}
        # Only ever act on what the NODE reports, and only on what it reports as OWNERLESS — a hand-made
        # request must not be able to conjure an instance record for something that is not there.
        _snap = ((deps.get("node_snaps") or {}).get(nid) or {})
        _rep = next((e for e in (_snap.get(fam) or []) if (e or {}).get("iface") == iface), None)
        if not _rep:
            return 400, {"ok": False, **perr("this node doesn't report a {v1} server on {v2} — refresh and try again", v1=fam, v2=iface), "code": "bad_request"}
        inst = {"iface": iface}
        for k in ("listen", "fork", "title", "wg_addr", "tun_addr", "wg_port", "max_passwords"):
            v = _rep.get(k)
            if v in (None, "", {}):
                continue
            if isinstance(v, str) and not no_ctrl(v):
                return 400, {"ok": False, "error": "control characters are not allowed", "code": "bad_request"}
            inst[k] = v
        _dv, _de = turn_client_dns(_rep.get("dns"), inst.get("fork") or fam, False)   # the node's own, carried across
        if _dv and not _de:
            inst["dns"] = _dv
        if fam == "wdtt":
            inst.setdefault("wg_port", 56001)
            inst.setdefault("max_passwords", 200)
            inst.setdefault("fork", "amurcanov")
            if not _WDTT_CIDR_RE.match(inst.get("wg_addr") or ""):
                return 400, {"ok": False, **perr("the node reports no usable subnet for {v1}", v1=iface), "code": "bad_request"}
        else:
            inst.setdefault("fork", _csqtt_default_fork())
        _ovsub = str(body.get("subnet") or "").strip()
        if _ovsub:
            if not _WDTT_CIDR_RE.match(_ovsub):
                return 400, {"ok": False, "error": "subnet must be an IPv4 CIDR (e.g. 10.66.70.1/24)", "code": "bad_request"}
            inst["wg_addr" if fam == "wdtt" else "tun_addr"] = _ovsub
        _sub = inst.get("wg_addr") or inst.get("tun_addr") or ""
        if _sub:
            fc = subnet_fleet_conflict(deps, nodes, _sub, skip_node=nid, skip_iface=iface)
            if fc:
                return 400, {"ok": False, "error": fc, "code": "bad_request"}
        # …its users, from the store the node is still holding. Same shape the take-over importer writes, so a
        # reclaimed user is indistinguishable from an adopted one afterwards.
        roster = roster_load(roster_path)
        roster.setdefault("peers", {})
        pw_field = "wdtt_password" if fam == "wdtt" else "csqtt_password"
        known = {p.get(pw_field) for p in (roster.get("peers") or {}).values()
                 if isinstance(p, dict) and p.get(pw_field)
                 and any((t or {}).get("node") == nid and (t or {}).get("iface") == iface
                         for t in (p.get("targets") or []))}
        imported = 0
        for pw, meta in ((_rep.get("passwords") or {}) if isinstance(_rep.get("passwords"), dict) else {}).items():
            if not pw or pw in known or not no_ctrl(str(pw)):
                continue
            meta = meta if isinstance(meta, dict) else {}
            pid = gen_id()
            while pid in roster["peers"]:
                pid = gen_id()
            f = {"id": pid, "user_id": None,
                 "title": (str(meta.get("comment") or "").strip() or "reclaimed")[:60],
                 "pubkey": "", "psk": "",
                 "targets": [{"node": nid, "iface": iface, "ip": "", "type": fam}],
                 pw_field: pw, "created_at": int(time.time()), "modified_at": int(time.time())}
            if meta.get("is_deactivated"):
                f["disabled"] = True
            roster["peers"][pid] = f
            imported += 1
        if imported:
            roster_save(roster_path, roster)
        nodes[nid].setdefault(fam, {})[iface] = inst      # …and only NOW does the panel claim it
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Reclaimed a WDTT server" if fam == "wdtt" else "Reclaimed a csqtt server", iface,
                  ("%d user(s) kept" % imported) if imported else "no users in its store",
                  detail_key="{count} kept" if imported else "no users in its store",
                  detail_vars={"count": {"n": imported, "noun": "user"}})
        return 200, {"ok": True, "data": {"node": nid, "iface": iface, "family": fam, "users": imported}}

    if method == "POST" and path == "/api/turn/title":
        # Set ONLY the display title — the node updates its turn record but does NOT restart the proxy
        # (a title is cosmetic). Keeps the running service untouched, unlike /manage.
        nid = body.get("node") or ""; svc = (body.get("service") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not _TURN_SVC_RE.match(svc) or not no_ctrl(body.get("title") or ""):
            return 400, {"ok": False, "error": "invalid service or title", "code": "bad_request"}
        nodes[nid].setdefault("turn", {})[svc] = {"action": "title", "title": (body.get("title") or "").strip(), "at": now()}
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Renaming turn-proxy", svc)
        return 200, {"ok": True, "data": {"node": nid, "service": svc}}

    if method == "POST" and path == "/api/turn/onboard":
        # Adopt an existing turn-proxy systemd unit by its .service path; the node reads it + reports it.
        nid = body.get("node") or ""; sp = (body.get("path") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not sp or " " in sp or not sp.startswith("/"):
            return 400, {"ok": False, "error": "an absolute .service path is required", "code": "bad_request"}
        lst = nodes[nid].setdefault("turn_onboard", [])
        if sp not in lst:
            lst.append(sp)
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Onboarding turn-proxy", sp)
        return 200, {"ok": True, "data": {"node": nid, "path": sp}}

    if method == "POST" and path == "/api/turn/cancel":
        nid = body.get("node") or ""; svc = (body.get("service") or "").strip(); sp = (body.get("path") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        removed = False
        d = nodes[nid].get("turn")
        if isinstance(d, dict) and svc and svc in d:
            d.pop(svc, None); removed = True
            if not d: nodes[nid].pop("turn", None)
        lst = nodes[nid].get("turn_onboard")
        if isinstance(lst, list) and sp and sp in lst:
            lst.remove(sp); removed = True
            if not lst: nodes[nid].pop("turn_onboard", None)
        if removed:
            nodes_save(deps["nodes_path"], nodes)
            ev_append(roster_path, "node", nid, "Cancelled turn-proxy request", svc or sp)
        return 200, {"ok": True, "data": {"node": nid, "removed": removed}}

    if method == "POST" and path == "/api/iface/restart":
        # Bounce the interface's service on the node (<tool>-quick down/up) — recovers a DOWN iface.
        nid = body.get("node") or ""
        iface = (body.get("iface") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not iface:
            return 400, {"ok": False, "error": "interface name is required", "code": "bad_request"}
        nodes[nid].setdefault("restart", {})[iface] = int(time.time())   # node bounces it on its next sync
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Restarting interface", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface}}

    if method == "POST" and path in ("/api/iface/stop", "/api/iface/start"):
        # Stop (down + disable, conf kept) or start (up + enable) the interface's service on the node.
        nid = body.get("node") or ""
        iface = (body.get("iface") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not iface:
            return 400, {"ok": False, "error": "interface name is required", "code": "bad_request"}
        stopping = path.endswith("/stop")
        key, other = ("iface_stop", "iface_start") if stopping else ("iface_start", "iface_stop")
        (nodes[nid].get(other) or {}).pop(iface, None)        # a new stop cancels a pending start (and vice-versa)
        nodes[nid].setdefault(key, {})[iface] = int(time.time())
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Stopping interface" if stopping else "Starting interface", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface}}

    if method == "POST" and path == "/api/iface/delete":
        nid = body.get("node") or ""
        iface = (body.get("iface") or "").strip()
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if not iface:
            return 400, {"ok": False, "error": "interface name is required", "code": "bad_request"}
        nodes[nid].setdefault("delete", {})[iface] = int(time.time())   # queue the node teardown
        for key in ("create", "ifaces"):
            d = nodes[nid].get(key)
            if isinstance(d, dict):
                d.pop(iface, None)
                if not d:
                    nodes[nid].pop(key, None)
        nodes_save(deps["nodes_path"], nodes)
        roster = roster_load(roster_path); changed = False         # purge peer targets on this iface
        for pid in list(roster["peers"].keys()):
            p = roster["peers"][pid]
            kept = [t for t in p.get("targets", []) if not (t.get("node") == nid and t.get("iface") == iface)]
            if len(kept) != len(p.get("targets", [])):
                changed = True
                if kept:
                    p["targets"] = kept; p["modified_at"] = int(time.time())
                else:
                    del roster["peers"][pid]
        if changed:
            roster_save(roster_path, roster)
        ev_append(roster_path, "node", nid, "Deleting interface", iface)
        return 200, {"ok": True, "data": {"node": nid, "iface": iface}}

    if method == "POST" and path == "/api/nodes/rotate":
        nid = body.get("id") or ""
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        token = base64.urlsafe_b64encode(os.urandom(18)).decode().rstrip("=")
        nodes[nid]["token_hash"] = make_token_hash(token)
        nodes[nid]["token_sha"] = hashlib.sha256(token.encode()).hexdigest()   # fast-lookup index (see find_node_by_token)
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Rotated node token", nodes[nid].get("name", nid))
        return 200, {"ok": True, "data": {"id": nid, "name": nodes[nid].get("name"), "token": token}}

    if method == "POST" and path == "/api/nodes/remesh":
        nid = body.get("id") or ""
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        if len(nodes) < 2:
            return 400, {"ok": False, "error": "there is no mesh to re-provision — this fleet has one node",
                         "code": "bad_request"}
        mesh_reprovision_node(nodes, nid)
        reconcile_mesh(nodes, deps.get("node_snaps") or {}, deps)
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Re-provisioned mesh links", nodes[nid].get("name", nid))
        return 200, {"ok": True, "data": {"id": nid, "links": len((nodes[nid].get("links") or {}))}}

    if method == "POST" and path == "/api/nodes/flag-remove":
        # Soft removal: mark the node "removing" but keep it (and its peers) working until it
        # signs off (uninstall -> /api/node/goodbye). Force-remove cuts it off without waiting.
        nid = body.get("id") or ""
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        nodes[nid]["removing"] = True
        nodes[nid]["removing_at"] = now()
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Flagged node for removal", nodes[nid].get("name", nid))
        return 200, {"ok": True, "data": {"id": nid}}

    if method == "POST" and path == "/api/nodes/unflag-remove":   # cancel a pending soft removal
        nid = body.get("id") or ""
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        nodes[nid].pop("removing", None); nodes[nid].pop("removing_at", None)
        nodes_save(deps["nodes_path"], nodes)
        ev_append(roster_path, "node", nid, "Cancelled node removal", nodes[nid].get("name", nid))
        return 200, {"ok": True, "data": {"id": nid}}

    if method == "POST" and path == "/api/nodes/delete":     # force-remove (no waiting for goodbye)
        nid = body.get("id") or ""
        if nid not in nodes:
            return 404, {"ok": False, "error": "unknown node", "code": "not_found"}
        nm = node_remove(deps, nid)
        return 200, {"ok": True, "data": {"id": nid, "name": nm}}

    return 404, {"ok": False, "error": "not found", "code": "bad_request"}


# external integration API (v1)

API_TOKEN_PREFIX = "swgp_"
WEBHOOK_EVENTS = ("peer.added", "peer.removed", "node.online", "node.offline")


def _api_token_hash(tok):
    return hashlib.sha256(("swg-api\x00" + (tok or "")).encode()).hexdigest()


def _api_settings(deps):
    a = (deps.get("panel_settings") or {}).get("api")
    return a if isinstance(a, dict) else {}


def api_token_lookup(deps, tok):
    """The stored token record matching a presented raw token, or None. Constant-time compare;
    returns None when the API is disabled so a stale token stops working the moment it's turned off."""
    tok = (tok or "").strip()
    if not tok:
        return None
    a = _api_settings(deps)
    if not a.get("enabled"):
        return None
    h = _api_token_hash(tok)
    hit = None
    for t in (a.get("tokens") or []):
        if hmac.compare_digest(str(t.get("hash", "")), h):
            hit = t
    return hit


def _api_public_view(deps):
    """Redacted `api` settings for the browser (/api/state): token HASHES and webhook SECRETS never
    leave the panel. last_used is an in-memory best-effort timestamp (no disk write per scrape)."""
    a = _api_settings(deps)
    seen = deps.get("api_seen") or {}
    return {"enabled": bool(a.get("enabled")),
            "tokens": [{"id": t.get("id"), "label": t.get("label"), "created": t.get("created"),
                        "last_used": seen.get(t.get("hash"))} for t in (a.get("tokens") or [])],
            "webhooks": [{"id": w.get("id"), "url": w.get("url"), "events": w.get("events") or [],
                          "enabled": w.get("enabled", True) is not False, "has_secret": bool(w.get("secret"))}
                         for w in (a.get("webhooks") or [])]}


def _ipof(cidr):
    s = (str(cidr or "")).split(",")[0].strip()
    return (s.split("/")[0] or None)


def _pct(used, total):
    return round(100.0 * used / total, 1) if total else None


def _ext_health_pcts(h):
    """cpu/mem/disk percentages + uptime from a node's health block (see swg-noded collect_health).

    `cpu_percent` is real utilization (0-100, mean across cores) when the node reports it; it falls
    back to load-per-core for a node on an older swg-noded. Must track health_pcts() so /metrics and
    /api/v1 never disagree with the UI about the same node.
    """
    h = h or {}
    load = h.get("load") or []
    ncpu = h.get("ncpu") or 1
    cpu_pct = h.get("cpu_pct")
    if isinstance(cpu_pct, (int, float)):
        cpu = round(max(0.0, min(100.0, float(cpu_pct))), 1)
    else:
        cpu = round(min(100.0, 100.0 * (load[0] / ncpu)), 1) if load and ncpu else None
    mem = h.get("mem") or {}
    mem_pct = _pct(mem.get("used", 0), mem.get("total", 0)) if mem.get("total") else None
    disks = h.get("disk") or []
    disk_pct = _pct((disks[0] or {}).get("used", 0), (disks[0] or {}).get("total", 0)) if disks and disks[0].get("total") else None
    # Peak + saturated-vCPU count are DERIVED from the per-vCPU list the node sends — never inferred
    # from (max - mean), which cannot distinguish 1 pinned core from 5 and goes silent at 6-of-8.
    cores = [c for c in (h.get("cpu_cores") or []) if isinstance(c, (int, float))]
    cpu_max = round(max(cores), 1) if cores else None
    cpu_hot = sum(1 for c in cores if c >= CPU_SAT_PCT) if cores else None
    iow = h.get("cpu_iowait_pct")
    iow = round(max(0.0, min(100.0, float(iow))), 1) if isinstance(iow, (int, float)) else None
    return {"cpu_percent": cpu, "cpu_max_percent": cpu_max, "cpu_saturated_cores": cpu_hot,
            "cpu_cores": cores or None, "cpu_iowait_percent": iow,
            "mem_percent": mem_pct, "disk_percent": disk_pct, "uptime_s": h.get("uptime")}


_EXT_CACHE = {"at": 0.0, "data": None}
_ext_cache_lock = threading.Lock()
EXT_CACHE_TTL = float(os.environ.get("SWG_PANEL_EXT_TTL", "3") or 3)


def _ext_build(deps):
    """Load nodes + roster ONCE and derive {servers, peers}. Memoized (EXT_CACHE_TTL) and double-checked
    under a lock so concurrent scrapes build it a single time, then read the same result."""
    c = _EXT_CACHE
    if c["data"] is not None and (time.monotonic() - c["at"]) < EXT_CACHE_TTL:
        return c["data"]
    with _ext_cache_lock:
        if c["data"] is not None and (time.monotonic() - c["at"]) < EXT_CACHE_TTL:
            return c["data"]
        nodes = nodes_load(deps["nodes_path"])
        snaps = deps.get("node_snaps") or {}
        seen = deps.get("node_seen") or {}
        roster = roster_load(deps["roster_path"])
        data = {"servers": _ext_servers_from(deps, nodes, snaps, seen),
                "peers": _ext_peers_from(deps, nodes, snaps, seen, roster)}
        c["data"] = data
        c["at"] = time.monotonic()
        return data


def ext_servers(deps):
    return _ext_build(deps)["servers"]


def _ext_servers_from(deps, nodes, snaps, seen):
    """The fleet as an external client sees it: one dict per node, status derived from sync staleness."""
    now = deps.get("now", lambda: int(time.time()))()
    out = []
    for nid, c in sorted(nodes.items(), key=lambda kv: (kv[1].get("pos", 1 << 30), kv[1].get("created", 0), kv[0])):
        snap = snaps.get(nid) or {}
        ls = seen.get(nid)
        online = ls is not None and (now - ls) <= NODE_OFFLINE
        pc = pon = 0
        rx = tx = 0.0
        ifaces = []
        for ifn, blk in (snap.get("interfaces") or {}).items():
            if is_system_iface(deps, nodes, nid, ifn):    # skip panel-managed mesh links — client-facing view only
                continue
            ps = blk.get("peers") or []
            pc += len(ps)
            pon += sum(1 for p in ps if p.get("online"))
            rx += sum(p.get("rx_speed", 0) or 0 for p in ps)
            tx += sum(p.get("tx_speed", 0) or 0 for p in ps)
            ifaces.append(ifn)
        rec = {"id": nid, "name": c.get("name", nid),
               "status": "online" if online else ("never_seen" if ls is None else "offline"),
               "online": bool(online),
               "kind": snap.get("kind") or c.get("kind"),
               "version": snap.get("noded_version"),
               "hostname": snap.get("hostname"),
               "endpoint_host": c.get("endpoint_host") or None,
               "routing_mode": c.get("routing_mode") or "kernel",
               "interfaces": ifaces,
               "peers": pc, "peers_online": pon,
               "rx_bytes_per_sec": int(rx), "tx_bytes_per_sec": int(tx),
               "last_seen": ls, "last_seen_age_s": (now - ls) if ls is not None else None}
        rec.update(_ext_health_pcts(snap.get("health")))
        out.append(rec)
    return out


def _resolve_nid(nodes, ref):
    """Accept a node id OR a display name (friendlier for hand-written dashboards)."""
    if ref in nodes:
        return ref
    for k, c in nodes.items():
        if c.get("name") == ref:
            return k
    return None


def ext_peers_for_node(deps, ref):
    """Peers observed on ONE node, with last-handshake timing, enriched from the roster. None if unknown."""
    nodes = nodes_load(deps["nodes_path"])
    nid = _resolve_nid(nodes, ref)
    if nid is None:
        return None
    snap = (deps.get("node_snaps") or {}).get(nid) or {}
    roster = roster_load(deps["roster_path"])
    users = roster.get("users") or {}
    by_pub = {p.get("pubkey"): (pid, p) for pid, p in (roster.get("peers") or {}).items()}
    out = []
    for ifn, blk in (snap.get("interfaces") or {}).items():
        if is_system_iface(deps, nodes, nid, ifn):        # mesh links aren't user peers
            continue
        for p in (blk.get("peers") or []):
            pid, pr = by_pub.get(p.get("public_key"), (None, {}))
            uid = pr.get("user_id")
            out.append({"peer_id": pid, "public_key": p.get("public_key"), "iface": ifn,
                        "user": (users.get(uid) or {}).get("name") if uid else None,
                        "title": pr.get("title") or None,
                        "address": _ipof(p.get("allowed_ips")),
                        "online": bool(p.get("online")),
                        "endpoint": p.get("endpoint"),
                        "last_handshake": p.get("last_handshake") or None,
                        "handshake_age_s": p.get("handshake_age"),
                        "rx_bytes": int(p.get("rx_bytes", 0) or 0), "tx_bytes": int(p.get("tx_bytes", 0) or 0),
                        "rx_bytes_per_sec": int(p.get("rx_speed", 0) or 0), "tx_bytes_per_sec": int(p.get("tx_speed", 0) or 0)})
    return {"node": nid, "name": nodes[nid].get("name", nid), "peers": out}


def ext_peers_all(deps):
    return _ext_build(deps)["peers"]


def _ext_peers_from(deps, nodes, snaps, seen, roster):
    """Roster-wide peer identities with per-target presence. A peer is `online` if it's online on ANY
    of its deployed nodes (matches the panel's most-alive-wins view for multi-node peers)."""
    now = deps.get("now", lambda: int(time.time()))()
    users = roster.get("users") or {}
    obs = {}
    for nid, snap in list(snaps.items()):               # a copy — syncs insert and removals pop meanwhile
        for blk in (snap.get("interfaces") or {}).values():
            for p in (blk.get("peers") or []):
                obs[(nid, p.get("public_key"))] = p
    def node_live(nid):
        ls = seen.get(nid)
        return ls is not None and (now - ls) <= NODE_OFFLINE
    out = []
    for pid, p in (roster.get("peers") or {}).items():
        pub = p.get("pubkey")
        uid = p.get("user_id")
        online = False
        last_hs = None
        targets = []
        for t in (p.get("targets") or []):
            o = obs.get((t.get("node"), pub))
            on = bool(o and o.get("online"))
            online = online or on
            if o and o.get("last_handshake"):
                last_hs = max(last_hs or 0, o["last_handshake"])
            targets.append({"node": t.get("node"), "iface": t.get("iface"), "address": t.get("ip"),
                            "online": on, "node_live": node_live(t.get("node"))})
        out.append({"peer_id": pid, "public_key": pub, "title": p.get("title") or None,
                    "user": (users.get(uid) or {}).get("name") if uid else None, "user_id": uid,
                    "online": online, "last_handshake": last_hs, "targets": targets})
    return out


def ext_summary(deps):
    b = _ext_build(deps)
    servers = b["servers"]
    peers = b["peers"]
    now = deps.get("now", lambda: int(time.time()))()
    return {"version": VERSIONS.get("panel"),
            "nodes": {"total": len(servers), "online": sum(1 for s in servers if s["online"])},
            "peers": {"total": len(peers), "online": sum(1 for p in peers if p["online"])},
            "throughput": {"rx_bytes_per_sec": sum(s["rx_bytes_per_sec"] for s in servers),
                           "tx_bytes_per_sec": sum(s["tx_bytes_per_sec"] for s in servers)},
            "generated_at": now}


def _prom_esc(v):
    return str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def ext_metrics(deps):
    """Prometheus text exposition (v0.0.4). Per-node cardinality only — never per-peer, which would
    explode the series count on a large fleet; peer detail lives in the JSON API."""
    servers = ext_servers(deps)
    s = ext_summary(deps)
    L = []
    def g(name, help_, typ="gauge"):
        L.append("# HELP %s %s" % (name, help_))
        L.append("# TYPE %s %s" % (name, typ))
    def row(_metric, val, **labels):
        lbl = ",".join('%s="%s"' % (k, _prom_esc(v)) for k, v in labels.items() if v is not None)
        L.append("%s{%s} %s" % (_metric, lbl, val) if lbl else "%s %s" % (_metric, val))
    g("swg_panel_up", "1 whenever the panel answers a scrape.")
    row("swg_panel_up", 1)
    g("swg_panel_build_info", "Panel build/version info.")
    row("swg_panel_build_info", 1, version=s["version"])
    g("swg_nodes_total", "Configured nodes in the fleet.")
    row("swg_nodes_total", s["nodes"]["total"])
    g("swg_nodes_online", "Nodes that have synced within the offline window.")
    row("swg_nodes_online", s["nodes"]["online"])
    g("swg_peers_total", "Peer identities in the roster.")
    row("swg_peers_total", s["peers"]["total"])
    g("swg_peers_online", "Peers online on at least one node.")
    row("swg_peers_online", s["peers"]["online"])
    g("swg_fleet_rx_bytes_per_second", "Fleet aggregate download rate (bytes/s).")
    row("swg_fleet_rx_bytes_per_second", s["throughput"]["rx_bytes_per_sec"])
    g("swg_fleet_tx_bytes_per_second", "Fleet aggregate upload rate (bytes/s).")
    row("swg_fleet_tx_bytes_per_second", s["throughput"]["tx_bytes_per_sec"])
    g("swg_node_up", "1 if the node is online (synced within the offline window), else 0.")
    for n in servers:
        row("swg_node_up", 1 if n["online"] else 0, node=n["id"], name=n["name"])
    g("swg_node_peers", "Peers configured on the node.")
    for n in servers:
        row("swg_node_peers", n["peers"], node=n["id"], name=n["name"])
    g("swg_node_peers_online", "Peers currently online on the node.")
    for n in servers:
        row("swg_node_peers_online", n["peers_online"], node=n["id"], name=n["name"])
    g("swg_node_rx_bytes_per_second", "Node download rate (bytes/s).")
    for n in servers:
        row("swg_node_rx_bytes_per_second", n["rx_bytes_per_sec"], node=n["id"], name=n["name"])
    g("swg_node_tx_bytes_per_second", "Node upload rate (bytes/s).")
    for n in servers:
        row("swg_node_tx_bytes_per_second", n["tx_bytes_per_sec"], node=n["id"], name=n["name"])
    g("swg_node_last_seen_timestamp_seconds", "Unix time of the node's last sync.")
    for n in servers:
        if n["last_seen"] is not None:
            row("swg_node_last_seen_timestamp_seconds", n["last_seen"], node=n["id"], name=n["name"])
    # HELP is fleet-wide, so it must not say "vCPU" (VMs) or "core" (bare metal, where hyperthreads inflate
    # the count) — /proc/stat's cpuN are logical CPUs either way. Only the UI picks a per-node label.
    for metric, key, help_ in (("swg_node_cpu_percent", "cpu_percent", "Node CPU utilization, mean across logical CPUs (0-100)."),
                               ("swg_node_cpu_max_percent", "cpu_max_percent", "Node CPU utilization of its busiest single logical CPU (0-100)."),
                               ("swg_node_cpu_saturated_cores", "cpu_saturated_cores", "Number of the node's logical CPUs at or above %d%% utilization." % CPU_SAT_PCT),
                               ("swg_node_cpu_iowait_percent", "cpu_iowait_percent", "Node time waiting on I/O (0-100). Raises load average but is NOT CPU."),
                               ("swg_node_memory_percent", "mem_percent", "Node memory used as a percentage."),
                               ("swg_node_disk_percent", "disk_percent", "Node primary-disk used as a percentage."),
                               ("swg_node_uptime_seconds", "uptime_s", "Node uptime in seconds.")):
        g(metric, help_)
        for n in servers:
            if n.get(key) is not None:
                row(metric, n[key], node=n["id"], name=n["name"])
    return "\n".join(L) + "\n"


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):     # never follow a redirect → can't be bounced to an internal target
        return None
_WEBHOOK_OPENER = urllib.request.build_opener(_NoRedirect)


def webhook_host_ok(url):
    """Reject a webhook target that resolves to link-local (169.254 — cloud-metadata credential theft),
    multicast, reserved, or unspecified. Loopback and RFC1918 private ranges are deliberately ALLOWED — a
    local receiver or an internal alerting endpoint is a legitimate, common webhook target. The narrow block
    kills the metadata-SSRF escalation without breaking internal/localhost webhooks."""
    try:
        host = urlparse(url).hostname
    except Exception:
        return False
    if not host:
        return False
    try:
        infos = socket.getaddrinfo(host, None)
    except Exception:
        return True                      # unresolvable NOW → nothing to SSRF (the POST just fails); don't reject a legit host over a DNS hiccup
    for ai in infos:
        try:
            ip = ipaddress.ip_address(ai[4][0])
        except ValueError:
            continue
        if ip.is_link_local or ip.is_multicast or ip.is_reserved or ip.is_unspecified:
            return False
    return True


def _webhook_post(url, secret, body_bytes, timeout=8):
    if not webhook_host_ok(url):              # re-check at send time (config may pre-date the guard) — no redirects
        raise ValueError("webhook target resolves to a disallowed (internal) address")
    headers = {"Content-Type": "application/json", "User-Agent": "swg-panel-webhook"}
    if secret:
        headers["X-SWG-Signature"] = "sha256=" + hmac.new(secret.encode(), body_bytes, hashlib.sha256).hexdigest()
    req = urllib.request.Request(url, data=body_bytes, headers=headers, method="POST")
    with _WEBHOOK_OPENER.open(req, timeout=timeout) as r:
        return getattr(r, "status", None) or r.getcode()


def webhook_emit(deps, event, data):
    """Fire-and-forget delivery to every enabled webhook subscribed to `event`, in a daemon thread so a
    slow/unreachable endpoint never blocks the API. One retry on failure; delivery is best-effort."""
    a = _api_settings(deps)
    hooks = [h for h in (a.get("webhooks") or [])
             if h.get("enabled", True) is not False and h.get("url")
             and (not h.get("events") or event in h["events"])]
    if not hooks:
        return
    body = json.dumps({"event": event, "ts": int(time.time()), "data": data}, separators=(",", ":")).encode()
    def _deliver():
        for h in hooks:
            for attempt in range(2):
                try:
                    _webhook_post(h["url"], h.get("secret") or "", body)
                    break
                except Exception:
                    if attempt == 0:
                        time.sleep(1.5)
    threading.Thread(target=_deliver, daemon=True).start()


def _node_watch_loop(deps):
    """Detect node online↔offline transitions (derived from sync staleness) and emit webhooks. Seeds
    from the current state on the first pass so a panel restart doesn't replay a flood of transitions."""
    state = {}
    first = True
    while True:
        with contextlib.suppress(Exception):
            if not (_api_settings(deps).get("webhooks")):   # nothing subscribed → do no work at all (re-seed when one is added)
                first = True
                time.sleep(10)
                continue
            now = int(time.time())
            seen = deps.get("node_seen") or {}
            nodes = nodes_load(deps["nodes_path"])
            for nid in list(seen.keys()):
                ls = seen.get(nid)
                online = ls is not None and (now - ls) <= NODE_OFFLINE
                prev = state.get(nid)
                state[nid] = online
                if first or prev is None or prev == online:
                    continue
                nm = (nodes.get(nid) or {}).get("name", nid)
                webhook_emit(deps, "node.online" if online else "node.offline",
                             {"id": nid, "name": nm, "last_seen": ls})
            first = False
        time.sleep(10)


# ───────────────────────── HTTP shell ─────────────────────────

# The largest leftover request body worth reading just to keep a connection alive; past it we close.
# Deliberately well under MAX_BODY: this is the tidy-up path, not the accept path.
DRAIN_CAP = 256 * 1024


class _CountedRfile:
    """`rfile`, plus how many body bytes a handler actually consumed — the only way the dispatcher can tell
    a handler that read its body from one that returned without touching it."""
    __slots__ = ("_f", "n")

    def __init__(self, f):
        self._f = f
        self.n = 0

    def read(self, size=-1):
        b = self._f.read(size)
        self.n += len(b)
        return b

    def readline(self, *a):
        b = self._f.readline(*a)
        self.n += len(b)
        return b

    def __getattr__(self, k):
        return getattr(self._f, k)


class Handler(BaseHTTPRequestHandler):
    deps = None
    protocol_version = "HTTP/1.1"
    timeout = 75

    def handle_one_request(self):
        _raw = self.rfile
        self.rfile = _CountedRfile(_raw)
        try:
            BaseHTTPRequestHandler.handle_one_request(self)
        finally:
            try:
                self._drain_request_body()
            except Exception:
                self.close_connection = True
            self.rfile = _raw

    def parse_request(self):
        ok = BaseHTTPRequestHandler.parse_request(self)
        if ok and isinstance(self.rfile, _CountedRfile):
            self.rfile.n = 0
        return ok

    def _drain_request_body(self):
        """Swallow whatever of the request body the handler left, or close rather than read it."""
        if not getattr(self, "headers", None):
            return                           # a request that never parsed has no length to drain by
        te = (self.headers.get("Transfer-Encoding") or "").strip().lower()
        if te and te != "identity":          # chunked: no Content-Length to bound a drain by
            self.close_connection = True     # nothing legitimate sends it — the node and the SPA both post
            return                           # bytes through http.client, and /api/v1 is GET-only
        try:
            n = int(self.headers.get("Content-Length", 0) or 0)
        except ValueError:
            n = 0
        left = n - getattr(self.rfile, "n", 0)
        if left <= 0:
            return
        if left > DRAIN_CAP:
            self.close_connection = True
            return
        with contextlib.suppress(Exception):
            self.rfile.read(left)

    def _send(self, code, obj):
        self._send_bytes(code, json.dumps(obj).encode())

    def _body_len(self, cap=MAX_BODY):
        """Validated Content-Length, or None (after sending 413) if malformed or over `cap` — read the body
        ONLY after this passes, so an oversized/streamed body can't exhaust memory before it's parsed."""
        try:
            n = int(self.headers.get("Content-Length", 0) or 0)
        except ValueError:
            n = -1
        if n < 0 or n > cap:
            self._send(413, {"ok": False, "error": "request body too large", "code": "too_large"})
            return None
        return n

    def _send_bytes(self, code, payload, encoding=None):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        if encoding:
            self.send_header("Content-Encoding", encoding)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")   # API replies may carry secrets — never cache
        self.end_headers()
        with contextlib.suppress(BrokenPipeError, ConnectionError):
            self.wfile.write(payload); self.wfile.flush()   # flush so the body reaches the client before the socket closes

    def _send_text(self, code, text, ctype="text/plain; charset=utf-8"):
        payload = text.encode() if isinstance(text, str) else text
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        with contextlib.suppress(BrokenPipeError, ConnectionError):
            self.wfile.write(payload)

    def _ext_token(self, u):
        hdr = self.headers.get("Authorization", "")
        if hdr.startswith("Bearer "):
            return hdr[7:].strip()
        xk = self.headers.get("X-API-Key", "")
        if xk:
            return xk.strip()
        return (parse_qs(u.query).get("token") or [""])[0]   # ?token= for tools that can't set a header

    def _ext_authed(self, u):
        """A valid read-only API token (header or ?token=) OR a live admin session. On a token hit,
        record a best-effort in-memory last-used stamp (no disk write, so scrapes stay cheap)."""
        tok = self._ext_token(u)
        if tok and api_token_lookup(self.deps, tok) is not None:
            self.deps.setdefault("api_seen", {})[_api_token_hash(tok.strip())] = int(time.time())
            return True
        return self._authed_user() is not None

    def _ext_api(self, path, u):
        try:
            if path == "/healthz":                              # bare liveness for uptime probes (no auth, no data)
                return self._send_text(200, "ok\n")
            if path == "/api/v1/health":                        # liveness + coarse counts (no secrets) — unauthenticated
                s = ext_summary(self.deps)
                return self._send(200, {"status": "ok", "version": s["version"], "nodes": s["nodes"], "peers": s["peers"]})
            if not self._ext_authed(u):
                _authfail_note("api")                 # same shape as the node door: the token was already
                _d = _authfail_delay("api")           # resolved, so a valid integration is never delayed
                if _d:
                    time.sleep(_d)
                return self._send(401, {"error": "unauthorized",
                                        "detail": "send a read-only API token as 'Authorization: Bearer <token>' "
                                                  "(mint one in Settings → Integrations, then enable the API)"})
            if path == "/metrics":
                return self._send_text(200, ext_metrics(self.deps), "text/plain; version=0.0.4; charset=utf-8")
            if path == "/api/v1/servers":
                return self._send(200, {"servers": ext_servers(self.deps)})
            m = re.match(r"^/api/v1/servers/([^/]+)/peers$", path)
            if m:
                r = ext_peers_for_node(self.deps, unquote(m.group(1)))
                return self._send(404, {"error": "unknown server"}) if r is None else self._send(200, r)
            m = re.match(r"^/api/v1/servers/([^/]+)$", path)
            if m:
                sid = unquote(m.group(1))
                hit = next((sv for sv in ext_servers(self.deps) if sv["id"] == sid or sv["name"] == sid), None)
                return self._send(200, hit) if hit else self._send(404, {"error": "unknown server"})
            if path == "/api/v1/peers":
                return self._send(200, {"peers": ext_peers_all(self.deps)})
            if path == "/api/v1/summary":
                return self._send(200, ext_summary(self.deps))
            return self._send(404, {"error": "not found"})
        except Exception as e:
            return self._send(500, {"error": "internal", "detail": str(e)})

    def _send_state(self):
        # Serve the memoized /api/state bytes (see _STATE_CACHE). Double-checked under a lock so a cold
        # cache is built exactly once while concurrent pollers wait, then re-send the same fresh bytes.
        c = _STATE_CACHE
        if c["bytes"] is not None and (time.monotonic() - c["at"]) < STATE_CACHE_TTL:
            return self._send_state_bytes(c)
        with _state_cache_lock:
            if c["bytes"] is not None and (time.monotonic() - c["at"]) < STATE_CACHE_TTL:
                return self._send_state_bytes(c)
            try:
                code, obj = api("GET", "/api/state", {}, {}, self.deps)
            except Exception as e:
                return self._send(500, {"ok": False, "error": str(e), "code": "internal"})
            if code == 200:
                c["bytes"] = json.dumps(obj).encode()
                c["gz"] = None                          # a stale compressed copy must never outlive its source
                c["at"] = time.monotonic()
                return self._send_state_bytes(c)
        return self._send(code, obj)   # an error build isn't cached

    def _send_state_bytes(self, c):
        """The memoized state, compressed if the client asked for it.

        WHY THIS ENDPOINT AND NOT THE STATIC PATH. /api/state is `no-store`, so there is no `Vary`, no ETag,
        no 304 and none of the shared-cache traps that make compressing a cacheable asset fiddly; and it is
        already memoized for STATE_CACHE_TTL, so ONE compression amortizes over every client and every tab.
        Measured on a near-empty rig: 111,083 B -> 11,573 B (9.6x) for 0.80 ms at level 6. Level 9 buys 0.8%
        more for nearly double the CPU; level 1 is 7.0x for half. The win scales with the fleet, the cost
        does not scale with the number of pollers.

        ⚠️ BREACH, AND WHY THIS IS SAFE — READ BEFORE CHANGING ANYTHING NEARBY. This response DOES carry
        secrets (the roster, and each peer's `psk`) and peer names ARE attacker-choosable, which is the exact
        shape BREACH needs. It is safe for ONE reason: the session cookie is SameSite=Strict, so no
        cross-site page can make the credentialed request the attack requires. Dropping SameSite, or adding
        a reflected public endpoint that returns this payload, invalidates this and the compression must go
        with it.

        Built lazily: a deployment whose only callers do not accept gzip never pays for it. Two threads
        racing to build it both produce equivalent bytes, so the race is benign and not worth a lock."""
        if accepts_gzip(self.headers.get("Accept-Encoding")):
            if c["gz"] is None:
                c["gz"] = gzip.compress(c["bytes"], 6)
            return self._send_bytes(200, c["gz"], encoding="gzip")
        return self._send_bytes(200, c["bytes"])

    def _static(self, key):
        rel = static_rel(key)
        if rel is None:
            return self.send_error(404)
        full = os.path.normpath(os.path.join(WEB_DIR, rel))
        if not full.startswith(os.path.realpath(WEB_DIR)) and not full.startswith(WEB_DIR):
            return self.send_error(403)
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            return self.send_error(404)
        _mb = getattr(_REQ, "matched_base", None)   # the base THIS request came in on (a path swap serves two)
        if _mb is None:                             # only fall back to the canonical mount when strip_base didn't match one
            _mb = PANEL_BASE                        # "" is a VALID (root) match during a swap — must NOT fall through to PANEL_BASE
        if _mb and rel == "index.html":   # point the SPA's <base> at the mount point this tab is under (_mb=="" → root, keep the default <base href="/">)
            data = data.replace(b'<base href="/">', ('<base href="%s/">' % _mb).encode())
        if rel == "index.html":
            data = _localize_meta(data, _accept_lang(self.headers.get("Accept-Language", "")))
        if rel == "index.html":
            # Stamp the modulepreload hints with the SAME key the imports get, or the browser preloads one
            # url and then fetches another: double the requests, none of the benefit.
            data = re.sub(rb'href="(js/[A-Za-z0-9_.-]+\.js)"',
                          lambda m: b'href="' + m.group(1) + _js_tree_q() + b'"', data)
            data = (data.replace(b'href="app.css"', b'href="app.css' + _asset_q("app.css") + b'"')
                        .replace(b'href="m/m.css"', b'href="m/m.css' + _asset_q("m/m.css") + b'"')
                        .replace(b'src="app.js"', b'src="app.js' + _asset_q("app.js") + b'"')
                        .replace(b'src="turn-artifacts.js"', b'src="turn-artifacts.js' + _asset_q("turn-artifacts.js") + b'"'))
        elif rel.endswith(".js"):
            data = _stamp_imports(data, rel)
        _, ext = os.path.splitext(full)
        if ext == ".woff2" or rel.startswith("js/"):
            self.send_response(200)
            self.send_header("Content-Type", CTYPES.get(ext, "application/octet-stream"))
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "public, max-age=31536000, immutable")
            if ext == ".js":
                self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            with contextlib.suppress(BrokenPipeError):
                self.wfile.write(data)
            return
        etag = '"%s"' % hashlib.sha256(data).hexdigest()[:16]
        if self.headers.get("If-None-Match") == etag:
            self.send_response(304)
            self.send_header("ETag", etag)
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", CTYPES.get(ext, "application/octet-stream"))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.send_header("ETag", etag)
        self.send_header("X-Content-Type-Options", "nosniff")
        if rel == "index.html":
            self.send_header("Content-Security-Policy",
                             "default-src 'self'; script-src 'self' 'unsafe-inline'; "
                             "style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; "
                             "connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "same-origin")
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(data)

    def _cookie(self, name):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == name:
                return v
        return ""

    def _authed_user(self):
        """Authenticated username, True if auth is disabled, or None if unauthenticated.
        Accepts a session cookie (browser) or HTTP Basic (API clients / curl)."""
        creds = Handler.deps.get("auth")
        if not creds:
            return None if AUTH_UNUSABLE else True
        secret = Handler.deps.get("session_secret")
        tok = self._cookie("swgsess")
        if tok and secret and verify_session(tok, secret) == creds[0]:
            return creds[0]
        hdr = self.headers.get("Authorization", "")
        if hdr.startswith("Basic "):
            try:
                user, _, pw = base64.b64decode(hdr[6:]).decode("utf-8", "replace").partition(":")
            except Exception:
                user, pw = "", ""
            if hmac.compare_digest(user, creds[0]) and verify_password(creds[1], pw):
                return creds[0]
        return None

    def _require_auth(self):
        if self._authed_user() is not None:
            return True
        # 401 JSON, deliberately WITHOUT WWW-Authenticate so the browser shows our login
        # page instead of its native Basic-auth popup.
        self._send(401, {"ok": False, "error": "authentication required", "code": "unauthorized"})
        return False

    def _session_cookie(self, value, max_age):
        _cb = getattr(_REQ, "matched_base", None)   # scope the cookie to the base this request came in on (a path swap serves two)
        base = (PANEL_BASE if _cb is None else _cb) + "/"   # "" is a VALID (root) match during a swap → cookie Path=/ (not the canonical subpath)
        secure = "; Secure"
        return f"swgsess={value}; Path={base}; HttpOnly; SameSite=Strict; Max-Age={max_age}{secure}"

    def _send_with_cookie(self, code, obj, cookie):
        payload = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        if cookie:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(payload)

    def _login(self):
        creds = Handler.deps.get("auth")
        length = self._body_len()
        if length is None:
            return
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            body = {}
        if not creds:
            if AUTH_UNUSABLE:
                # the fix follows the cause and the place (N1): chown/chmod only for a file this process cannot read,
                # swg-passwd for one that is gone, blank or holds no checkable hash, never systemctl on Docker
                if IN_DOCKER:
                    err = perr("the password file {v1} is unusable ({v2}), so nobody can sign in and every request is "
                               "refused. Set a new login on the Docker host: {v3} — the first command writes a new login, "
                               "the second restarts the panel so it reads it.", v1=AUTH_FILE, v2=AUTH_UNUSABLE,
                               v3=_auth_fix_cmd())
                elif AUTH_UNUSABLE_KIND == "perm":
                    err = perr("the password file {v1} cannot be read ({v2}) — this panel runs as {v3}, "
                               "so nobody can sign in and every request is refused. Fix it over SSH or the "
                               "provider console: chown root:swg {v1}; chmod 640 {v1}; systemctl restart "
                               "swg-panel-server  (or run swg-passwd to set a new password). If this panel "
                               "is MEANT to have no login — reached only over an SSH tunnel, say — clear "
                               "SWG_PANEL_AUTH in its unit instead: blank means no login by design, and "
                               "an empty file cannot say that.",
                               v1=AUTH_FILE, v2=AUTH_UNUSABLE, v3=_proc_user_name())
                else:
                    err = perr("the password file {v1} is unusable ({v2}), so nobody can sign in and every request is "
                               "refused. Set a new login over SSH or the provider console: {v3} — it writes a new login "
                               "and restarts the panel. If this panel is MEANT to have no login — reached only over an SSH "
                               "tunnel, say — clear SWG_PANEL_AUTH in its unit instead: blank means no login by design, and "
                               "an empty file cannot say that.",
                               v1=AUTH_FILE, v2=AUTH_UNUSABLE, v3=_auth_fix_cmd())
                return self._send(503, {"ok": False, "code": "auth_unusable", **err})
            return self._send(200, {"ok": True, "data": {"auth": False}})
        user = (body.get("username") or "").strip()
        pw = body.get("password") or ""
        _d = _authfail_delay("login")
        if _d:
            time.sleep(_d)
        if not (hmac.compare_digest(user, creds[0]) and verify_password(creds[1], pw)):
            _authfail_note("login")
            return self._send(401, {"ok": False, "error": "invalid username or password", "code": "bad_login"})
        _authfail_clear("login")                              # the password was right — forget the typos
        tok = make_session(creds[0], Handler.deps.get("session_secret"))
        data = {"username": creds[0]}
        # swg-passwd reset the Encryption Vault (its old-password wrap is gone) → tell the SPA to re-create it under
        # the password just entered, so stored configs / sub links re-connect without a manual "set up encryption" step.
        try:
            if os.path.exists(os.path.join(_sub_dir(Handler.deps), "vault.reset")):
                data["vault_reset"] = True
        except Exception:
            pass
        return self._send_with_cookie(200, {"ok": True, "data": data},
                                      self._session_cookie(tok, SESSION_TTL))

    def _logout(self):
        return self._send_with_cookie(200, {"ok": True}, self._session_cookie("", 0))

    def _wgstats(self, path):
        name = os.path.basename(path)          # basename strips any traversal
        if not name.endswith(".json") or "/" in name or name.startswith("."):
            return self.send_error(404)
        full = os.path.join(Handler.deps.get("stats_dir", "/var/www/wgstats"), name)
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            data = b"{}"                        # before the first snapshot lands
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        with contextlib.suppress(BrokenPipeError):
            self.wfile.write(data)

    def _node_token(self):
        """Bearer node-token auth (the cheap check, before the body is read): returns (nid, node, nodes), or
        (None, None, None) after sending 401. `node` is `nodes[nid]` so callers can mutate + save it. Also does the
        one-time legacy→token_sha index upgrade. Signature (if any) is checked by _node_sig_ok once the body is read."""
        hdr = self.headers.get("Authorization", "")
        token = hdr[7:].strip() if hdr.startswith("Bearer ") else ""
        self._nodes_mark = nodes_mark(Handler.deps["nodes_path"])   # before the read — see nodes_mark
        nodes = nodes_load(Handler.deps["nodes_path"])
        nid, node = find_node_by_token(nodes, token)
        if not nid:
            _authfail_note("node")
            _d = _authfail_delay("node")
            if _d:
                time.sleep(_d)
            self._send(401, {"error": "invalid node token"}); return None, None, None
        if token and not node.get("token_sha"):
            node["token_sha"] = hashlib.sha256(token.encode()).hexdigest()
            if _api_lock.acquire(timeout=2):
                try:
                    with contextlib.suppress(Exception):
                        nn = nodes_load(Handler.deps["nodes_path"])
                        if nid in nn and not nn[nid].get("token_sha"):
                            nn[nid]["token_sha"] = node["token_sha"]
                            nodes_save(Handler.deps["nodes_path"], nn)
                finally:
                    _api_lock.release()
        return nid, node, nodes

    def _node_sig_ok(self, node, body, require=None):
        """Verify the optional per-request signature over `body`. Returns True if the request may proceed, or
        sends 401 and returns False. A present X-SWG-MAC is ALWAYS verified; an absent one is allowed unless the
        signature is required. `require` defaults to REQUIRE_NODE_SIG (the daemon loop endpoints); installer-driven
        endpoints (goodbye/rename — bash can't HMAC) pass require=False so enforcement never locks them out."""
        if require is None:
            require = REQUIRE_NODE_SIG
        mac = self.headers.get("X-SWG-MAC", "")
        ts = self.headers.get("X-SWG-TS", "")
        if not mac and not ts:
            if require:
                self._send(401, {"error": "request signature required", "code": "signature_required"}); return False
            return True
        ok, why = _verify_node_sig(node.get("token_sha"), ts, mac, body)
        if not ok:
            self._send(401, {**perr("bad request signature ({v1})", v1=why), "code": "bad_signature"}); return False
        return True

    def _node_sync(self):
        nid, node, nodes = self._node_token()
        if not nid:
            return
        length = self._body_len(MAX_SYNC_BODY)
        if length is None:
            return
        raw = self.rfile.read(length) or b"{}"
        seq = next(_SYNC_SEQ)        # its arrival: a node's next sync can overtake this one (the ledger's ORDER note)
        if not self._node_sig_ok(node, raw):
            return
        try:                                             # NaN / Infinity are refused here, not stored (_json_finite)
            body = json.loads(raw or "{}", parse_constant=_json_finite, parse_float=_json_finite, parse_int=_json_int)
        except Exception:
            return self._send(400, {"error": "bad body"})
        snap = body.get("snapshot") or {}
        _serr = _snap_sanitise(snap, nid)
        if not _serr:
            Handler.deps.setdefault("node_snaps", {})[nid] = snap
            Handler.deps.setdefault("node_seen", {})[nid] = int(time.time())
            try:                                         # telemetry, before the lock — see _node_sync_history
                self._node_sync_history(nid, node, nodes, snap, seq)
            except Exception as e:                       # non-essential: a bug here must not fail the fleet's syncs
                log(LOG_WARNING, "stats: history for %s not recorded: %s", nid, e)
        if not _api_lock.acquire(timeout=SYNC_LOCK_WAIT):
            if not _serr and nid not in nodes_load(Handler.deps["nodes_path"]):   # removed while this waited → un-stamp
                (Handler.deps.get("node_snaps") or {}).pop(nid, None)
                (Handler.deps.get("node_seen") or {}).pop(nid, None)
            # `code` is what noded reads (post_json → _panel_busy) to tell a busy panel — alive, never fail over —
            # from a proxy's 503, whose upstream may really be gone.
            return self._send(503, {"ok": False, "error": "the panel is busy — this sync is skipped, the next one retries",
                                    "code": "busy"})
        try:
            tnode = node
            _mk = getattr(self, "_nodes_mark", None)
            if _mk is None or nodes_mark(Handler.deps["nodes_path"]) != _mk:   # saved since _node_token's read → re-read
                nodes = nodes_load(Handler.deps["nodes_path"])
            node = nodes.get(nid)
            if not isinstance(node, dict):               # removed while this request was waiting
                (Handler.deps.get("node_snaps") or {}).pop(nid, None)   # …so un-stamp it (memory; its stats files are as at HEAD)
                (Handler.deps.get("node_seen") or {}).pop(nid, None)
                code, obj = 401, {"error": "invalid node token"}
            elif not _node_cred_same(tnode, node):       # its token was rotated while this waited: nothing for the old one
                if (Handler.deps.get("node_snaps") or {}).get(nid) is snap:
                    Handler.deps["node_snaps"].pop(nid, None)   # …and its snapshot is not the node's state (the node re-stamps in 5 s)
                code, obj = 401, {"error": "invalid node token"}
            else:
                code, obj = self._node_sync_apply(nid, node, nodes, snap, _serr)
        finally:
            _api_lock.release()
        return self._send(code, obj)                     # written to the socket AFTER the lock is released

    def _node_sync_history(self, nid, node, nodes, snap, seq=None):
        """A sync's stats mirror, live samples and history rings — run by _node_sync OUTSIDE _api_lock, before it.
        It reads the snapshot and two record fields (`ifaces`, `stats_file`), writes no store, and is ~80% of a sync's
        time (fsync'd files, measured 15 of 19 ms): under the lock it would serialise every node's disk writes, and
        a busy panel (503) would leave a hole in every graph. Pure telemetry — each node's own keys and files."""
        stats_dir = Handler.deps.get("stats_dir")
        if stats_dir and snap and stats_disk_ok(stats_dir):   # skip the non-essential stats/RRD writes on a full disk
            sf = node.get("stats_file", f"stats-{nid}.json")
            with contextlib.suppress(Exception):   # 0640, group swg (the dir's setgid): swg-sub reads it, and it carries
                atomic_write(os.path.join(stats_dir, sf), json.dumps(snap), mode=0o640)   # each peer's PSK — no other user
            cpu, mem, disk = health_pcts(snap.get("health")) or (HRRD_NA, HRRD_NA, HRRD_NA)
            agg = snap_aggregates(snap, node)        # rx/tx (total) + awg/mesh split + peer counts, panel-derived
            rx, tx = agg["rx"], agg["tx"]            # == snap_traffic — total across every iface
            _in = snap.get("inet") or {}             # node-measured internet up/down (B/s); absent on older noded → 0
            M = [cpu, mem, disk, rx, tx, agg["arx"], agg["atx"], agg["mrx"], agg["mtx"],
                 max(0, int(_in.get("up") or 0)), max(0, int(_in.get("down") or 0)),
                 agg["pon"], agg["ptot"], agg["paon"], agg["patot"]]
            with contextlib.suppress(Exception):
                hrrd_update(os.path.join(stats_dir, f"health-{nid}.rrd"), int(time.time()), M)
            buf = Handler.deps.setdefault("live_samples", {}).setdefault(nid, [])
            buf.append((int(time.time()), cpu, mem, disk, rx, tx))
            if len(buf) > LIVE_MAX:
                del buf[:len(buf) - LIVE_MAX]
            with contextlib.suppress(Exception):
                atomic_write(os.path.join(stats_dir, f"live-{nid}.json"), json.dumps(buf), mode=0o640)
            now_i = int(time.time())
            mlast = Handler.deps.setdefault("_mesh_last", {})
            ov_ifaces = node.get("ifaces") or {}
            for ifn, blk in (snap.get("interfaces") or {}).items():
                meta = blk.get("meta") or {}; o = ov_ifaces.get(ifn) or {}
                peer = o.get("link_node") or meta.get("link_node") or o.get("egress_node") or meta.get("egress_node")   # a system mesh link's peer is link_node; egress_node is the user-iface forward target
                if not ((o.get("system") or meta.get("system")) and peer and peer in nodes):
                    continue
                a, b = sorted((nid, peer)); key = f"{a}|{b}"
                if now_i - mlast.get(key, 0) < MESH_THROTTLE_S:
                    continue                              # another end (or this one) wrote recently
                lrx = sum((p.get("rx_speed", 0) or 0) for p in (blk.get("peers") or []))
                ltx = sum((p.get("tx_speed", 0) or 0) for p in (blk.get("peers") or []))
                ab, ba = (ltx, lrx) if nid == a else (lrx, ltx)   # a→b, b→a from this node's perspective
                mM = [0] * HRRD_NM; mM[3] = ab; mM[4] = ba        # ab→rx slot, ba→tx slot (rest incl. inet = 0)
                with contextlib.suppress(Exception):
                    hrrd_update(mesh_rrd_path(stats_dir, a, b), now_i, mM)
                mlast[key] = now_i
            cat_rate = snap.get("cat_rate") or {}
            clast_w = Handler.deps.setdefault("_cat_last_w", {})   # (nid,cat) → last RRD write time
            for cat, v in cat_rate.items():
                rup = max(0, int(v.get("up") or 0)); rdn = max(0, int(v.get("dn") or 0))
                if (rup or rdn) and now_i - clast_w.get((nid, cat), 0) >= MESH_THROTTLE_S:   # lazy: only categories moving bytes get a ring
                    cM = [0] * HRRD_NM; cM[3] = rup; cM[4] = rdn                             # up→rx slot, dn→tx slot
                    with contextlib.suppress(Exception):
                        hrrd_update(cat_rrd_path(stats_dir, nid, cat), now_i, cM)
                    clast_w[(nid, cat)] = now_i
            xlast_w = Handler.deps.setdefault("_exit_last_w", {})   # (nid,dev) → last RRD write; its OWN dict, not the categories' with a prefix — one throttle map holding two keyspaces is a name that lies
            for _xd, _xv in (snap.get("exit_rate") or {}).items():
                _xu = int(_xv.get("up") or 0); _xn = int(_xv.get("down") or 0)
                if (_xu or _xn) and now_i - xlast_w.get((nid, _xd), 0) >= MESH_THROTTLE_S:
                    _xM = [0] * HRRD_NM; _xM[3] = _xu; _xM[4] = _xn                  # up→rx slot, down→tx slot
                    with contextlib.suppress(Exception):
                        hrrd_update(exit_rrd_path(stats_dir, nid, _xd), now_i, _xM)
                    xlast_w[(nid, _xd)] = now_i
            _sr = snap.get("smartroute") or {}
            _blk = _sr.get("block") or {}
            _reach = sum(int(c or 0) for nm, c in (_sr.get("sets") or {}).items()
                         if str(nm).startswith("cat_blku_") or str(nm).startswith("catl_blku_"))
            if _blk or _reach:                                    # node is doing blocking → keep its line continuous
                _torc = sum(int((v or {}).get("torrent") or 0) for v in _blk.values())
                _scan = sum(int((v or {}).get("scan") or 0) for v in _blk.values())
                _blkd = sum(int((v or {}).get("blocked") or 0) for v in _blk.values())   # cumulative pkts dropped to content-block sets
                _mechc = sum(int((v or {}).get("mech") or 0) for v in _blk.values())
                _bl = Handler.deps.setdefault("_blk_last", {}); _pt = _bl.get(nid); _trate = _brate = _mrate = 0
                if _pt and now_i > _pt[-1]:                       # torrents + blocked + mech are cumulative → per-interval RATE (mean-consolidatable), reset-safe
                    _dt = now_i - _pt[-1]
                    _trate = int(max(0, _torc - _pt[0]) * 3600 / _dt)      # torrents/HOUR
                    _brate = int(max(0, _blkd - (_pt[1] if len(_pt) >= 3 else _blkd)) * 3600 / _dt)   # blocked/HOUR (len<3 = pre-upgrade tuple → 0 this once)
                    _mrate = int(max(0, _mechc - (_pt[2] if len(_pt) >= 4 else _mechc)) * 3600 / _dt)  # mech/HOUR (len<4 = pre-upgrade tuple → 0 this once)
                _bl[nid] = (_torc, _blkd, _mechc, now_i)
                bM = [0] * HRRD_NM; bM[3] = min(_trate, HRRD_U32); bM[4] = min(_brate, HRRD_U32); bM[5] = min(_mrate, HRRD_U32); bM[11] = min(_scan, HRRD_U16); bM[12] = min(_reach, HRRD_U16)
                with contextlib.suppress(Exception):
                    hrrd_update(block_rrd_path(stats_dir, nid), now_i, bM)
                _off = Handler.deps.setdefault("_offenders", {})
                _touched = False
                for _v in _blk.values():
                    for _mtr, _key in (("torrent", "torrent_ips"), ("scan", "scan_ips")):
                        for _ip in ((_v or {}).get(_key) or []):
                            _m = _off.setdefault(_mtr, {}); _e = _m.get(_ip)
                            if _e: _e[1] = now_i; _e[2] = nid
                            else:  _m[_ip] = [now_i, now_i, nid]
                            _touched = True
                if _touched:
                    _cut = now_i - OFFENDER_TTL
                    for _m in _off.values():                       # prune the aged-out, then hard-cap to the most-recent
                        for _ip in [i for i, e in _m.items() if e[1] < _cut]: _m.pop(_ip, None)
                        if len(_m) > OFFENDER_MAX:
                            for _ip, _ in sorted(_m.items(), key=lambda kv: kv[1][1])[:len(_m) - OFFENDER_MAX]: _m.pop(_ip, None)
                    _olast = Handler.deps.get("_off_last_w", 0)     # mirror throttled (≤1/30s) — negligible, restart-safe
                    if now_i - _olast >= 30:
                        Handler.deps["_off_last_w"] = now_i
                        with contextlib.suppress(Exception):
                            atomic_write(os.path.join(stats_dir, "offenders.json"), json.dumps(_off), mode=0o640)
            _bd = _sr.get("blk_domains") or {}
            if _bd:
                _srcp = _blk_cat_srcpaths(Handler.deps)
                _cache = Handler.deps.setdefault("_blk_d2c", {})
                _percat = {}
                for _host in _bd:                                    # top-K keys are distinct hostnames → count = distinct sites/category
                    _cc = _blk_bucket(_cache, _srcp, str(_host))
                    if _cc:
                        _percat[_cc] = _percat.get(_cc, 0) + 1
                for _cc, _nsites in _percat.items():
                    _cM = [0] * HRRD_NM; _cM[11] = min(_nsites, HRRD_U16)   # distinct sites → GAUGE (pon slot), peak-consolidated over the range
                    with contextlib.suppress(Exception):
                        hrrd_update(blkcat_rrd_path(stats_dir, nid, _cc), now_i, _cM)
            tps = snap.get("turn_proxies") or []
            if tps:
                conn_ips = set(); by_port = {}; sport_svc = {}
                for tp in tps:
                    ci = _ip_of(tp.get("connect"))
                    if ci: conn_ips.add(ci)
                    cp = _port_of(tp.get("connect"))
                    if cp: by_port.setdefault(cp, []).append(tp.get("service") or "turn")
                    for sp in (tp.get("wg_sports") or []):
                        sport_svc[str(sp)] = tp.get("service") or "turn"   # exact: endpoint source port → its proxy
                fagg = {}   # fork → [rx, tx, online, total]
                for ifn, blk in (snap.get("interfaces") or {}).items():
                    lp = str((blk.get("meta") or {}).get("listen_port") or "")
                    svcs = by_port.get(lp) or []
                    for p in (blk.get("peers") or []):
                        if _ip_of(p.get("endpoint")) not in conn_ips: continue
                        # exact proxy via the peer's endpoint source port (disambiguates several proxies on one iface);
                        # fall back to the iface's first proxy for old nodes that don't report wg_sports.
                        svc = sport_svc.get(str(_port_of(p.get("endpoint"))))
                        if not svc:
                            if not svcs: continue
                            svc = svcs[0]
                        fork = turn_fork(svc)
                        f = fagg.setdefault(fork, [0, 0, 0, 0])
                        f[0] += p.get("rx_speed", 0) or 0; f[1] += p.get("tx_speed", 0) or 0
                        f[3] += 1
                        if p.get("online"): f[2] += 1
                deployed = {}
                for tp in (snap.get("turn_proxies") or []):
                    deployed.setdefault(turn_fork(tp.get("service") or ""), [0, 0, 0, 0])
                deployed.update(fagg)                            # override the idle 0s with real per-fork traffic
                for fork, (frx, ftx, fon, ftot) in deployed.items():
                    tM = [0] * HRRD_NM; tM[3] = int(frx); tM[4] = int(ftx); tM[11] = fon; tM[12] = ftot   # rx,tx + pon,ptot
                    with contextlib.suppress(Exception):
                        hrrd_update(turn_rrd_path(stats_dir, nid, fork), now_i, tM)
                tips = Handler.deps.setdefault("turn_ips", {}).setdefault(nid, {})
                for svc, _sips in _turnfam_srcs(snap):
                    for ip in _sips:
                        if not isinstance(ip, str) or not ip:
                            continue
                        rec = tips.get(ip)
                        if rec is None:
                            if len(tips) >= 1000:                # soft cap/node → evict the oldest-seen
                                tips.pop(min(tips, key=lambda k: tips[k].get("last", 0)), None)
                            rec = tips[ip] = {"first": now_i, "last": now_i, "by": []}
                        rec["last"] = now_i
                        if svc and svc not in rec["by"]:
                            rec["by"].append(svc)
                _tiw = Handler.deps.setdefault("_turn_ips_last_w", [0])
                if now_i - _tiw[0] >= 30:                         # persist throttled (small file; survives restart)
                    with contextlib.suppress(Exception):
                        atomic_write(_turn_ips_path(Handler.deps), json.dumps(Handler.deps.get("turn_ips") or {}))
                    _tiw[0] = now_i
            pagg = {}
            online_pks = set()                                  # presence: seen online this sync, traffic or not
            for ifn, blk in (snap.get("interfaces") or {}).items():
                meta = blk.get("meta") or {}; o = ov_ifaces.get(ifn) or {}
                if o.get("system") or meta.get("system"):
                    continue                                    # client ifaces only — mesh peers are never "online users"
                for p in (blk.get("peers") or []):
                    pk = p.get("public_key")
                    if not pk:
                        continue
                    a = pagg.setdefault(pk, [0, 0]); a[0] += p.get("rx_speed", 0) or 0; a[1] += p.get("tx_speed", 0) or 0
                    if p.get("online"):
                        online_pks.add(pk)
            # PRESENCE: union the online peers into this node's bitmap ring. Recorded from `online`, never from
            # traffic, so an idle-but-connected peer still counts — the per-peer traffic rings below cannot.
            if stats_dir:
                with contextlib.suppress(Exception):
                    idx = pres_bits_for(online_pks, stats_dir)
                    pres_feed(pres_path(stats_dir, nid), now_i,
                              [idx[pk] for pk in online_pks if pk in idx], pres_width(len(idx)))
            plast_w = Handler.deps.setdefault("_peer_last_w", {})   # (nid,pubkey) → last RRD write time
            for pk, (prx, ptx) in pagg.items():
                if (prx + ptx) >= PEER_MIN_BPS and now_i - plast_w.get((nid, pk), 0) >= MESH_THROTTLE_S:
                    pM = [0] * HRRD_NM; pM[3] = int(prx); pM[4] = int(ptx)
                    with contextlib.suppress(Exception):
                        hrrd_update(peer_rrd_path(stats_dir, nid, pk), now_i, pM)
                    plast_w[(nid, pk)] = now_i
            for ifn, blk in (snap.get("interfaces") or {}).items():
                meta = blk.get("meta") or {}; o = ov_ifaces.get(ifn) or {}
                if o.get("system") or meta.get("system"):
                    continue
                irx = sum((p.get("rx_speed", 0) or 0) for p in (blk.get("peers") or []))
                itx = sum((p.get("tx_speed", 0) or 0) for p in (blk.get("peers") or []))
                iM = [0] * HRRD_NM; iM[3] = int(irx); iM[4] = int(itx)
                with contextlib.suppress(Exception):
                    hrrd_update(iface_rrd_path(stats_dir, nid, ifn), now_i, iM)
            for _sc in ((snap.get("wdtt") or []), (snap.get("csqtt") or [])):
                for w in _sc:
                    wifn = (w or {}).get("iface")
                    if not wifn:
                        continue
                    iM = [0] * HRRD_NM; iM[3] = int(w.get("rx_speed", 0) or 0); iM[4] = int(w.get("tx_speed", 0) or 0)
                    with contextlib.suppress(Exception):
                        hrrd_update(iface_rrd_path(stats_dir, nid, wifn), now_i, iM)
        try:
            LEDGER.ingest(nid, snap, seq=seq)
        except Exception as e:
            LEDGER.ingest_failed(e)

    def _node_sync_apply(self, nid, node, nodes, snap, _serr):
        """The body of a node sync, run under _api_lock by _node_sync (on its fresh re-read). Returns (code, reply)."""
        _prev_serr = (node.get("snap_err") or {}).get("why")
        if _serr:
            if _prev_serr != _serr:
                node["snap_err"] = {"why": _serr, "at": int(time.time())}
                with contextlib.suppress(Exception):
                    nodes_save(Handler.deps["nodes_path"], nodes)
            return 400, {"ok": False, "error": _serr, "code": "bad_snapshot"}
        if _prev_serr:
            node.pop("snap_err", None)                   # it is reporting properly again
            with contextlib.suppress(Exception):
                nodes_save(Handler.deps["nodes_path"], nodes)
        # (node_snaps / node_seen were stamped by _node_sync before the lock — liveness must not wait on it)
        net_probe_absorb(nid, snap)                     # NETWORKS P4: a reachability test's answer, when one rode this snapshot
        exit_test_absorb(nid, snap)                     # …and a SOCKS5 proxy test's
        if not (node.get("endpoint_host") or "").strip():   # mesh needs a dial host — auto-fill from the reported
            _pub = node_public_ip(snap)                      # public IP (operator can still override it later)
            if _pub:
                node["endpoint_host"] = _pub
                with contextlib.suppress(Exception):
                    nodes_save(Handler.deps["nodes_path"], nodes)
        if node.pop("uninstalled", None) is not None:   # node is back (re-installed with the same token) → clear the grey "Uninstalled" tag
            nodes_save(Handler.deps["nodes_path"], nodes)
        # ACK the explicit WDTT removals: once the node stops reporting an instance it has done the delete, so the
        # entry comes off the list. Without this the reply would carry every removal ever made, forever.
        _wdel = node.get("wdtt_delete") or {}
        if _wdel:
            _live = {(w or {}).get("iface") for w in (snap.get("wdtt") or [])}
            _done = [i for i in list(_wdel) if i not in _live]
            if _done:
                for i in _done:
                    _wdel.pop(i, None)
                if _wdel: node["wdtt_delete"] = _wdel
                else: node.pop("wdtt_delete", None)
                with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        _cdel = node.get("csqtt_delete") or {}
        if _cdel:
            _clive = {(c or {}).get("iface") for c in (snap.get("csqtt") or [])}
            _cdone = [i for i in list(_cdel) if i not in _clive]
            if _cdone:
                for i in _cdone:
                    _cdel.pop(i, None)
                if _cdel: node["csqtt_delete"] = _cdel
                else: node.pop("csqtt_delete", None)
                with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        if isinstance(snap.get("interfaces"), dict) and (node.get("ignore_ifaces") or []):
            # list(), NOT any(): any() short-circuits on the first True, so a second stale entry would be left
            # for the next sync to find.
            if [1 for _mi in list(snap["interfaces"].keys()) if unignore_iface(node, _mi)]:
                with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        if snap.get("kind") and node.get("kind") != snap["kind"]:   # remember the method persistently, so a DOWN node (no live snapshot) still knows it (Recover shows the right command)
            node["kind"] = snap["kind"]
            with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        if snap.get("kind"):
            _own = {"platform": (snap.get("platform") or None), "declarative": (True if snap.get("declarative") else None),
                    "runtime": (snap.get("runtime") or None),
                    "platform_info": (snap.get("platform_info") or None)}   # persisted with them so a stale node still labels
            if any(node.get(k) != v for k, v in _own.items()):
                for k, v in _own.items():
                    if v is None: node.pop(k, None)
                    else:         node[k] = v
                with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        _cv = {"converting-docker": ("docker", "converted-docker"),
               "converting-bare":   ("baremetal", "converted-bare")}
        _tgt = _cv.get((node.get("proc_status") or {}).get("state"))
        if _tgt and snap.get("kind") == _tgt[0]:
            node["proc_status"] = {"state": _tgt[1], "at": int(time.time())}   # green confirmation for ~8s, then clears
            with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        _ps = node.get("proc_status") or {}
        if _ps.get("state") in ("updating", "update-failed") and snap.get("noded_version") \
           and snap.get("noded_version") == (VERSIONS.get("panel") or None) \
           and (time.time() - (_ps.get("at") or 0)) > 8:
            node["proc_status"] = {"state": "updated", "at": int(time.time())}   # green confirmation, then clears
            with contextlib.suppress(Exception): nodes_save(Handler.deps["nodes_path"], nodes)
        if reconcile_mesh(nodes, Handler.deps.get("node_snaps") or {}, Handler.deps):
            with contextlib.suppress(Exception):
                nodes_save(Handler.deps["nodes_path"], nodes)
        _rmark = roster_mark(Handler.deps["roster_path"])   # BEFORE the read: a save racing it is never cached as current
        roster = roster_load(Handler.deps["roster_path"])
        desired = desired_for_node(roster, nid, snap)   # the snapshot gates networks: absent net_deps ⇒ /32 only (D7)
        _clists = {cl["id"]: cl for cl in ((Handler.deps.get("panel_settings") or {}).get("custom_lists") or []) if cl.get("id")}
        cas_plans = cascade_plan(nodes, Handler.deps.get("node_snaps") or {}, _clists, roster=roster)
        Handler.deps["cas_capped"] = {_n: _p["_capped"] for _n, _p in cas_plans.items() if _p.get("_capped")}
        Handler.deps["cas_legs"] = {_n: _p["_legs"] for _n, _p in cas_plans.items() if _p.get("_legs")}
        # …and "whom it affects" for every node whose default is a list (§7.3) — the same terms: a fact only the plan holds,
        # kept from the last sync so /api/state never builds one (T16). Empty until the first sync after a restart.
        Handler.deps["cas_reach"] = {_n: _p["_reach"] for _n, _p in cas_plans.items() if _p.get("_reach")}
        # …and the pairs left unplanned because the far node holds the same subnet — the same terms again.
        Handler.deps["cas_clash"] = {_n: _p["_clash"] for _n, _p in cas_plans.items() if _p.get("_clash")}
        # …and the nodes sent per-interface torrent choices, each with the interfaces whose route could not be lowered
        # (blocked until it can) — the same terms.
        Handler.deps["cas_p2pi"] = {_n: sorted(set(_p.get("_p2p_dead") or ())) for _n, _p in cas_plans.items() if _p.get("_p2pi")}
        my_plan = cas_plans.get(nid) or {"forward": [], "smart": [], "exit": [], "devexit": [], "allowed": {}}
        if my_plan.get("_who"):                          # a rule names people: resolve them for THIS node only (§4.3, D4)
            my_plan = who_plan_for_node(my_plan, roster, nid, snap)
        my_plan = ports_plan_for_node(my_plan, snap)     # a node that does not read `ports` gets no port rule (B.4)
        _ps = Handler.deps.get("panel_settings") or {}   # Panel settings → mirrors / geo TTL / geo epoch for the node (used in the reply below)
        for _ifn, _mpeers in desired_mesh_for_node(nodes, nid, mesh_cfg(Handler.deps)["keepalive"],
                                                    my_plan.get("allowed"), Handler.deps.get("node_snaps")).items():
            desired.setdefault(_ifn, []).extend(_mpeers)   # node↔node mesh peers (endpoint + keepalive; cascade-aware AllowedIPs)
        snap_ifs = snap.get("interfaces") or {}
        ifaces_dirty = False
        desired_ifaces = {}
        _inflight = set(node.get("create") or {})
        for ifn, ov in (node.get("ifaces") or {}).items():
            rep = (snap_ifs.get(ifn) or {}).get("meta") or {}
            synced = ov.setdefault("_synced", {})
            drift = ov.setdefault("_drift", {})
            d = {}
            sysif = bool(ov.get("system"))   # mesh link — panel-managed: AUTO-ADOPT any node-side change, never drift
            if rep and not sysif:
                _lc = {k: rep.get(k) for k in ("subnet", "listen_port", "address", "awg_params", "mtu") if rep.get(k)}
                if _lc and ov.get("_lastcfg") != _lc:
                    ov["_lastcfg"] = _lc; ifaces_dirty = True
            # Escrow the node's sealed interface key (full-wipe restore): store the blob for THIS iface's current
            # key, replaced when the key rotates (blob.pub changes). Ciphertext only — the panel can't open it.
            if not sysif:
                if not (ov.get("public_key") or "") and not rep:
                    _okb = ov.get("key_blob") or {}
                    if _okb.get("ct") and _okb.get("pub"):
                        ov["public_key"] = _okb["pub"]; ifaces_dirty = True
                _sb = (snap.get("iface_key_sealed") or {}).get(ifn)
                if isinstance(_sb, dict) and _sb.get("pub") and _sb.get("ct"):
                    _vp = _current_ivk_pub(Handler.deps)   # NB: the sync's own `_ivk_pub` is computed further down
                    if not _sb.get("vault") and _vp and (ov.get("escrow_proved") or {}).get("vault") == _vp \
                            and _sb.get("pub") == (ov.get("public_key") or ""):
                        _sb = {**_sb, "vault": _vp}
                    if ov.get("key_blob") != _sb:
                        ov["key_blob"] = _sb; ifaces_dirty = True
            _xlive2 = {str((x or {}).get("id")): x for x in (snap.get("exits") or []) if isinstance(x, dict)}
            for _xrec in (node.get("exits") or []):
                if not (isinstance(_xrec, dict) and _xrec.get("key_restore")):
                    continue
                _have = str((_xlive2.get(str(_xrec.get("id"))) or {}).get("public_key") or "")
                _want = str(_xrec.get("key_restore_pub") or "")
                _at = _xrec.get("key_restore_at")
                if not isinstance(_at, (int, float)):
                    _xrec["key_restore_at"] = _at = int(time.time()); ifaces_dirty = True
                _stale = (time.time() - float(_at)) > _KEY_RESTORE_TTL
                _applied = bool(_have) and (_have == _want if _want else True)
                if _applied or _stale:
                    if _stale and not _applied:
                        # Said out loud: the operator pressed a button and nothing happened, and the row
                        # would otherwise just stop offering to explain itself.
                        ev_append(Handler.deps["roster_path"], "node", nid,
                                  "An exit key restore expired without being applied",
                                  _xrec.get("label") or str(_xrec.get("id") or ""),
                                  "the node never reported the restored key — it may be too old to accept one",
                                  detail_key="the node never reported the restored key — it may be too old to accept one")
                    _xrec.pop("key_restore", None)
                    _xrec.pop("key_restore_pub", None)
                    _xrec.pop("key_restore_at", None)
                    ifaces_dirty = True
            _xs = snap.get("exit_key_sealed") or {}
            if isinstance(_xs, dict) and _xs:
                for _xrec in (node.get("exits") or []):
                    if not isinstance(_xrec, dict):
                        continue
                    _blob = _xs.get(str(_xrec.get("id")))
                    if isinstance(_blob, dict) and _blob.get("ct") and _xrec.get("key_blob") != _blob:
                        _prev = _xrec.get("key_blob") or {}
                        if _prev.get("pub") and _blob.get("pub") and _prev["pub"] != _blob["pub"] \
                                and not (_xrec.get("key_blob_prev") or {}).get("ct"):
                            _xrec["key_blob_prev"] = _prev
                        if (_xrec.get("key_blob_prev") or {}).get("pub") == _blob.get("pub"):
                            _xrec.pop("key_blob_prev", None)
                        _xrec["key_blob"] = _blob
                        ifaces_dirty = True          # same save gate as the interface blobs just above
            def _clear_drift(k):
                if k in drift:
                    drift.pop(k, None); return True
                return False
            # listen port
            if ov.get("listen_port"):
                want = int(ov["listen_port"]); r = rep.get("listen_port")
                rp = int(r) if str(r).isdigit() else None
                if rp is None:
                    d["listen_port"] = want
                elif rp == want:
                    if synced.get("listen_port") != want:
                        synced["listen_port"] = want; ifaces_dirty = True
                    ifaces_dirty = _clear_drift("listen_port") or ifaces_dirty
                elif synced.get("listen_port") == want and not sysif:   # confirmed, then diverged → drift (user ifaces)
                    if drift.get("listen_port") != rp:
                        drift["listen_port"] = rp; ifaces_dirty = True
                else:                                                   # not yet confirmed → push to converge
                    ifaces_dirty = _clear_drift("listen_port") or ifaces_dirty
                    d["listen_port"] = want
            if ov.get("mtu"):
                want = int(ov["mtu"]); r = rep.get("mtu")
                rm = int(r) if str(r).isdigit() else None
                if rm is None:
                    d["mtu"] = want
                elif rm == want:
                    if synced.get("mtu") != want:
                        synced["mtu"] = want; ifaces_dirty = True
                    ifaces_dirty = _clear_drift("mtu") or ifaces_dirty
                elif synced.get("mtu") == want and not sysif:   # confirmed, then diverged → drift (user ifaces)
                    if drift.get("mtu") != rm:
                        drift["mtu"] = rm; ifaces_dirty = True
                else:                                           # not yet confirmed → push to converge
                    ifaces_dirty = _clear_drift("mtu") or ifaces_dirty
                    d["mtu"] = want
            if rep and "dns" not in ov and not sysif and ifn not in _inflight:
                ov["dns"] = [x for x in (rep.get("dns") or []) if isinstance(x, str)]; ifaces_dirty = True
            # AmneziaWG params
            if isinstance(ov.get("awg_params"), dict) and ov["awg_params"]:
                want = ov["awg_params"]; ra = rep.get("awg_params") or {}
                if not awg_gen_reported(snap):
                    want = {k: v for k, v in want.items() if k not in AWG3_FIELDS}
                extra = [k for k in (AWG_FIELDS if ov.get("awg_exact") else AWG3_FIELDS) if k in ra and k not in want]
                if not ra:
                    d["awg_params"] = want
                    if ov.get("awg_exact"):
                        d["awg_params_exact"] = True
                elif not extra and all(str(ra.get(k)) == str(want[k]) for k in want):
                    if synced.get("awg_params") != want:
                        synced["awg_params"] = dict(want); ifaces_dirty = True
                    ifaces_dirty = _clear_drift("awg_params") or ifaces_dirty
                elif synced.get("awg_params") == want and not sysif:    # confirmed, then diverged → drift (user ifaces)
                    nd = {k: ra.get(k) for k in list(want) + extra}     # the extra keys too, or Adopt could never take them
                    if drift.get("awg_params") != nd:
                        drift["awg_params"] = nd; ifaces_dirty = True
                else:                                                   # not yet confirmed (or a system link) → re-push the panel value
                    ifaces_dirty = _clear_drift("awg_params") or ifaces_dirty
                    d["awg_params"] = want
                    if extra or ov.get("awg_exact"):
                        d["awg_params_exact"] = True
            elif (rep.get("awg_params") and not sysif and ifn not in _inflight
                  and (rep.get("tool") or "awg") == "awg"):
                ov["awg_params"] = dict(rep["awg_params"]); ifaces_dirty = True
                if any(k not in rep["awg_params"] for k in AWG_FIELDS if k not in AWG3_FIELDS):
                    ov["awg_exact"] = True
            rep_pub = rep.get("public_key")
            if rep_pub:
                blessed = ov.get("public_key")
                if not blessed:
                    ov["public_key"] = rep_pub; ifaces_dirty = True            # first sight → bless it
                elif rep_pub == blessed:
                    ifaces_dirty = _clear_drift("public_key") or ifaces_dirty
                elif sysif:                                                    # mesh link key rotated → auto-adopt (re-bless), no drift
                    ov["public_key"] = rep_pub; _clear_drift("public_key"); ifaces_dirty = True
                elif drift.get("public_key") != rep_pub:
                    drift["public_key"] = rep_pub; ifaces_dirty = True
            if ov.get("egress_mode") != "forward":
                if "egress_ip" in ov:
                    d["egress_ip"] = ov.get("egress_ip") or ""
                if "wan_iface" in ov:
                    d["wan_iface"] = ov.get("wan_iface") or ""
            if ov.get("drops_reset"):
                d["drops_reset"] = ov["drops_reset"]
            if ov.get("mesh_reset"):
                d["mesh_reset"] = ov["mesh_reset"]
            if not synced:
                ov.pop("_synced", None)
            if not drift:
                ov.pop("_drift", None)
            if d:
                desired_ifaces[ifn] = d
        if ifaces_dirty:
            with contextlib.suppress(Exception):
                nodes_save(Handler.deps["nodes_path"], nodes)
        _mirrored_turn = False
        for _fam, _rkey, _dkey, _addr in (("wdtt", "wdtt", "wdtt_delete", "wg_addr"),
                                          ("csqtt", "csqtt", "csqtt_delete", "tun_addr")):
            for _rep in (snap.get(_fam) or []):
                if not isinstance(_rep, dict):
                    continue
                _tifn = (_rep.get("iface") or "").strip()
                if not _tifn or _tifn in (node.get(_rkey) or {}) or _tifn in (node.get(_dkey) or {}):
                    continue
                if "max_passwords" not in _rep or "params" not in _rep:
                    continue      # an older node — describing it partially is what restarts it
                _inst = {"iface": _tifn}
                for _k in ("fork", "listen", _addr, "wg_port", "web_port", "max_passwords", "params",
                           "raw_port", "raw_iface", "raw_addr", "bind_ip"):
                    if _rep.get(_k):
                        _inst[_k] = _rep[_k]
                # client DNS: compared by the node's _*_params_changed like params, so a mirror without it would
                # read as a change and restart the server with the fork's default
                _dv, _de = turn_client_dns(_rep.get("dns"), _rep.get("fork") or "", False)
                if _dv and not _de:
                    _inst["dns"] = _dv
                if _rep.get("stopped"):
                    _inst["stopped"] = True
                # csqtt's line: the record must say what runs, or the next reply (line absent = 2.1) would ask the
                # node to switch a server nobody asked to switch. 2.1 is the absent value.
                if _fam == "csqtt" and _CSQTT_LINE_RE.match(str(_rep.get("line") or "")) and _rep.get("line") != CSQTT_DEFAULT_LINE:
                    _inst["line"] = _rep["line"]
                _pwkey = "wdtt_password" if _fam == "wdtt" else "csqtt_password"
                _known_pw = {pp.get(_pwkey) for pp in (roster.get("peers") or {}).values()
                             if isinstance(pp, dict) and pp.get(_pwkey)}
                _took = 0
                for _pw, _pmeta in sorted((_rep.get("passwords") or {}).items()):
                    if not _pw or _pw in _known_pw or not no_ctrl(str(_pw)):
                        continue
                    _pmeta = _pmeta if isinstance(_pmeta, dict) else {}
                    _ppid = gen_id()
                    while _ppid in (roster.get("peers") or {}):
                        _ppid = gen_id()
                    _pf = {"user_id": None, "pubkey": "", "psk": "",
                           "title": (str(_pmeta.get("comment") or "").strip() or "adopted")[:60],
                           "targets": [{"node": nid, "iface": _tifn, "ip": "", "type": _fam}],
                           _pwkey: _pw}
                    if _pmeta.get("is_deactivated"):
                        _pf["disabled"] = True
                    with contextlib.suppress(Exception):
                        _pf["expiry"] = int(_pmeta.get("expires_at") or 0)
                    _pp = peer_set(roster, _ppid, _pf, int(time.time()))
                    _took += 1
                    ev_append(Handler.deps["roster_path"], "peer", _ppid,
                              "Imported user from a server the node runs", peer_label(roster, _pp),
                              nid + "/" + _tifn)
                if _took:
                    roster_save(Handler.deps["roster_path"], roster)
                node.setdefault(_rkey, {})[_tifn] = _inst
                _mirrored_turn = True
                ev_append(Handler.deps["roster_path"], "node", nid,
                          "Recorded a server the node runs", node.get("name", nid), _tifn)

        _wstore = node.get("wdtt") or {}
        if _wstore or node.get("csqtt"):
            _wsealed = snap.get("wdtt_key_sealed") or {}
            _wsnap = {w.get("iface"): w for w in (snap.get("wdtt") or []) if isinstance(w, dict)}
            _wdtt_dirty = _mirrored_turn      # the mirror above wrote records; this block owns the save
            _imported = 0
            try:
                for _wifn, _wsn in _wsnap.items():
                    _au = _wsn.get("adopt_users")
                    if not isinstance(_au, dict) or not _au or _wifn not in _wstore:
                        continue
                    _known = {p.get("wdtt_password") for p in (roster.get("peers") or {}).values()
                              if isinstance(p, dict) and p.get("wdtt_password")
                              and any((t or {}).get("node") == nid and (t or {}).get("iface") == _wifn
                                      for t in (p.get("targets") or []))}
                    for _pw, _meta in _au.items():
                        if not _pw or _pw in _known or not no_ctrl(str(_pw)):
                            continue
                        _meta = _meta if isinstance(_meta, dict) else {}
