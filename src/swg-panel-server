PROV_STATUS_PATH = "/var/lib/swg-panel/provider-status.json"
_CATALOG = {"idx": None, "at": 0, "err": "", "perr": {}}
_CATALOG_BOOT = int(time.time())
_CATALOG_GEN = itertools.count(1)
def _catalog_changed():
    _CATALOG["gen"] = next(_CATALOG_GEN)
def catalog_gen():
    return "%d:%d" % (_CATALOG_BOOT, _CATALOG.get("gen", 0))
_PROV_STATUS = {}
_PROV_UPDATING = {"on": False}

def _prov_status_load():
    with contextlib.suppress(Exception):
        _PROV_STATUS.update(json.load(open(PROV_STATUS_PATH)))
    _stuck = [p for p, st in _PROV_STATUS.items() if isinstance(st, dict) and st.get("status") in ("downloading", "updating")]
    for p in _stuck:
        _PROV_STATUS[p]["status"] = "idle"
    if _stuck:
        _prov_status_save()
def _prov_status_save():
    with contextlib.suppress(Exception):
        atomic_write(PROV_STATUS_PATH, json.dumps(_PROV_STATUS))

_CATALOG_LOCK = threading.Lock()
_PROV_GEN = {}
_PROV_INFLIGHT = set()

def provider_stale(pid, gen):
    return _PROV_GEN.get(pid, 0) != gen

def catalog_refresh_provider(pid, gen):
    part = _catalog_build(only=[pid])
    if provider_stale(pid, gen) or not part or pid in (_CATALOG.get("perr") or {}):
        return None
    with _CATALOG_LOCK:
        base = dict(_catalog_last_good())
        for k in [k for k in base if str(k).split(":", 1)[0] == pid]:
            base.pop(k, None)
        base.update(part)
        _CATALOG.update(idx=base, err="")
        _catalog_changed()
        _CATALOG.pop("fail_at", None)
        with contextlib.suppress(Exception):
            atomic_write(CATALOG_PATH, json.dumps({"idx": base, "at": int(_CATALOG.get("at") or 0)}))
    return part

def provider_download(pids):
    pids = [p for p in pids if p in CATALOG_PROVIDERS and p not in _PROV_INFLIGHT]
    if not pids:
        return
    gens = {}
    for p in pids:
        _PROV_INFLIGHT.add(p)
        gens[p] = _PROV_GEN[p] = _PROV_GEN.get(p, 0) + 1
        _PROV_STATUS.setdefault(p, {})["status"] = "downloading"
    _prov_status_save()
    def _work(pid, gen):
        try:
            catalog_refresh_provider(pid, gen)
        except Exception:
            pass
        finally:
            _PROV_INFLIGHT.discard(pid)
            if provider_stale(pid, gen):
                return
            st = _PROV_STATUS.setdefault(pid, {})
            perr = (_CATALOG.get("perr") or {}).get(pid, "")
            st["status"] = "failed" if perr else "uptodate"
            if perr: st["error"] = perr[:120]
            else:    st.pop("error", None)
            _prov_status_save()
    for p in pids:
        threading.Thread(target=_work, args=(p, gens[p]), daemon=True).start()

def provider_cancel(pid):
    if pid not in CATALOG_PROVIDERS:
        return False
    _PROV_GEN[pid] = _PROV_GEN.get(pid, 0) + 1
    _PROV_STATUS.pop(pid, None)
    _prov_status_save()
    return True

def catalog_provider_label(prov):
