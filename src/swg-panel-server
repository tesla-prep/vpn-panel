    if cid.startswith("runet:"):
        rid = rid.replace("--attr--", "@").replace("--bang--", "!")
    return rid.replace("_", " ").replace("-", " ").strip().title() or cid

def catalog_search(q, page, per=40, enabled=None):
    idx = catalog_index(); q = (q or "").strip().lower()
    items = []
    for cid, e in idx.items():
        prov = e.get("p", "")
        if enabled is not None and not enabled.get(prov, False):
            continue
        lbl = catalog_label(cid)
        if q and q not in cid.lower() and q not in lbl.lower():
            continue
        items.append((cid, lbl, prov, {"ip": e.get("ip", False), "host": e.get("host", False)}))
    items.sort(key=lambda x: (x[1].lower(), x[2]))
    total = len(items); sl = items[page * per:(page + 1) * per]
    return {"total": total, "page": page, "per": per,
            "items": [{"id": c, "label": l, "provider": p, "provider_label": catalog_provider_label(p), "caps": caps}
                      for c, l, p, caps in sl]}

