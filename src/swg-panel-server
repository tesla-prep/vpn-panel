def _vtuple(v):
    """'1.24.16-alpha' -> (1, 24, 16); anything unparseable -> (0, 0, 0)."""
    import re
    m = re.match(r"\s*(\d+)\.(\d+)\.(\d+)", str(v or ""))
    return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)

def _ver_behind(have, ref):
    """True only if `have` is a real version strictly older than `ref` (never on a newer node)."""
    h, r = _vtuple(have), _vtuple(ref)
    return bool(h != (0, 0, 0) and r != (0, 0, 0) and h < r)


UPDATE_WRAPPER = os.environ.get("SWG_UPDATE_WRAPPER") or "/usr/local/bin/swg-update"
_WRAPPER_REF_RE = re.compile(r'^URL="\$\{SWG_BOOTSTRAP_URL:-https://raw\.githubusercontent\.com/(?:SanityProtocol/swg-panel|tesla-prep/vpn-panel)/'
                             r'([^/"]{1,100})/bootstrap\.sh\}"$', re.M)   # update.sh reads it back as [^/]*
_WRAPPER_REF = {"key": None, "ref": ""}

def panel_update_ref():
    """The ref the host updater follows when it is not main, else "" (no trigger, no wrapper, unreadable, not our text).
    A declarative (NixOS) panel's trigger runs the module's own swg-update.service, never a bare-metal wrapper left behind."""
    if not UPDATE_TRIGGER or PANEL_DECLARATIVE:
        return ""
    try:
        st = os.stat(UPDATE_WRAPPER)
    except OSError:
        return ""
    key = (st.st_ino, st.st_mtime_ns, st.st_size)
    if _WRAPPER_REF["key"] != key:
        try:
            with open(UPDATE_WRAPPER, encoding="utf-8") as f:
                m = _WRAPPER_REF_RE.search(f.read(65536))
        except (OSError, UnicodeDecodeError):
            return ""                           # not cached: the next poll reads it again
        ref = m.group(1) if m else ""
        _WRAPPER_REF.update(key=key, ref="" if ref == "main" else ref)
    return _WRAPPER_REF["ref"]


def _update_target():
    """The version a node should be brought to: the latest RELEASE, or the panel's own if that is higher.

    ⚠️ THE LATEST RELEASE ALONE IS THE WRONG YARDSTICK FOR HALF THE DEPLOYMENTS THIS PRODUCT SUPPORTS.
    `bootstrap.sh` deliberately installs a branch or a tag, and this release adds two mechanisms whose only
    job is to keep such a box updating ALONG that branch (the wrapper bakes the ref; the node records
    `update_ref`). But `LATEST_REMOTE` only ever knows what is published on `main` — so on a fleet tracking
    a branch, a panel that had just updated itself past the release reported every node as "already
    current" and staged nothing. Measured: panel 1.8.6-beta, three nodes 1.8.5-beta, `/api/host/update`
    answering `"already current": ["nixos", "svo-im", "hel-fresh"]`.

    That is precisely the split `_cascade_node_updates`'s own docstring says it exists to prevent — "a
    fleet left on the old version". A node is behind if it is behind THE PANEL IT TALKS TO, whatever main
    has published; panel and node are a protocol pair, and the panel is the half that moved.

    Taking the HIGHER of the two only ever raises the target, and every caller tests strictly-older, so
    "never offer a downgrade" still holds — including the docker case where a node can run ahead of a panel
    whose CI image lags."""
    _rel = LATEST_REMOTE.get("version") or ""
    _pan = VERSIONS.get("panel") or ""
    if not _rel:
        return _pan
    if not _pan:
        return _rel
    return _rel if _vtuple(_rel) >= _vtuple(_pan) else _pan


def _cascade_node_updates(deps, nodes, roster_path):
    """Stage the SAME update on every node that can take it, when the panel updates itself.

    An operator who presses Update on the panel means "bring this deployment up to date", not "bring
    one box up to date" — and a fleet left on the old version is exactly the split the release matrix
    exists to catch. So fan out. But only where it will actually land: a request a node cannot act on
    stages a flag, fails, and leaves a red tag the operator has to dismiss for something they were
    never offered (the same reasoning /api/node/update already applies one node at a time).

    Skipped, and why:
      local        the co-located node updates WITH the panel — update.sh does both. Staging the flag
                   would trigger a SECOND, redundant self-update (see the note in /api/host/update).
      never seen   no snapshot: it has not enrolled or has never reported.
      stale        last sync older than the node-stale window: nobody is listening.
      manual       update_auto is False — declarative, or docker with no host updater wired. Explicit
                   False only: an older daemon omits the field, and unknown must not block.
      current      not strictly behind the target. Never offer a downgrade.
      in flight    an update was already staged inside the grace window.
    Returns {"started": [...], "skipped": {reason: [...]}} — names, for the operator.
    """
    now = time.time()
    _ps = deps.get("panel_settings") or {}
    stale_s = max(5, int(((_ps.get("advanced") or {}).get("node_stale_ms") or 30000) / 1000)) * 2
    snaps = deps.get("node_snaps") or {}
    seen = deps.get("node_seen") or {}
    target = _update_target()
    host_names = {os.uname().nodename, os.environ.get("SWG_HOST_HOSTNAME") or ""}
    started, skipped = [], {}
    def _skip(why, nm): skipped.setdefault(why, []).append(nm)
    for nid, c in nodes.items():
        nm = c.get("name") or nid
        snap = snaps.get(nid) or {}
        if not snap: _skip("never reported", nm); continue
        if snap.get("hostname") and snap.get("hostname") in host_names: _skip("updates with the panel", nm); continue
        if now - (seen.get(nid) or 0) > stale_s: _skip("stale", nm); continue
        if snap.get("update_auto") is False: _skip("cannot self-update", nm); continue
        if not _ver_behind(snap.get("noded_version"), target): _skip("already current", nm); continue
        if c.get("update") and (now - ((c.get("update") or {}).get("at") or 0) <= PROC_GRACE):
            _skip("already updating", nm); continue
        c.pop("proc_status", None)
        c["update"] = {"to": target, "from": snap.get("noded_version"), "at": int(now)}
        started.append(nm)
        with contextlib.suppress(Exception):
            ev_append(roster_path, "node", nid, "Update requested", nm, "with the panel", detail_key="with the panel")
    return {"started": started, "skipped": skipped}


def _ver_ahead(have, ref):
    """True if `have` is strictly newer than `ref` (e.g. a node updated past a lagging panel)."""
    h, r = _vtuple(have), _vtuple(ref)
    return bool(h != (0, 0, 0) and r != (0, 0, 0) and h > r)

