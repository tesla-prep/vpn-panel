def p2p_portok_clean(raw):
    """(canonical list, error): the port-rule grammar (`ports_clean`, gated on tests/ports_vectors.json — commas or spaces,
    an en dash read as a hyphen, ASCII digits, 1-65535, ranges merged and sorted; the node's interval set refuses an
    overlap), as a list or one string. Empty is refused: "nothing exempt" is not what clearing the field means — Reset to
    defaults is. What it cannot take is named."""
    if isinstance(raw, list):
        raw = " ".join(str(x) for x in raw)                   # a 0 in a JSON list is an entry, refused below — never dropped
    if not isinstance(raw, str):                              # a number, an object: named, never read as "empty" (s11c F15)
        return None, perr("Not a port or a port range (1-65535): {v1}", v1=str(raw)[:40])
    proto, canon = ports_clean("both", raw)
    if proto is not None:
        return canon.split(","), None
    if canon == "empty":
        return None, perr("Keep at least one port, or reset the list to its defaults.")
    if canon == "too_many":
        return None, perr("Too many entries — at most {v1}.", v1=str(PORTS_MAX_TOKENS))
    bad = [t for t in _ports_toks(raw) if ports_clean("both", t)[0] is None]
    return None, perr("Not a port or a port range (1-65535): {v1}", v1=", ".join(bad[:5]) or str(raw)[:40])


def p2p_portok_wire(ps, node):
    """The node's never-cut ports for the sync — its own list, else the fleet's — as the node's "a-b, c" string; None
    when that is the built-in list (the reply a fleet on the defaults always got). A stored value that is not a list (a
    hand edit) counts as absent — joined as a string it would exempt its characters."""
    own, fleet = (node or {}).get("p2p_portok"), (ps or {}).get("p2p_portok")
    eff = own if isinstance(own, list) and own else fleet if isinstance(fleet, list) and fleet else P2P_PORTOK_DEFAULT
    return None if eff == P2P_PORTOK_DEFAULT else ", ".join(eff)


def p2p_route_dev(node, p2p):
    """The device a record's own torrent route leaves by — what the node's iface groups route out of and name in their
    report's `down` (S11 backlog F48): an exit's device, or the mesh link to the node it routes through. "" when it has none (a disabled exit's too)."""
    a = (p2p or {}).get("action") if isinstance(p2p, dict) else None
    if a == "dev":                                            # resolve_exit's reading: a disabled exit routes nothing, a name stripped
        x = next((x for x in ((node or {}).get("exits") or []) if isinstance(x, dict) and str(x.get("id")) == str(p2p.get("exit_id"))), None)
        return str(x.get("device") or "").strip() if x and x.get("enabled") is not False else ""
    if a == "exit":
        lk = ((node or {}).get("links") or {}).get(p2p.get("node"))
        return str(lk.get("iface") or "").strip() if isinstance(lk, dict) else ""
    return ""


def p2p_policy(node):
    """The node's P2P policy in force: what the operator saved, else block. The default is never written — it is the
    absence of a choice — so nothing migrates, and a choice made later is the only thing ever stored.
    ⚠️ Reversed 2026-10-08 (operator: torrents blocked by default). The default used to be COMPUTED from the node's
    records: block while every interface, WDTT and csqtt server had Torrents / P2P switched on, else iface — "the
    behaviour the node had before the policy existed". It read as block-by-default and was off in practice: an interface
    the installer made or one onboarded is recorded with no block list, and so is a WDTT or csqtt server created from
    the Turn proxies card, so one such record turned the node to iface — which also stops judging the node's own
    processes and the traffic other nodes send out through it. Measured on swgt: 3 of 4 nodes computed iface, none by
    choice. The per-interface switches still decide under an iface the operator picks."""
    v = node.get("p2p")
    if isinstance(v, dict) and v.get("action") in P2P_ACTIONS:
        return v["action"]
    return "block"


def p2p_iface_wire(pi):
    """`smart.p2p` under "Each interface decides": None while no record lowers a choice (the reply as before), else
    {action: iface, entries?, direct?, block?} — the keys with something in them (IFACE-P2P-PICK §3.2)."""
    pi = pi or {}
    out = {k: (sorted(set(pi[k])) if k != "entries" else sorted(pi[k], key=lambda e: e["table"]))
           for k in ("entries", "direct", "block") if pi.get(k)}
    return {"action": "iface", **out} if out else None


def _p2p_target(pp, nodes, nid):
    rec = {"action": pp["action"]}
    if pp["action"] == "exit":
        q = str(pp.get("node") or "")
        if q not in nodes or q == nid:
            return None, "torrents can only be routed to another node of this fleet"
        rec["node"] = q
    return rec, None


def _block_list_src(pid, lid):
    """A human-viewable URL for a block list — where the operator can see exactly what it contains. Resolves the
    provider's raw template with the list id, then rewrites raw.githubusercontent.com → the GitHub blob page (nicer
    to read); non-GitHub feeds (oisd, phishing.army, pgl.yoyo) render their plaintext fine as-is."""
    cfg = BLOCK_PROVIDERS.get(pid) or {}
    raw = (cfg.get("raw") or "").replace("{id}", lid or "")
    m = re.match(r"^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.+)$", raw)
    if m:
        return "https://github.com/%s/%s/blob/%s/%s" % m.groups()
    return raw

