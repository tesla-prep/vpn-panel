RANGE_SPEC = {"live": (0, 200, 200 * 15), "hour": (0, 250, 3600), "day": (1, 300, 86400),
              "week": (2, 350, 7 * 86400), "month": (3, 400, 30 * 86400)}
RANGE_CUSTOM_DAYS = 33


def resolve_range(qs, dflt="day", now=None):
    now = time.time() if now is None else now
    rng = (qs.get("range") or [dflt])[0]
    if rng != "custom":
        spec = RANGE_SPEC.get(rng)
        if not spec:
            raise ValueError({"error": "range must be live|hour|day|week|month|custom"})
        ring, want, win = spec
        return ring, want, now - win, None, None
    f, t = _ld_from_to(qs)
    today = _ld_day(now)[0]
    t = min(t, today)
    if f > t:
        raise ValueError(perr("from must not be after to"))
    first = _ld_of(_ld_date(today) - _ldt.timedelta(days=RANGE_CUSTOM_DAYS - 1))
    if f < first:
        raise ValueError(perr("The charts keep {v1} days: a custom window can start on {v2} at the earliest",
                              v1=RANGE_CUSTOM_DAYS, v2=_ld_date(first).isoformat()))
    since, until = _ld_midnight(f), min(int(now), _ld_midnight(_ld_next(t)))
    ring = next((i for i, (st, n) in enumerate(HRRD_RINGS) if since >= now - (n - 1) * st), len(HRRD_RINGS) - 1)
    step, nslots = HRRD_RINGS[ring]
    axis = {"rangeKey": "custom:%d-%d" % (f, t), "step": step, "since": int(since), "until": int(until)}
    return ring, nslots, since, until, axis


def _local_bars(since, until, step, off=None):
    if step % 86400:
        n = max(1, min(64, -(-(until - since) // step)))
        return n, [since + i * step for i in range(n)], lambda ep: int((ep - since) // step)
    off = off or (lambda e: time.localtime(e).tm_gmtoff or 0)
    w0 = since + off(since)
    n = max(1, min(64, -(-((until + off(until)) - w0) // step)))
    starts = [w - off(w - off(w)) for w in (w0 + i * step for i in range(n))]
    return n, starts, lambda ep: int((ep + off(ep) - w0) // step)


def range_or_400(qs, dflt="day"):
    try:
        return resolve_range(qs, dflt), None
    except ValueError as e:
        m = e.args[0] if e.args and isinstance(e.args[0], dict) else {"error": str(e)}
        return None, (400, {"ok": False, **m, "code": "bad_request"})

