            # one stored before this door existed is reported by the node's issues instead (see _node_issues).
            if ms and ms != (nodes[nid].get("mesh_subnet") or ""):
                _why = mesh_pool_refusal(ms)
                if _why == "cidr":
                    return 400, {"ok": False, "error": "mesh subnet must be a CIDR (or blank)", "code": "bad_request"}
                if _why:
                    return 400, {"ok": False, "error": "mesh subnet must be an IPv4 range of /31 or larger (or blank)",
                                 "code": "bad_request"}
                _net = ipaddress.ip_network(ms, strict=False)
                _room = mesh_pool_room(ms) - len({(lr or {}).get("subnet") for k, n in nodes.items() if k != nid
                                                  for p, lr in (n.get("links") or {}).items()
                                                  if p != nid and _mesh_in((lr or {}).get("subnet"), _net)})
                _need = _mesh_anchored(nodes, deps).get(nid, 0)
                if _need > _room:
                    return 400, {"ok": False, **perr("{v1} holds too few mesh links for this node ({v2} fit, {v3} "
                                                     "needed) — choose a larger subnet, or leave it blank to use the "
                                                     "panel's", v1=ms, v2=max(0, _room), v3=_need), "code": "bad_request"}
