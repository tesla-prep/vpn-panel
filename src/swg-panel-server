def _csqtt_tun_for_line(addr):
    """The --tun-addr a 2.5 server is sent. 2.5.3 does not start on a host number in .2–.250 (the client range): such an
    address becomes .1 of the same /24 — the same subnet, so routing, mesh and the fleet's uniqueness check are untouched,
    and a 2.5 client's address is its password's own (operator, 2026-10-29). Any other address is sent as stored."""
    ip, sep, mask = str(addr or "").partition("/")
    octs = ip.split(".")
    if len(octs) == 4 and octs[3].isdigit() and 2 <= int(octs[3]) <= 250:
        return ".".join(octs[:3]) + ".1" + sep + mask
    return addr
_CSQTT_LINE_RE = re.compile(r"^[0-9]{1,3}\.[0-9]{1,3}$")
def _csqtt_standin(spec):
    line, _, vers = (spec or "").partition("=")
    line = line.strip()
    known = dict(CSQTT_BUILDS)
    builds = [(v.strip(), known[v.strip()]) for v in vers.split(",") if v.strip() in known]
    if _CSQTT_LINE_RE.match(line) and line not in CSQTT_LINES and builds:   # never over a released line (2.1, 2.5)
        CSQTT_LINES[line] = builds
_csqtt_standin(os.environ.get("SWG_CSQTT_STANDIN", ""))
