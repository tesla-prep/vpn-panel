_JS_TREE = {"sig": None, "q": b""}


def _js_dir():
    return os.path.join(WEB_DIR, "js")


def _js_tree_q():
    sig, names, srv = [], [], b""
    with contextlib.suppress(Exception):
        _st = os.stat(os.path.abspath(__file__))
        srv = ("%d.%d" % (_st.st_mtime_ns, _st.st_size)).encode()
        sig.append(("<server>", int(_st.st_mtime_ns), _st.st_size))
    with contextlib.suppress(Exception):
        for root, _dirs, files in os.walk(_js_dir()):
            for fn in files:
                if fn.endswith(".js"):
                    p = os.path.join(root, fn)
                    with contextlib.suppress(OSError):
                        st = os.stat(p)
                        names.append(p)
                        sig.append((os.path.relpath(p, _js_dir()), int(st.st_mtime_ns), st.st_size))
    sig.sort()
    if sig == _JS_TREE["sig"]:
        return _JS_TREE["q"]
    h = hashlib.sha1()
    h.update(srv)
    for p in sorted(names):
        with contextlib.suppress(OSError):
            h.update(os.path.relpath(p, _js_dir()).encode())
            with open(p, "rb") as f:
                h.update(f.read())
    base = (VERSIONS.get("panel") or "").strip()
    tag = base + ("." + h.hexdigest()[:8] if names else "")
    _JS_TREE["sig"] = sig
    _JS_TREE["q"] = (("?v=" + quote(tag, safe="")) if tag else "").encode()
    return _JS_TREE["q"]


_IMPORT_SPEC_RE = re.compile(rb'((?:from|import)\s*\(?\s*")(\.{1,2}/[A-Za-z0-9_./-]+\.js)(")')


def _stamp_imports(data, rel):
    base = os.path.dirname(rel)
    def one(m):
        spec = m.group(2).decode("utf-8", "replace")
        target = os.path.normpath(os.path.join(base, spec)).replace(os.sep, "/")
        q = _js_tree_q() if target.startswith("js/") else _asset_q(target)
        return m.group(1) + m.group(2) + q + m.group(3)
    return _IMPORT_SPEC_RE.sub(one, data)


