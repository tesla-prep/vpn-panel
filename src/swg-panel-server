                  "connect_failed", "dns_failed")


def _exit_test_expire(rec, now):
    if rec["result"] is None and now - rec["at"] > EXIT_TEST_TTL:
        rec["result"], rec["done_at"] = {"why": "expired", "collected": bool(rec["sent_at"])}, now
        rec["socks"] = {}


def exit_test_view(rec, now):
    return {"id": rec["id"], "node": rec["node"], "exit_id": rec["exit_id"],
            "state": "pending" if rec["result"] is None else "done", "collected": bool(rec["sent_at"]),
            "age": int(now - rec["at"]), "result": rec["result"]}


def exit_test_request(nid, exit_id, socks, snap, seen_age, stale_s, now=None, profile=None, provider="socks5"):
    now = time.time() if now is None else now
    if not isinstance(snap, dict) or not snap or seen_age is None or seen_age > stale_s:
        return 409, {"ok": False, "error": "the node is not reporting — a test would never be collected", "code": "offline"}
    _no = exit_kind_refusal(snap, provider)
    if _no:
        return 400, {"ok": False, **_no, "code": "unsupported"}
    with _EXIT_TESTS_LOCK:
        cur = _EXIT_TESTS.get(nid)
        if cur:
            _exit_test_expire(cur, now)
            if cur["result"] is None:
                return 409, {"ok": False, "error": "a test is already running on this node", "code": "busy"}
        rec = {"id": secrets.token_hex(8), "node": nid, "exit_id": str(exit_id or ""), "socks": dict(socks),
               "at": now, "sent_at": 0, "result": None, "done_at": 0, "profile": profile, "provider": provider}
        _EXIT_TESTS[nid] = rec
        return 200, {"ok": True, "data": exit_test_view(rec, now)}


def exit_test_reply(nid, now=None):
    now = time.time() if now is None else now
    with _EXIT_TESTS_LOCK:
        rec = _EXIT_TESTS.get(nid)
        if rec is None:
            return None
        _exit_test_expire(rec, now)
        if rec["result"] is not None:
            if now - rec["done_at"] > EXIT_TEST_KEEP:
                _EXIT_TESTS.pop(nid, None)
            return None
        rec["sent_at"] = rec["sent_at"] or now
        sk = rec["socks"]
        return {"id": rec["id"], "provider": rec["provider"], "host": sk.get("host") or "", "port": sk.get("port") or 0, "user": sk.get("user") or "",
                "pass": sk.get("pass") or ""}


def exit_test_absorb(nid, snap, deps, now=None):
    got = snap.get("exit_test") if isinstance(snap, dict) else None
    if not isinstance(got, dict):
        return False
    now = time.time() if now is None else now
    with _EXIT_TESTS_LOCK:
        rec = _EXIT_TESTS.get(nid)
        if not rec or rec["result"] is not None or got.get("id") != rec["id"]:
            return False
        why = got.get("why") if got.get("why") in _EXIT_TEST_WHY else ""
        u = got.get("udp")
        result = {"why": why, "login": got.get("login") is True,
                  "egress_ip": str(got.get("egress_ip") or "")[:45], "loc": str(got.get("loc") or "")[:8],
                  "udp": u if isinstance(u, bool) else None,
                  "rtt_ms": got.get("rtt_ms") if isinstance(got.get("rtt_ms"), int) and not isinstance(got.get("rtt_ms"), bool) else None}
        if rec["profile"]:
            pid, sig = rec["profile"]
            pool = socks_pool(deps)
            entry = pool.get(pid)
            if entry and sig == _pool_exit(pid, entry)["cfg_sig"]:
                previous = entry.get("check") or {}
                if rec["at"] >= previous.get("started_at", 0):
                    check = {"node": nid, "sig": sig, "started_at": rec["at"], "result": result}
                    try:
                        save_socks_pool(deps, {**pool, pid: dict(entry, check=check)})
                    except OSError as error:
                        log(LOG_WARNING, "SOCKS5 check result could not be saved: %s" % error)
                        return False  # The node will send the result again on the next sync.
        rec["result"], rec["done_at"], rec["socks"] = result, now, {}
        return True


def exit_test_status(nid, rid=None, now=None):
    now = time.time() if now is None else now
    with _EXIT_TESTS_LOCK:
        rec = _EXIT_TESTS.get(nid)
        if not rec or (rid and rec["id"] != rid):
            return None
        _exit_test_expire(rec, now)
        return exit_test_view(rec, now)


_HEV_MIRROR_LOCK = threading.Lock()
_HEV_MIRROR_FAIL = {}
HEV_MIRROR_RETRY_S = 600


def hev_mirror_file(arch):
    want = HEV_SHA256.get(arch)
    if not want:
        return ""
    if time.time() - _HEV_MIRROR_FAIL.get(arch, 0) < HEV_MIRROR_RETRY_S:
        return ""
    with _HEV_MIRROR_LOCK:
        if time.time() - _HEV_MIRROR_FAIL.get(arch, 0) < HEV_MIRROR_RETRY_S:
            return ""
        got = _hev_mirror_file(arch, want)
        if not got:
            _HEV_MIRROR_FAIL[arch] = time.time()
        return got


def _hev_mirror_file(arch, want):
    dest = os.path.join(TURN_BINS_DIR, _turn_safe(HEV_OWNER), _turn_safe(HEV_TAG), HEV_ASSET[arch])
    with contextlib.suppress(OSError):
        if os.path.getsize(dest) > 0:
            if _turn_sha256_file(dest) == want:
                return dest
            os.remove(dest)
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
    except OSError:
        return ""
    tmp = dest + ".dl." + secrets.token_hex(4)
    try:
        r = subprocess.run(["curl", "-4", "-fsSL", "--connect-timeout", "15", "--max-time", "180", "--retry", "2",
                            "--retry-delay", "2", "https://github.com/%s/releases/download/%s/%s" % (HEV_OWNER, HEV_TAG,
                                                                                              HEV_ASSET[arch]), "-o", tmp],
                           capture_output=True, text=True, timeout=200)
        if r.returncode == 0 and os.path.isfile(tmp) and _turn_sha256_file(tmp) == want:
            os.replace(tmp, dest)
            return dest
    except Exception:
        pass
    finally:
        with contextlib.suppress(OSError):
            os.remove(tmp)
    return ""

_EXIT_ESCROW_KEYS = ("key_blob", "key_blob_prev", "key_restore", "key_restore_pub", "key_restore_at")


def _validate_exits(exits, c, prev=(), gen_snap=None, **_):
    if not isinstance(exits, list):
        return None, "exits must be a list"
    known = {str(e.get("id") or ""): e for e in prev if isinstance(e, dict)}
    clean, seen = [], set()
    for e in exits:
        if not isinstance(e, dict) or e.get("producer") != "imported" or e.get("provider") != "socks5":
            return None, "only personal SOCKS5 exits are supported"
        eid = str(e.get("id") or "").strip().lower()
        if not EXIT_ID_RE.fullmatch(eid) or eid in seen:
            eid = uuid.uuid4().hex[:8]
        seen.add(eid)
        dev = "s5x-" + eid
        label = str(e.get("label") or "").strip()[:40]
        kept = (known.get(eid) or {}).get("socks") or {}
        if gen_snap is not None and not kept:
            refusal = exit_kind_refusal(gen_snap, "socks5", c.get("name") or "this node")
            if refusal:
                return None, refusal
        socks, error = socks_resolve(e.get("socks_text"), e.get("socks_pass"), kept)
        if error:
            return None, perr("{v1}: {v2}", v1=label or dev, v2=perr(error))
        socks["salt"] = kept.get("salt") if kept.get("salt") and kept.get("pass") == socks["pass"] else secrets.token_hex(8)
        out = {"id": eid, "device": dev, "label": label if label != dev else "",
               "provider": "socks5", "producer": "imported", "enabled": e.get("enabled", True) is not False,
               "socks": socks}
        out["cfg_sig"] = exit_cfg_sig(out)
        clean.append(out)
    return clean, None


def _dialin_refusal(out, kept, dial_src, ctx):
    if not exit_is_dialin(out):
        return ""
    pr = out["profile"]
    if dial_src:
        return "a dial-in exit dials nothing, so it has no source address to pin — set Connect from to Auto"
    if not ctx:
        return ""
    kept = kept if exit_is_dialin({"provider": "profile", "profile": kept or {}}) else {}
    port = int(pr["listen_port"])
    if port != (kept or {}).get("listen_port"):
        held = (ctx.get("ports") or {}).get(port)
        if held:
            return perr("UDP port {v1} is already used on this node by {v2}", v1=str(port), v2=held)
        _mb = ctx.get("mesh_band") or range(0)
        if port in _mb:
            return perr("UDP port {v1} is in the reserved system mesh range ({v2})", v1=str(port), v2="%d–%d" % (_mb[0], _mb[-1]))
        if (_pr := p2p_pool_refusal(port)):
            return _pr
        _fw = ctx.get("udp_ranges") or []
        if _fw and not any(a <= port <= b for a, b in _fw):
            return perr("UDP port {v1} is outside this node's declared firewall ranges ({v2}) — the router could never reach it; "
                        "pick a port inside them, or add it to udpPortRanges", v1=str(port),
                        v2=", ".join(str(a) if a == b else "%d–%d" % (a, b) for a, b in _fw))
    if pr.get("address") != (kept or {}).get("address"):
        with contextlib.suppress(ValueError):
            a = ipaddress.IPv4Address(str(pr.get("address") or ""))
            for nm, net in (ctx.get("nets") or ()):
                if net.version == 4 and a in net:
                    return perr("the address {v1} is inside {v2} ({v3}) on this node — use another one",
                                v1=str(a), v2=str(nm), v3=str(net))
    return ""


