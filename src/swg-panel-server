def accepts_gzip(hdr):
    """Does this client EXPLICITLY accept gzip? Substring matching is wrong: `gzip;q=0` means "not this one".

    Explicit opt-in is what makes compressing /api/state safe for the fleet. `swg-noded` talks through
    `http.client` (`post_json`, `_panel_get`), which sets only Content-Type/Authorization and adds no
    Accept-Encoding at all — so the node sync loop cannot observe this change even in principle."""
    for part in (hdr or "").split(","):
        bits = part.strip().split(";")
        if bits[0].strip().lower() != "gzip":
            continue
        for pair in bits[1:]:
            k, _, v = pair.partition("=")
            if k.strip().lower() == "q":
                try:
                    return float(v) > 0
                except ValueError:
                    return False
        return True
    return False


