def _accept_lang(hdr):
    """First supported language in an Accept-Language header, else 'en'. Quality values are not weighed: with two
    languages the order the browser lists them in already says which it prefers."""
    for part in (hdr or "").split(","):
        code = part.split(";")[0].strip().lower()[:2]
        if code in _META_LANG:
            return code
    return "en"

def _localize_meta(data, lang):
    """Swap the shell's description/og-description for `lang`. English is what the file ships with, so it is a
    no-op there — and an unknown language keeps the file as written rather than blanking the tags."""
    m = _META_LANG.get(lang)
    if not m:
        return data
    out = data.replace(b'<html lang="en">', ('<html lang="%s">' % lang).encode())
    with contextlib.suppress(Exception):
        out = re.sub(rb'(<meta (?:name="description"|property="og:description") content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["desc"].encode() + mo.group(2), out)
    return out


def _req_lang():
    """The UI language of the browser making this request (js/store.js sets it on every call).

    The panel translates nothing itself; it needs this only to fetch the right changelog file. Unknown or
    missing → English, which is also the fallback when a translated changelog isn't published yet."""
    v = (getattr(_REQ, "lang", "") or "").strip().lower()
    return v if re.fullmatch(r"[a-z]{2}", v or "") else "en"
