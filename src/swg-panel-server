    def _node_goodbye(self):
        nid, _gnode, _ = self._node_token()
        if not nid:
            return
        if not self._node_sig_ok(_gnode, b"", require=False):
            return
        with _api_lock:
            nodes = nodes_load(Handler.deps["nodes_path"])
            if nid not in nodes:
                return self._send(200, {"ok": True, "kept": nid})
            if nodes[nid].get("removing"):
                nm = node_remove(Handler.deps, nid)
                return self._send(200, {"ok": True, "removed": nm or nid})
            nodes[nid]["uninstalled"] = int(time.time())
            nodes[nid].pop("proc_status", None)
            nodes_save(Handler.deps["nodes_path"], nodes)
            (Handler.deps.get("node_snaps") or {}).pop(nid, None)
            (Handler.deps.get("node_seen") or {}).pop(nid, None)
            ev_append(Handler.deps["roster_path"], "node", nid, "Node uninstalled — kept for re-install",
                      nodes[nid].get("name", nid))
        return self._send(200, {"ok": True, "kept": nid})

    def _node_logs(self):
        if not _LIVE_REQS and not _RANGE_REQS:
            return self._send(404, {"ok": False, "error": "no such request", "code": "gone"})
        if not log_post_admits(_log_tok(self.headers.get("Authorization"))):
            return self._send(401, {"ok": False, "error": "invalid node token", "code": "unauthorized"})
        n = self._body_len(cap=LIVE_POST_MAX)
        if n is None:
            return
        raw = self.rfile.read(n) if n else b""
        if not LOG_POST_SLOTS.acquire(blocking=False):
            return self._send(503, {"ok": False, "error": "busy — send it again", "code": "busy"})
        try:
            try:
                if (self.headers.get("Content-Encoding") or "").strip().lower() == "gzip":
                    d = zlib.decompressobj(16 + zlib.MAX_WBITS)
                    raw = d.decompress(raw, LIVE_POST_RAW_MAX)
                    if d.unconsumed_tail:
                        return self._send(413, {"ok": False, "error": "request body too large", "code": "too_large"})
                body = json.loads(raw or b"{}")
            finally:
                LOG_POST_SLOTS.release()
            if not isinstance(body, dict):
                raise ValueError
            if body.get("id") in _RANGE_REQS and "seq" not in body:
                code, obj = range_absorb(body)
            elif body.get("id") in _RANGE_REQS:
                if not RANGE_POST_SLOTS.acquire(blocking=False):
                    return self._send(503, {"ok": False, "error": "busy — send it again", "code": "busy"})
                try:
                    code, obj = range_absorb(body)
                finally:
                    RANGE_POST_SLOTS.release()
            else:
                code, obj = live_absorb(body)
        except Exception:
            code, obj = 400, {"ok": False, "error": "invalid body", "code": "bad_request"}
        return self._send(code, obj)

    def _range_file(self, rid):
        got = range_download(rid)
        if got is None:
            return self._send(404, {"ok": False, **perr("no such download (made files are kept {v1} min)", v1=RANGE_KEEP // 60),
                                    "code": "gone"})
        path, raw, size, name = got
        gz = accepts_gzip(self.headers.get("Accept-Encoding"))
        try:
            f = open(path, "rb")
        except OSError:
            return self._send(404, {"ok": False, "error": "no such download", "code": "gone"})
        with f:
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Disposition", 'attachment; filename="%s"' % name)
            if gz:
                self.send_header("Content-Encoding", "gzip")
            self.send_header("Content-Length", str(size if gz else raw))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            with contextlib.suppress(BrokenPipeError, ConnectionError, OSError, EOFError, zlib.error):
                if gz:
                    shutil.copyfileobj(f, self.wfile, 65536)
                else:
                    with gzip.GzipFile(fileobj=f) as g:
                        shutil.copyfileobj(g, self.wfile, 65536)
                self.wfile.flush()

    def _node_whoami(self):
