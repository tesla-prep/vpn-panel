                lr["listen_port"] = np
                me.setdefault("ifaces", {}).setdefault(lr.get("iface"), {})["listen_port"] = np   # push via reconcile_ifaces
            ev_append(roster_path, "node", nid, "Re-ported mesh links (live)", me.get("name", nid))
        if "lan_share" in body:                 # NETWORKS P2: may this node's clients reach the private network it sits on?
            if body.get("lan_share") is False or (deps.get("panel_settings") or {}).get("show_node_lans") is False:
