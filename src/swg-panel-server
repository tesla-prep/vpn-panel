_TZ_BOOT = os.environ.get("TZ")          # what "" restores — read at import, before anything could change it
_TZ_NAME = re.compile(r"^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+){0,2}$")
_TZ_STATE = {"zone": "", "missing": "", "zones": None}   # the set zone in force · a stored one this server lacks · list


def _tz_dir():
    return os.environ.get("TZDIR") or "/usr/share/zoneinfo"


def tz_file(name):
    """The TZif file TZ=<name> loads on this server, or "". `right/` zones count leap seconds — time.localtime()
    would run ~27 s off the wall clock — and `posix/` repeats the tree, so neither is a zone to count days in."""
    if not isinstance(name, str) or not _TZ_NAME.match(name) or name.split("/")[0] in ("posix", "right"):
        return ""
    path = os.path.join(_tz_dir(), name)
    try:
        with open(path, "rb") as f:
            return path if f.read(4) == b"TZif" else ""
    except OSError:
        return ""


def tz_apply(name):
    """Count days in zone `name` from now on ("" = the zone this process started with). False, and nothing changed,
    when this server has no such zone."""
    if name:
        path = tz_file(name)
        if not path:
            return False
        os.environ["TZ"] = path
    elif _TZ_BOOT is None:
        os.environ.pop("TZ", None)
    else:
        os.environ["TZ"] = _TZ_BOOT
    time.tzset()
    _TZ_STATE["zone"], _TZ_STATE["missing"] = name, ""
    return True


def _tz_short(name):
    """The zone as a label: its place, with the region between them when there are three parts."""
    p = (name or "").replace("_", " ").split("/")
    return p[-1] + (" (%s)" % p[1] if len(p) == 3 else "")


def tz_view():
    """What /api/state says about the zone: the set one ("" = the server's own), its offset now, a stored zone this
    server has lost (then not in force — Settings says so), and what the server's own zone is called."""
    if "server" not in _TZ_STATE:
        n = (_TZ_BOOT or "").lstrip(":")
        if not n:
            with contextlib.suppress(OSError):
                n = os.path.normpath(os.path.join("/etc", os.readlink("/etc/localtime")))
        n = n[len(_tz_dir().rstrip("/")) + 1:] if n.startswith(_tz_dir().rstrip("/") + "/") else n
        _TZ_STATE["server"] = _tz_short(n) if _TZ_NAME.match(n) else ""
    lt = time.localtime()
    return {"zone": _TZ_STATE["zone"], "missing": _TZ_STATE["missing"], "server": _TZ_STATE["server"],
            "abbr": lt.tm_zone, "offset": lt.tm_gmtoff}


def tz_zones(browser=""):
    """GET /api/time-zones: the zones a Save accepts here — zone.tab's list, what a zone picker usually offers, each
    checked as a save checks it — and `browser`, the browser's own zone as THIS server names it: Chrome still reports
    legacy names (Asia/Calcutta, Europe/Kiev) that Debian 13 keeps only as link lines in tzdata.zi. Read once; the
    settings screen asks for it only when Display opens."""
    if _TZ_STATE["zones"] is None:
        names = set()
        with contextlib.suppress(OSError):
            with open(os.path.join(_tz_dir(), "zone.tab"), encoding="utf-8") as f:
                names = {p[2].strip() for p in (ln.split("\t") for ln in f if not ln.startswith("#")) if len(p) > 2}
        _TZ_STATE["zones"] = ["UTC"] * bool(tz_file("UTC")) + sorted(z for z in names if tz_file(z))
    alias = browser if isinstance(browser, str) and _TZ_NAME.match(browser) else ""
    found = alias if tz_file(alias) else ""
    if alias and not found:
        with contextlib.suppress(OSError):
            with open(os.path.join(_tz_dir(), "tzdata.zi"), encoding="utf-8") as f:
                link = next((p[1] for p in (ln.split() for ln in f if ln.startswith("L "))
                             if len(p) == 3 and p[2] == alias), "")
            found = link if tz_file(link) else ""
    return {"zones": _TZ_STATE["zones"], "browser": found}

