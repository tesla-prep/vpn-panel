_LF_FHEAD = struct.Struct("<4sHHIiQ")        # magic ver pad step utc_offset midnight_epoch
_LF_BKT = struct.Struct("<HHII")             # idx pad n crc — then n × slot u32 (sorted), n × rx u64, n × tx u64


def _ld_int(t):
    return t.tm_year * 10000 + t.tm_mon * 100 + t.tm_mday


def _ld_date(d):
    return _ldt.date(d // 10000, d // 100 % 100, d % 100)


def _ld_of(dt):
    return dt.year * 10000 + dt.month * 100 + dt.day


def _ld_next(d):
    return _ld_of(_ld_date(d) + _ldt.timedelta(days=1))


def _ld_prev(d):
    return _ld_of(_ld_date(d) - _ldt.timedelta(days=1))


def _ld_midnight(d):
    """The epoch of local 00:00 on day d, in the zone the panel counts days in (tz_apply)."""
    return int(time.mktime((d // 10000, d // 100 % 100, d % 100, 0, 0, 0, 0, 0, -1)))


def _ld_from_to(qs):
    """(from, to) as YYYYMMDD from ?from=&to= (YYYY-MM-DD) — the one grammar the ledger's windows (TrafficLedger._window)
    and the charts' custom windows (resolve_range) share; each clamps and orders them its own way."""
    g = lambda k: ((qs.get(k) or [""])[0] or "").strip()
    try:
        f = int(g("from").replace("-", "")); t = int(g("to").replace("-", ""))
        _ld_date(f); _ld_date(t)
    except (ValueError, TypeError):
        raise ValueError(perr("from and to must be dates, YYYY-MM-DD"))
    return f, t


def _ld_day(now):
    """(local date, UTC offset) for `now`. Buckets count from a day's LOCAL midnight — never _bucket_of(), which runs
    backwards across a DST fall-back (§3.3) — so a 25-hour day has room for its extra hour."""
    t = time.localtime(now)
    return _ld_int(t), t.tm_gmtoff


def _lnum(v):
    """A counter as a non-negative int, or None — a value that cannot be read is no observation, never a zero."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v if v >= 0 else None
    if isinstance(v, float):
        return int(v) if v >= 0 and v == v and v != float("inf") else None
    if isinstance(v, str) and v.isdigit():
        return int(v)
    return None


def _q_array(b):                 # the files are little-endian; the ledger refuses to start on any other host (_start)
    a = _larr.array("Q")
    a.frombytes(b)
    return a


def _i_array(b):
    a = _larr.array("I")
    a.frombytes(b)
    return a


def _ld_detail_cutoff(today):
    """The first day whose detail (fine file) Infinite history OFF keeps — one rule for the sweep and the read-out."""
    return _ld_of(_ld_date(today) - _ldt.timedelta(days=LEDGER_KEEP_DAYS))


def _ledger_index_ok(idx):
    """index.json holds a slot table: a dict whose `slots` are dicts with a pid."""
    return (isinstance(idx, dict) and isinstance(idx.get("slots"), list)
            and all(isinstance(s, dict) and s.get("pid") for s in idx["slots"]))


class _LedgerBusy(Exception):
    """A rolling-window query could not hold the writer still (TrafficLedger.totals) — answered 503, never a guess."""


class TrafficLedger:
    """One per panel process (LEDGER). ingest() runs at the end of every sync's history phase, outside _api_lock and in
    its own guard; everything it does is arithmetic on memory under the ledger's OWN lock — never _hrrd_lock, which
    gates every ring read in the panel (§5.1). Files are written by one background thread, at bucket closes."""

    def __init__(self):
        self.lock = threading.Lock()
        self._cv = threading.Condition()
        self._kick = False
        self.on = False
        self.why_off = "not started"
        self.dir = ""
        self.roster_path = ""
        self.step = LEDGER_STEP_DEFAULT
        self.step_next = LEDGER_STEP_DEFAULT   # the resolution setting: it takes over at the next local midnight (P2)
        self.infinite = True            # Infinite history (P2): off → fine files older than LEDGER_KEEP_DAYS go (day rows stay)
        self._sweep_due = False
        self._sweep_at = 0.0            # monotonic: a failed sweep waits until then
        self._day_mono = time.monotonic()   # when the ledger's day was entered — the sweep waits for the day to hold
        self._usage = (0.0, None)       # (monotonic, reply) — GET /api/stats-usage's cache
        self.slots = []                 # index.json: {pid, owner, name, on, since, until, o}
        self.had = set()                # every pid that ever had a slot — "never seen" is the ABSENCE from here (§5.4)
        self.open = {}                  # pid → its open slot
        self.C_rx = _larr.array("Q")    # per slot: credited cumulative bytes (base.bin)
        self.C_tx = _larr.array("Q")
        self.recs = {}                  # (node, iface, pid) → (last_rx, last_tx, ts, monotonic-or-None)
        self.newest = 0                 # the newest reading, panel clock — the clock gate's reference
        self.day, self.idx, self.off = 0, -1, 0
        self.fmid, self.foff = 0, 0     # the current day's midnight epoch and offset — its fine file's frame (header)
        self._flush_lock = threading.Lock()   # one flush at a time: the writer thread's, or the one at shutdown
        self._fseq = 0                  # flushes begun + ended: odd while one runs (readers: _consistent)
        self._tail_ok = True            # _c_at may sum a window start from the day's end (the gate turns it off to compare)
        self._retry_at = 0.0            # monotonic: after a failed write, nothing retries before this (no storm)
        self.fine = {}                  # slot → [rx, tx] credited in the current fine bucket
        self.map, self.deploys, self.owners, self.titles, self.mark = {}, set(), {}, {}, None
        self.onames = {}                # uid → the user's name, from the roster: a slot keeps its owner's LAST name (`on`)
        self.observed = False           # only a ledger that observed something writes (a second process never clobbers)
        self.seqs = {}                  # node → the arrival number of its newest snapshot ingested (ORDER, above)
        self.imports = set()            # index.json `imports`: deployments older than this ledger, each imported once
        self.fresh = False              # no index.json at start: the first map decides what `imports` holds
        self.d_index = self.d_base = self.prompt = False
        self.q_fine, self.q_day = [], []
        self.diag = self._diag_new()
        self._rowidx = {}               # day-file path → (size, mtime_ns, {date: (offset, nslots)})
        self._tails = {}                # append-file path → validated end (a torn tail is cut once, before an append)
        self._diag_w = 0

    @staticmethod
    def _diag_new():
        return {"v": 1, "held_for_clock": 0, "stale_snapshots": 0, "write_errors": 0, "last_error": "", "last_error_at": 0,
                "disk_pauses": 0, "ambiguous": 0, "base_recovered": "", "ifaces": {}, "pids": {}, "spans": {}}
    # ⚠️ a key missing from _diag_new() is DROPPED when diag.json is loaded — add any new persistent diag key here

    # ── paths ────────────────────────────────────────────────────────────────────────────────────────────────────
    def _p(self, name):
        return os.path.join(self.dir, name)

    def _day_path(self, d):
        return self._p("day-%04d-%02d.bin" % (d // 10000, d // 100 % 100))

    def _fine_path(self, d):
        return self._p("fine-%04d-%02d-%02d.bin" % (d // 10000, d // 100 % 100, d % 100))

    # ── start ────────────────────────────────────────────────────────────────────────────────────────────────────
    def start(self, deps, now=None, writer=True):
        """Load the ledger and start its writer (`writer=False`: the gates call flush() themselves). Never raises: a
        ledger that cannot load stays OFF — it neither reads nor writes, so a damaged history is left for a human rather
        than overwritten — and says why (debug dump)."""
        try:
            self._start(deps, int(time.time() if now is None else now), writer)
        except Exception as e:
            self.on, self.why_off = False, "could not start: %s" % e
            log(LOG_WARNING, "ledger: OFF — %s" % self.why_off)

    def _start(self, deps, now, writer=True):
        if sys.byteorder != "little" or _larr.array("I").itemsize != 4:
            self.on, self.why_off = False, "the ledger's files are little-endian with 32-bit slots; this host is not"
            log(LOG_WARNING, "ledger: OFF — %s" % self.why_off)
            return
        self.roster_path = deps["roster_path"]
        self.dir = os.path.join(os.path.dirname(self.roster_path) or ".", "history")
        os.makedirs(self.dir, mode=0o700, exist_ok=True)
        env = os.environ.get("SWG_LEDGER_STEP")          # rigs only: short buckets, to watch closes in minutes
        try:
            st = int(env) if env else int((deps.get("panel_settings") or {}).get("history_resolution") or LEDGER_STEP_DEFAULT)
        except (TypeError, ValueError):
            st = LEDGER_STEP_DEFAULT
        self.step = self.step_next = max(5, min(86400, st)) if env else (st if st in LEDGER_STEPS else LEDGER_STEP_DEFAULT)
        self.infinite = (deps.get("panel_settings") or {}).get("infinite_history") is not False
        self._sweep_due = not self.infinite
        try:
            idx = load_critical(self._p("index.json"), None, _ledger_index_ok)   # a corrupt primary: its newest GOOD backup
        except RuntimeError as e:                               # …and with none, the ledger stays off (never a fresh one)
            self.on, self.why_off = False, "index.json is unreadable and no backup is good (%s)" % e
            log(LOG_WARNING, "ledger: OFF — %s" % self.why_off)
            return
        if idx is None:                                        # ⚠️ MISSING IS NOT NEW when the history is there: load_critical
            for b in _state_backups(self._p("index.json")):    # takes a missing primary for a first install and restores only
                with contextlib.suppress(Exception):           # a corrupt one — but a new slot table over old day rows would
                    with open(b) as f:                         # renumber every slot, and each earlier window would be read
                        got = json.load(f)                     # against the wrong peers. Its newest good backup, else OFF —
                    if not _ledger_index_ok(got):              # and a backup that parses but holds no slot table is not good:
                        continue                               # the next older one is tried
                    idx = got
                    log(LOG_WARNING, "ledger: index.json is missing — recovered from %s" % b)
                    self.d_index = True
                    break
            if idx is None and any(f.startswith(("base.bin", "day-", "fine-")) for f in os.listdir(self.dir)):
                self.on, self.why_off = False, ("index.json is missing but the history it indexes is not — restore it, or "
                                                "move %s aside to start a new ledger" % self.dir)
                log(LOG_WARNING, "ledger: OFF — %s" % self.why_off)
                return
        if idx is not None and not _ledger_index_ok(idx):
            self.on, self.why_off = False, "index.json does not hold a slot table"
            log(LOG_WARNING, "ledger: OFF — %s" % self.why_off)
            return
        self.slots = list((idx or {}).get("slots") or [])
        self.fresh = idx is None                               # a new ledger: its first map fills `imports` (_rebuild)
        self.imports = {tuple(x) for x in ((idx or {}).get("imports") or []) if isinstance(x, list) and len(x) == 3}
        for n, s in enumerate(self.slots):
            self.had.add(s["pid"])
            if not s.get("until"):
                self.open[s["pid"]] = n
        dg = load_json(self._p("diag.json"), None)
        if isinstance(dg, dict) and dg.get("v") == 1:
            self.diag.update({k: v for k, v in dg.items() if k in self.diag})
        base = self._load_base()
        n = len(self.slots)
        row = self._newest_row()
        wide = max(len(base[1]) if base is not None else 0, len(row[1]) if row is not None else 0,
                   self._fine_width())                                     # the newest buckets name slots no row has yet
        if wide > n:                                           # base.bin, every day row and every fine bucket are written AFTER
            self.on = False                                    # index.json, so a table narrower than they are is OLDER than what
            self.why_off = ("index.json holds %d slots but the history it indexes has %d — it is older than those files. "
                            "Put back a newer index.json if one exists; if none does, move %s aside to start a new ledger"
                            % (n, wide, self.dir))             # it indexes: new slots would reuse their numbers, and every
            log(LOG_WARNING, "ledger: OFF — %s" % self.why_off)   # earlier day would be counted against the new peers
            return
        if base is not None:
            self.recs, crx, ctx, self.newest, bday, bidx, bstep = base
            self.C_rx, self.C_tx = crx[:n], ctx[:n]
        else:
            bday = bidx = bstep = 0
            if row is not None:                                # a lost base.bin: C from the newest closed day, so a day row is
                self.C_rx, self.C_tx = row[1][:n], row[2][:n]  # never above today's C (windows across it would go negative)
                if os.path.exists(self._p("base.bin")) or os.path.exists(self._p("base.bin.prev")):
                    self.diag["base_recovered"] = "C from the day row of %d; records re-baselined with zero credit" % row[0]
        while len(self.C_rx) < n:                              # slots opened after the last base.bin write: C = 0 (their opening is in index.json)
            self.C_rx.append(0); self.C_tx.append(0)
        d, off = _ld_day(now)
        self.off = off
        if bday and bday < d:                                  # the panel was down across midnight: the day it stopped in closes
            self._queue_day(bday, self.C_rx[:], self.C_tx[:], _ld_midnight(_ld_next(bday)))   # with its last C. Days with
        d = max(d, bday)                                       # no reading get NO row: a lookup falls back to the newest row
        fh = self._fine_head(self._fine_path(d)) if os.path.exists(self._fine_path(d)) else None   # before them — the same
        mid = fh[2] if fh else _ld_midnight(d)                 # numbers, bounded (a clock years ahead writes one row, not
        if fh:                                                 # thousands). The day keeps its file's frame — AND its step: a
            self.step = fh[0]                                  # resolution saved today takes over at the next midnight, so a
        elif d == bday and bstep and not env:                  # restart never cuts the rest of today's buckets off (they
            self.step = bstep                                  # would be dropped: the day's file keeps its own step)
        i = 0 if self.step >= 86400 else max(0, now - mid) // self.step
        if d == bday and bstep == self.step:                   # never behind the last bucket written — a bucket id counts in
            i = max(i, bidx)                                   # its own step, so it is never carried across a step change
        self.day, self.idx, self.fmid, self.foff = d, i, mid, off
        self.on, self.why_off = True, ""
        if writer:
            threading.Thread(target=self._writer, name="ledger-writer", daemon=True).start()
        log(LOG_INFO, "ledger: on — %s, %d slot(s), %d record(s), %ds buckets", self.dir, n, len(self.recs), self.step)

    # ── ingest (the hot path: every sync of every node) ───────────────────────────────────────────────────────────
    def ingest(self, nid, snap, now=None, mono=None, seq=None):
        if not self.on or not isinstance(snap, dict):
            return
        now = int(time.time() if now is None else now)
        mono = time.monotonic() if mono is None else mono
        mark = roster_mark(self.roster_path)                   # one stat() — the map is rebuilt only when this moves
        d, off = _ld_day(now)                                  # one localtime() per sync, outside the lock
        today = d                                              # the clock's day (d is reset to the ledger's below)
        with self.lock:
            if seq is not None:                                # ORDER (above): a snapshot older than this node's newest one
                if seq < self.seqs.get(nid, 0):                # is dropped — read now, its smaller counters would be a
                    self.diag["stale_snapshots"] += 1          # "restart" on every peer that moved
                    return
                self.seqs[nid] = seq
            if mark != self.mark:
                self._rebuild(mark, now)
            if now < self.newest - LEDGER_CLOCK_SLACK:         # §2.3 CLOCK GATE: nothing is credited, nothing advanced —
                self.diag["held_for_clock"] += 1               # the counters are cumulative, so the next reading carries it
                return
            if d <= self.day:                                  # the day the ledger is in keeps its own frame — the midnight its
                d, mid, off = self.day, self.fmid, self.off    # fine file was started at — so a zone change mid-day never moves
                step = self.step                               # the rest of that day's buckets (P0); a new day starts in the
            else:                                              # zone in force (one mktime a day) — and at the resolution in
                mid = _ld_midnight(d)                          # force: a change saved today applies from here (P2)
                step = self.step_next
            i = 0 if step >= 86400 else max(0, now - mid) // step
            self._advance(d, i, off, now, mid, step)
            m = self.map
            ifs = snap.get("interfaces")
            if isinstance(ifs, dict):
                for ifn, blk in ifs.items():
                    peers = blk.get("peers") if isinstance(blk, dict) else None
                    if not isinstance(peers, list):
                        continue
                    for p in peers:
                        if not isinstance(p, dict):
                            continue
                        pid = m.get((nid, ifn, p.get("public_key")))
                        if pid:
                            rx, tx = _lnum(p.get("rx_bytes")), _lnum(p.get("tx_bytes"))
                            if rx is not None and tx is not None:
                                self._observe(nid, ifn, pid, rx, tx, now, mono)
            for kind in ("wdtt", "csqtt"):
                insts = snap.get(kind)
                if not isinstance(insts, list):
                    continue
                for inst in insts:
                    ifn = inst.get("iface") if isinstance(inst, dict) else None
                    pws = inst.get("passwords") if ifn else None
                    if not isinstance(pws, dict):
                        continue
                    for pw, pe in pws.items():
                        pid = m.get((nid, ifn, pw))
                        if pid and isinstance(pe, dict):
                            rx, tx = _lnum(pe.get("up_bytes")), _lnum(pe.get("down_bytes"))   # up = client→server = rx
                            if rx is not None and tx is not None:
                                self._observe(nid, ifn, pid, rx, tx, now, mono)
            self._span(nid, now)
            self.newest = max(self.newest, now)
            kick = self.observed and (self.prompt or self.d_index or bool(self.q_fine or self.q_day)) and mono >= self._retry_at
            if (not kick and self._sweep_due and not self.infinite and self.observed and mono >= self._retry_at
                    and self._sweep_ready(today, mono)):
                kick = True                                    # an OFF sweep held back (a new day, a restart) runs once the day
                #                                               has held — at 1-day resolution nothing else would wake the writer
        if kick:
            self._wake()

    def _observe(self, nid, ifn, pid, rx, tx, now, mono):
        """§2.3, per record."""
        self.observed = True
        key = (nid, ifn, pid)
        s = self.open.get(pid)
        if s is None:
            if pid not in self.had:                            # D3: a pid never seen — its counter is an OPENING balance,
                self.open[pid] = self._new_slot(pid, now, rx, tx)   # credited to no bucket (first run, adoption, a take-over,
                self.recs[key] = (rx, tx, now, mono)                # a node transferred in)
                self.prompt = True
                self.imports.discard(key)
                return
            s = self.open[pid] = self._new_slot(pid, now, 0, 0)   # known, but its slot closed: a new one, no opening
        rec = self.recs.get(key)
        if rec is None:                                        # a known pid's NEW record (a new deployment, a node back, a lost
            self.recs[key] = (rx, tx, now, mono)               # base.bin): a baseline with ZERO credit, never an opening (§5.4)
            if key in self.imports:                            # — unless it is a deployment the ledger found when it was
                self.imports.discard(key)                      # created: nothing has counted its bytes either, so a peer on
                o = self.slots[s].setdefault("o", [0, 0])      # several servers imports every one of them at its first
                o[0] += rx; o[1] += tx                         # reading, not just the one it happened to be seen on first
                self.d_index = True
            else:
                ni = self._dpid(pid).setdefault("not_imported", [0, 0])
                ni[0] += rx; ni[1] += tx                       # what that baseline left uncounted, so the limit is visible
            self.prompt = True
            return
        lrx, ltx, lts, lmono = rec
        el = (mono - lmono) if lmono is not None else (now - lts)   # monotonic within this process: a clock step never shrinks it
        cap = int(LEDGER_MAX_BPS * max(el, LEDGER_FLOOR_S))
        reset = rx < lrx or tx < ltx                           # EITHER direction dropped: the counter restarted (§1.1)
        drx, dtx = (rx, tx) if reset else (rx - lrx, tx - ltx)
        if drx > cap or dtx > cap:
            drx, dtx = min(drx, cap), min(dtx, cap)
            self._diface(nid, ifn)["clamps"] += 1
            self._dpid(pid)["clamps"] = self._dpid(pid).get("clamps", 0) + 1
        if reset:
            di = self._diface(nid, ifn)
            di["resets"] += 1; di["last_reset_at"] = now
            self._dpid(pid)["resets"] = self._dpid(pid).get("resets", 0) + 1
        self.recs[key] = (rx, tx, now, mono)
        if drx or dtx:
            self.C_rx[s] += drx; self.C_tx[s] += dtx
            if self.step < 86400:
                f = self.fine.get(s)
                if f is None:
                    self.fine[s] = [drx, dtx]
                else:
                    f[0] += drx; f[1] += dtx
        self.d_base = True

    def _new_slot(self, pid, now, orx, otx):
        owner = self.owners.get(pid)
        self.slots.append({"pid": pid, "owner": owner, "name": self.titles.get(pid, ""), "on": self.onames.get(owner, ""),
                           "since": now, "until": None, "o": [orx, otx]})
        self.had.add(pid)
        self.C_rx.append(0); self.C_tx.append(0)
        self.d_index = self.d_base = True
        return len(self.slots) - 1

    def _close(self, s, now):
        rec = self.slots[s]
        rec["until"] = now
        rec["name"] = self.titles.get(rec["pid"], rec.get("name") or "")
        self.d_index = True

    def _rebuild(self, mark, now):
        """The (node, iface, credential) → pid map from the roster's targets, and the slot diff. Runs only when the roster
        changed. Read with load_json, never roster_load — that one repairs a corrupt primary by writing, and this runs on
        a sync thread outside _api_lock."""
        r = load_json(self.roster_path, None)
        if not isinstance(r, dict) or not isinstance(r.get("peers"), dict):
            return                                             # unreadable right now: keep the old map, try at the next sync
        claims, deploys, owners, titles = {}, set(), {}, {}
        for pid, p in r["peers"].items():
            if not isinstance(p, dict):
                continue
            owners[pid] = p.get("user_id") or None
            titles[pid] = str(p.get("title") or "")[:64]
            for t in p.get("targets") or []:
                if not isinstance(t, dict) or not isinstance(t.get("node"), str) or not isinstance(t.get("iface"), str) \
                        or not t["node"] or not t["iface"]:           # a hand-edited target (an int or a list) names no counter
                    continue
                cred = (p.get("wdtt_password") if _is_wdtt_target(t)
                        else p.get("csqtt_password") if _is_csqtt_target(t) else p.get("pubkey"))
                if not cred:                                   # an all-keyless peer's "" pubkey, a keyless target with no password
                    continue
                claims.setdefault((t["node"], t["iface"], cred), set()).add(pid)
                deploys.add((t["node"], t["iface"], pid))
        amb = [k for k, v in claims.items() if len(v) > 1]     # two peers claiming ONE counter: crediting either is a guess
        self.diag["ambiguous"] = len(amb)
        self.map = {k: next(iter(v)) for k, v in claims.items() if len(v) == 1}
        self.owners, self.titles, self.deploys = owners, titles, deploys
        us = r.get("users") if isinstance(r.get("users"), dict) else {}
        self.onames = {uid: str(u.get("name") or "")[:64] for uid, u in us.items() if isinstance(u, dict)}
        if self.fresh:                                         # the new ledger's first map: every deployment that exists now
            self.imports, self.fresh = set(deploys), False     # holds history nothing has counted — each is imported once, at
            self.d_index = True                                # its first reading (_observe)
        elif self.imports and not self.imports <= deploys:     # one deleted before its first reading leaves the set
            self.imports &= deploys
            self.d_index = True
        for pid, s in self.open.items():                       # an open slot's name follows its peer's title, so a deleted
            t = titles.get(pid)                                # peer keeps its LAST name — the one the operator knew it by —
            if t is not None and self.slots[s].get("name") != t:   # and its owner's name follows the user's, so a deleted
                self.slots[s]["name"] = t                      # user's slots still say whose they were
                self.d_index = True
            on = self.onames.get(self.slots[s].get("owner"))
            if on is not None and self.slots[s].get("on") != on:
                self.slots[s]["on"] = on
                self.d_index = True
        for pid, s in list(self.open.items()):
            if pid not in owners:                              # left the roster — by any of the five delete paths
                self._close(s, now); del self.open[pid]
            elif owners[pid] != self.slots[s].get("owner"):    # a new owner: the old slot keeps everything before now
                self._close(s, now)
                self.open[pid] = self._new_slot(pid, now, 0, 0)
        gone = [k for k in self.recs if k not in deploys]      # a deployment that no longer exists (node removed, target or
        for k in gone:                                         # interface deleted): its record goes — and a node that comes
            del self.recs[k]                                   # back gets a zero-credit baseline, never a second opening
        if gone:
            self.d_base = self.prompt = True
        self.mark = mark

    def _advance(self, d, i, off, now, mid, step=None):
        """Move to the bucket `now` falls in. Bucket ids never go backwards (a stepped-back clock keeps crediting the
        newest one). Passing local midnight takes C AS IT STOOD at the boundary — before this reading's own delta — as
        the day's row; a day with no reading at all gets none (a lookup reads the newest row before it: the same numbers)."""
        if (d, i) <= (self.day, self.idx):
            return
        self._close_bucket()
        if d > self.day:
            if self.day:
                self._queue_day(self.day, self.C_rx[:], self.C_tx[:], mid if d == _ld_next(self.day) else _ld_midnight(_ld_next(self.day)))
                self._sweep_due = self._sweep_due or not self.infinite   # OFF: yesterday's oldest detail leaves the 33 days
            self.fmid, self.foff = mid, off
            self._day_mono = time.monotonic()
            if step:
                self.step = step
        self.day, self.idx, self.off = d, i, off
        self.d_base = True

    def _close_bucket(self):
        if self.fine:
            self.q_fine.append((self.day, self.idx, self.step, self.foff, self.fmid, self.fine))
            self.fine = {}
            if len(self.q_fine) > LEDGER_FINE_QUEUE:           # a disk that stays full: the graph's oldest buckets go
                del self.q_fine[0]                             # first (counted) — memory stays bounded; C is untouched
                self.diag["fine_dropped"] = self.diag.get("fine_dropped", 0) + 1

    def _queue_day(self, d, crx, ctx, end):
        self.q_day.append((d, self.off, end, crx, ctx))

    def _span(self, nid, now):
        sp = self.diag["spans"].setdefault(nid, [])
        if sp and now - sp[-1][1] <= LEDGER_GAP_S:
            sp[-1][1] = max(sp[-1][1], now)
        else:
            sp.append([now, now])
            if len(sp) > LEDGER_SPANS_MAX:
                del sp[:len(sp) - LEDGER_SPANS_MAX]

    def _diface(self, nid, ifn):
        return self.diag["ifaces"].setdefault("%s|%s" % (nid, ifn), {"resets": 0, "last_reset_at": 0, "clamps": 0})

    def _dpid(self, pid):
        return self.diag["pids"].setdefault(pid, {})

    # ── the writer ───────────────────────────────────────────────────────────────────────────────────────────────
    def _wake(self):
        with self._cv:
            self._kick = True
            self._cv.notify()

    def _writer(self):
        while True:
            with self._cv:
                while not self._kick:
                    self._cv.wait()
                self._kick = False
            try:
                self.flush()
            except Exception as e:                             # never let the thread die — count it, the next close retries
                self._err("flush", e)

    def ingest_failed(self, e):
        """A bug in ingest: counted and logged (at most every 5 min), never raised into the sync (V33)."""
        self.diag["ingest_errors"] = self.diag.get("ingest_errors", 0) + 1
        self.diag["last_error"], self.diag["last_error_at"] = "ingest: %s" % e, int(time.time())
        now = time.time()
        if now - getattr(self, "_ing_said", 0) > 300:
            self._ing_said = now
            log(LOG_ERR, "ledger: ingest failed — %s (the sync's rings are written; the next snapshot carries the counters)" % e)

    def _err(self, what, e):
        self.diag["write_errors"] += 1
        self.diag["last_error"], self.diag["last_error_at"] = "%s: %s" % (what, e), int(time.time())
        now = time.time()
        if now - getattr(self, "_err_said", 0) > 300:          # logged, not a log line every close of a stuck disk
            self._err_said = now
            log(LOG_ERR, "ledger: %s failed — %s (kept in memory, retried at the next close)", what, e)

    def flush(self):
        """One pass of the write order: index.json → day rows → base.bin → fine appends → diag.json. A closed day's
        row goes before base.bin, which already names the next day: written after, a crash between the two lost the day
        for good (a re-close is harmless — the first row stands). Whatever fails goes back to the front of its queue,
        nothing later in the order is written past it, and nothing retries before the next close (no storm)."""
        with self._flush_lock:
            self._fseq += 1                                    # odd while a flush runs: readers read again (_consistent)
            try:
                if self._flush():
                    self._retry_at = 0.0
            finally:
                self._fseq += 1

    def shutdown(self):
        """SIGTERM: the open bucket is closed as it stands and everything is written, so a graceful restart neither
        moves its last partial bucket into the next one nor lets the next day take the rest of this one. A bucket the
        restart lands inside is written twice, once each side of it; readers sum them."""
        if not self.on or not self._flush_lock.acquire(timeout=5):   # a writer stuck on a hung disk: stop anyway
            return
        self._fseq += 1
        try:
            self._diag_w = 0                                   # the spans too: they are the gaps every reply carries
            self._flush(closing=True)
        finally:
            self._fseq += 1
            self._flush_lock.release()

    def _flush(self, closing=False):
        day = self._sweep_ok() if self._sweep_due and not self.infinite and self.on and self.observed and not closing else 0
        if day:                                                # FIRST: it only frees space, so a full disk (the case OFF is
            self._sweep_due = False                            # most needed for) must not hold it back. Only a process that
            try:                                               # observed (a second panel on this state dir never deletes),
                self._sweep(day if isinstance(day, int) and day > 19700101 else self.day)   # never on the SIGTERM flush
            except Exception as e:
                self._err("sweep", e)
                self._sweep_due = True
                self._sweep_at = time.monotonic() + 300        # a disk that keeps refusing: once per 5 min, not every sync
        with self.lock:
            if closing:                                        # in the same lock section as the snapshot: a sync landing
                self._close_bucket()                           # between the two would reach base.bin and never the graph
                self.d_base = self.d_base or self.observed
            if not self.observed:                              # a process that observed nothing never writes (a second
                return True                                    # panel on this state dir must not replace base.bin) — nor fails
            ix = (json.dumps({"v": 1, "slots": self.slots, **({"imports": sorted(self.imports)} if self.imports else {})},
                             separators=(",", ":")) if self.d_index else None)
            snap = ((dict(self.recs), self.C_rx[:], self.C_tx[:], self.newest, self.day, self.idx, self.step, len(self.slots))
                    if self.d_base else None)
            qf, self.q_fine = self.q_fine, []
            qd, self.q_day = self.q_day, []
            self.d_index = self.d_base = self.prompt = False

        def requeue(ix_back, base_back, qf_rest, qd_rest):
            with self.lock:
                self.d_index = self.d_index or ix_back
                self.d_base = self.d_base or base_back
                self.q_fine[:0] = qf_rest
                self.q_day[:0] = qd_rest
                self._retry_at = time.monotonic() + max(30, min(self.step, 300))   # the pause first, then the prompt:
                self.prompt = True                             # retried after it even if nothing else happens
            return False

        if not stats_disk_ok(self.dir):                        # the history shares the disk with users.json: it stops first
            self.diag["disk_pauses"] += 1
            return requeue(bool(ix), bool(snap), qf, qd)
        if ix:
            try:
                save_critical(self._p("index.json"), ix + "\n", mode=0o600)
            except Exception as e:
                self._err("index.json", e)
                return requeue(True, bool(snap), qf, qd)
        for n, dr in enumerate(qd):
            try:
                self._append_day(dr)
            except Exception as e:
                self._err("day", e)
                return requeue(False, bool(snap), qf, qd[n:])
        if snap:
            try:
                self._write_base(snap)
            except Exception as e:
                self._err("base.bin", e)
                return requeue(False, True, qf, [])
        for n, fb in enumerate(qf):
            try:
                self._append_fine(fb)
            except Exception as e:
                self._err("fine", e)
                return requeue(False, False, qf[n:], [])
        if time.time() - self._diag_w >= 60 or qd:
            with contextlib.suppress(Exception):
                with self.lock:
                    js = json.dumps(self.diag, separators=(",", ":"))
                atomic_write(self._p("diag.json"), js + "\n", mode=0o600)
                self._diag_w = time.time()
        return True

    # ── Infinite history (P2) ──────────────────────────────────────────────────────────────────────────────────
    def configure(self, ps):
        """A settings save: the resolution takes over at the next local midnight (today's file keeps its step, so none
        of today's buckets is dropped); Infinite history turned off sweeps the old detail now, then once a day."""
        try:
            st = int(ps.get("history_resolution") or LEDGER_STEP_DEFAULT)
        except (TypeError, ValueError):
            st = LEDGER_STEP_DEFAULT
        inf = ps.get("infinite_history") is not False
        with self.lock:
            if not os.environ.get("SWG_LEDGER_STEP"):          # rigs: the step is the environment's (the switch is not)
                self.step_next = st if st in LEDGER_STEPS else LEDGER_STEP_DEFAULT
            off_now = self.infinite and not inf
            self.infinite = inf
            if off_now:
                self._sweep_due = True
            self._usage = (0.0, None)
        if off_now and self.on:
            self._wake()

    def _old_detail(self, today):
        """[(day, path, bytes)] — the FINE files of days older than LEDGER_KEEP_DAYS: what the OFF sweep deletes, and what
        the read-out (and so the confirm) names. ⚠️ NEVER A DAY ROW: they are cumulative and tiny (16 B per slot a day, ~58
        MB a year at 10,000 peers, against ~3.4 GB for hourly detail); kept, every total for every period stays exact for
        good and an old day still draws as one bar — nothing to clamp, no gap to report, no file rewritten under a reader.
        (Deleting them too was built first, 2026-09-24: it needed a floor row, a persisted purge span, clamped windows and
        re-reading readers, and three review rounds kept finding wrong numbers in it.)"""
        cutoff = _ld_detail_cutoff(today)
        out = []
        for fn in sorted(os.listdir(self.dir)):
            m = re.match(r"^fine-(\d{4})-(\d{2})-(\d{2})\.bin$", fn)
            if m:
                d = int(m.group(1) + m.group(2) + m.group(3))
                if d < cutoff:
                    with contextlib.suppress(FileNotFoundError):
                        out.append((d, self._p(fn), os.path.getsize(self._p(fn))))
        return out

    def _sweep_ready(self, today, mono):
        """⚠️ DELETION IS FOR GOOD, so the sweep runs only on a day the clock has HELD: the ledger's day equals the real
        clock's (`today`), and has for 10 minutes (monotonic). A clock that jumped ahead for one sync moves the ledger's
        day, and it never goes back — so until real time reaches that day nothing is deleted (late, never wrong)."""
        return mono >= self._sweep_at and self.day == today and mono - self._day_mono >= LEDGER_SWEEP_HOLD_S

    def _sweep_ok(self):
        """The day the sweep may delete by, checked NOW and held under the lock (0 = not yet) — _sweep deletes by exactly
        this day, so a sync that moves the ledger's day between the check and the deletion cannot move the cutoff."""
        with self.lock:
            return self.day if self._sweep_ready(_ld_day(time.time())[0], time.monotonic()) else 0

    def _sweep(self, today):
        """Infinite history OFF (§6): delete the old detail _old_detail names. Lifetimes (C + o) and every day row stay.
        `today` is the day _sweep_ok checked the clock had held."""
        gone = self._old_detail(today)
        for _d, path, _b in gone:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)
            self._tails.pop(path, None)
        if gone:
            self._usage = (0.0, None)
            log(LOG_INFO, "ledger: Infinite history is off — the detail of %d day(s) older than %d days deleted", len(gone), LEDGER_KEEP_DAYS)

    def usage(self, now=None):
        """GET /api/stats-usage — MEASURED: one directory walk over the history, cached LEDGER_USAGE_TTL s. The projection
        is the observed bytes a day of the last closed days' fine files plus a day row, falling back to 20 B × open slots ×
        buckets a day before there is a closed day. `sweep_*`: what turning Infinite history off deletes."""
        mono = time.monotonic()
        c = self._usage
        if c[1] is not None and mono - c[0] < LEDGER_USAGE_TTL:
            return c[1]
        now = int(time.time() if now is None else now)
        today = _ld_day(now)[0]
        led, fines = 0, []
        with contextlib.suppress(OSError):
            for e in os.scandir(self.dir):
                if not e.is_file(follow_symlinks=False):
                    continue
                sz = e.stat(follow_symlinks=False).st_size
                led += sz
                m = re.match(r"^fine-(\d{4})-(\d{2})-(\d{2})\.bin$", e.name)
                if m:                                          # the projection's recent days
                    fines.append((int(m.group(1) + m.group(2) + m.group(3)), sz))
        with self.lock:
            nslots, nopen, step, step_next = len(self.slots), len(self.open), self.step, self.step_next
        closed = sorted((d, sz) for d, sz in fines if d < today)[-7:]
        if step_next >= 86400:                                 # 1-day resolution from tomorrow: no fine files at all
            per_fine, basis = 0, "observed" if step >= 86400 else "estimate"
        elif closed and step < 86400:                          # the last closed days' files, scaled to the step in force next
            per_fine = sum(sz for _d, sz in closed) // len(closed) * step // step_next
            basis = "observed" if step == step_next else "scaled"
        else:
            per_fine, basis = 20 * nopen * (86400 // step_next), "estimate"
        per_day = per_fine + 16 * nslots + _LD_ROW.size
        try:
            free = shutil.disk_usage(self.dir).free
        except OSError:
            free = 0
        cutoff = _ld_detail_cutoff(today)                      # the sweep's own rule (_old_detail), on this same walk
        old = [sz for d, sz in fines if d < cutoff]
        out = {"on": self.on, "why_off": self.why_off, "dir": self.dir, "bytes_ledger": led, "free_bytes": free,
               "active_slots": nopen, "resolution_next": step_next, "per_day_bytes": per_day, "per_year_bytes": per_day * 365,
               "basis": basis, "infinite": self.infinite, "sweep_bytes": sum(old), "sweep_days": len(old)}
        self._usage = (mono, out)
        return out

    def _write_base(self, snap):
        recs, crx, ctx, newest, day, idx, step, nslots = snap
        names, nb = {}, bytearray()

        def nm(s):
            k = names.get(s)
            if k is None:
                b = str(s).encode("utf-8")[:65535]
                k = names[s] = len(names)
                nb.extend(struct.pack("<H", len(b))); nb.extend(b)
            return k
        rb = bytearray(_LB_REC.size * len(recs))
        o = 0
        for (nid, ifn, pid), (rx, tx, ts, _m) in recs.items():
            _LB_REC.pack_into(rb, o, nm(nid), nm(ifn), nm(pid), rx, tx, ts & 0xFFFFFFFF)
            o += _LB_REC.size
        cb = _larr.array("Q", bytes(16 * len(crx)))
        cb[0::2] = crx; cb[1::2] = ctx
        body = bytes(nb) + cb.tobytes() + bytes(rb)
        head = _LB_HEAD.pack(_LB_MAGIC, _LB_VER, 0, int(time.time()), newest, day, max(idx, 0), step,
                             len(crx), len(names), len(recs), _lzlib.crc32(body))
        atomic_write(self._p("base.bin"), head + body, keep_prev=True)

    def _load_base(self):
        """(recs, C_rx, C_tx, newest, day, idx, step) from base.bin, else base.bin.prev, else None."""
        for fn in ("base.bin", "base.bin.prev"):
            try:
                with open(self._p(fn), "rb") as f:
                    data = f.read()
                mg, ver, _fl, _w, newest, day, idx, bstep, ns, nn, nr, crc = _LB_HEAD.unpack_from(data, 0)
                body = memoryview(data)[_LB_HEAD.size:]
                if mg != _LB_MAGIC or ver != _LB_VER or _lzlib.crc32(body) != crc:
                    raise ValueError("bad header or checksum")
                o, names = 0, []
                for _ in range(nn):
                    (ln,) = struct.unpack_from("<H", body, o)
                    names.append(bytes(body[o + 2:o + 2 + ln]).decode("utf-8")); o += 2 + ln
                cb = _q_array(bytes(body[o:o + 16 * ns])); o += 16 * ns
                if len(cb) != 2 * ns:
                    raise ValueError("short C table")
                recs = {}
                for nidx, iidx, pidx, rx, tx, ts in _LB_REC.iter_unpack(bytes(body[o:o + _LB_REC.size * nr])):
                    recs[(names[nidx], names[iidx], names[pidx])] = (rx, tx, ts, None)
                if len(recs) != nr:
                    raise ValueError("short record table")
                if fn != "base.bin":
                    self.diag["base_recovered"] = "base.bin unreadable — loaded base.bin.prev"
                return recs, cb[0::2], cb[1::2], newest, day, idx, bstep
            except FileNotFoundError:
                continue
            except Exception as e:
                log(LOG_ERR, "ledger: %s unreadable (%s)", fn, e)
                continue
        return None

    def _valid_end(self, path, magic):
        """Where the valid part of an append-only file ends. A torn tail (a crash mid-append) is cut, once, so the next
        append never lands after garbage the reader stops at; a file whose HEADER is not ours is moved aside rather than
        appended to — the reader would reject everything after it."""
        end = self._tails.get(path)
        if end is None:
            try:
                sz = os.path.getsize(path)
            except FileNotFoundError:
                return 0
            if sz < len(magic):                                # its first write never finished (a full disk): nothing in it
                os.truncate(path, 0)                           # was ever valid, so it starts again — not a "corrupt" file
                self._tails[path] = 0                          # moved aside at every retry
                return 0
            with open(path, "rb") as f:
                h = f.read(4)
            if h != magic:
                os.replace(path, "%s.corrupt.%d" % (path, int(time.time())))
                log(LOG_WARNING, "ledger: %s had no valid header — moved aside, a new file starts" % path)
                self._tails[path] = 0
                return 0
            verdict = "ok"
            if magic == _LD_MAGIC:
                with open(path, "rb") as f:
                    data = f.read()
                _rows, end, verdict = self._walk_rows(path, data)
            else:
                end = self._scan_end(path)
            if verdict == "corrupt":                           # ⚠️ day rows are the totals, kept for good: never cut past what
                keep = "%s.corrupt.%d" % (path, int(time.time()))   # cannot be read — the whole file is kept aside for a
                os.replace(path, keep)                         # recovery, and its readable rows go on in a new one
                atomic_write(path, data[:end])
                self._rowidx.pop(path, None)
                log(LOG_WARNING, "ledger: %s holds a row that cannot be ours at byte %d — kept as %s; its %d readable byte(s) go on", path, end, keep, end)
            elif end < sz:
                os.truncate(path, end)
                log(LOG_WARNING, "ledger: %s ended in a torn record — cut back to %d bytes", path, end)
            self._tails[path] = end
        return end

    def _walk_rows(self, path, data):
        """One month file's rows, walked once — the readers (_day_rows) and the append path (_valid_end) read it the same
        way. → ({date: (offset, nslots)}, end, verdict): verdict "ok" (walked to the end), "torn" (a plausible row cut off
        by the end — a crash mid-append, the only thing ever cut) or "corrupt" (a header that cannot be ours).
        ⚠️ A row header carries no checksum (the CRC covers its C table), so it is judged: its date is in this file's
        month and its width never shrinks (slots are never removed). Without that a bit flip in `nslots` read as a torn
        tail — and the cut deleted every later day for good — and a zero-filled tail (d=0, ns=0, crc32(b"")=0) passed as
        a row. A row whose C table fails its checksum is SKIPPED, never the place a file is cut."""
        m = re.search(r"day-(\d{4})-(\d{2})\.bin$", path)
        ym = int(m.group(1) + m.group(2)) if m else None
        rows, prev = {}, 0
        o = _LD_FHEAD.size if data[:4] == _LD_MAGIC and len(data) >= _LD_FHEAD.size else 0
        if not o:
            return rows, 0, "corrupt" if data else "ok"
        while o < len(data):
            if o + _LD_ROW.size > len(data):
                return rows, o, "torn"
            d, _off, _end, ns, crc = _LD_ROW.unpack_from(data, o)
            if (ym is not None and d // 100 != ym) or ns < prev or ns > max(prev, len(self.slots)) + LEDGER_ROW_GROWTH:
                return rows, o, "corrupt"
            p1 = o + _LD_ROW.size + 16 * ns
            if p1 > len(data):                                 # past the end: torn — unless a real row follows (a flipped
                return rows, o, ("corrupt" if self._row_after(data, o, ym) else "torn")   # width in the middle, not a crash)
            if _lzlib.crc32(data[o + _LD_ROW.size:p1]) == crc:   # a damaged C table: skipped here, once, so a total and a
                rows.setdefault(d, (o, ns))                    # series never read two versions of one day; a date closed
            prev, o = ns, p1                                   # twice: the first row stands
        return rows, o, "ok"

    @staticmethod
    def _row_after(data, o, ym):
        """Is there a whole, checksummed row of this month anywhere after offset o? A crash only ever tears the LAST row,
        so one found means the row at o is damaged, not torn. Searched by the date bytes (31 candidates), not byte by byte."""
        if ym is None:
            return False
        for day in range(1, 32):
            pat = struct.pack("<I", ym * 100 + day)
            i = data.find(pat, o + 1)
            while i != -1:
                if i + _LD_ROW.size <= len(data):
                    _d, _off, _end, ns, crc = _LD_ROW.unpack_from(data, i)
                    p1 = i + _LD_ROW.size + 16 * ns
                    if ns and p1 <= len(data) and _lzlib.crc32(data[i + _LD_ROW.size:p1]) == crc:
                        return True
                i = data.find(pat, i + 1)
        return False

    def _scan_end(self, path):
        """The end of the last complete record: rows (day files) or buckets (fine files), lengths and checksums read."""
        with open(path, "rb") as f:
            data = f.read()
        if data[:4] == _LF_MAGIC:
            end = _LF_FHEAD.size if len(data) >= _LF_FHEAD.size else 0
            for _i, _n, e, _c in self._fine_buckets(path, want=False, data=data):
                end = e
            return end
        return self._walk_rows(path, data)[1]

    def _append(self, path, head, rec):
        end = self._valid_end(path, head[:4])
        data = (head if end == 0 else b"") + rec
        fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
        try:
            os.lseek(fd, end, os.SEEK_SET)
            mv = memoryview(data)
            try:
                while mv:                                      # ⚠️ os.write may write LESS than asked — a disk filling up
                    n = os.write(fd, mv)                       # mid-record. Taken as whole, the next record would land past
                    if n <= 0:                                 # a hole, and every one after it would be unreadable.
                        raise OSError(errno.EIO, "short write to %s" % path)
                    mv = mv[n:]
            except BaseException:
                self._tails.pop(path, None)                    # a record cut short is re-validated, and cut, before the next
                raise                                          # append (_valid_end)
            try:
                os.fsync(fd)
            except BaseException:                              # written whole but not known durable: the retry rewrites this
                self._tails[path] = end                        # record IN PLACE — a re-scan would find it complete and append
                raise                                          # a second copy (a new file's end was never cached at all)
        finally:
            os.close(fd)
        self._tails[path] = end + len(data)

    def _append_fine(self, fb):
        d, i, step, off, mid, deltas = fb
        slots = sorted(deltas)
        cols = (_larr.array("I", slots), _larr.array("Q", (deltas[s][0] for s in slots)),
                _larr.array("Q", (deltas[s][1] for s in slots)))
        payload = b"".join(c.tobytes() for c in cols)
        rec = _LF_BKT.pack(i, 0, len(slots), _lzlib.crc32(payload)) + payload
        path = self._fine_path(d)
        head = _LF_FHEAD.pack(_LF_MAGIC, _LF_VER, 0, step, off, mid)
        hd = self._fine_head(path) if os.path.exists(path) else None
        if hd and hd[0] != step:                               # the resolution changed mid-day: this day's file keeps its own
            self.diag["fine_dropped"] = self.diag.get("fine_dropped", 0) + 1   # step; the bucket is the graph, not the truth
            return
        self._append(path, head, rec)

    def _append_day(self, dr):
        d, off, end, crx, ctx = dr
        if self._row_at_exact(d) is not None:                  # already closed (a restart re-closing a day): first one wins —
            self._tails.pop(self._day_path(d), None)           # and a row written whole whose fsync failed is ON disk: its
            return                                             # tail was rewound for a rewrite, so the next row must not land on it
        cb = _larr.array("Q", bytes(16 * len(crx)))
        cb[0::2] = crx; cb[1::2] = ctx
        payload = cb.tobytes()
        rec = _LD_ROW.pack(d, off, end, len(crx), _lzlib.crc32(payload)) + payload
        self._append(self._day_path(d), _LD_FHEAD.pack(_LD_MAGIC, _LD_VER, 0), rec)
        self._rowidx.pop(self._day_path(d), None)

    # ── readers ──────────────────────────────────────────────────────────────────────────────────────────────────
    def _day_rows(self, path):
        """{date: (offset, nslots)} for one month file — cached until the file changes."""
        try:
            st = os.stat(path)
        except OSError:
            return {}
        c = self._rowidx.get(path)
        if c and c[0] == st.st_size and c[1] == st.st_mtime_ns:
            return c[2]
        with open(path, "rb") as f:
            data = f.read()
        rows = self._walk_rows(path, data)[0]                  # the same walk the append path uses
        self._rowidx[path] = (st.st_size, st.st_mtime_ns, rows)
        return rows

    def _read_row(self, path, o, ns):
        with open(path, "rb") as f:
            f.seek(o)
            rh = f.read(_LD_ROW.size)
            payload = f.read(16 * ns)
        d, _off, _end, n2, crc = _LD_ROW.unpack(rh)
        if n2 != ns or len(payload) != 16 * ns or _lzlib.crc32(payload) != crc:
            return None
        cb = _q_array(payload)
        return d, cb[0::2], cb[1::2]

    def _read_row_slots(self, path, o, ns, want):
        """(Σrx, Σtx, end) of the `want` slots of one day row — positioned reads of 16 B each (a slot past the row's width
        had C = 0), no checksum over the whole table. None when the row header does not match."""
        with open(path, "rb") as f:
            f.seek(o)
            rh = f.read(_LD_ROW.size)
            if len(rh) < _LD_ROW.size:
                return None
            _d, _off, end, n2, _crc = _LD_ROW.unpack(rh)
            if n2 != ns:
                return None
            rx = tx = 0
            for s in want:
                if s < ns:
                    f.seek(o + _LD_ROW.size + 16 * s)
                    b = f.read(16)
                    if len(b) == 16:
                        a, c = struct.unpack("<QQ", b)
                        rx += a; tx += c
        return rx, tx, end

    def _row_end(self, d):
        path = self._day_path(d)
        r = self._day_rows(path).get(d)                        # the row on disk first — the one _row_at_or_before reads
        if r is None:
            return (self._pending_rows().get(d) or (0, 0, 0))[2]
        with open(path, "rb") as f:
            f.seek(r[0])
            rh = f.read(_LD_ROW.size)
        return _LD_ROW.unpack(rh)[2] if len(rh) == _LD_ROW.size else 0

    def _row_at_exact(self, d):
        path = self._day_path(d)
        r = self._day_rows(path).get(d)
        return None if r is None else self._read_row(path, *r)

    def _pending_rows(self):
        """Closed days whose row is not on disk yet (a failed or paused write): {date: (C_rx, C_tx, end)}. Readers take them
        as if written — a day's row held back must not hand its traffic to the next day."""
        with self.lock:
            return {dr[0]: (dr[3], dr[4], dr[2]) for dr in self.q_day}

    def _row_at_or_before(self, d):
        """(date, C_rx, C_tx) of the newest closed day ≤ d, or None — C before the ledger's first closed day is 0."""
        pend = self._pending_rows()
        pd = max((x for x in pend if x <= d), default=0)
        got = self._row_on_disk(d)
        if pd and (got is None or got[0] < pd):
            return pd, pend[pd][0], pend[pd][1]
        return got

    def _row_on_disk(self, d):
        try:
            files = sorted((f for f in os.listdir(self.dir) if f.startswith("day-") and f.endswith(".bin")), reverse=True)
        except OSError:
            return None
        for fn in files:
            path = self._p(fn)
            rows = self._day_rows(path)
            for rd in sorted(rows, reverse=True):
                if rd <= d:
                    got = self._read_row(path, *rows[rd])
                    if got is not None:
                        return got
        return None

    def _newest_row(self):
        return self._row_at_or_before(99991231)

    def _fine_buckets(self, path, want=True, data=None):
        """Yield (idx, n, end_offset, (slots, rx, tx) or None) per valid bucket; stops at the first torn one. `want`: decode
        the columns (True), none (False), or only for the buckets whose idx it accepts (a function)."""
        if data is None:
            with open(path, "rb") as f:
                data = f.read()
        if len(data) < _LF_FHEAD.size or data[:4] != _LF_MAGIC:
            return
        o = _LF_FHEAD.size
        while o + _LF_BKT.size <= len(data):
            i, _pad, n, crc = _LF_BKT.unpack_from(data, o)
            p0 = o + _LF_BKT.size
            p1 = p0 + 20 * n
            if p1 > len(data) or _lzlib.crc32(data[p0:p1]) != crc:
                return
            cols = None
            if want is True or (callable(want) and want(i)):
                cols = (_i_array(data[p0:p0 + 4 * n]), _q_array(data[p0 + 4 * n:p0 + 12 * n]), _q_array(data[p0 + 12 * n:p1]))
            yield i, n, p1, cols
            o = p1

    def _fine_width(self):
        """1 + the highest slot the newest fine file's valid buckets name (0 for none). The newest file ON DISK, not
        today's: a restart after midnight, or a clock behind the ledger's day, would read an empty one. A bucket's
        slot column is sorted, so only its last id is read."""
        names = sorted(f for f in os.listdir(self.dir) if f.startswith("fine-") and f.endswith(".bin"))
        if not names:
            return 0
        try:
            with open(self._p(names[-1]), "rb") as f:
                data = f.read()
        except OSError:
            return 0
        w = 0
        for _i, n, e, _c in self._fine_buckets(None, want=False, data=data):
            if n:
                p0 = e - 20 * n
                w = max(w, struct.unpack_from("<I", data, p0 + 4 * (n - 1))[0] + 1)
        return w

    def _fine_head(self, path):
        try:
            with open(path, "rb") as f:
                h = f.read(_LF_FHEAD.size)
        except FileNotFoundError:                              # deleted by the OFF sweep since the caller looked
            return None
        if len(h) < _LF_FHEAD.size:
            return None
        mg, _v, _p, step, off, mid = _LF_FHEAD.unpack(h)
        return (step, off, mid) if mg == _LF_MAGIC else None

    # ── queries ──────────────────────────────────────────────────────────────────────────────────────────────────
    def _window(self, qs, now):
        """(from, to, rangeKey) as local dates from ?range=today|7d|30d|month|all|custom&from=&to= (YYYY-MM-DD)."""
        g = lambda k: ((qs.get(k) or [""])[0] or "").strip()
        today = _ld_day(now)[0]
        rng = g("range") or "month"
        if rng == "custom" or (g("from") and g("to")):
            f, t = _ld_from_to(qs)
            if f > t:
                raise ValueError(perr("from must not be after to"))
            rk = "custom:%d-%d" % (f, t)
            f, t = max(f, 19700101), min(t, today)             # a series walks day by day: never from year 1
            if f > t:
                raise ValueError(perr("from and to must include a day between 1970 and today"))
            return f, t, rk
        if rng == "today":
            return today, today, rng
        if rng in ("7d", "30d"):
            return _ld_of(_ld_date(today) - _ldt.timedelta(days=int(rng[:-1]) - 1)), today, rng
        if rng == "month":
            return today // 100 * 100 + 1, today, rng
        if rng == "all":
            return 19700101, today, rng
        raise ValueError(perr("range must be today, 7d, 30d, month, all or custom"))

    def _cum(self, d, live):
        if d >= live[0]:
            return live[1], live[2]
        row = self._row_at_or_before(d)
        return (row[1], row[2]) if row else (_larr.array("Q"), _larr.array("Q"))

    def _spans(self):
        """A copy of the observed spans, taken under the lock — a first sync adds a node while a query iterates."""
        with self.lock:
            return {k: [list(x) for x in v] for k, v in (self.diag.get("spans") or {}).items()}

    def _gaps(self, since, until, spans, nodes=None):
        out = {}
        for nid, sp in spans.items():
            if nodes is not None and nid not in nodes:
                continue
            g, cur = [], since
            for a, b in sp:
                if b < since or a > until:
                    continue
                if a - cur > LEDGER_GAP_S:
                    g.append([cur, a])
                cur = max(cur, b)
            if until - cur > LEDGER_GAP_S:
                g.append([cur, until])
            if g:
                out[nid] = g
        return out

    def _c_at(self, ts, live, cur, qall):
        """C per slot at the start of the fine bucket that holds `ts`, and that start: the row of the day before plus the
        day's buckets before it. A day with no detail (1-day resolution, swept by OFF, before history) → its midnight.
        Read under _consistent(), so every closed bucket is either on disk or in q_fine — never between the two. `live`
        (C), `cur` (the open bucket) and `qall` (the queue) come from ONE lock section of the caller's: bytes credited
        between two sections would count at the window's start only."""
        d = min(_ld_day(ts)[0], live[0])
        row = self._row_at_or_before(_ld_prev(d))
        rx = _larr.array("Q", row[1] if row else []); tx = _larr.array("Q", row[2] if row else [])
        qf = [(q[1], q[2], q[3], q[4]) for q in qall if q[0] == d]
        fp = self._fine_path(d)
        head = self._fine_head(fp) if os.path.exists(fp) else None
        if head:
            step, mid = head[0], head[2]
        elif d == cur[0] and cur[2] < 86400:
            step, mid = cur[2], cur[3]
        elif qf:
            step, mid = qf[0][1], qf[0][2]
        else:
            return rx, tx, _ld_midnight(d)
        k = max(0, (int(ts) - mid) // step)
        last = cur[1] if d == cur[0] else 86400 // step
        end = None
        if self._tail_ok and last - k < k:
            if d == live[0]:
                end = (live[1], live[2])
            else:
                r_d = self._row_at_or_before(d)
                end = (r_d[1], r_d[2]) if r_d and r_d[0] == d else None
        tail = end is not None
        if tail:
            rx, tx = list(end[0]), list(end[1])
        sgn = -1 if tail else 1
        inside = (lambda i: i >= k) if tail else (lambda i: i < k)

        def add(s, a, b):
            if s >= len(rx):
                rx.extend([0] * (s + 1 - len(rx))); tx.extend([0] * (s + 1 - len(tx)))
            rx[s] += sgn * a; tx[s] += sgn * b
        if head:
            try:
                for i, n, _e, cols in self._fine_buckets(fp, want=inside):
                    if cols:
                        sl, brx, btx = cols
                        for j in range(n):
                            add(sl[j], brx[j], btx[j])
            except FileNotFoundError:                          # swept since its header was read: the day starts at midnight
                return (_larr.array("Q", row[1] if row else []), _larr.array("Q", row[2] if row else []), _ld_midnight(d))
        for qi, qstep, _qm, qv in qf:
            if qstep == step and inside(qi):
                for sl_, v in qv.items():
                    add(sl_, v[0], v[1])
        if d == cur[0] and cur[2] == step and inside(cur[1]):
            for sl_, v in cur[4].items():
                add(sl_, v[0], v[1])
        if tail:                                               # a bucket lost to a full queue is simply not inside the window
            rx = [max(0, x) for x in rx]; tx = [max(0, x) for x in tx]
        return rx, tx, mid + k * step

    def totals(self, qs, now=None):
        """Rows per pid (`by=peer`), per owner (`by=user`), or per (pid, owner) (`by=slot`: what a device carried while it
        was one user's — the Users grid, a user's peer list and the user view all read these, so they add up). Every row
        says since when it has been counted (`since`); `opening_at` only when a counter was imported.

        `window=<seconds>` or `since=<epoch>` (P3, the Overview's Top talkers): a rolling window up to now instead of local
        days — whole days from the rows, the first day's part from its fine buckets. It starts at the start of the bucket
        holding its start (widened, never cut), never before the ledger's history, and the reply says what was asked
        (`asked`) and where it starts (`since`)."""
        now = int(time.time() if now is None else now)
        g = lambda k: ((qs.get(k) or [""])[0] or "").strip()
        by = g("by") or "peer"
        if by not in ("peer", "user", "slot"):
            raise ValueError(perr("by must be peer, user or slot"))
        try:
            want_since = int(g("since")) if g("since") else (now - max(0, int(g("window"))) if g("window") else None)
        except ValueError:
            raise ValueError(perr("since and window must be integers"))
        rolling = want_since is not None
        return self._consistent(lambda: self._totals(qs, now, by, want_since, rolling))

    def _consistent(self, read):
        """Run a read that must not overlap a flush. ⚠️ A FLUSH IN FLIGHT HAS TAKEN ITS QUEUES AND NOT YET WRITTEN THEM: a
        closed day or bucket is then neither pending nor on disk, and a read in that gap misses it — a window ending
        yesterday read 0, and a past window is cached for good. The writer counts its flushes (`_fseq`: odd while one runs);
        a read that saw the count move is read again. The writer never waits for a reader, and readers never wait for each
        other; only a flush that stays in the way (a slow disk) is waited for, 2 s, then answered 503 — never a guess."""
        for n in range(6):
            if n == 5:                                         # a flush in the way five times running: wait for it to end —
                if not self._flush_lock.acquire(timeout=2):    # never holding the lock over the read, so neither the writer
                    raise _LedgerBusy()                        # (nor SIGTERM's last write) nor another reader waits on us
                self._flush_lock.release()
            s0 = self._fseq
            if not s0 % 2:
                try:
                    out = read()
                except _LedgerBusy:
                    raise
                except ValueError as e:                        # a refusal of the query itself (a perr() sentence) cannot be
                    if (e.args and isinstance(e.args[0], dict)) or self._fseq == s0:   # read away: answered at once, 400
                        raise
                    continue                                   # a short array under a flush: read again
                except Exception:                              # a file replaced or cut short under the read by a flush:
                    if self._fseq == s0:                       # read again; with no flush in between it is real
                        raise
                    continue
                if self._fseq == s0:
                    return out
            if n < 4:
                time.sleep(0.05)
        raise _LedgerBusy()

    def _totals(self, qs, now, by, want_since, rolling):
        with self.lock:
            slots = [(s["pid"], s.get("owner"), s.get("o") or [0, 0], s.get("since") or 0, s.get("until"),
                      s.get("name") or "", s.get("on") or "") for s in self.slots]
            live = (self.day, self.C_rx[:], self.C_tx[:])
            if rolling:                                      # the open bucket (copied: it moves) and the queue (referenced:
                cur = (self.day, self.idx, self.step, self.fmid, {k: list(v) for k, v in self.fine.items()})   # a closed
                qall = [(q[0], q[1], q[2], q[4], q[5]) for q in self.q_fine]                                 # bucket never)
            first = min((s_.get("since") or 0 for s_ in self.slots), default=0)
        if rolling:
            fr_rx, fr_tx, since = self._c_at(max(0, min(want_since, now)), live, cur, qall)
            to_rx, to_tx = live[1], live[2]
            if first and since < first:                      # nothing was counted before the ledger's first slot: the
                since = max(since, _ld_midnight(_ld_day(first)[0]))   # window starts where history does, and says so
            f, t, rk = _ld_day(since)[0], live[0], "since:%d" % since
            until = now
        else:
            f, t, rk = self._window(qs, now)
            to_rx, to_tx = self._cum(t, live)
            fr_rx, fr_tx = self._cum(_ld_prev(f), live) if f > 19700101 else (_larr.array("Q"), _larr.array("Q"))
            since = _ld_midnight(f)
            until = min(now, _ld_midnight(_ld_next(t)))
        rows = {}
        for n, (pid, owner, o, since_, until_, name, on) in enumerate(slots):
            k = pid if by == "peer" else (owner or "") if by == "user" else (pid, owner or "")
            a = to_rx[n] if n < len(to_rx) else 0; b = to_tx[n] if n < len(to_tx) else 0
            a0 = fr_rx[n] if n < len(fr_rx) else 0; b0 = fr_tx[n] if n < len(fr_tx) else 0
            r = rows.get(k)
            if r is None:
                r = rows[k] = {"id": k if by != "slot" else pid, "rx": 0, "tx": 0, "lifetime_rx": 0, "lifetime_tx": 0,
                               "opening_rx": 0, "opening_tx": 0, "opening_at": 0, "since": since_, "slots": 0, "closed": 0}
                if by == "slot":
                    r.update({"owner": owner or "", "name": name, "owner_name": on, "until": until_})
            r["rx"] += max(0, a - a0); r["tx"] += max(0, b - b0)
            r["lifetime_rx"] += live[1][n] + o[0]; r["lifetime_tx"] += live[2][n] + o[1]
            if o[0] or o[1]:
                r["opening_rx"] += o[0]; r["opening_tx"] += o[1]
                r["opening_at"] = min(r["opening_at"] or since_, since_)
            r["since"] = min(r["since"] or since_, since_)
            r["slots"] += 1
            r["closed"] += 1 if until_ else 0
            if by == "slot":                                   # the newest slot of the pair names it, and says whether it is
                if since_ >= (r.get("_last") or 0):            # still open — an unassign and a reassign back make two slots
                    r["_last"], r["name"], r["owner_name"], r["until"] = since_, name, on or r["owner_name"], until_
        for r in rows.values():
            r.pop("_last", None)
        return {"rangeKey": rk, "from": f, "to": t, "by": by, "step": 86400, "since": since, "until": until,
                "utc_offset": time.localtime().tm_gmtoff, "gaps": self._gaps(since, until, self._spans()),
                **({"asked": want_since} if rolling else {}), "rows": list(rows.values())}

    def series(self, qs, now=None):
        return self._consistent(lambda: self._series(qs, now))   # the same gap as totals()

    def _series(self, qs, now=None):
        now = int(time.time() if now is None else now)
        f, t, rk = self._window(qs, now)
        by = (qs.get("by") or ["peer"])[0]
        ident = (qs.get("id") or [""])[0]
        if by not in ("peer", "user", "group") or not ident:
            raise ValueError(perr("id is required, by must be peer, user or group"))
        # A group is its members' slots added together — every slot each of them held, as their own graphs count. The route
        # resolves the members from the roster (`members`); the ledger knows owners, not groups.
        members = {u for u in ((qs.get("members") or [""])[0]).split(",") if u} if by == "group" else None
        owned = (lambda o: (o or "") in members) if by == "group" else (lambda o: (o or "") == ident)
        with self.lock:
            want = sorted(n for n, s in enumerate(self.slots)
                          if (s["pid"] == ident if by == "peer" else owned(s.get("owner"))))
            first = min((s.get("since") or 0 for s in self.slots), default=0)
            nslots = len(self.slots)
            live = (self.day, self.C_rx[:], self.C_tx[:])
            cur = (self.day, self.idx, self.step, self.fmid, {s: list(self.fine[s]) for s in want if s in self.fine})
            # the queue in the SAME section as the open bucket: a sync closing the bucket between two sections moved it
            # from one to the other, and the graph drew it twice
            qf_all = [(q[0], q[1], q[2], q[4], {s: q[5][s] for s in want if s in q[5]}) for q in self.q_fine if f <= q[0] <= t]
            nodes = {k[0] for k in self.recs if (k[2] == ident if by == "peer" else owned(self.owners.get(k[2])))}
        if first:                                              # nothing exists before the ledger's first slot: never walk from 1970
            f = min(max(f, _ld_day(first)[0]), t)
        elif not nslots:                                       # an empty ledger walks no day before today
            f = t
        fine_ok = (_ld_date(t) - _ld_date(f)).days < LEDGER_SERIES_FINE_DAYS   # a longer window is read from the day rows:
        #                                                     one peer's fine points cost a read of each day's whole file
        sw = lambda arr: sum(arr[s] for s in want if s < len(arr))
        cums = {}                                              # the want slots' C at each closed day, and the day's end —
        base_row = self._row_at_or_before(_ld_prev(f)) if f <= t else None   # month files indexed once, and of each row only
        prev_c = (sw(base_row[1]), sw(base_row[2])) if base_row else (0, 0)  # the wanted slots read (16 B each): the cost is
        prev_end = self._row_end(base_row[0]) if base_row else 0             # days × peers asked about, not days × fleet
        m = f // 100
        while m <= t // 100:
            path = self._day_path(m * 100 + 1)
            for rd, (o, ns) in sorted(self._day_rows(path).items()):
                if f <= rd <= t:
                    got = self._read_row_slots(path, o, ns, want)
                    if got:
                        cums[rd] = got
            m = m + 1 if m % 100 < 12 else (m // 100 + 1) * 100 + 1
        for rd, (crx, ctx, end) in self._pending_rows().items():
            if f <= rd <= t and rd not in cums:
                cums[rd] = (sw(crx), sw(ctx), end)
        qf = [q for q in qf_all if f <= q[0] <= t]             # closed buckets still waiting for their write: part of the graph
        pts = []
        d = f
        while d <= t:
            fp = self._fine_path(d)
            head = self._fine_head(fp) if fine_ok and os.path.exists(fp) else None
            fdata = None
            if head:                                           # read once: gone since its header was read (the OFF sweep) →
                try:                                           # the day draws from its row below, like any day with no detail
                    with open(fp, "rb") as fh_:
                        fdata = fh_.read()
                except FileNotFoundError:
                    head = None
            drawn = [0, 0]
            if fine_ok and (head or any(q[0] == d for q in qf) or (d == cur[0] and cur[4] and cur[2] < 86400)):
                step, mid = (head[0], head[2]) if head else (cur[2], cur[3]) if d == cur[0] else next((q[2], q[3]) for q in qf if q[0] == d)
                acc = {}
                if head:
                    for i, n, _e, (sl, rx, tx) in self._fine_buckets(fp, data=fdata):
                        for s in want:
                            j = _lbis.bisect_left(sl, s)
                            if j < n and sl[j] == s:
                                a = acc.setdefault(i, [0, 0]); a[0] += rx[j]; a[1] += tx[j]
                for qd, qi, qs, qm, qv in qf:                  # a bucket's halves (a restart inside it), a pending one and
                    if qd == d and qs == step:                 # the open one all land on their own idx, summed
                        a = acc.setdefault(qi, [0, 0]); a[0] += sum(v[0] for v in qv.values()); a[1] += sum(v[1] for v in qv.values())
                if d == cur[0] and cur[4] and cur[2] == step:
                    a = acc.setdefault(cur[1], [0, 0]); a[0] += sum(v[0] for v in cur[4].values()); a[1] += sum(v[1] for v in cur[4].values())
                pts.extend([mid + i * step, step, a[0], a[1]] for i, a in sorted(acc.items()) if a[0] or a[1])
                drawn = [sum(a[0] for a in acc.values()), sum(a[1] for a in acc.values())]
            elif d in cums:                                    # no fine file (1-day resolution, or none written): the day's delta,
                c = cums[d]                                    # drawn from where that day began — its own recorded frame
                start = prev_end or (c[2] - 86400)
                if c[0] > prev_c[0] or c[1] > prev_c[1]:
                    pts.append([start, max(1, c[2] - start), max(0, c[0] - prev_c[0]), max(0, c[1] - prev_c[1])])
            if d in cums:
                prev_c, prev_end = (cums[d][0], cums[d][1]), cums[d][2]
            if d == cur[0] and (not fine_ok or cur[2] >= 86400):   # today by day (a long window, or no fine tier): live C
                lc = (sw(live[1]) - drawn[0], sw(live[2]) - drawn[1])   # against the last closed day — less what today's fine
                if lc[0] > prev_c[0] or lc[1] > prev_c[1]:              # points already drew (a resolution changed today)
                    pts.append([cur[3], 86400, max(0, lc[0] - prev_c[0]), max(0, lc[1] - prev_c[1])])
            d = _ld_next(d)
        since = _ld_midnight(f)
        until = min(now, _ld_midnight(_ld_next(t)))
        return {"rangeKey": rk, "id": ident, "by": by, "from": f, "to": t, "since": since, "until": until,
                "utc_offset": time.localtime().tm_gmtoff, "gaps": self._gaps(since, until, self._spans(), nodes), "points": pts}

    def dump(self):
        """GET /api/traffic-ledger — the debug view: per pid its slots, lifetime (C + opening), resets, clamps."""
        with self.lock:
            pids = {}
            for n, s in enumerate(self.slots):
                e = pids.setdefault(s["pid"], {"slots": [], "lifetime": [0, 0], "opening": [0, 0], "owner": None})
                o = s.get("o") or [0, 0]
                e["slots"].append({"slot": n, "owner": s.get("owner"), "since": s.get("since"), "until": s.get("until"),
                                   "c": [self.C_rx[n], self.C_tx[n]]})
                e["lifetime"][0] += self.C_rx[n] + o[0]; e["lifetime"][1] += self.C_tx[n] + o[1]
                e["opening"][0] += o[0]; e["opening"][1] += o[1]
                if not s.get("until"):
                    e["owner"] = s.get("owner")
            byp = {}
            for k in self.recs:
                byp.setdefault(k[2], []).append("%s|%s" % (k[0], k[1]))
            for pid, e in pids.items():
                dp = self.diag["pids"].get(pid) or {}
                e.update({"resets": dp.get("resets", 0), "clamps": dp.get("clamps", 0),
                          "not_imported": dp.get("not_imported", [0, 0]), "records": sorted(byp.get(pid, []))})
            return {"on": self.on, "why_off": self.why_off, "dir": self.dir, "step": self.step, "day": self.day,
                    "idx": self.idx, "newest": self.newest, "observed": self.observed, "slots": len(self.slots),
                    "open": len(self.open), "records": len(self.recs), "imports": len(self.imports),
                    "pending": {"fine": len(self.q_fine), "day": len(self.q_day)},
                    "map": len(self.map), "diag": {k: v for k, v in self.diag.items() if k not in ("pids", "spans")},
                    "spans": self.diag.get("spans"), "pids": pids}

    def api(self, path, qs):
        if not self.on:
            return 503, {"ok": False, "code": "ledger_off", **perr("The traffic ledger is not running: {v1}", v1=self.why_off)}
        try:
            if path == "/api/traffic-totals":
                return 200, {"ok": True, "data": self.totals(qs)}
            if path == "/api/traffic-series":
                return 200, {"ok": True, "data": self.series(qs)}
            return 200, {"ok": True, "data": self.dump()}
        except _LedgerBusy:
            return 503, {"ok": False, "code": "busy", **perr("The traffic history is being written; try again in a moment")}
        except ValueError as e:                                # a perr() sentence, so the browser can translate it
            return 400, {"ok": False, "code": "bad_request", **(e.args[0] if e.args and isinstance(e.args[0], dict) else {"error": str(e)})}


