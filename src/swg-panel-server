def load_panel_settings(path):
    """panel-settings.json merged over the defaults (one level deep for the sub-dicts)."""
    saved = load_settings_critical(path) or {}   # backup-recovering load (a clobbered/corrupt primary → newest good backup)
    out = {**PANEL_SETTINGS_DEFAULTS, **saved}
    for k in ("interface_defaults", "mirrors", "advanced", "reserved", "geo_update", "turn_update", "api", "subscriptions"):
        out[k] = {**PANEL_SETTINGS_DEFAULTS[k], **(saved.get(k) or {})}
    # access has nested sub-dicts (panel/sub/tls) → merge each so a partial saved block keeps the defaults
    sa = saved.get("access") if isinstance(saved.get("access"), dict) else {}
    out["access"] = {sk: {**PANEL_SETTINGS_DEFAULTS["access"][sk], **(sa.get(sk) or {})}
                     for sk in PANEL_SETTINGS_DEFAULTS["access"]}
    return out


