                                           **({"socks": {k: x["socks"].get(k) for k in ("host", "port", "user", "pass")}}
                                              if isinstance(x.get("socks"), dict) else {})}
                                          for x in (node.get("exits") or [])
                                          if isinstance(x, dict) and x.get("provider") == "socks5"
