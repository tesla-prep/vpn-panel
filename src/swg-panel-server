            return 400, {"ok": False, "error": "token_sha and token_by_sk are required", "code": "bad_request"}
        users[uid]["token_sha"] = tsha; users[uid]["enabled"] = True
        rec = escrow.get(uid) or {}
        rec["token_by_sk"] = tbs; rec["rotated"] = now()
        if isinstance(body.get("unlock_by_sk"), str):                # a full re-key also rotates the unlock-key
            rec["unlock_by_sk"] = body["unlock_by_sk"]
        escrow[uid] = rec
        save_sub_users(deps, users); save_sub_escrow(deps, escrow)
        return 200, {"ok": True, "data": {"rotated": True}}

    if method == "POST" and path == "/api/sub/user/disable":         # kill the public URL, but KEEP the encrypted config store
