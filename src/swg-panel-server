            vk = _vk_link_norm(fields.get("vk_link"))[:512]
            if vk and not _VK_CALL_RE.match(vk):
                return 400, {"ok": False, **perr("Not a VK call link or its hash — expected https://vk.ru/call/join/…"), "code": "bad_request"}
            fields["vk_link"] = vk
        if "vk_links" in body:
            raw = body.get("vk_links")
            if not isinstance(raw, list):
                return 400, {"ok": False, "error": "vk_links must be a list", "code": "bad_request"}
            links = []
            for item in raw:
                s = _vk_link_norm(item)[:512]
                if not s:
                    continue
                if not _VK_CALL_RE.match(s):
                    return 400, {"ok": False, **perr("Not a VK call link or its hash — expected https://vk.ru/call/join/…"), "code": "bad_request"}
                links.append(s)
            fields["vk_links"] = links
        if "static_exit" in body:
            if body["static_exit"] is not None:
                return 400, {"ok": False, **perr("Choose a proxy profile from the shared pool"), "code": "bad_request"}
            fields["static_exit"] = None
        if "socks_profile" in body:
            value = body["socks_profile"]
            fields["socks_profile"] = None
            if value is not None:
                profile_id = value.get("id") if isinstance(value, dict) else None
                policy = value.get("failure", "block") if isinstance(value, dict) else None
                if not isinstance(profile_id, str) or policy not in ("block", "direct"):
                    return 400, {"ok": False, **perr("Choose a proxy profile and failure policy"), "code": "bad_request"}
                profile = socks_pool(deps).get(profile_id)
                existing = (roster["users"][uid].get("socks_profile") or {}).get("id")
                if profile_id != existing and (not profile or profile.get("enabled") is False):
                    return 400, {"ok": False, **perr("Choose an enabled proxy profile"), "code": "bad_request"}
                if any(k != uid and (u.get("socks_profile") or {}).get("id") == profile_id for k, u in roster["users"].items()):
                    return 409, {"ok": False, **perr("This proxy profile is already assigned to another user"), "code": "conflict"}
                fields["socks_profile"] = {"id": profile_id, "failure": policy}
