_SUB_META = {
    "ru": {"desc": "Ваш доступ к VPN — настройки и QR-коды для ваших устройств в одном месте.",
           "title": "Ваш доступ к VPN",
           "ogdesc": "Настройки и QR-коды для ваших устройств в одном месте."},
}

def _sub_meta(data, lang):
    """Rewrite the shell's description/og for `lang`. English is what sub.html ships with, so that is a no-op;
    an unknown code leaves the file as written rather than emptying the tags. Nothing here is per-user — the URL
    carries a token, so a preview must describe the page and never say whose it is."""
    m = _SUB_META.get((lang or "").strip().lower()[:2])
    if not m:
        return data
    out = data.replace(b'<html lang="en">', ('<html lang="%s">' % lang).encode())
    with contextlib.suppress(Exception):
        out = re.sub(rb'(<meta name="description" content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["desc"].encode() + mo.group(2), out)
        out = re.sub(rb'(<meta property="og:title" content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["title"].encode() + mo.group(2), out)
        out = re.sub(rb'(<meta property="og:description" content=")[^"]*(")',
                     lambda mo: mo.group(1) + m["ogdesc"].encode() + mo.group(2), out)
    return out


class State:
    """Resolved paths into the panel's state dir, from fleet.json + the panel's own defaults."""

    def __init__(self, fleet):
        self.roster_path = fleet.get("roster_path", "/var/lib/swg-panel/users.json")
        self.nodes_path = fleet.get("nodes_path", "/var/lib/swg-panel/nodes.json")
        self.stats_dir = fleet.get("stats_dir", "/var/www/wgstats")
        state_dir = os.path.dirname(self.roster_path) or "."
        self.sub_dir = fleet.get("sub_dir") or os.path.join(state_dir, "subs")

    def subscriptions(self):
        d = load_json(os.path.join(self.sub_dir, "serve.json"), {})
        return d if isinstance(d, dict) else {}

    def enabled(self):
        return bool(self.subscriptions().get("enabled"))

    def sub_users(self):
        d = load_json(os.path.join(self.sub_dir, "users.json"), {})
        return d if isinstance(d, dict) else {}

    def sub_blobs(self, uid):
        safe = re.sub(r"[^A-Za-z0-9_-]", "_", str(uid))
        d = load_json(os.path.join(self.sub_dir, "blobs", safe + ".json"), {})
        return d if isinstance(d, dict) else {}

    def roster(self):
        r = load_json(self.roster_path, {})
        if not isinstance(r, dict):
            r = {}
        if not isinstance(r.get("users"), dict):
            r["users"] = {}
        if not isinstance(r.get("peers"), dict):
            r["peers"] = {}
        return r

    def nodes(self):
        d = load_json(self.nodes_path, {})
        return d if isinstance(d, dict) else {}

    def describe(self, nodes):
        """Per-node {ifaces, turn} — snapshots are read from the mirror files the panel writes
        (stats-<id>.json), so this needs no running panel. `turn` is the node's raw turn-proxy list
        (non-secret client-config material: service / listen / wrap_key)."""
        out = {}
        for nid, cfg in nodes.items():
            snap = load_json(os.path.join(self.stats_dir, (cfg or {}).get("stats_file") or f"stats-{nid}.json"), None)
            if not isinstance(snap, dict) or not snap:
                continue
            out[nid] = {"ifaces": apply_iface_meta(cfg, node_describe(snap)),
                        "turn": snap.get("turn_proxies") or [],
                        "pub_host": node_public_host(snap),   # reported public IP → WDTT link host when endpoint_host is unset
                        # each WDTT / csqtt server's RUNNING version, by interface → the page offers the app release it names
                        "tver": _running_versions(snap),
                        # each csqtt server's running LINE (2.1 / 2.5), by interface → the page offers only apps of that line
                        "tline": _running_lines(snap),
                        # the networks this node ROUTES right now (swg-noded net_carried) — what the page may promise a user
                        "net_carried": snap.get("net_carried") if isinstance(snap.get("net_carried"), list) else [],
                        # the torrent policy the node RUNS ({state, mode, route}) — a Route it could not lower runs as block
                        "p2p": _snap_p2p(snap),
                        # the devices' incoming torrent ports it forwards, by interface ({addr, taken}, Part C)
                        "p2p_fwd": snap.get("p2p_fwd") if isinstance(snap.get("p2p_fwd"), dict) else {}}
        return out


def _own_pins(cat, peers_out):
    """The catalog with only the pins of versions THIS subscriber's servers run: serve.json carries the whole fleet's,
    and which builds run on other people's servers is not theirs to read."""
    pins = cat.get("pins")
    if not isinstance(pins, dict):
        return cat
    mine = set()
    for po in peers_out:
        for tg in (po.get("targets") or []):
            for k in ("wdtt", "csqtt"):
                if isinstance(tg.get(k), dict) and tg[k].get("version"):
                    mine.add(tg[k]["version"])
            mine.update(tp.get("version") for tp in (tg.get("turn") or []) if isinstance(tp, dict) and tp.get("version"))
    return {**cat, "pins": {repo: {v: x for v, x in vs.items() if v in mine}
                            for repo, vs in pins.items() if isinstance(vs, dict) and any(v in mine for v in vs)}}


def _snap_p2p(snap):
    """The node's own report of its torrent policy (swg-noded smart_status `p2p`), or {} — read only as an object."""
    sr = snap.get("smartroute")
    v = sr.get("p2p") if isinstance(sr, dict) else None
    return v if isinstance(v, dict) else {}


def _running_versions(snap):
    """{iface: running version} of a node's WDTT and csqtt servers — any shape a snapshot carries (a list, or a map of
    records) and nothing else: a stray value is skipped, never an exception inside every subscription's describe()."""
    out = {}
    for k in ("wdtt", "csqtt"):
        xs = snap.get(k)
        for x in (xs.values() if isinstance(xs, dict) else xs if isinstance(xs, list) else ()):
            if isinstance(x, dict) and isinstance(x.get("iface"), str):
                out[x["iface"]] = str(x.get("version") or "").strip()
    return out


def _running_lines(snap):
    """{iface: running line} of a node's csqtt servers. "" when the node does not say (an older node: one line, 2.1)."""
    xs = snap.get("csqtt")
    return {x["iface"]: str(x.get("line") or "").strip()
            for x in (xs.values() if isinstance(xs, dict) else xs if isinstance(xs, list) else ())
            if isinstance(x, dict) and isinstance(x.get("iface"), str)}


# ── networks this user can reach (docs/NETWORKS-PLAN.md §18) ──
# The end user was never told: the office LAN a colleague's router fronts, shared with them, appeared nowhere they look.

_KEYLESS = ("wdtt", "csqtt")


def _net_prefix(s):
    """A v4 CIDR normalised the way the panel stores it (`10.0.0.5` → `10.0.0.5/32`), or ""."""
    with contextlib.suppress(ValueError, TypeError):
        n = ipaddress.ip_network(str(s).strip(), strict=False)
        if n.version == 4:
            return str(n)
    return ""


def share_grants(p, users, nowv, groups):
    """{uid: until} for a RESTRICTED provider, None when it is open to everyone on its node. Byte-for-byte the same rule as
    swg-panel-server's share_grants (tests/sub_networks_selftest.py holds them together, source and answers): the owner
    always, a grant whose user or group is gone or whose date has passed never, a group grant reaching its members, and a
    user covered twice getting the widest date."""
    sh = p.get("share") if isinstance(p, dict) else None
    if isinstance(p, dict) and p.get("private"):
        return {p["user_id"]: 0} if p.get("user_id") in users else {}
    if not isinstance(sh, dict):
        return None
    out = {}

    def grant(uid, until):
        if isinstance(uid, str) and uid in users:
            out[uid] = 0 if 0 in (until, out.get(uid)) else max(until, out.get(uid) or 0)

    def live(d):
        return [(k, u) for k, u in (d.items() if isinstance(d, dict) else ())
                if not isinstance(u, bool) and isinstance(u, int) and u >= 0 and not (u and u <= nowv)]

    for uid, until in live(sh.get("users")):
        grant(uid, until)
    for gid, until in live(sh.get("groups")):
        g = groups.get(gid) if isinstance(groups, dict) else None
        for uid in (g.get("users") if isinstance(g, dict) and isinstance(g.get("users"), list) else ()):
            grant(uid, until)
    if p.get("user_id") in users:
        out[p["user_id"]] = 0
    return out


def _allowed_covers(allowed, prefix):
    """Does a client AllowedIPs string route `prefix` into the tunnel? Same rule as swg-panel-server's `_allowed_covers`."""
    n = ipaddress.ip_network(prefix)
    for m in str(allowed or "").split(","):
        with contextlib.suppress(ValueError, TypeError):
            if n.subnet_of(ipaddress.ip_network(m.strip(), strict=False)):
                return True
    return False


def sub_networks(roster, uid, describe, nodes, nowv):
    """The networks this user's devices reach beyond the internet: [{prefix, node_name, via, covered}].

    ⚠️ ONLY WHAT A NODE REPORTS ROUTING (`net_carried`). The page tells an end user what works, never what should: a network
    the node refused, one waiting for its next sync, or one on a node too old to report is simply not listed.
    A provider's network attaches to it on a node exactly as the panel's `node_networks` decides — earliest `created_at`, then
    id, wins an identical prefix — so the provider named here is the one the node routes through.
    A RESTRICTED network is listed for its owner and live grantees only, and only through a KEYED deployment: a turn-server
    device reaches one only on a build the panel vouches for (§16), which this read-only page does not re-derive — left out
    rather than promised. `via` (the provider's title) only for a restricted network — someone chose to share it; an open
    one says where, not whose. `covered`: that device's own config routes it (None for a keyless deployment)."""
    users = roster.get("users") or {}
    peers = roster.get("peers") or {}

    def live(q):
        u = users.get(q.get("user_id")) or {}
        return not (q.get("disabled") or u.get("disabled") or is_expired(q, nowv) or is_expired(u, nowv))

    provs = sorted(((int(q.get("created_at") or 0), str(q.get("id") or k), q) for k, q in peers.items()
                    if isinstance(q, dict) and q.get("routes") and live(q)), key=lambda x: (x[0], x[1]))
    if not provs:
        return []
    out, seen = [], set()
    for mk, q in sorted(peers.items()):
        if not isinstance(q, dict) or q.get("user_id") != uid or not live(q):
            continue
        mine = str(q.get("id") or mk)
        for t in q.get("targets") or []:
            if not isinstance(t, dict):
                continue
            nid = t.get("node")
            nd = describe.get(nid) or {}
            held = set(nd.get("net_carried") or [])
            if not held:
                continue
            keyed = (t.get("type") or "wg") not in _KEYLESS
            meta = (nd.get("ifaces") or {}).get(t.get("iface")) or {}
            allowed = effective_client_params(q, t, meta)["allowed"] if keyed else None
            claimed = set()
            for _c, opid, o in provs:
                if not any(isinstance(x, dict) and x.get("node") == nid and x.get("iface") and (x.get("type") or "wg") not in _KEYLESS
                           for x in o.get("targets") or []):
                    continue
                pres = [p_ for p_ in (_net_prefix(r) for r in o.get("routes") or []) if p_ in held and p_ not in claimed]
                claimed.update(pres)                   # the first provider holding a prefix is the one the node routes
                if opid == mine:
                    continue                           # a device's own networks are behind it, not reached through it
                g = share_grants(o, users, nowv, roster.get("groups"))
                if g is not None and (uid not in g or not keyed):
                    continue
                for pre in pres:
                    if (pre, nid, mine) in seen:
                        continue
                    seen.add((pre, nid, mine))
                    out.append({"prefix": pre, "node_name": (nodes.get(nid) or {}).get("name") or nid,
                                "via": (o.get("title") or "") if g is not None else "",
                                "covered": None if allowed is None else _allowed_covers(allowed, pre)})
    # one row per network per node: the device that routes it wins over one that doesn't, so a user with a phone and a
    # narrowed laptop reads "reachable", with the narrowed device named only when nothing of theirs covers it
    best = {}
    for r in out:
        k = (r["prefix"], r["node_name"])
        if k not in best or (best[k]["covered"] is not True and r["covered"] is True):
            best[k] = r
    return sorted(best.values(), key=lambda r: (r["node_name"], ipaddress.ip_network(r["prefix"])))


# torrents allowed on a deployment (1.8.11 S4b)

P2P_ACTIONS = ("block", "direct", "iface", "exit", "dev")


def p2p_policy(node):
    """swg-panel-server's p2p_policy, copied — this process imports nothing of the panel (tests/sub_p2p_hint_selftest.py holds
    the two together): what the operator saved, else block."""
    v = node.get("p2p")
    if isinstance(v, dict) and v.get("action") in P2P_ACTIONS:
        return v["action"]
    return "block"


_P2P_RECS = {"wdtt": "wdtt", "csqtt": "csqtt"}   # a deployment's type → the node record set it lands on (else "ifaces")


def _p2p_runs(nodes, describe, nid, arrivals=False):
    """Whether node `nid` lets P2P out: its policy is not Block, and it does not REPORT running Block — a Route the panel could
    not lower (no mesh link, the exit gone) runs as Block (fail closed), and a Route whose way out is down carries nothing.
    `arrivals`: for P2P another node sends here, which this node judges by its own policy and drops under a Route of its own
    (P2P-POLICY §2: P2P never goes back into the mesh), so only Direct and per-interface let it on."""
    cfg = nodes.get(nid)
    if not isinstance(cfg, dict):
        return False
    pol = p2p_policy(cfg)
    rep = (describe.get(nid) or {}).get("p2p") or {}
    # `route` down is the NODE-WIDE route's (exit/dev); under iface it is one interface's, judged per record below (S11 F4)
    if pol == "block" or rep.get("mode") == "block" or (rep.get("route") == "down" and pol in ("exit", "dev")):
        return False
    return pol in ("direct", "iface") if arrivals else True


def _p2p_route_dev(node, p2p):
    """The device a record's own torrent route leaves by — the panel's `p2p_route_dev`, twinned (the node names these in
    its report's `down`): an exit's device, or the mesh link to the node it routes through. "" when it has none (a disabled exit's too)."""
    a = (p2p or {}).get("action") if isinstance(p2p, dict) else None
    if a == "dev":                                            # resolve_exit's reading: a disabled exit routes nothing, a name stripped
        x = next((x for x in ((node or {}).get("exits") or []) if isinstance(x, dict) and str(x.get("id")) == str(p2p.get("exit_id"))), None)
        return str(x.get("device") or "").strip() if x and x.get("enabled") is not False else ""
    if a == "exit":
        lk = ((node or {}).get("links") or {}).get(p2p.get("node"))
        return str(lk.get("iface") or "").strip() if isinstance(lk, dict) else ""
    return ""


def torrents_allowed(nodes, describe, t):
    """Whether torrents may leave by deployment `t` — the nodes' own rule, strictest wins (P2P-POLICY §2.2): the record `t`
    lands on (its interface, WDTT or csqtt server) does not block "torrents", its node lets P2P out, and where the policy hands
    it to ANOTHER node — a Route to a node, or a per-interface policy on an interface forwarded whole to one — that node lets
    arrivals' P2P out too; under per-interface, the record's own choice decides first (a route through a node needs a link
    and that node's arrivals let out, a route through an exit needs it there and on, Direct is the node's own WAN). One hop, as the policy routes: a smart interface's catch-all is cascade_plan's to resolve, not this
    page's (a known limit). A "torrents" category switched off in Settings still reads as blocked here (Settings is not this
    process's to read), so the hint can be missing where torrents run."""
    nid = t.get("node")
    cfg = nodes.get(nid)
    if not _p2p_runs(nodes, describe, nid):
        return False
    recs = cfg.get(_P2P_RECS.get(t.get("type") or "", "ifaces"))
    rec = recs.get(t.get("iface")) if isinstance(recs, dict) else None
    rec = rec if isinstance(rec, dict) else {}
    blk = rec.get("block")
    if any(str(b).strip() == "torrents" for b in (blk if isinstance(blk, list) else ())):
        return False
    pol = p2p_policy(cfg)
    if pol == "exit":                                  # every client subnet's P2P goes to that node
        return _p2p_runs(nodes, describe, (cfg.get("p2p") or {}).get("node"), arrivals=True)
    _rp = rec.get("p2p") if pol == "iface" and isinstance(rec.get("p2p"), dict) else {}
    _rep = (describe.get(nid) or {}).get("p2p") or {}
    if _rp.get("action") in ("exit", "dev") and _rep.get("route") == "down":
        # the node names the devices down (`down`): only an interface whose own route leaves by one is not allowed (S11
        # backlog F48); a node that names none — fail closed (pick F2)
        _dv = _p2p_route_dev(cfg, _rp)                 # no device to leave by — a disabled exit, a blank device, no link —
        if not isinstance(_rep.get("down"), list) or not _dv or _dv in _rep["down"]:   # is no way out either (review F11)
            return False
    if _rp.get("action") == "exit":                    # its own route through a node (IFACE-P2P-PICK): a link there, and that
        _q = _rp.get("node")                           # node lets arrivals' P2P out
        return isinstance(cfg.get("links"), dict) and _q in cfg["links"] and _p2p_runs(nodes, describe, _q, arrivals=True)
    if _rp.get("action") == "dev":                     # …through one of this node's exits, there and switched on
        return any(isinstance(x, dict) and str(x.get("id")) == str(_rp.get("exit_id")) and x.get("enabled") is not False
                   for x in (cfg.get("exits") if isinstance(cfg.get("exits"), list) else ()))
    if _rp.get("action") == "direct":                  # out this node's own address, whatever the interface's egress
        return True
    if pol == "iface" and rec.get("egress_mode") == "forward":   # follows the interface: forwarded whole to that node
        return _p2p_runs(nodes, describe, rec.get("egress_node"), arrivals=True)
    return True


def _p2p_fwd_of(p, tg, describe):
    """{p2p_port, p2p_addr} — the device's incoming torrent port on this deployment — only where its node reports
    forwarding this interface (swg-noded `p2p_fwd`), the port is not taken there, and this is the one target on that node
    the panel forwards: its primary, else the first by interface name (the panel's p2p_fwd_for_node, twinned). {} else."""
    port, fw = p.get("p2p_port"), (describe.get(tg.get("node")) or {}).get("p2p_fwd") or {}
    e = fw.get(tg.get("iface"))
    if type(port) is not int or not isinstance(e, dict) or port in (e.get("taken") if isinstance(e.get("taken"), list) else ()):
        return {}
    mine = min(((_role_of(t) != "primary", str(t.get("iface") or "")) for t in (p.get("targets") or [])
                if isinstance(t, dict) and t.get("node") == tg.get("node") and str(t.get("iface") or "") in fw), default=None)
    if not mine or mine[1] != tg.get("iface"):
        return {}
    with contextlib.suppress(ValueError):                 # the address only where the swarm sees it: a node behind 1:1 NAT
        if ipaddress.ip_address(str(e.get("addr") or "")).is_global:   # holds a private one (its forward works all the same)
            return {"p2p_port": port, "p2p_addr": str(e["addr"])}
    return {"p2p_port": port}


def _role_of(t):
    """The operator's label for one deployment: "primary", "backup", or "" — literal, never derived.

    The only such field: the page both prints this word and orders by it (primary, then unmarked, then
    backups). A peer nobody has labelled prints nothing at all, rather than calling its first deployment
    primary and every other one a backup of it."""
    v = (t or {}).get("primary")
    r = v.strip().lower() if isinstance(v, str) else ("primary" if v else "")
    return r if r in ("primary", "backup") else ""   # `True` is what pre-backup rosters carry


def _port_of(hostport):
    """Trailing :port of a host:port string → int, else None (mirrors the SPA's portOf)."""
    s = str(hostport or "")
    i = s.rfind(":")
    if i < 0:
        return None
    try:
        return int(s[i + 1:])
    except ValueError:
        return None


def _bind_ip_of(listen):
    """The concrete IP an instance binds, from its `host:port` listen string — "" for a wildcard or a bare port.

    A node can carry several public addresses, and a WDTT/csqtt server binds ONE of them. That bind is the only
    address that will answer, so it beats the node-wide fallback; a wildcard bind answers on all of them, and there
    the operator's endpoint choice is the right one. This mirrors the operator app's own resolution order
    (js/peer-ui.js) — which the subscription page had simply never learned, so on a multi-address node it handed
    the holder a different IP from the one the operator picked, with the right port. Nothing listens there.
    """
    s = str(listen or "").strip()
    i = s.rfind(":")
    host = s[:i] if i > 0 else ""
    if not host or host in ("0.0.0.0", "::", "[::]", "*"):
        return ""
    return host.strip("[]")


def token_lookup(users, token):
    """Raw token → user_id via constant-time sha256 match; None if unknown or disabled."""
    if not token:
        return None
    sha = hashlib.sha256(token.encode()).hexdigest()
    for uid, rec in users.items():
        if isinstance(rec, dict) and rec.get("enabled") and hmac.compare_digest(str(rec.get("token_sha", "")), sha):
            return uid
    return None


def token_lookup_rec(users, token):
    """Like token_lookup but matches a SUSPENDED user too (enabled False) → (uid, rec). A blocked user keeps
    its token_sha so the page can show a "Subscription disabled" screen instead of a bare 404. None if unknown."""
    if not token:
        return None
    sha = hashlib.sha256(token.encode()).hexdigest()
    for uid, rec in users.items():
        if isinstance(rec, dict) and hmac.compare_digest(str(rec.get("token_sha", "")), sha):
            return uid, rec
    return None


_READ_TTL = 3.0
_read_lock = threading.Lock()
_READ_CACHE = {"at": -1e9, "roster": None, "describe": None, "users": None, "nodes": None}

def _shared_read(state):
    now = time.monotonic()
    c = _READ_CACHE
    if c["roster"] is not None and (now - c["at"]) < _READ_TTL:
        return c["roster"], c["describe"], c["users"], c["nodes"]
    with _read_lock:
        now = time.monotonic()
        if c["roster"] is not None and (now - c["at"]) < _READ_TTL:
            return c["roster"], c["describe"], c["users"], c["nodes"]
        roster = state.roster()
        nodes = state.nodes()
        describe = state.describe(nodes)
        users = state.sub_users()
        c.update({"at": time.monotonic(), "roster": roster, "describe": describe, "users": users, "nodes": nodes})
        return roster, describe, users, nodes


_TRUST_XFF = bool(os.environ.get("SWG_SUB_TRUST_XFF"))
_RL_CAP = 120           # burst allowance per client
_RL_RATE = 20.0         # sustained refill (tokens/sec)
_RL_MAX = 8192          # cap the tracking table so a spoofed/rotating-IP flood can't grow memory
_rl_lock = threading.Lock()
_RL = {}                # ident -> [tokens, last_monotonic]

def _rate_ok(ident):
    now = time.monotonic()
    with _rl_lock:
        if len(_RL) > _RL_MAX:
            _RL.clear()                                # crude but bounded: a many-IP flood resets the table, not RAM
        b = _RL.get(ident)
        if b is None:
            _RL[ident] = [_RL_CAP - 1.0, now]
            return True
        b[0] = min(_RL_CAP, b[0] + (now - b[1]) * _RL_RATE)
        b[1] = now
        if b[0] < 1.0:
            return False
        b[0] -= 1.0
        return True


def is_expired(rec, nowv):
    """True if rec (a user or a peer) has an expiry date that has already passed. 0/absent = never expires.
    Evaluated live on every request — no scheduler; a peer/sub reappears the instant the date is extended."""
    exp = (rec or {}).get("expiry") or 0
    return bool(exp) and nowv >= int(exp)


def read_data(state, token):
    """The public page's data for a token: the user's CURRENT peers, each target's NON-SECRET
    params + the encrypted secret blob. Never returns a plaintext key. None if subscriptions are
    off or the token is invalid.

    READ-ONLY: unlike the panel's sub_read_data (which prunes stale blobs on read), this filters
    the blob set against the live roster purely in memory — a peer no longer assigned to the user
    is simply skipped, so a stale blob can never surface even though we never delete it. The
    roster is authoritative; the blob store is a subordinate cache the panel keeps in sync."""
    if not state.enabled():
        return None
    roster, describe, users, nodes = _shared_read(state)
    found = token_lookup_rec(users, token)
    if found is None:
        return None
    uid, rec = found
    user = (roster.get("users") or {}).get(uid) or {}
    subs = state.subscriptions()
    langs = subs.get("languages") if isinstance(subs.get("languages"), dict) else {}
    theme = {"theme_color": subs.get("theme_color") or "", "theme_color_light": subs.get("theme_color_light") or "",
             "langs": {"enabled": langs.get("enabled") or ["en"], "default": langs.get("default") or "en"}}
    nowv = int(time.time())
    # BLOCKED user (subscription suspended, or the roster flag set): resolve the token to show the name +
    # theme, but serve NO peers or secrets. The page renders the centered "Subscription disabled" screen.
    if not rec.get("enabled") or user.get("disabled"):
        return {"disabled": True, "user": {"name": user.get("name") or ""}, **theme}
    # EXPIRED subscription: same treatment as blocked, but the page shows "Subscription expired". Expiry is a live
    # date test (the sub record stays enabled), so it's evaluated here on every request rather than at set-time.
    if is_expired(user, nowv):
        return {"expired": True, "user": {"name": user.get("name") or ""}, **theme}
    live = {pid: p for pid, p in (roster.get("peers") or {}).items()
            if isinstance(p, dict) and p.get("user_id") == uid}
    blobs = state.sub_blobs(uid)                        # per-user file — small, read fresh so a new peer shows at once
    peers_out = []
    for pid, p in live.items():
        sec = (blobs.get(pid) or {}).get("sec")        # None until the admin browser provisions it
        tgts_in = p.get("targets") or []
        # Which deployment is the PRIMARY one
        tgts = []
        _hide = set(x for x in (p.get("sub_hide") or []) if isinstance(x, str))
        for i, t in enumerate(tgts_in):
            if not isinstance(t, dict):
                continue
            _ty = (t.get("type") or "wg")
            if _ty in ("wdtt", "csqtt") and _ty in _hide:
                continue
            nd = describe.get(t.get("node")) or {}
            if (t.get("type") or "") == "wdtt":
                # WDTT peer: keyless. Its client link carries only the WRAP password (roster) + the node's public
                # host + the instance's DTLS/WG ports (from the node store, NOT a snapshot). No WG meta / no `sec`.
                node_cfg = nodes.get(t.get("node")) or {}
                inst = ((node_cfg.get("wdtt")) or {}).get(t.get("iface")) or {}
                dtls = ((inst.get("listen") or "").rsplit(":", 1)[-1]) or "56000"
                tgts.append({
                    "node": t.get("node"), "iface": t.get("iface"),
                    "node_name": node_cfg.get("name") or t.get("node"),
                    "type": "wdtt",
                    "wdtt": {"password": p.get("wdtt_password") or "",
                             "fork": inst.get("fork") or "amurcanov",   # which WDTT fork → resolve the right per-OS client + encoder
                             "version": (nd.get("tver") or {}).get(t.get("iface")) or "",

                             "endpoint_host": (_bind_ip_of(inst.get("listen")) or node_cfg.get("endpoint_host")
                                               or (describe.get(t.get("node")) or {}).get("pub_host") or ""),
                             "dtls_port": dtls, "wg_port": str(inst.get("wg_port") or 56001), "tun_port": "9000",
                             "raw_port": str(inst.get("raw_port") or ""),   # RAW-IP mode, when this server accepts it
                             "vk_hash": (p.get("vk_hash") or "").strip()},
                    "primary": _role_of(t),
                })
                continue
            if (t.get("type") or "") == "csqtt":
                node_cfg = nodes.get(t.get("node")) or {}
                inst = ((node_cfg.get("csqtt")) or {}).get(t.get("iface")) or {}
                port = ((inst.get("listen") or "").rsplit(":", 1)[-1]) or "46000"
                tgts.append({
                    "node": t.get("node"), "iface": t.get("iface"),
                    "node_name": node_cfg.get("name") or t.get("node"),
                    "type": "csqtt",
                    "csqtt": {"password": p.get("csqtt_password") or "",
                              "endpoint_host": (_bind_ip_of(inst.get("listen")) or node_cfg.get("endpoint_host")
                                                or (describe.get(t.get("node")) or {}).get("pub_host") or ""),
                              "port": port,
                              "version": (nd.get("tver") or {}).get(t.get("iface")) or "",
                              "line": (nd.get("tline") or {}).get(t.get("iface")) or "",
                              "vk_hash": (p.get("vk_hash") or "").strip()},
                    "primary": _role_of(t),
                })
                continue
            meta = (nd.get("ifaces") or {}).get(t.get("iface")) or {}
            awg = meta.get("awg_params") or {}
            lp = meta.get("listen_port")
            # turn-proxies forwarding to THIS interface (same test as the admin's turnProxiesFor: the proxy
            # connects to the iface's listen port). Only non-secret client-config material rides along.
            turn = [{"service": tp.get("service"), "listen": tp.get("listen"), "wrap_key": tp.get("wrap_key"), "version": str(tp.get("version") or "").strip()}
                    for tp in (nd.get("turn") or []) if isinstance(tp, dict) and lp and _port_of(tp.get("connect")) == lp]
            _wgty = "awg" if awg else (t.get("type") or "wg")
            eff = effective_client_params(p, t, meta)
            if "turn" in _hide:
                turn = []                       # keep the direct config, drop its proxy variants
            if _wgty in _hide:
                if not turn:
                    continue                    # nothing left to publish for this deployment
                _direct_off = True              # publish ONLY its turn variants (below)
            else:
                _direct_off = False
            tgts.append({
                "node": t.get("node"), "iface": t.get("iface"),
                "node_name": (nodes.get(t.get("node")) or {}).get("name") or t.get("node"),
                "type": "awg" if awg else (t.get("type") or "wg"),
                "ip": t.get("ip"),
                "endpoint": meta.get("endpoint"), "server_pubkey": meta.get("public_key"),
                "dns": eff["dns"],
                "subnet": meta.get("subnet"),
                "mtu": eff["mtu"],
                "allowed": eff["allowed"],
                "keepalive": eff["keepalive"],
                "awg": awg,
                "turn": turn,
                **({} if not _direct_off else {"direct": False}),   # its own kind is hidden: only the proxy variants publish
                "primary": _role_of(t),
            })
        _exp = is_expired(p, nowv)
        if not (p.get("disabled") or _exp):
            for tg in tgts:   # torrents may leave by it → the page's client-setting line; absent otherwise (old pages ignore it)
                if torrents_allowed(nodes, describe, tg):
                    tg["p2p"] = True
                    tg.update(_p2p_fwd_of(p, tg, describe))
        peers_out.append({"peer_id": pid, "title": p.get("title") or "", "sec": sec, "targets": tgts,
                          "disabled": bool(p.get("disabled")), "expired": _exp})
    # active peers first (A-Z by title, untitled by IP), then blocked/expired at the bottom (also A-Z). The sub page
    # renders live-then-dead within this order, so a single title sort here gives both groups their A-Z ordering.
    def _peer_key(po):
        t = (po.get("title") or "").strip().lower()
        ip = ((po.get("targets") or [{}])[0] or {}).get("ip") or ""
        return (bool(po.get("disabled") or po.get("expired")), t == "", t, ip)   # active-first · titled-first · A-Z · then IP
    peers_out.sort(key=_peer_key)
    subs = state.subscriptions()
    langs = subs.get("languages") if isinstance(subs.get("languages"), dict) else {}
    return {"user": {"name": user.get("name") or ""}, "peers": peers_out,
            "networks": sub_networks(roster, uid, describe, nodes, nowv),   # what their devices reach beyond the internet (§18)
            # PER-USER VK link only — subscriptions NEVER fall back to the panel-wide vk_link (that one is for
            # the admin's own testing + unassigned peers). Empty here → the sub page shows a "create one" warning.
            "turn_enabled": bool(subs.get("turn_enabled")), "vk_link": (user.get("vk_link") or ""),
            "vk_links": (user.get("vk_links") if isinstance(user.get("vk_links"), list) else ([user.get("vk_link")] if user.get("vk_link") else [])),   # all of the user's VK links (primary first); every client that takes a list embeds all

            "theme_color": subs.get("theme_color") or "", "theme_color_light": subs.get("theme_color_light") or "",
            "turn_fork_colors": subs.get("turn_fork_colors") or {},
            "turn_client_default": subs.get("turn_client_default") or {},   # admin's END-USER default app per (fork, OS) → the page hands out THIS app instead of the compat-ranked top one
            "turn_client_settings": subs.get("turn_client_settings") or {},   # SETTINGS SPLIT: admin's per-fork client (app) values → the sub page generates configs with them (encoder fills any unset with defaults)
            "turn_catalog": _own_pins(subs.get("turn_catalog") or {}, peers_out),   # AXIS-3: server→client/app/scheme/store metadata so the page can offer "Get the app" install links (public app links only, no secrets)
            "wg_catalog": subs.get("wg_catalog") or {},   # WG/AWG client apps + per-OS resolved installer (download bubble): body → downloads page, icon → direct file
            "node_colors": subs.get("node_colors") or {},   # per-node colour so each server name renders in its panel colour
            "langs": {"enabled": langs.get("enabled") or ["en"], "default": langs.get("default") or "en"}}


# ── HTTP ──

class Handler(BaseHTTPRequestHandler):
    server_version = "swg-sub"
    protocol_version = "HTTP/1.1"
    timeout = 60
    state = None
    _meta_warned = False        # link-preview metadata failure is reported once, not once per visit
    _tb, _tb_lock = [float("-inf"), 0], threading.Lock()   # do_GET: when it last wrote a traceback, and how many it held since

    def log_message(self, *a):
        pass                                            # no request logging — the page is public, keep it quiet

    def _headers(self, code, ctype, length, cache="no-store", extra=None):
        self._replied = True                              # so the do_GET guard never writes a second response
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(length))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()

    def _send(self, code, body, ctype="text/plain; charset=utf-8", cache="no-store", extra=None):
        data = body if isinstance(body, (bytes, bytearray)) else str(body).encode()
        self._headers(code, ctype, len(data), cache, extra)
        if self.command != "HEAD":
            with contextlib.suppress(BrokenPipeError, ConnectionError):
                self.wfile.write(data)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj).encode(), "application/json; charset=utf-8")

    def _notfound(self):
        # Uniform 404 for everything that isn't a live surface: an off master switch, an unknown
        # or disabled token, a stray path. Reveals nothing about which tokens exist.
        self._send(404, "not found\n")

    # Strict CSP for the buildless page: same-origin scripts/styles, data: only for the QR images
    # this page draws into <img>. No connect-src to anywhere but self; no framing.
    _CSP = ("default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; "
            "img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; "
            "base-uri 'self'; frame-ancestors 'none'")

    def _static(self, name):
        rel = STATIC.get(name)
        if not rel:
            return self._notfound()
        full = os.path.normpath(os.path.join(WEB_DIR, rel))
        if not full.startswith(WEB_DIR):
            return self._send(403, "forbidden\n")
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            return self._notfound()
        _, ext = os.path.splitext(full)
        self._send(200, data, CTYPES.get(ext, "application/octet-stream"), cache="no-cache")

    def _page(self):
        # The single-page shell for every token. It carries no user data itself — the browser reads
        # its token from the path and the unlock key from the fragment, then fetches /api/<token>.
        full = os.path.join(WEB_DIR, "sub.html")
        try:
            with open(full, "rb") as f:
                data = f.read()
        except OSError:
            return self._send(500, "subscription page missing\n")
        if VERSION:
            # a "+sha" dev build must be %2B in the query — a literal "+" makes a CDN/WAF (Cloudflare) reject the URL.
            q = ("?v=" + VERSION.replace("+", "%2B")).encode()   # asset refs are RELATIVE (no leading /) so they resolve under any reverse-proxy mount
            data = (data.replace(b'href="_a/sub.css"', b'href="_a/sub.css' + q + b'"')
                        .replace(b'src="_a/sub.js"', b'src="_a/sub.js' + q + b'"')
                        .replace(b'src="_a/qrcode.js"', b'src="_a/qrcode.js' + q + b'"')
                        .replace(b'src="_a/turn-artifacts.js"', b'src="_a/turn-artifacts.js' + q + b'"'))
        try:
            _lg = (Handler.state.subscriptions() or {}).get("languages")
            data = _sub_meta(data, ((_lg if isinstance(_lg, dict) else {}).get("default") or "en"))
        except Exception as _e:
            if not Handler._meta_warned:
                Handler._meta_warned = True
                log(LOG_WARNING, "sub: link-preview metadata skipped (%s) — the page itself is served unchanged"
                      % str(_e)[:160])
        self._send(200, data, "text/html; charset=utf-8", cache="no-cache", extra={"Content-Security-Policy": self._CSP})

    def _client_ident(self):
        if _TRUST_XFF:
            xff = self.headers.get("X-Forwarded-For", "")
            if xff:
                return xff.split(",")[0].strip()
        try:
            return self.client_address[0]
        except Exception:
            return "?"

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        try:
            self._route()
        except (ConnectionError, TimeoutError, socket.timeout, ssl.SSLError) as e:
            log(LOG_DEBUG, "sub: a client went away before its reply was written (%s)", e.__class__.__name__)
        except Exception:
            # A real fault keeps its traceback — at most one a minute, with how many were held back: the page answers
            # every visitor, and a fault on it would otherwise write one per request.
            with Handler._tb_lock:
                now, (last, held) = time.monotonic(), Handler._tb
                due = now - last >= 60
                Handler._tb = [now, 0] if due else [last, held + 1]
            if due:
                log(LOG_ERR, traceback.format_exc().rstrip("\n")
                    + ("\n(%d more since the last one were not written)" % held if held else ""))
            if not getattr(self, "_replied", False):
                with contextlib.suppress(Exception):     # the peer may be gone; never raise out of the handler
                    self._send(500, "server error\n")

    def _route(self):
        path = strip_base(self.path.split("?", 1)[0].split("#", 1)[0])   # drop the reverse-proxy mount prefix, if any
        st = Handler.state

        if path == "/healthz":
            return self._send(200, "ok\n")

        if not _rate_ok(self._client_ident()):
            return self._send(429, "slow down\n", extra={"Retry-After": "5"})

        if path.startswith(ASSET_PREFIX):
            return self._static(path[len(ASSET_PREFIX):])

        if path.startswith("/api/"):
            token = path[len("/api/"):]
            if not TOKEN_RE.match(token):
                return self._notfound()
            data = read_data(st, token)
            if data is None:
                return self._notfound()
            return self._json(200, {"ok": True, "data": data})

        if path == "/" or path == "":
            return self._notfound()

        token = path[1:]
        if "/" in token or not TOKEN_RE.match(token):
            return self._notfound()
        if not st.enabled():                            # surface off ⇒ nothing here, not even the shell
            return self._notfound()
        return self._page()


class _QuietServer(ThreadingHTTPServer):
    def handle_error(self, request, client_address):
        pass                                            # failed handshake / scanner / vanished client — routine noise

    max_conns = 256

    def verify_request(self, request, client_address):
        return threading.active_count() <= self.max_conns     # the serve loop's own thread + one per connection


LOG_REREAD = 5
_LOG_SERVE = {"path": None, "at": -LOG_REREAD}


def _log_follow():
    if not _LOG_SERVE["path"] or time.monotonic() - _LOG_SERVE["at"] < LOG_REREAD:
        return
    _LOG_SERVE["at"] = time.monotonic()
    lg = (load_json(_LOG_SERVE["path"], {}) or {}).get("log")
    lg = lg if isinstance(lg, dict) else {}
    try:
        until = int(lg.get("debug_until") or 0)
    except (TypeError, ValueError):
        until = 0
    log_set(min(LOG_LEVELS.get(lg.get("level"), LOG_INFO), LOG_INFO),
            -1 if until == -1 else max(0, until - time.time()))


_log_write_lines = log


def log(prio, msg, *args):            # noqa: F811 — the shared helper's log(), after following the fleet's level
    _log_follow()
    _log_write_lines(prio, msg, *args)


def main():
    if os.getpid() == 1:
        signal.signal(signal.SIGTERM, lambda _sig, _frm: os._exit(0))
    fleet = load_json(FLEET_PATH, None)
    for _ in range(30):
        if fleet is not None:
            break
        log(LOG_INFO, f"swg-sub: waiting for {FLEET_PATH} …")
        time.sleep(2)
        fleet = load_json(FLEET_PATH, None)
    if fleet is None:
        raise SystemExit(f"cannot read fleet config: {FLEET_PATH}")
    state = State(fleet)
    Handler.state = state
    _LOG_SERVE["path"] = os.path.join(state.sub_dir, "serve.json")
    if not os.path.exists(_LOG_SERVE["path"]):
        log(LOG_INFO, "swg-sub: waiting for the panel's %s …" % _LOG_SERVE["path"])
        for _ in range(30):
            time.sleep(2)
            if os.path.exists(_LOG_SERVE["path"]):
                break

    global SUB_BASE, SUB_BASE_ALT                            # SWG_SUB_BASE wins (infra), else the panel's serve.base (from the sub public URL path)
    def _read_bases():
        sv = (state.subscriptions().get("serve") or {})
        b = _norm_base(os.environ.get("SWG_SUB_BASE") or sv.get("base"))
        ba = _norm_base(sv.get("base_alt"))                 # a transitional OLD base the panel keeps live during a grace
        return b, (ba if ba and ba != b else "")
    SUB_BASE, SUB_BASE_ALT = _read_bases()

    host = os.environ.get("SWG_SUB_HOST", "127.0.0.1")
    port = int(os.environ.get("SWG_SUB_PORT", "8444"))
    srv = _QuietServer((host, port), Handler)

    on = "enabled" if state.enabled() else "disabled (all requests 404 until turned on in the panel)"
    log(LOG_INFO, f"swg-sub {VERSION} on http://{host}:{port}{SUB_BASE or ''} — subscriptions {on}")
    with contextlib.suppress(KeyboardInterrupt):
        srv.serve_forever()


if __name__ == "__main__":
    main()
